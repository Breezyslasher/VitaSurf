+static JSSkipMemo *skip_memo_find(JSParseState *s, const uint8_t *ptr)
+{
+    uint32_t mask, i;
+
+    if (!s->skip_memo)
+        return NULL;
+    mask = s->skip_memo_size - 1;
+    for (i = ((uint32_t)(uintptr_t)ptr * 2654435761u) & mask;
+         s->skip_memo[i].ptr; i = (i + 1) & mask) {
+        if (s->skip_memo[i].ptr == ptr)
+            return &s->skip_memo[i];
+    }
+    return NULL;
+}
+
+static void skip_memo_add(JSParseState *s, const uint8_t *ptr, int tok,
+                          int bits, bool nl)
+{
+    JSRuntime *rt = s->ctx->rt;
+    JSSkipMemo *m;
+    uint32_t mask, i;
+
+    if ((s->skip_memo_count + 1) * 2 > s->skip_memo_size) {
+        uint32_t n = s->skip_memo_size ? s->skip_memo_size * 2 : 256, j;
+        JSSkipMemo *t = js_mallocz_rt(rt, n * sizeof(*t));
+
+        if (!t)
+            return; /* not kept: the scan is simply done again */
+        for (j = 0; j < s->skip_memo_size; j++) {
+            JSSkipMemo *o = &s->skip_memo[j];
+            if (!o->ptr)
+                continue;
+            for (i = ((uint32_t)(uintptr_t)o->ptr * 2654435761u) & (n - 1);
+                 t[i].ptr; i = (i + 1) & (n - 1)) {
+            }
+            t[i] = *o;
+        }
+        js_free_rt(rt, s->skip_memo);
+        s->skip_memo = t;
+        s->skip_memo_size = n;
+    }
+    mask = s->skip_memo_size - 1;
+    for (i = ((uint32_t)(uintptr_t)ptr * 2654435761u) & mask;
+         s->skip_memo[i].ptr; i = (i + 1) & mask) {
+        if (s->skip_memo[i].ptr == ptr)
+            return;
+    }
+    m = &s->skip_memo[i];
+    m->ptr = ptr;
+    m->tok = tok;
+    m->bits = bits;
+    m->nl = nl;
+    s->skip_memo_count++;
+}
+
+static void skip_memo_free(JSParseState *s)
+{
+    js_free_rt(s->ctx->rt, s->skip_memo);
+    s->skip_memo = NULL;
+    s->skip_memo_size = s->skip_memo_count = 0;
+}
