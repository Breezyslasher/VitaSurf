+/*
+ * The first variable called name on the scope chain that begins at
+ * scope_level, or the chain's end (-1, or ARG_SCOPE_END), with *with set
+ * if a 'with' object lies before it (VitaSurf).
+ *
+ * The chains are linked lists through every lexical variable in scope,
+ * and a minified bundle is a few functions each declaring thousands:
+ * every reference walked them, and resolving variables was a fifth of
+ * the compile of a Home Assistant plugin. Once js_create_function has
+ * linked the chains for the last time nothing changes them, so each
+ * (scope, name) is walked once and remembered.
+ */
+typedef struct JSChainMemo {
+    JSAtom name;            /* JS_ATOM_NULL for a free slot */
+    int32_t scope;
+    int32_t result;
+    int32_t with;
+} JSChainMemo;
+
+static int scope_chain_walk(JSFunctionDef *fd, int scope_level, JSAtom name,
+                            bool *with)
+{
+    int idx;
+
+    *with = false;
+    for (idx = fd->scopes[scope_level].first; idx >= 0;
+         idx = fd->vars[idx].scope_next) {
+        if (fd->vars[idx].var_name == name)
+            break;
+        if (fd->vars[idx].var_name == JS_ATOM__with_)
+            *with = true;
+    }
+    return idx;
+}
+
+static int scope_chain_find(JSContext *ctx, JSFunctionDef *fd,
+                            int scope_level, JSAtom name, bool *with)
+{
+    JSChainMemo *m;
+    uint32_t mask, i, h;
+    int r;
+
+    if (!fd->chains_final)
+        return scope_chain_walk(fd, scope_level, name, with);
+    /* a short chain costs less to walk than to look up */
+    {
+        int n = 0;
+        *with = false;
+        for (r = fd->scopes[scope_level].first; r >= 0 && n < 16;
+             r = fd->vars[r].scope_next, n++) {
+            if (fd->vars[r].var_name == name)
+                return r;
+            if (fd->vars[r].var_name == JS_ATOM__with_)
+                *with = true;
+        }
+        if (r < 0)
+            return r;
+    }
+    h = (name * 2654435761u) ^ ((uint32_t)scope_level * 40503u);
+    if (fd->chain_memo) {
+        mask = fd->chain_memo_size - 1;
+        for (i = h & mask; fd->chain_memo[i].name != JS_ATOM_NULL;
+             i = (i + 1) & mask) {
+            m = &fd->chain_memo[i];
+            if (m->name == name && m->scope == scope_level) {
+                *with = m->with;
+                return m->result;
+            }
+        }
+    }
+    r = scope_chain_walk(fd, scope_level, name, with);
+    if ((fd->chain_memo_count + 1) * 2 > fd->chain_memo_size) {
+        uint32_t n = fd->chain_memo_size ? fd->chain_memo_size * 2 : 64, j;
+        JSChainMemo *t = js_mallocz_rt(ctx->rt, n * sizeof(*t));
+
+        if (!t)
+            return r; /* not remembered: walked again next time */
+        for (j = 0; j < fd->chain_memo_size; j++) {
+            JSChainMemo *o = &fd->chain_memo[j];
+            uint32_t k;
+            if (o->name == JS_ATOM_NULL)
+                continue;
+            k = ((o->name * 2654435761u) ^ ((uint32_t)o->scope * 40503u)) & (n - 1);
+            while (t[k].name != JS_ATOM_NULL)
+                k = (k + 1) & (n - 1);
+            t[k] = *o;
+        }
+        js_free_rt(ctx->rt, fd->chain_memo);
+        fd->chain_memo = t;
+        fd->chain_memo_size = n;
+    }
+    mask = fd->chain_memo_size - 1;
+    for (i = h & mask; fd->chain_memo[i].name != JS_ATOM_NULL;
+         i = (i + 1) & mask) {
+    }
+    m = &fd->chain_memo[i];
+    m->name = name;
+    m->scope = scope_level;
+    m->result = r;
+    m->with = *with;
+    fd->chain_memo_count++;
+    return r;
+}
