+static int dynamic_bit_index(uint32_t bit)
+{
+	switch (bit) {
+	case CSS_DYNAMIC_HOVER:  return 0;
+	case CSS_DYNAMIC_ACTIVE: return 1;
+	case CSS_DYNAMIC_FOCUS:  return 2;
+	case CSS_DYNAMIC_TARGET: return 3;
+	default:                 return -1;
+	}
+}
+
+/* exported function documented in libcss/stylesheet.h */
+void css_stylesheet_dynamic_keys(const css_stylesheet *sheet, uint32_t bit,
+		const css_dynamic_key **keys, uint32_t *n, bool *any)
+{
+	int i = dynamic_bit_index(bit);
+
+	if (sheet == NULL || i < 0) {
+		*keys = NULL;
+		*n = 0;
+		*any = false;
+		return;
+	}
+	*keys = sheet->dynamic_keys[i].keys;
+	*n = sheet->dynamic_keys[i].n;
+	*any = sheet->dynamic_keys[i].any;
+}
