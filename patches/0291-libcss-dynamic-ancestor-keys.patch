+/**
+ * What an ancestor has to be for a state on it to matter (VitaSurf).
+ *
+ * For each ancestor compound that asks for a CSS_DYNAMIC_ state -- the
+ * ".menu:hover" of ".menu:hover .sub" -- one thing an element must have
+ * to match it: its id if it names one, else its first class, else its
+ * element name. A client restyles what is under an element whose state
+ * changed only if the element has one of these. *any is set when some
+ * such compound cannot be keyed (":hover .sub", or the state inside
+ * :is() or :not()), and then every element counts.
+ */
+enum css_dynamic_key_kind {
+	CSS_DYNAMIC_KEY_ELEMENT,
+	CSS_DYNAMIC_KEY_CLASS,
+	CSS_DYNAMIC_KEY_ID
+};
+typedef struct css_dynamic_key {
+	uint32_t kind;		/**< a css_dynamic_key_kind */
+	lwc_string *name;
+} css_dynamic_key;
+
+/**
+ * \param sheet  The stylesheet
+ * \param bit    One CSS_DYNAMIC_ bit
+ * \param keys   Set to the keys, owned by the sheet
+ * \param n      Set to how many
+ * \param any    Set to whether any element counts
+ */
+void css_stylesheet_dynamic_keys(const css_stylesheet *sheet, uint32_t bit,
+		const css_dynamic_key **keys, uint32_t *n, bool *any);
+
 /**
  * Read one of those (VitaSurf).
  *
