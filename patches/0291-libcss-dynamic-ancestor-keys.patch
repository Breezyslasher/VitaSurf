+/** The CSS_DYNAMIC_ bits of one compound's own pseudo-classes. */
+static uint32_t dynamic_bits_own(const css_selector *sel)
+{
+	const css_selector_detail *d = &sel->data;
+	uint32_t bits = 0;
+
+	for (;;) {
+		if (d->type == CSS_SELECTOR_PSEUDO_CLASS &&
+				d->value_type != CSS_SELECTOR_DETAIL_VALUE_SELECTOR) {
+			const char *n = lwc_string_data(d->qname.name);
+
+			if (strcasecmp(n, "hover") == 0)
+				bits |= CSS_DYNAMIC_HOVER;
+			else if (strcasecmp(n, "active") == 0)
+				bits |= CSS_DYNAMIC_ACTIVE;
+			else if (strcasecmp(n, "focus") == 0 ||
+					strcasecmp(n, "focus-within") == 0 ||
+					strcasecmp(n, "focus-visible") == 0)
+				bits |= CSS_DYNAMIC_FOCUS;
+			else if (strcasecmp(n, "target") == 0 ||
+					strcasecmp(n, "target-within") == 0)
+				bits |= CSS_DYNAMIC_TARGET;
+		}
+		if (d->next == 0)
+			break;
+		d++;
+	}
+	return bits;
+}
+
+/** Note what an element must have to match an ancestor compound. */
+static void dynamic_key_add(css_stylesheet *sheet, uint32_t bits,
+		const css_selector *sel)
+{
+	const css_selector_detail *d = &sel->data;
+	const css_selector_detail *id = NULL, *cls = NULL, *el = NULL;
+	int i;
+
+	for (;;) {
+		if (d->type == CSS_SELECTOR_ID && id == NULL)
+			id = d;
+		else if (d->type == CSS_SELECTOR_CLASS && cls == NULL)
+			cls = d;
+		else if (d->type == CSS_SELECTOR_ELEMENT &&
+				!(lwc_string_length(d->qname.name) == 1 &&
+				  lwc_string_data(d->qname.name)[0] == '*'))
+			el = d;
+		if (d->next == 0)
+			break;
+		d++;
+	}
+	if (id != NULL)
+		d = id;
+	else if (cls != NULL)
+		d = cls;
+	else
+		d = el;
+
+	for (i = 0; i < 4; i++) {
+		uint32_t kind, j;
+
+		if (!(bits & (1u << i)))
+			continue;
+		if (d == NULL) {
+			sheet->dynamic_keys[i].any = true;
+			continue;
+		}
+		kind = d == id ? CSS_DYNAMIC_KEY_ID :
+			d == cls ? CSS_DYNAMIC_KEY_CLASS :
+			CSS_DYNAMIC_KEY_ELEMENT;
+		for (j = 0; j < sheet->dynamic_keys[i].n; j++) {
+			if (sheet->dynamic_keys[i].keys[j].kind == kind &&
+					sheet->dynamic_keys[i].keys[j].name ==
+					d->qname.name)
+				break;
+		}
+		if (j < sheet->dynamic_keys[i].n)
+			continue;
+		if (sheet->dynamic_keys[i].n == sheet->dynamic_keys[i].alloc) {
+			uint32_t want = sheet->dynamic_keys[i].alloc ?
+				sheet->dynamic_keys[i].alloc * 2 : 8;
+			css_dynamic_key *k = realloc(
+					sheet->dynamic_keys[i].keys,
+					want * sizeof(*k));
+
+			if (k == NULL) {
+				/* unkeyed, so every element counts */
+				sheet->dynamic_keys[i].any = true;
+				continue;
+			}
+			sheet->dynamic_keys[i].keys = k;
+			sheet->dynamic_keys[i].alloc = want;
+		}
+		sheet->dynamic_keys[i].keys[sheet->dynamic_keys[i].n].kind =
+			kind;
+		sheet->dynamic_keys[i].keys[sheet->dynamic_keys[i].n].name =
+			lwc_string_ref(d->qname.name);
+		sheet->dynamic_keys[i].n++;
+	}
+}
+
+/** Key every ancestor compound of a selector that asks for a state. */
+static void dynamic_keys_note(css_stylesheet *sheet,
+		const css_selector *selector)
+{
+	const css_selector *sel;
+
+	for (sel = selector->combinator; sel != NULL; sel = sel->combinator) {
+		uint32_t all = dynamic_bits(sel, false);
+		uint32_t own = dynamic_bits_own(sel);
+		int i;
+
+		if (own != 0)
+			dynamic_key_add(sheet, own, sel);
+		/* inside :is(), :not(), :has() and the like: not keyed */
+		for (i = 0; i < 4; i++) {
+			if ((all & ~own) & (1u << i))
+				sheet->dynamic_keys[i].any = true;
+		}
+	}
+}
