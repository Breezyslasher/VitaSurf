diff --git a/quickjs.c b/quickjs.c
index 31f8a36..39d4828 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -296,6 +296,10 @@ struct JSRuntime {
     struct list_head tmp_obj_list; /* used during GC */
     JSGCPhaseEnum gc_phase : 8;
     size_t malloc_gc_threshold;
+    /* VitaSurf: how far the heap may grow past what a collection left
+       before the next one runs; see JS_SetGCGrowth */
+    uint32_t vita_gc_growth_pct;
+    size_t vita_gc_min_growth, vita_gc_max_growth;
     /* VitaSurf: collections run and the time they took, for the page
        report; see JS_GetGCStats */
     uint32_t vita_gc_runs;
@@ -1693,6 +1697,44 @@ JSValue JS_DupValueRT(JSRuntime *rt, JSValueConst v)
     return js_dup(v);
 }
 
+/*
+ * Where the next collection runs (VitaSurf): what this one left plus a
+ * share of it, and at least a floor, but short of the memory limit, so
+ * the heap is collected before an allocation is refused rather than
+ * after. A cycle collection walks everything live, so on a large heap
+ * each one costs the same whatever it frees: growing further between
+ * them is fewer of them for the same garbage.
+ */
+static void js_next_gc_threshold(JSRuntime *rt)
+{
+    size_t live = rt->malloc_state.malloc_size;
+    size_t limit = rt->malloc_state.malloc_limit;
+    size_t grow = live / 100 * rt->vita_gc_growth_pct;
+    size_t next;
+
+    if (grow < rt->vita_gc_min_growth)
+        grow = rt->vita_gc_min_growth;
+    /* the most is never less than stock's half of what is live */
+    if (rt->vita_gc_max_growth != 0 && grow > rt->vita_gc_max_growth)
+        grow = rt->vita_gc_max_growth > (live >> 1) ?
+            rt->vita_gc_max_growth : live >> 1;
+    next = live + grow;
+    if (limit != 0) {
+        size_t room = limit - limit / 8;
+        if (next > room)
+            next = room > live + (live >> 3) ? room : live + (live >> 3);
+    }
+    rt->malloc_gc_threshold = next;
+}
+
+void JS_SetGCGrowth(JSRuntime *rt, uint32_t percent, size_t min_bytes,
+                    size_t max_bytes)
+{
+    rt->vita_gc_growth_pct = percent;
+    rt->vita_gc_min_growth = min_bytes;
+    rt->vita_gc_max_growth = max_bytes;
+}
+
 static void js_trigger_gc(JSRuntime *rt, size_t size)
 {
     bool force_gc;
@@ -1709,8 +1751,7 @@ static void js_trigger_gc(JSRuntime *rt, size_t size)
         }
 #endif
         JS_RunGC(rt);
-        rt->malloc_gc_threshold = rt->malloc_state.malloc_size +
-            (rt->malloc_state.malloc_size >> 1);
+        js_next_gc_threshold(rt);
     }
 }
 
@@ -2090,6 +2131,9 @@ JSRuntime *JS_NewRuntime2(const JSMallocFunctions *mf, void *opaque)
     ms.malloc_size += rt->mf.js_malloc_usable_size(rt) + MALLOC_OVERHEAD;
     rt->malloc_state = ms;
     rt->malloc_gc_threshold = 256 * 1024;
+    rt->vita_gc_growth_pct = 50;
+    rt->vita_gc_min_growth = 0;
+    rt->vita_gc_max_growth = 0;
 
     init_list_head(&rt->context_list);
     init_list_head(&rt->gc_obj_list);
