 /** Write the attributes of an element, and the root's namespaces. */
+/*
+ * The paint the stylesheet chose (VitaSurf).
+ *
+ * libsvgtiny reads fill and stroke from attributes, and a site writes
+ * neither: it writes "fill: currentColor" in a stylesheet so that an
+ * icon takes the colour of the text around it. The two meet here, on
+ * the root of the markup that is about to be handed over -- fill and
+ * stroke inherit in SVG, so saying it once on the root reaches every
+ * shape inside that does not say otherwise.
+ *
+ * Only a value the page actually asked for is written. The initial
+ * value is the same black libsvgtiny already starts from, so leaving
+ * that case alone keeps a graphic that styles itself exactly as it was.
+ */
+static bool svg_paint_value(uint8_t type, css_color colour,
+			    const css_computed_style *style,
+			    char out[8])
+{
+	css_color current = 0;
+
+	/* fill and stroke share their value numbering */
+	switch (type) {
+	case CSS_FILL_NONE:
+		memcpy(out, "none", 5);
+		return true;
+	case CSS_FILL_CURRENT_COLOR:
+		css_computed_color(style, &current);
+		colour = current;
+		break;
+	case CSS_FILL_COLOR:
+		if (colour == 0xff000000) {
+			return false; /* the initial value; say nothing */
+		}
+		break;
+	default:
+		return false;
+	}
+
+	if ((colour >> 24) == 0) {
+		memcpy(out, "none", 5); /* nothing to see */
+		return true;
+	}
+
+	snprintf(out, 8, "#%02x%02x%02x",
+		 (unsigned)((colour >> 16) & 0xff),
+		 (unsigned)((colour >> 8) & 0xff),
+		 (unsigned)(colour & 0xff));
+
+	return true;
+}
+
+/** Write fill and stroke from the style, and say which ones it wrote. */
+static void svg_paint_attributes(struct svg_buf *b,
+				 const css_computed_style *style,
+				 bool *wrote_fill, bool *wrote_stroke)
+{
+	css_color colour = 0;
+	char value[8];
+	uint8_t type;
+
+	*wrote_fill = false;
+	*wrote_stroke = false;
+
+	if (style == NULL) {
+		return;
+	}
+
+	/*
+	 * The colour is read out through the pointer, so it has to be
+	 * fetched before it is passed: as one call it was an argument
+	 * evaluated against whatever the last one left behind, and every
+	 * plain colour came out as "none".
+	 */
+	type = css_computed_fill(style, &colour);
+	if (svg_paint_value(type, colour, style, value)) {
+		svg_buf_lit(b, " fill=\"");
+		svg_buf_lit(b, value);
+		svg_buf_lit(b, "\"");
+		*wrote_fill = true;
+	}
+
+	colour = 0;
+	type = css_computed_stroke(style, &colour);
+	if (svg_paint_value(type, colour, style, value)) {
+		svg_buf_lit(b, " stroke=\"");
+		svg_buf_lit(b, value);
+		svg_buf_lit(b, "\"");
+		*wrote_stroke = true;
+	}
+}
