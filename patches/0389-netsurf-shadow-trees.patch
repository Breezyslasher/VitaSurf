+/*
+ * X::part(a b) (VitaSurf). A part's names at the host of its own tree
+ * are its part attribute's; a host passes them on to the host of the
+ * tree it is in through its exportparts attribute, "a" or "a: b", a
+ * comma between each. Names are matched with case.
+ */
+#define PART_NAMES 16
+#define PART_NAME_LEN 64
+
+struct part_names {
+	unsigned n;
+	char name[PART_NAMES][PART_NAME_LEN];
+};
+
+static void part_names_add(struct part_names *set, const char *s, size_t len)
+{
+	if (len == 0 || len >= PART_NAME_LEN || set->n == PART_NAMES)
+		return;
+	memcpy(set->name[set->n], s, len);
+	set->name[set->n][len] = '\0';
+	set->n++;
+}
+
+static bool part_names_has(const struct part_names *set, const char *s,
+		size_t len)
+{
+	unsigned i;
+
+	for (i = 0; i < set->n; i++) {
+		if (strlen(set->name[i]) == len &&
+				memcmp(set->name[i], s, len) == 0)
+			return true;
+	}
+	return false;
+}
+
+static dom_string *part_attr_name(int which)
+{
+	static dom_string *names[2];
+
+	if (names[which] == NULL) {
+		const char *s = which == 0 ? "part" : "exportparts";
+
+		if (dom_string_create_interned((const uint8_t *) s,
+				strlen(s), &names[which]) != DOM_NO_ERR)
+			names[which] = NULL;
+	}
+	return names[which];
+}
+
+static bool part_is_ws(char c)
+{
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f';
+}
+
+/* The host of the shadow tree \a node is in, unreferenced, or NULL. */
+static dom_node *part_tree_host(dom_node *node)
+{
+	dom_node *n = dom_node_ref(node), *up = NULL;
+	dom_node_type type;
+	dom_element *host = NULL;
+
+	while (dom_node_get_parent_node(n, &up) == DOM_NO_ERR && up != NULL) {
+		dom_node_unref(n);
+		n = up;
+	}
+	if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+			type == DOM_DOCUMENT_FRAGMENT_NODE &&
+			dom_document_fragment_get_host(
+				(dom_document_fragment *) n, &host) ==
+				DOM_NO_ERR && host != NULL)
+		dom_node_unref(host);
+	else
+		host = NULL;
+	dom_node_unref(n);
+	return (dom_node *) host;
+}
+
+static css_error part_host(void *pw, void *node, lwc_string *const *names,
+		uint32_t n_names, void *prev, void **host)
+{
+	struct part_names set, next;
+	dom_string *attr = NULL, *name;
+	dom_node *n = node, *h;
+	bool past = (prev == NULL);
+	const char *s;
+	size_t len, i, a;
+	uint32_t k;
+
+	(void)pw;
+	*host = NULL;
+
+	name = part_attr_name(0);
+	if (name == NULL || dom_element_get_attribute(n, name, &attr) !=
+			DOM_NO_ERR || attr == NULL)
+		return CSS_OK;
+	set.n = 0;
+	s = dom_string_data(attr);
+	len = dom_string_byte_length(attr);
+	for (i = 0; i < len; ) {
+		while (i < len && part_is_ws(s[i]))
+			i++;
+		a = i;
+		while (i < len && !part_is_ws(s[i]))
+			i++;
+		part_names_add(&set, s + a, i - a);
+	}
+	dom_string_unref(attr);
+
+	while (set.n > 0 && (h = part_tree_host(n)) != NULL) {
+		if (past) {
+			for (k = 0; k < n_names; k++) {
+				if (!part_names_has(&set,
+						lwc_string_data(names[k]),
+						lwc_string_length(names[k])))
+					break;
+			}
+			if (k == n_names) {
+				*host = h;
+				return CSS_OK;
+			}
+		}
+		if (h == prev)
+			past = true;
+
+		/* the names h passes on to the host of its own tree */
+		name = part_attr_name(1);
+		attr = NULL;
+		if (name == NULL || dom_element_get_attribute(h, name,
+				&attr) != DOM_NO_ERR || attr == NULL)
+			break;
+		next.n = 0;
+		s = dom_string_data(attr);
+		len = dom_string_byte_length(attr);
+		for (i = 0; i < len; ) {
+			size_t inner, inner_len, outer, outer_len;
+
+			while (i < len && part_is_ws(s[i]))
+				i++;
+			inner = i;
+			while (i < len && s[i] != ',' && s[i] != ':' &&
+					!part_is_ws(s[i]))
+				i++;
+			inner_len = i - inner;
+			while (i < len && part_is_ws(s[i]))
+				i++;
+			outer = inner;
+			outer_len = inner_len;
+			if (i < len && s[i] == ':') {
+				i++;
+				while (i < len && part_is_ws(s[i]))
+					i++;
+				outer = i;
+				while (i < len && s[i] != ',' &&
+						!part_is_ws(s[i]))
+					i++;
+				outer_len = i - outer;
+				while (i < len && part_is_ws(s[i]))
+					i++;
+			}
+			/* a malformed entry is dropped up to its comma */
+			if (i < len && s[i] != ',') {
+				while (i < len && s[i] != ',')
+					i++;
+				inner_len = 0;
+			}
+			if (i < len)
+				i++;
+			if (inner_len > 0 && outer_len > 0 &&
+					part_names_has(&set, s + inner,
+						inner_len))
+				part_names_add(&next, s + outer, outer_len);
+		}
+		dom_string_unref(attr);
+		set = next;
+		n = h;
+	}
+	return CSS_OK;
+}
+
+/* exported interface documented in css/select.h */
+void *nscss_tree_scope(dom_node *node)
+{
+	dom_node *n = dom_node_ref(node), *up = NULL;
+	dom_node_type type;
+	dom_element *host = NULL;
+	void *scope = NULL;
+
+	while (dom_node_get_parent_node(n, &up) == DOM_NO_ERR && up != NULL) {
+		dom_node_unref(n);
+		n = up;
+	}
+	if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+			type == DOM_DOCUMENT_FRAGMENT_NODE &&
+			dom_document_fragment_get_host(
+				(dom_document_fragment *) n, &host) ==
+				DOM_NO_ERR && host != NULL) {
+		dom_node_unref(host);
+		scope = n;
+	}
+	dom_node_unref(n);
+	return scope;
+}
+
+static css_error node_tree_scope(void *pw, void *node, void **scope)
+{
+	(void)pw;
+	*scope = nscss_tree_scope(node);
+	return CSS_OK;
+}
