+static css_error named_parent_node_cross(void *pw, void *node,
+		const css_qname *qname, void **parent)
+{
+	(void)pw;
+	dom_element_named_parent_node_cross(node, qname->name,
+			(struct dom_element **)parent);
+	dom_node_unref(*parent);
+
+	return CSS_OK;
+}
+
+static css_error parent_node_cross(void *pw, void *node, void **parent)
+{
+	(void)pw;
+	dom_element_parent_node_cross(node, (struct dom_element **)parent);
+	dom_node_unref(*parent);
+
+	return CSS_OK;
