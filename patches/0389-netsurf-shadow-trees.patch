+/*
+ * The parent walks for a rule a shadow tree's own <style> was rewritten
+ * into (VitaSurf): these go on from the top of a shadow tree to its
+ * host, which such a rule names. The ones above stop at a shadow root,
+ * as a browser's do for the page's own rules: Home Assistant's
+ * hui-view-container>*{display:flex} reached into the component and
+ * drew a <style> of card-mod's as text.
+ */
+static css_error named_ancestor_node_cross(void *pw, void *node,
+		const css_qname *qname, void **ancestor)
+{
+	(void)pw;
+	dom_element_named_ancestor_node_cross(node, qname->name,
+			(struct dom_element **)ancestor);
+	dom_node_unref(*ancestor);
+
+	return CSS_OK;
+}
