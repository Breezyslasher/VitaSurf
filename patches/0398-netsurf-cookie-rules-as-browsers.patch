 /** Whether the cookie being set came from script (document.cookie) */
 static bool urldb_cookie_script = false;
 
+/** What parsing the cookie being set found, for its checks */
+static bool urldb_cookie_max_age = false;
+static bool urldb_cookie_samesite_none = false;
+static bool urldb_cookie_too_long = false;
+
 /**
  * Log what became of a cookie a response or a script set: its name and
  * where it applies, never its value.
@@ -1768,6 +1773,23 @@ urldb_cookie_note(const char *what,
 }
 
 
+/**
+ * Whether a page may set a Secure cookie: https, or this machine, which
+ * browsers trust as they do https.
+ */
+static bool urldb_cookie_secure_origin(lwc_string *scheme, lwc_string *host)
+{
+	bool match;
+	const char *h = lwc_string_data(host);
+
+	if (lwc_string_isequal(scheme, corestring_lwc_https, &match) ==
+	    lwc_error_ok && match)
+		return true;
+	return strcasecmp(h, "localhost") == 0 ||
+	       strncmp(h, "127.", 4) == 0 || strcmp(h, "[::1]") == 0;
+}
+
+
 /**
  * Parse a cookie avpair
  *
@@ -1839,12 +1861,23 @@ urldb_parse_avpair(struct cookie_internal_data *c,
 			memcpy(c->domain + 1, v, dlen + 1);
 		}
 	} else if (strcasecmp(n, "Max-Age") == 0) {
-		int temp = atoi(v);
-		if (temp == 0)
-			/* Special case - 0 means delete */
+		/* RFC 6265 5.2.2: digits, perhaps after a '-', or the
+		 * attribute is ignored; and it wins over Expires, in
+		 * whichever order they come */
+		const char *d = (v[0] == '-') ? v + 1 : v;
+		int temp;
+
+		if (*d == '\0' || strspn(d, "0123456789") != strlen(d))
+			return true;
+		temp = atoi(v);
+		urldb_cookie_max_age = true;
+		if (temp <= 0)
+			/* Special case - 0 or less means delete */
 			c->expires = 0;
 		else
 			c->expires = time(NULL) + temp;
+	} else if (strcasecmp(n, "SameSite") == 0) {
+		urldb_cookie_samesite_none = (strcasecmp(v, "None") == 0);
 	} else if (!c->path && strcasecmp(n, "Path") == 0) {
 		c->path_from_set = true;
 		c->path = strdup(v);
@@ -1874,7 +1907,8 @@ urldb_parse_avpair(struct cookie_internal_data *c,
 			 * deal with that once we come to it) */
 			expires = (time_t)0x7fffffff;
 		}
-		c->expires = expires;
+		if (!urldb_cookie_max_age)
+			c->expires = expires;
 	} else if (strcasecmp(n, "Secure") == 0) {
 		c->secure = true;
