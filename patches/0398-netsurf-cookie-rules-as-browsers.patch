@@ -1929,9 +1963,14 @@ urldb_parse_cookie(nsurl *url, const char **cookie)
 	bool value_verbatim = false;
 	bool quoted = false;
 	bool was_quoted = false;
+	size_t pair_len = 0;
 
 	assert(url && cookie && *cookie);
 
+	urldb_cookie_max_age = false;
+	urldb_cookie_samesite_none = false;
+	urldb_cookie_too_long = false;
+
 	c = calloc(1, sizeof(struct cookie_internal_data));
 	if (c == NULL)
 		return NULL;
@@ -2001,6 +2040,10 @@ urldb_parse_cookie(nsurl *url, const char **cookie)
 			*n = '\0';
 			*v = '\0';
 
+			if (c->name == NULL && pair_len > 4096)
+				urldb_cookie_too_long = true;
+			pair_len = 0;
+
 			if (!urldb_parse_avpair(c, name, value, was_quoted)) {
 				/* Memory exhausted */
 				urldb_free_cookie(c);
@@ -2024,59 +2067,16 @@ urldb_parse_cookie(nsurl *url, const char **cookie)
 			continue;
 		}
 
-		/* And now handle commas. These are a pain as they may mean
-		 * any of the following:
-		 *
-		 * + End of cookie
-		 * + Day separator in Expires avpair
-		 * + (Invalid) comma in unquoted value
-		 *
-		 * Therefore, in order to handle all 3 cases (2 and 3 are
-		 * identical, the difference being that 2 is in the spec and
-		 * 3 isn't), we need to determine where the comma actually
-		 * lies. We use the following heuristic:
-		 *
-		 *   Given a comma at the current input position, find the
-		 *   immediately following semicolon (or end of input if none
-		 *   found). Then, consider the input characters between
-		 *   these two positions. If any of these characters is an
-		 *   '=', we must assume that the comma signified the end of
-		 *   the current cookie.
-		 *
-		 * This holds as the first avpair of any cookie must be
-		 * NAME=VALUE, so the '=' is guaranteed to appear in the
-		 * case where the comma marks the end of a cookie.
-		 *
-		 * This will fail, however, in the case where '=' appears in
-		 * the value of the current avpair after the comma or the
-		 * subsequent cookie does not start with NAME=VALUE. Neither
-		 * of these is particularly likely and if they do occur, the
-		 * website is more broken than we can be bothered to handle.
-		 */
-		if (!quoted && *cur == ',') {
-			/* Find semi-colon, if any */
-			const char *p;
-			const char *semi = strchr(cur + 1, ';');
-			if (!semi)
-				semi = cur + strlen(cur) - 2 /* CRLF */;
-
-			/* Look for equals sign between comma and semi */
-			for (p = cur + 1; p < semi; p++)
-				if (*p == '=')
-					break;
+		/* No comma ends a cookie. NetSurf split a header at a comma
+		 * followed by an '=', for servers folding several cookies
+		 * into one header, which RFC 6265 forbids; curl hands each
+		 * Set-Cookie header over on its own, and browsers keep a
+		 * value such as "lang=en,theme=dark" whole. */
 
-			if (p == semi) {
-				/* none found => comma internal to value */
-				/* do nothing */
-			} else {
-				/* found one => comma marks end of cookie */
-				cur++;
-				break;
-			}
-		}
-
-		/* Accumulate into buffers, always leaving space for a NUL */
-		/** \todo is silently truncating overlong names/values wise? */
+		/* Accumulate into buffers, always leaving space for a NUL;
+		 * what does not fit is counted, and a cookie whose name and
+		 * value are over 4096 bytes is refused, as browsers do */
+		pair_len++;
 		if (!in_value) {
 			if (n < name + (sizeof(name) - 1))
 				*n++ = *cur;
@@ -2090,6 +2090,9 @@ urldb_parse_cookie(nsurl *url, const char **cookie)
 	*n = '\0';
 	*v = '\0';
 
+	if (c->name == NULL && pair_len > 4096)
+		urldb_cookie_too_long = true;
+
 	if (!urldb_parse_avpair(c, name, value, was_quoted)) {
 		/* Memory exhausted */
 		urldb_free_cookie(c);
@@ -4151,6 +4154,43 @@ bool urldb_set_cookie(const char *header, nsurl *url, nsurl *referer)
 			goto error;
 		}
 
+		/* RFC 6265bis 5.6, as browsers have it: a name and value
+		 * over 4096 bytes, a Secure cookie from a page that is not
+		 * https (or this machine), SameSite=None without Secure,
+		 * and a __Secure- or __Host- name without what it promises
+		 * are refused */
+		if (urldb_cookie_too_long) {
+			urldb_cookie_note("refused, over 4096 bytes,", c, host);
+			urldb_free_cookie(c);
+			goto error;
+		}
+		if (c->secure && !urldb_cookie_secure_origin(scheme, host)) {
+			urldb_cookie_note("refused, Secure from a page that is "
+					  "not https,", c, host);
+			urldb_free_cookie(c);
+			goto error;
+		}
+		if (urldb_cookie_samesite_none && !c->secure) {
+			urldb_cookie_note("refused, SameSite=None without "
+					  "Secure,", c, host);
+			urldb_free_cookie(c);
+			goto error;
+		}
+		if (strncasecmp(c->name, "__Secure-", 9) == 0 && !c->secure) {
+			urldb_cookie_note("refused, __Secure- without Secure,",
+					  c, host);
+			urldb_free_cookie(c);
+			goto error;
+		}
+		if (strncasecmp(c->name, "__Host-", 7) == 0 &&
+		    (!c->secure || c->domain_from_set ||
+		     !c->path_from_set || strcmp(c->path, "/") != 0)) {
+			urldb_cookie_note("refused, __Host- not Secure, "
+					  "host-only and at /,", c, host);
+			urldb_free_cookie(c);
+			goto error;
+		}
