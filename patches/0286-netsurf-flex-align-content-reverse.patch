 		if (i > 0) {
-			line_pos += (reversed ? -1 : 1) * ctx->cross_gap;
+			line_pos += (reversed ? -1 : 1) *
+					(ctx->cross_gap + between);
 		}
 		line_pos += pre_multiplier * line->cross_size;
 		line->pos = line_pos;
