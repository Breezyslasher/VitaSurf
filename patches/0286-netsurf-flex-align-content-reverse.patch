 	}
 
 	for (size_t i = line->first; i < item_count; i++) {
@@ -1199,21 +1208,67 @@ static void layout_flex__place_lines(struct flex_ctx *ctx)
 	int pre_multiplier = reversed ? -1 : 0;
 	int extra_remainder = 0;
 	int extra = 0;
+	int lead = 0, between = 0;
 
 	if (ctx->available_cross != AUTO &&
 	    ctx->available_cross > ctx->cross_size &&
 	    ctx->line.count > 0) {
-		extra = ctx->available_cross - ctx->cross_size;
+		int total = ctx->available_cross - ctx->cross_size;
+		size_t n = ctx->line.count;
+
+		extra = total;
+
+		/*
+		 * align-content, for a container whose items may wrap,
