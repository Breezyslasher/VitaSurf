@@ -930,8 +930,17 @@ static bool layout_flex__place_line_items_main(
 	int placed = 0;
 
 	if (ctx->main_reversed) {
-		main_pos = lh__box_size_main(ctx->horizontal, ctx->flex) -
-				main_pos;
+		/*
+		 * The content box's far edge: the near padding and the
+		 * content size, measured from the padding edge the items
