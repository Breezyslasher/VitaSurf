diff --git a/src/core/node.c b/src/core/node.c
index 184755f..9a592fb 100644
--- a/src/core/node.c
+++ b/src/core/node.c
@@ -143,12 +143,31 @@ void _dom_node_destroy(struct dom_node_internal *node)
  * ::name, ::value, ::namespace, and ::prefix  will have their reference 
  * counts increased.
  */
+/* nodes alive, for a client's memory report (VitaSurf) */
+static uint32_t dom_nodes_live;
+
+/* exported interface documented in dom/core/node.h */
+uint32_t dom_node_live_count(void)
+{
+	return dom_nodes_live;
+}
+
+/* A node finalised that will be finalised again (VitaSurf): a document
+ * with nodes still pending deletion is. */
+void _dom_node_live_unfinalise(void)
+{
+	dom_nodes_live++;
+}
+
 dom_exception _dom_node_initialise(dom_node_internal *node,
 		struct dom_document *doc, dom_node_type type,
 		dom_string *name, dom_string *value,
 		dom_string *namespace, dom_string *prefix)
 {
+	dom_nodes_live++;
 	node->owner = doc;
+	if (doc != NULL)
+		doc->owned_nodes++;
 
 	if (name != NULL)
 		node->name = dom_string_ref(name);
@@ -228,6 +247,12 @@ void _dom_node_finalise(dom_node_internal *node)
 	struct dom_node_internal *p;
 	struct dom_node_internal *n = NULL;
 
+	dom_nodes_live--;
+	if (node->owner != NULL &&
+			node != (dom_node_internal *) node->owner &&
+			node->owner->owned_nodes > 0)
+		node->owner->owned_nodes--;
+
 	/* Destroy user data */
 	for (u = node->user_data; u != NULL; u = v) {
 		v = u->next;
@@ -744,7 +769,10 @@ static void adopt_one(dom_node_internal *n, void *pw)
 	if (n->owner != to && n->type != DOM_DOCUMENT_NODE) {
 		if (pending)
 			list_del(&n->pending_list);
+		if (n->owner != NULL && n->owner->owned_nodes > 0)
+			n->owner->owned_nodes--;
 		n->owner = to;
+		to->owned_nodes++;
 		if (pending)
 			list_append(&to->pending_nodes, &n->pending_list);
 	}
@@ -891,6 +919,7 @@ dom_exception _dom_node_insert_before(dom_node_internal *node,
 		/* See long comment in _dom_node_initialise as to why 
 		 * we don't ref the document here */
 		new_child->owner = (struct dom_document *) node;
+		((struct dom_document *) node)->owned_nodes++;
 	}
 
 	/** \todo Is it correct to return DocumentFragments? */
@@ -1987,6 +2016,8 @@ dom_exception _dom_node_copy(dom_node_internal *old, dom_node_internal **copy)
 dom_exception _dom_node_copy_internal(dom_node_internal *old, 
 		dom_node_internal *new)
 {
+	/* a copy is finalised like any other node (VitaSurf) */
+	dom_nodes_live++;
 	new->base.vtable = old->base.vtable;
 	new->vtable = old->vtable;
 
@@ -2004,6 +2035,7 @@ dom_exception _dom_node_copy_internal(dom_node_internal *old,
 	assert(old->owner != NULL);
 
 	new->owner = old->owner;
+	new->owner->owned_nodes++;
 
 	if (old->namespace != NULL)
 		new->namespace = dom_string_ref(old->namespace);
