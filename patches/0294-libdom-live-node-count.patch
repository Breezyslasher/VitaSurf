+ */
+uint32_t dom_node_live_count(void);
+
 static inline dom_node *dom_node_ref(dom_node *node)
 {
 	if (node != NULL)
diff --git a/src/core/document.c b/src/core/document.c
index 7671f6a..b705f3a 100644
--- a/src/core/document.c
+++ b/src/core/document.c
@@ -307,8 +307,11 @@ bool _dom_document_finalise(dom_document *doc)
 	/* Ensure list of nodes pending deletion is empty. If not,
 	 * then we can't yet destroy the document (its destruction will
 	 * have to wait until the pending nodes are destroyed) */
-	if (doc->pending_nodes.next != &doc->pending_nodes)
+	if (doc->pending_nodes.next != &doc->pending_nodes) {
+		/* finalised again once they go: count it once (VitaSurf) */
+		_dom_node_live_unfinalise();
 		return false;
+	}
 
 	/* Ok, the document tree is empty, as is the list of nodes pending
 	 * deletion. Therefore, it is safe to destroy the document. */
diff --git a/src/core/node.c b/src/core/node.c
index 184755f..2d42207 100644
--- a/src/core/node.c
+++ b/src/core/node.c
@@ -143,11 +143,28 @@ void _dom_node_destroy(struct dom_node_internal *node)
  * ::name, ::value, ::namespace, and ::prefix  will have their reference 
  * counts increased.
  */
+/* nodes alive, for a client's memory report (VitaSurf) */
+static uint32_t dom_nodes_live;
+
+/* exported interface documented in dom/core/node.h */
+uint32_t dom_node_live_count(void)
+{
+	return dom_nodes_live;
+}
+
+/* A node finalised that will be finalised again (VitaSurf): a document
+ * with nodes still pending deletion is. */
+void _dom_node_live_unfinalise(void)
+{
+	dom_nodes_live++;
+}
+
 dom_exception _dom_node_initialise(dom_node_internal *node,
 		struct dom_document *doc, dom_node_type type,
 		dom_string *name, dom_string *value,
 		dom_string *namespace, dom_string *prefix)
 {
+	dom_nodes_live++;
 	node->owner = doc;
 
 	if (name != NULL)
@@ -228,6 +245,8 @@ void _dom_node_finalise(dom_node_internal *node)
 	struct dom_node_internal *p;
 	struct dom_node_internal *n = NULL;
 
+	dom_nodes_live--;
+
 	/* Destroy user data */
 	for (u = node->user_data; u != NULL; u = v) {
 		v = u->next;
@@ -1987,6 +2006,8 @@ dom_exception _dom_node_copy(dom_node_internal *old, dom_node_internal **copy)
 dom_exception _dom_node_copy_internal(dom_node_internal *old, 
 		dom_node_internal *new)
 {
+	/* a copy is finalised like any other node (VitaSurf) */
+	dom_nodes_live++;
 	new->base.vtable = old->base.vtable;
 	new->vtable = old->vtable;
 
