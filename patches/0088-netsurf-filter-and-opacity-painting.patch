+/*
+ * Painting through a filter (VitaSurf).
+ *
+ * A box with a CSS filter or an opacity below one, and everything in it,
+ * is painted through a plotter table that stands in front of the real
+ * one: every colour a call carries is put through the box's colour
+ * matrix and alpha, and a bitmap is copied and transformed pixel by
+ * pixel before it is drawn. Fills keep their alpha, since the plotters
+ * blend those; a text or stroke colour, which they do not blend, is
+ * mixed towards the colour under the box instead. Nested filters stack:
+ * each level's calls forward to the table below it, so an inner box is
+ * transformed by its own filter and then by every enclosing one.
+ */
+#define HTML_FILTER_DEPTH 8
+
+struct html_filter_level {
+	const struct plotter_table *real;
+	int alpha;			/**< 0..256 */
+	const int32_t *m;		/**< NULL for the identity */
+	colour bg;			/**< what a mixed colour fades to */
+};
+
+static struct html_filter_level html_filter_stack[HTML_FILTER_DEPTH];
+static int html_filter_depth;
+
+static inline int html_filter_clamp(int v)
+{
+	return v < 0 ? 0 : v > 255 ? 255 : v;
+}
+
+/** The matrix and alpha applied to a NetSurf colour, alpha kept. */
+static colour html_filter_colour(const struct html_filter_level *lv,
+		colour c)
+{
+	int r = c & 0xff, g = (c >> 8) & 0xff, b = (c >> 16) & 0xff;
+	int a = 0xff - (c >> 24);
+
+	if (lv->m != NULL) {
+		const int32_t *m = lv->m;
+		int nr = (m[0] * r + m[1] * g + m[2] * b) / 4096 +
+				m[3] * 255 / 4096;
+		int ng = (m[4] * r + m[5] * g + m[6] * b) / 4096 +
+				m[7] * 255 / 4096;
+		int nb = (m[8] * r + m[9] * g + m[10] * b) / 4096 +
+				m[11] * 255 / 4096;
+
+		r = html_filter_clamp(nr);
+		g = html_filter_clamp(ng);
+		b = html_filter_clamp(nb);
+	}
+	a = a * lv->alpha / 256;
+
+	return ((0xff - a) << 24) | (b << 16) | (g << 8) | r;
+}
+
+/** As above, then mixed towards the background for a sink without alpha. */
+static colour html_filter_opaque(const struct html_filter_level *lv,
+		colour c)
+{
+	colour t = html_filter_colour(lv, c);
+	int a = 0xff - (t >> 24);
+	int r, g, b;
+
+	if (a >= 0xff)
+		return t & 0x00ffffff;
+	r = ((t & 0xff) * a + (lv->bg & 0xff) * (0xff - a)) / 0xff;
+	g = (((t >> 8) & 0xff) * a + ((lv->bg >> 8) & 0xff) * (0xff - a)) /
+			0xff;
+	b = (((t >> 16) & 0xff) * a + ((lv->bg >> 16) & 0xff) * (0xff - a)) /
+			0xff;
+	return (b << 16) | (g << 8) | r;
+}
+
+/* Each wrapper pops its level while it forwards, so that a level below
+ * sees itself on top. */
+#define HTML_FILTER_FORWARD(lvvar, ctxvar, call)			\
+	do {								\
+		struct redraw_context rctx_ = *(ctxvar);		\
+		html_filter_depth--;					\
+		rctx_.plot = (lvvar)->real;				\
+		res = (call);						\
+		html_filter_depth++;					\
+	} while (0)
