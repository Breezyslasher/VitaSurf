+static nserror html_filter_bitmap(const struct redraw_context *ctx,
+		struct bitmap *bitmap, int x, int y, int width, int height,
+		colour bg, bitmap_flags_t flags)
+{
+	struct html_filter_level *lv =
+			&html_filter_stack[html_filter_depth - 1];
+	struct bitmap *copy = NULL;
+	nserror res;
+
+	bg = html_filter_opaque(lv, bg);
+
+	if (lv->m != NULL || lv->alpha < 256) {
+		int bw = guit->bitmap->get_width(bitmap);
+		int bh = guit->bitmap->get_height(bitmap);
+		const uint8_t *src;
+		uint8_t *dst;
+		size_t ss, ds;
+		int px, py;
+
+		copy = guit->bitmap->create(bw, bh, BITMAP_NONE);
+		if (copy != NULL) {
+			src = guit->bitmap->get_buffer(bitmap);
+			dst = guit->bitmap->get_buffer(copy);
+			ss = guit->bitmap->get_rowstride(bitmap);
+			ds = guit->bitmap->get_rowstride(copy);
+			if (src == NULL || dst == NULL) {
+				guit->bitmap->destroy(copy);
+				copy = NULL;
+			}
+		}
+		if (copy != NULL) {
+			bool opaque = guit->bitmap->get_opaque(bitmap);
+
+			for (py = 0; py < bh; py++) {
+				const uint8_t *sp = src + py * ss;
+				uint8_t *dp = dst + py * ds;
+
+				for (px = 0; px < bw; px++) {
+					colour c = bitmap_pixel_to_colour(sp);
+					colour t;
+
+					if (opaque)
+						c &= 0x00ffffff;
+					/* pixel alpha is stored straight,
+					 * not inverted as in a colour */
+					c ^= 0xff000000;
+					t = html_filter_colour(lv, c);
+					t ^= 0xff000000;
+					dp[bitmap_layout.r] = t & 0xff;
+					dp[bitmap_layout.g] = (t >> 8) & 0xff;
+					dp[bitmap_layout.b] = (t >> 16) & 0xff;
+					dp[bitmap_layout.a] = (t >> 24) & 0xff;
+					sp += 4;
+					dp += 4;
+				}
+			}
+			guit->bitmap->set_opaque(copy,
+					opaque && lv->alpha == 256);
+			guit->bitmap->modified(copy);
+			bitmap = copy;
+		}
+	}
+
+	HTML_FILTER_FORWARD(lv, ctx, rctx_.plot->bitmap(&rctx_, bitmap, x, y,
+			width, height, bg, flags));
+	if (copy != NULL)
+		guit->bitmap->destroy(copy);
+	return res;
+}
