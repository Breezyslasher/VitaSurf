+/**
+ * Read the filter string libcss folded a filter list into (VitaSurf).
+ *
+ * See libcss parse/properties/filter.c for the form. The result is
+ * owned by the box.
+ */
+static struct html_paint_filter *box_parse_filter(struct box *box,
+		const char *spec)
+{
+	struct html_paint_filter *f = talloc_zero(box, struct html_paint_filter);
+	const char *p = spec;
+	char *end;
+	int i;
+
+	if (f == NULL)
+		return NULL;
+	f->alpha = 256;
+	f->m[0] = f->m[5] = f->m[10] = 4096;
+
+	while (*p != '\0') {
+		if (p[0] == 'a' && p[1] == '=') {
+			long a = strtol(p + 2, &end, 10);
+
+			f->alpha = (int) ((a < 0 ? 0 : a > 4096 ? 4096 : a) /
+					16);
+			p = end;
+		} else if (p[0] == 'm' && p[1] == '=') {
+			p += 2;
+			for (i = 0; i < 12; i++) {
+				f->m[i] = (int32_t) strtol(p, &end, 10);
+				if (end == p)
+					break;
+				p = end;
+				if (*p == ',')
+					p++;
+			}
+			f->colour = (i == 12);
+		} else if (p[0] == 's' && p[1] == '=') {
+			p += 2;
+			f->shadow_x = (int) strtol(p, &end, 10); p = end;
+			if (*p == ',') p++;
+			f->shadow_y = (int) strtol(p, &end, 10); p = end;
+			if (*p == ',') p++;
+			f->shadow_blur = (int) strtol(p, &end, 10); p = end;
+			if (*p == ',') p++;
+			f->shadow_colour = (css_color) strtoul(p, &end, 16);
+			f->shadow = (end != p);
+			p = end;
+		} else if (p[0] == 'b' && p[1] == '=') {
+			/* blur: noted by libcss, not drawn */
+			strtol(p + 2, &end, 10);
+			p = end;
+		} else {
+			break;
+		}
+		if (*p == ';')
+			p++;
+		else
+			break;
+	}
+
+	if (f->alpha == 256 && !f->colour && !f->shadow) {
+		talloc_free(f);
+		return NULL;
+	}
+	return f;
+}
