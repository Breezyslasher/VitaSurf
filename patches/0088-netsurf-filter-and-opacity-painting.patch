+static bool html_redraw_box_inner(const html_content *html, struct box *box,
+		int x_parent, int y_parent,
+		const struct rect *clip, const float scale,
+		colour current_background_color,
+		const struct redraw_context *ctx);
+
+/**
+ * Recursively draw a box.
+ *
+ * The box's opacity and filter, if any, are put in front of the
+ * plotters for the box and its descendants (VitaSurf); a box with no
+ * opacity at all paints nothing. The drawing itself is
+ * html_redraw_box_inner().
+ */
 bool html_redraw_box(const html_content *html, struct box *box,
 		int x_parent, int y_parent,
 		const struct rect *clip, const float scale,
 		colour current_background_color,
 		const struct redraw_context *ctx)
+{
+	struct redraw_context fctx;
+	int alpha = 256;
+	const int32_t *m = NULL;
+	bool pushed = false;
+	bool ok;
+
+	if (box->style != NULL) {
+		css_fixed op = INTTOFIX(1);
+
+		if (css_computed_opacity(box->style, &op) == CSS_OPACITY_SET) {
+			alpha = FIXTOINT(FMUL(op, INTTOFIX(256)));
+			if (alpha < 0)
+				alpha = 0;
+			if (alpha > 256)
+				alpha = 256;
+		}
+		if (box->filter != NULL) {
+			alpha = alpha * box->filter->alpha / 256;
+			if (box->filter->colour)
+				m = box->filter->m;
+		}
+	}
+
+	if (alpha <= 0)
+		return true;
+
+	if ((alpha < 256 || m != NULL) &&
+			html_filter_depth < HTML_FILTER_DEPTH) {
+		struct html_filter_level *lv =
+				&html_filter_stack[html_filter_depth++];
+
+		lv->real = ctx->plot;
+		lv->alpha = alpha;
+		lv->m = m;
+		lv->bg = current_background_color;
+		fctx = *ctx;
+		fctx.plot = &html_filter_plotters;
+		ctx = &fctx;
+		pushed = true;
+	}
+
+	ok = html_redraw_box_inner(html, box, x_parent, y_parent, clip, scale,
+			current_background_color, ctx);
+
+	if (pushed)
+		html_filter_depth--;
+
+	return ok;
+}
