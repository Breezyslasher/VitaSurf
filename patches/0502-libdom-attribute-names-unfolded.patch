+/*
+ * Whether an element's id is name, compared as dom_string_lwc_isequal
+ * does (VitaSurf): the id attribute found in the element's own list,
+ * where getting the id went through the HTML getAttribute, which looks
+ * up the element's namespace and lowers the name "id" for every test a
+ * selector makes, and handed back a reference to the value.
+ */
+dom_exception dom_element_vita_has_id(dom_element *element,
+		lwc_string *name, bool *match);
+
 #endif
diff --git a/src/core/element.c b/src/core/element.c
index 2aa29e3..ac1857d 100644
--- a/src/core/element.c
+++ b/src/core/element.c
@@ -2327,6 +2327,31 @@ dom_exception _dom_element_get_id(struct dom_element *ele, dom_string **id)
 
 
 
+/* exported interface documented in dom/core/element.h */
+dom_exception dom_element_vita_has_id(dom_element *element,
+		lwc_string *name, bool *match)
+{
+	dom_attr_list *a;
+	dom_string *idn, *value = NULL;
+	dom_exception err;
+
+	/* the attribute named id, as the HTML element's id reads it */
+	*match = false;
+	idn = _dom_document_get_id_name(dom_node_get_owner(element));
+	if (idn == NULL || element->attributes == NULL)
+		return DOM_NO_ERR;
+	a = _dom_element_attr_list_find_by_name(element->attributes, idn,
+			NULL);
+	if (a == NULL)
+		return DOM_NO_ERR;
+	err = dom_attr_get_value(a->attr, &value);
+	if (err != DOM_NO_ERR || value == NULL)
+		return err;
+	*match = dom_string_lwc_isequal(value, name);
+	dom_string_unref(value);
+	return DOM_NO_ERR;
+}
+
