diff --git a/src/html/html_element.c b/src/html/html_element.c
index d4d3917..c276518 100644
--- a/src/html/html_element.c
+++ b/src/html/html_element.c
@@ -202,6 +202,26 @@ static bool html_element_folds_case(struct dom_element *element)
 }
 
 
+/*
+ * Whether a name has to be lowered before the element's attributes are
+ * searched (VitaSurf): never when it has no ASCII capital, which is what
+ * nearly every name is, so the namespace an element folds by is looked
+ * up only for a name that would change. Every getAttribute, and every
+ * attribute and id test a selector makes, had looked it up and then
+ * read the name again for a capital.
+ */
+static bool html_name_folds(struct dom_element *element, dom_string *name)
+{
+	const char *d = dom_string_data(name);
+	size_t len = dom_string_byte_length(name), i;
+
+	for (i = 0; i < len; i++) {
+		if (d[i] >= 'A' && d[i] <= 'Z')
+			return html_element_folds_case(element);
+	}
+	return false;
+}
+
 dom_exception _dom_html_element_get_attribute(
 		struct dom_element *element,
 		dom_string *name, dom_string **value)
@@ -209,7 +229,7 @@ dom_exception _dom_html_element_get_attribute(
 	dom_exception exc;
 	dom_string *lower_case_name;
 
-	if (html_element_folds_case(element) == false) {
+	if (html_name_folds(element, name) == false) {
 		return _dom_element_get_attribute(element, name, value);
 	}
 
