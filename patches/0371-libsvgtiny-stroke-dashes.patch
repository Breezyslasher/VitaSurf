 }
 
 
+/**
+ * Parse a stroke-dasharray (VitaSurf): none, or lengths separated by
+ * commas, white space or both. An odd number of them is repeated, as
+ * the specification has it; a negative one makes the value an error,
+ * and lengths that are all zero draw the stroke solid.
+ */
+static svgtiny_code
+svgtiny_parse_dasharray(const char *text, size_t textlen, int viewport_size,
+			struct svgtiny_parse_state *state)
+{
+	float dash[SVGTINY_DASH_MAX];
+	float sum = 0;
+	int n = 0, i;
+	size_t at = 0;
+
+	while (at < textlen && strchr(" \t\r\n", text[at]) != NULL)
+		at++;
+	if (textlen - at >= 4 && strncmp(text + at, "none", 4) == 0) {
+		state->dash_n = 0;
+		return svgtiny_OK;
+	}
+
+	while (at < textlen) {
+		size_t end = at;
+		float len;
+		svgtiny_code res;
+
+		while (end < textlen && strchr(" \t\r\n,", text[end]) == NULL)
+			end++;
+		if (end > at) {
+			if (n == SVGTINY_DASH_MAX / 2)
+				return svgtiny_SVG_ERROR;
+			res = svgtiny_parse_length(text + at, end - at,
+					viewport_size, &len);
+			if (res != svgtiny_OK || len < 0)
+				return svgtiny_SVG_ERROR;
+			dash[n++] = len;
+			sum += len;
+		}
+		at = end;
+		while (at < textlen && strchr(" \t\r\n,", text[at]) != NULL)
+			at++;
+	}
+
+	if (n == 0 || sum <= 0) {
+		state->dash_n = 0;
+		return svgtiny_OK;
+	}
+	if (n % 2 == 1) {
+		for (i = 0; i < n; i++)
+			dash[n + i] = dash[i];
+		n *= 2;
+	}
+	memcpy(state->dash, dash, n * sizeof(dash[0]));
+	state->dash_n = n;
+	return svgtiny_OK;
+}
+
+
 /**
  * dispatch parse operation
  */
@@ -1063,6 +1122,12 @@ dispatch_op(const char *value,
 	case SVGTIOP_OFFSET:
 		res = svgtiny_parse_offset(value, value_len, styleop->value);
 		break;
+
+	case SVGTIOP_DASHARRAY:
+		res = svgtiny_parse_dasharray(value, value_len,
+				(int) *((float *)styleop->param),
+				styleop->value);
+		break;
 	}
 	return res;
 }
