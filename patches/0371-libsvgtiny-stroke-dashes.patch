+/** Room for want more floats in a dashed path being built (VitaSurf). */
+static bool svgtiny_dash_room(float **out, unsigned int *len,
+		unsigned int *cap, unsigned int want)
+{
+	float *p;
+	unsigned int c;
+
+	if (*len + want <= *cap)
+		return true;
+	c = *cap ? *cap * 2 : 64;
+	while (c < *len + want)
+		c *= 2;
+	p = realloc(*out, c * sizeof(float));
+	if (p == NULL)
+		return false;
+	*out = p;
+	*cap = c;
+	return true;
+}
+
+/**
+ * The dashes of a path (VitaSurf): what of it the stroke's dash pattern
+ * draws, as open subpaths of lines, curves flattened. The pattern starts
+ * again at each subpath, dash_offset into it. Returns NULL with *len 0
+ * when nothing of it is drawn, or when memory runs out (*len 1).
+ */
+static float *svgtiny_dash_path(const float *p, unsigned int n,
+		const struct svgtiny_parse_state *state, unsigned int *len)
+{
+	float *out = NULL;
+	unsigned int cap = 0, i = 0;
+	float total = 0, phase0;
+	float cx = 0, cy = 0, sx = 0, sy = 0;
+	int di = 0;		/* the dash being walked */
+	float left = 0;		/* of it */
+	bool pen = false;	/* the last point put down is where we are */
+	int k;
+
+	*len = 0;
+	for (k = 0; k < state->dash_n; k++)
+		total += state->dash[k];
+	phase0 = fmodf(state->dash_offset, total);
+	if (phase0 < 0)
+		phase0 += total;
+
+#define DASH_RESTART() do { \
+		float ph = phase0; \
+		di = 0; \
+		while (ph >= state->dash[di]) { \
+			ph -= state->dash[di]; \
+			di = (di + 1) % state->dash_n; \
+		} \
+		left = state->dash[di] - ph; \
+		pen = false; \
+	} while (0)
+
+	DASH_RESTART();
+
+	while (i < n) {
+		float pts[2 * 17];
+		int np = 0, j;
+		int cmd = (int) p[i];
+
+		switch (cmd) {
+		case svgtiny_PATH_MOVE:
+			cx = sx = p[i + 1];
+			cy = sy = p[i + 2];
+			i += 3;
+			DASH_RESTART();
+			continue;
+		case svgtiny_PATH_CLOSE:
+			pts[0] = sx;
+			pts[1] = sy;
+			np = 1;
+			i += 1;
+			break;
+		case svgtiny_PATH_LINE:
+			pts[0] = p[i + 1];
+			pts[1] = p[i + 2];
+			np = 1;
+			i += 3;
+			break;
+		case svgtiny_PATH_BEZIER:
+			for (j = 1; j <= 16; j++) {
+				float t = j / 16.0f, u = 1 - t;
+
+				pts[2 * (j - 1)] = u * u * u * cx +
+					3 * u * u * t * p[i + 1] +
+					3 * u * t * t * p[i + 3] +
+					t * t * t * p[i + 5];
+				pts[2 * (j - 1) + 1] = u * u * u * cy +
+					3 * u * u * t * p[i + 2] +
+					3 * u * t * t * p[i + 4] +
+					t * t * t * p[i + 6];
+			}
+			np = 16;
+			i += 7;
+			break;
+		default:
+			free(out);
+			*len = 0;
+			return NULL;
+		}
+
+		for (j = 0; j < np; j++) {
+			float x1 = pts[2 * j], y1 = pts[2 * j + 1];
+			float dx = x1 - cx, dy = y1 - cy;
+			float seg = sqrtf(dx * dx + dy * dy), done = 0;
+
+			while (seg - done > 0) {
+				float step = left < seg - done ? left :
+						seg - done;
+				float t0 = done / seg, t1 = (done + step) / seg;
+				bool on = (di % 2) == 0;
+
+				if (on) {
+					if (!svgtiny_dash_room(&out, len, &cap,
+							6)) {
+						free(out);
+						*len = 1;
+						return NULL;
+					}
+					if (!pen) {
+						out[(*len)++] =
+							svgtiny_PATH_MOVE;
+						out[(*len)++] = cx + dx * t0;
+						out[(*len)++] = cy + dy * t0;
+					}
+					out[(*len)++] = svgtiny_PATH_LINE;
+					out[(*len)++] = cx + dx * t1;
+					out[(*len)++] = cy + dy * t1;
+					pen = true;
+				} else {
+					pen = false;
+				}
+				done += step;
+				left -= step;
+				if (left <= 0) {
+					di = (di + 1) % state->dash_n;
+					left = state->dash[di];
+					if ((di % 2) == 0)
+						pen = false;
+				}
+			}
+			cx = x1;
+			cy = y1;
+		}
+		if (cmd == svgtiny_PATH_CLOSE)
+			pen = false;
+	}
+#undef DASH_RESTART
+
+	return out;
+}
+
+static svgtiny_code svgtiny_add_path_shape(float *p, unsigned int n,
+		struct svgtiny_parse_state *state);
+
 /**
  * Add a path to the svgtiny_diagram.
  */
 static svgtiny_code
 svgtiny_add_path(float *p, unsigned int n, struct svgtiny_parse_state *state)
+{
+	svgtiny_code res = svgtiny_OK;
+
+	/* a dashed stroke (VitaSurf): the fill is the whole path, and the
+	 * stroke is drawn along its dashes */
+	if (state->dash_n > 0 && state->stroke != svgtiny_TRANSPARENT &&
+			state->stroke != svgtiny_LINEAR_GRADIENT &&
+			state->fill != svgtiny_LINEAR_GRADIENT) {
+		svgtiny_colour fill = state->fill, stroke = state->stroke;
+		unsigned int dn = 0;
+		float *d = svgtiny_dash_path(p, n, state, &dn);
+
+		if (d == NULL && dn == 1) {
+			free(p);
+			return svgtiny_OUT_OF_MEMORY;
+		}
+		if (fill != svgtiny_TRANSPARENT) {
+			state->stroke = svgtiny_TRANSPARENT;
+			res = svgtiny_add_path_shape(p, n, state);
+			state->stroke = stroke;
+			p = NULL;
+		} else {
+			free(p);
+		}
+		if (res != svgtiny_OK || d == NULL) {
+			free(d);
+			return res;
+		}
+		state->fill = svgtiny_TRANSPARENT;
+		res = svgtiny_add_path_shape(d, dn, state);
+		state->fill = fill;
+		return res;
+	}
+
+	return svgtiny_add_path_shape(p, n, state);
+}
+
+/**
+ * Add a path to the svgtiny_diagram as it is.
+ */
+static svgtiny_code
+svgtiny_add_path_shape(float *p, unsigned int n,
+		struct svgtiny_parse_state *state)
 {
 	struct svgtiny_shape *shape;
 	svgtiny_code res = svgtiny_OK;
@@ -1294,6 +1506,8 @@ initialise_parse_state(struct svgtiny_parse_state *state,
 	state->fill = 0x000000;
 	state->stroke = svgtiny_TRANSPARENT;
 	state->stroke_width = 1;
+	state->dash_n = 0;
+	state->dash_offset = 0;
 	return svgtiny_OK;
 }
 
