  * We don't check the overall dispatch size here because we're not called unless
  * there is room in the fetch queue for us.
  */
+/*
+ * Local fetches (VitaSurf). max_fetchers and max_fetchers_per_host are
+ * there to share the network, but every fetch was counted: a page's
+ * data: images were one "host" of six at a time, behind the downloads
+ * for the twelve in all, and Home Assistant's 145 inline SVG icons
+ * spent minutes in the queue between them. A fetch that needs no
+ * network starts at once and holds no slot.
+ */
+static bool fetch_is_local(lwc_string *scheme)
+{
+	bool match;
+
+	if (lwc_string_isequal(scheme, corestring_lwc_http, &match) ==
+	    lwc_error_ok && match)
+		return false;
+	if (lwc_string_isequal(scheme, corestring_lwc_https, &match) ==
+	    lwc_error_ok && match)
+		return false;
+	return true;
+}
+
+/** The fetches in the fetch ring that hold a network slot. */
+static int fetch_count_network(lwc_string *host)
+{
+	struct fetch *f = fetch_ring;
+	int count = 0;
+	bool match;
+
+	if (f == NULL)
+		return 0;
+	do {
+		if (!f->local &&
+		    (host == NULL ||
+		     (lwc_string_isequal(f->host, host, &match) ==
+		      lwc_error_ok && match)))
+			count++;
+		f = f->r_next;
+	} while (f != fetch_ring);
+	return count;
+}
+
+/** Start every queued local fetch. */
+static void fetch_dispatch_local(void)
+{
+	struct fetch *q, *next;
+	int n;
+
+	RING_GETSIZE(struct fetch, queue_ring, n);
+	q = queue_ring;
+	while (n-- > 0 && q != NULL) {
+		next = q->r_next;
+		if (q->local)
+			fetch_dispatch_job(q);
+		q = (queue_ring == NULL) ? NULL : next;
+	}
+}
