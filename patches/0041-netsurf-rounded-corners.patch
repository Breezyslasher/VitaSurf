+/* ------------------------------------------------------------------ */
+/* Rounded corners (VitaSurf)                                         */
+
+/*
+ * border-radius reaches here as four pairs of computed lengths, one
+ * pair per corner: a horizontal radius and a vertical one. Nothing in
+ * layout changes; only the shapes drawn for the background and the
+ * border do, which is why this lives beside the border plotters.
+ */
+
+/** A quarter ellipse as a cubic: control points this far along each axis. */
+#define RADIUS_KAPPA 0.5522847498f
+
+/** Resolve one radius to device pixels. */
+static int
+radius_device_px(const struct box *box,
+		 const css_unit_ctx *unit_len_ctx,
+		 css_fixed value,
+		 css_unit unit,
+		 int percent_basis,
+		 float scale)
+{
+	if (unit == CSS_UNIT_PCT) {
+		/* already device pixels, so no further scaling */
+		return (int) (percent_basis * FIXTOFLT(value) / 100.0);
+	}
+
+	return (int) (FIXTOFLT(css_unit_len2device_px(box->style,
+			unit_len_ctx, value, unit)) * scale);
+}
+
+/**
+ * Work out a box's corner radii in device pixels.
+ *
+ * \return true if any corner is actually rounded.
+ */
+bool
+html_box_corner_radii(const struct box *box,
+		      const struct rect *border_box,
+		      const css_unit_ctx *unit_len_ctx,
+		      float scale,
+		      struct html_corner_radii *radii)
+{
+	css_fixed h = 0, v = 0;
+	css_unit hu = CSS_UNIT_PX, vu = CSS_UNIT_PX;
+	int width = border_box->x1 - border_box->x0;
+	int height = border_box->y1 - border_box->y0;
+	float f = 1.0f;
+	int sum;
+
+	if (box->style == NULL || width <= 0 || height <= 0) {
+		return false;
+	}
+
+	css_computed_border_top_left_radius(box->style, &h, &hu, &v, &vu);
+	radii->tl_h = radius_device_px(box, unit_len_ctx, h, hu, width, scale);
+	radii->tl_v = radius_device_px(box, unit_len_ctx, v, vu, height, scale);
+
+	css_computed_border_top_right_radius(box->style, &h, &hu, &v, &vu);
+	radii->tr_h = radius_device_px(box, unit_len_ctx, h, hu, width, scale);
+	radii->tr_v = radius_device_px(box, unit_len_ctx, v, vu, height, scale);
+
+	css_computed_border_bottom_right_radius(box->style, &h, &hu, &v, &vu);
+	radii->br_h = radius_device_px(box, unit_len_ctx, h, hu, width, scale);
+	radii->br_v = radius_device_px(box, unit_len_ctx, v, vu, height, scale);
+
+	css_computed_border_bottom_left_radius(box->style, &h, &hu, &v, &vu);
+	radii->bl_h = radius_device_px(box, unit_len_ctx, h, hu, width, scale);
+	radii->bl_v = radius_device_px(box, unit_len_ctx, v, vu, height, scale);
+
+	if (radii->tl_h <= 0 && radii->tl_v <= 0 &&
+	    radii->tr_h <= 0 && radii->tr_v <= 0 &&
+	    radii->br_h <= 0 && radii->br_v <= 0 &&
+	    radii->bl_h <= 0 && radii->bl_v <= 0) {
+		return false;
+	}
+
+	/*
+	 * Two radii sharing a side may together ask for more room than
+	 * the side has. CSS says to shrink every radius by the same
+	 * factor until they all fit, which is what keeps a pill shape a
+	 * pill rather than letting one end swallow the other.
+	 */
+	sum = radii->tl_h + radii->tr_h;
+	if (sum > width && sum > 0) {
+		f = min(f, (float) width / sum);
+	}
+	sum = radii->bl_h + radii->br_h;
+	if (sum > width && sum > 0) {
+		f = min(f, (float) width / sum);
+	}
+	sum = radii->tl_v + radii->bl_v;
+	if (sum > height && sum > 0) {
+		f = min(f, (float) height / sum);
+	}
+	sum = radii->tr_v + radii->br_v;
+	if (sum > height && sum > 0) {
+		f = min(f, (float) height / sum);
+	}
+
+	if (f < 1.0f) {
+		radii->tl_h *= f;	radii->tl_v *= f;
+		radii->tr_h *= f;	radii->tr_v *= f;
+		radii->br_h *= f;	radii->br_v *= f;
+		radii->bl_h *= f;	radii->bl_v *= f;
+	}
+
+	if (radii->tl_h < 0) radii->tl_h = 0;
+	if (radii->tl_v < 0) radii->tl_v = 0;
+	if (radii->tr_h < 0) radii->tr_h = 0;
+	if (radii->tr_v < 0) radii->tr_v = 0;
+	if (radii->br_h < 0) radii->br_h = 0;
+	if (radii->br_v < 0) radii->br_v = 0;
+	if (radii->bl_h < 0) radii->bl_h = 0;
+	if (radii->bl_v < 0) radii->bl_v = 0;
+
+	return true;
+}
+
+/** Append one path element, guarding the buffer. */
+#define PUSH(...) do {							\
+		float vals[] = { __VA_ARGS__ };				\
+		size_t nvals = sizeof(vals) / sizeof(vals[0]);		\
+		size_t k;						\
+		if (n + nvals > max) {					\
+			return 0;					\
+		}							\
+		for (k = 0; k < nvals; k++) {				\
+			p[n++] = vals[k];				\
+		}							\
+	} while (0)
+
+/**
+ * Build the outline of a rounded rectangle as a path.
+ *
+ * \return the number of floats written, or 0 if they would not fit.
+ */
+static unsigned int
+rounded_rect_path(float *p,
+		  unsigned int max,
+		  const struct rect *r,
+		  const struct html_corner_radii *radii)
+{
+	unsigned int n = 0;
+	float x0 = r->x0, y0 = r->y0, x1 = r->x1, y1 = r->y1;
+	float k = RADIUS_KAPPA;
+
+	PUSH(PLOTTER_PATH_MOVE, x0 + radii->tl_h, y0);
+
+	PUSH(PLOTTER_PATH_LINE, x1 - radii->tr_h, y0);
+	if (radii->tr_h > 0 || radii->tr_v > 0) {
+		PUSH(PLOTTER_PATH_BEZIER,
+		     x1 - radii->tr_h + radii->tr_h * k, y0,
+		     x1, y0 + radii->tr_v - radii->tr_v * k,
+		     x1, y0 + radii->tr_v);
+	}
+
+	PUSH(PLOTTER_PATH_LINE, x1, y1 - radii->br_v);
+	if (radii->br_h > 0 || radii->br_v > 0) {
+		PUSH(PLOTTER_PATH_BEZIER,
+		     x1, y1 - radii->br_v + radii->br_v * k,
+		     x1 - radii->br_h + radii->br_h * k, y1,
+		     x1 - radii->br_h, y1);
+	}
+
+	PUSH(PLOTTER_PATH_LINE, x0 + radii->bl_h, y1);
+	if (radii->bl_h > 0 || radii->bl_v > 0) {
+		PUSH(PLOTTER_PATH_BEZIER,
+		     x0 + radii->bl_h - radii->bl_h * k, y1,
+		     x0, y1 - radii->bl_v + radii->bl_v * k,
+		     x0, y1 - radii->bl_v);
+	}
+
+	PUSH(PLOTTER_PATH_LINE, x0, y0 + radii->tl_v);
+	if (radii->tl_h > 0 || radii->tl_v > 0) {
+		PUSH(PLOTTER_PATH_BEZIER,
+		     x0, y0 + radii->tl_v - radii->tl_v * k,
+		     x0 + radii->tl_h - radii->tl_h * k, y0,
+		     x0 + radii->tl_h, y0);
+	}
+
+	PUSH(PLOTTER_PATH_CLOSE);
+
+	return n;
+}
+
+#undef PUSH
+
+/** The identity, which is what the path plotters want for an unrotated box. */
+static const float rounded_transform[6] = { 1, 0, 0, 1, 0, 0 };
+
+/**
+ * Fill a rounded rectangle.
+ */
+nserror
+html_plot_rounded_fill(const struct redraw_context *ctx,
+		       const plot_style_t *pstyle,
+		       const struct rect *border_box,
+		       const struct html_corner_radii *radii)
+{
+	float path[64];
+	unsigned int n;
+	plot_style_t style = *pstyle;
+
+	n = rounded_rect_path(path, sizeof(path) / sizeof(path[0]),
+			      border_box, radii);
+	if (n == 0) {
+		return ctx->plot->rectangle(ctx, pstyle, border_box);
+	}
+
+	style.stroke_type = PLOT_OP_TYPE_NONE;
+
+	return ctx->plot->path(ctx, &style, path, n, rounded_transform);
+}
+
+/**
+ * Stroke a rounded rectangle, for a border that is the same all round.
+ */
+nserror
+html_plot_rounded_stroke(const struct redraw_context *ctx,
+			 const plot_style_t *pstyle,
+			 const struct rect *rect,
+			 const struct html_corner_radii *radii)
+{
+	float path[64];
+	unsigned int n;
+	plot_style_t style = *pstyle;
+
+	n = rounded_rect_path(path, sizeof(path) / sizeof(path[0]),
+			      rect, radii);
+	if (n == 0) {
+		return NSERROR_OK;
+	}
+
+	style.fill_type = PLOT_OP_TYPE_NONE;
+
+	return ctx->plot->path(ctx, &style, path, n, rounded_transform);
+}
