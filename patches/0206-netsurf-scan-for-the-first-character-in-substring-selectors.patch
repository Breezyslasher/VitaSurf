  */
+/** ASCII lower case, as strncasecmp compares (VitaSurf). */
+static inline unsigned char ascii_lower(unsigned char c)
+{
+	return (c >= 'A' && c <= 'Z') ? (unsigned char) (c + ('a' - 'A')) : c;
+}
