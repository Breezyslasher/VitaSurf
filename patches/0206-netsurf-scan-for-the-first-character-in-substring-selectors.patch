-		const char *last_start = start + len - vlen;
+		unsigned char c0 = ascii_lower((unsigned char) vdata[0]);
+		size_t i;
 
+		*match = false;
 		if (len >= vlen) {
-			while (start <= last_start) {
-				if (strncasecmp(start, vdata,
-						vlen) == 0) {
+			for (i = 0; i + vlen <= len; i++) {
+				if (ascii_lower((unsigned char) start[i]) == c0 &&
+				    (vlen == 1 ||
+				     strncasecmp(start + i + 1, vdata + 1,
+						 vlen - 1) == 0)) {
 					*match = true;
 					break;
 				}
-
-				start++;
 			}
 		}
 	}
