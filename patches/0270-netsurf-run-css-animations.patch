+/*
+ * Running animations (VitaSurf).
+ *
+ * libcss says, as it selects an element, whether an animation on it is
+ * still going at the clock css/select.c gives it. Such an element is
+ * held here, and each frame selects every one of them again: a change
+ * that only paints -- opacity, a transform, a colour -- is applied to
+ * the boxes in place and what they cover drawn again; a change to their
+ * size lays the document out again, which costs what it costs. The
+ * frame rate is css_animation_fps, and the log says every few seconds
+ * how many frames came, how many elements they moved and what
+ * selecting them took.
+ */
+
+/** Most elements animated at once; more wait for a free place. */
+#define HTML_ANIM_MAX 64
+
+static struct {
+	uint64_t since;
+	unsigned frames, elements, select_ms, worst_ms, relayouts;
+} html_anim_stats;
+
+static void html_animation_tick(void *p);
+
+static void html_animation_schedule(html_content *c)
+{
+	int fps = nsoption_int(css_animation_fps);
+
+	if (c->anim_scheduled)
+		return;
+	if (fps < 1)
+		fps = 1;
+	if (fps > 60)
+		fps = 60;
+	c->anim_scheduled = true;
+	guit->misc->schedule(1000 / fps, html_animation_tick, c);
+}
+
+/* exported interface documented in html/private.h */
+void html_animation_note(html_content *c, dom_node *node)
+{
+	unsigned i;
+
+	for (i = 0; i < c->n_anim; i++) {
+		if (c->anim[i] == node)
+			return;
+	}
+	if (c->anim == NULL) {
+		c->anim = calloc(HTML_ANIM_MAX, sizeof(*c->anim));
+		if (c->anim == NULL)
+			return;
+	}
+	if (c->n_anim >= HTML_ANIM_MAX)
+		return;
+	c->anim[c->n_anim++] = dom_node_ref(node);
+	html_animation_schedule(c);
+}
+
+/** Results held: enough for two frames of every element animated. */
+#define HTML_ANIM_HELD (2 * HTML_ANIM_MAX)
+
+/* exported interface documented in html/private.h */
+bool html_animation_hold(html_content *c, css_select_results *old)
+{
+	if (c->anim_held == NULL) {
+		c->anim_held = calloc(HTML_ANIM_HELD, sizeof(*c->anim_held));
+		if (c->anim_held == NULL)
+			return false;
+	}
+	if (c->anim_held[c->anim_held_next] != NULL)
+		css_select_results_destroy(c->anim_held[c->anim_held_next]);
+	c->anim_held[c->anim_held_next] = old;
+	c->anim_held_next = (c->anim_held_next + 1) % HTML_ANIM_HELD;
+	return true;
+}
+
+/* exported interface documented in html/private.h */
+void html_animation_drop(html_content *c)
+{
+	unsigned i;
+
+	if (c->anim_scheduled) {
+		guit->misc->schedule(-1, html_animation_tick, c);
+		c->anim_scheduled = false;
+	}
+	for (i = 0; i < c->n_anim; i++)
+		dom_node_unref(c->anim[i]);
+	c->n_anim = 0;
+	free(c->anim);
+	c->anim = NULL;
+	if (c->anim_held != NULL) {
+		for (i = 0; i < HTML_ANIM_HELD; i++) {
+			if (c->anim_held[i] != NULL)
+				css_select_results_destroy(c->anim_held[i]);
+		}
+		free(c->anim_held);
+		c->anim_held = NULL;
+	}
+}
+
+/** Add what an element's box covers to a rectangle, generously: a
+ * turned box reaches out past its own. */
+static void html_animation_area(dom_node *n, struct rect *area)
+{
+	struct box *box = NULL;
+	int x, y, w, h, reach;
+
+	if (dom_node_get_user_data(n, corestring_dom___ns_key_box_node_data,
+			(void *) &box) != DOM_NO_ERR || box == NULL)
+		return;
+	box_coords(box, &x, &y);
+	w = box->descendant_x1 - box->descendant_x0;
+	h = box->descendant_y1 - box->descendant_y0;
+	reach = (w > h ? w : h) / 2 + 8;
+	x += box->descendant_x0 - reach;
+	y += box->descendant_y0 - reach;
+	w += 2 * reach;
+	h += 2 * reach;
+	if (area->x0 > area->x1) {
+		area->x0 = x;
+		area->y0 = y;
+		area->x1 = x + w;
+		area->y1 = y + h;
+		return;
+	}
+	if (x < area->x0) area->x0 = x;
+	if (y < area->y0) area->y0 = y;
+	if (x + w > area->x1) area->x1 = x + w;
+	if (y + h > area->y1) area->y1 = y + h;
+}
+
+static void html_animation_tick(void *p)
+{
+	html_content *c = p;
+	dom_node *list[HTML_ANIM_MAX];
+	unsigned n, i, budget = 600, ms;
+	enum box_restyle result = BOX_RESTYLE_SAME, r;
+	struct rect area = { 1, 1, 0, 0 };
+	uint64_t t0 = 0, t1 = 0;
+
+	c->anim_scheduled = false;
+	if (!nsoption_bool(css_animations)) {
+		html_animation_drop(c);
+		return;
+	}
+	if (c->layout == NULL || c->bctx == NULL || c->reflowing ||
+			c->box_conversion_context != NULL) {
+		/* no tree to restyle yet: try on the next frame */
+		html_animation_schedule(c);
+		return;
+	}
+
+	/* each is noted again as it is selected, if it is still going */
+	n = c->n_anim;
+	memcpy(list, c->anim, n * sizeof(list[0]));
+	c->n_anim = 0;
+
+	nsu_getmonotonic_ms(&t0);
+	c->anim_restyling = true;
+	for (i = 0; i < n; i++) {
+		if (result != BOX_RESTYLE_LAYOUT) {
+			r = box_restyle(c, list[i], false, &budget);
+			if (r > result)
+				result = r;
+			html_animation_area(list[i], &area);
+		} else {
+			/* the relayout selects it again */
+			html_animation_note(c, list[i]);
+		}
+	}
+	c->anim_restyling = false;
+	nsu_getmonotonic_ms(&t1);
+	for (i = 0; i < n; i++)
+		dom_node_unref(list[i]);
+
+	if (result == BOX_RESTYLE_LAYOUT) {
+		html_anim_stats.relayouts++;
+		if (!c->dynamic_relayout_pending) {
+			c->dynamic_relayout_pending = true;
+			guit->misc->schedule(0, html_dynamic_relayout, c);
+		}
+	} else if (result == BOX_RESTYLE_PAINT && area.x0 < area.x1) {
+		content__request_redraw(&c->base, area.x0, area.y0,
+				area.x1 - area.x0, area.y1 - area.y0);
+	}
+
+	ms = (unsigned) (t1 - t0);
+	html_anim_stats.frames++;
+	html_anim_stats.elements += n;
+	html_anim_stats.select_ms += ms;
+	if (ms > html_anim_stats.worst_ms)
+		html_anim_stats.worst_ms = ms;
+	if (html_anim_stats.since == 0)
+		html_anim_stats.since = t1;
+	if (t1 - html_anim_stats.since >= 5000) {
+		unsigned span = (unsigned) (t1 - html_anim_stats.since);
+
+		vita_log("anim: %u frames in %u ms (%u a second), "
+				"%u elements a frame, selecting %u ms a "
+				"frame (worst %u), %u relayouts taking %u ms "
+				"each",
+				html_anim_stats.frames, span,
+				html_anim_stats.frames * 1000 / span,
+				html_anim_stats.elements /
+					html_anim_stats.frames,
+				html_anim_stats.select_ms /
+					html_anim_stats.frames,
+				html_anim_stats.worst_ms,
+				html_anim_stats.relayouts,
+				html_anim_stats.relayouts > 0 ?
+					html_anim_relayout_ms /
+					html_anim_stats.relayouts : 0);
+		memset(&html_anim_stats, 0, sizeof(html_anim_stats));
+		html_anim_relayout_ms = 0;
+	}
+
+	if (c->n_anim > 0)
+		html_animation_schedule(c);
+}
