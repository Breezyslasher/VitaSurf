+/*
+ * The animation clock (VitaSurf): milliseconds since animations were
+ * first run, and when each element's animation started on it. An
+ * element's start is noted the first time it is selected with that
+ * animation; the table holds a reference to each element so that its
+ * address is not reused while it is in the table, and the oldest entry
+ * makes way when the table is full, which starts that animation again.
+ */
+#define NSCSS_ANIM_STARTS 128
+
+static struct nscss_anim_start {
+	dom_node *node;
+	lwc_string *name;
+	uint32_t start;
+} nscss_anim_starts[NSCSS_ANIM_STARTS];
+static unsigned nscss_anim_next;
+static uint64_t nscss_anim_t0;
+
+static uint32_t nscss_anim_now(void)
+{
+	uint64_t now = 0;
+
+	nsu_getmonotonic_ms(&now);
+	if (nscss_anim_t0 == 0)
+		nscss_anim_t0 = now > 0 ? now : 1;
+	return (uint32_t) (now - nscss_anim_t0);
+}
+
+static css_error node_animation_start(void *pw, void *node,
+		lwc_string *name, uint32_t *start_ms)
+{
+	struct nscss_anim_start *e;
+	unsigned i;
+	bool match;
+
+	(void) pw;
+	for (i = 0; i < NSCSS_ANIM_STARTS; i++) {
+		e = &nscss_anim_starts[i];
+		if (e->node == node && e->name != NULL &&
+				lwc_string_isequal(e->name, name, &match) ==
+					lwc_error_ok && match) {
+			*start_ms = e->start;
+			return CSS_OK;
+		}
+	}
+	e = &nscss_anim_starts[nscss_anim_next];
+	nscss_anim_next = (nscss_anim_next + 1) % NSCSS_ANIM_STARTS;
+	if (e->node != NULL)
+		dom_node_unref(e->node);
+	if (e->name != NULL)
+		lwc_string_unref(e->name);
+	e->node = dom_node_ref((dom_node *) node);
+	e->name = lwc_string_ref(name);
+	e->start = nscss_anim_now();
+	*start_ms = e->start;
+	return CSS_OK;
+}
