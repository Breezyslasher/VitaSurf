+++ b/content/handlers/html/box_construct.c
@@ -3416,11 +3416,14 @@ static bool box_within(const struct box *b, const struct box *root)
 }
 
 /** Whether a box subtree holds what a hidden element cannot simply
- * drop: a form control, a frame, an HTML object. */
+ * drop: a frame, an HTML object. A form control can be (VitaSurf): it
+ * lives with the document, not its box, and lets go of the box as it
+ * does when a rebuild of the whole tree finds it hidden
+ * (hide_unlink_gadgets). */
 static bool hide_subtree_unsafe(const struct box *b, unsigned *count)
 {
 	for (; b != NULL; b = b->next) {
-		if (++*count > 4000 || b->gadget != NULL ||
+		if (++*count > 4000 ||
 				(b->flags & IFRAME) || b->iframe != NULL ||
 				(b->object != NULL &&
 				 content_get_type(b->object) == CONTENT_HTML))
@@ -3432,6 +3435,22 @@ static bool hide_subtree_unsafe(const struct box *b, unsigned *count)
 	return false;
 }
 
+/** The form controls of boxes leaving the tree let go of them; one
+ * built again takes its new box (VitaSurf). The controls' boxes had
+ * pointed at freed memory once a block was built again around them,
+ * so any block with a control in it had the whole tree built instead:
+ * ten times in one site test, the Guardian's 3.3 s and Stack Overflow's
+ * three of 1.3 to 2.3 s among them. */
+static void hide_unlink_gadgets(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->gadget != NULL && b->gadget->box == b)
+			b->gadget->box = NULL;
+		if (b->children != NULL)
+			hide_unlink_gadgets(b->children);
+	}
+}
+
 /** Take an element that has just been hidden out of the tree. False,
  * with nothing changed, if it cannot be done safely. */
 static bool box_hide_element(html_content *c, struct box *box)
@@ -3451,11 +3470,15 @@ static bool box_hide_element(html_content *c, struct box *box)
 	default:
 		return false;
 	}
-	if ((box->flags & DISPLAY_CONTENTS) || box->gadget != NULL ||
+	if ((box->flags & DISPLAY_CONTENTS) ||
 			(box->flags & IFRAME) || box->iframe != NULL ||
 			(box->children != NULL &&
 			 hide_subtree_unsafe(box->children, &count)))
 		return false;
+	if (box->gadget != NULL && box->gadget->box == box)
+		box->gadget->box = NULL;
+	if (box->children != NULL)
+		hide_unlink_gadgets(box->children);
 
 	/* the sticky and fixed boxes in it are no longer pinned */
 	if (c->pinned_boxes <= c->pinned_alloc) {
@@ -3747,8 +3770,7 @@ static bool rebuild_root_ok(html_content *c, dom_node *e, struct box *b,
 	if (b->children != NULL && hide_subtree_unsafe(b->children, &count)) {
 		restyle_why = count > 4000 ? "the blocks around the change "
 				"are too big to build on their own" :
-				"a form control, frame or object is near the "
-				"change";
+				"a frame or object is near the change";
 		*give_up = true;
 		return false;
 	}
