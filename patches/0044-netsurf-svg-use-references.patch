+/** Write an element's opening tag, with its namespaces if it is the root. */
+static void svg_serialise_open(struct svg_buf *b, dom_node *node)
+{
+	dom_string *name = svg_qualified_name(node);
+
+	if (name == NULL) {
+		return;
+	}
+	svg_buf_lit(b, "<");
 	svg_buf_append(b, dom_string_data(name),
 		       dom_string_byte_length(name));
+	svg_serialise_attributes(b, node, true);
 	svg_buf_lit(b, ">");
+	dom_string_unref(name);
+}
+
+/** Write an element's children, but not the element itself. */
+static void svg_serialise_children(struct svg_buf *b, dom_node *node)
+{
+	dom_node *child;
 
+	if (dom_node_get_first_child(node, &child) != DOM_NO_ERR) {
+		return;
+	}
+	while (child != NULL) {
+		dom_node *next = NULL;
+
+		svg_serialise_node(b, child, false);
+		if (dom_node_get_next_sibling(child, &next) != DOM_NO_ERR) {
+			dom_node_unref(child);
+			return;
+		}
+		dom_node_unref(child);
+		child = next;
+	}
+}
+
+/** Write an element's closing tag. Always one: deciding is not worth it. */
+static void svg_serialise_close(struct svg_buf *b, dom_node *node)
+{
+	dom_string *name = svg_qualified_name(node);
+
+	if (name == NULL) {
+		return;
+	}
+	svg_buf_lit(b, "</");
+	svg_buf_append(b, dom_string_data(name),
+		       dom_string_byte_length(name));
+	svg_buf_lit(b, ">");
 	dom_string_unref(name);
 }
 
