+/**
+ * Does this subtree contain anything that would be painted?
+ *
+ * A page that keeps its icons in one hidden <svg><defs> gets an element
+ * that draws nothing, and turning each of those into an image costs a
+ * copy of every icon in the sprite for no pixels at all. YouTube ships
+ * several (VitaSurf).
+ */
+static bool svg_paints_something(dom_node *node, unsigned int depth)
+{
+	dom_node *child;
+	bool found = false;
+
+	if (depth > 8) {
+		return true; /* too deep to tell: assume it does */
+	}
+
+	if (dom_node_get_first_child(node, &child) != DOM_NO_ERR) {
+		return false;
+	}
+
+	while (child != NULL && found == false) {
+		dom_node *next = NULL;
+		dom_node_type type = DOM_ELEMENT_NODE;
+		dom_string *name;
+
+		if (dom_node_get_node_type(child, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE) {
+			name = svg_qualified_name(child);
+			if (name != NULL) {
+				const char *n = dom_string_data(name);
+				size_t len = dom_string_byte_length(name);
+
+				if ((len == SLEN("defs") &&
+				     strncmp(n, "defs", len) == 0) ||
+				    (len == SLEN("symbol") &&
+				     strncmp(n, "symbol", len) == 0) ||
+				    (len == SLEN("title") &&
+				     strncmp(n, "title", len) == 0) ||
+				    (len == SLEN("desc") &&
+				     strncmp(n, "desc", len) == 0) ||
+				    (len == SLEN("metadata") &&
+				     strncmp(n, "metadata", len) == 0) ||
+				    (len == SLEN("style") &&
+				     strncmp(n, "style", len) == 0) ||
+				    (len == SLEN("script") &&
+				     strncmp(n, "script", len) == 0)) {
+					/* never painted where it stands */
+				} else if (len == SLEN("g") &&
+					   strncmp(n, "g", len) == 0) {
+					found = svg_paints_something(child,
+							depth + 1);
+				} else {
+					found = true;
+				}
+				dom_string_unref(name);
+			}
+		}
+
+		if (dom_node_get_next_sibling(child, &next) != DOM_NO_ERR) {
+			dom_node_unref(child);
+			return found;
+		}
+		dom_node_unref(child);
+		child = next;
+	}
+
+	return found;
+}
