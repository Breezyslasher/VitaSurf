+/*
+ * A <use> may point at a shape defined somewhere else in the page.
+ *
+ * Sites keep one hidden <svg> holding a <defs> of every icon and then
+ * refer to them by id, which is how YouTube draws its Home, Shorts and
+ * Library icons. Copying only the element's own subtree left those
+ * references pointing at nothing, so the icons came out blank. The
+ * referenced elements are gathered and written into the markup that is
+ * handed on, where the reference resolves again.
+ */
+
+#define SVG_MAX_REFS 64
+
+struct svg_refs {
+	dom_node *root;			/**< the element being written out */
+	dom_node *node[SVG_MAX_REFS];
+	unsigned int count;
+	bool full;
+};
+
+/** Is \a node inside \a root, or root itself? */
+static bool svg_node_contains(dom_node *root, dom_node *node)
+{
+	dom_node *walk = node;
+	unsigned int guard = 0;
+
+	if (root == NULL || node == NULL) {
+		return false;
+	}
+
+	dom_node_ref(walk);
+	while (walk != NULL && guard++ < 64) {
+		dom_node *parent = NULL;
+
+		if (walk == root) {
+			dom_node_unref(walk);
+			return true;
+		}
+		if (dom_node_get_parent_node(walk, &parent) != DOM_NO_ERR) {
+			dom_node_unref(walk);
+			return false;
+		}
+		dom_node_unref(walk);
+		walk = parent;
+	}
+	if (walk != NULL) {
+		dom_node_unref(walk);
+	}
+	return false;
+}
+
+static void svg_refs_collect(struct svg_refs *refs, dom_document *doc,
+			     dom_node *node, unsigned int depth);
+
+/** Note one id, unless it is already known. */
+static void svg_refs_add(struct svg_refs *refs, dom_document *doc,
+			 dom_string *id, unsigned int depth)
+{
+	dom_element *target = NULL;
+	unsigned int i;
+
+	if (refs->full || doc == NULL || id == NULL ||
+	    dom_string_byte_length(id) < 2 ||
+	    dom_string_data(id)[0] != '#') {
+		return;
+	}
+
+	/* the id itself, without the leading hash */
+	{
+		dom_string *bare = NULL;
+
+		if (dom_string_substr(id, 1, dom_string_length(id),
+				      &bare) != DOM_NO_ERR || bare == NULL) {
+			return;
+		}
+		if (dom_document_get_element_by_id(doc, bare,
+				&target) != DOM_NO_ERR) {
+			target = NULL;
+		}
+		dom_string_unref(bare);
+	}
+
+	if (target == NULL) {
+		return;
+	}
+
+	for (i = 0; i < refs->count; i++) {
+		if (refs->node[i] == (dom_node *) target) {
+			dom_node_unref(target);
+			return;
+		}
+	}
+
+	/*
+	 * Something the element already contains needs no copy, and
+	 * copying it would define the same id twice.
+	 */
+	if (svg_node_contains(refs->root, (dom_node *) target)) {
+		dom_node_unref(target);
+		return;
+	}
+
+	if (refs->count == SVG_MAX_REFS) {
+		refs->full = true;
+		dom_node_unref(target);
+		return;
+	}
+
+	refs->node[refs->count++] = (dom_node *) target;
+
+	/* what it refers to may refer on in turn */
+	svg_refs_collect(refs, doc, (dom_node *) target, depth + 1);
+}
+
+/** Walk a subtree noting every id a <use> refers to. */
+static void svg_refs_collect(struct svg_refs *refs, dom_document *doc,
+			     dom_node *node, unsigned int depth)
+{
+	dom_node *child;
+	dom_string *href = NULL;
+	dom_node_type type = DOM_ELEMENT_NODE;
+
+	if (refs->full || depth > 8) {
+		return;
+	}
+	if (dom_node_get_node_type(node, &type) != DOM_NO_ERR ||
+	    type != DOM_ELEMENT_NODE) {
+		return;
+	}
+
+	/*
+	 * Either spelling. xlink:href is the older one and still the
+	 * commoner in the wild, and it is a namespaced attribute, so it
+	 * has to be asked for by namespace rather than by the name it
+	 * was written under.
+	 */
+	if (dom_element_get_attribute(node, corestring_dom_href,
+			&href) == DOM_NO_ERR && href != NULL) {
+		svg_refs_add(refs, doc, href, depth);
+		dom_string_unref(href);
+	} else {
+		dom_string *ns = NULL;
+
+		if (dom_string_create(
+				(const uint8_t *) "http://www.w3.org/1999/xlink",
+				SLEN("http://www.w3.org/1999/xlink"),
+				&ns) == DOM_NO_ERR) {
+			if (dom_element_get_attribute_ns(node, ns,
+					corestring_dom_href,
+					&href) == DOM_NO_ERR && href != NULL) {
+				svg_refs_add(refs, doc, href, depth);
+				dom_string_unref(href);
+			}
+			dom_string_unref(ns);
+		}
+	}
+
+	if (dom_node_get_first_child(node, &child) != DOM_NO_ERR) {
+		return;
+	}
+	while (child != NULL) {
+		dom_node *next = NULL;
+
+		svg_refs_collect(refs, doc, child, depth);
+		if (dom_node_get_next_sibling(child, &next) != DOM_NO_ERR) {
+			dom_node_unref(child);
+			return;
+		}
+		dom_node_unref(child);
+		child = next;
+	}
+}
+
+static void svg_refs_free(struct svg_refs *refs)
+{
+	unsigned int i;
+
+	for (i = 0; i < refs->count; i++) {
+		dom_node_unref(refs->node[i]);
+	}
+	refs->count = 0;
+}
