+#ifdef __vita__
+/*
+ * Where the scheduler's time went, by callback (VitaSurf). Scrolling
+ * Yamtrack spent 300 to 500 ms of each second in the scheduler and
+ * nothing said in what: callbacks slower than 200 ms are logged one
+ * by one, but this was many short ones. Reported once a second with
+ * the frame line while the scheduler takes a good part of it.
+ */
+#define SCHED_TOP_SLOTS 24
+
+static struct {
+	void (*callback)(void *p);
+	unsigned int us;
+	unsigned int calls;
+} sched_top[SCHED_TOP_SLOTS];
+
+static void sched_top_add(void (*callback)(void *p), unsigned int us)
+{
+	int i, low = 0;
+
+	for (i = 0; i < SCHED_TOP_SLOTS; i++) {
+		if (sched_top[i].callback == callback) {
+			sched_top[i].us += us;
+			sched_top[i].calls++;
+			return;
+		}
+		if (sched_top[i].us < sched_top[low].us) {
+			low = i;
+		}
+	}
+	/* a new one takes the place of the least, or an empty one */
+	sched_top[low].callback = callback;
+	sched_top[low].us = us;
+	sched_top[low].calls = 1;
+}
+
+/* exported function documented in framebuffer/schedule.h */
+void schedule_take_top(char *buf, size_t len)
+{
+	size_t used = 0;
+	int n, i;
+
+	if (len == 0) {
+		return;
+	}
+	buf[0] = '\0';
+	for (n = 0; n < 5; n++) {
+		int best = -1;
+		int w;
+
+		for (i = 0; i < SCHED_TOP_SLOTS; i++) {
+			if (sched_top[i].calls != 0 &&
+			    (best < 0 || sched_top[i].us > sched_top[best].us)) {
+				best = i;
+			}
+		}
+		if (best < 0 || sched_top[best].us < 1000) {
+			break;
+		}
+		w = snprintf(buf + used, len - used, "%s%08x %u ms in %u",
+			     n > 0 ? ", " : "",
+			     (unsigned int)(uintptr_t)sched_top[best].callback,
+			     sched_top[best].us / 1000,
+			     sched_top[best].calls);
+		if (w < 0 || (size_t)w >= len - used) {
+			break;
+		}
+		used += w;
+		sched_top[best].calls = 0;
+	}
+	for (i = 0; i < SCHED_TOP_SLOTS; i++) {
+		sched_top[i].callback = NULL;
+		sched_top[i].us = 0;
+		sched_top[i].calls = 0;
+	}
+}
+#endif
+
