+                                              (unsigned int)
+                                              ((c1.tv_sec - c0.tv_sec) *
+                                               1000000 +
+                                               (c1.tv_usec - c0.tv_usec)));
+#endif
                                 if (took > vitasurf_ms_sched_max) {
                                         vitasurf_ms_sched_max = took;
                                 }
