+ */
+static char restyle_boxes_why[200];
+
+static const char *restyle_boxes_detail(const struct box *box,
+		const css_select_results *a, const css_select_results *b)
+{
+	const css_computed_style *sa = a->styles[CSS_PSEUDO_ELEMENT_NONE];
+	const css_computed_style *sb = b->styles[CSS_PSEUDO_ELEMENT_NONE];
+	const char *what = "a property the boxes are built from";
+	char name[24] = "?", cls[48] = "";
+	int i;
+
+	for (i = 1; i < CSS_PSEUDO_ELEMENT_COUNT; i++) {
+		if ((a->styles[i] == NULL) != (b->styles[i] == NULL)) {
+			what = "a ::before, ::after or other pseudo-element "
+				"appears or goes";
+			break;
+		}
+	}
+	if (i == CSS_PSEUDO_ELEMENT_COUNT && sa != NULL && sb != NULL) {
+		lwc_string **fa = NULL, **fb = NULL;
+		lwc_string *ia = NULL, *ib = NULL;
+		const css_computed_content_item *ca = NULL, *cb = NULL;
+
+		if (ns_computed_display(sa, false) !=
+				ns_computed_display(sb, false))
+			what = "display";
+		else if (css_computed_position(sa) !=
+				css_computed_position(sb))
+			what = "position";
+		else if (css_computed_float(sa) != css_computed_float(sb))
+			what = "float";
+		else if (css_computed_white_space(sa) !=
+				css_computed_white_space(sb))
+			what = "white-space";
+		else if (css_computed_text_transform(sa) !=
+				css_computed_text_transform(sb))
+			what = "text-transform";
+		else if (css_computed_font_family(sa, &fa) !=
+				css_computed_font_family(sb, &fb) || fa != fb)
+			what = "font-family";
+		else if (css_computed_content(sa, &ca) !=
+				css_computed_content(sb, &cb) || ca != cb)
+			what = "content";
+		else if (css_computed_background_image(sa, &ia) !=
+				css_computed_background_image(sb, &ib) ||
+				ia != ib)
+			what = "background-image";
+		else if (css_computed_list_style_type(sa) !=
+				css_computed_list_style_type(sb))
+			what = "list-style-type";
+		else if (!css_computed_style_same_boxes(sa, sb))
+			what = "another property the boxes are built from";
+		else if ((box->flags & IS_REPLACED) != 0)
+			what = "a replaced element's width or height";
+		else
+			what = "the overflow of the root or the body";
