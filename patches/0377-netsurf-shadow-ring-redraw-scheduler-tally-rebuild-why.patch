+					dom_string_data(n));
+			dom_string_unref(n);
+		}
+		if (dom_element_get_attribute(box->node, corestring_dom_class,
+				&c) == DOM_NO_ERR && c != NULL) {
+			snprintf(cls, sizeof(cls), " class \"%.*s\"",
+					(int) dom_string_byte_length(c) > 40 ?
+					40 : (int) dom_string_byte_length(c),
+					dom_string_data(c));
+			dom_string_unref(c);
+		}
+	}
+	snprintf(restyle_boxes_why, sizeof(restyle_boxes_why),
+			"the new style changes the boxes (%s, on %s%s)",
+			what, name, cls);
