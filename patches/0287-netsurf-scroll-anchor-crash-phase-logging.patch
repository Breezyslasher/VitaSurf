+/**
+ * A node's principal box, found in the tree that exists.
+ *
+ * Not box_for_node() alone. A rebuild clears the box a node points at
+ * only for the nodes still in the document; a node script removed in the
+ * meantime keeps pointing into the tree the rebuild freed, and reading it
+ * crashed build 504 on a Home Assistant dashboard. The pointer is only
+ * compared here, never followed: a box that is in this tree, is the
+ * node's, and is the one the node names.
+ */
+static struct box *sa_find(struct box *root, struct dom_node *node)
+{
+	struct box *b = root;
+
+	while (b != NULL) {
+		if (b->node == node && box_for_node(node) == b) {
+			return b;
+		}
+		if (b->children != NULL) {
+			b = b->children;
+			continue;
+		}
+		while (b != NULL && b != root && b->next == NULL) {
+			b = b->parent;
+		}
+		if (b == NULL || b == root) {
+			break;
+		}
+		b = b->next;
+	}
+	return NULL;
+}
+
