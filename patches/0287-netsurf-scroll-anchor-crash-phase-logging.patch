+/*
+ * What the main thread is doing, for the Vita's busy sampling (VitaSurf):
+ * the overlay thread reads it on every frame the page holds the screen
+ * and no script binding is named, so a long stall is put down to the
+ * phase it was in -- layout, box building, a style sheet, drawing,
+ * script -- rather than to "script or NetSurf". Set with
+ * VITASURF_PHASE() and put back with VITASURF_PHASE_END() in the same
+ * scope.
+ */
+extern const char *volatile vitasurf_phase;
+#define VITASURF_PHASE(name) \
+	const char *vitasurf_phase_was_ = vitasurf_phase; \
+	vitasurf_phase = (name)
+#define VITASURF_PHASE_END() (vitasurf_phase = vitasurf_phase_was_)
 /**
  * What laying the page out actually did (VitaSurf).
  *
