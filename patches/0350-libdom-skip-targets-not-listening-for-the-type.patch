+
+/*
+ * The bit an event type sets in a target's type_mask (VitaSurf). Every
+ * event dispatched to a node, the mutation events libdom sends itself on
+ * each change included, looked through the listeners of each ancestor
+ * that had any, comparing each one's type: on a Home Assistant
+ * dashboard, whose components listen for many things high in the tree,
+ * that was a hundred string comparisons an event and 1% of the load.
+ * An ancestor whose mask lacks the event's bit is passed over.
+ */
+uint32_t _dom_event_type_bit(dom_string *type)
+{
+	const unsigned char *d = (const unsigned char *) dom_string_data(type);
+	size_t len = dom_string_byte_length(type);
+
+	if (len == 0)
+		return 1;
+	return (uint32_t) 1 << ((len + d[0] * 7u + d[len - 1] * 13u +
+			d[len / 2] * 3u) & 31);
 }
 
