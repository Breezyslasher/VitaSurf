diff --git a/frontends/framebuffer/bitmap.c b/frontends/framebuffer/bitmap.c
index c9b58541e..74ad2b4a4 100644
--- a/frontends/framebuffer/bitmap.c
+++ b/frontends/framebuffer/bitmap.c
@@ -33,6 +33,7 @@
 #include "netsurf/bitmap.h"
 #include "netsurf/plotters.h"
 #include "netsurf/content.h"
+#include "desktop/bitmap.h"
 
 #include "framebuffer/gui.h"
 #include "framebuffer/fbtk.h"
@@ -269,6 +270,116 @@ bitmap_render(struct bitmap *bitmap,
 	return NSERROR_OK;
 }
 
+/*
+ * vitasurf_raster() for the framebuffer (VitaSurf): the plot calls are
+ * made twice, into scratch surfaces cleared to black and to white, and
+ * each pixel's coverage is how far the two differ -- the same on both
+ * where something opaque was drawn, black against white where nothing
+ * was. The plotters write every pixel opaque, so this is the one way to
+ * learn what they left transparent.
+ */
+nserror vitasurf_raster(int width, int height,
+		bool (*draw)(const struct redraw_context *ctx, void *pw),
+		void *pw, struct bitmap **out)
+{
+	struct redraw_context ctx = {
+		.interactive = false,
+		.background_images = true,
+		.plot = &fb_plotters
+	};
+	struct rect clip;
+	nsfb_t *surf[2] = { NULL, NULL };
+	uint8_t *src[2];
+	int srcstride[2];
+	nsfb_t *current;
+	struct bitmap *bm;
+	uint8_t *dst;
+	size_t dststride;
+	bool opaque = true, ok = true;
+	int k, x, y;
+
+	*out = NULL;
+	if (width <= 0 || height <= 0) {
+		return NSERROR_BAD_PARAMETER;
+	}
+	clip.x0 = 0;
+	clip.y0 = 0;
+	clip.x1 = width;
+	clip.y1 = height;
+	for (k = 0; k < 2; k++) {
+		plot_style_t bg = {
+			.stroke_type = PLOT_OP_TYPE_NONE,
+			.fill_type = PLOT_OP_TYPE_SOLID,
+			.fill_colour = k == 0 ? 0x000000 : 0xffffff
+		};
+
+		surf[k] = nsfb_new(NSFB_SURFACE_RAM);
+		if (surf[k] == NULL ||
+		    nsfb_set_geometry(surf[k], width, height,
+				      NSFB_FMT_XBGR8888) == -1 ||
+		    nsfb_init(surf[k]) == -1) {
+			ok = false;
+			break;
+		}
+		current = framebuffer_set_surface(surf[k]);
+		fb_plotters.clip(&ctx, &clip);
+		fb_plotters.rectangle(&ctx, &bg, &clip);
+		ok = draw(&ctx, pw);
+		framebuffer_set_surface(current);
+		if (!ok) {
+			break;
+		}
+		nsfb_get_buffer(surf[k], &src[k], &srcstride[k]);
+	}
+	bm = ok ? bitmap_create(width, height, BITMAP_NONE) : NULL;
+	if (bm == NULL) {
+		for (k = 0; k < 2; k++) {
+			if (surf[k] != NULL) nsfb_free(surf[k]);
+		}
+		return ok ? NSERROR_NOMEM : NSERROR_INVALID;
+	}
+	dst = bitmap_get_buffer(bm);
+	dststride = bitmap_get_rowstride(bm);
+	for (y = 0; y < height; y++) {
+		const uint32_t *pb = (const uint32_t *)(void *)
+			(src[0] + (size_t)y * (size_t)srcstride[0]);
+		const uint32_t *pw_ = (const uint32_t *)(void *)
+			(src[1] + (size_t)y * (size_t)srcstride[1]);
+		uint8_t *dp = dst + (size_t)y * dststride;
+
+		for (x = 0; x < width; x++, dp += 4) {
+			uint32_t b = pb[x], w = pw_[x];
+			int cb[3], d = 0, i, a;
+
+			for (i = 0; i < 3; i++) {
+				int vb = (int)((b >> (8 * i)) & 0xff);
+				int vw = (int)((w >> (8 * i)) & 0xff);
+
+				cb[i] = vb;
+				if (vw - vb > d) d = vw - vb;
+			}
+			a = 255 - d;
+			if (a < 255) opaque = false;
+			for (i = 0; i < 3; i++) {
+				/* the colour, undone from its blend
+				 * onto black */
+				cb[i] = a > 0 ? cb[i] * 255 / a : 0;
+				if (cb[i] > 255) cb[i] = 255;
+			}
+			dp[bitmap_layout.r] = (uint8_t)cb[0];
+			dp[bitmap_layout.g] = (uint8_t)cb[1];
+			dp[bitmap_layout.b] = (uint8_t)cb[2];
+			dp[bitmap_layout.a] = (uint8_t)a;
+		}
+	}
+	nsfb_free(surf[0]);
+	nsfb_free(surf[1]);
+	bitmap_set_opaque(bm, opaque);
+	bitmap_modified(bm);
+	*out = bm;
+	return NSERROR_OK;
+}
+
 static struct gui_bitmap_table bitmap_table = {
 	.create = bitmap_create,
 	.destroy = bitmap_destroy,
