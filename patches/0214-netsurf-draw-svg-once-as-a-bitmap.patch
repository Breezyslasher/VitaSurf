+/**
+ * Draw into a new bitmap of width by height (VitaSurf).
+ *
+ * draw() is called to plot what the bitmap is to hold, with a redraw
+ * context whose plotters write into it and a clip of the whole bitmap;
+ * what it leaves unpainted comes out transparent. A frontend that can
+ * do this defines it; for any other the symbol is NULL and callers keep
+ * plotting as they did.
+ *
+ * eturn NSERROR_OK with the bitmap in *out, or an error and no bitmap
+ */
+nserror vitasurf_raster(int width, int height,
+		bool (*draw)(const struct redraw_context *ctx, void *pw),
+		void *pw, struct bitmap **out) __attribute__((weak));
