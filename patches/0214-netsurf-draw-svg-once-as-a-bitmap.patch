 	}
 
 	if ((data->repeat_x == false) && (data->repeat_y == false)) {
+		struct bitmap *bm = svg_raster_for(svg, data);
+
+		if (bm != NULL) {
+			return ctx->plot->bitmap(ctx, bm, data->x, data->y,
+					data->width, data->height,
+					data->background_colour,
+					BITMAPF_NONE) == NSERROR_OK;
+		}
 		/* Simple case: SVG is not tiled */
 		return svg_redraw_internal(svg, data->x, data->y,
 				data->width, data->height,
@@ -659,6 +776,7 @@ static void svg_destroy(struct content *c)
 {
 	svg_content *svg = (svg_content *) c;
 
+	svg_raster_free(svg);
 	if (svg->diagram != NULL)
 		svgtiny_free(svg->diagram);
 }
