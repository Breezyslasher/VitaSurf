--- a/content/handlers/image/svg.c
+++ b/content/handlers/image/svg.c
@@ -38,6 +38,28 @@
 #include "content/content_factory.h"
 
 #include "image/svg.h"
+#include "desktop/gui_internal.h"
+#include "desktop/bitmap.h"
+
+/*
+ * Drawn once, plotted as an image after (VitaSurf). svgtiny's paths were
+ * flattened and filled again on every redraw, and a page of icons is the
+ * same few small graphics over and over: Yamtrack scrolled with 1700 to
+ * 2400 path plots a second. Each graphic keeps its rendering at the last
+ * few sizes it was drawn at, within a bound for all of them together;
+ * past that, or where the frontend cannot draw into a bitmap, it is
+ * plotted as paths as before.
+ */
+#define SVG_RASTER_SIZES 4
+#define SVG_RASTER_MAX_PIXELS (256 * 256)
+#define SVG_RASTER_MAX_BYTES (4 * 1024 * 1024)
+
+struct svg_raster {
+	int width, height;
+	struct bitmap *bitmap;
+};
+
+static size_t svg_raster_bytes;
 
 typedef struct svg_content {
 	struct content base;
@@ -46,8 +68,24 @@ typedef struct svg_content {
 
 	int current_width;
 	int current_height;
+
+	struct svg_raster raster[SVG_RASTER_SIZES];
+	unsigned int raster_n;
 } svg_content;
 
+/** Free every cached rendering: the graphic changed, or is going. */
+static void svg_raster_free(svg_content *svg)
+{
+	unsigned int i;
+
+	for (i = 0; i < svg->raster_n; i++) {
+		guit->bitmap->destroy(svg->raster[i].bitmap);
+		svg_raster_bytes -= (size_t)svg->raster[i].width *
+			(size_t)svg->raster[i].height * 4;
+	}
+	svg->raster_n = 0;
+}
+
 
 
 static nserror svg_create_svg_data(svg_content *c)
@@ -444,6 +482,7 @@ static void svg_reformat(struct content *c, int width, int height)
 		return;
 	}
 
+	svg_raster_free(svg);
 	svg_parse_at(svg, width, height);
 }
 
@@ -621,6 +660,76 @@ svg_redraw_tiled_internal(svg_content *svg,
 }
 
 
+struct svg_raster_draw {
+	svg_content *svg;
+	int width, height;
+	float scale;
+	colour background;
+};
+
+static bool svg_raster_draw_cb(const struct redraw_context *ctx, void *pw)
+{
+	struct svg_raster_draw *d = pw;
+	struct rect clip;
+
+	clip.x0 = 0;
+	clip.y0 = 0;
+	clip.x1 = d->width;
+	clip.y1 = d->height;
+	return svg_redraw_internal(d->svg, 0, 0, d->width, d->height, &clip,
+			ctx, d->scale, d->background, false, 0);
+}
+
+/**
+ * The graphic drawn at this size as a bitmap, made now if it can be;
+ * NULL to plot it as paths.
+ */
+static struct bitmap *
+svg_raster_for(svg_content *svg, const struct content_redraw_data *data)
+{
+	struct svg_raster_draw d;
+	struct svg_raster *r;
+	struct bitmap *bm = NULL;
+	size_t bytes;
+	unsigned int i;
+
+	if (vitasurf_raster == NULL || data->mask ||
+	    data->width <= 0 || data->height <= 0 ||
+	    (size_t)data->width * (size_t)data->height >
+			SVG_RASTER_MAX_PIXELS) {
+		return NULL;
+	}
+	for (i = 0; i < svg->raster_n; i++) {
+		if (svg->raster[i].width == data->width &&
+		    svg->raster[i].height == data->height) {
+			return svg->raster[i].bitmap;
+		}
+	}
+	/* Not freed to make room: knockout plots queued earlier in this
+	 * redraw may still hold an older size. */
+	bytes = (size_t)data->width * (size_t)data->height * 4;
+	if (svg->raster_n >= SVG_RASTER_SIZES ||
+	    svg_raster_bytes + bytes > SVG_RASTER_MAX_BYTES) {
+		return NULL;
+	}
+	d.svg = svg;
+	d.width = data->width;
+	d.height = data->height;
+	d.scale = data->scale;
+	d.background = data->background_colour;
+	if (vitasurf_raster(data->width, data->height, svg_raster_draw_cb,
+			    &d, &bm) != NSERROR_OK || bm == NULL) {
+		return NULL;
+	}
+	r = &svg->raster[svg->raster_n++];
+	r->width = data->width;
+	r->height = data->height;
+	r->bitmap = bm;
+	svg_raster_bytes += bytes;
+	return bm;
+}
+
+
 /**
  * Redraw a CONTENT_SVG.
  */
