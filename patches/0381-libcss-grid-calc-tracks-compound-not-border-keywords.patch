+/**
+ * Whether a compound holds more than one simple selector, as dialog[open]
+ * or .a.b do: libcss's own :not() takes one, so such a compound goes the
+ * way of a complex selector (VitaSurf).
+ */
+static bool sel_is_compound(const char *s, size_t n)
+{
+	size_t i;
+	int depth = 0, parts = 0;
+
+	for (i = 0; i < n; i++) {
+		char c = s[i];
+
+		if (c == '\\') {
+			if (i == 0)
+				parts++;
+			i++;
+			continue;
+		}
+		if (depth == 0 && (c == '.' || c == '#' || c == '[' ||
+				(c == ':' && (i == 0 || s[i - 1] != ':')) ||
+				(i == 0 && c != ':')))
+			parts++;
+		if (c == '(' || c == '[')
+			depth++;
+		else if (c == ')' || c == ']')
+			depth--;
+		else if (c == '"' || c == '\'') {
+			char q = c;
+
+			for (i++; i < n && s[i] != q; i++)
+				if (s[i] == '\\')
+					i++;
+		}
+	}
+	return parts > 1;
+}
