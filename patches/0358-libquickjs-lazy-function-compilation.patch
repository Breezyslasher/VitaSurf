+        return false;
+    }
+    /* the source must be the parse's own, for the offsets */
+    if (fd->source_len < JS_LAZY_MIN_SOURCE || s->with_depth > 0 ||
+        !fd->lazy_params || !fd->source_blob)
+        return false;
+    if (js_lazy_called_here(s))
+        return false;
+    /* a direct eval sees every variable around it */
+    if (js_lazy_has_eval(fd))
+        return false;
+    return !js_lazy_in_eval_reach(s, fd, fd->lazy_params);
+}
