+static bool js_lazy_has_eval(JSFunctionDef *fd)
+{
+    struct list_head *el;
+
+    if (fd->has_eval_call)
+        return true;
+    list_for_each(el, &fd->child_list) {
+        JSFunctionDef *fd1 = list_entry(el, JSFunctionDef, link);
+        /* a lazy function was checked when it was left */
+        if (!fd1->is_lazy && js_lazy_has_eval(fd1))
+            return true;
+    }
+    return false;
+}
