+/* whether name, used at scope_level of d, is a variable of d's own;
+   what resolve_scope_var looks at before it leaves d */
+static bool js_lazy_bound_in(JSContext *ctx, JSFunctionDef *d, JSAtom name,
+                             int scope_level, bool is_private)
+{
+    bool with;
+    int idx;
+
+    if (is_private)
+        return find_private_class_field_all(ctx, d, name, scope_level) >= 0;
+    idx = scope_chain_find(ctx, d, scope_level, name, &with);
+    if (idx >= 0)
+        return true;
+    if (idx != ARG_SCOPE_END && find_var(ctx, d, name) >= 0)
+        return true;
+    if ((name == JS_ATOM_home_object || name == JS_ATOM_this_active_func ||
+         name == JS_ATOM_new_target || name == JS_ATOM_this) &&
+        d->has_this_binding)
+        return true;
+    if (name == JS_ATOM_arguments && d->has_arguments_binding)
+        return true;
+    if (d->is_func_expr && d->func_name == name)
+        return true;
+    return false;
+}
+
+/* a set of names, each with whether it is a #name */
+typedef struct JSLazySet {
+    JSAtom *names;
+    uint8_t *priv;
+    int count, size;
+    int *hash;
+    int hash_size;
+} JSLazySet;
+
+static void js_lazy_set_free(JSContext *ctx, JSLazySet *set)
+{
+    int i;
+
+    for (i = 0; i < set->count; i++)
+        JS_FreeAtom(ctx, set->names[i]);
+    js_free(ctx, set->names);
+    js_free(ctx, set->priv);
+    js_free(ctx, set->hash);
+    memset(set, 0, sizeof(*set));
+}
+
+static int js_lazy_set_add(JSContext *ctx, JSLazySet *set, JSAtom name,
+                           bool is_private)
+{
+    int i, j, n, *t;
+    uint32_t h;
+
+    if ((set->count + 1) * 2 > set->hash_size) {
+        /* at most half full, with the names the set may already have
+           without a table (js_lazy_set_take) */
+        n = set->hash_size ? set->hash_size * 2 : 64;
+        while ((set->count + 1) * 2 > n)
+            n *= 2;
+        t = js_malloc(ctx, sizeof(int) * n);
+        if (!t)
+            return -1;
+        memset(t, 0xff, sizeof(int) * n);
+        for (i = 0; i < set->count; i++) {
+            h = (set->names[i] * 2654435761u) & (n - 1);
+            while (t[h] >= 0)
+                h = (h + 1) & (n - 1);
+            t[h] = i;
+        }
+        js_free(ctx, set->hash);
+        set->hash = t;
+        set->hash_size = n;
+    }
+    h = (name * 2654435761u) & (set->hash_size - 1);
+    while ((j = set->hash[h]) >= 0) {
+        if (set->names[j] == name && set->priv[j] == is_private)
+            return 0;
+        h = (h + 1) & (set->hash_size - 1);
+    }
+    if (set->count >= set->size) {
+        JSAtom *names;
+        uint8_t *priv;
+
+        n = set->size ? set->size * 2 : 16;
+        names = js_realloc(ctx, set->names, sizeof(JSAtom) * n);
+        if (!names)
+            return -1;
+        set->names = names;
+        priv = js_realloc(ctx, set->priv, n);
+        if (!priv)
+            return -1;
+        set->priv = priv;
+        set->size = n;
+    }
+    set->hash[h] = set->count;
+    set->names[set->count] = JS_DupAtom(ctx, name);
+    set->priv[set->count] = is_private;
+    set->count++;
+    return 0;
+}
+
+/* add name, used at scope_level of d, unless it is a variable of d */
+static int js_lazy_use(JSContext *ctx, JSLazySet *out, JSFunctionDef *d,
+                       JSAtom name, int scope_level, bool is_private)
+{
+    if (js_lazy_bound_in(ctx, d, name, scope_level, is_private))
+        return 0;
+    return js_lazy_set_add(ctx, out, name, is_private);
+}
+
+/* the names d and the functions in it use that d does not declare,
+   each name once however often it is used */
+static int js_lazy_free_names(JSContext *ctx, JSFunctionDef *d,
+                              JSLazySet *out)
+{
+    const uint8_t *bc = d->byte_code.buf;
+    int pos = 0, len = d->byte_code.size, op, i, r;
+    bool is_private;
+    struct list_head *el;
+    /* the uses just looked at: a name is mostly used where it was
+       used last */
+    uint32_t seen[64];
+
+    memset(seen, 0, sizeof(seen));
+    /* d is whole: link its scopes as they will be, and remember the
+       lookups, as js_create_function would */
+    js_relink_scopes(d);
+    d->chains_final = true;
+    while (pos < len) {
+        int scope_pos;
+        uint32_t key;
+
+        op = bc[pos];
+        switch (op) {
+        case OP_scope_get_var_undef:
+        case OP_scope_get_var:
+        case OP_scope_put_var:
+        case OP_scope_delete_var:
+        case OP_scope_get_ref:
+        case OP_scope_put_var_init:
+            scope_pos = 5;
+            is_private = false;
+            goto use;
+        case OP_scope_make_ref:
+            scope_pos = 9;
+            is_private = false;
+            goto use;
+        case OP_scope_get_private_field:
+        case OP_scope_get_private_field2:
+        case OP_scope_put_private_field:
+        case OP_scope_in_private_field:
+            scope_pos = 5;
+            is_private = true;
+        use:
+            key = get_u32(bc + pos + 1) * 4 + is_private +
+                (get_u16(bc + pos + scope_pos) << 20) + 1;
+            if (seen[(key ^ (key >> 7)) & 63] == key)
+                break;
+            seen[(key ^ (key >> 7)) & 63] = key;
+            if (js_lazy_use(ctx, out, d, get_u32(bc + pos + 1),
+                            get_u16(bc + pos + scope_pos), is_private))
+                return -1;
+            break;
+        }
+        pos += opcode_info[op].size;
+    }
+    list_for_each(el, &d->child_list) {
+        JSFunctionDef *c = list_entry(el, JSFunctionDef, link);
+        if (c->is_lazy) {
+            /* left already: what it uses from outside itself */
+            for (i = 0; i < c->lazy_name_count; i++) {
+                if (js_lazy_use(ctx, out, d, c->lazy_names[i],
+                                c->parent_scope_level, c->lazy_private[i]))
+                    return -1;
+            }
+        } else {
+            JSLazySet tmp;
+
+            memset(&tmp, 0, sizeof(tmp));
+            r = js_lazy_free_names(ctx, c, &tmp);
+            for (i = 0; i < tmp.count && !r; i++) {
+                r = js_lazy_use(ctx, out, d, tmp.names[i],
+                                c->parent_scope_level, tmp.priv[i]);
+            }
+            js_lazy_set_free(ctx, &tmp);
+            if (r)
+                return -1;
+        }
+    }
+    return 0;
+}
+
+/* fd's names from a set, which is left empty */
+static void js_lazy_set_give(JSContext *ctx, JSFunctionDef *fd, JSLazySet *set)
+{
+    int i;
+
+    for (i = 0; i < fd->lazy_name_count; i++)
+        JS_FreeAtom(ctx, fd->lazy_names[i]);
+    js_free(ctx, fd->lazy_names);
+    js_free(ctx, fd->lazy_private);
+    fd->lazy_names = set->names;
+    fd->lazy_private = set->priv;
+    fd->lazy_name_count = set->count;
+    fd->lazy_name_size = set->size;
+    js_free(ctx, set->hash);
+    memset(set, 0, sizeof(*set));
+}
+
+/* a set holding fd's names, which fd gives up */
+static void js_lazy_set_take(JSFunctionDef *fd, JSLazySet *set)
+{
+    memset(set, 0, sizeof(*set));
+    set->names = fd->lazy_names;
+    set->priv = fd->lazy_private;
+    set->count = fd->lazy_name_count;
+    set->size = fd->lazy_name_size;
+    fd->lazy_names = NULL;
+    fd->lazy_private = NULL;
+    fd->lazy_name_count = fd->lazy_name_size = 0;
+}
+
+/* leave fd's body for its first call: note the names it uses from
+   outside, then drop its code, its variables and the functions in it */
+static int js_lazy_collapse(JSParseState *s, JSFunctionDef *fd)
+{
+    JSContext *ctx = s->ctx;
+    struct list_head *el, *el1;
+    JSLazySet set;
+    int i, r;
+    const uint8_t *start;
+
+    /* with any its body's skip found */
+    js_lazy_set_take(fd, &set);
+    r = js_lazy_free_names(ctx, fd, &set);
+    js_lazy_set_give(ctx, fd, &set);
+    if (r)
+        return -1;
+
+    list_for_each_safe(el, el1, &fd->child_list) {
+        js_free_function_def(ctx, list_entry(el, JSFunctionDef, link));
+    }
+    free_bytecode_atoms(ctx->rt, fd->byte_code.buf, fd->byte_code.size,
+                        fd->use_short_opcodes);
+    dbuf_free(&fd->byte_code);
+    dbuf_free(&fd->pc2line);
+    js_free(ctx, fd->jump_slots);
+    fd->jump_slots = NULL;
+    fd->jump_size = fd->jump_count = 0;
+    js_free(ctx, fd->label_slots);
+    fd->label_slots = NULL;
+    fd->label_size = fd->label_count = 0;
+    js_free(ctx, fd->source_loc_slots);
+    fd->source_loc_slots = NULL;
+    fd->source_loc_size = fd->source_loc_count = 0;
+    for (i = 0; i < fd->cpool_count; i++)
+        JS_FreeValue(ctx, fd->cpool[i]);
+    js_free(ctx, fd->cpool);
+    fd->cpool = NULL;
+    fd->cpool_count = fd->cpool_size = 0;
+    for (i = 0; i < fd->var_count; i++)
+        JS_FreeAtom(ctx, fd->vars[i].var_name);
+    js_free(ctx, fd->vars);
+    js_free(ctx, fd->vars_htab);
+    fd->vars = NULL;
+    fd->vars_htab = NULL;
+    fd->var_count = fd->var_size = 0;
+    for (i = 0; i < fd->arg_count; i++)
+        JS_FreeAtom(ctx, fd->args[i].var_name);
+    js_free(ctx, fd->args);
+    fd->args = NULL;
+    fd->arg_count = fd->arg_size = 0;
+    js_free(ctx, fd->chain_memo);
+    fd->chain_memo = NULL;
+    fd->chain_memo_size = fd->chain_memo_count = 0;
+    fd->chains_final = false;
+    if (fd->scopes != fd->def_scope_array)
+        js_free(ctx, fd->scopes);
+    fd->scopes = fd->def_scope_array;
+    fd->scope_size = countof(fd->def_scope_array);
+    fd->scope_count = 1;
+    fd->scopes[0].first = -1;
+    fd->scopes[0].parent = -1;
+    fd->scope_level = 0;
+    fd->scope_first = -1;
+    fd->has_parameter_expressions = false;
+
+    /* where the parameters are, from the start of its source */
+    start = s->buf_start + (fd->source - fd->source_blob->data);
+    fd->lazy_params_off = fd->lazy_params - start;
+    fd->lazy_mark_off = fd->lazy_mark - start;
+    fd->lazy_eol_off = fd->lazy_eol - start;
+    fd->is_lazy = true;
+    return 0;
+}
+
+static int js_lazy_skip_add(JSParseState *s, JSFunctionDef *fd,
+                            JSLazySet *set, JSAtom name, bool is_private)
+{
+    return js_lazy_use(s->ctx, set, fd, name, fd->body_scope, is_private);
+}
+
+/*
+ * Compiling a lazy function: leave the function fd inside it for later
+ * without parsing its body (VitaSurf). The source was parsed whole when
+ * it loaded, so it is known to be well formed and the body need only be
+ * read to its end, by the tokenizer, noting the names in it. Whether a
+ * '/' starts a regular expression is the one thing a tokenizer cannot
+ * tell by itself: after a ')' it does only when the parentheses were an
+ * if, while, for or with's, which is followed here, and anything not
+ * certain gives up and the body is parsed. fd's body's first token is
+ * current; 1 with its closing '}' current, or 0 with nothing changed.
+ */
+static int js_lazy_skip_body(JSParseState *s, JSFunctionDef *fd,
+                             const uint8_t *src_start)
+{
+    JSContext *ctx = s->ctx;
+    JSParsePos body_pos, end_pos;
+    char state[256];
+    size_t level = 0;
+    int last_tok = '{', t;
+    JSLazySet set;
+    bool last_ctl = false, after_dot = false, last_unsure = false, called;
+    char c;
+
+    switch (fd->func_type) {
+    case JS_PARSE_FUNC_STATEMENT:
+    case JS_PARSE_FUNC_VAR:
+    case JS_PARSE_FUNC_EXPR:
+    case JS_PARSE_FUNC_ARROW:
+    case JS_PARSE_FUNC_METHOD:
+    case JS_PARSE_FUNC_GETTER:
+    case JS_PARSE_FUNC_SETTER:
+        break;
+    default:
+        return 0;
+    }
+    if (s->with_depth > 0 || !fd->lazy_params || js_lazy_has_eval(fd) ||
+        js_lazy_in_eval_reach(s, fd, src_start))
+        return 0;
+
+    memset(&set, 0, sizeof(set));
+    js_parse_get_pos(s, &body_pos);
+    s->skip_values = true;
+    state[level++] = '{';
+    for (;;) {
+        bool ctl = false, unsure = false;
+
+        t = s->token.val;
+        switch (t) {
+        case '(':
+            if (level >= sizeof(state))
+                goto give_up;
+            /* "for await (" is a for's too: not known which */
+            state[level++] = (last_tok == TOK_IF || last_tok == TOK_WHILE ||
+                              last_tok == TOK_FOR || last_tok == TOK_WITH) ?
+                'c' : (last_tok == TOK_AWAIT) ? 'u' : '(';
+            break;
+        case '[':
+        case '{':
+            if (level >= sizeof(state))
+                goto give_up;
+            state[level++] = t;
+            break;
+        case ')':
+            c = state[--level];
+            if (c != '(' && c != 'c' && c != 'u')
+                goto give_up;
+            ctl = (c == 'c');
+            unsure = (c == 'u');
+            break;
+        case ']':
+            if (state[--level] != '[')
+                goto give_up;
+            break;
+        case '}':
+            c = state[--level];
+            if (c == '`') {
+                /* the rest of the template */
+                free_token(s, &s->token);
+                s->got_lf = false;
+                s->last_line_num = s->token.line_num;
+                s->last_col_num = s->token.col_num;
+                if (js_parse_template_part(s, s->buf_ptr))
+                    goto give_up_error;
+                goto handle_template;
+            }
+            if (c != '{')
+                goto give_up;
+            if (level == 0)
+                goto done;
+            break;
+        case TOK_TEMPLATE:
+        handle_template:
+            if (s->token.u.str.sep != '`') {
+                if (level >= sizeof(state))
+                    goto give_up;
+                state[level++] = '`';
+            }
+            break;
+        case TOK_EOF:
+        case TOK_WITH:
+            goto give_up;
+        case '/':
+        case TOK_DIV_ASSIGN:
+            if (last_tok == '}' || last_unsure)
+                goto give_up;
+            if (last_tok == ')' ? last_ctl : is_regexp_allowed(last_tok)) {
+                s->buf_ptr -= (t == '/') ? 1 : 2;
+                if (js_parse_regexp(s))
+                    goto give_up_error;
+                t = TOK_REGEXP;
+            }
+            break;
+        case TOK_IDENT:
+            if (after_dot)
+                break;
+            /* a direct eval needs what only parsing finds out */
+            if (s->token.u.ident.atom == JS_ATOM_eval)
+                goto give_up;
+            if (js_lazy_skip_add(s, fd, &set, s->token.u.ident.atom, false))
+                goto fail;
+            break;
+        case TOK_AWAIT:
+        case TOK_YIELD:
+            /* a name in a function inside, read here as a keyword */
+            if (!after_dot &&
+                js_lazy_skip_add(s, fd, &set, s->token.u.ident.atom, false))
+                goto fail;
+            break;
+        case TOK_PRIVATE_NAME:
+            if (js_lazy_skip_add(s, fd, &set, s->token.u.ident.atom, true))
+                goto fail;
+            break;
+        case TOK_THIS:
+            if (!after_dot &&
+                js_lazy_skip_add(s, fd, &set, JS_ATOM_this, false))
+                goto fail;
+            break;
+        case TOK_SUPER:
+            if (!after_dot &&
+                (js_lazy_skip_add(s, fd, &set, JS_ATOM_home_object, false) ||
+                 js_lazy_skip_add(s, fd, &set, JS_ATOM_this, false) ||
+                 js_lazy_skip_add(s, fd, &set, JS_ATOM_this_active_func,
+                                  false) ||
+                 js_lazy_skip_add(s, fd, &set, JS_ATOM_new_target, false)))
+                goto fail;
+            break;
+        case '.':
+            /* new.target */
+            if (last_tok == TOK_NEW &&
+                js_lazy_skip_add(s, fd, &set, JS_ATOM_new_target, false))
+                goto fail;
+            break;
+        }
+        after_dot = (t == '.' || t == TOK_QUESTION_MARK_DOT);
+        last_ctl = ctl;
+        /* a '/' after these could be either */
+        last_unsure = (unsure || t == TOK_AWAIT || t == TOK_YIELD ||
+                       token_reads_by_function(&s->token) ||
+                       (t == TOK_IDENT &&
+                        s->token.u.ident.atom == JS_ATOM_of));
+        last_tok = t;
+        if (next_token(s))
+            goto give_up_error;
+    }
+ done:
+    s->skip_values = false;
+    /* at the body's '}': short, or called where it is written, and it
+       is compiled now */
+    if (s->token.ptr + 1 - src_start < JS_LAZY_MIN_SOURCE)
+        goto give_up;
+    js_parse_get_pos(s, &end_pos);
+    if (next_token(s))
+        goto give_up_error;
+    called = js_lazy_called_here(s);
+    if (js_parse_seek_token(s, &end_pos))
+        goto fail;
+    if (called)
+        goto give_up;
+    js_lazy_set_give(ctx, fd, &set);
+    return 1;
+
+ give_up_error:
+    /* the full parse will report it, if it is real */
+    JS_FreeValue(ctx, JS_GetException(ctx));
+ give_up:
+    s->skip_values = false;
+    js_lazy_set_free(ctx, &set);
+    if (js_parse_seek_token(s, &body_pos))
+        return -1;
+    return 0;
+ fail:
+    s->skip_values = false;
+    js_lazy_set_free(ctx, &set);
+    return -1;
+}
+
+/* compiling a lazy function: its closure variables are the ones it was
+   given, in the same order, each reaching the stand-in parent's entry
+   of the same index */
+static int js_lazy_reparse_closure(JSParseState *s, JSFunctionDef *fd)
+{
+    JSFunctionBytecode *b = s->reparse;
+    int i, n = b->closure_var_count;
+
+    if (n == 0)
+        return 0;
+    fd->closure_var = js_malloc(s->ctx, sizeof(fd->closure_var[0]) * n);
+    if (!fd->closure_var)
+        return -1;
+    fd->closure_var_size = n;
+    for (i = 0; i < n; i++) {
+        JSClosureVar *cv = &fd->closure_var[i];
+        *cv = b->closure_var[i];
+        cv->closure_type = JS_CLOSURE_REF;
+        cv->var_idx = i;
+        cv->var_name = JS_DupAtom(s->ctx, cv->var_name);
+    }
+    fd->closure_var_count = n;
+    return 0;
+}
