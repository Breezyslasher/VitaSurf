+/*
+ * Whether the token after a function's body, the current one, calls the
+ * function where it is written: "}(", "})(", "}).call(", "}).apply(" or
+ * "}.call(". Google's bundles are each one function ending
+ * "}).call(this, this._s)", and left for later it was parsed twice, the
+ * second time all of it at once when it ran. The current token stays.
+ */
+static bool js_lazy_called_here(JSParseState *s)
+{
+    JSParsePos pos;
+    bool called = false;
+
+    if (s->token.val == '(')
+        return true;
+    if (s->token.val != ')' && s->token.val != '.')
+        return false;
+    js_parse_get_pos(s, &pos);
+    if (s->token.val == ')') {
+        if (next_token(s))
+            goto fail;
+        called = (s->token.val == '(');
+    }
+    if (!called && s->token.val == '.') {
+        if (next_token(s))
+            goto fail;
+        char buf[ATOM_GET_STR_BUF_SIZE];
+
+        if (s->token.val == TOK_IDENT && !s->token.u.ident.has_escape &&
+            (s->token.u.ident.atom == JS_ATOM_apply ||
+             !strcmp(JS_AtomGetStr(s->ctx, buf, sizeof(buf),
+                                   s->token.u.ident.atom), "call"))) {
+            if (next_token(s))
+                goto fail;
+            called = (s->token.val == '(');
+        }
+    }
+    if (js_parse_seek_token(s, &pos))
+        goto fail;
+    return called;
+ fail:
+    /* parsing on reports it, if it is real */
+    JS_FreeValue(s->ctx, JS_GetException(s->ctx));
+    if (js_parse_seek_token(s, &pos))
+        JS_FreeValue(s->ctx, JS_GetException(s->ctx));
+    return false;
+}
