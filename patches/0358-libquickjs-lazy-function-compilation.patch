+    lz->mark_off = fd->lazy_mark_off;
+    lz->eol_off = fd->lazy_eol_off;
+    lz->params_line = fd->lazy_params_line;
+    lz->func_type = fd->func_type;
+    lz->parent_func_type = fd->lazy_parent_func_type;
+    lz->parent_func_kind = fd->lazy_parent_func_kind;
+    lz->init_strict = fd->lazy_init_strict;
+    lz->parent_in_body = fd->lazy_parent_in_body;
+    lz->is_module = fd->lazy_is_module;
+    add_gc_object(ctx->rt, &b->header, JS_GC_OBJ_TYPE_FUNCTION_BYTECODE);
+    js_free_function_def(ctx, fd);
+    return JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, b);
+ fail:
+    js_free_function_def(ctx, fd);
+    return JS_EXCEPTION;
+}
