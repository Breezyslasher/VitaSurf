+/* whether a direct eval may see fd's variables' names: one in a
+   function around it, or, on a compile again, one found anywhere in a
+   function around it the first time */
+static bool js_lazy_in_eval_reach(JSParseState *s, JSFunctionDef *fd,
+                                  const uint8_t *start)
+{
+    JSFunctionDef *p;
+    int i;
+
+    for (p = fd->parent; p != NULL; p = p->parent) {
+        if (p->has_eval_call)
+            return true;
+    }
+    for (i = 0; i < s->eval_range_count; i += 2) {
+        if (start >= s->eval_ranges[i] && start < s->eval_ranges[i + 1])
+            return true;
+    }
+    return false;
+}
+
+/* note fd's source as a function that calls eval (see eval_ranges) */
+static void js_lazy_note_eval(JSParseState *s, const uint8_t *start,
+                              const uint8_t *end)
+{
+    if (js_resize_array(s->ctx, (void **)&s->eval_ranges,
+                        sizeof(s->eval_ranges[0]), &s->eval_range_size,
+                        s->eval_range_count + 2)) {
+        /* without it, the compile again is all eager */
+        JS_FreeValue(s->ctx, JS_GetException(s->ctx));
+        return;
+    }
+    s->eval_ranges[s->eval_range_count++] = start;
+    s->eval_ranges[s->eval_range_count++] = end;
+}
