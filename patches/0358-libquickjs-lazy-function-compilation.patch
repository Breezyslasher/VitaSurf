+    b = js_mallocz(ctx, sizeof(*b) + n * sizeof(JSClosureVar));
+    if (!b)
+        goto fail;
+    lz = js_mallocz(ctx, sizeof(*lz));
+    if (!lz) {
+        js_free(ctx, b);
+        goto fail;
+    }
+    b->header.ref_count = 1;
+    b->lazy = lz;
+    if (n) {
+        b->closure_var = (void *)((uint8_t *)b + sizeof(*b));
+        memcpy(b->closure_var, fd->closure_var, n * sizeof(JSClosureVar));
+        b->closure_var_count = n;
+    }
+    js_free(ctx, fd->closure_var);
+    fd->closure_var = NULL;
+    fd->closure_var_count = 0;
+    b->func_name = fd->func_name;
+    fd->func_name = JS_ATOM_NULL;
+    b->defined_arg_count = fd->defined_arg_count;
+    b->filename = fd->filename;
+    fd->filename = JS_ATOM_NULL;
+    b->line_num = fd->line_num;
+    b->col_num = fd->col_num;
+    b->source = fd->source;
+    b->source_len = fd->source_len;
+    b->source_blob = fd->source_blob;
+    fd->source = NULL;
+    fd->source_blob = NULL;
+    b->has_prototype = fd->has_prototype;
+    b->has_simple_parameter_list = fd->has_simple_parameter_list;
+    b->is_strict_mode = fd->is_strict_mode;
+    b->is_derived_class_constructor = fd->is_derived_class_constructor;
+    b->func_kind = fd->func_kind;
+    /* whether the body uses super is not known yet: a function that
+       has a home object is given it */
+    b->need_home_object = (fd->home_object_var_idx >= 0 ||
+                           fd->need_home_object || fd->has_home_object);
+    b->new_target_allowed = fd->new_target_allowed;
+    b->super_call_allowed = fd->super_call_allowed;
+    b->super_allowed = fd->super_allowed;
