+/*
+ * A lazy function's JSFunctionBytecode (VitaSurf): what creating it
+ * needs, and the closure variables its body will use. Each name its
+ * body uses from outside is looked up from where the function is, as
+ * the compile of the body would, which makes the variables it finds
+ * captured and gives them the same entries. A name that is not a
+ * variable around it is a global and makes no entry.
+ */
+static JSValue js_create_lazy_function(JSContext *ctx, JSFunctionDef *fd)
+{
+    JSFunctionBytecode *b;
+    JSLazyFunc *lz;
+    DynBuf bc;
+    int i, n;
+
+    js_dbuf_init(ctx, &bc);
+    for (i = 0; i < fd->lazy_name_count; i++) {
+        JSAtom name = fd->lazy_names[i];
+        if (fd->lazy_private[i]) {
+            int idx, var_kind;
+            bool is_ref;
+
+            /* the entry is given the field's kind, which the compile
+               of the body reads from it, and a setter's name its own */
+            idx = resolve_scope_private_field1(ctx, &is_ref, &var_kind, fd,
+                                               name, 0);
+            if (idx < 0) {
+                dbuf_free(&bc);
+                goto fail;
+            }
+            fd->closure_var[idx].var_kind = var_kind;
+            if (var_kind == JS_VAR_PRIVATE_SETTER ||
+                var_kind == JS_VAR_PRIVATE_GETTER_SETTER) {
+                JSAtom setter_name = get_private_setter_name(ctx, name);
+                if (setter_name == JS_ATOM_NULL) {
+                    dbuf_free(&bc);
+                    goto fail;
+                }
+                idx = resolve_scope_private_field1(ctx, &is_ref, &var_kind,
+                                                   fd, setter_name, 0);
+                JS_FreeAtom(ctx, setter_name);
+                if (idx < 0) {
+                    dbuf_free(&bc);
+                    goto fail;
+                }
+                fd->closure_var[idx].var_kind = var_kind;
+            }
+        } else {
+            resolve_scope_var(ctx, fd, name, 0, OP_scope_get_var, &bc,
+                              NULL, NULL, 0);
+        }
+        free_bytecode_atoms(ctx->rt, bc.buf, bc.size, false);
+        bc.size = 0;
+        if (bc.error) {
+            dbuf_free(&bc);
+            JS_ThrowOutOfMemory(ctx);
+            goto fail;
+        }
+    }
+    dbuf_free(&bc);
+
+    n = fd->closure_var_count;
+    for (i = 0; i < n; i++) {
+        JSAtom name = fd->closure_var[i].var_name;
+        if (name == JS_ATOM__var_ || name == JS_ATOM__arg_var_ ||
+            name == JS_ATOM__with_) {
+            /* the names go through an eval's variables or a with
+               object first; only compiling the body now gets their
+               order right */
+            ctx->lazy_retry = true;
+            JS_ThrowInternalError(ctx, "lazy function in reach of eval");
+            goto fail;
+        }
+    }
