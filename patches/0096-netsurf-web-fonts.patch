+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Web fonts (VitaSurf).
+ *
+ * Nothing in NetSurf fetched what @font-face named, so every page was
+ * set in the bundled faces and an icon font drew nothing at all. Here,
+ * when an element's style is worked out, each family its font-family
+ * list names is looked up among the sheet's @font-face rules through
+ * libcss, and the regular, bold, italic and bold italic faces of a
+ * family not seen before are fetched through the low-level cache, one
+ * source each. A face that arrives is handed to the frontend, which
+ * keeps it by family name, weight and slant and picks it when a text
+ * run's family list names it; the page is then laid out again.
+ *
+ * The registry is global rather than per page: a face named the same
+ * on two pages is fetched once and kept for both. Faces are never
+ * dropped, so the total held is capped; beyond it a page falls back to
+ * the bundled faces, as it did before.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <libcss/libcss.h>
+
+#include "utils/errors.h"
+#include "utils/log.h"
+#include "utils/nsurl.h"
+#include "netsurf/content.h"
+#include "netsurf/layout.h"
+#include "content/content_protected.h"
+#include "content/llcache.h"
+#include "desktop/gui_internal.h"
+
+#include "html/private.h"
+#include "html/webfont.h"
+
+/** The most bytes held across every face; the Vita has little to spare. */
+#define WEBFONT_BYTES_MAX (2 * 1024 * 1024)
+/** The most one face may be; icon fonts and text faces sit well under. */
+#define WEBFONT_FACE_MAX (700 * 1024)
+
+enum webfont_state {
+	WEBFONT_LOADING,
+	WEBFONT_LOADED,
+	WEBFONT_FAILED
+};
+
+struct webfont {
+	char *family;			/**< lower case */
+	int weight;			/**< 100..900 */
+	bool italic;
+	enum webfont_state state;
+	llcache_handle *fetch;
+	uint8_t *data;
+	size_t len, cap;
+	struct html_content *owner;	/**< the page to lay out again */
+	struct webfont *next;
+};
+
+static struct webfont *webfonts;
+static size_t webfont_bytes;
+
+/** Whether a family name is one of the generic ones, which no @font-face
+ * describes. */
+static bool webfont_generic(const char *name)
+{
+	static const char *const generic[] = {
+		"serif", "sans-serif", "monospace", "cursive", "fantasy",
+		"system-ui", "ui-sans-serif", "ui-serif", "ui-monospace",
+		"inherit", "initial", NULL
+	};
+	int i;
+
+	for (i = 0; generic[i] != NULL; i++) {
+		if (strcasecmp(name, generic[i]) == 0)
+			return true;
+	}
+	return false;
+}
+
+static struct webfont *webfont_find(const char *family, int weight, bool italic)
+{
+	struct webfont *wf;
+
+	for (wf = webfonts; wf != NULL; wf = wf->next) {
+		if (wf->weight == weight && wf->italic == italic &&
+				strcasecmp(wf->family, family) == 0)
+			return wf;
+	}
+	return NULL;
+}
+
+static bool webfont_family_known(const char *family)
+{
+	struct webfont *wf;
+
+	for (wf = webfonts; wf != NULL; wf = wf->next) {
+		if (strcasecmp(wf->family, family) == 0)
+			return true;
+	}
+	return false;
+}
+
+/** A libcss font weight as a number. */
+static int webfont_weight(uint8_t w)
+{
+	switch (w) {
+	case CSS_FONT_WEIGHT_BOLD:
+	case CSS_FONT_WEIGHT_BOLDER:
+	case CSS_FONT_WEIGHT_700:
+		return 700;
+	case CSS_FONT_WEIGHT_100: return 100;
+	case CSS_FONT_WEIGHT_200: return 200;
+	case CSS_FONT_WEIGHT_300: return 300;
+	case CSS_FONT_WEIGHT_500: return 500;
+	case CSS_FONT_WEIGHT_600: return 600;
+	case CSS_FONT_WEIGHT_800: return 800;
+	case CSS_FONT_WEIGHT_900: return 900;
+	case CSS_FONT_WEIGHT_LIGHTER:
+	case CSS_FONT_WEIGHT_NORMAL:
+	case CSS_FONT_WEIGHT_400:
+	default:
+		return 400;
+	}
+}
+
+/**
+ * How good a source is: TrueType and OpenType first, then WOFF, which
+ * FreeType unpacks with zlib; WOFF2 last, since it needs brotli and the
+ * frontend will say if it cannot take it. EOT and SVG fonts are of no
+ * use. A source the format hint does not name is judged by its suffix.
+ */
+static int webfont_src_rank(const css_font_face_src *src, const char *url)
+{
+	size_t n = strlen(url);
+	css_font_face_format fmt = css_font_face_src_format(src);
+
+	if (css_font_face_src_location_type(src) !=
+			CSS_FONT_FACE_LOCATION_TYPE_URI)
+		return 0;
+
+	switch (fmt) {
+	case CSS_FONT_FACE_FORMAT_OPENTYPE:
+		return 3;
+	case CSS_FONT_FACE_FORMAT_WOFF:
+		return 2;
+	case CSS_FONT_FACE_FORMAT_EMBEDDED_OPENTYPE:
+	case CSS_FONT_FACE_FORMAT_SVG:
+		return 0;
+	default:
+		break;
+	}
+
+	/* the suffix, before any query */
+	{
+		const char *q = strchr(url, '?');
+
+		if (q != NULL)
+			n = (size_t) (q - url);
+	}
+	if (n > 4 && (strncasecmp(url + n - 4, ".ttf", 4) == 0 ||
+			strncasecmp(url + n - 4, ".otf", 4) == 0))
+		return 3;
+	if (n > 5 && strncasecmp(url + n - 5, ".woff", 5) == 0)
+		return 2;
+	if (n > 6 && strncasecmp(url + n - 6, ".woff2", 6) == 0)
+		return 1;
+	if (n > 4 && (strncasecmp(url + n - 4, ".eot", 4) == 0 ||
+			strncasecmp(url + n - 4, ".svg", 4) == 0))
+		return 0;
+	if (fmt == CSS_FONT_FACE_FORMAT_UNKNOWN)
+		return 1;	/* format("woff2"), most likely */
+	return 1;
+}
+
+static void webfont_reformat(struct webfont *wf)
+{
+	struct html_content *html = wf->owner;
+
+	if (html == NULL)
+		return;
+	if (html->base.status != CONTENT_STATUS_READY &&
+			html->base.status != CONTENT_STATUS_DONE)
+		return;
+	content__reformat(&html->base, false, html->base.available_width,
+			html->base.available_height);
+}
+
+static nserror webfont_callback(llcache_handle *handle,
+		const llcache_event *event, void *pw)
+{
+	struct webfont *wf = pw;
+
+	switch (event->type) {
+	case LLCACHE_EVENT_HAD_DATA:
+		if (wf->len + event->data.data.len > WEBFONT_FACE_MAX ||
+				webfont_bytes + event->data.data.len >
+					WEBFONT_BYTES_MAX) {
+			NSLOG(netsurf, INFO, "web font %s too large, dropped",
+					wf->family);
+			wf->state = WEBFONT_FAILED;
+			free(wf->data);
+			wf->data = NULL;
+			webfont_bytes -= wf->len;
+			wf->len = wf->cap = 0;
+			llcache_handle_abort(handle);
+			llcache_handle_release(handle);
+			wf->fetch = NULL;
+			return NSERROR_OK;
+		}
+		if (wf->len + event->data.data.len > wf->cap) {
+			size_t ncap = wf->cap == 0 ? 32 * 1024 : wf->cap * 2;
+			uint8_t *n;
+
+			while (ncap < wf->len + event->data.data.len)
+				ncap *= 2;
+			n = realloc(wf->data, ncap);
+			if (n == NULL) {
+				wf->state = WEBFONT_FAILED;
+				llcache_handle_abort(handle);
+				llcache_handle_release(handle);
+				wf->fetch = NULL;
+				return NSERROR_OK;
+			}
+			wf->data = n;
+			wf->cap = ncap;
+		}
+		memcpy(wf->data + wf->len, event->data.data.buf,
+				event->data.data.len);
+		wf->len += event->data.data.len;
+		webfont_bytes += event->data.data.len;
+		break;
+
+	case LLCACHE_EVENT_DONE:
+		llcache_handle_release(handle);
+		wf->fetch = NULL;
+		if (wf->len == 0 || guit->layout->add_face == NULL ||
+				guit->layout->add_face(wf->family, wf->weight,
+					wf->italic, wf->data, wf->len) !=
+					NSERROR_OK) {
+			NSLOG(netsurf, INFO, "web font %s %d%s rejected",
+					wf->family, wf->weight,
+					wf->italic ? " italic" : "");
+			wf->state = WEBFONT_FAILED;
+			free(wf->data);
+			wf->data = NULL;
+			webfont_bytes -= wf->len;
+			wf->len = wf->cap = 0;
+			break;
+		}
+		/* the frontend owns the bytes now */
+		wf->data = NULL;
+		wf->state = WEBFONT_LOADED;
+		NSLOG(netsurf, INFO, "web font %s %d%s: %u bytes",
+				wf->family, wf->weight,
+				wf->italic ? " italic" : "",
+				(unsigned) wf->len);
+		webfont_reformat(wf);
+		break;
+
+	case LLCACHE_EVENT_ERROR:
+		NSLOG(netsurf, INFO, "web font %s: %s", wf->family,
+				event->data.error.msg);
+		llcache_handle_release(handle);
+		wf->fetch = NULL;
+		wf->state = WEBFONT_FAILED;
+		free(wf->data);
+		wf->data = NULL;
+		webfont_bytes -= wf->len;
+		wf->len = wf->cap = 0;
+		break;
+
+	case LLCACHE_EVENT_REDIRECT:
+	case LLCACHE_EVENT_HAD_HEADERS:
+	case LLCACHE_EVENT_PROGRESS:
+	case LLCACHE_EVENT_GOT_CERTS:
+	default:
+		break;
+	}
+
+	return NSERROR_OK;
+}
+
+/** Start fetching one face, unless one of that family, weight and slant
+ * is already known. */
+static void webfont_fetch(struct html_content *html, const char *family,
+		int weight, bool italic, const char *url)
+{
+	struct webfont *wf;
+	nsurl *nurl;
+	nserror err;
+
+	if (webfont_find(family, weight, italic) != NULL)
+		return;
+
+	if (nsurl_create(url, &nurl) != NSERROR_OK)
+		return;
+
+	wf = calloc(1, sizeof(*wf));
+	if (wf == NULL) {
+		nsurl_unref(nurl);
+		return;
+	}
+	wf->family = strdup(family);
+	if (wf->family == NULL) {
+		free(wf);
+		nsurl_unref(nurl);
+		return;
+	}
+	wf->weight = weight;
+	wf->italic = italic;
+	wf->state = WEBFONT_LOADING;
+	wf->owner = html;
+	wf->next = webfonts;
+	webfonts = wf;
+
+	err = llcache_handle_retrieve(nurl, 0, content_get_url(&html->base),
+			NULL, webfont_callback, wf, &wf->fetch);
+	nsurl_unref(nurl);
+	if (err != NSERROR_OK) {
+		wf->state = WEBFONT_FAILED;
+		wf->fetch = NULL;
+		NSLOG(netsurf, INFO, "web font %s: fetch not started (%d)",
+				family, (int) err);
+	}
+}
+
+/**
+ * Look one family up among the @font-face rules and fetch its faces.
+ */
+static void webfont_request_family(struct html_content *html,
+		lwc_string *family)
+{
+	css_select_font_faces_results *faces = NULL;
+	const char *name = lwc_string_data(family);
+	uint32_t i;
+	int fetched = 0;
+
+	if (webfont_generic(name) || webfont_family_known(name))
+		return;
+
+	if (css_select_font_faces(html->select_ctx, &html->media,
+			&html->unit_len_ctx, family, &faces) != CSS_OK ||
+			faces == NULL)
+		return;
+
+	for (i = 0; i < faces->n_font_faces && fetched < 4; i++) {
+		const css_font_face *face = faces->font_faces[i];
+		const css_font_face_src *best = NULL;
+		int best_rank = 0;
+		uint32_t n = 0, j;
+		lwc_string *loc = NULL;
+		int weight;
+		bool italic;
+
+		weight = webfont_weight(css_font_face_font_weight(face));
+		italic = css_font_face_font_style(face) ==
+				CSS_FONT_STYLE_ITALIC ||
+				css_font_face_font_style(face) ==
+				CSS_FONT_STYLE_OBLIQUE;
+		/* only the four the frontend picks between */
+		weight = weight >= 600 ? 700 : 400;
+
+		if (css_font_face_count_srcs(face, &n) != CSS_OK)
+			continue;
+		for (j = 0; j < n; j++) {
+			const css_font_face_src *src;
+			int rank;
+
+			if (css_font_face_get_src(face, j, &src) != CSS_OK ||
+					css_font_face_src_get_location(src,
+						&loc) != CSS_OK || loc == NULL)
+				continue;
+			rank = webfont_src_rank(src, lwc_string_data(loc));
+			if (rank > best_rank) {
+				best_rank = rank;
+				best = src;
+			}
+		}
+		if (best == NULL ||
+				css_font_face_src_get_location(best, &loc) !=
+					CSS_OK)
+			continue;
+		webfont_fetch(html, name, weight, italic,
+				lwc_string_data(loc));
+		fetched++;
+	}
+
+	if (fetched == 0 && faces->n_font_faces > 0) {
+		/* remembered as tried, so the rules are not walked again
+		 * for every element */
+		struct webfont *wf = calloc(1, sizeof(*wf));
+
+		if (wf != NULL && (wf->family = strdup(name)) != NULL) {
+			wf->weight = 400;
+			wf->state = WEBFONT_FAILED;
+			wf->next = webfonts;
+			webfonts = wf;
+		} else {
+			free(wf);
+		}
+	}
+
+	css_select_font_faces_results_destroy(faces);
+}
+
+/* exported interface documented in html/webfont.h */
+void html_webfont_request(struct html_content *html,
+		const css_computed_style *style)
+{
+	lwc_string **families = NULL;
+	int i;
+
+	if (style == NULL || html->select_ctx == NULL ||
+			guit->layout->add_face == NULL)
+		return;
+
+	css_computed_font_family(style, &families);
+	if (families == NULL)
+		return;
+
+	for (i = 0; families[i] != NULL && i < 8; i++)
+		webfont_request_family(html, families[i]);
+}
+
+/* exported interface documented in html/webfont.h */
+void html_webfont_forget(struct html_content *html)
+{
+	struct webfont *wf;
+
+	for (wf = webfonts; wf != NULL; wf = wf->next) {
+		if (wf->owner == html)
+			wf->owner = NULL;
+	}
+}
