+static fb_faceid_t *fb_web_face_for(const plot_font_style_t *fstyle)
+{
+	bool want_bold = fstyle->weight >= BOLD_WEIGHT;
+	bool want_italic = (fstyle->flags & (FONTF_ITALIC | FONTF_OBLIQUE)) != 0;
+	int i;
