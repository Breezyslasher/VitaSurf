+/**
+ * Take a web font face (VitaSurf). See gui_layout_table.add_face.
+ */
+static nserror fb_font_add_face(const char *family, int weight, bool italic,
+		uint8_t *data, size_t len)
+{
+	struct fb_webface *wf;
+	fb_faceid_t *newf;
+	FT_Face aface;
+	FT_Error error;
+
+	newf = calloc(1, sizeof(fb_faceid_t));
