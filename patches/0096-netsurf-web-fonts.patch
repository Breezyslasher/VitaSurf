diff --git a/content/handlers/html/webfont.c b/content/handlers/html/webfont.c
new file mode 100644
index 000000000..a33356844
--- /dev/null
+++ b/content/handlers/html/webfont.c
@@ -0,0 +1,455 @@
+/*
