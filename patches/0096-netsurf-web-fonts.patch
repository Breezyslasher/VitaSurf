+/**
+ * \file
+ * Web fonts: fetching what @font-face names (VitaSurf).
+ */
+
+#ifndef NETSURF_HTML_WEBFONT_H
+#define NETSURF_HTML_WEBFONT_H
+
+struct html_content;
+struct css_computed_style;
+
+/**
+ * Ask for the faces an element's font-family list names.
+ *
+ * Each family that @font-face rules describe, and that no fetch has
+ * been started for, has its regular, bold, italic and bold italic
+ * faces fetched, at most one source each. Does nothing when the
+ * frontend cannot take a face.
+ */
+void html_webfont_request(struct html_content *html,
+		const struct css_computed_style *style);
+
+/**
+ * The content is going away: fetches it started keep running for the
+ * face registry, but must not reformat it when they land.
+ */
+void html_webfont_forget(struct html_content *html);
+
+#endif
