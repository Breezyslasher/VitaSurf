+/**
+ * Build the boxes of an element child put into an element, on their own,
+ * as an element just shown is built (VitaSurf): an element added to the
+ * body had the whole tree built again, the body's children having no
+ * block of their own to build. Not when a selector has asked about the
+ * order or presence of the element's children (nscss_children_ordered).
+ *
+ * \param c         the document
+ * \param e         the element whose children changed
+ * \param child     the child put in
+ * \param result    what the page needs, when it returns true
+ * \param done      the blocks built in this batch (box_rebuild_content);
+ *                  the child is added when there is room
+ * \param n_done    how many there are
+ * \param max_done  how many done can hold
+ * \return true if its boxes were built, false with nothing changed
+ */
+bool box_child_build(struct html_content *c, struct dom_node *e,
+		struct dom_node *child, enum box_restyle *result,
+		struct dom_node **done, unsigned *n_done, unsigned max_done);
+
 /**
