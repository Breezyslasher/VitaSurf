 	return none;
 }
 
+/* exported interface documented in html/box_construct.h */
+bool box_child_build(html_content *c, dom_node *e, dom_node *child,
+		enum box_restyle *result, dom_node **done, unsigned *n_done,
+		unsigned max_done)
+{
+	struct box_construct_props props;
+	const css_computed_style *root_style, *style;
+	css_select_results *fresh;
+	dom_node *parent = NULL;
+	dom_node_type type;
+	struct box *nb;
+	unsigned count = 0;
+	bool in, built;
+
+	if (c->layout == NULL || box_for_node(e) == NULL ||
+			nscss_children_ordered(e) ||
+			dom_node_get_node_type(child, &type) != DOM_NO_ERR ||
+			type != DOM_ELEMENT_NODE ||
+			box_for_node(child) != NULL ||
+			!show_hide_allowed(c) ||
+			c->base.textsearch.context != NULL)
+		return false;
+	if (dom_node_get_parent_node(child, &parent) != DOM_NO_ERR)
+		return false;
+	in = parent == e;
+	if (parent != NULL)
+		dom_node_unref(parent);
+	if (!in)
+		return false;
+
+	box_extract_properties(c, child, &props);
+	if (props.parent_style == NULL || props.node_is_root)
+		return false;
+	root_style = c->layout->style;
+	nscss_clear_node_data(child);
+	fresh = box_get_style(c, props.parent_style, root_style, child);
+	if (fresh == NULL)
+		return false;
+	box_note_neg_z(c, fresh);
+	style = fresh->styles[CSS_PSEUDO_ELEMENT_NONE];
+	if (style == NULL || ns_computed_display(style, false) ==
+			CSS_DISPLAY_NONE) {
+		css_select_results_destroy(fresh);
+		return false;
+	}
+	/* built as an element that has just been shown is: nothing is
+	 * changed when that cannot be done safely */
+	built = box_show_element(c, child, fresh);
+	css_select_results_destroy(fresh);
+	if (!built)
+		return false;
+	c->restyle_built = true;
+
+	nb = box_for_node(child);
+	if (nb == NULL) {
+		restyle_why = "new content that could not be built";
+		*result = BOX_RESTYLE_LAYOUT;
+		return true;
+	}
+	/* what was put in may count, which the rest of the page sees */
+	if (rebuild_results_count(nb->styles) || (nb->children != NULL &&
+			rebuild_subtree_counts(nb->children, &count))) {
+		restyle_why = "new content that counts or quotes";
+		*result = BOX_RESTYLE_LAYOUT;
+		return true;
+	}
+	/* changes inside it in the same batch need nothing more */
+	if (*n_done < max_done)
+		done[(*n_done)++] = dom_node_ref(child);
+	*result = BOX_RESTYLE_REFLOW;
+	return true;
+}
+
 /* exported interface documented in html/box_construct.h */
 enum box_restyle box_restyle(html_content *c, dom_node *n, bool subtree,
 		unsigned *budget)
