+/**
+ * Keep the value a declaration lost for not being understood, the first
+ * one for its property, so the log can say what it was (VitaSurf).
+ *
+ * \param sheet   The stylesheet
+ * \param name    The property's name, noted already with kind 1
+ * \param sample  The value as written, or near it
+ */
+void css__stylesheet_gap_sample(css_stylesheet *sheet, lwc_string *name,
+		const char *sample)
+{
+	uint32_t i;
+
+	if (sheet == NULL || name == NULL || sample == NULL) {
+		return;
+	}
+	for (i = 0; i < sheet->n_gaps; i++) {
+		bool match = false;
+
+		if (sheet->gaps[i].kind == 1 &&
+				sheet->gaps[i].sample[0] == '\0' &&
+				lwc_string_caseless_isequal(
+					sheet->gaps[i].name, name,
+					&match) == lwc_error_ok && match) {
+			strncpy(sheet->gaps[i].sample, sample,
+					sizeof(sheet->gaps[i].sample) - 1);
+			sheet->gaps[i].sample[
+				sizeof(sheet->gaps[i].sample) - 1] = '\0';
+			return;
+		}
+	}
+}
+
 
 /* exported function documented in libcss/stylesheet.h */
 /**
@@ -1118,6 +1152,17 @@ css_error css_stylesheet_get_gap(const css_stylesheet *sheet, uint32_t index,
 	return CSS_OK;
 }
 
+/* exported function documented in libcss/stylesheet.h */
+const char *css_stylesheet_get_gap_sample(const css_stylesheet *sheet,
+		uint32_t index)
+{
+	if (sheet == NULL || index >= sheet->n_gaps ||
+			sheet->gaps[index].sample[0] == '\0') {
+		return NULL;
+	}
+	return sheet->gaps[index].sample;
+}
