+/**
+ * The opcode value for one overflow keyword, or false if it is not one
+ * (VitaSurf).
+ */
+static bool overflow_keyword(css_language *c, const css_token *token,
+		uint16_t *value)
+{
+	static const struct { int string; uint16_t value; } kw[] = {
+		{ VISIBLE, OVERFLOW_VISIBLE },
+		{ HIDDEN, OVERFLOW_HIDDEN },
+		{ SCROLL, OVERFLOW_SCROLL },
+		{ AUTO, OVERFLOW_AUTO },
+		{ CLIP, OVERFLOW_CLIP },
+	};
+	size_t i;
+
+	if (token == NULL || token->type != CSS_TOKEN_IDENT)
+		return false;
+	for (i = 0; i < sizeof(kw) / sizeof(kw[0]); i++) {
+		bool match = false;
+
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[kw[i].string], &match) ==
+				lwc_error_ok && match) {
+			*value = kw[i].value;
+			return true;
+		}
+	}
+	return false;
+}
