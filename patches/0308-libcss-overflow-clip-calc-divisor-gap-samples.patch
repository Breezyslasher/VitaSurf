  * Property parsing functions						      *
  ******************************************************************************/
 
+/**
+ * Write out the value a declaration lost, from its tokens, for the log
+ * (VitaSurf). It is near what the sheet said, not exact: a string loses
+ * its quoting style and a comment its text.
+ */
+static void gap_sample(css_language *c, lwc_string *name,
+		const parserutils_vector *vector, int32_t at)
+{
+	char buf[48];
+	size_t n = 0;
+	const css_token *t;
+
+	while (n < sizeof(buf) - 1 &&
+			(t = parserutils_vector_iterate(vector, &at)) != NULL) {
+		const char *pre = "", *post = "";
+		const char *d = "";
+		size_t len = 0, k;
+
+		if (t->type == CSS_TOKEN_S) {
+			if (n > 0 && buf[n - 1] != ' ')
+				buf[n++] = ' ';
+			continue;
+		}
+		if (t->idata != NULL) {
+			d = lwc_string_data(t->idata);
+			len = lwc_string_length(t->idata);
+		}
+		switch (t->type) {
+		case CSS_TOKEN_FUNCTION: post = "("; break;
+		case CSS_TOKEN_HASH: pre = "#"; break;
+		case CSS_TOKEN_STRING: pre = "\""; post = "\""; break;
+		case CSS_TOKEN_PERCENTAGE: post = "%"; break;
+		case CSS_TOKEN_URI: pre = "url("; post = ")"; break;
+		default: break;
+		}
+		for (k = 0; pre[k] != '\0' && n < sizeof(buf) - 1; k++)
+			buf[n++] = pre[k];
+		for (k = 0; k < len && n < sizeof(buf) - 1; k++)
+			buf[n++] = d[k];
+		for (k = 0; post[k] != '\0' && n < sizeof(buf) - 1; k++)
+			buf[n++] = post[k];
+	}
+	while (n > 0 && buf[n - 1] == ' ')
+		n--;
+	buf[n] = '\0';
+	css__stylesheet_gap_sample(c->sheet, name, buf);
+}
