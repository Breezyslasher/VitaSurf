@@ -1857,6 +1874,28 @@ css_error consumeNMChars(css_lexer *lexer)
 	/* nmchar = [a-zA-Z] | '-' | '_' | nonascii | escape */
 
 	do {
+		/*
+		 * A run of plain ASCII name characters in one step
+		 * (VitaSurf): each would have been peeked and appended a
+		 * byte at a time, and names are most of a style sheet --
+		 * 95 of the 843 million instructions GitHub's took.
+		 * Anything else, including a character that is not all in
+		 * the buffer yet, goes the old way below.
+		 */
+		{
+			const parserutils_buffer *utf8 = lexer->input->utf8;
+			size_t from = lexer->input->cursor +
+					lexer->bytesReadForToken;
+			size_t at = from;
+
+			while (at < utf8->length &&
+					lex_ascii_nmchar[utf8->data[at]])
+				at++;
+			if (at > from) {
+				APPEND(lexer, utf8->data + from, at - from);
+			}
+		}
+
 		perror = parserutils_inputstream_peek(lexer->input,
 				lexer->bytesReadForToken, &cptr, &clen);
 		if (perror != PARSERUTILS_OK && perror != PARSERUTILS_EOF)
