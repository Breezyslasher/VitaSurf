-			(rs->n_deferred + 1) * sizeof(*rs->deferred));
-	if (grown == NULL) {
-		return CSS_NOMEM;
+	/*
+	 * Room doubles, from 4, whenever the count reaches a power of two
+	 * (VitaSurf). Growing by one copied the whole list for every
+	 * declaration held over, and GitHub's :root holds 1,984 of them at
+	 * about a hundred bytes each: 35 million instructions of a
+	 * style sheet parse were those copies.
+	 */
+	if (rs->n_deferred == 0 || (rs->n_deferred >= 4 &&
+			(rs->n_deferred & (rs->n_deferred - 1)) == 0)) {
+		uint32_t room = (rs->n_deferred == 0) ? 4 :
+				rs->n_deferred * 2;
+
+		grown = realloc(rs->deferred, room * sizeof(*rs->deferred));
+		if (grown == NULL) {
+			return CSS_NOMEM;
+		}
+		rs->deferred = grown;
 	}
-	rs->deferred = grown;
 
 	d = &rs->deferred[rs->n_deferred];
 	memset(d, 0, sizeof(*d));
