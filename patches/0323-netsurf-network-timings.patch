+/* add a finished transfer to the page's network figures (VitaSurf) */
+static void fetch_curl_note_times(CURL *curl_handle)
+{
+#if LIBCURL_VERSION_NUM >= 0x073d00
+	long connects = 0;
+	curl_off_t connect = 0, tls = 0, request = 0, first = 0, total = 0;
+	curl_off_t bytes = 0;
+
+	curl_easy_getinfo(curl_handle, CURLINFO_NUM_CONNECTS, &connects);
+	curl_easy_getinfo(curl_handle, CURLINFO_CONNECT_TIME_T, &connect);
+	curl_easy_getinfo(curl_handle, CURLINFO_APPCONNECT_TIME_T, &tls);
+	curl_easy_getinfo(curl_handle, CURLINFO_PRETRANSFER_TIME_T, &request);
+	curl_easy_getinfo(curl_handle, CURLINFO_STARTTRANSFER_TIME_T, &first);
+	curl_easy_getinfo(curl_handle, CURLINFO_TOTAL_TIME_T, &total);
+	curl_easy_getinfo(curl_handle, CURLINFO_SIZE_DOWNLOAD_T, &bytes);
+	vitasurf_net_note(connects, connect, tls, request, first, total, bytes);
+#else
+	(void)curl_handle;
+#endif
+}
