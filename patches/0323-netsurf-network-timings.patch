diff --git a/utils/utils.c b/utils/utils.c
index 959323a1c..0970820b1 100644
--- a/utils/utils.c
+++ b/utils/utils.c
@@ -625,6 +625,67 @@ unsigned int vitasurf_ms_image;
 unsigned int vitasurf_images_asked;
 unsigned int vitasurf_images_done;
 unsigned int vitasurf_images_failed;
+unsigned int vitasurf_net_transfers;
+unsigned int vitasurf_net_connections;
+unsigned int vitasurf_net_handshakes;
+unsigned int vitasurf_ms_net_connect;
+unsigned int vitasurf_ms_net_tls;
+unsigned int vitasurf_ms_net_tls_max;
+unsigned int vitasurf_ms_net_first_byte;
+unsigned int vitasurf_ms_net_first_byte_max;
+unsigned int vitasurf_ms_net_body;
+unsigned int vitasurf_ms_net_body_max;
+unsigned int vitasurf_net_kb;
+unsigned int vitasurf_net_queued;
+unsigned int vitasurf_ms_net_queue;
+unsigned int vitasurf_ms_net_queue_max;
+
+/* exported interface documented in utils/utils.h */
+void vitasurf_net_note(long connects, int64_t connect_us, int64_t tls_us,
+		       int64_t request_us, int64_t first_byte_us,
+		       int64_t total_us, int64_t bytes)
+{
+	unsigned int ms;
+
+	vitasurf_net_transfers++;
+	vitasurf_net_kb += (unsigned int)(bytes / 1024);
+	if (connects > 0) {
+		vitasurf_net_connections += (unsigned int)connects;
+		vitasurf_ms_net_connect += (unsigned int)(connect_us / 1000);
+		/* TLS done after the TCP connection: a handshake was made */
+		if (tls_us > connect_us) {
+			ms = (unsigned int)((tls_us - connect_us) / 1000);
+			vitasurf_net_handshakes++;
+			vitasurf_ms_net_tls += ms;
+			if (ms > vitasurf_ms_net_tls_max)
+				vitasurf_ms_net_tls_max = ms;
+		}
+	}
+	if (first_byte_us > request_us) {
+		ms = (unsigned int)((first_byte_us - request_us) / 1000);
+		vitasurf_ms_net_first_byte += ms;
+		if (ms > vitasurf_ms_net_first_byte_max)
+			vitasurf_ms_net_first_byte_max = ms;
+	}
+	if (total_us > first_byte_us && first_byte_us > 0) {
+		ms = (unsigned int)((total_us - first_byte_us) / 1000);
+		vitasurf_ms_net_body += ms;
+		if (ms > vitasurf_ms_net_body_max)
+			vitasurf_ms_net_body_max = ms;
+	}
+}
+
+/* exported interface documented in utils/utils.h */
+void vitasurf_net_queue_wait(unsigned int ms)
+{
+	if (ms == 0)
+		return;
+	vitasurf_net_queued++;
+	vitasurf_ms_net_queue += ms;
+	if (ms > vitasurf_ms_net_queue_max)
+		vitasurf_ms_net_queue_max = ms;
+}
