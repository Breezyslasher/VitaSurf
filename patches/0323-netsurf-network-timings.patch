diff --git a/utils/utils.h b/utils/utils.h
index 902f7b77c..ea002046b 100644
--- a/utils/utils.h
+++ b/utils/utils.h
@@ -190,6 +190,49 @@ extern unsigned int vitasurf_ms_image;
 extern unsigned int vitasurf_images_asked;
 extern unsigned int vitasurf_images_done;
 extern unsigned int vitasurf_images_failed;
+
+/*
+ * What the page's network transfers cost (VitaSurf), as curl times them
+ * when each one ends. A first visit is mostly waiting, and the log could
+ * not say whether on connections, TLS handshakes, the server or the
+ * bodies. The times are summed over transfers that overlap, so they are
+ * not shares of the load; the longest of each is kept too.
+ */
+extern unsigned int vitasurf_net_transfers; /**< finished transfers */
+extern unsigned int vitasurf_net_connections; /**< new connections */
+extern unsigned int vitasurf_net_handshakes; /**< of those, with TLS */
+extern unsigned int vitasurf_ms_net_connect; /**< DNS and TCP */
+extern unsigned int vitasurf_ms_net_tls;
+extern unsigned int vitasurf_ms_net_tls_max;
+extern unsigned int vitasurf_ms_net_first_byte; /**< request to reply */
+extern unsigned int vitasurf_ms_net_first_byte_max;
+extern unsigned int vitasurf_ms_net_body; /**< first byte to last */
+extern unsigned int vitasurf_ms_net_body_max;
+extern unsigned int vitasurf_net_kb;
+
+/**
+ * Add one finished transfer to those figures; times in microseconds
+ * since the transfer began, as curl's CURLINFO_*_TIME_T give them.
+ */
+void vitasurf_net_note(long connects, int64_t connect_us, int64_t tls_us,
+		       int64_t request_us, int64_t first_byte_us,
+		       int64_t total_us, int64_t bytes);
+
+/**
+ * Fetches that waited in NetSurf's own queue for a free fetcher slot
+ * (max_fetchers, max_fetchers_per_host) before curl saw them, the
+ * time they waited in all, and the longest wait.
+ */
+extern unsigned int vitasurf_net_queued;
+extern unsigned int vitasurf_ms_net_queue;
+extern unsigned int vitasurf_ms_net_queue_max;
+
+/** Milliseconds on a monotonic clock, for measuring short waits. */
+unsigned int vitasurf_clock_ms(void);
+
+/** Note that a fetch waited \a ms in the queue before it started. */
+void vitasurf_net_queue_wait(unsigned int ms);
+
 extern unsigned int vitasurf_ms_boxes;
