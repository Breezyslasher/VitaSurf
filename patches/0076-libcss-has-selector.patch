+/**
+ * Parse the relative selector list inside :has() (VitaSurf).
+ *
+ * Each argument is one compound, optionally led by the combinator
+ * that places it relative to the subject: ":has(> img)" looks at the
+ * children, ":has(+ p)" at the next sibling, ":has(~ p)" at every
+ * later sibling and a bare ":has(img)" at every descendant. Those
+ * shapes are what sites write; an argument with a combinator in the
+ * middle, ":has(ul > li)", is not supported and drops the rule as it
+ * did before.
+ *
+ * The compounds come back chained through their combinator pointers,
+ * which is the chain css__stylesheet_selector_destroy() frees, with
+ * the relative combinator in each one's data.comb (CSS_COMBINATOR_NONE
+ * meaning descendant). select.c's match_has() walks them.
+ */
+static css_error parseHasArgs(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_selector **out)
+{
+	css_selector *head = NULL, *tail = NULL;
+	const css_token *token;
+	css_error error;
+	int prefix_n = c->prefix_n;
+
+	*out = NULL;
+
+	for (;;) {
+		css_selector *sub = NULL;
+		css_combinator comb = CSS_COMBINATOR_NONE;
+
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL) {
+			error = CSS_INVALID;
+			goto fail;
+		}
+		if (tokenIsChar(token, '>')) {
+			comb = CSS_COMBINATOR_PARENT;
+		} else if (tokenIsChar(token, '+')) {
+			comb = CSS_COMBINATOR_SIBLING;
+		} else if (tokenIsChar(token, '~')) {
+			comb = CSS_COMBINATOR_GENERIC_SIBLING;
+		}
+		if (comb != CSS_COMBINATOR_NONE) {
+			parserutils_vector_iterate(vector, ctx);
+			consumeWhitespace(vector, ctx);
+		}
+
+		c->in_has++;
+		error = parseSimpleSelector(c, vector, ctx, &sub);
+		c->in_has--;
+		if (error != CSS_OK)
+			goto fail;
+
+		/* An :is() with a combinator in it leaves a prefix chain
+		 * for the enclosing selector to pick up, which would put
+		 * the argument's ancestors in front of the subject. */
+		if (c->prefix_n != prefix_n) {
+			css__stylesheet_selector_destroy(c->sheet, sub);
+			dropPrefixChain(c);
+			error = CSS_INVALID;
+			goto fail;
+		}
+
+		sub->data.comb = comb;
+		if (tail == NULL)
+			head = sub;
+		else
+			tail->combinator = sub;
+		tail = sub;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL) {
+			error = CSS_INVALID;
+			goto fail;
+		}
+		if (tokenIsChar(token, ')'))
+			break;
+		if (tokenIsChar(token, ',') == false) {
+			error = CSS_INVALID;
+			goto fail;
+		}
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+	}
+
+	*out = head;
+	return CSS_OK;
+
+fail:
+	if (head != NULL)
+		css__stylesheet_selector_destroy(c->sheet, head);
+	return error;
+}
