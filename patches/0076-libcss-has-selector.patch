+/**
+ * Match one :has() argument's compound against a candidate node
+ * (VitaSurf).
+ */
+static css_error match_has_compound(css_select_ctx *ctx, void *n,
+		const css_selector *sub, css_select_state *state,
+		bool *match)
+{
+	css_error error;
+
+	*match = false;
+
+	if (sub->data.qname.name != ctx->str.universal) {
+		error = state->handler->node_has_name(state->pw, n,
+				&sub->data.qname, match);
+		if (error != CSS_OK)
+			return error;
+		if (*match == false)
+			return CSS_OK;
+	}
+
+	return match_details(ctx, n, &sub->data, state, match, NULL);
+}
