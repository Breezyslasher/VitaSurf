+/**
+ * Match a :has() detail (VitaSurf).
+ *
+ * The arguments are a chain of compounds (see parseHasArgs in
+ * parse/language.c), each with the combinator that relates it to the
+ * subject in its data.comb. The subject matches when any argument
+ * finds an element: a descendant for CSS_COMBINATOR_NONE, a child for
+ * PARENT, the next sibling element for SIBLING and any later sibling
+ * for GENERIC_SIBLING. The descendant walk is depth first without
+ * recursion, climbing back through parent_node until it reaches the
+ * subject again.
+ *
+ * \param[in]  ctx    Selection context.
+ * \param[in]  node   Subject node.
+ * \param[in]  sub    First argument compound.
+ * \param[in]  state  Selection state.
+ * \param[out] match  Set to whether any argument matched.
+ * 
+eturn CSS_OK on success, appropriate error otherwise.
+ */
+static css_error match_has(css_select_ctx *ctx, void *node,
+		const css_selector *sub, css_select_state *state,
+		bool *match)
+{
+	const css_select_handler *h = state->handler;
+	css_error error;
+
+	*match = false;
+
+	if (h->first_child_node == NULL || h->next_sibling_node == NULL)
+		return CSS_OK;
+
+	for (; sub != NULL; sub = sub->combinator) {
+		void *n = NULL;
+
+		switch (sub->data.comb) {
+		case CSS_COMBINATOR_SIBLING:
+		case CSS_COMBINATOR_GENERIC_SIBLING:
+			if (node == state->node) {
+				state->node_data->flags |=
+						CSS_NODE_FLAGS_TAINT_SIBLING;
+			}
+			error = h->next_sibling_node(state->pw, node, &n);
+			if (error != CSS_OK)
+				return error;
+			while (n != NULL) {
+				error = match_has_compound(ctx, n, sub, state,
+						match);
+				if (error != CSS_OK)
+					return error;
+				if (*match ||
+				    sub->data.comb == CSS_COMBINATOR_SIBLING)
+					break;
+				error = h->next_sibling_node(state->pw, n, &n);
+				if (error != CSS_OK)
+					return error;
+			}
+			break;
+
+		case CSS_COMBINATOR_PARENT:
+			error = h->first_child_node(state->pw, node, &n);
+			if (error != CSS_OK)
+				return error;
+			while (n != NULL) {
+				error = match_has_compound(ctx, n, sub, state,
+						match);
+				if (error != CSS_OK)
+					return error;
+				if (*match)
+					break;
+				error = h->next_sibling_node(state->pw, n, &n);
+				if (error != CSS_OK)
+					return error;
+			}
+			break;
+
+		default:
+			error = h->first_child_node(state->pw, node, &n);
+			if (error != CSS_OK)
+				return error;
+			while (n != NULL) {
+				void *next = NULL;
+
+				error = match_has_compound(ctx, n, sub, state,
+						match);
+				if (error != CSS_OK)
+					return error;
+				if (*match)
+					break;
+
+				/* Down, else along, else up until there is
+				 * an along, stopping at the subject. */
+				error = h->first_child_node(state->pw, n,
+						&next);
+				if (error != CSS_OK)
+					return error;
+				while (next == NULL) {
+					error = h->next_sibling_node(state->pw,
+							n, &next);
+					if (error != CSS_OK)
+						return error;
+					if (next != NULL)
+						break;
+					error = h->parent_node(state->pw, n,
+							&n);
+					if (error != CSS_OK)
+						return error;
+					if (n == NULL || n == node)
+						break;
+				}
+				n = next;
+			}
+			break;
+		}
+
+		if (*match)
+			break;
+	}
+
+	return CSS_OK;
+}
