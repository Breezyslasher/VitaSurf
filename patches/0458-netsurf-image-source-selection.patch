+/**
+ * \file
+ * Which image an <img> shows: srcset, sizes and <picture> (VitaSurf).
+ */
+
+#ifndef NETSURF_HTML_IMAGE_SOURCE_H
+#define NETSURF_HTML_IMAGE_SOURCE_H
+
+struct html_content;
+struct dom_node;
+struct nsurl;
+
+/**
+ * Whether an <img> has a choice to make: a srcset, or a <picture> as
+ * its parent. One without shows its src, as it always has.
+ */
+bool html_image_has_choice(struct dom_node *img);
+
+/**
+ * The address an <img> shows now, chosen as the HTML standard selects
+ * an image source.
+ *
+ * \param c    The document's content
+ * \param img  The <img> element
+ * \param url  Set to the address, or NULL when it has none
+ * \return NSERROR_OK, or NSERROR_NOMEM
+ */
+nserror html_image_source(struct html_content *c, struct dom_node *img,
+		struct nsurl **url);
+
+#endif
