+/** The <img> a <source> is for: the one after it in its <picture>. */
+static dom_node *html_picture_img(dom_node *source)
+{
+	dom_node *parent = NULL, *n = NULL;
+	dom_string *name = NULL;
+	bool picture = false;
+
+	if (dom_node_get_parent_node(source, &parent) != DOM_NO_ERR ||
+			parent == NULL)
+		return NULL;
+	if (dom_node_get_node_name(parent, &name) == DOM_NO_ERR &&
+			name != NULL) {
+		picture = strcasecmp(dom_string_data(name), "PICTURE") == 0;
+		dom_string_unref(name);
+	}
+	dom_node_unref(parent);
+	if (!picture || dom_node_get_next_sibling(source, &n) != DOM_NO_ERR)
+		return NULL;
+	while (n != NULL) {
+		dom_node *next = NULL;
+
+		name = NULL;
+		if (dom_node_get_node_name(n, &name) == DOM_NO_ERR &&
+				name != NULL) {
+			bool img = strcasecmp(dom_string_data(name),
+					"IMG") == 0;
+
+			dom_string_unref(name);
+			if (img)
+				return n;
+		}
+		if (dom_node_get_next_sibling(n, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(n);
+		n = next;
+	}
+	return NULL;
+}
