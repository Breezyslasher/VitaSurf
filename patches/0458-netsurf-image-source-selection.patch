+/**
+ * Fetch what an <img> shows now that its src, srcset or sizes, or a
+ * source of its <picture>, has changed (VitaSurf): 1 if it changed, 0
+ * if it is the same, -1 if it has no image to replace.
+ */
+static int html_img_reselect(html_content *c, dom_node *img,
+		struct box *box)
+{
+	nsurl *url = NULL;
+	int got = -1;
+
+	if (html_image_has_choice(img)) {
+		if (html_image_source(c, img, &url) != NSERROR_OK)
+			url = NULL;
+	} else {
+		dom_string *src = NULL;
+
+		if (dom_element_get_attribute(img, corestring_dom_src,
+				&src) == DOM_NO_ERR && src != NULL) {
+			if (!box_extract_link(c, src, c->base_url, &url))
+				url = NULL;
+			dom_string_unref(src);
+		}
+	}
+	if (url != NULL) {
+		got = html_object_set_src(c, box, url);
+		nsurl_unref(url);
+	}
+	return got;
+}
