diff --git a/content/handlers/html/image_source.c b/content/handlers/html/image_source.c
new file mode 100644
index 000000000..85f13ad8b
--- /dev/null
+++ b/content/handlers/html/image_source.c
@@ -0,0 +1,782 @@
+/*
