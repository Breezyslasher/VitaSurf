+/*
+ * Appends op2 to op1 in place when op1's string can take it, as
+ * JS_ConcatString2 does, for a caller that knows the refs references
+ * to it are all ones the result replaces (VitaSurf): a flat, short
+ * string, not an atom, with room in its block. Nothing is freed; false
+ * leaves both as they were.
+ */
+static bool js_concat_in_place(JSContext *ctx, JSValueConst op1,
+                               JSValueConst op2, int refs)
+{
+    JSString *p1, *p2;
+
+    if (JS_VALUE_GET_TAG(op1) != JS_TAG_STRING ||
+        JS_VALUE_GET_TAG(op2) != JS_TAG_STRING)
+        return false;
+    p1 = JS_VALUE_GET_STRING(op1);
+    p2 = JS_VALUE_GET_STRING(op2);
+    if (p1->header.ref_count != refs || p1->atom_type != 0 ||
+        p1->kind != JS_STRING_KIND_NORMAL ||
+        p1->is_wide_char != p2->is_wide_char ||
+        p1->len > JS_STRING_ROPE_SHORT2_LEN ||
+        p2->len > JS_STRING_ROPE_SHORT_LEN ||
+        js_malloc_usable_size(ctx, p1) < sizeof(*p1) +
+        ((p1->len + p2->len) << p2->is_wide_char) + 1 - p1->is_wide_char)
+        return false;
+    if (p1->hash_next) {
+        /* its cached atom is for what it held before */
+        JS_FreeAtomRT(ctx->rt, p1->hash_next);
+        p1->hash_next = 0;
+    }
+    if (p1->is_wide_char) {
+        memcpy(str16(p1) + p1->len, str16(p2), p2->len << 1);
+        p1->len += p2->len;
+    } else {
+        memcpy(str8(p1) + p1->len, str8(p2), p2->len);
+        p1->len += p2->len;
+        str8(p1)[p1->len] = '\0';
+    }
+    return true;
+}
