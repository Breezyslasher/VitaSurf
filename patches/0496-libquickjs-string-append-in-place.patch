+/*
+ * Whether the instruction at pc stores the top of the stack, without
+ * reading it, in a variable that now holds v (VitaSurf): OP_add's
+ * in-place append.
+ */
+static inline bool js_add_stores_over(const uint8_t *pc, JSValue *var_buf,
+                                      JSValue *arg_buf, JSVarRef **var_refs,
+                                      JSValueConst v)
+{
+    JSValue *slot;
+
+    switch (pc[0]) {
+    case OP_put_loc: case OP_set_loc: case OP_put_loc_check:
+        slot = &var_buf[get_u16(pc + 1)]; break;
+    case OP_put_loc8: case OP_set_loc8:
+        slot = &var_buf[pc[1]]; break;
+    case OP_put_loc0: case OP_set_loc0: slot = &var_buf[0]; break;
+    case OP_put_loc1: case OP_set_loc1: slot = &var_buf[1]; break;
+    case OP_put_loc2: case OP_set_loc2: slot = &var_buf[2]; break;
+    case OP_put_loc3: case OP_set_loc3: slot = &var_buf[3]; break;
+    case OP_put_arg: case OP_set_arg:
+        slot = &arg_buf[get_u16(pc + 1)]; break;
+    case OP_put_arg0: case OP_set_arg0: slot = &arg_buf[0]; break;
+    case OP_put_arg1: case OP_set_arg1: slot = &arg_buf[1]; break;
+    case OP_put_arg2: case OP_set_arg2: slot = &arg_buf[2]; break;
+    case OP_put_arg3: case OP_set_arg3: slot = &arg_buf[3]; break;
+    case OP_put_var_ref: case OP_set_var_ref:
+        slot = var_refs[get_u16(pc + 1)]->pvalue; break;
+    case OP_put_var_ref0: case OP_set_var_ref0: slot = var_refs[0]->pvalue; break;
+    case OP_put_var_ref1: case OP_set_var_ref1: slot = var_refs[1]->pvalue; break;
+    case OP_put_var_ref2: case OP_set_var_ref2: slot = var_refs[2]->pvalue; break;
+    case OP_put_var_ref3: case OP_set_var_ref3: slot = var_refs[3]->pvalue; break;
+    default:
+        return false;
+    }
+    return JS_VALUE_GET_TAG(*slot) == JS_VALUE_GET_TAG(v) &&
+        JS_VALUE_GET_PTR(*slot) == JS_VALUE_GET_PTR(v);
+}
