diff --git a/content/handlers/html/layout_flex.c b/content/handlers/html/layout_flex.c
index bf0f09025..d5a4f705e 100644
--- a/content/handlers/html/layout_flex.c
+++ b/content/handlers/html/layout_flex.c
@@ -296,6 +296,29 @@ static inline bool layout_flex__base_and_main_sizes(
 	int content_max_width = b->max_width;
 	int delta_outer_main = lh__delta_outer_main(ctx->flex, b);
 
+	/*
+	 * An item's min and max widths are its content plus its margins,
+	 * borders and padding, and layout_minmax_block counts those as
+	 * nothing when they add up to less than nothing (VitaSurf). The
+	 * item's outer size is then its content plus the real sum, as
+	 * CSS Flexbox has it: stackoverflow.com's sidebar icons sit in a
+	 * 32px circle with -8px margins either side, which came out 2px
+	 * too wide, and 16px with calc() margins.
+	 */
+	if (ctx->horizontal) {
+		int fixed = 0;
+		float frac = 0;
+
+		calculate_mbp_width(ctx->unit_len_ctx, b->style, LEFT,
+				true, true, true, &fixed, &frac);
+		calculate_mbp_width(ctx->unit_len_ctx, b->style, RIGHT,
+				true, true, true, &fixed, &frac);
+		if (fixed < 0) {
+			content_min_width = max(content_min_width + fixed, 0);
+			content_max_width = max(content_max_width + fixed, 0);
+		}
+	}
+
 	NSLOG(flex, DEEPDEBUG, "box %p: delta_outer_main: %i",
 			b, delta_outer_main);
 
