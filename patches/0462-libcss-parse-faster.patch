+/*
+ * The property a name is (VitaSurf): a table keyed by the interned
+ * caseless form of each property's name, where a declaration had been
+ * compared with every name in turn until one matched, a hundred
+ * comparisons for an average one. The table is rebuilt whenever the
+ * names it was made from are not the ones in use, and a hit is checked
+ * against the name, so it can only ever save the search.
+ */
+#define PROP_TABLE_SIZE 1024
+
+static struct {
+	unsigned int generation;	/**< of the names it was built from,
+					     0 for none */
+	lwc_string *key[PROP_TABLE_SIZE];
+	uint16_t index[PROP_TABLE_SIZE];
+} prop_table;
+
+static inline uint32_t prop_slot(const lwc_string *key)
+{
+	return (((uint32_t) ((uintptr_t) key >> 4)) * 2654435761u >> 8) &
+			(PROP_TABLE_SIZE - 1);
+}
+
+static bool property_table_build(lwc_string *const *strings)
+{
+	int i;
+
+	memset(&prop_table, 0, sizeof(prop_table));
+	for (i = FIRST_PROP; i <= LAST_PROP; i++) {
+		lwc_string *k;
+		uint32_t at;
+
+		if (strings[i]->insensitive == NULL &&
+				lwc__intern_caseless_string(strings[i]) !=
+				lwc_error_ok) {
+			prop_table.generation = 0;
+			return false;
+		}
+		k = strings[i]->insensitive;
+		for (at = prop_slot(k); prop_table.key[at] != NULL &&
+				prop_table.key[at] != k;
+				at = (at + 1) & (PROP_TABLE_SIZE - 1))
+			;
+		if (prop_table.key[at] == NULL) {
+			prop_table.key[at] = k;
+			prop_table.index[at] = (uint16_t) i;
+		}
+	}
+	prop_table.generation = css__propstrings_generation;
+	return true;
+}
+
+static int property_index(css_language *c, lwc_string *name)
+{
+	lwc_string *k;
+	uint32_t at;
+	int i;
+
+	if (name == NULL)
+		return LAST_PROP + 1;
+	if (prop_table.generation != css__propstrings_generation &&
+			!property_table_build(c->strings))
+		goto search;
+	if (name->insensitive == NULL &&
+			lwc__intern_caseless_string(name) != lwc_error_ok)
+		goto search;
+	k = name->insensitive;
+	for (at = prop_slot(k); prop_table.key[at] != NULL;
+			at = (at + 1) & (PROP_TABLE_SIZE - 1)) {
+		if (prop_table.key[at] == k)
+			return prop_table.index[at];
+	}
+	return LAST_PROP + 1;
+
+search:
+	for (i = FIRST_PROP; i <= LAST_PROP; i++) {
+		bool match = false;
+
+		if (lwc_string_caseless_isequal(name, c->strings[i],
+				&match) == lwc_error_ok && match)
+			break;
+	}
+	return i;
+}
