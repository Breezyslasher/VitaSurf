+/**
+ * Add a token to the parser's vector (VitaSurf): a structure copy where
+ * the vector holds tokens and has room, which it nearly always has,
+ * where it was a call to memcpy with the size read from the vector.
+ */
+static inline css_error appendToken(css_parser *parser, const css_token *t)
+{
+	parserutils_vector *v = parser->tokens;
+	int32_t slot = v->current_item + 1;
+
+	if (v->item_size == sizeof(css_token) && v->current_item >= -1 &&
+			v->current_item < INT32_MAX &&
+			(size_t) slot < v->items_allocated) {
+		((css_token *) v->items)[slot] = *t;
+		v->current_item = slot;
+		return CSS_OK;
+	}
+	return css_error_from_parserutils_error(
+			parserutils_vector_append(v, (void *) t));
+}
+
+/**
+ * Read the next token from the lexer, interned, without adding it to the
+ * token vector (VitaSurf): what getToken and eatWS share.
+ */
+static css_error readToken(css_parser *parser, css_token **token)
+{
+	lwc_error lerror;
+	css_error error;
+	css_token *t;
+
+	error = css__lexer_get_token(parser->lexer, &t);
+	if (error != CSS_OK)
+		return error;
+
+	/* If the last token read was whitespace, keep reading
+	 * tokens until we encounter one that isn't whitespace */
+	while (parser->last_was_ws && t->type == CSS_TOKEN_S) {
+		error = css__lexer_get_token(parser->lexer, &t);
+		if (error != CSS_OK)
+			return error;
+	}
+
+	/* We need only intern for the following token types:
+	 *
+	 * CSS_TOKEN_IDENT, CSS_TOKEN_ATKEYWORD, CSS_TOKEN_STRING,
+	 * CSS_TOKEN_INVALID_STRING, CSS_TOKEN_HASH, CSS_TOKEN_URI,
+	 * CSS_TOKEN_UNICODE_RANGE?, CSS_TOKEN_FUNCTION, CSS_TOKEN_CHAR,
+	 * CSS_TOKEN_NUMBER, CSS_TOKEN_PERCENTAGE, CSS_TOKEN_DIMENSION
+	 *
+	 * These token types all appear before CSS_TOKEN_LAST_INTERN.
+	 * All other token types appear after this magic value.
+	 */
+
+	if (t->type < CSS_TOKEN_LAST_INTERN && t->data.data != NULL) {
+		/* Insert token text into the dictionary */
+		lerror = lwc_intern_string((char *)t->data.data,
+					    t->data.len, &t->idata);
+		if (lerror != lwc_error_ok)
+			return css_error_from_lwc_error(lerror);
+	} else {
+		t->idata = NULL;
+	}
+
+	*token = t;
+	return CSS_OK;
+}
