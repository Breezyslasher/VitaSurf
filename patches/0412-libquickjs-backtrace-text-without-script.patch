+/* VitaSurf: see quickjs.h */
+int JS_GetBacktraceText(JSContext *ctx, char *buf, int buf_len,
+                        int max_frames)
+{
+    JSStackFrame *sf;
+    int n = 0, frames = 0, w;
+
+    if (buf_len <= 0)
+        return 0;
+    buf[0] = '\0';
+    for (sf = ctx->rt->current_stack_frame;
+         sf != NULL && frames < max_frames && n < buf_len - 1;
+         sf = sf->prev_frame) {
+        JSObject *p;
+        JSFunctionBytecode *b = NULL;
+        const char *name, *file = NULL;
+        int line = -1, col = 0;
+
+        if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+            continue;
+        p = JS_VALUE_GET_OBJ(sf->cur_func);
+        if (js_class_has_bytecode(p->class_id))
+            b = p->u.func.function_bytecode;
+        name = get_func_name(ctx, sf->cur_func);
+        if (b && sf->cur_pc) {
+            line = find_line_num(ctx, b,
+                                 sf->cur_pc - b->byte_code_buf - 1, &col);
+            file = b->filename ? JS_AtomToCString(ctx, b->filename) : NULL;
+        }
+        if (b && sf->cur_pc && line != -1)
+            w = snprintf(buf + n, buf_len - n, "    at %s (%s:%d:%d)\n",
+                         name && name[0] ? name : "<anonymous>",
+                         file ? file : "<null>", line, col);
+        else if (b && sf->cur_pc)
+            w = snprintf(buf + n, buf_len - n, "    at %s (%s)\n",
+                         name && name[0] ? name : "<anonymous>",
+                         file ? file : "<null>");
+        else
+            w = snprintf(buf + n, buf_len - n, "    at %s (%s)\n",
+                         name && name[0] ? name : "<anonymous>",
+                         b ? "missing" : "native");
+        JS_FreeCString(ctx, name);
+        JS_FreeCString(ctx, file);
+        if (w < 0)
+            break;
+        n += w;
+        if (n >= buf_len - 1) {
+            n = buf_len - 1;
+            buf[n] = '\0';
+        }
+        frames++;
+        if (b && b->backtrace_barrier)
+            break;
+    }
+    return n;
+}
+
