 {
 	dom_attr_list *match;
 	dom_node_internal *e = (dom_node_internal *) element;
@@ -1688,7 +1691,7 @@ dom_exception _dom_element_set_attr(struct dom_element *element,
 		struct dom_document *doc;
 		bool success = true;
 
-		err = _dom_attr_create(e->owner, name, namespace, NULL,
+		err = _dom_attr_create(e->owner, name, namespace, prefix,
 				true, &attr);
 		if (err != DOM_NO_ERR)
 			return err;
