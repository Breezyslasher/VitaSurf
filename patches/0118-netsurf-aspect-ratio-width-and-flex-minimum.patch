+/**
+ * Whether a box with width auto takes the width of its content rather
+ * than of its containing block (VitaSurf).
+ *
+ * CSS Sizing 4: an aspect ratio resolves an automatic width only for
+ * such a box. A block-level box in normal flow fills its containing
+ * block instead, whatever ratio it names.
+ */
+static inline bool layout_shrink_to_fit_width(
+		const struct box *box,
+		const css_computed_style *style)
+{
+	if (css_computed_position(style) == CSS_POSITION_ABSOLUTE ||
+	    css_computed_position(style) == CSS_POSITION_FIXED) {
+		return true;
+	}
+	if (css_computed_float(style) == CSS_FLOAT_LEFT ||
+	    css_computed_float(style) == CSS_FLOAT_RIGHT) {
+		return true;
+	}
+	return box->type == BOX_INLINE_BLOCK ||
+	       box->type == BOX_INLINE_FLEX;
+}
