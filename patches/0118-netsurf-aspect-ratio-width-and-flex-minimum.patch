+/**
+ * Whether a flex item's content is the smallest it may be (VitaSurf).
+ *
+ * Flexbox 4.5: an item is kept as wide as its content only while its
+ * minimum size on the main axis is auto and it does not hide what
+ * overflows. Writing min-width: 0, or overflow: hidden, is how a page
+ * lets a long line shrink and be cut off, and this floored it at the
+ * width of the longest word instead, which pushed everything beside it
+ * off the screen.
+ *
+ * \param[in] ctx   Flex layout context
+ * \param[in] b     Flex item box
+ * \return true if the item may be no smaller than its content
+ */
+static inline bool layout_flex__auto_minimum(
+		const struct flex_ctx *ctx,
+		const struct box *b)
+{
+	if (ctx->horizontal) {
+		return css_computed_min_width_is_auto(b->style) &&
+				css_computed_overflow_x(b->style) ==
+						CSS_OVERFLOW_VISIBLE;
+	}
+
+	return css_computed_min_height_is_auto(b->style) &&
+			css_computed_overflow_y(b->style) ==
+					CSS_OVERFLOW_VISIBLE;
+}
