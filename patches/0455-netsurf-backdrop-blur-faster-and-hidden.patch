+/**
+ * Whether a box paints itself at all (VitaSurf): not one that is
+ * transparent or hidden. A backdrop-filter is part of what the box
+ * paints, and apple.com's navigation curtain, hidden and transparent
+ * until a menu opens, blurred the whole page under it at every redraw,
+ * 1.35 s each.
+ */
+static bool html_box_paints(const struct box *box)
+{
+	css_fixed op = INTTOFIX(1);
+
+	if (box->style == NULL)
+		return true;
+	if (css_computed_visibility(box->style) == CSS_VISIBILITY_HIDDEN)
+		return false;
+	if (css_computed_opacity(box->style, &op) == CSS_OPACITY_SET &&
+			op <= 0)
+		return false;
+	if (box->filter != NULL && box->filter->alpha <= 0)
+		return false;
+	return true;
+}
+
