+static void reach_compound(css_stylesheet *sheet,
+		const css_selector *sel, int set);
+
+/** Key every compound of a chain whose reach is past its subtree. */
+static void reach_chain(css_stylesheet *sheet, const css_selector *selector)
+{
+	const css_selector *sel, *prev = NULL;
+	bool deep = false;
+
+	for (sel = selector; sel != NULL; prev = sel, sel = sel->combinator) {
+		int set = -1;
+
+		if (prev != NULL) {
+			if (prev->data.comb == CSS_COMBINATOR_SIBLING ||
+					prev->data.comb ==
+					CSS_COMBINATOR_GENERIC_SIBLING) {
+				set = deep ? 4 + CSS_REACH_SIBLINGS_DEEP :
+					4 + CSS_REACH_SIBLINGS;
+			} else {
+				set = 4 + CSS_REACH_DESCENDANTS;
+				deep = true;
+			}
+		}
+		reach_compound(sheet, sel, set);
+	}
+}
+
+/** Key a compound's details in one set, or only its arguments if -1. */
+static void reach_compound(css_stylesheet *sheet,
+		const css_selector *sel, int set)
+{
+	const css_selector_detail *d = &sel->data;
+
+	for (;;) {
+		const char *n = lwc_string_data(d->qname.name);
+
+		if (d->type == CSS_SELECTOR_PSEUDO_CLASS &&
+				d->value_type ==
+				CSS_SELECTOR_DETAIL_VALUE_SELECTOR) {
+			/* each argument is one compound, the alternatives
+			 * chained through their combinators */
+			const css_selector *alt;
+			int inner = set;
+
+			if (strcasecmp(n, "has") == 0)
+				inner = 4 + CSS_REACH_HAS;
+			else if (strncasecmp(n, "nth-", 4) == 0)
+				inner = 4 + CSS_REACH_SIBLINGS;
+			for (alt = d->value.selector; alt != NULL;
+					alt = alt->combinator)
+				reach_compound(sheet, alt, inner);
+		} else if (set >= 0) {
+			switch (d->type) {
+			case CSS_SELECTOR_CLASS:
+				reach_key_add(sheet, set,
+						CSS_DYNAMIC_KEY_CLASS,
+						d->qname.name);
+				break;
+			case CSS_SELECTOR_ID:
+				reach_key_add(sheet, set,
+						CSS_DYNAMIC_KEY_ID,
+						d->qname.name);
+				break;
+			case CSS_SELECTOR_ATTRIBUTE:
+			case CSS_SELECTOR_ATTRIBUTE_EQUAL:
+			case CSS_SELECTOR_ATTRIBUTE_DASHMATCH:
+			case CSS_SELECTOR_ATTRIBUTE_INCLUDES:
+			case CSS_SELECTOR_ATTRIBUTE_PREFIX:
+			case CSS_SELECTOR_ATTRIBUTE_SUFFIX:
+			case CSS_SELECTOR_ATTRIBUTE_SUBSTRING:
+				reach_key_add(sheet, set,
+						CSS_DYNAMIC_KEY_ATTRIBUTE,
+						d->qname.name);
+				break;
+			case CSS_SELECTOR_PSEUDO_CLASS:
+			{
+				size_t i, a;
+
+				for (i = 0; i < sizeof(reach_pseudo) /
+						sizeof(reach_pseudo[0]); i++) {
+					if (strcasecmp(n,
+						reach_pseudo[i].name) == 0)
+						break;
+				}
+				if (i == sizeof(reach_pseudo) /
+						sizeof(reach_pseudo[0])) {
+					sheet->dynamic_keys[set].any = true;
+					break;
+				}
+				for (a = 0; a < 3 &&
+						reach_pseudo[i].attrs[a] !=
+						NULL; a++)
+					reach_attr_add(sheet, set,
+						reach_pseudo[i].attrs[a]);
+				break;
+			}
+			default:
+				/* element names and pseudo-elements */
+				break;
+			}
+		}
+		if (d->next == 0)
+			break;
+		d++;
+	}
+}
