+
+/** Add a key to one of the sheet's key sets, once. */
+static void reach_key_add(css_stylesheet *sheet, int set, uint32_t kind,
+		lwc_string *name)
+{
+	css_dynamic_key *k;
+	uint32_t j;
+
+	if (sheet->dynamic_keys[set].any)
+		return;
+	for (j = 0; j < sheet->dynamic_keys[set].n; j++) {
+		if (sheet->dynamic_keys[set].keys[j].kind == kind &&
+				sheet->dynamic_keys[set].keys[j].name == name)
+			return;
+	}
+	if (sheet->dynamic_keys[set].n == sheet->dynamic_keys[set].alloc) {
+		uint32_t want = sheet->dynamic_keys[set].alloc ?
+			sheet->dynamic_keys[set].alloc * 2 : 8;
+
+		k = realloc(sheet->dynamic_keys[set].keys, want * sizeof(*k));
+		if (k == NULL) {
+			sheet->dynamic_keys[set].any = true;
+			return;
+		}
+		sheet->dynamic_keys[set].keys = k;
+		sheet->dynamic_keys[set].alloc = want;
+	}
+	k = &sheet->dynamic_keys[set].keys[sheet->dynamic_keys[set].n++];
+	k->kind = kind;
+	k->name = lwc_string_ref(name);
+}
+
+/** Key an attribute by its name, as a C string. */
+static void reach_attr_add(css_stylesheet *sheet, int set, const char *name)
+{
+	lwc_string *s = NULL;
+
+	if (lwc_intern_string(name, strlen(name), &s) != lwc_error_ok) {
+		sheet->dynamic_keys[set].any = true;
+		return;
+	}
+	reach_key_add(sheet, set, CSS_DYNAMIC_KEY_ATTRIBUTE, s);
+	lwc_string_unref(s);
+}
