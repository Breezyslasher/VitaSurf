+/*
+ * The attribute names a rule's key compound insists on (VitaSurf).
+ *
+ * 94% of the candidates a GitHub page offers come out of the universal
+ * chain, where a rule like [data-view-component] is handed to every
+ * element there is and then refused on its first detail. The names it
+ * needs are known when it is filed, and the names a node has are asked
+ * for once per node, so most of that can be settled with an and.
+ *
+ * Every name in the compound is OR-ed in, because they must all be
+ * present for the compound to match, so the test stays "every bit the
+ * rule wants is a bit the node has". A negated detail asks for the
+ * absence of an attribute and so says nothing about what the node
+ * carries; those are left out.
+ */
+uint64_t css_attribute_bloom_bits(const char *name, size_t len)
+{
+	uint32_t h = 2166136261u;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		unsigned char c = (unsigned char) name[i];
+
+		if (c >= 'A' && c <= 'Z')
+			c = (unsigned char) (c + ('a' - 'A'));
+		h ^= c;
+		h *= 16777619u;
+	}
+
+	return (1ull << (h & 63)) | (1ull << ((h >> 8) & 63));
+}
+
+static uint64_t _attrs_needed(const css_selector *selector)
+{
+	const css_selector_detail *d = &selector->data;
+	uint64_t bits = 0;
+
+	do {
+		switch (d->type) {
+		case CSS_SELECTOR_ATTRIBUTE:
+		case CSS_SELECTOR_ATTRIBUTE_EQUAL:
+		case CSS_SELECTOR_ATTRIBUTE_DASHMATCH:
+		case CSS_SELECTOR_ATTRIBUTE_INCLUDES:
+		case CSS_SELECTOR_ATTRIBUTE_PREFIX:
+		case CSS_SELECTOR_ATTRIBUTE_SUFFIX:
+		case CSS_SELECTOR_ATTRIBUTE_SUBSTRING:
+			if (d->negate == 0 && d->qname.name != NULL) {
+				bits |= css_attribute_bloom_bits(
+					lwc_string_data(d->qname.name),
+					lwc_string_length(d->qname.name));
+			}
+			break;
+		default:
+			break;
+		}
+	} while (d->next != 0 && (d = d + 1) != NULL);
+
+	return bits;
+}
