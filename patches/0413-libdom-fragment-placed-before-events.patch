 		}
 	} else {
 		err = _dom_node_attach(new_child, 
@@ -2364,11 +2368,44 @@ dom_exception _dom_node_attach_range(dom_node_internal *first,
 		return DOM_NO_ERR;
 	}
 
-	for (n = first; n != last->next; n = n->next) {
