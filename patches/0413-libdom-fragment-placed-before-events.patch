 							  : ref_child->previous,
@@ -896,9 +903,6 @@ dom_exception _dom_node_insert_before(dom_node_internal *node,
 							  : ref_child);
 			if (err != DOM_NO_ERR)
 				return err;
-
-			new_child->first_child = NULL;
