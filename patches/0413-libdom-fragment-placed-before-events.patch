+	/*
+	 * Every node is in the tree before any event about one is sent
+	 * (VitaSurf), as the DOM's insert has it: the first node's event
+	 * runs a <script> among them, and the nodes after it still had the
+	 * fragment for a parent, so a script that walked the document
+	 * followed them back into the fragment and the walk crashed. The
+	 * events go to a list of the nodes taken first, each held, so a
+	 * script that moves or removes one cannot break the walk along
+	 * them; one no longer under the parent hears nothing.
+	 */
+	{
+		dom_node_internal **list, *one[8];
+		size_t count = 0, i;
+
+		for (n = first; n != last->next; n = n->next) {
+			n->parent = parent;
+			count++;
+		}
+		list = count <= 8 ? one : malloc(count * sizeof(*list));
+		if (list == NULL)
+			return DOM_NO_MEM_ERR;
+		i = 0;
+		for (n = first; n != last->next; n = n->next) {
+			dom_node_ref(n);
+			list[i++] = n;
+		}
+		err = DOM_NO_ERR;
+		for (i = 0; i < count; i++) {
+			if (err == DOM_NO_ERR && list[i]->parent == parent) {
+				/* Dispatch a DOMNodeInserted event */
+				err = dom_node_dispatch_node_change_event(
+						parent->owner, list[i], parent,
+						DOM_MUTATION_ADDITION, &success);
+			}
+			dom_node_unref(list[i]);
+		}
+		if (list != one)
+			free(list);
 		if (err != DOM_NO_ERR)
 			return err;
 	}
