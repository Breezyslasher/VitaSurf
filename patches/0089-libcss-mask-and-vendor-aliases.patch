+
+css_error css__cascade_mask_size(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_MASK_SIZE_INHERIT;
+	css_fixed hlength = 0;
+	css_fixed vlength = 0;
+	uint32_t hunit = UNIT_PX;
+	uint32_t vunit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case MASK_SIZE_AUTO:
+			value = CSS_MASK_SIZE_AUTO;
+			break;
+		case MASK_SIZE_COVER:
+			value = CSS_MASK_SIZE_COVER;
+			break;
+		case MASK_SIZE_CONTAIN:
+			value = CSS_MASK_SIZE_CONTAIN;
+			break;
+		default:
+			value = CSS_MASK_SIZE_SET;
+			break;
+		}
+	}
+
+	if (value == CSS_MASK_SIZE_SET) {
+		hlength = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(hlength));
+		hunit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(hunit));
+
+		vlength = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(vlength));
+		vunit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(vunit));
+	}
+
+	hunit = css__to_css_unit(hunit);
+	vunit = css__to_css_unit(vunit);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_mask_size(state->computed, value,
+				hlength, hunit, vlength, vunit);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_mask_size_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_mask_size(style, hint->status,
+		hint->data.position.h.value, hint->data.position.h.unit,
+		hint->data.position.v.value, hint->data.position.v.unit);
+}
+
+css_error css__initial_mask_size(css_select_state *state)
+{
+	return set_mask_size(state->computed, CSS_MASK_SIZE_AUTO,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX);
+}
+
+css_error css__copy_mask_size(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed hlength = 0, vlength = 0;
+	css_unit hunit = CSS_UNIT_PX, vunit = CSS_UNIT_PX;
+	uint8_t type = get_mask_size(from, &hlength, &hunit,
+			&vlength, &vunit);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_mask_size(to, type, hlength, hunit, vlength, vunit);
+}
+
+css_error css__compose_mask_size(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed hlength = 0, vlength = 0;
+	css_unit hunit = CSS_UNIT_PX, vunit = CSS_UNIT_PX;
+	uint8_t type = get_mask_size(child, &hlength, &hunit,
+			&vlength, &vunit);
+
+	return css__copy_mask_size(
+			type == CSS_MASK_SIZE_INHERIT ? parent : child,
+			result);
+}
