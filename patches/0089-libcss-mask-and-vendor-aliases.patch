diff --git a/src/parse/properties/mask.c b/src/parse/properties/mask.c
new file mode 100644
index 0000000..0b1a28f
--- /dev/null
+++ b/src/parse/properties/mask.c
@@ -0,0 +1,493 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * mask-size, mask-position and the mask shorthand (VitaSurf). The two
+ * longhands read exactly as background-size and background-position,
+ * which they are copies of; the shorthand takes an image, a position
+ * with an optional "/ size", and steps over the repeat, mode and
+ * geometry keywords the renderer does not act on.
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+css_error css__parse_mask_size(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_fixed length[2] = { 0, 0 };
+	uint32_t unit[2] = { 0, 0 };
+	enum flag_value flag_value;
+	css_error error;
+	bool match;
+	int n = 0;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_MASK_SIZE);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT) {
+		if (lwc_string_caseless_isequal(token->idata, c->strings[COVER],
+				&match) == lwc_error_ok && match) {
+			parserutils_vector_iterate(vector, ctx);
+			return css__stylesheet_style_appendOPV(result,
+					CSS_PROP_MASK_SIZE, 0,
+					MASK_SIZE_COVER);
+		}
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[CONTAIN], &match) == lwc_error_ok &&
+				match) {
+			parserutils_vector_iterate(vector, ctx);
+			return css__stylesheet_style_appendOPV(result,
+					CSS_PROP_MASK_SIZE, 0,
+					MASK_SIZE_CONTAIN);
+		}
+	}
+
+	/*
+	 * One or two sizes, each a length, a percentage or auto. auto is
+	 * carried as a zero length in pixels, which is what the drawing
+	 * side reads as "this axis follows the picture".
+	 */
+	while (n < 2) {
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!')) {
+			break;
+		}
+
+		if (token->type == CSS_TOKEN_IDENT &&
+		    lwc_string_caseless_isequal(token->idata, c->strings[AUTO],
+				&match) == lwc_error_ok && match) {
+			parserutils_vector_iterate(vector, ctx);
+			length[n] = 0;
+			unit[n] = UNIT_PX;
+		} else {
+			int32_t before = *ctx;
+
+			error = css__parse_unit_specifier(c, vector, ctx,
+					UNIT_PX, &length[n], &unit[n]);
+			if (error != CSS_OK) {
+				*ctx = before;
+				break;
+			}
+			if ((unit[n] & UNIT_ANGLE) || (unit[n] & UNIT_TIME) ||
+					(unit[n] & UNIT_FREQ) ||
+					length[n] < 0) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		}
+		n++;
+		consumeWhitespace(vector, ctx);
+	}
+
+	if (n == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	if (n == 1) {
+		length[1] = 0;		/* the other axis follows */
+		unit[1] = UNIT_PX;
+	}
+
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_MASK_SIZE, 0, MASK_SIZE_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = css__stylesheet_style_vappend(result, 4,
+			length[0], unit[0], length[1], unit[1]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
+
+css_error css__parse_mask_position(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	css_error error;
+	const css_token *token;
+	uint8_t flags = 0;
+	uint16_t value[2] = { 0 };
+	css_fixed length[2] = { 0 };
+	uint32_t unit[2] = { 0 };
+	bool match;
+
+	/* [length | percentage | IDENT(left, right, top, bottom, center)]{1,2}
+	 * | IDENT(inherit) */
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[INHERIT],
+			&match) == lwc_error_ok && match)) {
+		parserutils_vector_iterate(vector, ctx);
+		flags = FLAG_INHERIT;
+	} else if (token->type == CSS_TOKEN_IDENT &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[INITIAL],
+			&match) == lwc_error_ok && match)) {
+		parserutils_vector_iterate(vector, ctx);
+		flags = FLAG_INITIAL;
+	} else if (token->type == CSS_TOKEN_IDENT &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[REVERT],
+			&match) == lwc_error_ok && match)) {
+		parserutils_vector_iterate(vector, ctx);
+		flags = FLAG_REVERT;
+	} else if (token->type == CSS_TOKEN_IDENT &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[UNSET],
+			&match) == lwc_error_ok && match)) {
+		parserutils_vector_iterate(vector, ctx);
+		flags = FLAG_UNSET;
+	} else {
+		int i;
+
+		for (i = 0; i < 2; i++) {
+			token = parserutils_vector_peek(vector, *ctx);
+			if (token == NULL)
+				break;
+
+			if (token->type == CSS_TOKEN_IDENT) {
+				if ((lwc_string_caseless_isequal(
+						token->idata, c->strings[LEFT],
+						&match) == lwc_error_ok &&
+						match)) {
+					value[i] =
+						MASK_POSITION_HORZ_LEFT;
+				} else if ((lwc_string_caseless_isequal(
+						token->idata, c->strings[RIGHT],
+						&match) == lwc_error_ok &&
+						match)) {
+					value[i] =
+						MASK_POSITION_HORZ_RIGHT;
+				} else if ((lwc_string_caseless_isequal(
+						token->idata, c->strings[TOP],
+						&match) == lwc_error_ok &&
+						match)) {
+					value[i] = MASK_POSITION_VERT_TOP;
+				} else if ((lwc_string_caseless_isequal(
+						token->idata,
+						c->strings[BOTTOM],
+						&match) == lwc_error_ok &&
+						match)) {
+					value[i] =
+						MASK_POSITION_VERT_BOTTOM;
+				} else if ((lwc_string_caseless_isequal(
+						token->idata,
+						c->strings[CENTER],
+						&match) == lwc_error_ok &&
+						match)) {
+					/* We'll fix this up later */
+					value[i] =
+						MASK_POSITION_VERT_CENTER;
+				} else if (i == 1) {
+					/* Second pass, so ignore this one */
+					break;
+				} else {
+					/* First pass, so invalid */
+					*ctx = orig_ctx;
+					return CSS_INVALID;
+				}
+
+				parserutils_vector_iterate(vector, ctx);
+			} else if (token->type == CSS_TOKEN_DIMENSION ||
+					token->type == CSS_TOKEN_NUMBER ||
+					token->type == CSS_TOKEN_PERCENTAGE) {
+				error = css__parse_unit_specifier(c, vector, ctx,
+						UNIT_PX, &length[i], &unit[i]);
+				if (error != CSS_OK) {
+					*ctx = orig_ctx;
+					return error;
+				}
+
+				if (unit[i] & UNIT_ANGLE ||
+						unit[i] & UNIT_TIME ||
+						unit[i] & UNIT_FREQ) {
+					*ctx = orig_ctx;
+					return CSS_INVALID;
+				}
+
+				/* We'll fix this up later, too */
+				value[i] = MASK_POSITION_VERT_SET;
+			} else {
+				if (i == 1) {
+					/* Second pass, so ignore */
+					break;
+				} else {
+					/* First pass, so invalid */
+					*ctx = orig_ctx;
+					return CSS_INVALID;
+				}
+			}
+
+			consumeWhitespace(vector, ctx);
+		}
+
+		assert(i != 0);
+
+		/* Now, sort out the mess we've got */
+		if (i == 1) {
+			assert(MASK_POSITION_VERT_CENTER ==
+					MASK_POSITION_HORZ_CENTER);
+
+			/* Only one value, so the other is center */
+			switch (value[0]) {
+			case MASK_POSITION_HORZ_LEFT:
+			case MASK_POSITION_HORZ_RIGHT:
+			case MASK_POSITION_VERT_CENTER:
+			case MASK_POSITION_VERT_TOP:
+			case MASK_POSITION_VERT_BOTTOM:
+				break;
+			case MASK_POSITION_VERT_SET:
+				value[0] = MASK_POSITION_HORZ_SET;
+				break;
+			}
+
+			value[1] = MASK_POSITION_VERT_CENTER;
+		} else if (value[0] != MASK_POSITION_VERT_SET &&
+				value[1] != MASK_POSITION_VERT_SET) {
+			/* Two keywords. Verify the axes differ */
+			if (((value[0] & 0xf) != 0 && (value[1] & 0xf) != 0) ||
+					((value[0] & 0xf0) != 0 &&
+						(value[1] & 0xf0) != 0)) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		} else {
+			/* One or two non-keywords. First is horizontal */
+			if (value[0] == MASK_POSITION_VERT_SET)
+				value[0] = MASK_POSITION_HORZ_SET;
+
+			/* Verify the axes differ */
+			if (((value[0] & 0xf) != 0 && (value[1] & 0xf) != 0) ||
+					((value[0] & 0xf0) != 0 &&
+						(value[1] & 0xf0) != 0)) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		}
+	}
+
+	error = css__stylesheet_style_appendOPV(result,
+					       CSS_PROP_MASK_POSITION,
+					       flags,
+					       value[0] | value[1]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	if ((flags & FLAG_INHERIT) == false) {
+		if (value[0] == MASK_POSITION_HORZ_SET) {
+			error = css__stylesheet_style_append(result, length[0]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+
+			error = css__stylesheet_style_append(result, unit[0]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+		}
+		if (value[1] == MASK_POSITION_VERT_SET) {
+			error = css__stylesheet_style_append(result, length[1]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+
+			error = css__stylesheet_style_append(result, unit[1]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+		}
+	}
+
+	return CSS_OK;
+}
+
+/* exported interface documented in properties.h */
+css_error css__parse_mask(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_style *image_style = NULL, *position_style = NULL,
+			*size_style = NULL;
+	bool image = true, position = true, size = true;
+	bool none = false;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (is_css_inherit(c, token)) {
+		/* a keyword for the whole shorthand applies to each part */
+		error = css__parse_mask_image(c, vector, ctx, result);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		*ctx = orig_ctx;
+		error = css__parse_mask_size(c, vector, ctx, result);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		*ctx = orig_ctx;
+		return css__parse_mask_position(c, vector, ctx, result);
+	}
+
+	error = css__stylesheet_style_create(c->sheet, &image_style);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_create(c->sheet, &position_style);
+	if (error != CSS_OK) {
+		css__stylesheet_style_destroy(image_style);
+		return error;
+	}
+	error = css__stylesheet_style_create(c->sheet, &size_style);
+	if (error != CSS_OK) {
+		css__stylesheet_style_destroy(image_style);
+		css__stylesheet_style_destroy(position_style);
+		return error;
+	}
+
+	for (;;) {
+		int32_t before;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!'))
+			break;
+
+		if (tokenIsChar(token, ',')) {
+			/* further layers are not painted */
+			css__skip_background_layers(vector, ctx);
+			break;
+		}
+		if (tokenIsChar(token, '/')) {
+			if (size == false)
+				goto invalid;
+			parserutils_vector_iterate(vector, ctx);
+			consumeWhitespace(vector, ctx);
+			error = css__parse_mask_size(c, vector, ctx, size_style);
+			if (error != CSS_OK)
+				goto invalid;
+			size = false;
+			continue;
+		}
+
+		before = *ctx;
+		if (image && (token->type == CSS_TOKEN_URI ||
+				token->type == CSS_TOKEN_FUNCTION ||
+				(token->type == CSS_TOKEN_IDENT &&
+				 lwc_string_caseless_isequal(token->idata,
+					c->strings[NONE], &none) ==
+					lwc_error_ok && none))) {
+			error = css__parse_mask_image(c, vector, ctx,
+					image_style);
+			if (error == CSS_OK) {
+				image = false;
+				continue;
+			}
+			*ctx = before;
+		}
+		if (position) {
+			error = css__parse_mask_position(c, vector, ctx,
+					position_style);
+			if (error == CSS_OK) {
+				position = false;
+				continue;
+			}
+			*ctx = before;
+		}
+		if (token->type == CSS_TOKEN_IDENT) {
+			/* repeat, mode, composite and geometry box keywords */
+			parserutils_vector_iterate(vector, ctx);
+			continue;
+		}
+		goto invalid;
+	}
+
+	if (image && position && size)
+		goto invalid;
+
+	if (image) {
+		error = css__stylesheet_style_appendOPV(image_style,
+				CSS_PROP_MASK_IMAGE, 0, MASK_IMAGE_NONE);
+		if (error != CSS_OK)
+			goto cleanup;
+	}
+	if (position) {
+		error = css__stylesheet_style_appendOPV(position_style,
+				CSS_PROP_MASK_POSITION, 0, MASK_POSITION_AUTO);
+		if (error != CSS_OK)
+			goto cleanup;
+	}
+	if (size) {
+		error = css__stylesheet_style_appendOPV(size_style,
+				CSS_PROP_MASK_SIZE, 0, MASK_SIZE_AUTO);
+		if (error != CSS_OK)
+			goto cleanup;
+	}
+
+	error = css__stylesheet_merge_style(result, image_style);
+	if (error != CSS_OK)
+		goto cleanup;
+	error = css__stylesheet_merge_style(result, position_style);
+	if (error != CSS_OK)
+		goto cleanup;
+	error = css__stylesheet_merge_style(result, size_style);
+	goto cleanup;
+
+invalid:
+	error = CSS_INVALID;
+cleanup:
+	css__stylesheet_style_destroy(image_style);
+	css__stylesheet_style_destroy(position_style);
+	css__stylesheet_style_destroy(size_style);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
diff --git a/src/parse/properties/properties.c b/src/parse/properties/properties.c
index 24d7351..020c664 100644
--- a/src/parse/properties/properties.c
+++ b/src/parse/properties/properties.c
@@ -315,7 +315,97 @@ const css_prop_handler property_handlers[LAST_PROP + 1 - FIRST_PROP] =
