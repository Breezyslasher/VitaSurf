+static void html_dynamic_relayout(void *p);
+
+static struct box *html_box_of(dom_node *n)
+{
+	struct box *box = NULL;
+
+	if (dom_node_get_user_data(n, corestring_dom___ns_key_box_node_data,
+			(void *) &box) != DOM_NO_ERR)
+		return NULL;
+	return box;
+}
+
+/** Whether a space-separated list of names has \a name. */
+static bool html_container_named(lwc_string *names, lwc_string *name)
+{
+	const char *s = lwc_string_data(names);
+	const char *want = lwc_string_data(name);
+	size_t len = lwc_string_length(names), n = lwc_string_length(name);
+	size_t i = 0;
+
+	while (i < len) {
+		size_t j = i;
+
+		while (j < len && s[j] != ' ')
+			j++;
+		if (j - i == n && memcmp(s + i, want, n) == 0)
+			return true;
+		i = j + 1;
+	}
+	return false;
+}
+
+/* exported interface documented in html/private.h */
+uint8_t html_container_lookup(html_content *c, dom_node *node,
+		lwc_string *name, css_fixed *width, css_fixed *height)
+{
+	dom_node *n = dom_node_ref(node), *p = NULL;
+	uint8_t status = 0;
+
+	while (dom_node_get_parent_node(n, &p) == DOM_NO_ERR && p != NULL) {
+		struct box *box;
+		uint8_t type;
+		unsigned i;
+
+		dom_node_unref(n);
+		n = p;
+		p = NULL;
+		box = html_box_of(n);
+		if (box == NULL || box->style == NULL)
+			continue;
+		type = css_computed_container_type(box->style);
+		if (type != CSS_CONTAINER_TYPE_SIZE &&
+				type != CSS_CONTAINER_TYPE_INLINE_SIZE)
+			continue;
+		if (name != NULL) {
+			lwc_string *names = NULL;
+
+			if (css_computed_container_name(box->style, &names) !=
+					CSS_CONTAINER_NAME_SET ||
+					names == NULL ||
+					!html_container_named(names, name))
+				continue;
+		}
+		c->containers_asked = true;
+		status = 2;
+		for (i = 0; i < c->n_csizes; i++) {
+			if (c->csizes[i].node == n) {
+				*width = c->csizes[i].width;
+				*height = c->csizes[i].height;
+				status = 1;
+				break;
+			}
+		}
+		break;
+	}
+	dom_node_unref(n);
+	return status;
+}
+
+static void html_containers_free(struct html_container_size *t, unsigned n)
+{
+	unsigned i;
+
+	for (i = 0; i < n; i++)
+		dom_node_unref(t[i].node);
+	free(t);
+}
+
+/** Note the size each container came out, and rebuild if one changed. */
+static void html_containers_measure(html_content *c)
+{
+	struct html_container_size *t = NULL;
+	unsigned n = 0, alloc = 0, i;
+	struct box *b = c->layout;
+	bool changed = false;
+
+	/* every box, in tree order, without recursion */
+	while (b != NULL) {
+		if (b->style != NULL && b->node != NULL &&
+				(b->flags & DISPLAY_CONTENTS) == 0 &&
+				css_computed_container_type(b->style) >
+					CSS_CONTAINER_TYPE_NORMAL &&
+				html_box_of(b->node) == b) {
+			if (n == alloc) {
+				unsigned na = alloc ? alloc * 2 : 8;
+				struct html_container_size *nt =
+					realloc(t, na * sizeof(*nt));
+
+				if (nt == NULL)
+					break;
+				t = nt;
+				alloc = na;
+			}
+			t[n].node = dom_node_ref(b->node);
+			t[n].width = css_unit_device2css_px(INTTOFIX(b->width),
+					c->unit_len_ctx.device_dpi);
+			t[n].height = css_unit_device2css_px(
+					INTTOFIX(b->height),
+					c->unit_len_ctx.device_dpi);
+			n++;
+		}
+		if (b->children != NULL) {
+			b = b->children;
+		} else {
+			while (b != NULL && b->next == NULL)
+				b = b->parent;
+			if (b != NULL)
+				b = b->next;
+		}
+	}
+
+	if (n != c->n_csizes) {
+		changed = true;
+	} else {
+		for (i = 0; i < n && !changed; i++) {
+			changed = t[i].node != c->csizes[i].node ||
+				t[i].width != c->csizes[i].width ||
+				t[i].height != c->csizes[i].height;
+		}
+	}
+	html_containers_free(c->csizes, c->n_csizes);
+	c->csizes = t;
+	c->n_csizes = n;
+
+	if (c->viewport_w != c->container_width_seen) {
+		c->container_width_seen = c->viewport_w;
+		c->container_rebuilds = 0;
+	}
+	if (changed && c->containers_asked && c->container_rebuilds < 2) {
+		c->container_rebuilds++;
+		NSLOG(netsurf, INFO, "container sizes changed: styles "
+				"chosen again (content %p)", c);
+		if (!c->dynamic_relayout_pending) {
+			c->dynamic_relayout_pending = true;
+			guit->misc->schedule(0, html_dynamic_relayout, c);
+		}
+	}
+}
