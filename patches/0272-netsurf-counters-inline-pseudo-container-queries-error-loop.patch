+/*
+ * CSS counters (VitaSurf).
+ *
+ * The boxes are built in document order, which is the order counters
+ * are counted in. As an element that gets a box is reached, its
+ * counter-reset makes new counters, its counter-increment adds to the
+ * innermost counter of each name and its counter-set sets it, in that
+ * order; a list item adds one to list-item unless it names it itself.
+ * A counter an element makes is seen by the element, what follows it
+ * among its siblings and all their descendants, so it is kept until
+ * the element's parent is left: each is noted with that parent, its
+ * scope. A reset of a name a sibling already made replaces it rather
+ * than nesting. ::before and ::after count as the element's first and
+ * last children. counter() reads the innermost counter of a name and
+ * counters() all of them, outermost first; either makes one at 0 if
+ * there is none.
+ */
+struct html_counter {
+	lwc_string *name;
+	int32_t value;
+	const void *scope;
+};
+
+/* exported interface documented in html/private.h */
+void html_counters_clear(html_content *c)
+{
+	unsigned i;
+
+	for (i = 0; i < c->n_counters; i++)
+		lwc_string_unref(c->counters[i].name);
+	free(c->counters);
+	c->counters = NULL;
+	c->n_counters = 0;
+	c->counters_alloc = 0;
+	c->quote_depth = 0;
+}
+
+static struct html_counter *
+box_counter_find(html_content *c, lwc_string *name)
+{
+	unsigned i;
+	bool match;
+
+	for (i = c->n_counters; i-- > 0; ) {
+		if (lwc_string_caseless_isequal(c->counters[i].name, name,
+				&match) == lwc_error_ok && match)
+			return &c->counters[i];
+	}
+	return NULL;
+}
+
+static struct html_counter *
+box_counter_push(html_content *c, lwc_string *name, int32_t value,
+		const void *scope)
+{
+	struct html_counter *e;
+
+	if (c->n_counters == c->counters_alloc) {
+		unsigned alloc = c->counters_alloc ?
+				c->counters_alloc * 2 : 16;
+		struct html_counter *n = realloc(c->counters,
+				alloc * sizeof(*n));
+
+		if (n == NULL)
+			return NULL;
+		c->counters = n;
+		c->counters_alloc = alloc;
+	}
+	e = &c->counters[c->n_counters++];
+	e->name = lwc_string_ref(name);
+	e->value = value;
+	e->scope = scope;
+	return e;
+}
+
+/** The innermost counter of a name, made at 0 in \a scope if none. */
+static struct html_counter *
+box_counter_get(html_content *c, lwc_string *name, const void *scope)
+{
+	struct html_counter *e = box_counter_find(c, name);
+
+	return e != NULL ? e : box_counter_push(c, name, 0, scope);
+}
+
+/**
+ * Apply one style's counter-reset, counter-increment and counter-set.
+ *
+ * \param c          the document
+ * \param style      the style, the element's or a pseudo element's
+ * \param list_item  whether it is a list item, which counts list-item
+ * \param scope      the node its new counters are kept for
+ */
+static void
+box_counters_apply(html_content *c, const css_computed_style *style,
+		bool list_item, const void *scope)
+{
+	const css_computed_counter *k = NULL;
+	struct html_counter *e;
+	bool counts_list_item = false;
+
+	if (css_computed_counter_reset(style, &k) ==
+			CSS_COUNTER_RESET_NAMED && k != NULL) {
+		for (; k->name != NULL; k++) {
+			e = box_counter_find(c, k->name);
+			if (e != NULL && e->scope == scope)
+				e->value = FIXTOINT(k->value);
+			else
+				box_counter_push(c, k->name,
+						FIXTOINT(k->value), scope);
+		}
+	}
+	k = NULL;
+	if (css_computed_counter_increment(style, &k) ==
+			CSS_COUNTER_INCREMENT_NAMED && k != NULL) {
+		for (; k->name != NULL; k++) {
+			e = box_counter_get(c, k->name, scope);
+			if (e != NULL)
+				e->value += FIXTOINT(k->value);
+			if (lwc_string_isequal(k->name,
+					corestring_lwc_list_item,
+					&counts_list_item) == lwc_error_ok &&
+					counts_list_item)
+				list_item = false;
+		}
+	}
+	if (list_item) {
+		e = box_counter_get(c, corestring_lwc_list_item, scope);
+		if (e != NULL)
+			e->value++;
+	}
+	k = NULL;
+	if (css_computed_counter_set(style, &k) ==
+			CSS_COUNTER_SET_NAMED && k != NULL) {
+		for (; k->name != NULL; k++) {
+			e = box_counter_get(c, k->name, scope);
+			if (e != NULL)
+				e->value = FIXTOINT(k->value);
+		}
+	}
+}
+
+/** Leave an element: the counters its children made go. */
+static void box_counters_leave(html_content *c, const void *node)
+{
+	while (c->n_counters > 0 &&
+			c->counters[c->n_counters - 1].scope == node) {
+		c->n_counters--;
+		lwc_string_unref(c->counters[c->n_counters].name);
+	}
+}
