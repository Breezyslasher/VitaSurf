+/** Append a counter's value in a list style (the opcode, as content
+ * holds it) to \a out. */
+static char *
+box_counter_format(char *out, int32_t value, uint8_t style_op, void *bctx)
+{
+	char buf[64];
+	size_t len = 0;
+	char *joined;
+
+	if (css_format_counter((uint8_t) (style_op + 1), value, buf,
+			sizeof(buf) - 1, &len) != CSS_OK)
+		return out;
+	if (len > sizeof(buf) - 1)
+		len = sizeof(buf) - 1;
+	joined = talloc_asprintf(bctx, "%s%.*s", out, (int) len, buf);
+	if (joined == NULL)
+		return out;
+	talloc_free(out);
+	return joined;
+}
