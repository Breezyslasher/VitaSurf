+/*
+ * Container queries (VitaSurf).
+ *
+ * An @container rule's condition is about the size of the element's
+ * container, which layout decides after the styles are chosen. So each
+ * layout notes the size every container came out, by element, and the
+ * next selection answers from that; a container not laid out yet is
+ * answered with the viewport, as @media is. When a layout finds that
+ * a container's size is not what the styles were chosen with, and a
+ * query has asked, the tree is rebuilt with the new sizes; twice at
+ * most for one viewport width, so a query that changes the size it
+ * asks about cannot go round for ever.
+ */
+struct html_container_size {
+	dom_node *node;
+	css_fixed width, height;
+};
