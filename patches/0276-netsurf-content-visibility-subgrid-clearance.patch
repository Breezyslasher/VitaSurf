+/**
+ * Lay out an item, telling it the tracks it spans if it is a subgrid
+ * (VitaSurf): the columns' sizes, and the rows' once \a rows_known.
+ */
+static bool grid_layout_subgrid_item(struct grid_ctx *ctx,
+		struct grid_item *it, int area_w, bool rows_known)
+{
+	struct grid_subgrid_req req;
+	const struct grid_subgrid_req *was = grid_subgrid_pending;
+	int *cs = NULL, *rs = NULL;
+	bool ok;
+	int k;
+
+	if (!grid_box_is_subgrid(it->box, 0) &&
+			!grid_box_is_subgrid(it->box, 1))
+		return grid_layout_item(ctx, it, area_w);
+
+	memset(&req, 0, sizeof(req));
+	req.box = it->box;
+	req.n[0] = it->col_span > 0 ? (unsigned) it->col_span : 0;
+	req.n[1] = it->row_span > 0 ? (unsigned) it->row_span : 0;
+	req.gap[0] = ctx->col_gap;
+	req.gap[1] = ctx->row_gap;
+	cs = malloc((req.n[0] + 1) * sizeof(*cs));
+	rs = malloc((req.n[1] + 1) * sizeof(*rs));
+	if (cs == NULL || rs == NULL) {
+		free(cs);
+		free(rs);
+		return grid_layout_item(ctx, it, area_w);
+	}
+	for (k = 0; k < (int) req.n[0]; k++)
+		cs[k] = (unsigned) (it->col + k) < ctx->n_cols ?
+				ctx->cols[it->col + k].base : 0;
+	for (k = 0; k < (int) req.n[1]; k++)
+		rs[k] = (unsigned) (it->row + k) < ctx->n_rows ?
+				ctx->rows[it->row + k].base : 0;
+	req.sizes[0] = cs;
+	req.sizes[1] = rows_known ? rs : NULL;
+	if (!rows_known && grid_box_is_subgrid(it->box, 1)) {
+		/* its rows, as its own items size them, come back in rs */
+		for (k = 0; k < (int) req.n[1]; k++)
+			rs[k] = 0;
+		req.out[1] = rs;
+	}
+
+	grid_subgrid_pending = &req;
+	ok = grid_layout_item(ctx, it, area_w);
+	grid_subgrid_pending = was;
+
+	/* and each is the least the parent's row can be */
+	if (ok && req.out[1] != NULL) {
+		for (k = 0; k < (int) req.n[1]; k++) {
+			struct grid_track *t;
+
+			if ((unsigned) (it->row + k) >= ctx->n_rows)
+				break;
+			t = &ctx->rows[it->row + k];
+			if (t->min_type == GS_FIXED) {
+				if (rs[k] > t->min_fixed)
+					t->min_fixed = rs[k];
+			} else if (t->min_type == GS_AUTO ||
+					t->min_type == GS_MIN_CONTENT ||
+					t->min_type == GS_MAX_CONTENT) {
+				t->min_type = GS_FIXED;
+				t->min_fixed = rs[k];
+			}
+		}
+	}
+	free(cs);
+	free(rs);
+	return ok;
+}
