+/**
+ * What a grid tells an item that is a subgrid (VitaSurf): for columns
+ * [0] and rows [1], how many of its tracks the item spans, their sizes
+ * (NULL while they are not known yet) and its gap.
+ */
+struct grid_subgrid_req {
+	const struct box *box;
+	unsigned n[2];
+	const int *sizes[2];
+	int gap[2];
+	/** filled in by the subgrid, if not NULL: the sizes its content
+	 * gave the tracks it was laid out with */
+	int *out[2];
+};
+
+/** The request for the item being laid out now, if it is a subgrid. */
+static const struct grid_subgrid_req *grid_subgrid_pending;
+
+/** Whether a template is subgrid. */
+static bool grid_tmpl_is_subgrid(const css_computed_grid_track *t)
+{
+	return t != NULL && t[0].min_type != CSS_GRID_TRACK_NONE &&
+			(t[0].flags & CSS_GRID_TRACK_FLAG_SUBGRID) != 0;
+}
+
+/** Whether a box is a grid with a subgrid in an axis, 0 columns, 1 rows. */
+static bool grid_box_is_subgrid(const struct box *b, int axis)
+{
+	const css_computed_grid_track *t = NULL;
+
+	if (b->style == NULL || (b->type != BOX_FLEX &&
+			b->type != BOX_INLINE_FLEX) ||
+			!(b->flags & GRID_CONTAINER))
+		return false;
+	if ((axis == 0 ? css_computed_grid_template_columns(b->style, &t) :
+			css_computed_grid_template_rows(b->style, &t)) !=
+			CSS_GRID_TEMPLATE_SET)
+		return false;
+	return grid_tmpl_is_subgrid(t);
+}
+
+/**
+ * The tracks of a subgrid axis: the parent's, fixed at their sizes, or
+ * auto while those are not known.
+ */
+static bool grid_build_subgrid(const struct grid_subgrid_req *req, int axis,
+		struct grid_track **tracks_out, unsigned *count_out)
+{
+	struct grid_track *tracks;
+	unsigned i, n = req->n[axis];
+
+	*tracks_out = NULL;
+	*count_out = 0;
+	if (n == 0)
+		return true;
+	if (n > GRID_MAX_TRACKS)
+		n = GRID_MAX_TRACKS;
+	tracks = calloc(n, sizeof(*tracks));
+	if (tracks == NULL)
+		return false;
+	for (i = 0; i < n; i++) {
+		if (req->sizes[axis] != NULL) {
+			tracks[i].min_type = tracks[i].max_type = GS_FIXED;
+			tracks[i].min_fixed = tracks[i].max_fixed =
+					req->sizes[axis][i];
+		} else {
+			tracks[i].min_type = tracks[i].max_type = GS_AUTO;
+		}
+	}
+	*tracks_out = tracks;
+	*count_out = n;
+	return true;
+}
