+/* the client's counters, see dom_vita_set_generations (VitaSurf) */
+static uint32_t *vita_gen_any, *vita_gen_tree, *vita_gen_id;
+
+void dom_vita_set_generations(uint32_t *any, uint32_t *tree, uint32_t *id)
+{
+	vita_gen_any = any;
+	vita_gen_tree = tree;
+	vita_gen_id = id;
+}
+
+void _dom_vita_changed(bool tree, bool id)
+{
+	if (vita_gen_any != NULL)
+		(*vita_gen_any)++;
+	if (tree && vita_gen_tree != NULL)
+		(*vita_gen_tree)++;
+	if ((tree || id) && vita_gen_id != NULL)
+		(*vita_gen_id)++;
+}
+
