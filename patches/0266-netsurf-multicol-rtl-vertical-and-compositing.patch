+/*
+ * vitasurf_backdrop() for the framebuffer (VitaSurf): the pixels already
+ * plotted to the surface in the area, copied out. The surface is the
+ * one the plotters draw to, whose coordinates the redraw uses.
+ */
+nserror vitasurf_backdrop(const struct rect *area, struct bitmap **out)
+{
+	nsfb_t *surf = framebuffer_set_surface(NULL);
+	enum nsfb_format_e fmt = NSFB_FMT_ANY;
+	uint8_t *src, *dst;
+	int stride, sw = 0, sh = 0, w, h, x, y, x0, y0, rbyte;
+	size_t dststride;
+	struct bitmap *bm;
+
+	framebuffer_set_surface(surf);
+	*out = NULL;
+	if (surf == NULL || nsfb_get_buffer(surf, &src, &stride) == -1 ||
+			nsfb_get_geometry(surf, &sw, &sh, &fmt) == -1)
+		return NSERROR_INVALID;
+	switch (fmt) {
+	case NSFB_FMT_XBGR8888:
+	case NSFB_FMT_ABGR8888:
+		rbyte = 0;
+		break;
+	case NSFB_FMT_XRGB8888:
+	case NSFB_FMT_ARGB8888:
+		rbyte = 2;
+		break;
+	default:
+		return NSERROR_NOT_IMPLEMENTED;
+	}
+
+	x0 = area->x0 < 0 ? 0 : area->x0;
+	y0 = area->y0 < 0 ? 0 : area->y0;
+	w = (area->x1 > sw ? sw : area->x1) - x0;
+	h = (area->y1 > sh ? sh : area->y1) - y0;
+	if (w <= 0 || h <= 0)
+		return NSERROR_BAD_PARAMETER;
+
+	bm = bitmap_create(w, h, BITMAP_OPAQUE);
+	if (bm == NULL)
+		return NSERROR_NOMEM;
+	dst = bitmap_get_buffer(bm);
+	dststride = bitmap_get_rowstride(bm);
+	for (y = 0; y < h; y++) {
+		const uint8_t *sp = src + (size_t)(y0 + y) * (size_t)stride +
+				(size_t)x0 * 4;
+		uint8_t *dp = dst + (size_t)y * dststride;
+
+		for (x = 0; x < w; x++, sp += 4, dp += 4) {
+			dp[bitmap_layout.r] = sp[rbyte];
+			dp[bitmap_layout.g] = sp[1];
+			dp[bitmap_layout.b] = sp[2 - rbyte];
+			dp[bitmap_layout.a] = 0xff;
+		}
+	}
+	bitmap_modified(bm);
+	*out = bm;
+	return NSERROR_OK;
+}
