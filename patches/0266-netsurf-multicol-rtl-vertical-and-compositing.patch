+/** Give a box whose content was cut up the height its content now
+ * takes, as the columns have moved some of it up. */
+static void multicol_shrink(struct box *b)
+{
+	struct box *c;
+	int bottom = 0;
+
+	if (b->type == BOX_BLOCK && b->style != NULL) {
+		css_fixed len = 0;
+		css_unit unit = CSS_UNIT_PX;
+
+		if (css_computed_height(b->style, &len, &unit) ==
+				CSS_HEIGHT_SET)
+			return;
+	}
+
+	for (c = b->children; c != NULL; c = c->next) {
+		int cb;
+
+		if (!multicol_moves(c))
+			continue;
+		if (c->style != NULL &&
+				(css_computed_position(c->style) ==
+					CSS_POSITION_ABSOLUTE ||
+				 css_computed_position(c->style) ==
+					CSS_POSITION_FIXED))
+			continue;
+		cb = c->y + c->padding[TOP] + c->height +
+				c->padding[BOTTOM] + c->border[BOTTOM].width;
+		if (c->type != BOX_INLINE_CONTAINER && c->margin[BOTTOM] > 0)
+			cb += c->margin[BOTTOM];
+		if (cb > bottom)
+			bottom = cb;
+	}
+	bottom -= b->type == BOX_INLINE_CONTAINER ? 0 : b->padding[TOP];
+	if (bottom < b->height)
+		b->height = bottom < 0 ? 0 : bottom;
+}
+
+
+/* exported interface documented in html/layout_internal.h */
+bool layout_multicol(struct box *box, int viewport_height,
+		html_content *content)
+{
+	struct multicol_ctx m;
+	int n, colw, gap, width, height_spec, total, lo, hi, col_h;
+	int orig_bottom = INT_MIN, new_bottom = 0, trailing;
+	unsigned int i;
+	bool ok;
+
+	if (!layout_multicol_columns(&content->unit_len_ctx, box,
+			box->width, &n, &colw, &gap)) {
+		return layout_block_context_single(box, viewport_height,
+				content);
+	}
+
+	/* the content, as a single column one column wide */
+	width = box->width;
+	height_spec = box->height;
+	box->width = colw;
+	ok = layout_block_context_single(box, viewport_height, content);
+	box->width = width;
+	if (!ok)
+		return false;
+
+	memset(&m, 0, sizeof(m));
+	total = box->height;
+	m.threshold = total / n;
+	multicol_collect(&m, box, 0, 0);
+	if (m.nomem || m.n_frag < 2) {
+		free(m.frag);
+		free(m.cut);
+		return !m.nomem;
+	}
+
+	for (i = 0; i < m.n_frag; i++) {
+		if (m.frag[i].bottom > orig_bottom)
+			orig_bottom = m.frag[i].bottom;
+	}
+
+	if (height_spec != AUTO) {
+		/* a box with a height fills each column to it, and what
+		 * does not fit goes into more columns beside them */
+		col_h = height_spec;
+	} else {
+		/* balanced: the least height that fits the fragments into
+		 * n columns, found by halving; no column can be shorter
+		 * than its tallest fragment */
+		lo = 0;
+		for (i = 0; i < m.n_frag; i++) {
+			if (m.frag[i].bottom - m.frag[i].top > lo)
+				lo = m.frag[i].bottom - m.frag[i].top;
+		}
+		hi = orig_bottom - m.frag[0].top;
+		if (hi < lo)
+			hi = lo;
+		while (lo < hi) {
+			int mid = lo + (hi - lo) / 2;
+
+			if (multicol_deal(&m, mid, colw + gap, false,
+					NULL) <= n)
+				hi = mid;
+			else
+				lo = mid + 1;
+		}
+		col_h = lo;
+	}
+
+	multicol_deal(&m, col_h, colw + gap, true, &new_bottom);
+
+	/* the boxes that were cut up take only what is left in them,
+	 * innermost first */
+	for (i = m.n_cut; i-- > 0; )
+		multicol_shrink(m.cut[i]);
+
+	if (height_spec == AUTO) {
+		/* the tallest column, and whatever margin followed the
+		 * content when it was one column */
+		trailing = total + box->padding[TOP] - orig_bottom;
+		if (trailing < 0)
+			trailing = 0;
+		box->height = new_bottom - box->padding[TOP] + trailing;
+		if (box->height < 0)
+			box->height = 0;
+	}
+
+	NSLOG(layout, DEBUG, "multicol %p: %d columns of %d, gap %d, "
+			"height %d, %u fragments", box, n, colw, gap,
+			col_h, m.n_frag);
+
+	free(m.frag);
+	free(m.cut);
+	return true;
+}
