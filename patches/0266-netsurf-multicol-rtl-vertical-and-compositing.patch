+	float cx, cy, ex, ey;		/**< the ellipse's centre and radii */
+};
+
+/** The box being painted aside, which is painted normally inside. */
+static const struct box *html_composite_active;
+
+/** How much of a pixel at (px, py) lies inside an ellipse. */
+static inline float html_shape_curve(float px, float py, float cx,
+		float cy, float rx, float ry)
+{
+	float dx = (px - cx) / rx, dy = (py - cy) / ry;
+	float m = rx < ry ? rx : ry;
+	float c = (1.0f - sqrtf(dx * dx + dy * dy)) * m + 0.5f;
+
+	return c < 0.0f ? 0.0f : c > 1.0f ? 1.0f : c;
+}
+
+static float html_shape_cover(const struct html_shape *s, float px,
+		float py)
+{
+	const struct html_corner_radii *r = &s->r;
+
+	if (s->ellipse) {
+		if (s->ex <= 0.0f || s->ey <= 0.0f)
+			return 0.0f;
+		return html_shape_curve(px, py, s->cx, s->cy, s->ex, s->ey);
+	}
+	if (px < s->x0 || px >= s->x1 || py < s->y0 || py >= s->y1)
+		return 0.0f;
+	if (r->tl_h > 0 && r->tl_v > 0 && px < s->x0 + r->tl_h &&
+			py < s->y0 + r->tl_v)
+		return html_shape_curve(px, py, s->x0 + r->tl_h,
+				s->y0 + r->tl_v, r->tl_h, r->tl_v);
+	if (r->tr_h > 0 && r->tr_v > 0 && px >= s->x1 - r->tr_h &&
+			py < s->y0 + r->tr_v)
+		return html_shape_curve(px, py, s->x1 - r->tr_h,
+				s->y0 + r->tr_v, r->tr_h, r->tr_v);
+	if (r->br_h > 0 && r->br_v > 0 && px >= s->x1 - r->br_h &&
+			py >= s->y1 - r->br_v)
+		return html_shape_curve(px, py, s->x1 - r->br_h,
+				s->y1 - r->br_v, r->br_h, r->br_v);
+	if (r->bl_h > 0 && r->bl_v > 0 && px < s->x0 + r->bl_h &&
+			py >= s->y1 - r->bl_v)
+		return html_shape_curve(px, py, s->x0 + r->bl_h,
+				s->y1 - r->bl_v, r->bl_h, r->bl_v);
+	return 1.0f;
+}
+
+/** What html_composite paints aside: the drawing, moved by -dx, -dy
+ * in layout pixels (ox, oy in device pixels), through ctx, within
+ * clip. */
+struct html_composite_job {
+	bool (*draw)(const struct redraw_context *ctx, void *pw, int dx,
+			int dy, int ox, int oy, const struct rect *clip);
+	void *pw;
+	int dx, dy, ox, oy;
+	struct rect clip;
+};
+
+static bool html_composite_trampoline(const struct redraw_context *ctx,
+		void *pw)
+{
+	struct html_composite_job *j = pw;
+
+	return j->draw(ctx, j->pw, j->dx, j->dy, j->ox, j->oy, &j->clip);
+}
+
+/**
+ * Paint an area aside (VitaSurf).
+ *
+ * \param area   the area, device coordinates
+ * \param clip   the clip in force
+ * \param scale  the redraw's scale
+ * \param draw   paints what is in the area
+ * \param pw     passed to draw
+ * \param out    set to the bitmap, or NULL if there is none
+ * \param ox     set to where its left edge lands
+ * \param oy     set to where its top edge lands
+ * \return false if the area is empty and nothing needs painting; true
+ *         otherwise, with *out NULL if it could not be painted aside
+ */
+static bool html_composite_raster(const struct rect *area,
+		const struct rect *clip, float scale,
+		bool (*draw)(const struct redraw_context *ctx, void *pw,
+			int dx, int dy, int ox, int oy,
+			const struct rect *clip),
+		void *pw, struct bitmap **out, int *ox, int *oy)
+{
+	struct html_composite_job job;
+	struct rect r = *area;
+	int w, h;
+
+	*out = NULL;
+	if (r.x0 < clip->x0) r.x0 = clip->x0;
+	if (r.y0 < clip->y0) r.y0 = clip->y0;
+	if (r.x1 > clip->x1) r.x1 = clip->x1;
+	if (r.y1 > clip->y1) r.y1 = clip->y1;
+	if (r.x0 >= r.x1 || r.y0 >= r.y1)
+		return false;
+	if (vitasurf_raster == NULL || scale <= 0.0f)
+		return true;
+
+	/* the origin on a whole layout pixel, so what is painted aside
+	 * lands where it would have */
+	job.dx = (int) floorf(r.x0 / scale);
+	job.dy = (int) floorf(r.y0 / scale);
+	job.ox = (int) (job.dx * scale);
+	job.oy = (int) (job.dy * scale);
+	w = r.x1 - job.ox;
+	h = r.y1 - job.oy;
+	if (w <= 0 || h <= 0 || w * h > HTML_COMPOSITE_MAX)
+		return true;
+	job.draw = draw;
+	job.pw = pw;
+	job.clip.x0 = r.x0 - job.ox;
+	job.clip.y0 = r.y0 - job.oy;
+	job.clip.x1 = w;
+	job.clip.y1 = h;
+
+	if (vitasurf_raster(w, h, html_composite_trampoline, &job,
+			out) != NSERROR_OK)
+		*out = NULL;
+	*ox = job.ox;
+	*oy = job.oy;
+	return true;
+}
+
+/** Scale a bitmap's alpha by how much of each pixel is in a shape. */
+static void html_shape_apply(struct bitmap *bm, int ox, int oy,
+		const struct html_shape *shape)
+{
+	uint8_t *buf = guit->bitmap->get_buffer(bm);
+	size_t stride = guit->bitmap->get_rowstride(bm);
+	int w = guit->bitmap->get_width(bm);
+	int h = guit->bitmap->get_height(bm);
+	int x, y;
+
+	if (buf == NULL)
+		return;
+	for (y = 0; y < h; y++) {
+		uint8_t *row = buf + y * stride;
+		float py = oy + y + 0.5f;
+
+		for (x = 0; x < w; x++) {
+			uint8_t *px = row + x * 4;
+			float c;
+
+			if (px[bitmap_layout.a] == 0)
+				continue;
+			c = html_shape_cover(shape, ox + x + 0.5f, py);
+			if (c < 1.0f)
+				px[bitmap_layout.a] = (uint8_t)
+					(px[bitmap_layout.a] * c + 0.5f);
+		}
+	}
+	guit->bitmap->set_opaque(bm, false);
+	guit->bitmap->modified(bm);
+}
+
+/** Plot a bitmap made for this redraw, then let it go: the knockout
+ * plotter draws later from the pointer it keeps, so it is flushed
+ * first. */
+static bool html_plot_made(const struct redraw_context *ctx,
+		struct bitmap *bm, int x, int y)
+{
+	nserror res = ctx->plot->bitmap(ctx, bm, x, y,
+			guit->bitmap->get_width(bm),
+			guit->bitmap->get_height(bm), 0, BITMAPF_NONE);
+
+	if (ctx->plot->flush != NULL)
+		ctx->plot->flush(ctx);
+	guit->bitmap->destroy(bm);
+	return res == NSERROR_OK;
+}
+
+/**
+ * Paint an area aside and plot it cut to a shape.
+ *
+ * \param ctx    the redraw context it is plotted through
+ * \param area   the area, device coordinates
+ * \param clip   the clip in force
+ * \param scale  the redraw's scale
+ * \param shape  the shape to cut to
+ * \param draw   paints what is in the area
+ * \param pw     passed to draw
+ * \param done   set to false if nothing was done and the caller is
+ *               to paint the area as it would have
+ * \return false on a plotting error
+ */
+static bool html_composite(const struct redraw_context *ctx,
+		const struct rect *area, const struct rect *clip, float scale,
+		const struct html_shape *shape,
+		bool (*draw)(const struct redraw_context *ctx, void *pw,
+			int dx, int dy, int ox, int oy,
+			const struct rect *clip),
+		void *pw, bool *done)
+{
+	struct bitmap *bm;
+	int ox = 0, oy = 0;
+
+	*done = false;
+	if (!html_composite_raster(area, clip, scale, draw, pw, &bm, &ox,
+			&oy)) {
+		*done = true;
+		return true;
+	}
+	if (bm == NULL)
+		return true;
+	html_shape_apply(bm, ox, oy, shape);
+	*done = true;
+	return html_plot_made(ctx, bm, ox, oy);
+}
+
+/** The padding box of a box with rounded corners, as a shape: the
+ * corners' radii less the borders (VitaSurf). */
+static bool html_padding_shape(const html_content *html,
+		const struct box *box, int x, int y, int padding_width,
+		int padding_height, int bl, int bt, int br, int bb, float scale,
+		struct html_shape *s)
+{
+	struct rect border_box;
+	struct html_corner_radii r;
+
+	border_box.x0 = x - bl;
+	border_box.y0 = y - bt;
+	border_box.x1 = x + padding_width + br;
+	border_box.y1 = y + padding_height + bb;
+	if (box->style == NULL || !html_box_corner_radii(box, &border_box,
+			&html->unit_len_ctx, scale, &r))
+		return false;
+
+#define HTML_SHRINK(v, by) v = (v) > (by) ? (v) - (by) : 0
+	HTML_SHRINK(r.tl_h, bl); HTML_SHRINK(r.tl_v, bt);
+	HTML_SHRINK(r.tr_h, br); HTML_SHRINK(r.tr_v, bt);
+	HTML_SHRINK(r.br_h, br); HTML_SHRINK(r.br_v, bb);
+	HTML_SHRINK(r.bl_h, bl); HTML_SHRINK(r.bl_v, bb);
+#undef HTML_SHRINK
+	if ((r.tl_h == 0 || r.tl_v == 0) && (r.tr_h == 0 || r.tr_v == 0) &&
+			(r.br_h == 0 || r.br_v == 0) &&
+			(r.bl_h == 0 || r.bl_v == 0))
+		return false;
+
+	s->ellipse = false;
+	s->x0 = x;
+	s->y0 = y;
+	s->x1 = x + padding_width;
+	s->y1 = y + padding_height;
+	s->r = r;
+	return true;
+}
+
+/**
+ * Whether anything painted inside a box reaches into one of the corner
+ * squares of its shape (VitaSurf): a background, a border or a replaced
+ * object. Text keeps clear of the corners behind the padding, so a
+ * card that holds only text need not be painted aside; one whose image
+ * runs to its top edge must be. At most a few hundred boxes are looked
+ * at, and a box too busy to check is taken to reach them.
+ */
+static bool html_corners_touched(const struct box *box, int ox, int oy,
+		float scale, const struct html_shape *s, int *budget)
+{
+	const struct box *c;
+
+	for (c = box->children; c != NULL; c = c->next) {
+		int x0, y0, x1, y1;
+		bool paints;
+
+		if (--*budget <= 0)
+			return true;
+		x0 = (int) ((ox + c->x - c->border[LEFT].width) * scale);
+		y0 = (int) ((oy + c->y - c->border[TOP].width) * scale);
+		x1 = (int) ((ox + c->x + c->padding[LEFT] + c->width +
+				c->padding[RIGHT] + c->border[RIGHT].width) *
+				scale);
+		y1 = (int) ((oy + c->y + c->padding[TOP] + c->height +
+				c->padding[BOTTOM] + c->border[BOTTOM].width) *
+				scale);
+
+		paints = c->object != NULL || c->gadget != NULL ||
+				(c->style != NULL &&
+				 (html_redraw_box_has_background(
+						(struct box *) c) ||
+				  c->border[TOP].width || c->border[LEFT].width ||
+				  c->border[RIGHT].width ||
+				  c->border[BOTTOM].width));
+		if (paints && (
+			(x0 < s->x0 + s->r.tl_h && y0 < s->y0 + s->r.tl_v) ||
+			(x1 > s->x1 - s->r.tr_h && y0 < s->y0 + s->r.tr_v) ||
+			(x1 > s->x1 - s->r.br_h && y1 > s->y1 - s->r.br_v) ||
+			(x0 < s->x0 + s->r.bl_h && y1 > s->y1 - s->r.bl_v)))
+			return true;
+		if (c->children != NULL && html_corners_touched(c,
+				ox + c->x, oy + c->y, scale, s, budget))
+			return true;
+	}
+	return false;
+}
+
+
+/** A replaced object, painted aside (VitaSurf). */
+struct html_composite_object {
+	struct hlcache_handle *object;
+	const struct content_redraw_data *data;
+};
+
+static bool html_composite_object_draw(const struct redraw_context *ctx,
+		void *pw, int dx, int dy, int ox, int oy,
+		const struct rect *clip)
+{
+	struct html_composite_object *o = pw;
+	struct content_redraw_data data = *o->data;
+
+	(void) dx;
+	(void) dy;
+	data.x -= ox;
+	data.y -= oy;
+	return content_redraw(o->object, &data, clip, ctx);
+}
+
+/** A box's children, or the box itself, painted aside (VitaSurf). */
+struct html_composite_boxes {
+	const html_content *html;
+	struct box *box;
+	int x_parent, y_parent;
+	float scale;
+	colour bg;
+	bool whole;
+};
+
+static bool html_composite_boxes_draw(const struct redraw_context *ctx,
+		void *pw, int dx, int dy, int ox, int oy,
+		const struct rect *clip)
+{
+	struct html_composite_boxes *b = pw;
+
+	(void) ox;
+	(void) oy;
+	if (b->whole)
+		return html_redraw_box(b->html, b->box, b->x_parent - dx,
+				b->y_parent - dy, clip, b->scale, b->bg, ctx);
+	return html_redraw_box_children(b->html, b->box, b->x_parent - dx,
+			b->y_parent - dy, clip, b->scale, b->bg, ctx);
+}
+
+/** A clip-path radius in device pixels: a percentage of the basis, a
+ * length, or closest-side (-1px) or farthest-side (-2px) from the
+ * distances to the sides given. */
+static float html_clip_radius(const html_content *html,
+		const struct box *box, css_fixed v, css_unit u, float basis,
+		float nearest, float farthest, float scale)
+{
+	if (u == CSS_UNIT_PX && v == INTTOFIX(-1))
+		return nearest;
+	if (u == CSS_UNIT_PX && v == INTTOFIX(-2))
+		return farthest;
+	if (u == CSS_UNIT_PCT)
+		return basis * FIXTOFLT(v) / 100.0f;
+	return FIXTOFLT(css_unit_len2device_px(box->style,
+			&html->unit_len_ctx, v, u)) * scale;
+}
+
+/**
+ * Paint a box cut to its clip-path circle() or ellipse() (VitaSurf).
+ *
+ * \return true if it was painted, with *ok the result
+ */
+static bool html_redraw_clip_shape(const html_content *html,
+		struct box *box, int x_parent, int y_parent,
+		const struct rect *clip, float scale, colour bg,
+		const struct redraw_context *ctx, bool *ok)
+{
+	css_fixed v[4];
+	css_unit u[4];
+	uint8_t type;
+	struct html_shape shape;
+	struct html_composite_boxes pw;
+	const struct box *outer;
+	struct rect area;
+	float x0, y0, w, h, dl, dr, dt, db;
+	bool done;
+
+	if (box->style == NULL || vitasurf_raster == NULL ||
+			box == html_composite_active)
+		return false;
+	type = css_computed_clip_path(box->style, &v[0], &u[0], &v[1], &u[1],
+			&v[2], &u[2], &v[3], &u[3]);
+	if (type != CSS_CLIP_PATH_CIRCLE && type != CSS_CLIP_PATH_ELLIPSE)
+		return false;
+
+	x0 = (x_parent + box->x - box->border[LEFT].width) * scale;
+	y0 = (y_parent + box->y - box->border[TOP].width) * scale;
+	w = (box->border[LEFT].width + box->padding[LEFT] + box->width +
+			box->padding[RIGHT] + box->border[RIGHT].width) * scale;
+	h = (box->border[TOP].width + box->padding[TOP] + box->height +
+			box->padding[BOTTOM] + box->border[BOTTOM].width) * scale;
+
+	shape.ellipse = true;
+	shape.cx = x0 + html_clip_radius(html, box, v[2], u[2], w, 0, 0, scale);
+	shape.cy = y0 + html_clip_radius(html, box, v[3], u[3], h, 0, 0, scale);
+	dl = shape.cx - x0;
+	dr = x0 + w - shape.cx;
+	dt = shape.cy - y0;
+	db = y0 + h - shape.cy;
+	if (type == CSS_CLIP_PATH_CIRCLE) {
+		/* a percentage is of the box's diagonal over root two */
+		float basis = sqrtf((w * w + h * h) / 2.0f);
+		float nearest = fminf(fminf(dl, dr), fminf(dt, db));
+		float farthest = fmaxf(fmaxf(dl, dr), fmaxf(dt, db));
+
+		shape.ex = shape.ey = html_clip_radius(html, box, v[0], u[0],
+				basis, nearest, farthest, scale);
+	} else {
+		shape.ex = html_clip_radius(html, box, v[0], u[0], w,
+				fminf(dl, dr), fmaxf(dl, dr), scale);
+		shape.ey = html_clip_radius(html, box, v[1], u[1], h,
+				fminf(dt, db), fmaxf(dt, db), scale);
+	}
+
+	area.x0 = (int) x0;
+	area.y0 = (int) y0;
+	area.x1 = (int) (x0 + w + 0.5f);
+	area.y1 = (int) (y0 + h + 0.5f);
+
+	pw.html = html;
+	pw.box = box;
+	pw.x_parent = x_parent;
+	pw.y_parent = y_parent;
+	pw.scale = scale;
+	pw.bg = bg;
+	pw.whole = true;
+	outer = html_composite_active;
+	html_composite_active = box;
+	*ok = html_composite(ctx, &area, clip, scale, &shape,
+			html_composite_boxes_draw, &pw, &done);
+	html_composite_active = outer;
+	return done;
+}
+
+
+/**
+ * An empty text field's placeholder (VitaSurf): the placeholder
+ * attribute's text in the field's font, at the field's text origin,
+ * its colour the text colour taken halfway to the background, as
+ * browsers draw it when ::placeholder says nothing else.
+ */
+static bool html_redraw_placeholder(const html_content *html,
+		struct box *box, int x, int y, int padding_width,
+		int padding_height, float scale, colour bg,
+		const struct rect *clip, const struct redraw_context *ctx)
+{
+	dom_string *ph = NULL;
+	plot_font_style_t fstyle;
+	struct rect r = *clip;
+	int px, tx, ty;
+	colour fg;
+	nserror res;
+
+	if (box->node == NULL || box->style == NULL ||
+			box->gadget->data.text.ta == NULL ||
+			textarea_get_text(box->gadget->data.text.ta,
+					NULL, 0) > 1)
+		return true;
+	if (dom_element_get_attribute(box->node, corestring_dom_placeholder,
+			&ph) != DOM_NO_ERR || ph == NULL)
+		return true;
+	if (dom_string_byte_length(ph) == 0) {
+		dom_string_unref(ph);
+		return true;
+	}
+
+	font_plot_style_from_css(&html->unit_len_ctx, box->style, &fstyle);
+	fg = fstyle.foreground;
+	if (bg == NS_TRANSPARENT)
+		bg = 0xffffff;
+	fstyle.foreground =
+		((((fg & 0xff) + (bg & 0xff)) / 2) & 0xff) |
+		(((((fg >> 8) & 0xff) + ((bg >> 8) & 0xff)) / 2) << 8) |
+		(((((fg >> 16) & 0xff) + ((bg >> 16) & 0xff)) / 2) << 16);
+	fstyle.background = bg;
+	fstyle.size *= scale;
+	px = (int) (plot_style_fixed_to_float(fstyle.size) *
+			FIXTOFLT(nscss_screen_dpi) / 72.0f + 0.5f);
+
+	/* the field's text starts four pixels in (box_textarea.c) */
+	tx = x + 4 * scale;
+	if (box->gadget->type == GADGET_TEXTAREA)
+		ty = y + 4 * scale + px;
+	else
+		ty = y + (padding_height + px * 7 / 10) / 2;
+
+	if (r.x0 < x) r.x0 = x;
+	if (r.y0 < y) r.y0 = y;
+	if (r.x1 > x + padding_width) r.x1 = x + padding_width;
+	if (r.y1 > y + padding_height) r.y1 = y + padding_height;
+	if (r.x0 >= r.x1 || r.y0 >= r.y1) {
+		dom_string_unref(ph);
+		return true;
+	}
+	res = ctx->plot->clip(ctx, &r);
+	if (res == NSERROR_OK)
+		res = ctx->plot->text(ctx, &fstyle, tx, ty,
+				dom_string_data(ph),
+				dom_string_byte_length(ph));
+	if (res == NSERROR_OK)
+		res = ctx->plot->clip(ctx, clip);
+	/* the knockout plotter keeps the text's pointer until it
+	 * flushes, and the string is released here */
+	if (res == NSERROR_OK && ctx->plot->flush != NULL)
+		res = ctx->plot->flush(ctx);
+	dom_string_unref(ph);
+	return res == NSERROR_OK;
+}
+
+
+/** A box's border box, in device coordinates (VitaSurf). */
+static void html_border_box_device(const struct box *box, int x_parent,
+		int y_parent, float scale, struct rect *r)
+{
+	r->x0 = (int) ((x_parent + box->x - box->border[LEFT].width) *
+			scale);
+	r->y0 = (int) ((y_parent + box->y - box->border[TOP].width) *
+			scale);
+	r->x1 = (int) ((x_parent + box->x + box->padding[LEFT] + box->width +
+			box->padding[RIGHT] + box->border[RIGHT].width) *
+			scale + 0.5f);
+	r->y1 = (int) ((y_parent + box->y + box->padding[TOP] +
+			box->height + box->padding[BOTTOM] +
+			box->border[BOTTOM].width) * scale + 0.5f);
+}
+
+/**
+ * backdrop-filter (VitaSurf): what is already on the screen behind the
+ * box is read back, blurred and recoloured as the filter says, cut to
+ * the box's rounded border box and put back, before the box paints its
+ * own background over it. Frosted headers and menus are made this way.
+ * Without a surface to read back, the box paints as it would.
+ */
+static bool html_redraw_backdrop(const html_content *html,
+		const struct box *box, int x_parent, int y_parent,
+		const struct rect *clip, float scale,
+		const struct redraw_context *ctx)
+{
+	lwc_string *spec = NULL;
+	struct html_paint_filter f;
+	struct html_shape shape;
+	struct rect bb, area;
+	struct bitmap *bm = NULL;
+	uint8_t *buf;
+	size_t stride;
+	int w, h, x, y;
+
+	if (vitasurf_backdrop == NULL || box->style == NULL ||
+			css_computed_backdrop_filter(box->style, &spec) !=
+					CSS_BACKDROP_FILTER_SET || spec == NULL ||
+			!html_paint_filter_parse(lwc_string_data(spec), &f))
+		return true;
+
+	html_border_box_device(box, x_parent, y_parent, scale, &bb);
+	area = bb;
+	if (area.x0 < clip->x0) area.x0 = clip->x0;
+	if (area.y0 < clip->y0) area.y0 = clip->y0;
+	if (area.x1 > clip->x1) area.x1 = clip->x1;
+	if (area.y1 > clip->y1) area.y1 = clip->y1;
+	if (area.x0 >= area.x1 || area.y0 >= area.y1 ||
+			(area.x1 - area.x0) * (area.y1 - area.y0) >
+					HTML_COMPOSITE_MAX)
+		return true;
+
+	if (ctx->plot->flush != NULL)
+		ctx->plot->flush(ctx);
+	if (vitasurf_backdrop(&area, &bm) != NSERROR_OK || bm == NULL)
+		return true;
+	buf = guit->bitmap->get_buffer(bm);
+	stride = guit->bitmap->get_rowstride(bm);
+	w = guit->bitmap->get_width(bm);
+	h = guit->bitmap->get_height(bm);
+	if (buf == NULL) {
+		guit->bitmap->destroy(bm);
+		return true;
+	}
+
+	if (f.blur > 0) {
+		int radius = (int) (f.blur * scale);
+		int span = w > h ? w : h;
+		uint8_t *tmp = malloc((size_t) span * 4);
+
+		if (radius > 64)
+			radius = 64;
+		if (tmp != NULL && radius > 0) {
+			html_filter_blur_pass(buf, w, h, stride, radius, tmp);
+			html_filter_blur_pass(buf, w, h, stride,
+					(radius + 1) / 2, tmp);
+		}
+		free(tmp);
+	}
+	if (f.colour) {
+		for (y = 0; y < h; y++) {
+			uint8_t *px = buf + y * stride;
+
+			for (x = 0; x < w; x++, px += 4) {
+				int r = px[bitmap_layout.r];
+				int g = px[bitmap_layout.g];
+				int b = px[bitmap_layout.b];
+				const int32_t *m = f.m;
+
+				px[bitmap_layout.r] = html_filter_clamp(
+					(m[0] * r + m[1] * g + m[2] * b) /
+					4096 + m[3] * 255 / 4096);
+				px[bitmap_layout.g] = html_filter_clamp(
+					(m[4] * r + m[5] * g + m[6] * b) /
+					4096 + m[7] * 255 / 4096);
+				px[bitmap_layout.b] = html_filter_clamp(
+					(m[8] * r + m[9] * g + m[10] * b) /
+					4096 + m[11] * 255 / 4096);
+			}
+		}
+	}
+	guit->bitmap->modified(bm);
+
+	/* cut to the border box's corners */
+	if (html_box_corner_radii(box, &bb, &html->unit_len_ctx, scale,
+			&shape.r)) {
+		shape.ellipse = false;
+		shape.x0 = bb.x0;
+		shape.y0 = bb.y0;
+		shape.x1 = bb.x1;
+		shape.y1 = bb.y1;
+		html_shape_apply(bm, area.x0, area.y0, &shape);
+	}
+	return html_plot_made(ctx, bm, area.x0, area.y0);
+}
+
+/** One channel of a separable blend mode, 0..255 (VitaSurf). */
+static int html_blend_channel(uint8_t mode, int s, int b)
+{
+	switch (mode) {
+	case CSS_MIX_BLEND_MODE_MULTIPLY:
+		return s * b / 255;
+	case CSS_MIX_BLEND_MODE_SCREEN:
+		return s + b - s * b / 255;
+	case CSS_MIX_BLEND_MODE_OVERLAY:
+		return b < 128 ? 2 * s * b / 255 :
+				255 - 2 * (255 - s) * (255 - b) / 255;
+	case CSS_MIX_BLEND_MODE_DARKEN:
+		return s < b ? s : b;
+	case CSS_MIX_BLEND_MODE_LIGHTEN:
+		return s > b ? s : b;
+	case CSS_MIX_BLEND_MODE_COLOR_DODGE:
+		return b == 0 ? 0 : s == 255 ? 255 :
+				html_filter_clamp(b * 255 / (255 - s));
+	case CSS_MIX_BLEND_MODE_COLOR_BURN:
+		return b == 255 ? 255 : s == 0 ? 0 :
+				255 - html_filter_clamp((255 - b) * 255 / s);
+	case CSS_MIX_BLEND_MODE_HARD_LIGHT:
+		return s < 128 ? 2 * s * b / 255 :
+				255 - 2 * (255 - s) * (255 - b) / 255;
+	case CSS_MIX_BLEND_MODE_SOFT_LIGHT:
+		return html_filter_clamp(((255 - 2 * s) * b / 255 * b +
+				2 * s * b) / 255);
+	case CSS_MIX_BLEND_MODE_DIFFERENCE:
+		return s > b ? s - b : b - s;
+	case CSS_MIX_BLEND_MODE_EXCLUSION:
+		return s + b - 2 * s * b / 255;
+	case CSS_MIX_BLEND_MODE_PLUS_LIGHTER:
+		return s + b > 255 ? 255 : s + b;
+	default:
+		return s;
+	}
+}
+
+/** The non-separable modes: a colour given another's luminosity. */
+static void html_blend_set_lum(int c[3], int lum)
+{
+	int d = lum - (30 * c[0] + 59 * c[1] + 11 * c[2]) / 100;
+	int i;
+
+	for (i = 0; i < 3; i++)
+		c[i] = html_filter_clamp(c[i] + d);
+}
+
+/**
+ * mix-blend-mode (VitaSurf): the box is painted aside, what is on the
+ * screen behind it is read back, and the two are mixed pixel by pixel
+ * as the mode says, the box's own alpha deciding how much of the mix
+ * shows. hue and saturation are taken as color.
+ *
+ * \return true if the box was painted this way, with *ok the result
+ */
+static bool html_redraw_blend(const html_content *html, struct box *box,
+		int x_parent, int y_parent, const struct rect *clip,
+		float scale, colour bg, const struct redraw_context *ctx,
+		bool *ok)
+{
+	struct html_composite_boxes pw;
+	const struct box *outer;
+	struct rect bb, area;
+	struct bitmap *src = NULL, *back = NULL;
+	uint8_t mode, *sb, *bb_buf;
+	size_t ss, bs;
+	int ox = 0, oy = 0, w, h, x, y;
+
+	if (box->style == NULL || vitasurf_raster == NULL ||
+			vitasurf_backdrop == NULL ||
+			box == html_composite_active)
+		return false;
+	mode = css_computed_mix_blend_mode(box->style);
+	if (mode == CSS_MIX_BLEND_MODE_INHERIT ||
+			mode == CSS_MIX_BLEND_MODE_NORMAL)
+		return false;
+
+	html_border_box_device(box, x_parent, y_parent, scale, &bb);
+	pw.html = html;
+	pw.box = box;
+	pw.x_parent = x_parent;
+	pw.y_parent = y_parent;
+	pw.scale = scale;
+	pw.bg = bg;
+	pw.whole = true;
+	outer = html_composite_active;
+	html_composite_active = box;
+	if (!html_composite_raster(&bb, clip, scale,
+			html_composite_boxes_draw, &pw, &src, &ox, &oy)) {
+		html_composite_active = outer;
+		*ok = true;
+		return true;
+	}
+	html_composite_active = outer;
+	if (src == NULL)
+		return false;
+
+	w = guit->bitmap->get_width(src);
+	h = guit->bitmap->get_height(src);
+	area.x0 = ox;
+	area.y0 = oy;
+	area.x1 = ox + w;
+	area.y1 = oy + h;
+	if (ctx->plot->flush != NULL)
+		ctx->plot->flush(ctx);
+	if (vitasurf_backdrop(&area, &back) != NSERROR_OK || back == NULL ||
+			guit->bitmap->get_width(back) != w ||
+			guit->bitmap->get_height(back) != h) {
+		/* nothing to mix with: the box as it is */
+		if (back != NULL)
+			guit->bitmap->destroy(back);
+		*ok = html_plot_made(ctx, src, ox, oy);
+		return true;
+	}
+
+	sb = guit->bitmap->get_buffer(src);
+	bb_buf = guit->bitmap->get_buffer(back);
+	ss = guit->bitmap->get_rowstride(src);
+	bs = guit->bitmap->get_rowstride(back);
+	for (y = 0; y < h && sb != NULL && bb_buf != NULL; y++) {
+		uint8_t *sp = sb + y * ss;
+		uint8_t *bp = bb_buf + y * bs;
+
+		for (x = 0; x < w; x++, sp += 4, bp += 4) {
+			int a = sp[bitmap_layout.a];
+			int s3[3], b3[3], m3[3], i;
+
+			if (a == 0)
+				continue;
+			s3[0] = sp[bitmap_layout.r];
+			s3[1] = sp[bitmap_layout.g];
+			s3[2] = sp[bitmap_layout.b];
+			b3[0] = bp[bitmap_layout.r];
+			b3[1] = bp[bitmap_layout.g];
+			b3[2] = bp[bitmap_layout.b];
+			if (mode == CSS_MIX_BLEND_MODE_LUMINOSITY) {
+				memcpy(m3, b3, sizeof(m3));
+				html_blend_set_lum(m3, (30 * s3[0] +
+						59 * s3[1] + 11 * s3[2]) / 100);
+			} else if (mode == CSS_MIX_BLEND_MODE_COLOR ||
+					mode == CSS_MIX_BLEND_MODE_HUE ||
+					mode == CSS_MIX_BLEND_MODE_SATURATION) {
+				memcpy(m3, s3, sizeof(m3));
+				html_blend_set_lum(m3, (30 * b3[0] +
+						59 * b3[1] + 11 * b3[2]) / 100);
+			} else {
+				for (i = 0; i < 3; i++)
+					m3[i] = html_blend_channel(mode, s3[i],
+							b3[i]);
+			}
+			bp[bitmap_layout.r] = (uint8_t) ((b3[0] * (255 - a) +
+					m3[0] * a) / 255);
+			bp[bitmap_layout.g] = (uint8_t) ((b3[1] * (255 - a) +
+					m3[1] * a) / 255);
+			bp[bitmap_layout.b] = (uint8_t) ((b3[2] * (255 - a) +
+					m3[2] * a) / 255);
+		}
+	}
+	guit->bitmap->destroy(src);
+	guit->bitmap->modified(back);
+	*ok = html_plot_made(ctx, back, ox, oy);
+	return true;
+}
+
+
+/** The mask drawn aside, white where it lets the box through. */
+struct html_mask_job {
+	struct hlcache_handle *mask;
+	struct content_redraw_data data;
+	struct rect clip;
+};
+
+static bool html_mask_draw(const struct redraw_context *ctx, void *pw)
+{
+	struct html_mask_job *j = pw;
+
+	return content_redraw(j->mask, &j->data, &j->clip, ctx);
+}
+
+/**
+ * A mask over a box that holds more than its background colour
+ * (VitaSurf): the box and everything in it is painted aside, the mask
+ * is drawn aside in white, and the box's alpha is multiplied by the
+ * mask's. html_redraw_mask keeps the plainer case, a background colour
+ * shown through the mask, which is how icons are drawn.
+ *
+ * \return true if the box was painted this way, with *ok the result
+ */
+static bool html_redraw_mask_all(const html_content *html, struct box *box,
+		int x_parent, int y_parent, const struct rect *clip,
+		float scale, colour bg, const struct redraw_context *ctx,
+		bool *ok)
+{
+	struct html_composite_boxes pw;
+	struct html_mask_job job;
+	const struct box *outer;
+	struct rect bb;
+	struct bitmap *src = NULL, *mbm = NULL;
+	uint8_t *sb, *mb;
+	size_t ss, ms;
+	int x, y, pwid, phei, ox = 0, oy = 0, w, h, i, j;
+
+	if (vitasurf_raster == NULL || box == html_composite_active ||
+			!html_box_masked(box) || box->children == NULL)
+		return false;
+
+	x = (x_parent + box->x) * scale;
+	y = (y_parent + box->y) * scale;
+	pwid = (box->padding[LEFT] + box->width + box->padding[RIGHT]) * scale;
+	phei = (box->padding[TOP] + box->height + box->padding[BOTTOM]) *
+			scale;
+	if (!html_mask_place(x, y, pwid, phei, box, scale,
+			&html->unit_len_ctx, &job.data)) {
+		/* a mask not yet here hides the box */
+		*ok = true;
+		return true;
+	}
+
+	html_border_box_device(box, x_parent, y_parent, scale, &bb);
+	pw.html = html;
+	pw.box = box;
+	pw.x_parent = x_parent;
+	pw.y_parent = y_parent;
+	pw.scale = scale;
+	pw.bg = bg;
+	pw.whole = true;
+	outer = html_composite_active;
+	html_composite_active = box;
+	if (!html_composite_raster(&bb, clip, scale,
+			html_composite_boxes_draw, &pw, &src, &ox, &oy)) {
+		html_composite_active = outer;
+		*ok = true;
+		return true;
+	}
+	html_composite_active = outer;
+	if (src == NULL)
+		return false;
+
+	w = guit->bitmap->get_width(src);
+	h = guit->bitmap->get_height(src);
+	job.mask = box->mask;
+	job.data.x -= ox;
+	job.data.y -= oy;
+	job.data.background_colour = 0xffffff;
+	job.data.mask = true;
+	job.data.mask_colour = 0xffffff;
+	job.clip.x0 = x - ox;
+	job.clip.y0 = y - oy;
+	job.clip.x1 = x - ox + pwid;
+	job.clip.y1 = y - oy + phei;
+	if (vitasurf_raster(w, h, html_mask_draw, &job, &mbm) != NSERROR_OK ||
+			mbm == NULL) {
+		guit->bitmap->destroy(src);
+		return false;
+	}
+
+	sb = guit->bitmap->get_buffer(src);
+	mb = guit->bitmap->get_buffer(mbm);
+	ss = guit->bitmap->get_rowstride(src);
+	ms = guit->bitmap->get_rowstride(mbm);
+	for (j = 0; j < h && sb != NULL && mb != NULL; j++) {
+		uint8_t *sp = sb + j * ss;
+		const uint8_t *mp = mb + j * ms;
+
+		for (i = 0; i < w; i++, sp += 4, mp += 4)
+			sp[bitmap_layout.a] = (uint8_t)
+				(sp[bitmap_layout.a] * mp[bitmap_layout.a] /
+				 255);
+	}
+	guit->bitmap->destroy(mbm);
+	guit->bitmap->set_opaque(src, false);
+	guit->bitmap->modified(src);
+	*ok = html_plot_made(ctx, src, ox, oy);
+	return true;
+}
+
+
+/**
+ * One piece of a border image (VitaSurf): the part of the source from
+ * sx0 to sx1 across and sy0 to sy1 down, source pixels, into the
+ * device rectangle d, stretched, or repeated along an axis whose flag
+ * is set. The whole source is drawn, scaled so that the part lands on
+ * the piece, clipped to the piece.
+ */
+static bool html_border_image_piece(struct hlcache_handle *img,
+		const char *gradient, const struct rect *bb, float iw, float ih,
+		float sx0, float sx1, float sy0, float sy1,
+		const struct rect *d, bool tile_x, bool tile_y, float scale,
+		const struct rect *clip, const struct redraw_context *ctx)
+{
+	struct rect pc = *d;
+	float sw = sx1 - sx0, sh = sy1 - sy0;
+	float kx, ky, tw, th, x, y;
+	int dw = d->x1 - d->x0, dh = d->y1 - d->y0;
+
+	if (dw <= 0 || dh <= 0 || sw <= 0.0f || sh <= 0.0f)
+		return true;
+	if (pc.x0 < clip->x0) pc.x0 = clip->x0;
+	if (pc.y0 < clip->y0) pc.y0 = clip->y0;
+	if (pc.x1 > clip->x1) pc.x1 = clip->x1;
+	if (pc.y1 > clip->y1) pc.y1 = clip->y1;
+	if (pc.x0 >= pc.x1 || pc.y0 >= pc.y1)
+		return true;
+
+	if (gradient != NULL) {
+		/* a gradient is as big as the border box, and each piece
+		 * shows the part of it that lies there */
+		if (ctx->plot->clip(ctx, &pc) != NSERROR_OK)
+			return false;
+		return html_redraw_gradient(gradient, bb, &pc, ctx);
+	}
+
+	kx = dw / sw;
+	ky = dh / sh;
+	/* a repeated edge keeps the source's proportions along it */
+	if (tile_x && !tile_y)
+		kx = ky;
+	if (tile_y && !tile_x)
+		ky = kx;
+	tw = sw * kx;
+	th = sh * ky;
+	if (tw < 1.0f || th < 1.0f)
+		return true;
+
+	if (ctx->plot->clip(ctx, &pc) != NSERROR_OK)
+		return false;
+	for (y = d->y0; y < d->y1; y += th) {
+		for (x = d->x0; x < d->x1; x += tw) {
+			struct content_redraw_data data;
+			struct rect tc = pc;
+
+			memset(&data, 0, sizeof(data));
+			data.x = (int) (x - sx0 * kx);
+			data.y = (int) (y - sy0 * ky);
+			data.width = (int) (iw * kx + 0.5f);
+			data.height = (int) (ih * ky + 0.5f);
+			data.background_colour = NS_TRANSPARENT;
+			data.scale = scale;
+			if (tc.x0 < (int) x) tc.x0 = (int) x;
+			if (tc.y0 < (int) y) tc.y0 = (int) y;
+			if (tc.x1 > (int) (x + tw + 0.5f))
+				tc.x1 = (int) (x + tw + 0.5f);
+			if (tc.y1 > (int) (y + th + 0.5f))
+				tc.y1 = (int) (y + th + 0.5f);
+			if (tc.x0 < tc.x1 && tc.y0 < tc.y1) {
+				if (ctx->plot->clip(ctx, &tc) != NSERROR_OK)
+					return false;
+				content_redraw(img, &data, &tc, ctx);
+			}
+			if (!tile_x)
+				break;
+		}
+		if (!tile_y)
+			break;
+	}
+	return true;
+}
+
+/**
+ * border-image (VitaSurf): the source cut into nine by the slice, the
+ * corners into the border's corners, the edges along its sides,
+ * stretched or repeated as border-image-repeat says (round and space
+ * repeat), and the middle over the padding box if the slice says fill.
+ * The border's own widths are the widths the image is drawn at.
+ *
+ * \return true if the border image was painted in place of the border
+ */
+static bool html_redraw_border_image(const html_content *html,
+		struct box *box, int x, int y, int padding_width,
+		int padding_height, int bl, int bt, int br, int bb_,
+		float scale, const struct rect *clip,
+		const struct redraw_context *ctx, bool *ok)
+{
+	lwc_string *src = NULL, *slice = NULL;
+	const char *gradient = NULL;
+	struct hlcache_handle *img = NULL;
+	struct rect bb, d;
+	float iw, ih, s[4], sx[4], sy[4];
+	int dx[4], dy[4], v[4] = { 100, 100, 100, 100 }, mask = 15, fill = 0;
+	int i, j;
+	uint8_t rep;
+	bool tile_h, tile_v;
+
+	*ok = true;
+	if (box->style == NULL || css_computed_border_image_source(box->style,
+			&src) != CSS_BORDER_IMAGE_SOURCE_SET || src == NULL)
+		return false;
+	if (strncmp(lwc_string_data(src), "gradient:", 9) == 0) {
+		gradient = lwc_string_data(src) + 9;
+	} else {
+		img = box->border_image;
+		if (img == NULL ||
+		    (content_get_status(img) != CONTENT_STATUS_READY &&
+		     content_get_status(img) != CONTENT_STATUS_DONE))
+			/* the border until the image is here */
+			return false;
+	}
+
+	bb.x0 = x - bl;
+	bb.y0 = y - bt;
+	bb.x1 = x + padding_width + br;
+	bb.y1 = y + padding_height + bb_;
+	if (gradient != NULL) {
+		iw = bb.x1 - bb.x0;
+		ih = bb.y1 - bb.y0;
+	} else {
+		iw = content_get_width(img);
+		ih = content_get_height(img);
+	}
+	if (iw <= 0 || ih <= 0)
+		return false;
+
+	if (css_computed_border_image_slice(box->style, &slice) ==
+			CSS_BORDER_IMAGE_SLICE_SET && slice != NULL) {
+		sscanf(lwc_string_data(slice), "%d,%d,%d,%d,%d,%d", &v[0],
+				&v[1], &v[2], &v[3], &mask, &fill);
+	}
+	/* a slice in pixels of the source; a gradient's source pixels are
+	 * the device's */
+	for (i = 0; i < 4; i++) {
+		float basis = (i == 0 || i == 2) ? ih : iw;
+
+		if (mask & (1 << i))
+			s[i] = basis * v[i] / 100.0f;
+		else
+			s[i] = gradient != NULL ? v[i] * scale : v[i];
+		if (s[i] > basis)
+			s[i] = basis;
+	}
+	sx[0] = 0; sx[1] = s[3]; sx[2] = iw - s[1]; sx[3] = iw;
+	sy[0] = 0; sy[1] = s[0]; sy[2] = ih - s[2]; sy[3] = ih;
+	dx[0] = bb.x0; dx[1] = bb.x0 + bl; dx[2] = bb.x1 - br; dx[3] = bb.x1;
+	dy[0] = bb.y0; dy[1] = bb.y0 + bt; dy[2] = bb.y1 - bb_; dy[3] = bb.y1;
+
+	rep = css_computed_border_image_repeat(box->style);
+	if (rep == CSS_BORDER_IMAGE_REPEAT_INHERIT)
+		rep = CSS_BORDER_IMAGE_REPEAT_STRETCH;
+	tile_h = ((rep - 1) & 3) != 0;
+	tile_v = (((rep - 1) >> 2) & 3) != 0;
+
+	for (j = 0; j < 3 && *ok; j++) {
+		for (i = 0; i < 3 && *ok; i++) {
+			if (i == 1 && j == 1 && !fill)
+				continue;
+			d.x0 = dx[i];
+			d.x1 = dx[i + 1];
