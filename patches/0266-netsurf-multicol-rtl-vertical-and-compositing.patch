+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Multi-column layout (VitaSurf): column-count, column-width, columns.
+ *
+ * A multi-column box's content is laid out once, as a single column as
+ * wide as one of its columns. The result is then cut into fragments --
+ * the lines of its inline content and the blocks it holds, looking
+ * inside a tall plain block such as a list for its lines and items --
+ * and the fragments are dealt out in order into columns of one height,
+ * the least that fits them into the column count. Moving a fragment is
+ * moving its boxes: nothing is laid out twice.
+ *
+ * What this leaves out: a block that is not split, other than by the
+ * lines and blocks inside it, keeps its whole height in one column, so
+ * a box with a background that runs across a column break has it drawn
+ * only in the first; floats inside the content stay where the single
+ * column put them; column-span is not honoured.
+ */
+
+#include <assert.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "utils/log.h"
+#include "utils/utils.h"
+
+#include "html/box.h"
+#include "html/html.h"
+#include "html/private.h"
+#include "html/box_inspect.h"
+#include "html/layout.h"
+#include "html/layout_internal.h"
+
+/** Deepest a tall block is looked inside for fragments. */
+#define MULTICOL_DEPTH 8
+
+/** Most columns laid out, whatever a page asks for. */
+#define MULTICOL_MAX 32
+
+/**
+ * A run of sibling boxes that goes into a column whole: a line of an
+ * inline container, or a block. Its top and bottom are measured from
+ * the multi-column box's own origin, as its children's are.
+ */
+struct multicol_frag {
+	struct box *first;
+	struct box *last;
+	int top;
+	int bottom;
+};
+
+struct multicol_ctx {
+	struct multicol_frag *frag;
+	unsigned int n_frag;
+	unsigned int alloc;
+	/** boxes whose content was cut up, parents first, to be given
+	 * their new heights afterwards */
+	struct box **cut;
+	unsigned int n_cut;
+	unsigned int cut_alloc;
+	/** a block at least this tall is looked inside */
+	int threshold;
+	bool nomem;
+};
+
+
+/* exported interface documented in html/layout.h */
+bool layout_multicol_columns(const css_unit_ctx *unit_len_ctx,
+		const struct box *box, int available_width,
+		int *n_out, int *width_out, int *gap_out)
+{
+	int32_t count = 0;
+	int cw = 0, gap = 0, n, colw;
+	bool has_count, has_width;
+
+	if (box->style == NULL || available_width <= 0)
+		return false;
+
+	has_count = css_computed_column_count(box->style, &count) ==
+			CSS_COLUMN_COUNT_SET && count > 0;
+	has_width = css_computed_column_width_px(box->style, unit_len_ctx,
+			available_width, &cw) == CSS_COLUMN_WIDTH_SET &&
+			cw > 0;
+	if (!has_count && !has_width)
+		return false;
+
+	/* "normal" is 1em in a multi-column box */
+	if (css_computed_column_gap_px(box->style, unit_len_ctx,
+			available_width, &gap) != CSS_COLUMN_GAP_SET) {
+		gap = FIXTOINT(css_unit_len2device_px(box->style,
+				unit_len_ctx, INTTOFIX(1), CSS_UNIT_EM));
+	}
+	if (gap < 0)
+		gap = 0;
+
+	if (has_width) {
+		/* as many columns of at least that width as fit, but no
+		 * more than a count that is also given */
+		n = (available_width + gap) / (cw + gap);
+		if (n < 1)
+			n = 1;
+		if (has_count && n > count)
+			n = count;
+	} else {
+		n = count;
+	}
+	if (n > MULTICOL_MAX)
+		n = MULTICOL_MAX;
+
+	colw = (available_width - (n - 1) * gap) / n;
+	if (colw < 1) {
+		n = 1;
+		colw = available_width;
+	}
+
+	*n_out = n;
+	*width_out = colw;
+	*gap_out = gap;
+	return n > 1;
+}
+
+
+static void multicol_add(struct multicol_ctx *m, struct box *first,
+		struct box *last, int top, int bottom)
+{
+	if (m->n_frag == m->alloc) {
+		unsigned int alloc = m->alloc ? m->alloc * 2 : 64;
+		struct multicol_frag *f = realloc(m->frag,
+				alloc * sizeof(*f));
+
+		if (f == NULL) {
+			m->nomem = true;
+			return;
+		}
+		m->frag = f;
+		m->alloc = alloc;
+	}
+	m->frag[m->n_frag].first = first;
+	m->frag[m->n_frag].last = last;
+	m->frag[m->n_frag].top = top;
+	m->frag[m->n_frag].bottom = bottom < top ? top : bottom;
+	m->n_frag++;
+}
+
+
+static void multicol_note_cut(struct multicol_ctx *m, struct box *b)
+{
+	if (m->n_cut == m->cut_alloc) {
+		unsigned int alloc = m->cut_alloc ? m->cut_alloc * 2 : 16;
+		struct box **c = realloc(m->cut, alloc * sizeof(*c));
+
+		if (c == NULL) {
+			m->nomem = true;
+			return;
+		}
+		m->cut = c;
+		m->cut_alloc = alloc;
+	}
+	m->cut[m->n_cut++] = b;
+}
+
+
+/** Whether a child of an inline container moves with its line. A float
+ * is placed against its block, not the line, and is left alone. */
+static inline bool multicol_moves(const struct box *b)
+{
+	return b->type != BOX_FLOAT_LEFT && b->type != BOX_FLOAT_RIGHT;
+}
+
+
+/** Cut an inline container into its lines. */
+static void multicol_lines(struct multicol_ctx *m, struct box *ic,
+		int base_y)
+{
+	struct box *c, *first = NULL, *last = NULL;
+	int top = 0, bottom = 0;
+
+	multicol_note_cut(m, ic);
+	for (c = ic->children; c != NULL; c = c->next) {
+		int ct, cb;
+
+		if (!multicol_moves(c))
+			continue;
+		ct = base_y + c->y;
+		cb = ct + c->height + c->padding[TOP] + c->padding[BOTTOM] +
+				c->border[TOP].width + c->border[BOTTOM].width;
+
+		if (first != NULL && ct >= bottom) {
+			/* below everything on the line so far: a new line */
+			multicol_add(m, first, last, top, bottom);
+			first = NULL;
+		}
+		if (first == NULL) {
+			first = c;
+			top = ct;
+			bottom = cb;
+		}
+		if (cb > bottom)
+			bottom = cb;
+		last = c;
+	}
+	if (first != NULL)
+		multicol_add(m, first, last, top, bottom);
+}
+
+
+/** Whether a block may be looked inside for smaller fragments. */
+static bool multicol_can_cut(const struct box *b)
+{
+	enum css_overflow_e ox, oy;
+
+	if (b->type != BOX_BLOCK || b->children == NULL ||
+			b->object != NULL || (b->flags & IFRAME) ||
+			b->gadget != NULL || b->style == NULL)
+		return false;
+	if (b->list_marker != NULL)
+		/* the marker stays with the item's first line */
+		return false;
+	ox = box_overflow_x(b);
+	oy = box_overflow_y(b);
+	if (ox != CSS_OVERFLOW_VISIBLE || oy != CSS_OVERFLOW_VISIBLE)
+		return false;
+	if (css_computed_break_inside(b->style) == CSS_BREAK_INSIDE_AVOID)
+		return false;
+	return !lh__box_is_multicol(b);
+}
+
+
+static void multicol_collect(struct multicol_ctx *m, struct box *parent,
+		int base_y, int depth)
+{
+	struct box *c;
+
+	for (c = parent->children; c != NULL && !m->nomem; c = c->next) {
+		int top, bottom;
+
+		if (c->style != NULL &&
+				(css_computed_position(c->style) ==
+					CSS_POSITION_ABSOLUTE ||
+				 css_computed_position(c->style) ==
+					CSS_POSITION_FIXED))
+			continue;
+
+		if (c->type == BOX_INLINE_CONTAINER) {
+			multicol_lines(m, c, base_y + c->y);
+			continue;
+		}
+
+		top = base_y + c->y - c->border[TOP].width;
+		bottom = base_y + c->y + c->padding[TOP] + c->height +
+				c->padding[BOTTOM] + c->border[BOTTOM].width;
+
+		if (depth < MULTICOL_DEPTH && bottom - top > m->threshold &&
+				multicol_can_cut(c)) {
+			multicol_note_cut(m, c);
+			multicol_collect(m, c, base_y + c->y, depth + 1);
+			continue;
+		}
+		multicol_add(m, c, c, top, bottom);
+	}
+}
+
+
+/**
+ * Deal the fragments into columns of a height.
+ *
+ * \param m          the fragments
+ * \param col_h      the most a column holds
+ * \param col_step   a column's width and the gap after it
+ * \param apply      move the boxes, or only count
+ * \param bottom_out if not NULL, set to the lowest bottom of a column
+ * \return how many columns that takes
+ */
+static int multicol_deal(const struct multicol_ctx *m, int col_h,
+		int col_step, bool apply, int *bottom_out)
+{
+	unsigned int i;
+	int k = 0;
+	int y0 = m->frag[0].top;
+	int start = y0;
+	int bottom = y0;
+	bool empty = true;
+
+	for (i = 0; i < m->n_frag; i++) {
+		const struct multicol_frag *f = &m->frag[i];
+
+		if (!empty && f->bottom - start > col_h) {
+			k++;
+			start = f->top;
+		}
+		empty = false;
+		if (f->bottom - start + y0 > bottom)
+			bottom = f->bottom - start + y0;
+
+		if (apply && (k != 0 || start != y0)) {
+			int dx = k * col_step, dy = y0 - start;
+			struct box *b;
+
+			for (b = f->first; b != NULL; b = b->next) {
+				if (multicol_moves(b)) {
+					b->x += dx;
+					b->y += dy;
+				}
+				if (b == f->last)
+					break;
+			}
+		}
+	}
+	if (bottom_out != NULL)
+		*bottom_out = bottom;
+	return k + 1;
+}
+
