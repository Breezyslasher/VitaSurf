+/**
+ * \file
+ * Right-to-left text for one run (VitaSurf): Arabic letters given the
+ * forms that join them, and the run put in the order it is seen.
+ */
+
+#ifndef NETSURF_HTML_BIDI_H
+#define NETSURF_HTML_BIDI_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/**
+ * Put a run of text in the order it is drawn in.
+ *
+ * The run is taken as a paragraph of its own whose direction is the
+ * block's: runs of Hebrew and Arabic are reversed, numbers and
+ * left-to-right text inside them are not, spaces and punctuation go
+ * with the text either side, brackets are mirrored, and Arabic letters
+ * are replaced by their joined presentation forms.
+ *
+ * \param text  the run, UTF-8, in the order it was written
+ * \param len   its length in bytes
+ * \param rtl   whether the block the run is in is right to left
+ * \param out   set to the visual run, in memory owned by this module
+ *              that stays valid until the next outermost redraw begins
+ * \return the visual run's length, or 0 if the run is drawn as it is
+ */
+size_t html_bidi_visual(const char *text, size_t len, bool rtl,
+		const char **out);
+
+/**
+ * A redraw is starting (VitaSurf). The outermost one frees the runs the
+ * last redraw made; a nested one, for an iframe, keeps them.
+ */
+void html_bidi_redraw_begin(void);
+
+/** A redraw has finished. */
+void html_bidi_redraw_end(void);
+
+#endif
