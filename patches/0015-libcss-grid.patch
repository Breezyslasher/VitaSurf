@@ -97,6 +97,36 @@ static inline bool arena__compare_string_list(
 }
 
 
+/* Compare two NONE-terminated grid track arrays (VitaSurf addition) */
+static inline bool arena__compare_grid_tracks(
+		const css_computed_grid_track *a,
+		const css_computed_grid_track *b)
+{
+	if (a == NULL && b == NULL) {
+		return true;
+
+	} else if (a == NULL || b == NULL) {
+		return false;
+	}
+
+	while (a->min_type != CSS_GRID_TRACK_NONE &&
+			b->min_type != CSS_GRID_TRACK_NONE) {
+		if (a->min_type != b->min_type ||
+				a->max_type != b->max_type ||
+				a->flags != b->flags ||
+				a->min_unit != b->min_unit ||
+				a->max_unit != b->max_unit ||
+				a->min_value != b->min_value ||
+				a->max_value != b->max_value) {
+			return false;
+		}
+		a++;
+		b++;
+	}
+
+	return a->min_type == b->min_type;
+}
+
 static inline bool css__arena_style_is_equal(
 		struct css_computed_style *a,
 		struct css_computed_style *b)
@@ -141,6 +171,30 @@ static inline bool css__arena_style_is_equal(
 		return false;
 	}
 
+	if (!arena__compare_grid_tracks(
+			a->grid_template_columns,
+			b->grid_template_columns)) {
+		return false;
+	}
+
+	if (!arena__compare_grid_tracks(
+			a->grid_template_rows,
+			b->grid_template_rows)) {
+		return false;
+	}
+
+	if (!arena__compare_grid_tracks(
+			a->grid_auto_columns,
+			b->grid_auto_columns)) {
+		return false;
+	}
+
+	if (!arena__compare_grid_tracks(
+			a->grid_auto_rows,
+			b->grid_auto_rows)) {
+		return false;
+	}
+
 	return true;
 }
 
