@@ -78,6 +78,95 @@ enum op_mask_image {
 	MASK_IMAGE_NONE			= 0x0000
 };
 
+enum op_grid_template {
+	GRID_TEMPLATE_NONE		= 0x0000,
+	GRID_TEMPLATE_SET		= 0x0080	/* + track list */
+};
+
+enum op_grid_auto_track {
+	GRID_AUTO_TRACK_AUTO		= 0x0000,
+	GRID_AUTO_TRACK_SET		= 0x0080	/* + track list (1 entry) */
+};
+
+/* Grid track list entries follow GRID_TEMPLATE_SET / GRID_AUTO_TRACK_SET.
+ * Each entry is one word:
+ *   bits  0.. 7  min track type (GRID_TRACK_*)
+ *   bits  8..15  max track type (GRID_TRACK_*)
+ *   bits 16..23  flags (GRID_TRACK_FLAG_*)
+ *   bit  24      GRID_TRACK_MINMAX: max data words follow the min data words
+ * followed by the data words for the min type and, if GRID_TRACK_MINMAX is
+ * set, the data words for the max type:
+ *   GRID_TRACK_LENGTH, GRID_TRACK_FIT_CONTENT: length + units
+ *   GRID_TRACK_FR: number
+ *   others: none
+ * The list is terminated by a GRID_TRACK_END word. */
+enum op_grid_track {
+	GRID_TRACK_END			= 0x0000,
+	GRID_TRACK_AUTO			= 0x0001,
+	GRID_TRACK_LENGTH		= 0x0002,
+	GRID_TRACK_FR			= 0x0003,
+	GRID_TRACK_MIN_CONTENT		= 0x0004,
+	GRID_TRACK_MAX_CONTENT		= 0x0005,
+	GRID_TRACK_FIT_CONTENT		= 0x0006,
+
+	GRID_TRACK_TYPE_MASK		= 0x00ff,
+	GRID_TRACK_MAX_SHIFT		= 8,
+	GRID_TRACK_FLAGS_SHIFT		= 16,
+	GRID_TRACK_FLAG_AUTO_FILL	= 0x0001,
+	GRID_TRACK_FLAG_AUTO_FIT	= 0x0002,
+	GRID_TRACK_MINMAX		= 0x01000000
+};
+
+/**
+ * Number of data words for one grid track breadth of the given type
+ */
+static inline uint32_t css__grid_breadth_data_words(uint32_t type)
+{
+	switch (type) {
+	case GRID_TRACK_LENGTH:
+	case GRID_TRACK_FIT_CONTENT:
+		return 2; /* length + units */
+	case GRID_TRACK_FR:
+		return 1; /* number */
+	default:
+		return 0;
+	}
+}
+
+/**
+ * Number of data words following a grid track header word
+ */
+static inline uint32_t css__grid_track_data_words(uint32_t head)
+{
+	uint32_t n = css__grid_breadth_data_words(head & GRID_TRACK_TYPE_MASK);
+
+	if (head & GRID_TRACK_MINMAX)
+		n += css__grid_breadth_data_words(
+				(head >> GRID_TRACK_MAX_SHIFT) &
+				GRID_TRACK_TYPE_MASK);
+
+	return n;
+}
+
+enum op_grid_auto_flow {
+	GRID_AUTO_FLOW_ROW		= 0x0000,
+	GRID_AUTO_FLOW_COLUMN		= 0x0001,
+	GRID_AUTO_FLOW_ROW_DENSE	= 0x0002,
+	GRID_AUTO_FLOW_COLUMN_DENSE	= 0x0003
+};
+
+enum op_grid_line {
+	GRID_LINE_AUTO			= 0x0000,
+	GRID_LINE_SET			= 0x0080,	/* + integer */
+	GRID_LINE_SPAN			= 0x0081	/* + integer */
+};
+
+enum op_row_gap {
+	ROW_GAP_NORMAL			= 0x0000,
+	ROW_GAP_CALC			= VALUE_IS_CALC,
+	ROW_GAP_SET			= 0x0080
+};
+
 enum op_background_position {
 	BACKGROUND_POSITION_HORZ_SET	= 0x0080,
 	BACKGROUND_POSITION_HORZ_CENTER	= 0x0000,
