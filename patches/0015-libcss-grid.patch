diff --git a/src/select/properties/helpers.c b/src/select/properties/helpers.c
index 5716359..564e60c 100644
--- a/src/select/properties/helpers.c
+++ b/src/select/properties/helpers.c
@@ -601,3 +601,173 @@ css_error css__cascade_counter_increment_reset(uint32_t opv, css_style *style,
 	return CSS_OK;
 }
 
+
+/**
+ * Read the data words for one grid track breadth
+ */
+static void css__read_grid_breadth(css_style *style, uint8_t type,
+		css_fixed *value, css_unit *unit)
+{
+	*value = 0;
+	*unit = CSS_UNIT_PX;
+
+	switch (type) {
+	case GRID_TRACK_LENGTH:
+	case GRID_TRACK_FIT_CONTENT:
+		*value = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(*value));
+		*unit = css__to_css_unit(*((uint32_t *) style->bytecode));
+		advance_bytecode(style, sizeof(uint32_t));
+		break;
+	case GRID_TRACK_FR:
+		*value = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(*value));
+		break;
+	default:
+		break;
+	}
+}
+
+/**
+ * Cascade a grid track list (grid-template-* and grid-auto-* properties)
+ *
+ * \param set_value   Computed type when a track list is present
+ * \param none_value  Computed type when the value is none / auto
+ * \param fun         Mutator, which takes ownership of the track array
+ */
+css_error css__cascade_grid_tracks(uint32_t opv, css_style *style,
+		css_select_state *state, uint8_t set_value, uint8_t none_value,
+		css_error (*fun)(css_computed_style *, uint8_t,
+				css_computed_grid_track *))
+{
+	uint16_t value = CSS_GRID_TEMPLATE_INHERIT;
+	css_computed_grid_track *tracks = NULL;
+	uint32_t n_tracks = 0;
+
+	/* Bytecode track types and flags map directly to the computed ones */
+	assert(GRID_TRACK_END == (enum op_grid_track)CSS_GRID_TRACK_NONE);
+	assert(GRID_TRACK_AUTO == (enum op_grid_track)CSS_GRID_TRACK_AUTO);
+	assert(GRID_TRACK_LENGTH == (enum op_grid_track)CSS_GRID_TRACK_LENGTH);
+	assert(GRID_TRACK_FR == (enum op_grid_track)CSS_GRID_TRACK_FR);
+	assert(GRID_TRACK_MIN_CONTENT ==
+			(enum op_grid_track)CSS_GRID_TRACK_MIN_CONTENT);
+	assert(GRID_TRACK_MAX_CONTENT ==
+			(enum op_grid_track)CSS_GRID_TRACK_MAX_CONTENT);
+	assert(GRID_TRACK_FIT_CONTENT ==
+			(enum op_grid_track)CSS_GRID_TRACK_FIT_CONTENT);
+	assert(GRID_TRACK_FLAG_AUTO_FILL ==
+			(enum op_grid_track)CSS_GRID_TRACK_FLAG_AUTO_FILL);
+	assert(GRID_TRACK_FLAG_AUTO_FIT ==
+			(enum op_grid_track)CSS_GRID_TRACK_FLAG_AUTO_FIT);
+	assert(GRID_TEMPLATE_SET == (enum op_grid_template)GRID_AUTO_TRACK_SET);
+
+	if (hasFlagValue(opv) == false) {
+		if (getValue(opv) == GRID_TEMPLATE_SET) {
+			uint32_t head;
+
+			value = set_value;
+
+			head = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(head));
+
+			while (head != GRID_TRACK_END) {
+				css_computed_grid_track *temp;
+				css_computed_grid_track *t;
+
+				/* Room for this track and the terminator */
+				temp = realloc(tracks,
+						(n_tracks + 2) * sizeof(*tracks));
+				if (temp == NULL) {
+					free(tracks);
+					return CSS_NOMEM;
+				}
+				tracks = temp;
+
+				t = &tracks[n_tracks];
+				memset(t, 0, sizeof(*t));
+
+				t->min_type = head & GRID_TRACK_TYPE_MASK;
+				t->max_type = (head >> GRID_TRACK_MAX_SHIFT) &
+						GRID_TRACK_TYPE_MASK;
+				t->flags = (head >> GRID_TRACK_FLAGS_SHIFT) &
+						0xff;
+
+				css__read_grid_breadth(style, t->min_type,
+						&t->min_value, &t->min_unit);
+
+				if (head & GRID_TRACK_MINMAX) {
+					css__read_grid_breadth(style,
+							t->max_type,
+							&t->max_value,
+							&t->max_unit);
+				} else {
+					t->max_value = t->min_value;
+					t->max_unit = t->min_unit;
+				}
+
+				n_tracks++;
+
+				head = *((uint32_t *) style->bytecode);
+				advance_bytecode(style, sizeof(head));
+			}
+
+			if (tracks != NULL) {
+				memset(&tracks[n_tracks], 0, sizeof(*tracks));
+				tracks[n_tracks].min_type = CSS_GRID_TRACK_NONE;
+			}
+		} else {
+			value = none_value;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		css_error error;
+
+		error = fun(state->computed, value, tracks);
+		if (error != CSS_OK && tracks != NULL)
+			free(tracks);
+
+		return error;
+	} else if (tracks != NULL) {
+		free(tracks);
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Cascade a grid line (grid-column-start etc.)
+ */
+css_error css__cascade_grid_line(uint32_t opv, css_style *style,
+		css_select_state *state,
+		css_error (*fun)(css_computed_style *, uint8_t, int32_t))
+{
+	uint16_t value = CSS_GRID_LINE_INHERIT;
+	int32_t line = 0;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case GRID_LINE_AUTO:
+			value = CSS_GRID_LINE_AUTO;
+			break;
+		case GRID_LINE_SET:
+		case GRID_LINE_SPAN:
+			value = getValue(opv) == GRID_LINE_SET ?
+					CSS_GRID_LINE_SET : CSS_GRID_LINE_SPAN;
+			line = FIXTOINT(*((css_fixed *) style->bytecode));
+			advance_bytecode(style, sizeof(css_fixed));
+			break;
+		default:
+			assert(0 && "Invalid value");
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return fun(state->computed, value, line);
+	}
+
+	return CSS_OK;
+}
