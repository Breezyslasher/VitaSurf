+/**
+ * Dump one grid track breadth, advancing *bc past its data words
+ */
+static void dump_grid_breadth(uint32_t type, const uint8_t **bc, char **ptr)
+{
+	css_fixed val;
+	uint32_t unit;
+
+	switch (type) {
+	case GRID_TRACK_AUTO:
+		*ptr += sprintf(*ptr, "auto");
+		break;
+	case GRID_TRACK_MIN_CONTENT:
+		*ptr += sprintf(*ptr, "min-content");
+		break;
+	case GRID_TRACK_MAX_CONTENT:
+		*ptr += sprintf(*ptr, "max-content");
+		break;
+	case GRID_TRACK_LENGTH:
+	case GRID_TRACK_FIT_CONTENT:
+		val = *((const css_fixed *) *bc);
+		*bc += sizeof(val);
+		unit = *((const uint32_t *) *bc);
+		*bc += sizeof(unit);
+		if (type == GRID_TRACK_FIT_CONTENT)
+			*ptr += sprintf(*ptr, "fit-content(");
+		dump_unit(val, unit, ptr);
+		if (type == GRID_TRACK_FIT_CONTENT)
+			*ptr += sprintf(*ptr, ")");
+		break;
+	case GRID_TRACK_FR:
+		val = *((const css_fixed *) *bc);
+		*bc += sizeof(val);
+		dump_number(val, ptr);
+		*ptr += sprintf(*ptr, "fr");
+		break;
+	default:
+		*ptr += sprintf(*ptr, "?");
+		break;
+	}
+}
