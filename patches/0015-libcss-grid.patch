+static size_t dump_grid_breadth(uint8_t type, css_fixed value, css_unit unit,
+		char *ptr, size_t len)
+{
+	size_t wrote = 0;
+
+	switch (type) {
+	case CSS_GRID_TRACK_AUTO:
+		wrote = snprintf(ptr, len, "auto");
+		break;
+	case CSS_GRID_TRACK_MIN_CONTENT:
+		wrote = snprintf(ptr, len, "min-content");
+		break;
+	case CSS_GRID_TRACK_MAX_CONTENT:
+		wrote = snprintf(ptr, len, "max-content");
+		break;
+	case CSS_GRID_TRACK_LENGTH:
+		wrote = dump_css_unit(value, unit, ptr, len);
+		break;
+	case CSS_GRID_TRACK_FIT_CONTENT:
+		wrote = snprintf(ptr, len, "fit-content(");
+		wrote += dump_css_unit(value, unit, ptr + wrote, len - wrote);
+		wrote += snprintf(ptr + wrote, len - wrote, ")");
+		break;
+	case CSS_GRID_TRACK_FR:
+		wrote = dump_css_number(value, ptr, len);
+		wrote += snprintf(ptr + wrote, len - wrote, "fr");
+		break;
+	default:
+		wrote = snprintf(ptr, len, "?");
+		break;
+	}
+
+	return wrote;
+}
+
+/**
+ * Dump a NONE-terminated array of computed grid tracks.
+ * Each track is preceded by a space; auto-fill/auto-fit tracks are
+ * wrapped in repeat().
+ */
+static size_t dump_grid_tracks(const css_computed_grid_track *tracks,
+		char *ptr, size_t len)
+{
+	size_t wrote = 0;
+	uint8_t in_repeat = 0;
+	const css_computed_grid_track *t;
+
+	if (tracks == NULL)
+		return snprintf(ptr, len, " (null)");
+
+	for (t = tracks; t->min_type != CSS_GRID_TRACK_NONE; t++) {
+		if (t->flags != in_repeat) {
+			if (in_repeat != 0)
+				wrote += snprintf(ptr + wrote, len - wrote, ")");
+			if (t->flags & CSS_GRID_TRACK_FLAG_AUTO_FILL)
+				wrote += snprintf(ptr + wrote, len - wrote,
+						" repeat(auto-fill,");
+			else if (t->flags & CSS_GRID_TRACK_FLAG_AUTO_FIT)
+				wrote += snprintf(ptr + wrote, len - wrote,
+						" repeat(auto-fit,");
+			in_repeat = t->flags;
+		}
+
+		wrote += snprintf(ptr + wrote, len - wrote, " ");
+
+		if (t->min_type != t->max_type ||
+				t->min_value != t->max_value ||
+				t->min_unit != t->max_unit) {
+			wrote += snprintf(ptr + wrote, len - wrote, "minmax(");
+			wrote += dump_grid_breadth(t->min_type, t->min_value,
+					t->min_unit, ptr + wrote, len - wrote);
+			wrote += snprintf(ptr + wrote, len - wrote, ", ");
+			wrote += dump_grid_breadth(t->max_type, t->max_value,
+					t->max_unit, ptr + wrote, len - wrote);
+			wrote += snprintf(ptr + wrote, len - wrote, ")");
+		} else {
+			wrote += dump_grid_breadth(t->min_type, t->min_value,
+					t->min_unit, ptr + wrote, len - wrote);
+		}
+	}
+
+	if (in_repeat != 0)
+		wrote += snprintf(ptr + wrote, len - wrote, ")");
+
+	return wrote;
+}
