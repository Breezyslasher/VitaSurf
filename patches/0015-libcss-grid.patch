diff --git a/src/parse/properties/grid.c b/src/parse/properties/grid.c
new file mode 100644
index 0000000..eb9611f
--- /dev/null
+++ b/src/parse/properties/grid.c
@@ -0,0 +1,1427 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ *
+ * CSS Grid layout properties (VitaSurf addition).
+ *
+ * Longhands:
+ *   grid-template-columns, grid-template-rows:
+ *       none | <track-list>
+ *   grid-auto-columns, grid-auto-rows:
+ *       <track-size>  (extra sizes are parsed and dropped)
+ *   grid-auto-flow:
+ *       row | column | dense | row dense | column dense
+ *   grid-column-start, grid-column-end, grid-row-start, grid-row-end:
+ *       auto | <integer> | span <positive-integer> | <custom-ident> |
+ *       span <custom-ident>
+ *   (named lines are not supported: an ident maps to auto and
+ *    span <ident> to span 1)
+ *
+ * Shorthands:
+ *   gap, grid-column, grid-row, grid-area, grid-template, grid
+ *
+ * grid-template-areas is parsed (none | <string>+) and discarded.
+ *
+ * Track lists are expanded at parse time: repeat(<n>, ...) is unrolled,
+ * repeat(auto-fill | auto-fit, ...) is emitted once with a flag on each
+ * of its tracks.  Bracketed line names are skipped.  The expanded list
+ * is capped at GRID_MAX_TRACKS entries.
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+#define GRID_MAX_TRACKS 128
+
+/**
+ * A track size as parsed, before it is written out as bytecode
+ */
+struct grid_track_parse {
+	uint8_t min_type;	/* GRID_TRACK_* */
+	uint8_t max_type;	/* GRID_TRACK_* */
+	uint8_t flags;		/* GRID_TRACK_FLAG_* */
+	bool minmax;		/* true if the track came from minmax() */
+	css_fixed min_value;
+	css_fixed max_value;
+	uint32_t min_unit;	/* bytecode unit (UNIT_*) */
+	uint32_t max_unit;	/* bytecode unit (UNIT_*) */
+};
+
+static bool token_is_ident(css_language *c, const css_token *token,
+		int str)
+{
+	bool match = false;
+
+	return token != NULL && token->type == CSS_TOKEN_IDENT &&
+		lwc_string_caseless_isequal(token->idata, c->strings[str],
+				&match) == lwc_error_ok && match;
+}
+
+static bool token_is_function(css_language *c, const css_token *token,
+		int str)
+{
+	bool match = false;
+
+	return token != NULL && token->type == CSS_TOKEN_FUNCTION &&
+		lwc_string_caseless_isequal(token->idata, c->strings[str],
+				&match) == lwc_error_ok && match;
+}
+
+/**
+ * Consume whitespace and then expect a single character token
+ */
+static css_error expect_char(const parserutils_vector *vector, int32_t *ctx,
+		uint8_t ch)
+{
+	const css_token *token;
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL || tokenIsChar(token, ch) == false)
+		return CSS_INVALID;
+
+	return CSS_OK;
+}
+
+/**
+ * Parse an integer token
+ *
+ * \param token  NUMBER token
+ * \param value  Location to receive the integer
+ * \return true if the token is an integer
+ */
+static bool token_to_integer(const css_token *token, int32_t *value)
+{
+	size_t consumed = 0;
+	css_fixed num;
+
+	if (token == NULL || token->type != CSS_TOKEN_NUMBER)
+		return false;
+
+	num = css__number_from_lwc_string(token->idata, true, &consumed);
+	if (consumed != lwc_string_length(token->idata))
+		return false;
+
+	*value = FIXTOINT(num);
+
+	return true;
+}
+
+/**
+ * Parse a <track-breadth>:
+ *   <length-percentage> | <flex> | auto | min-content | max-content |
+ *   fit-content( <length-percentage> )
+ *
+ * \param allow_fr  Whether a <flex> value (e.g. 1fr) is acceptable
+ */
+static css_error parse_track_breadth(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		bool allow_fr, uint8_t *type, css_fixed *value,
+		uint32_t *unit)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_error error;
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	*value = 0;
+	*unit = UNIT_PX;
+
+	if (token->type == CSS_TOKEN_IDENT) {
+		if (token_is_ident(c, token, AUTO)) {
+			*type = GRID_TRACK_AUTO;
+		} else if (token_is_ident(c, token, MIN_CONTENT)) {
+			*type = GRID_TRACK_MIN_CONTENT;
+		} else if (token_is_ident(c, token, MAX_CONTENT)) {
+			*type = GRID_TRACK_MAX_CONTENT;
+		} else {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		parserutils_vector_iterate(vector, ctx);
+
+		return CSS_OK;
+	}
+
+	if (token_is_function(c, token, FIT_CONTENT)) {
+		parserutils_vector_iterate(vector, ctx);
+
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				value, unit);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		if ((*unit & (UNIT_LENGTH | UNIT_PCT)) == 0 || *value < 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		if (expect_char(vector, ctx, ')') != CSS_OK) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		*type = GRID_TRACK_FIT_CONTENT;
+
+		return CSS_OK;
+	}
+
+	if (token->type == CSS_TOKEN_DIMENSION) {
+		/* The lexer does not know "fr", so detect it here */
+		size_t consumed = 0;
+		size_t len = lwc_string_length(token->idata);
+		const char *data = lwc_string_data(token->idata);
+		css_fixed num;
+
+		num = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+
+		if (len - consumed == 2 &&
+				(data[consumed] == 'f' ||
+				 data[consumed] == 'F') &&
+				(data[consumed + 1] == 'r' ||
+				 data[consumed + 1] == 'R')) {
+			if (allow_fr == false || num < 0) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+
+			parserutils_vector_iterate(vector, ctx);
+
+			*type = GRID_TRACK_FR;
+			*value = num;
+			*unit = UNIT_PX;
+
+			return CSS_OK;
+		}
+	}
+
+	if (token->type == CSS_TOKEN_DIMENSION ||
+			token->type == CSS_TOKEN_NUMBER ||
+			token->type == CSS_TOKEN_PERCENTAGE) {
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				value, unit);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		if ((*unit & (UNIT_LENGTH | UNIT_PCT)) == 0 || *value < 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		*type = GRID_TRACK_LENGTH;
+
+		return CSS_OK;
+	}
+
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
+
+/**
+ * Parse a <track-size>:
+ *   <track-breadth> | minmax( <inflexible-breadth> , <track-breadth> )
+ */
+static css_error parse_track_size(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct grid_track_parse *track)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_error error;
+
+	memset(track, 0, sizeof(*track));
+	track->min_unit = UNIT_PX;
+	track->max_unit = UNIT_PX;
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (token_is_function(c, token, MINMAX)) {
+		parserutils_vector_iterate(vector, ctx);
+
+		/* The minimum may not be flexible */
+		error = parse_track_breadth(c, vector, ctx, false,
+				&track->min_type, &track->min_value,
+				&track->min_unit);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		if (expect_char(vector, ctx, ',') != CSS_OK) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		error = parse_track_breadth(c, vector, ctx, true,
+				&track->max_type, &track->max_value,
+				&track->max_unit);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		if (expect_char(vector, ctx, ')') != CSS_OK) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		track->minmax = true;
+
+		return CSS_OK;
+	}
+
+	error = parse_track_breadth(c, vector, ctx, true,
+			&track->min_type, &track->min_value, &track->min_unit);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	track->max_type = track->min_type;
+	track->max_value = track->min_value;
+	track->max_unit = track->min_unit;
+
+	return CSS_OK;
+}
+
+/**
+ * Skip a bracketed list of line names: '[' <custom-ident>* ']'
+ *
+ * The '[' token has been peeked but not consumed.
+ */
+static css_error skip_line_names(const parserutils_vector *vector,
+		int32_t *ctx)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+
+	/* '[' */
+	parserutils_vector_iterate(vector, ctx);
+
+	while ((token = parserutils_vector_iterate(vector, ctx)) != NULL) {
+		if (tokenIsChar(token, ']'))
+			return CSS_OK;
+
+		if (token->type != CSS_TOKEN_IDENT &&
+				token->type != CSS_TOKEN_S) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+	}
+
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
+
+static css_error parse_track_list(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct grid_track_parse *tracks, uint32_t *n_tracks,
+		bool allow_repeat, bool *seen_auto_repeat, uint8_t flags);
+
+/**
+ * Parse repeat( <positive-integer> | auto-fill | auto-fit , <track-list> )
+ * and append the resulting tracks to \a tracks.
+ *
+ * The repeat( token has been peeked but not consumed.
+ */
+static css_error parse_repeat(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct grid_track_parse *tracks, uint32_t *n_tracks,
+		bool *seen_auto_repeat)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_error error;
+	uint8_t flags = 0;
+	int32_t count = 1;
+	uint32_t start = *n_tracks;
+	uint32_t group;
+
+	/* repeat( */
+	parserutils_vector_iterate(vector, ctx);
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token_is_ident(c, token, AUTO_FILL)) {
+		flags = GRID_TRACK_FLAG_AUTO_FILL;
+	} else if (token_is_ident(c, token, AUTO_FIT)) {
+		flags = GRID_TRACK_FLAG_AUTO_FIT;
+	} else if (token_to_integer(token, &count) == false || count < 1) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (flags != 0) {
+		/* Only one automatic repetition is allowed */
+		if (*seen_auto_repeat) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		*seen_auto_repeat = true;
+	}
+
+	if (expect_char(vector, ctx, ',') != CSS_OK) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	/* Nested repeat() is not permitted */
+	error = parse_track_list(c, vector, ctx, tracks, n_tracks, false,
+			seen_auto_repeat, flags);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	group = *n_tracks - start;
+	if (group == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (expect_char(vector, ctx, ')') != CSS_OK) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	/* Unroll a fixed repetition */
+	if (flags == 0 && count > 1) {
+		uint32_t i;
+
+		if ((uint32_t) count > GRID_MAX_TRACKS ||
+				start + group * (uint32_t) count >
+				GRID_MAX_TRACKS) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		for (i = group; i < group * (uint32_t) count; i++) {
+			tracks[start + i] = tracks[start + (i % group)];
+		}
+
+		*n_tracks = start + group * (uint32_t) count;
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Parse a <track-list> into \a tracks, starting at index \a *n_tracks.
+ *
+ * Parsing stops at the first token that does not start a track; the
+ * caller decides whether that token is acceptable.  At least one track
+ * must have been parsed for the result to be CSS_OK.
+ *
+ * \param allow_repeat      Whether repeat() may appear at this level
+ * \param seen_auto_repeat  Tracks whether an automatic repeat() was seen
+ * \param flags             Flags to set on every track parsed
+ */
+static css_error parse_track_list(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct grid_track_parse *tracks, uint32_t *n_tracks,
+		bool allow_repeat, bool *seen_auto_repeat, uint8_t flags)
+{
+	int32_t orig_ctx = *ctx;
+	uint32_t start = *n_tracks;
+	css_error error;
+
+	while (true) {
+		const css_token *token;
+		int32_t prev_ctx;
+
+		consumeWhitespace(vector, ctx);
+
+		prev_ctx = *ctx;
+
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL)
+			break;
+
+		if (tokenIsChar(token, '[')) {
+			error = skip_line_names(vector, ctx);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			continue;
+		}
+
+		if (token_is_function(c, token, REPEAT)) {
+			if (allow_repeat == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+
+			error = parse_repeat(c, vector, ctx, tracks, n_tracks,
+					seen_auto_repeat);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			continue;
+		}
+
+		if (token->type == CSS_TOKEN_IDENT ||
+				token->type == CSS_TOKEN_FUNCTION ||
+				token->type == CSS_TOKEN_DIMENSION ||
+				token->type == CSS_TOKEN_NUMBER ||
+				token->type == CSS_TOKEN_PERCENTAGE) {
+			struct grid_track_parse track;
+
+			error = parse_track_size(c, vector, ctx, &track);
+			if (error != CSS_OK) {
+				if (token->type == CSS_TOKEN_IDENT) {
+					/* Not a track keyword: end of list */
+					*ctx = prev_ctx;
+					break;
+				}
+				*ctx = orig_ctx;
+				return error;
+			}
+
+			if (*n_tracks >= GRID_MAX_TRACKS) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+
+			track.flags = flags;
+			tracks[(*n_tracks)++] = track;
+			continue;
+		}
+
+		/* Something else: end of the list */
+		*ctx = prev_ctx;
+		break;
+	}
+
+	if (*n_tracks == start) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Append the data words for one track breadth
+ */
+static css_error append_breadth(css_style *result, uint8_t type,
+		css_fixed value, uint32_t unit)
+{
+	css_error error = CSS_OK;
+
+	switch (type) {
+	case GRID_TRACK_LENGTH:
+	case GRID_TRACK_FIT_CONTENT:
+		error = css__stylesheet_style_append(result, value);
+		if (error != CSS_OK)
+			return error;
+		error = css__stylesheet_style_append(result, unit);
+		break;
+	case GRID_TRACK_FR:
+		error = css__stylesheet_style_append(result, value);
+		break;
+	default:
+		break;
+	}
+
+	return error;
+}
+
+/**
+ * Append a parsed track list, followed by its terminator, to \a result
+ */
+static css_error append_track_list(css_style *result,
+		const struct grid_track_parse *tracks, uint32_t n_tracks)
+{
+	uint32_t i;
+	css_error error;
+
+	for (i = 0; i < n_tracks; i++) {
+		const struct grid_track_parse *t = &tracks[i];
+		uint32_t head = (uint32_t) t->min_type |
+			((uint32_t) t->max_type << GRID_TRACK_MAX_SHIFT) |
+			((uint32_t) t->flags << GRID_TRACK_FLAGS_SHIFT) |
+			(t->minmax ? (uint32_t) GRID_TRACK_MINMAX : 0);
+
+		error = css__stylesheet_style_append(result, head);
+		if (error != CSS_OK)
+			return error;
+
+		error = append_breadth(result, t->min_type, t->min_value,
+				t->min_unit);
+		if (error != CSS_OK)
+			return error;
+
+		if (t->minmax) {
+			error = append_breadth(result, t->max_type,
+					t->max_value, t->max_unit);
+			if (error != CSS_OK)
+				return error;
+		}
+	}
+
+	return css__stylesheet_style_append(result, GRID_TRACK_END);
+}
+
+/**
+ * Parse the value of grid-template-columns / grid-template-rows:
+ *   none | <track-list>
+ * (flag values are handled by the caller)
+ */
+static css_error parse_grid_template_value(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_error error;
+	struct grid_track_parse tracks[GRID_MAX_TRACKS];
+	uint32_t n_tracks = 0;
+	bool seen_auto_repeat = false;
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (token_is_ident(c, token, NONE)) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_TEMPLATE_NONE);
+	}
+
+	error = parse_track_list(c, vector, ctx, tracks, &n_tracks, true,
+			&seen_auto_repeat, 0);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = css__stylesheet_style_appendOPV(result, prop, 0,
+			GRID_TEMPLATE_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = append_track_list(result, tracks, n_tracks);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+static css_error parse_grid_template_longhand(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+	}
+
+	error = parse_grid_template_value(c, vector, ctx, result, prop);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+css_error css__parse_grid_template_columns(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_template_longhand(c, vector, ctx, result,
+			CSS_PROP_GRID_TEMPLATE_COLUMNS);
+}
+
+css_error css__parse_grid_template_rows(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_template_longhand(c, vector, ctx, result,
+			CSS_PROP_GRID_TEMPLATE_ROWS);
+}
+
+/**
+ * Parse grid-auto-columns / grid-auto-rows: <track-size>+
+ *
+ * Only the first track size is kept.
+ */
+static css_error parse_grid_auto_track(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+	struct grid_track_parse track;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+	}
+
+	error = parse_track_size(c, vector, ctx, &track);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	/* Swallow any further track sizes */
+	while (true) {
+		int32_t prev_ctx = *ctx;
+		struct grid_track_parse extra;
+
+		if (parse_track_size(c, vector, ctx, &extra) != CSS_OK) {
+			*ctx = prev_ctx;
+			break;
+		}
+	}
+
+	if (track.minmax == false && track.min_type == GRID_TRACK_AUTO) {
+		error = css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_AUTO_TRACK_AUTO);
+	} else {
+		error = css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_AUTO_TRACK_SET);
+		if (error == CSS_OK)
+			error = append_track_list(result, &track, 1);
+	}
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+css_error css__parse_grid_auto_columns(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_auto_track(c, vector, ctx, result,
+			CSS_PROP_GRID_AUTO_COLUMNS);
+}
+
+css_error css__parse_grid_auto_rows(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_auto_track(c, vector, ctx, result,
+			CSS_PROP_GRID_AUTO_ROWS);
+}
+
+/**
+ * Parse grid-auto-flow: [ row | column ] || dense
+ */
+css_error css__parse_grid_auto_flow(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+	bool column = false;
+	bool dense = false;
+	bool have_dir = false;
+	int i;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_GRID_AUTO_FLOW);
+	}
+
+	for (i = 0; i < 2; i++) {
+		int32_t prev_ctx;
+
+		consumeWhitespace(vector, ctx);
+		prev_ctx = *ctx;
+
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL || token->type != CSS_TOKEN_IDENT) {
+			*ctx = prev_ctx;
+			break;
+		}
+
+		if (have_dir == false && token_is_ident(c, token, ROW)) {
+			have_dir = true;
+		} else if (have_dir == false &&
+				token_is_ident(c, token, COLUMN)) {
+			have_dir = true;
+			column = true;
+		} else if (dense == false && token_is_ident(c, token, DENSE)) {
+			dense = true;
+		} else {
+			*ctx = prev_ctx;
+			break;
+		}
+	}
+
+	if (have_dir == false && dense == false) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_GRID_AUTO_FLOW,
+			0, column ?
+			(dense ? GRID_AUTO_FLOW_COLUMN_DENSE :
+				 GRID_AUTO_FLOW_COLUMN) :
+			(dense ? GRID_AUTO_FLOW_ROW_DENSE :
+				 GRID_AUTO_FLOW_ROW));
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+/**
+ * Parse a <grid-line> value (flag values are handled by the caller):
+ *   auto | <custom-ident> | [ <integer> && <custom-ident>? ] |
+ *   [ span && [ <integer> || <custom-ident> ] ]
+ */
+static css_error parse_grid_line_value(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop)
+{
+	int32_t orig_ctx = *ctx;
+	int32_t prev_ctx;
+	const css_token *token;
+	css_error error;
+	int32_t number = 0;
+	bool have_number = false;
+	bool span = false;
+	bool have_ident = false;
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		consumeWhitespace(vector, ctx);
+		prev_ctx = *ctx;
+
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL) {
+			*ctx = prev_ctx;
+			break;
+		}
+
+		if (token->type == CSS_TOKEN_NUMBER) {
+			if (have_number ||
+					token_to_integer(token, &number) == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			have_number = true;
+		} else if (token->type == CSS_TOKEN_IDENT) {
+			if (token_is_ident(c, token, SPAN)) {
+				if (span) {
+					*ctx = orig_ctx;
+					return CSS_INVALID;
+				}
+				span = true;
+			} else if (token_is_ident(c, token, AUTO)) {
+				/* auto is not a <custom-ident> */
+				if (i != 0) {
+					*ctx = prev_ctx;
+					break;
+				}
+				return css__stylesheet_style_appendOPV(result,
+						prop, 0, GRID_LINE_AUTO);
+			} else if (have_ident == false &&
+					get_css_flag_value(c, token) ==
+						FLAG_VALUE__NONE) {
+				have_ident = true;
+			} else {
+				*ctx = prev_ctx;
+				break;
+			}
+		} else {
+			*ctx = prev_ctx;
+			break;
+		}
+	}
+
+	if (have_number == false && span == false && have_ident == false) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (span) {
+		if (have_number == false) {
+			/* span <custom-ident>: named lines unsupported */
+			if (have_ident == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			number = 1;
+		} else if (number < 1) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		error = css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_LINE_SPAN);
+		if (error == CSS_OK)
+			error = css__stylesheet_style_append(result,
+					INTTOFIX(number));
+	} else if (have_number) {
+		if (number == 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		error = css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_LINE_SET);
+		if (error == CSS_OK)
+			error = css__stylesheet_style_append(result,
+					INTTOFIX(number));
+	} else {
+		/* <custom-ident> alone: named lines unsupported */
+		error = css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_LINE_AUTO);
+	}
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+static css_error parse_grid_line_longhand(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop)
+{
+	const css_token *token;
+	enum flag_value flag_value;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+	}
+
+	return parse_grid_line_value(c, vector, ctx, result, prop);
+}
+
+css_error css__parse_grid_column_start(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_line_longhand(c, vector, ctx, result,
+			CSS_PROP_GRID_COLUMN_START);
+}
+
+css_error css__parse_grid_column_end(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_line_longhand(c, vector, ctx, result,
+			CSS_PROP_GRID_COLUMN_END);
+}
+
+css_error css__parse_grid_row_start(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_line_longhand(c, vector, ctx, result,
+			CSS_PROP_GRID_ROW_START);
+}
+
+css_error css__parse_grid_row_end(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_line_longhand(c, vector, ctx, result,
+			CSS_PROP_GRID_ROW_END);
+}
+
+/******************************************************************************
+ * Shorthands                                                                 *
+ ******************************************************************************/
+
+/**
+ * Apply a flag value (inherit etc.) to a list of properties
+ */
+static css_error apply_flag_value(css_style *result,
+		enum flag_value flag_value, const opcode_t *props,
+		size_t n_props)
+{
+	size_t i;
+	css_error error = CSS_OK;
+
+	for (i = 0; i < n_props && error == CSS_OK; i++) {
+		error = css_stylesheet_style_flag_value(result, flag_value,
+				props[i]);
+	}
+
+	return error;
+}
+
+/**
+ * Parse [ '/' <grid-line> ]? for the grid-column / grid-row / grid-area
+ * shorthands, emitting auto if the part is absent.
+ *
+ * \param present  Set to false if no '/' part was found
+ */
+static css_error parse_optional_grid_line(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop, bool *present)
+{
+	int32_t prev_ctx;
+	const css_token *token;
+
+	if (*present) {
+		consumeWhitespace(vector, ctx);
+		prev_ctx = *ctx;
+
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token != NULL && tokenIsChar(token, '/')) {
+			return parse_grid_line_value(c, vector, ctx, result,
+					prop);
+		}
+
+		*ctx = prev_ctx;
+		*present = false;
+	}
+
+	return css__stylesheet_style_appendOPV(result, prop, 0,
+			GRID_LINE_AUTO);
+}
+
+/**
+ * Parse grid-column / grid-row: <grid-line> [ / <grid-line> ]?
+ */
+static css_error parse_grid_line_pair(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t start_prop, opcode_t end_prop)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+	bool present = true;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		const opcode_t props[2] = { start_prop, end_prop };
+
+		parserutils_vector_iterate(vector, ctx);
+		return apply_flag_value(result, flag_value, props, 2);
+	}
+
+	error = parse_grid_line_value(c, vector, ctx, result, start_prop);
+	if (error == CSS_OK)
+		error = parse_optional_grid_line(c, vector, ctx, result,
+				end_prop, &present);
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+css_error css__parse_grid_column(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_line_pair(c, vector, ctx, result,
+			CSS_PROP_GRID_COLUMN_START, CSS_PROP_GRID_COLUMN_END);
+}
+
+css_error css__parse_grid_row(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_grid_line_pair(c, vector, ctx, result,
+			CSS_PROP_GRID_ROW_START, CSS_PROP_GRID_ROW_END);
+}
+
+/**
+ * Parse grid-area:
+ *   <grid-line> [ / <grid-line> [ / <grid-line> [ / <grid-line> ] ] ]
+ * in the order row-start / column-start / row-end / column-end
+ */
+css_error css__parse_grid_area(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const opcode_t props[4] = {
+		CSS_PROP_GRID_ROW_START, CSS_PROP_GRID_COLUMN_START,
+		CSS_PROP_GRID_ROW_END, CSS_PROP_GRID_COLUMN_END
+	};
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+	bool present = true;
+	int i;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return apply_flag_value(result, flag_value, props, 4);
+	}
+
+	error = parse_grid_line_value(c, vector, ctx, result, props[0]);
+
+	for (i = 1; i < 4 && error == CSS_OK; i++) {
+		error = parse_optional_grid_line(c, vector, ctx, result,
+				props[i], &present);
+	}
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+/**
+ * Copy a single-property style into \a result, rewriting its opcode
+ *
+ * Used by the gap shorthand: row-gap and column-gap share their value
+ * encoding, so one parsed value serves both.
+ */
+static css_error copy_style_as(css_style *result, const css_style *src,
+		opcode_t prop)
+{
+	uint32_t i;
+	css_error error = CSS_OK;
+
+	for (i = 0; i < src->used && error == CSS_OK; i++) {
+		css_code_t code = src->bytecode[i];
+
+		if (i == 0)
+			code = buildOPV(prop, getFlags(code), getValue(code));
+
+		error = css__stylesheet_style_append(result, code);
+	}
+
+	return error;
+}
+
+/**
+ * Parse gap: <'row-gap'> <'column-gap'>?
+ */
+css_error css__parse_gap(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	int32_t prev_ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+	css_style *row_style = NULL;
+	css_style *column_style = NULL;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		const opcode_t props[2] = {
+			CSS_PROP_ROW_GAP, CSS_PROP_COLUMN_GAP
+		};
+
+		parserutils_vector_iterate(vector, ctx);
+		return apply_flag_value(result, flag_value, props, 2);
+	}
+
+	error = css__stylesheet_style_create(c->sheet, &row_style);
+	if (error != CSS_OK)
+		return error;
+
+	error = css__stylesheet_style_create(c->sheet, &column_style);
+	if (error != CSS_OK)
+		goto cleanup;
+
+	error = css__parse_row_gap(c, vector, ctx, row_style);
+	if (error != CSS_OK)
+		goto cleanup;
+
+	consumeWhitespace(vector, ctx);
+	prev_ctx = *ctx;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL &&
+			get_css_flag_value(c, token) == FLAG_VALUE__NONE &&
+			css__parse_row_gap(c, vector, ctx, column_style) ==
+				CSS_OK) {
+		/* Second value parsed as if it were row-gap; relabel it */
+		error = copy_style_as(result, column_style,
+				CSS_PROP_COLUMN_GAP);
+	} else {
+		*ctx = prev_ctx;
+		error = copy_style_as(result, row_style, CSS_PROP_COLUMN_GAP);
+	}
+	if (error != CSS_OK)
+		goto cleanup;
+
+	error = css__stylesheet_merge_style(result, row_style);
+
+cleanup:
+	if (row_style != NULL)
+		css__stylesheet_style_destroy(row_style);
+	if (column_style != NULL)
+		css__stylesheet_style_destroy(column_style);
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+/**
+ * Parse the common form of grid-template / grid:
+ *   none | <'grid-template-rows'> / <'grid-template-columns'>
+ */
+static css_error parse_grid_template_shorthand(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_error error;
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	if (token_is_ident(c, token, NONE)) {
+		int32_t prev_ctx;
+
+		parserutils_vector_iterate(vector, ctx);
+
+		/* none alone resets both; none / <columns> is also valid */
+		consumeWhitespace(vector, ctx);
+		prev_ctx = *ctx;
+
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL || tokenIsChar(token, '/') == false) {
+			*ctx = prev_ctx;
+
+			error = css__stylesheet_style_appendOPV(result,
+					CSS_PROP_GRID_TEMPLATE_ROWS, 0,
+					GRID_TEMPLATE_NONE);
+			if (error == CSS_OK)
+				error = css__stylesheet_style_appendOPV(result,
+					CSS_PROP_GRID_TEMPLATE_COLUMNS, 0,
+					GRID_TEMPLATE_NONE);
+			if (error != CSS_OK)
+				*ctx = orig_ctx;
+
+			return error;
+		}
+
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_GRID_TEMPLATE_ROWS, 0,
+				GRID_TEMPLATE_NONE);
+	} else {
+		error = parse_grid_template_value(c, vector, ctx, result,
+				CSS_PROP_GRID_TEMPLATE_ROWS);
+		if (error == CSS_OK)
+			error = expect_char(vector, ctx, '/');
+	}
+
+	if (error == CSS_OK)
+		error = parse_grid_template_value(c, vector, ctx, result,
+				CSS_PROP_GRID_TEMPLATE_COLUMNS);
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+css_error css__parse_grid_template(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	const css_token *token;
+	enum flag_value flag_value;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		const opcode_t props[2] = {
+			CSS_PROP_GRID_TEMPLATE_ROWS,
+			CSS_PROP_GRID_TEMPLATE_COLUMNS
+		};
+
+		parserutils_vector_iterate(vector, ctx);
+		return apply_flag_value(result, flag_value, props, 2);
+	}
+
+	return parse_grid_template_shorthand(c, vector, ctx, result);
+}
+
+/**
+ * Parse grid: only the <'grid-template'> form is supported.  As a
+ * shorthand it also resets the implicit grid properties.
+ */
+css_error css__parse_grid(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const opcode_t props[5] = {
+		CSS_PROP_GRID_TEMPLATE_ROWS, CSS_PROP_GRID_TEMPLATE_COLUMNS,
+		CSS_PROP_GRID_AUTO_ROWS, CSS_PROP_GRID_AUTO_COLUMNS,
+		CSS_PROP_GRID_AUTO_FLOW
+	};
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return apply_flag_value(result, flag_value, props, 5);
+	}
+
+	error = parse_grid_template_shorthand(c, vector, ctx, result);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_GRID_AUTO_ROWS, 0,
+				GRID_AUTO_TRACK_AUTO);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_GRID_AUTO_COLUMNS, 0,
+				GRID_AUTO_TRACK_AUTO);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_GRID_AUTO_FLOW, 0,
+				GRID_AUTO_FLOW_ROW);
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
+
+/**
+ * Parse grid-template-areas: none | <string>+
+ *
+ * Named areas are not supported, so the value is validated and
+ * discarded (no bytecode is produced), which keeps the rest of the
+ * rule alive.
+ */
+css_error css__parse_grid_template_areas(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	uint32_t n_strings = 0;
+
+	UNUSED(result);
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	if (get_css_flag_value(c, token) != FLAG_VALUE__NONE ||
+			token_is_ident(c, token, NONE)) {
+		parserutils_vector_iterate(vector, ctx);
+		return CSS_OK;
+	}
+
+	while (true) {
+		int32_t prev_ctx;
+
+		consumeWhitespace(vector, ctx);
+		prev_ctx = *ctx;
+
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL || token->type != CSS_TOKEN_STRING) {
+			*ctx = prev_ctx;
+			break;
+		}
+
+		n_strings++;
+	}
+
+	if (n_strings == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	return CSS_OK;
+}
