+/**
+ * Dump a grid track list, returning the number of bytes consumed
+ */
+static size_t dump_grid_track_list(const void *bytecode, char **ptr)
+{
+	const uint8_t *bc = bytecode;
+	uint32_t head = *((const uint32_t *) bc);
+	uint32_t in_repeat = 0;
+	bool first = true;
+
+	bc += sizeof(head);
+
+	while (head != GRID_TRACK_END) {
+		uint32_t min_type = head & GRID_TRACK_TYPE_MASK;
+		uint32_t max_type = (head >> GRID_TRACK_MAX_SHIFT) &
+				GRID_TRACK_TYPE_MASK;
+		uint32_t flags = (head >> GRID_TRACK_FLAGS_SHIFT) & 0xff;
+
+		if (flags != in_repeat) {
+			if (in_repeat != 0) {
+				*ptr += sprintf(*ptr, ")");
+				first = false;
+			}
+			if (first == false)
+				*ptr += sprintf(*ptr, " ");
+			if (flags & GRID_TRACK_FLAG_AUTO_FILL)
+				*ptr += sprintf(*ptr, "repeat(auto-fill, ");
+			else if (flags & GRID_TRACK_FLAG_AUTO_FIT)
+				*ptr += sprintf(*ptr, "repeat(auto-fit, ");
+			in_repeat = flags;
+			first = true;
+		}
+
+		if (first == false)
+			*ptr += sprintf(*ptr, " ");
+		first = false;
+
+		if (head & GRID_TRACK_MINMAX) {
+			*ptr += sprintf(*ptr, "minmax(");
+			dump_grid_breadth(min_type, &bc, ptr);
+			*ptr += sprintf(*ptr, ", ");
+			dump_grid_breadth(max_type, &bc, ptr);
+			*ptr += sprintf(*ptr, ")");
+		} else {
+			dump_grid_breadth(min_type, &bc, ptr);
+		}
+
+		head = *((const uint32_t *) bc);
+		bc += sizeof(head);
+	}
+
+	if (in_repeat != 0)
+		*ptr += sprintf(*ptr, ")");
+
+	return bc - (const uint8_t *) bytecode;
+}
