@@ -50,6 +50,17 @@ static inline enum css_overflow_e box_overflow_y(const struct box *box)
 	return css_computed_overflow_y(box->style);
 }
 
+/**
+ * Whether an overflow value makes the box a scroll container, and so a
+ * new block formatting context that margins do not collapse through
+ * (VitaSurf). clip cuts the content off as hidden does, but is neither.
+ */
+static inline bool box_overflow_contains(enum css_overflow_e overflow)
+{
+	return overflow != CSS_OVERFLOW_VISIBLE &&
+			overflow != CSS_OVERFLOW_CLIP;
+}
