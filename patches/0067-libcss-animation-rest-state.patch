+/**
+ * Leave the element where its animation comes to rest (VitaSurf).
+ *
+ * Nothing is animated here, so the choice is which single state to
+ * draw. The base style is where an element sits after an animation
+ * whose fill mode is none; for one that fills forwards, or never ends,
+ * the last keyframe is. That last case is the one that matters: the
+ * usual way to fade something in is a base style of opacity 0 and an
+ * animation that ends at 1, and drawing the base style leaves the
+ * element invisible for ever.
+ *
+ * The keyframe's declarations are cascaded above every ordinary
+ * declaration, as a browser's animation origin is, but below anything
+ * marked important, which css__outranks_existing keeps for free.
+ */
+static css_error apply_animation_rest(css_select_ctx *ctx,
+		css_select_state *state)
+{
+	css_computed_style *style =
+			state->results->styles[CSS_PSEUDO_ELEMENT_NONE];
+	const css_style *rest = NULL;
+	lwc_string *name = NULL;
+	css_fixed count = 0;
+	uint8_t fill;
+	uint32_t i;
+
+	if (style == NULL ||
+			get_animation_name(style, &name) !=
+					CSS_ANIMATION_NAME_SET ||
+			name == NULL) {
+		return CSS_OK;
+	}
+
+	fill = get_animation_fill_mode(style);
+	if (fill != CSS_ANIMATION_FILL_MODE_FORWARDS &&
+			fill != CSS_ANIMATION_FILL_MODE_BOTH &&
+			get_animation_iteration_count(style, &count) !=
+					CSS_ANIMATION_ITERATION_COUNT_INFINITE) {
+		return CSS_OK;
+	}
+
+	/* The last sheet to define the name wins, as in a browser. */
+	for (i = 0; i < ctx->n_sheets; i++) {
+		const css_style *found;
+
+		if (ctx->sheets[i].sheet == NULL ||
+				ctx->sheets[i].sheet->disabled)
+			continue;
+		found = css__stylesheet_find_keyframes(ctx->sheets[i].sheet,
+				name);
+		if (found != NULL)
+			rest = found;
+	}
+
+	if (rest == NULL) {
+		return CSS_OK;
+	}
+
+	state->current_pseudo = CSS_PSEUDO_ELEMENT_NONE;
+	state->computed = style;
+	state->current_origin = CSS_ORIGIN_AUTHOR;
+	state->current_specificity = UINT32_MAX;
+
+	return cascade_style(rest, state);
+}
