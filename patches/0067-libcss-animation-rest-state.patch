diff --git a/src/parse/nesting.c b/src/parse/nesting.c
index d356724..a86a962 100644
--- a/src/parse/nesting.c
+++ b/src/parse/nesting.c
@@ -142,6 +142,38 @@ static bool nest_is_comment(const char *s, size_t n, size_t i)
 	return (s[i] == '/' && i + 1 < n && s[i + 1] == '*');
 }
 
+/**
+ * Step over the whitespace and comments at the front of a prelude.
+ *
+ * A comment before an at-rule is common -- a note above @keyframes, say
+ * -- and it is not part of what follows: an at-rule prelude that begins
+ * with a comment is still an at-rule. Reading it as a style rule made
+ * every block inside look like nesting, and the flattener then took
+ * the whole sheet apart on that basis.
+ */
+static void nest_skip_leading(const char **p, size_t *n)
+{
+	for (;;) {
+		if (*n > 0 && ((*p)[0] == ' ' || (*p)[0] == '\t' ||
+			       (*p)[0] == '\n' || (*p)[0] == '\r')) {
+			(*p)++;
+			(*n)--;
+		} else if (*n > 1 && (*p)[0] == '/' && (*p)[1] == '*') {
+			size_t j = 2;
+
+			while (j + 1 < *n && !((*p)[j] == '*' &&
+					       (*p)[j + 1] == '/')) {
+				j++;
+			}
+			j = (j + 1 < *n) ? j + 2 : *n;
+			*p += j;
+			*n -= j;
+		} else {
+			return;
+		}
+	}
+}
