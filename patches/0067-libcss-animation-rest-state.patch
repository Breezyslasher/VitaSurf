+const css_style *css__stylesheet_find_keyframes(const css_stylesheet *sheet,
+		lwc_string *name)
+{
+	if (sheet == NULL || name == NULL)
+		return NULL;
+
+	return find_keyframes_in(sheet->rule_list, name, NULL);
+}
