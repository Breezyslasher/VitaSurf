+css_error css__initial_animation_iteration_count(css_select_state *state)
+{
+	return set_animation_iteration_count(state->computed,
+			CSS_ANIMATION_ITERATION_COUNT_SET, INTTOFIX(1));
+}
+
+css_error css__copy_animation_iteration_count(
