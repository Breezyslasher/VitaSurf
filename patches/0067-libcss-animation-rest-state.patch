+	rule->index = is_last ? 1 : 0;
+	rule->ptype = CSS_RULE_PARENT_RULE;
+	rule->parent = parent;
+	if (parent->last_child == NULL) {
+		parent->first_child = parent->last_child = rule;
+	} else {
+		parent->last_child->next = rule;
+		rule->prev = parent->last_child;
+		parent->last_child = rule;
+	}
+
