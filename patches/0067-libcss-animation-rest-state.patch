+/**
+ * Find where a named animation comes to rest (VitaSurf).
+ *
+ * \param sheet  Sheet to search, including the sheets it imports and the
+ *               rules inside its media blocks
+ * \param name   The animation-name
+ * \return the merged declarations of the keyframes that select 100%, or
+ *         NULL if the sheet has no such animation or it has no such
+ *         keyframe.
+ *
+ * The last definition wins, as it does in a browser, so the walk keeps
+ * going after a match.
+ */
+static const css_style *find_keyframes_in(const css_rule *rule,
+		lwc_string *name, const css_style *found)
+{
+	for (; rule != NULL; rule = rule->next) {
+		if (rule->type == CSS_RULE_KEYFRAMES) {
+			const css_rule_keyframes *kf =
+					(const css_rule_keyframes *) rule;
+			bool match = false;
+
+			if (kf->name != NULL && lwc_string_isequal(kf->name,
+					name, &match) == lwc_error_ok &&
+					match) {
+				found = kf->last;
+			}
+		} else if (rule->type == CSS_RULE_MEDIA) {
+			const css_rule_media *m = (const css_rule_media *) rule;
+
+			found = find_keyframes_in(m->first_child, name, found);
+		} else if (rule->type == CSS_RULE_IMPORT) {
+			const css_rule_import *im =
+					(const css_rule_import *) rule;
+
+			if (im->sheet != NULL) {
+				found = find_keyframes_in(im->sheet->rule_list,
+						name, found);
+			}
+		}
+	}
+
+	return found;
+}
