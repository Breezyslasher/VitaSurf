+css_error css__cascade_animation_iteration_count(uint32_t opv,
+		css_style *style, css_select_state *state)
+{
+	uint16_t value = CSS_ANIMATION_ITERATION_COUNT_INHERIT;
+	css_fixed count = 0;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case ANIMATION_ITERATION_COUNT_SET:
+			value = CSS_ANIMATION_ITERATION_COUNT_SET;
+			count = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(count));
+			break;
+		case ANIMATION_ITERATION_COUNT_INFINITE:
+			value = CSS_ANIMATION_ITERATION_COUNT_INFINITE;
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
