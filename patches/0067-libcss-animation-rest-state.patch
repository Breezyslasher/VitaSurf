+ * sheet, so nothing ever tries to match it. Whether it selects the
+ * resting frame is noted in the rule's index, which a rule outside the
+ * sheet has no other use for.
+ */
+static css_error handleStartKeyframe(css_language *c,
+		const parserutils_vector *vector)
+{
+	parserutils_error perror;
+	context_entry entry = { CSS_PARSER_START_RULESET, NULL };
+	context_entry *cur;
+	css_rule_keyframes *parent;
+	css_rule *rule = NULL;
+	const css_token *token;
+	int32_t ctx = 0;
+	bool is_last = false;
+	bool match;
+	css_error error;
+
+	cur = parserutils_stack_get_current(c->context);
+	if (cur == NULL || cur->data == NULL ||
+			((css_rule *) cur->data)->type != CSS_RULE_KEYFRAMES)
+		return CSS_INVALID;
+	parent = cur->data;
+
+	if (vector != NULL) {
+		consumeWhitespace(vector, &ctx);
+		while ((token = parserutils_vector_iterate(vector, &ctx)) !=
+				NULL) {
+			if (token->type == CSS_TOKEN_IDENT) {
+				if (lwc_string_caseless_isequal(token->idata,
+						c->strings[KF_TO], &match) ==
+						lwc_error_ok && match)
+					is_last = true;
+				else if (lwc_string_caseless_isequal(
+						token->idata,
+						c->strings[KF_FROM], &match) !=
+						lwc_error_ok || !match)
+					return CSS_INVALID;
+			} else if (token->type == CSS_TOKEN_PERCENTAGE) {
+				size_t consumed = 0;
+				css_fixed pct = css__number_from_lwc_string(
+						token->idata, false,
+						&consumed);
+				if (pct == INTTOFIX(100))
+					is_last = true;
+			} else if (token->type == CSS_TOKEN_S ||
+					tokenIsChar(token, ',')) {
+				/* separators */
+			} else {
+				return CSS_INVALID;
+			}
+		}
