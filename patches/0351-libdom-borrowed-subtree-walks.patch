+/*
+ * Walks of a subtree that hand out borrowed nodes (VitaSurf). The walk
+ * through the public interface took and dropped a reference at every
+ * step and went through the vtable for each child, sibling, parent,
+ * type and name: on a Home Assistant dashboard, where every card asks
+ * the body for its <action-handler> and the dashboard's components all
+ * sit in the light tree, that was 8% of the load. These follow the
+ * links directly. Nothing they return is referenced, so the caller must
+ * run no script and change no tree while it holds one.
+ */
+
+/* The node after n in tree order, within root (root itself first comes
+ * up as n), or NULL at the end. */
+static inline dom_node_internal *vita_next(dom_node_internal *root,
+		dom_node_internal *n)
+{
+	if (n->first_child != NULL)
+		return n->first_child;
+	while (n != root) {
+		if (n->next != NULL)
+			return n->next;
+		n = n->parent;
+	}
+	return NULL;
+}
+
+dom_node *dom_node_vita_next_element(dom_node *root, dom_node *after)
+{
+	dom_node_internal *r = (dom_node_internal *) root;
+	dom_node_internal *n = after != NULL ? (dom_node_internal *) after : r;
+
+	for (n = vita_next(r, n); n != NULL; n = vita_next(r, n)) {
+		if (n->type == DOM_ELEMENT_NODE)
+			return (dom_node *) n;
+	}
+	return NULL;
+}
+
+dom_string *dom_node_vita_local_name(dom_node *node)
+{
+	dom_node_internal *n = (dom_node_internal *) node;
+
+	return n->type == DOM_ELEMENT_NODE ? n->name : NULL;
+}
+
+/*
+ * Whether element n is what a selector of the one bare tag names: the
+ * name in any ASCII case for an element in the HTML namespace or none,
+ * and for any other its tag name exactly.
+ */
+static inline bool vita_tag_is(dom_node_internal *n, lwc_string *tag)
+{
+	if (n->name == NULL || !dom_string_caseless_lwc_isequal(n->name, tag))
+		return false;
+	if (n->namespace == NULL || dom_string_isequal(n->namespace,
+			dom_namespaces[DOM_NAMESPACE_HTML]))
+		return true;
+	return n->prefix == NULL && dom_string_lwc_isequal(n->name, tag);
+}
+
+dom_node *dom_node_vita_find_tag(dom_node *root, dom_node *after,
+		lwc_string *tag, uint32_t *visits)
+{
+	dom_node_internal *r = (dom_node_internal *) root;
+	dom_node_internal *n = after != NULL ? (dom_node_internal *) after : r;
+	uint32_t seen = 0;
+
+	for (n = vita_next(r, n); n != NULL; n = vita_next(r, n)) {
+		if (n->type != DOM_ELEMENT_NODE)
+			continue;
+		seen++;
+		if (vita_tag_is(n, tag))
+			break;
+	}
+	if (visits != NULL)
+		*visits += seen;
+	return (dom_node *) n;
+}
+
 dom_exception _dom_node_clone_node(dom_node_internal *node, bool deep,
 		dom_node_internal **result)
 {
