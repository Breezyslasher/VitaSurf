+ * if `after` is NULL; NULL when there are no more.
+ * dom_node_vita_find_tag: the same, for elements a selector of the one
+ * bare tag `tag` matches (any ASCII case in the HTML namespace or none,
+ * the tag name exactly in any other), adding the elements it looked at
+ * to *visits if visits is not NULL.
+ * dom_node_vita_local_name: an element's local name, or NULL.
+ */
+struct dom_node *dom_node_vita_next_element(struct dom_node *root,
+		struct dom_node *after);
+struct dom_node *dom_node_vita_find_tag(struct dom_node *root,
