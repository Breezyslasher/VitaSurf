@@ -745,6 +745,53 @@ monkey_window_handle_command(int argc, char **argv)
 		}
 		browser_window_mouse_track(gw->bw, 0, atoi(argv[5]),
 				atoi(argv[7]));
+	} else if (strcmp(argv[1], "DRAG") == 0) {
+		/* `WINDOW DRAG WIN` _%id%_ _%phase%_ `X` _%num%_ `Y` _%num%_
+		 * _%TOUCH|MOUSE%_: a press, move or release the page is told
+		 * of, as the Vita's input hands them (VitaSurf); phase is
+		 * DOWN, MOVE, UP, CANCEL or CLICK, the last a press let go
+		 * where it went down, which NetSurf's own click then ends */
+		struct gui_window *gw;
+		enum html_page_drag_phase ph;
+		unsigned int r;
+		bool touch;
+		int x, y;
+
+		if (argc != 10) {
+			moutf(MOUT_ERROR, "WINDOW DRAG ARGS BAD\n");
+			return;
+		}
+		gw = monkey_find_window_by_num(atoi(argv[3]));
+		if (gw == NULL) {
+			moutf(MOUT_ERROR, "WINDOW NUM BAD");
+			return;
+		}
+		x = atoi(argv[6]);
+		y = atoi(argv[8]);
+		touch = strcmp(argv[9], "TOUCH") == 0;
+		if (strcmp(argv[4], "DOWN") == 0) {
+			ph = HTML_PAGE_DRAG_DOWN;
+		} else if (strcmp(argv[4], "MOVE") == 0) {
+			ph = HTML_PAGE_DRAG_MOVE;
+		} else if (strcmp(argv[4], "UP") == 0) {
+			ph = HTML_PAGE_DRAG_UP;
+		} else if (strcmp(argv[4], "CANCEL") == 0) {
+			ph = HTML_PAGE_DRAG_CANCEL;
+		} else if (strcmp(argv[4], "CLICK") == 0) {
+			html_page_drag(gw->bw, HTML_PAGE_DRAG_CLICKED, touch,
