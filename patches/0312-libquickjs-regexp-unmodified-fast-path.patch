+/* VitaSurf: replace with a plain string, for an unmodified regexp that is
+   not sticky and a replacement with no '$' in it. The spec's loop builds
+   a result array for every match, with index, input and groups, only to
+   take the match's ends back out of it; this runs the matcher and copies
+   the pieces. lastIndex ends as the spec leaves it: 0 after a global
+   replace, untouched otherwise. */
+static JSValue JS_RegExpReplaceLiteral(JSContext *ctx, JSValueConst rx,
+                                       JSValueConst str_val, JSString *rep,
+                                       bool is_global)
+{
+    JSRegExp *re = &JS_VALUE_GET_OBJ(rx)->u.regexp;
+    JSString *str = JS_VALUE_GET_STRING(str_val);
+    uint8_t *re_bytecode, **capture, *str_buf;
+    int ret, capture_count, shift, re_flags, next_src_pos, start, end;
+    int64_t last_index;
+    StringBuffer b_s, *b = &b_s;
+
+    string_buffer_init(ctx, b, 0);
+    capture = NULL;
+    re_bytecode = str8(re->bytecode);
+    re_flags = lre_get_flags(re_bytecode);
+    capture_count = lre_get_capture_count(re_bytecode);
+    if (capture_count > 0) {
+        capture = js_malloc(ctx, sizeof(capture[0]) * capture_count * 2);
+        if (!capture)
+            goto fail;
+    }
+    shift = str->is_wide_char;
+    str_buf = str8(str);
+    next_src_pos = 0;
+    last_index = 0;
+    for (;;) {
+        if (last_index > str->len)
+            break;
+        ret = lre_exec(capture, re_bytecode,
+                       str_buf, last_index, str->len, shift, ctx);
+        if (ret != 1) {
+            if (ret < 0) {
+                switch(ret) {
+                case LRE_RET_TIMEOUT:
+                    JS_ThrowInterrupted(ctx);
+                    break;
+                case LRE_RET_MEMORY_ERROR:
+                    JS_ThrowInternalError(ctx, "out of memory in regexp execution");
+                    break;
+                case LRE_RET_BYTECODE_ERROR:
+                    JS_ThrowInternalError(ctx, "corrupted bytecode in regexp execution");
+                    break;
+                default:
+                    abort();
+                }
+                goto fail;
+            }
+            break;
+        }
+        start = (capture[0] - str_buf) >> shift;
+        end = (capture[1] - str_buf) >> shift;
+        if (next_src_pos < start) {
+            if (string_buffer_concat(b, str, next_src_pos, start))
+                goto fail;
+        }
+        if (rep->len > 0 && string_buffer_concat(b, rep, 0, rep->len))
+            goto fail;
+        next_src_pos = end;
+        if (!is_global)
+            break;
+        if (end == start) {
+            if (!(re_flags & LRE_FLAG_UNICODE) || (unsigned)end >= str->len || !str->is_wide_char) {
+                end++;
+            } else {
+                string_getc(str, &end);
+            }
+        }
+        last_index = end;
+    }
+    if (is_global &&
+        JS_SetProperty(ctx, rx, JS_ATOM_lastIndex, js_int32(0)) < 0)
+        goto fail;
+    if (next_src_pos < (int)str->len &&
+        string_buffer_concat(b, str, next_src_pos, str->len))
+        goto fail;
+    js_free(ctx, capture);
+    return string_buffer_end(b);
+fail:
+    js_free(ctx, capture);
+    string_buffer_free(b);
+    return JS_EXCEPTION;
+}
