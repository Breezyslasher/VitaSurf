+/* VitaSurf: the unmodified-RegExp fast path.
+
+   The spec reads a regexp's flags through the flags getter, which reads
+   eight more getters, and calls exec through a property lookup, on every
+   replace, match and test. A regexp whose own properties are only
+   lastIndex, on a RegExp.prototype whose getters and exec are still the
+   built-in ones, gets the same answers from its compiled flags and from
+   js_regexp_exec directly. Anything a page has changed takes the spec's
+   path as before. */
+static JSValue js_regexp_get_flags(JSContext *ctx, JSValueConst this_val);
+static JSValue js_regexp_exec(JSContext *ctx, JSValueConst this_val,
+                              int argc, JSValueConst *argv);
+
+static const char *const js_regexp_proto_names[10] = {
+    "flags", "hasIndices", "global", "ignoreCase", "multiline", "dotAll",
+    "unicode", "unicodeSets", "sticky", "exec",
+};
+static const int js_regexp_proto_masks[10] = {
+    0, LRE_FLAG_INDICES, LRE_FLAG_GLOBAL, LRE_FLAG_IGNORECASE,
+    LRE_FLAG_MULTILINE, LRE_FLAG_DOTALL, LRE_FLAG_UNICODE,
+    LRE_FLAG_UNICODE_SETS, LRE_FLAG_STICKY, 0,
+};
+
+static void js_regexp_note_proto(JSContext *ctx)
+{
+    JSObject *proto = JS_VALUE_GET_OBJ(ctx->class_proto[JS_CLASS_REGEXP]);
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    JSAtom atom;
+    int i;
+
+    for (i = 0; i < 10; i++) {
+        atom = JS_NewAtom(ctx, js_regexp_proto_names[i]);
+        if (atom == JS_ATOM_NULL)
+            goto fail;
+        prs = find_own_property(&pr, proto, atom);
+        if (!prs) {
+            JS_FreeAtom(ctx, atom);
+            goto fail;
+        }
+        ctx->regexp_proto_idx[i] = (int)(pr - proto->prop);
+        ctx->regexp_proto_atoms[i] = atom;
+    }
+    ctx->regexp_proto_noted = true;
+    return;
+fail:
+    while (i-- > 0)
+        JS_FreeAtom(ctx, ctx->regexp_proto_atoms[i]);
+}
+
+static bool js_regexp_pristine(JSContext *ctx, JSValueConst rx)
+{
+    JSObject *p, *proto;
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    int i, idx, t;
+
+    if (JS_VALUE_GET_TAG(rx) != JS_TAG_OBJECT)
+        return false;
+    p = JS_VALUE_GET_OBJ(rx);
+    if (p->class_id != JS_CLASS_REGEXP || p->shape != ctx->regexp_shape ||
+        !ctx->regexp_proto_noted)
+        return false;
+    /* the prototype's shape is cloned as its properties are first
+       touched, so its layout is checked slot by slot instead */
+    proto = JS_VALUE_GET_OBJ(ctx->class_proto[JS_CLASS_REGEXP]);
+    for (i = 0; i < 10; i++) {
+        idx = ctx->regexp_proto_idx[i];
+        if (idx >= (int)proto->shape->prop_count)
+            return false;
+        prs = &proto->shape->prop[idx];
+        if (prs->atom != ctx->regexp_proto_atoms[i])
+            return false;
+        pr = &proto->prop[idx];
+        t = prs->flags & JS_PROP_TMASK;
+        if (t == JS_PROP_AUTOINIT)
+            continue;   /* never looked at, so never changed */
+        if (i == 9) {
+            if (t != JS_PROP_NORMAL ||
+                !JS_IsCFunction(ctx, pr->u.value, js_regexp_exec, 0))
+                return false;
+        } else {
+            JSObject *g;
+
+            if (t != JS_PROP_GETSET || !pr->u.getset.getter)
+                return false;
+            g = pr->u.getset.getter;
+            if (g->class_id != JS_CLASS_C_FUNCTION ||
+                g->u.cfunc.magic != js_regexp_proto_masks[i])
+                return false;
+            if (i == 0 ?
+                g->u.cfunc.c_function.getter != js_regexp_get_flags :
+                g->u.cfunc.c_function.getter_magic != js_regexp_get_flag)
+                return false;
+        }
+    }
+    return true;
+}
+
+/* The flags string, as the flags getter would build it */
+static JSValue js_regexp_flags_string(JSContext *ctx, int flags)
+{
+    char str[8], *q = str;
+
+    if (flags & LRE_FLAG_INDICES) *q++ = 'd';
+    if (flags & LRE_FLAG_GLOBAL) *q++ = 'g';
+    if (flags & LRE_FLAG_IGNORECASE) *q++ = 'i';
+    if (flags & LRE_FLAG_MULTILINE) *q++ = 'm';
+    if (flags & LRE_FLAG_DOTALL) *q++ = 's';
+    if (flags & LRE_FLAG_UNICODE) *q++ = 'u';
+    if (flags & LRE_FLAG_UNICODE_SETS) *q++ = 'v';
+    if (flags & LRE_FLAG_STICKY) *q++ = 'y';
+    if (q == str)
+        return js_empty_string(ctx->rt);
+    return js_new_string8_len(ctx, str, q - str);
+}
+
+static int js_regexp_raw_flags(JSValueConst rx)
+{
+    JSRegExp *re = &JS_VALUE_GET_OBJ(rx)->u.regexp;
+
+    return lre_get_flags(str8(re->bytecode));
+}
+
+/* rx.flags, from the compiled regexp when nothing has been changed */
+static JSValue js_regexp_flags_of(JSContext *ctx, JSValueConst rx)
+{
+    if (js_regexp_pristine(ctx, rx))
+        return js_regexp_flags_string(ctx, js_regexp_raw_flags(rx));
+    return JS_GetProperty(ctx, rx, JS_ATOM_flags);
+}
