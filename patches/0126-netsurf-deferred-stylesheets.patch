+/**
+ * Whether a sheet's media attribute keeps it out of the screen cascade
+ * (VitaSurf).
+ *
+ * An empty attribute means every medium, as it does in a browser; only
+ * a list that names neither screen nor all excludes the sheet.
+ */
+static bool media_excludes_screen(dom_string *media)
+{
+	const char *text;
+
+	if (media == NULL) {
+		return false;
+	}
+
+	text = dom_string_data(media);
+	while (*text == ' ' || *text == '\t' || *text == '\n' ||
+	       *text == '\r' || *text == '\f') {
+		text++;
+	}
+
+	return *text != '\0' &&
+		strcasestr(dom_string_data(media), "screen") == NULL &&
+		strcasestr(dom_string_data(media), "all") == NULL;
+}
+
+
+/**
+ * Read an attribute of a stylesheet's element (VitaSurf).
+ *
+ * A change reports the new value before the DOM holds it, so when the
+ * attribute asked for is the one being changed the reported value is
+ * the answer. The caller owns the result.
+ */
+static dom_string *sheet_attribute(dom_node *node, dom_string *attr,
+				   dom_string *name, dom_string *value)
+{
+	dom_string *out = NULL;
+
+	if (name != NULL && dom_string_caseless_isequal(name, attr)) {
+		return value != NULL ? dom_string_ref(value) : NULL;
+	}
+	if (dom_element_get_attribute(node, attr, &out) != DOM_NO_ERR) {
+		return NULL;
+	}
+
+	return out;
+}
+
+
+/**
+ * Whether the sheet of this element stays out of the screen cascade
+ * (VitaSurf).
+ *
+ * Two things keep it out: a media list that names neither screen nor
+ * all, and a rel that does not say stylesheet yet, which is what a
+ * preload of a stylesheet looks like until a script promotes it.
+ *
+ * \param node   the LINK or STYLE element
+ * \param name   the attribute being changed, or NULL
+ * \param value  that attribute's new value, or NULL
+ */
+static bool css_sheet_unused(dom_node *node, dom_string *name,
+			     dom_string *value)
+{
+	dom_string *rel, *media;
+	bool unused;
+
+	if (node == NULL) {
+		return false;
+	}
+
+	media = sheet_attribute(node, corestring_dom_media, name, value);
+	unused = media_excludes_screen(media);
+	if (media != NULL) {
+		dom_string_unref(media);
+	}
+
+	/* a <style> has no rel, and is a stylesheet by being one */
+	rel = sheet_attribute(node, corestring_dom_rel, name, value);
+	if (rel != NULL) {
+		if (strcasestr(dom_string_data(rel), "stylesheet") == NULL) {
+			unused = true;
+		}
+		dom_string_unref(rel);
+	}
+
+	return unused;
+}
+
+
+/**
+ * Whether a link that is not a stylesheet preloads one (VitaSurf).
+ */
+static bool link_preloads_style(dom_node *node, dom_string *rel)
+{
+	dom_string *as;
+	bool style;
+
+	if (strcasestr(dom_string_data(rel), "preload") == NULL) {
+		return false;
+	}
+	if (dom_element_get_attribute(node, corestring_dom_as, &as) !=
+			DOM_NO_ERR || as == NULL) {
+		return false;
+	}
+	style = strcasecmp(dom_string_data(as), "style") == 0;
+	dom_string_unref(as);
+
+	return style;
+}
