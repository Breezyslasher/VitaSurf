+/* exported function documented in html/css.h */
+void html_css_link_changed(html_content *c, dom_node *node, dom_string *name,
+		dom_string *value)
+{
+	unsigned int i;
+	struct html_stylesheet *s;
+	bool unused;
+
+	for (i = 0, s = c->stylesheets; i != c->stylesheet_count; i++, s++) {
+		if (s->node != node) {
+			continue;
+		}
+		/* the new value comes from the change itself: the DOM
+		 * still holds the old one while it is being reported */
+		unused = css_sheet_unused(node, name, value);
+		if (unused == s->unused) {
+			return;
+		}
+		/*
+		 * The sheet has just joined the cascade, or just left it,
+		 * so the page has to be styled again (VitaSurf). This is
+		 * how a deferred stylesheet arrives: its own load handler
+		 * widens its media from print to all.
+		 */
+		s->unused = unused;
+		if (c->select_ctx != NULL) {
+			c->late_css_retries = 0;
+			guit->misc->schedule(0, html_css_late_rebuild, c);
+		}
+		return;
+	}
+}
