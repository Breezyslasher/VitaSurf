+/**
+ * react to an attribute change on a LINK or STYLE element (VitaSurf)
+ *
+ * A sheet whose media no longer excludes the screen joins the cascade,
+ * as does a preload whose rel is promoted to stylesheet; one that goes
+ * the other way leaves it. Either way the page is styled again. This is
+ * what makes a deferred stylesheet take effect: a page that inlines its
+ * critical CSS links the rest for print, or preloads it, and widens it
+ * from the link's own load handler.
+ *
+ * \param htmlc the html content to process for
+ * \param node the DOM node whose attribute changed
+ * \param name the attribute's name
+ * \param value its new value, which the DOM does not hold yet while
+ *              the change is being reported
+ */
+void html_css_link_changed(struct html_content *htmlc, dom_node *node,
+		dom_string *name, dom_string *value);
+
 
 
 #endif
