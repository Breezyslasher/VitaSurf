+/**
+ * Handle an attribute change on an element (VitaSurf).
+ *
+ * Only the stylesheet elements care: a page that defers its CSS links
+ * it for print and widens the media in the link's own load handler, and
+ * nothing then told the cascade the sheet had arrived.
+ */
+static void
+dom_default_action_DOMAttrModified_cb(struct dom_event *evt, void *pw)
+{
+	dom_event_target *node;
+	dom_node_type type;
+	dom_exception exc;
+	html_content *htmlc = pw;
+
+	exc = dom_event_get_target(evt, &node);
+	if ((exc != DOM_NO_ERR) || (node == NULL)) {
+		return;
+	}
+
+	exc = dom_node_get_node_type(node, &type);
+	if ((exc == DOM_NO_ERR) && (type == DOM_ELEMENT_NODE)) {
+		dom_html_element_type tag_type;
+
+		exc = dom_html_element_get_tag_type(node, &tag_type);
+		if (exc != DOM_NO_ERR) {
+			tag_type = DOM_HTML_ELEMENT_TYPE__UNKNOWN;
+		}
+
+		if ((tag_type == DOM_HTML_ELEMENT_TYPE_LINK ||
+		     tag_type == DOM_HTML_ELEMENT_TYPE_STYLE) &&
+		    nsoption_bool(author_level_css)) {
+			dom_string *name = NULL;
+
+			exc = dom_mutation_event_get_attr_name(
+					(dom_mutation_event *)evt, &name);
+			if (exc == DOM_NO_ERR && name != NULL) {
+				if (dom_string_caseless_isequal(name,
+						corestring_dom_media) ||
+				    dom_string_caseless_isequal(name,
+						corestring_dom_rel)) {
+					dom_string *value = NULL;
+
+					dom_mutation_event_get_new_value(
+						(dom_mutation_event *)evt,
+						&value);
+					html_css_link_changed(htmlc,
+						(dom_node *)node, name, value);
+					if (value != NULL) {
+						dom_string_unref(value);
+					}
+				}
+				dom_string_unref(name);
+			}
+		}
+	}
+
+	dom_node_unref(node);
+}
+
