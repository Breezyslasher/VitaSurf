+		const parserutils_vector *vector, int32_t ctx, int *which)
+{
+	const css_token *t = parserutils_vector_peek(vector, ctx);
+	bool match = false;
+
+	if (tokenIsChar(t, ':') == false)
+		return false;
+	t = parserutils_vector_peek(vector, ctx + 1);
+	if (t == NULL || t->type != CSS_TOKEN_FUNCTION)
+		return false;
+	if (lwc_string_caseless_isequal(t->idata, c->strings[IS_FN],
+			&match) == lwc_error_ok && match) {
+		*which = IS_FN;
+		return true;
+	}
