-                        "AppleWebKit/536.26 (KHTML, like Gecko) "
-                        "Silk/3.2 Mobile Safari/536.26";
-                char *copy = strdup(vita_ua);
-
-                if (copy != NULL) {
-                        core_user_agent_string = copy;
-                        return;
-                }
-                /* out of memory: fall through and build the usual one */
