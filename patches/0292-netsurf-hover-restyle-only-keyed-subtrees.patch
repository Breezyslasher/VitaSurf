+/** Whether an element has one of a sheet's keys for a state. */
+static bool dynamic_sheet_keyed(const css_stylesheet *sheet, uint32_t bit,
+		dom_string *name, dom_string *id, lwc_string **classes,
+		uint32_t n_classes, bool *any)
+{
+	const css_dynamic_key *keys;
+	uint32_t n, i, j;
+
+	css_stylesheet_dynamic_keys(sheet, bit, &keys, &n, any);
+	if (*any)
+		return true;
+	for (i = 0; i < n; i++) {
+		switch (keys[i].kind) {
+		case CSS_DYNAMIC_KEY_ID:
+			if (id != NULL &&
+			    dom_string_caseless_lwc_isequal(id, keys[i].name))
+				return true;
+			break;
+		case CSS_DYNAMIC_KEY_CLASS:
+			for (j = 0; j < n_classes; j++) {
+				bool eq = false;
+				if (lwc_string_caseless_isequal(classes[j],
+						keys[i].name, &eq) ==
+						lwc_error_ok && eq)
+					return true;
+			}
+			break;
+		default:
+			if (name != NULL &&
+			    dom_string_caseless_lwc_isequal(name, keys[i].name))
+				return true;
+			break;
+		}
+	}
+	return false;
+}
+
+/*
+ * Whether a change of state on an element can restyle what is under it
+ * (VitaSurf): only if some sheet has an ancestor compound asking for the
+ * state that the element could match. GitHub's sheets ask ".Box-row:hover
+ * .Link--muted" and the like, which set the sheet's bit, and every
+ * pointer move restyled the subtree under each of the six nearest
+ * ancestors of what it crossed: past the budget, that became a rebuild
+ * of the whole page, two seconds each on the Vita. Now an ancestor's
+ * subtree is restyled only if it has the class, id or name a sheet asks
+ * for with the state.
+ */
+static bool dynamic_keyed(html_content *c, dom_node *n, uint32_t bit)
+{
+	dom_string *name = NULL, *id = NULL;
+	lwc_string **classes = NULL;
+	uint32_t n_classes = 0, i, k;
+	bool hit = false, any = false;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR)
+		name = NULL;
+	if (dom_element_get_attribute(n, corestring_dom_id, &id) !=
+			DOM_NO_ERR)
+		id = NULL;
+	if (dom_element_get_classes((dom_element *) n, &classes,
+			&n_classes) != DOM_NO_ERR) {
+		classes = NULL;
+		n_classes = 0;
+	}
+
+	for (i = 0; i < c->stylesheet_count && !hit; i++) {
+		struct hlcache_handle *h = c->stylesheets[i].sheet;
+		struct nscss_import *imports;
+		uint32_t ni = 0;
+
+		if (!dynamic_sheet_ready(h))
+			continue;
+		hit = dynamic_sheet_keyed(nscss_get_stylesheet(h), bit, name,
+				id, classes, n_classes, &any);
+		imports = nscss_get_imports(h, &ni);
+		for (k = 0; k < ni && !hit; k++) {
+			if (dynamic_sheet_ready(imports[k].c))
+				hit = dynamic_sheet_keyed(nscss_get_stylesheet(
+						imports[k].c), bit, name, id,
+						classes, n_classes, &any);
+		}
+	}
+
+	for (i = 0; i < n_classes; i++)
+		lwc_string_unref(classes[i]);
+	if (name != NULL)
+		dom_string_unref(name);
+	if (id != NULL)
+		dom_string_unref(id);
+	return hit;
+}
+
+/** What the state changes that laid the page out again were (VitaSurf) */
+static struct {
+	unsigned changes, rebuilds, restyled, subtrees, skipped;
+} dynamic_stats;
+
+/* exported interface documented in html/private.h */
+void html_dynamic_report(void)
+{
+	if (dynamic_stats.changes == 0)
+		return;
+	vita_log("hover: %u changes of state restyled %u elements, %u "
+		 "subtrees under an ancestor and %u ancestors passed over "
+		 "as no sheet asks about them; %u laid the page out again",
+		 dynamic_stats.changes, dynamic_stats.restyled,
+		 dynamic_stats.subtrees, dynamic_stats.skipped,
+		 dynamic_stats.rebuilds);
+	memset(&dynamic_stats, 0, sizeof(dynamic_stats));
+}
