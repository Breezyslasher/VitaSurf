+/*
+ * Promise jobs (VitaSurf). Every entry into JavaScript ends by draining
+ * the microtask queue, which is where async, await and every .then()
+ * continuation actually run -- and it happens after the script bucket
+ * has been closed, so that work was landing in no bucket at all. A
+ * build 370 log has 2077 ms unaccounted on a YouTube load with this
+ * inside it.
+ */
+extern unsigned int vitasurf_ms_js_jobs;
+extern unsigned int vitasurf_js_jobs;
 /**
  * Milliseconds the conversion now returning spent, handed up so the
