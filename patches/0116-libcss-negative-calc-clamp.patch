+/*
+ * The same two accessors for a property that takes no negative value.
+ * A negative literal is thrown out when it is parsed, but a calc() is
+ * only known to be negative once it is resolved, and CSS Values 3
+ * clamps that to zero rather than dropping the declaration: before
+ * this, padding: calc(0px - 5px) shrank the box by five pixels
+ * (VitaSurf).
+ */
+#define COMPUTED_LENGTH_PX_NONNEG(prop, SET, FALLBACK)			\
+uint8_t css_computed_##prop##_px(					\
+		const css_computed_style *style,			\
+		const css_unit_ctx *unit_ctx,				\
+		int available_px,					\
+		int *px_out)						\
+{									\
+	css_fixed_or_calc value = { .value = 0 };			\
+	css_unit unit = CSS_UNIT_PX;					\
+	*px_out = 0;							\
+	uint8_t type = get_##prop(style, &value, &unit);		\
+									\
+	if (type == (SET) && css__length_to_px(style, unit_ctx,		\
+			available_px, value, unit, px_out) == false) {	\
+		*px_out = 0;						\
+	}								\
+	if (*px_out < 0) {						\
+		*px_out = 0;						\
+	}								\
+									\
+	return type;							\
+}
+
+#define COMPUTED_LENGTH_PX_ZERO_NONNEG(prop, SET)			\
+uint8_t css_computed_##prop##_px(					\
+		const css_computed_style *style,			\
+		const css_unit_ctx *unit_ctx,				\
+		int available_px,					\
+		int *px_out)						\
+{									\
+	css_fixed_or_calc value = { .value = 0 };			\
+	css_unit unit = CSS_UNIT_PX;					\
+	*px_out = 0;							\
+	uint8_t type = get_##prop(style, &value, &unit);		\
+									\
+	if (type == (SET) && css__length_to_px(style, unit_ctx,		\
+			available_px, value, unit, px_out) == false) {	\
+		*px_out = 0;						\
+	}								\
+	if (*px_out < 0) {						\
+		*px_out = 0;						\
+	}								\
+									\
+	return type;							\
+}
+
