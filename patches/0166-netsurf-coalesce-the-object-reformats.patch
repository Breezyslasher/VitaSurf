diff --git a/content/handlers/html/private.h b/content/handlers/html/private.h
index 25c79518a..122b1a48f 100644
--- a/content/handlers/html/private.h
+++ b/content/handlers/html/private.h
@@ -125,6 +125,17 @@ typedef struct html_content {
 	/** Whether an initial layout has been done */
 	bool had_initial_layout;
 
+	/**
+	 * A reformat asked for by an object, waiting to happen (VitaSurf).
+	 *
+	 * An object whose box has no fixed size can change the shape of the
+	 * page when it arrives, so the page has to be laid out again. Doing
+	 * that for each of them is what made a GitHub profile lay itself out
+	 * 143 times for 23006 ms. One pending reformat at a time turns a
+	 * burst of arrivals into a single pass.
+	 */
+	bool object_reformat_pending;
+
 	/** Whether scripts are enabled for this content */
 	bool enable_scripting;
 
