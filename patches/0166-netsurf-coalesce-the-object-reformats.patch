diff --git a/content/handlers/html/object.c b/content/handlers/html/object.c
index 35fef8c66..19444a720 100644
--- a/content/handlers/html/object.c
+++ b/content/handlers/html/object.c
@@ -132,6 +132,50 @@ html_object_done(struct box *box,
 }
 
 
+/**
+ * Lay the page out for the objects that have arrived (VitaSurf).
+ *
+ * Scheduled rather than run as each object becomes ready, so that a
+ * burst of them costs one pass instead of one pass each. The wait is
+ * taken from what the last pass cost: a page whose layout is cheap
+ * reformats almost at once, and one where it costs a sixth of a second
+ * does not spend all its time doing it.
+ */
+static void html_object_reformat(void *pw)
+{
+	html_content *c = pw;
+
+	c->object_reformat_pending = false;
+
+	if (c->layout == NULL) {
+		return;
+	}
+	if (c->base.status != CONTENT_STATUS_READY &&
+	    c->base.status != CONTENT_STATUS_DONE) {
+		return;
+	}
+
+	vitasurf_object_reformats++;
+	content__reformat(&c->base, false,
+			  c->base.available_width,
+			  c->base.available_height);
+}
+
+/** How long to let object arrivals gather before laying out again. */
+static int html_object_reformat_wait(void)
+{
+	/* four times the last pass keeps reflow to a fifth of the time */
+	int wait = (int)(vitasurf_ms_layout_last * 4);
+
+	if (wait < 50) {
+		wait = 50;
+	} else if (wait > 2000) {
+		wait = 2000;
+	}
+	return wait;
+}
+
+
 /**
