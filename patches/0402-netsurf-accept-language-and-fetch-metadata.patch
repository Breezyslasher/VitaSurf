+/**
+ * Log what a refused request sent and what the refusal said (VitaSurf):
+ * the request's headers, but for the value of any that may carry a
+ * secret, and a challenge's cf-mitigated header.
+ */
+static void fetch_curl_log_refused(struct curl_fetch_info *f, long code)
+{
+	char line[1024];
+	size_t at = 0;
+	struct curl_slist *h;
+	struct curl_header *ch = NULL;
+
+	line[0] = '\0';
+	for (h = f->headers; h != NULL && at + 4 < sizeof line; h = h->next) {
+		const char *d = h->data;
+		const char *colon = strchr(d, ':');
+		size_t nl = colon != NULL ? (size_t)(colon - d) : strlen(d);
+		bool secret = false;
+		char name[64];
+		size_t k;
+
+		if (colon == NULL || colon[1] == '\0') {
+			/* "Pragma:" and the like take a curl default off */
+			continue;
+		}
+		if (nl >= sizeof name)
+			nl = sizeof name - 1;
+		for (k = 0; k < nl; k++)
+			name[k] = (char)tolower((unsigned char)d[k]);
+		name[nl] = '\0';
+		if (strstr(name, "auth") || strstr(name, "token") ||
+		    strstr(name, "key") || strstr(name, "csrf") ||
+		    strstr(name, "secret") || strstr(name, "cookie") ||
+		    strstr(name, "session"))
+			secret = true;
+		at += (size_t)snprintf(line + at, sizeof line - at, "%s%.*s%s",
+				       at > 0 ? " | " : "", secret ? (int)nl :
+				       (int)strlen(d), d, secret ? ": (value not logged)" : "");
+		if (at >= sizeof line)
+			at = sizeof line - 1;
+	}
+	{
+		char *method = NULL;
+
+		if (curl_easy_getinfo(f->curl_handle, CURLINFO_EFFECTIVE_METHOD,
+				      &method) != CURLE_OK || method == NULL)
+			method = (char *)"a request";
+		NSLOG(netsurf, INFO, "refused: the %li answer to %s, which "
+		      "sent %s", code, method, line);
+	}
+	if (curl_easy_header(f->curl_handle, "cf-mitigated", 0, CURLH_HEADER,
+			     -1, &ch) == CURLHE_OK && ch != NULL) {
+		NSLOG(netsurf, INFO, "refused: cf-mitigated: %s", ch->value);
+	}
+}
