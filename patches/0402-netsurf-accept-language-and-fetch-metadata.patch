+/* exported interface documented in content/fetch.h */
+int fetch_metadata_headers(struct fetch *fetch, char lines[][160], int max,
+			   bool want_accept)
+{
+	static const char *const dests[] = {
+		"empty", "document", "iframe", "image", "style", "script",
+		"font", "object"
+	};
+	const char *accept = NULL, *mode, *site;
+	unsigned int dest = fetch->dest < 8 ? fetch->dest : FETCH_DEST_EMPTY;
+	bool nav = (dest == FETCH_DEST_DOCUMENT || dest == FETCH_DEST_IFRAME);
+	char a[256], b[256];
+	int n = 0;
+
+	/* the Fetch standard's Accept for each destination */
+	switch (dest) {
+	case FETCH_DEST_DOCUMENT:
+	case FETCH_DEST_IFRAME:
+		accept = "text/html,application/xhtml+xml,application/xml;"
+			"q=0.9,*/*;q=0.8";
+		break;
+	case FETCH_DEST_IMAGE:
+		accept = "image/png,image/svg+xml,image/*;q=0.8,*/*;q=0.5";
+		break;
+	case FETCH_DEST_STYLE:
+		accept = "text/css,*/*;q=0.1";
+		break;
+	default:
+		accept = "*/*";
+		break;
+	}
+
+	/* the mode a browser fetches each destination in */
+	if (nav)
+		mode = "navigate";
+	else if (dest == FETCH_DEST_FONT || dest == FETCH_DEST_EMPTY)
+		mode = "cors";
+	else
+		mode = "no-cors";
+
+	/* the initiator against the request: the user's own, the same
+	 * origin, the same site or another */
+	if (fetch->referer == NULL) {
+		site = "none";
+	} else if (nsurl_compare(fetch->referer, fetch->url,
+				 NSURL_SCHEME | NSURL_HOST | NSURL_PORT)) {
+		site = "same-origin";
+	} else if (urldb_site(fetch->referer, a, sizeof(a)) &&
+		   urldb_site(fetch->url, b, sizeof(b)) && strcmp(a, b) == 0) {
+		site = "same-site";
+	} else {
+		site = "cross-site";
+	}
+
+	if (want_accept && n < max)
+		snprintf(lines[n++], 160, "Accept: %s", accept);
+	if (n < max)
+		snprintf(lines[n++], 160, "Sec-Fetch-Site: %s", site);
+	if (n < max)
+		snprintf(lines[n++], 160, "Sec-Fetch-Mode: %s", mode);
+	if (n < max)
+		snprintf(lines[n++], 160, "Sec-Fetch-Dest: %s", dests[dest]);
+	if (nav && fetch->user && n < max)
+		snprintf(lines[n++], 160, "Sec-Fetch-User: ?1");
+	if (nav && n < max)
+		snprintf(lines[n++], 160, "Upgrade-Insecure-Requests: 1");
+	return n;
+}
