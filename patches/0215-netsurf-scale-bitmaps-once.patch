-		/* Not repeating at all, so just plot it */
+		/* Not repeating at all, so just plot it: a scaled copy made
+		 * once where the size differs (VitaSurf) */
+		nsfb_get_geometry(bm, &bmwidth, &bmheight, &bmformat);
+		if (width != bmwidth || height != bmheight) {
+			nsfb_t *scaled = scaled_copy(bm, width, height);
+
+			if (scaled != NULL) {
+				bm = scaled;
+			}
+		}
 		loc.x0 = x;
 		loc.y0 = y;
 		loc.x1 = loc.x0 + width;
@@ -799,6 +951,13 @@ void fb_plot_take_stats(char *buf, size_t len)
 		fbp_us[k] = 0;
 		fbp_px[k] = 0;
 	}
+	if (fb_scaled_hits + fb_scaled_made > 0 && at < len) {
+		snprintf(buf + at, len - at, "; scaled copies %u reused, %u "
+			 "made, %u KB held", fb_scaled_hits, fb_scaled_made,
+			 (unsigned int)(fb_scaled_bytes / 1024));
+		fb_scaled_hits = 0;
+		fb_scaled_made = 0;
+	}
 }
 #endif
 
