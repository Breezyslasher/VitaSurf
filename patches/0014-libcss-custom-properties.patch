+			return error;
+		if (error != CSS_OK)
+			return CSS_INVALID; /* unresolved var(): dropped */
+		error = parseProperty(c, ident, subst, &sctx, rule);
+		parserutils_vector_destroy(subst);
 	} else {
 		error = parseProperty(c, ident, vector, &ctx, rule);
 	}
