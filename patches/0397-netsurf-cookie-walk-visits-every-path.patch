+	if (url_callback == NULL && cookie_callback != NULL) {
+		/* Any node may hold cookies, not only the leaves: the
+		 * host's own holds its domain cookies, and a node with
+		 * URLs below it those set with its Path. So visit every
+		 * node, each before its children. */
+		do {
+			c = (const struct cookie_data *)p->cookies;
+			for (; c != NULL; c = c->next) {
+				if (!cookie_callback(c))
+					return false;
+			}
+
+			if (p->children != NULL) {
+				p = p->children;
+				continue;
+			}
+
+			while (p != parent) {
+				if (p->next != NULL) {
+					p = p->next;
+					break;
+				}
+				p = p->parent;
+			}
+		} while (p != parent);
+
+		return true;
+	}
