+/**
+ * Build again the boxes around a text node whose text a script changed,
+ * or an element whose children it changed: those of the nearest block
+ * that can be built on its own (VitaSurf).
+ *
+ * \param c         the document
+ * \param n         the text node, or the element
+ * \param done      the blocks built in this batch, each holding a
+ *                  reference; one added here when there is room
+ * \param n_done    how many there are
+ * \param max_done  how many done can hold
+ * \return BOX_RESTYLE_REFLOW when built (or already built), the boxes
+ *         needing laying out; BOX_RESTYLE_SAME when the text is not
+ *         drawn; BOX_RESTYLE_LAYOUT when the tree has to be rebuilt,
+ *         box_restyle_why() saying why
+ */
+enum box_restyle box_rebuild_content(struct html_content *c,
+		struct dom_node *n, struct dom_node **done,
+		unsigned *n_done, unsigned max_done);
+
 /** Why the last restyle asked for the layout, for the log (VitaSurf). */
 const char *box_restyle_why(void);
 
