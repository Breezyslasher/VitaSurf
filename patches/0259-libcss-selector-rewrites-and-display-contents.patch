+/**
+ * Rewrite the selector forms the parser does not take (VitaSurf).
+ *
+ * :-webkit-any() and :-moz-any() become :is(); :not() over a list, or
+ * over one :is() or :where() of a list, becomes a :not() per item, which
+ * is the same selector when every item is a compound. Home Assistant's
+ * sidebar keeps its content clear of itself with
+ * .app-content:not(:is(:lang(ar), ...)) { padding-left: ... }, and the
+ * whole rule was dropped, so the sidebar lay over the dashboard.
+ *
+ * \param src     Stylesheet source
+ * \param len     Length of \a src
+ * \param out     Receives the rewritten source, or NULL if nothing changed
+ * \param outlen  Receives the length of \a out
+ * \return CSS_OK on success, CSS_NOMEM on memory exhaustion
+ */
+css_error css__rewrite_selectors(const char *src, size_t len,
+				 char **out, size_t *outlen);
+
 #endif
