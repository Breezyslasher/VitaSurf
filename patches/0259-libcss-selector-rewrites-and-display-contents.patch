+
+/******************************************************************************
+ * Selector forms the parser does not take (VitaSurf)                          *
+ ******************************************************************************/
+
+struct sbuf {
+	char *p;
+	size_t n, cap;
+	bool fail;
+};
+
+static void sb_put(struct sbuf *b, const char *s, size_t n)
+{
+	if (b->fail || n == 0)
+		return;
+	if (b->n + n + 1 > b->cap) {
+		size_t cap = b->cap ? b->cap * 2 : 1024;
+		char *np;
+
+		while (cap < b->n + n + 1)
+			cap *= 2;
+		np = realloc(b->p, cap);
+		if (np == NULL) {
+			b->fail = true;
+			return;
+		}
+		b->p = np;
+		b->cap = cap;
+	}
+	memcpy(b->p + b->n, s, n);
+	b->n += n;
+	b->p[b->n] = '\0';
+}
+
+/** Index just past the ')' closing the '(' at s[i], or 0. */
+static size_t sel_close(const char *s, size_t n, size_t i)
+{
+	int depth = 0;
+	char q;
+
+	for (; i < n; i++) {
+		char c = s[i];
+
+		if (c == '"' || c == '\'') {
+			q = c;
+			for (i++; i < n && s[i] != q; i++)
+				if (s[i] == '\\')
+					i++;
+			continue;
+		}
+		if (c == '\\') {
+			i++;
+			continue;
+		}
+		if (c == '(')
+			depth++;
+		else if (c == ')' && --depth == 0)
+			return i + 1;
+	}
+	return 0;
+}
+
+static bool sel_ws(char c)
+{
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f';
+}
+
+/** Whether a selector has a combinator outside its parentheses. */
+static bool sel_has_combinator(const char *s, size_t n)
+{
+	size_t i;
+	int depth = 0;
+
+	for (i = 0; i < n; i++) {
+		char c = s[i];
+
+		if (c == '\\') {
+			i++;
+			continue;
+		}
+		if (c == '(' || c == '[')
+			depth++;
+		else if (c == ')' || c == ']')
+			depth--;
+		else if (depth == 0 &&
+			 (c == '>' || c == '+' || c == '~' || sel_ws(c)))
+			return true;
+	}
+	return false;
+}
+
+/** Split a list at its top-level commas; items are trimmed. */
+static int sel_split(const char *s, size_t n, const char **it, size_t *il,
+		     int max)
+{
+	size_t i, st = 0;
+	int depth = 0, k = 0;
+
+	for (i = 0; i <= n; i++) {
+		char c = i < n ? s[i] : ',';
+
+		if (i < n && c == '\\') {
+			i++;
+			continue;
+		}
+		if (c == '(' || c == '[')
+			depth++;
+		else if (c == ')' || c == ']')
+			depth--;
+		else if (c == ',' && depth == 0) {
+			size_t a = st, b = i;
+
+			while (a < b && sel_ws(s[a]))
+				a++;
+			while (b > a && sel_ws(s[b - 1]))
+				b--;
+			if (k >= max || a == b)
+				return -1;
+			it[k] = s + a;
+			il[k] = b - a;
+			k++;
+			st = i + 1;
+		}
+	}
+	return k;
+}
+
+static bool sel_prefix(const char *s, size_t n, const char *p)
+{
+	size_t l = strlen(p);
+
+	return n >= l && strncasecmp(s, p, l) == 0;
+}
+
+#define SEL_MAX_ITEMS 64
+
+/** Rewrite one selector prelude into b. */
+static void sel_rewrite_prelude(struct sbuf *b, const char *s, size_t n)
+{
+	size_t i = 0;
+
+	while (i < n) {
+		char c = s[i];
+
+		if (c == '"' || c == '\'') {
+			size_t j = i + 1;
+
+			while (j < n && s[j] != c) {
+				if (s[j] == '\\')
+					j++;
+				j++;
+			}
+			j = j < n ? j + 1 : n;
+			sb_put(b, s + i, j - i);
+			i = j;
+			continue;
+		}
+		if (c == ':' && sel_prefix(s + i, n - i, ":-webkit-any(")) {
+			sb_put(b, ":is(", 4);
+			i += 13;
+			continue;
+		}
+		if (c == ':' && sel_prefix(s + i, n - i, ":-moz-any(")) {
+			sb_put(b, ":is(", 4);
+			i += 10;
+			continue;
+		}
+		if (c == ':' && sel_prefix(s + i, n - i, ":not(")) {
+			size_t end = sel_close(s, n, i + 4);
+			const char *arg = s + i + 5;
+			size_t alen = end > i + 6 ? end - i - 6 : 0;
+			const char *it[SEL_MAX_ITEMS], *sub[SEL_MAX_ITEMS];
+			size_t il[SEL_MAX_ITEMS], sl[SEL_MAX_ITEMS];
+			int k, m, j, total = 0;
+			bool ok = end != 0;
+			struct sbuf inner = { NULL, 0, 0, false };
+
+			/* the argument, with its own any() forms rewritten */
+			if (ok)
+				sel_rewrite_prelude(&inner, arg, alen);
+			if (inner.fail || inner.p == NULL)
+				ok = false;
+			k = ok ? sel_split(inner.p, inner.n, it, il,
+					   SEL_MAX_ITEMS) : -1;
+			/* one item that is :is() or :where() of a list
+			 * stands for its list */
+			if (k == 1 && (sel_prefix(it[0], il[0], ":is(") ||
+				       sel_prefix(it[0], il[0], ":where("))) {
+				size_t open = (it[0][1] == 'i' ||
+					       it[0][1] == 'I') ? 3 : 6;
+
+				if (sel_close(it[0], il[0], open) == il[0]) {
+					k = sel_split(it[0] + open + 1,
+						      il[0] - open - 2,
+						      it, il, SEL_MAX_ITEMS);
+				}
+			}
+			if (k > 1) {
+				for (j = 0; j < k && ok; j++) {
+					if (sel_has_combinator(it[j], il[j]))
+						ok = false;
+					/* a nested :is() list in an item
+					 * is left as it is */
+					m = sel_split(it[j], il[j], sub, sl,
+						      SEL_MAX_ITEMS);
+					if (m != 1)
+						ok = false;
+					total++;
+				}
+			} else {
+				ok = false;
+			}
+			if (ok && total > 0) {
+				for (j = 0; j < k; j++) {
+					sb_put(b, ":not(", 5);
+					sb_put(b, it[j], il[j]);
+					sb_put(b, ")", 1);
+				}
+			} else if (end != 0) {
+				sb_put(b, ":not(", 5);
+				if (inner.p != NULL)
+					sb_put(b, inner.p, inner.n);
+				sb_put(b, ")", 1);
+			} else {
+				sb_put(b, s + i, n - i);
+				free(inner.p);
+				return;
+			}
+			free(inner.p);
+			i = end;
+			continue;
+		}
+		sb_put(b, s + i, 1);
+		i++;
+	}
+}
+
+css_error css__rewrite_selectors(const char *src, size_t len,
+				 char **out, size_t *outlen)
+{
+	struct sbuf b = { NULL, 0, 0, false };
+	size_t i = 0, start = 0;
+
+	*out = NULL;
+	*outlen = 0;
+	/* most sheets have nothing to rewrite */
+	{
+		bool any = false;
+		size_t j;
+
+		for (j = 0; j + 5 <= len && !any; j++) {
+			if (src[j] == ':' &&
+			    (strncasecmp(src + j, ":not(", 5) == 0 ||
+			     (j + 9 <= len &&
+			      strncasecmp(src + j, ":-moz-any(", 10) == 0) ||
+			     (j + 13 <= len &&
+			      strncasecmp(src + j, ":-webkit-any(", 13) == 0)))
+				any = true;
+		}
+		if (!any)
+			return CSS_OK;
+	}
+
+	/* a prelude is the text before a '{', from the last '{', '}' or
+	 * ';' outside a block's declarations */
+	while (i < len) {
+		char c = src[i];
+
+		if (c == '/' && i + 1 < len && src[i + 1] == '*') {
+			size_t j = i + 2;
+
+			while (j + 1 < len && !(src[j] == '*' && src[j + 1] == '/'))
+				j++;
+			i = j + 2 <= len ? j + 2 : len;
+			continue;
+		}
+		if (c == '"' || c == '\'') {
+			for (i++; i < len && src[i] != c; i++)
+				if (src[i] == '\\')
+					i++;
+			i++;
+			continue;
+		}
+		if (c == '{') {
+			sel_rewrite_prelude(&b, src + start, i - start);
+			sb_put(&b, "{", 1);
+			start = ++i;
+			continue;
+		}
+		if (c == '}' || c == ';') {
+			sb_put(&b, src + start, i + 1 - start);
+			start = ++i;
+			continue;
+		}
+		i++;
+	}
+	if (start < len)
+		sb_put(&b, src + start, len - start);
+	if (b.fail) {
+		free(b.p);
+		return CSS_NOMEM;
+	}
+	if (b.n == len && b.p != NULL && memcmp(b.p, src, len) == 0) {
+		free(b.p);
+		return CSS_OK;
+	}
+	*out = b.p;
+	*outlen = b.n;
+	return CSS_OK;
+}
