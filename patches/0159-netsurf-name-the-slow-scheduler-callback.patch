diff --git a/frontends/framebuffer/schedule.c b/frontends/framebuffer/schedule.c
index 0df64606c..f0a994e95 100644
--- a/frontends/framebuffer/schedule.c
+++ b/frontends/framebuffer/schedule.c
@@ -19,8 +19,12 @@
 #include <time.h>
 #include <stdlib.h>
 
+#include <stdint.h>
+
 #include "utils/sys_time.h"
 #include "utils/log.h"
+#include "utils/nsurl.h"
+#include "utils/utils.h"
 
 #include "framebuffer/schedule.h"
 
@@ -181,7 +185,40 @@ int schedule_run(void)
                                 prev_nscb->next = unlnk_nscb->next;
                         }
 
-                        unlnk_nscb->callback(unlnk_nscb->p);
+                        /*
+                         * Time it (VitaSurf). A GitHub load reports one
+                         * round of this loop taking 23438 ms with 23405
+                         * of it in here, so a single callback ran for
+                         * twenty-three seconds with the browser stopped
+                         * behind it and nothing said which callback. The
+                         * address is enough: the Vita build keeps line
+                         * tables, so it resolves the same way a crash
+                         * offset does.
+                         */
+                        {
+                                struct timeval c0, c1;
+                                unsigned int took;
+
+                                gettimeofday(&c0, NULL);
+                                unlnk_nscb->callback(unlnk_nscb->p);
+                                gettimeofday(&c1, NULL);
+
+                                took = (unsigned int)
+                                        ((c1.tv_sec - c0.tv_sec) * 1000 +
+                                         (c1.tv_usec - c0.tv_usec) / 1000);
+                                vitasurf_sched_calls++;
+                                vitasurf_ms_sched += took;
+                                if (took > vitasurf_ms_sched_max) {
+                                        vitasurf_ms_sched_max = took;
+                                }
+                                if (took >= 200) {
+                                        NSLOG(netsurf, INFO,
+                                              "slow scheduled callback "
+                                              "%08x took %u ms",
+                                              (unsigned int)(uintptr_t)
+                                              unlnk_nscb->callback, took);
+                                }
+                        }
 
                         free(unlnk_nscb);
 
