 	vitasurf_ms_nested = 0;
 }
 
diff --git a/utils/utils.h b/utils/utils.h
index 317bf33be..bdd434dd3 100644
--- a/utils/utils.h
+++ b/utils/utils.h
@@ -264,6 +264,16 @@ extern unsigned int vitasurf_ms_js_jobs_slow;
 /** Calls into the DOM query binding, which walks the tree. */
 extern unsigned int vitasurf_js_finds;
 extern unsigned int vitasurf_ms_js_finds;
+
+/*
+ * The scheduler's callbacks (VitaSurf). A GitHub page load reports
+ * "1 rounds in 23438 ms; scheduler 23405 ms": one scheduled callback
+ * ran for twenty-three seconds with the whole browser stopped behind
+ * it, and the scheduler does not record which callback it was.
+ */
+extern unsigned int vitasurf_sched_calls;
+extern unsigned int vitasurf_ms_sched;
+extern unsigned int vitasurf_ms_sched_max;
 /**
  * Milliseconds the conversion now returning spent, handed up so the
  * conversion that contains it can subtract its own nested work.
