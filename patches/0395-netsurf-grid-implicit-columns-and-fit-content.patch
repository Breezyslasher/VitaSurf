+/* exported function, documented in html/layout_internal.h (VitaSurf) */
+bool layout_grid_minmax(struct box *grid, const html_content *content,
+		int *min, int *max)
+{
+	struct grid_ctx ctx;
+	const css_computed_grid_track *tmpl;
+	uint8_t flow;
+	unsigned i;
+	bool ok = false;
+
+	memset(&ctx, 0, sizeof(ctx));
+	/* nothing is laid out here, so no content to lay out into */
+	ctx.content = NULL;
+	ctx.unit_len_ctx = &content->unit_len_ctx;
+	ctx.grid = grid;
+	/* the widths it takes at no width and at any width */
+	ctx.avail_w = AUTO;
+	ctx.avail_h = AUTO;
+	ctx.col_gap = grid_gap(&ctx, css_computed_column_gap_px, AUTO);
+	ctx.row_gap = grid_gap(&ctx, css_computed_row_gap_px, AUTO);
+
+	flow = css_computed_grid_auto_flow(grid->style);
+	ctx.column_flow = (flow == CSS_GRID_AUTO_FLOW_COLUMN ||
+			flow == CSS_GRID_AUTO_FLOW_COLUMN_DENSE);
+	ctx.dense = (flow == CSS_GRID_AUTO_FLOW_ROW_DENSE ||
+			flow == CSS_GRID_AUTO_FLOW_COLUMN_DENSE);
+
+	/* a subgrid's columns are its parent's: not known here */
+	tmpl = NULL;
+	if (css_computed_grid_template_columns(grid->style, &tmpl) !=
+			CSS_GRID_TEMPLATE_SET) {
+		tmpl = NULL;
+	}
+	if (grid_tmpl_is_subgrid(tmpl) ||
+	    !grid_build_explicit(&ctx, tmpl, AUTO, ctx.col_gap,
+			&ctx.cols, &ctx.n_explicit_cols, &ctx.col_names,
+			&ctx.n_col_names)) {
+		goto cleanup;
+	}
+	tmpl = NULL;
+	if (css_computed_grid_template_rows(grid->style, &tmpl) !=
+			CSS_GRID_TEMPLATE_SET || grid_tmpl_is_subgrid(tmpl)) {
+		tmpl = NULL;
+	}
+	if (!grid_build_explicit(&ctx, tmpl, AUTO, ctx.row_gap,
+			&ctx.rows, &ctx.n_explicit_rows, &ctx.row_names,
+			&ctx.n_row_names)) {
+		goto cleanup;
+	}
+	grid_read_areas(&ctx);
+	if (!grid_collect_items(&ctx) || !grid_place_items(&ctx) ||
+	    !grid_extend_tracks(&ctx, true) ||
+	    !grid_extend_tracks(&ctx, false)) {
+		goto cleanup;
+	}
+	grid_collapse_empty(&ctx, true);
+	if (!grid_size_axis(&ctx, true)) {
+		goto cleanup;
+	}
+	/* at its narrowest each column is its base size; at its widest,
+	 * its growth limit, which is the widest of its items' content */
+	*min = *max = ctx.col_gap * grid_gap_count(ctx.cols, ctx.n_cols);
+	for (i = 0; i < ctx.n_cols; i++) {
+		const struct grid_track *t = &ctx.cols[i];
+
+		if (t->collapsed) {
+			continue;
+		}
+		*min += t->base;
+		*max += (t->limit == GRID_INF || t->limit < t->base) ?
+				t->base : t->limit;
+	}
+	ok = true;
+
+cleanup:
+	grid_ctx_destroy(&ctx);
+	return ok;
+}
