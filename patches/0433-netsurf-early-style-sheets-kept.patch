+ * waiting to be converted parsed again from its text: those are every
+ * one a long script adds, since the conversions wait for the scheduler,
+ * and reddit.com's computed style reads took 1.6 s each, 19% of its
+ * script. A sheet is kept while its element's text is what it was
+ * parsed from, and let go by the first build that does not use it.
+ */
+struct html_early_sheet {
+	struct dom_node *node;
+	char *text;
+	size_t len;
+	css_stylesheet *sheet;
+	bool used;
+};
+
+static void early_sheet_free(struct html_early_sheet *e)
+{
+	css_stylesheet_destroy(e->sheet);
+	free(e->text);
+	dom_node_unref(e->node);
+}
+
+/** The element's sheet parsed from this text, kept or parsed now. */
+static css_stylesheet *early_sheet(html_content *c, struct dom_node *node,
+		const uint8_t *data, size_t len)
+{
+	struct html_early_sheet *e;
+	css_stylesheet *sheet;
+	unsigned int k;
+
+	for (k = 0; k < c->early_cache_n; k++) {
+		e = &c->early_cache[k];
+		if (e->node != node)
+			continue;
+		if (e->len == len && memcmp(e->text, data, len) == 0) {
+			e->used = true;
+			return e->sheet;
+		}
+		/* its text changed: no context holds the old sheet, as the
+		 * last one was dropped before this build */
+		early_sheet_free(e);
+		c->early_cache[k] = c->early_cache[--c->early_cache_n];
+		break;
+	}
+
+	sheet = html_css_parse_now(c, data, len);
+	if (sheet == NULL)
+		return NULL;
+	if (c->early_cache_n == c->early_cache_alloc) {
+		unsigned int n = c->early_cache_alloc ?
+				c->early_cache_alloc * 2 : 16;
+		struct html_early_sheet *grown = realloc(c->early_cache,
+				n * sizeof(*grown));
+
+		if (grown == NULL) {
+			css_stylesheet_destroy(sheet);
+			return NULL;
+		}
+		c->early_cache = grown;
+		c->early_cache_alloc = n;
+	}
+	e = &c->early_cache[c->early_cache_n];
+	e->text = malloc(len > 0 ? len : 1);
+	if (e->text == NULL) {
+		css_stylesheet_destroy(sheet);
+		return NULL;
+	}
+	memcpy(e->text, data, len);
+	e->len = len;
+	e->node = dom_node_ref(node);
+	e->sheet = sheet;
+	e->used = true;
+	c->early_cache_n++;
+	return sheet;
+}
