@@ -2453,3 +2467,89 @@ bool attributes_equal(void *p1, void *p2)
 }
 /*------------------ End of namednodemap functions -----------------------*/
 
+/*
+ * The same walks, going on from the top of a shadow tree to its host
+ * (VitaSurf): for a selector a shadow tree's own rules were rewritten
+ * into, which names the host. A page's own rules use the walks above,
+ * which stop at a shadow root, as they stop at the top of a
+ * document.
+ */
+dom_exception dom_element_named_ancestor_node_cross(dom_element *element,
+		lwc_string *name, dom_element **ancestor)
+{
+	dom_node_internal *node = (dom_node_internal *)element;
+
+	*ancestor = NULL;
+
+	/* within the tree, then into the host of the first shadow root
+	 * on the way, only when it is the one named: a shadow tree's
+	 * rules reach their own host, not the host of a tree around it */
+	for (node = node->parent; node != NULL; node = node->parent) {
+		if (node->type == DOM_DOCUMENT_FRAGMENT_NODE) {
+			dom_node_internal *host = (dom_node_internal *)
+				_dom_document_fragment_host(
+					(dom_document_fragment *) node);
+
+			if (host != NULL && host->name != NULL &&
+					dom_string_caseless_lwc_isequal(
+						host->name, name))
+				*ancestor = (dom_element *)
+					dom_node_ref(host);
+			break;
+		}
+		if (node->type != DOM_ELEMENT_NODE)
+			continue;
+
+		assert(node->name != NULL);
+
+		if (dom_string_caseless_lwc_isequal(node->name, name)) {
+			*ancestor = (dom_element *)dom_node_ref(node);
+			break;
+		}
+	}
+
+	return DOM_NO_ERR;
+}
+
+dom_exception dom_element_named_parent_node_cross(dom_element *element,
+		lwc_string *name, dom_element **parent)
+{
+	dom_node_internal *node = (dom_node_internal *)element;
+
+	*parent = NULL;
+
+	for (node = _dom_node_flat_parent(node); node != NULL;
+			node = _dom_node_flat_parent(node)) {
+		if (node->type != DOM_ELEMENT_NODE)
+			continue;
+
+		assert(node->name != NULL);
+
+		if (dom_string_caseless_lwc_isequal(node->name, name)) {
+			*parent = (dom_element *)dom_node_ref(node);
+		}
+		break;
+	}
+
+	return DOM_NO_ERR;
+}
+
+dom_exception dom_element_parent_node_cross(dom_element *element,
+		dom_element **parent)
+{
+	dom_node_internal *node = (dom_node_internal *)element;
+
+	*parent = NULL;
+
+	for (node = _dom_node_flat_parent(node); node != NULL;
+			node = _dom_node_flat_parent(node)) {
+		if (node->type != DOM_ELEMENT_NODE)
+			continue;
+
+		*parent = (dom_element *)dom_node_ref(node);
+		break;
+	}
+
+	return DOM_NO_ERR;
+}
+
