 #ifndef dom_core_documentfragment_h_
 #define dom_core_documentfragment_h_
 
+#include <stdbool.h>
+
+#include <dom/core/exceptions.h>
+
 typedef struct dom_document_fragment dom_document_fragment;
 
+struct dom_element;
+
+/*
+ * Shadow roots (VitaSurf). A shadow root is a document fragment that an
+ * element holds as its shadow tree. Its children are a tree of their own:
+ * the fragment has no parent, so the DOM's own walks stop at it. Only the
+ * walks that build the page -- selector matching and the event path --
+ * go on from it to its host.
+ */
+dom_exception dom_element_attach_shadow(struct dom_element *element,
+		bool closed, dom_document_fragment **root);
+dom_exception dom_element_get_shadow_root(struct dom_element *element,
+		dom_document_fragment **root);
+dom_exception dom_document_fragment_get_host(dom_document_fragment *frag,
+		struct dom_element **host);
+bool dom_document_fragment_is_closed(dom_document_fragment *frag);
+
 #endif
