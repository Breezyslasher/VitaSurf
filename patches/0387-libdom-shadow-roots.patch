diff --git a/src/core/doc_fragment.c b/src/core/doc_fragment.c
index 9e10a1a..d781b4f 100644
--- a/src/core/doc_fragment.c
+++ b/src/core/doc_fragment.c
@@ -12,6 +12,7 @@
 
 #include "core/document.h"
 #include "core/doc_fragment.h"
+#include "core/element.h"
 #include "core/node.h"
 #include "utils/utils.h"
 
@@ -20,6 +21,9 @@
  */
 struct dom_document_fragment {
 	dom_node_internal base;		/**< Base node */
+	/** the element whose shadow root this is, unowned (VitaSurf) */
+	struct dom_element *shadow_host;
+	bool shadow_closed;		/**< attached with mode "closed" */
 };
 
 static const struct dom_node_vtable df_vtable = {
@@ -60,6 +64,8 @@ dom_exception _dom_document_fragment_create(dom_document *doc,
 
 	f->base.base.vtable = &df_vtable;
 	f->base.vtable = &df_protect_vtable;
+	f->shadow_host = NULL;
+	f->shadow_closed = false;
 
 	/* And initialise the node */
 	err = _dom_document_fragment_initialise(&f->base, doc, 
@@ -115,9 +121,106 @@ dom_exception _dom_df_copy(dom_node_internal *old, dom_node_internal **copy)
 		free(new_f);
 		return err;
 	}
+	/* a copy of a shadow root is no element's shadow root */
+	new_f->shadow_host = NULL;
+	new_f->shadow_closed = false;
 
 	*copy = (dom_node_internal *) new_f;
 
 	return DOM_NO_ERR;
 }
 
+
+/*-----------------------------------------------------------------------*/
+
+/* Shadow roots (VitaSurf) */
+
+struct dom_element *_dom_document_fragment_host(
+		const dom_document_fragment *frag)
+{
+	return frag->shadow_host;
+}
+
+void _dom_document_fragment_drop_host(dom_document_fragment *frag)
+{
+	frag->shadow_host = NULL;
+}
+
+/**
+ * Give an element a shadow root
+ *
+ * \param element  The element, which has none yet
+ * \param closed   Whether the root was asked for with mode "closed"
+ * \param root     Pointer to location to receive the root, referenced
+ * 
+eturn DOM_NO_ERR, DOM_NOT_SUPPORTED_ERR if the element has one, or
+ *         DOM_NO_MEM_ERR.
+ *
+ * The element holds the root for as long as it lives; the root names the
+ * element as its host until then.
+ */
+dom_exception dom_element_attach_shadow(struct dom_element *element,
+		bool closed, dom_document_fragment **root)
+{
+	dom_node_internal *el = (dom_node_internal *) element;
+	dom_document_fragment *f = NULL;
+	dom_exception err;
+
+	*root = NULL;
+	if (element->shadow_root != NULL)
+		return DOM_NOT_SUPPORTED_ERR;
+
+	err = _dom_document_create_document_fragment(el->owner, &f);
+	if (err != DOM_NO_ERR)
+		return err;
+
+	f->shadow_host = element;
+	f->shadow_closed = closed;
+	/* the element's reference, given back when it goes */
+	element->shadow_root = f;
+	*root = (dom_document_fragment *) dom_node_ref(f);
+
+	return DOM_NO_ERR;
+}
+
+/**
+ * An element's shadow root, open or closed
+ *
+ * \param element  The element
+ * \param root     Pointer to location to receive the root, referenced,
+ *                 or NULL when it has none
+ * 
+eturn DOM_NO_ERR.
+ */
+dom_exception dom_element_get_shadow_root(struct dom_element *element,
+		dom_document_fragment **root)
+{
+	*root = element->shadow_root;
+	if (*root != NULL)
+		dom_node_ref(*root);
+	return DOM_NO_ERR;
+}
+
+/**
+ * The host of a shadow root
+ *
+ * \param frag  The fragment
+ * \param host  Pointer to location to receive the host, referenced, or
+ *              NULL when the fragment is no shadow root or its host is
+ *              gone
+ * 
+eturn DOM_NO_ERR.
+ */
+dom_exception dom_document_fragment_get_host(dom_document_fragment *frag,
+		struct dom_element **host)
+{
+	*host = frag->shadow_host;
+	if (*host != NULL)
+		dom_node_ref(*host);
+	return DOM_NO_ERR;
+}
+
+bool dom_document_fragment_is_closed(dom_document_fragment *frag)
+{
+	return frag->shadow_closed;
+}
