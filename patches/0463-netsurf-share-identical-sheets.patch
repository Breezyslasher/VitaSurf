+/*
+ * Sheets parsed from text, kept by it so that a content with the same
+ * text takes the parse instead of making its own (VitaSurf). As Chrome
+ * shares the parsed contents of identical inline style sheets: BBC's
+ * page put the same 328 KB sheet into seventeen STYLE elements, and
+ * each was parsed afresh, 500 to 760 ms apiece, and old.reddit's login
+ * page the same sheet seven times. A sheet is shared only when its
+ * text, base URL, charset and quirks are the same, it imports nothing,
+ * and any root hints its parse used are the document's now; it is
+ * destroyed when the last content holding it goes.
+ */
+#define NSCSS_SHARE_MIN 2048
+#define NSCSS_SHARE_BUCKETS 64
+
+struct nscss_shared {
+	struct nscss_shared *next;
+	css_stylesheet *sheet;
+	unsigned int refs;
+	uint32_t hash;
+	size_t len;
+	uint8_t *text;
+	char *base;
+	char *charset;
+	bool quirks;
+	uint32_t root_hints;
+};
+
+static struct nscss_shared *nscss_share_table[NSCSS_SHARE_BUCKETS];
+
+
+static uint32_t nscss_share_hash(const uint8_t *d, size_t n)
+{
+	uint32_t h = 2166136261u;
+	size_t i, step = n > 65536 ? n / 16384 : 1;
+
+	/* a sample of a long text, all of a short one; the whole text is
+	 * compared before a match is taken */
+	for (i = 0; i < n; i += step)
+		h = (h ^ d[i]) * 16777619u;
+	return h ^ (uint32_t) n;
+}
+
+static bool nscss_share_same_str(const char *a, const char *b)
+{
+	if (a == NULL || b == NULL)
+		return a == b;
+	return strcmp(a, b) == 0;
+}
+
+/** The kept parse for this text and setting, or NULL. */
+static struct nscss_shared *nscss_share_find(const uint8_t *data,
+		size_t len, const char *base, const char *charset, bool quirks)
+{
+	uint32_t h = nscss_share_hash(data, len);
+	struct nscss_shared *e;
+
+	for (e = nscss_share_table[h % NSCSS_SHARE_BUCKETS]; e != NULL;
+			e = e->next) {
+		if (e->hash != h || e->len != len || e->quirks != quirks ||
+				!nscss_share_same_str(e->base, base) ||
+				!nscss_share_same_str(e->charset, charset))
+			continue;
+		if (e->root_hints != 0 &&
+				e->root_hints != css_root_hints_signature())
+			continue;
+		if (memcmp(e->text, data, len) != 0)
+			continue;
+		return e;
+	}
+	return NULL;
+}
+
+/** Keep a content's parse for others; false if it cannot be kept. */
+static struct nscss_shared *nscss_share_add(css_stylesheet *sheet,
+		const uint8_t *data, size_t len, const char *base,
+		const char *charset, bool quirks, uint32_t root_hints)
+{
+	struct nscss_shared *e = calloc(1, sizeof(*e));
+	uint32_t h;
+
+	if (e == NULL)
+		return NULL;
+	e->text = malloc(len);
+	e->base = base != NULL ? strdup(base) : NULL;
+	e->charset = charset != NULL ? strdup(charset) : NULL;
+	if (e->text == NULL || (base != NULL && e->base == NULL) ||
+			(charset != NULL && e->charset == NULL)) {
+		free(e->text);
+		free(e->base);
+		free(e->charset);
+		free(e);
+		return NULL;
+	}
+	memcpy(e->text, data, len);
+	h = nscss_share_hash(data, len);
+	e->hash = h;
+	e->len = len;
+	e->sheet = sheet;
+	e->refs = 1;
+	e->quirks = quirks;
+	e->root_hints = root_hints;
+	e->next = nscss_share_table[h % NSCSS_SHARE_BUCKETS];
+	nscss_share_table[h % NSCSS_SHARE_BUCKETS] = e;
+	return e;
+}
+
+/** Let go of a content's hold on a kept parse. */
+static void nscss_share_release(struct nscss_shared *e)
+{
+	struct nscss_shared **pp;
+
+	if (--e->refs > 0)
+		return;
+	for (pp = &nscss_share_table[e->hash % NSCSS_SHARE_BUCKETS];
+			*pp != NULL; pp = &(*pp)->next) {
+		if (*pp == e) {
+			*pp = e->next;
+			break;
+		}
+	}
+	css_stylesheet_destroy(e->sheet);
+	free(e->text);
+	free(e->base);
+	free(e->charset);
+	free(e);
+}
