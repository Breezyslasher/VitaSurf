+			size >= NSCSS_SHARE_MIN) {
+		const uint8_t *data = content__get_source_data(c, &size);
+		const char *base = NULL;
+
+		if (data != NULL && css_stylesheet_get_url(css->data.sheet,
+				&base) == CSS_OK &&
