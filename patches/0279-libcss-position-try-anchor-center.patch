+/******************************************************************************
+ * @position-try (VitaSurf)                                                    *
+ ******************************************************************************/
+
+/*
+ * The @position-try rules the sheets have given, by name: what is in
+ * each block, as written. A later rule of a name replaces an earlier
+ * one. The client reads them when a box names one in
+ * position-try-fallbacks; libcss has nothing to cascade them into.
+ */
+#define POSITION_TRY_MAX 128
+
+static struct {
+	char name[64];
+	char *text;
+} position_try[POSITION_TRY_MAX];
+static unsigned n_position_try;
+
+static void position_try_put(const char *name, size_t nl, const char *body,
+		size_t bl)
+{
+	unsigned i;
+	char *t;
+
+	if (nl == 0 || nl >= sizeof(position_try[0].name))
+		return;
+	t = malloc(bl + 1);
+	if (t == NULL)
+		return;
+	memcpy(t, body, bl);
+	t[bl] = '\0';
+	for (i = 0; i < n_position_try; i++) {
+		if (strlen(position_try[i].name) == nl &&
+				memcmp(position_try[i].name, name, nl) == 0) {
+			free(position_try[i].text);
+			position_try[i].text = t;
+			return;
+		}
+	}
+	if (n_position_try == POSITION_TRY_MAX) {
+		free(t);
+		return;
+	}
+	memcpy(position_try[n_position_try].name, name, nl);
+	position_try[n_position_try].name[nl] = '\0';
+	position_try[n_position_try].text = t;
+	n_position_try++;
+}
+
+/* exported interface documented in parse/nesting.h */
+void css__note_position_try(const char *src, size_t len)
+{
+	size_t i = 0;
+
+	while (i + 13 < len) {
+		const char *at = memchr(src + i, '@', len - i);
+		size_t k, n0, n1, open, close;
+		int depth;
+
+		if (at == NULL)
+			return;
+		i = (size_t) (at - src) + 1;
+		if (len - (i - 1) < 13 ||
+				strncasecmp(at, "@position-try", 13) != 0 ||
+				(i - 1 + 13 < len && (isalnum((unsigned char)
+					at[13]) || at[13] == '-') &&
+				 at[13] != ' '))
+			continue;
+		k = i - 1 + 13;
+		while (k < len && sel_ws(src[k]))
+			k++;
+		n0 = k;
+		while (k < len && !sel_ws(src[k]) && src[k] != '{')
+			k++;
+		n1 = k;
+		while (k < len && src[k] != '{')
+			k++;
+		if (k >= len)
+			return;
+		open = k;
+		depth = 0;
+		for (close = open; close < len; close++) {
+			if (src[close] == '{')
+				depth++;
+			else if (src[close] == '}' && --depth == 0)
+				break;
+		}
+		if (close >= len)
+			return;
+		position_try_put(src + n0, n1 - n0, src + open + 1,
+				close - open - 1);
+		i = close + 1;
+	}
+}
+
+/* exported interface documented in libcss/stylesheet.h */
+const char *css_position_try_rule(const char *name, size_t len)
+{
+	unsigned i;
+
+	for (i = 0; i < n_position_try; i++) {
+		if (strlen(position_try[i].name) == len &&
+				memcmp(position_try[i].name, name, len) == 0)
+			return position_try[i].text;
+	}
+	return NULL;
+}
