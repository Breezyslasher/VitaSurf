--- a/src/select/properties/font_size.c
+++ b/src/select/properties/font_size.c
@@ -13,6 +13,28 @@
 
 #include "select/properties/properties.h"
 #include "select/properties/helpers.h"
+#include "select/mq.h"
+
+/*
+ * A font size in a container's inline-size units, against the element's
+ * nearest container as the last layout left it (VitaSurf): cqw and cqi,
+ * which every kind of container has. The block-size ones need a size
+ * container, which the lookup does not tell apart, and keep their
+ * viewport meaning, as everything does while a container's size is not
+ * known. Asking notes that the page's styles hang on its containers, so
+ * they are chosen again once the layout has measured them.
+ */
+static bool font_size_from_container(uint32_t raw, css_fixed *value)
+{
+	css_fixed width = 0, height = 0;
+
+	if (raw != UNIT_CQW && raw != UNIT_CQI)
+		return false;
+	if (mq__container_size(NULL, &width, &height) != 1 || width <= 0)
+		return false;
+	*value = FDIV(FMUL(*value, width), F_100);
+	return true;
+}
 
