diff --git a/content/hlcache.c b/content/hlcache.c
index 545b28e87..08f1cabc6 100644
--- a/content/hlcache.c
+++ b/content/hlcache.c
@@ -160,6 +160,40 @@ static void hlcache_clean(void *force_clean_flag)
 	guit->misc->schedule(hlcache->params.bg_clean_time, hlcache_clean, NULL);
 }
 
+/* exported interface documented in content/hlcache.h */
+void hlcache_size_report(struct hlcache_size_report *r)
+{
+	hlcache_entry *entry;
+
+	memset(r, 0, sizeof(*r));
+	if (hlcache == NULL) {
+		return;
+	}
+	for (entry = hlcache->content_list; entry != NULL; entry = entry->next) {
+		unsigned int sz;
+		content_type type;
+
+		if (entry->content == NULL) {
+			continue;
+		}
+		sz = entry->content->size;
+		type = entry->content->handler->type();
+		r->total_bytes += sz;
+		r->count++;
+		if (content_count_users(entry->content) == 0) {
+			r->unused_bytes += sz;
+			r->unused_count++;
+		}
+		switch (type) {
+		case CONTENT_CSS:	r->css_bytes += sz; r->css_count++; break;
+		case CONTENT_HTML:	r->html_bytes += sz; r->html_count++; break;
+		case CONTENT_IMAGE:	r->image_bytes += sz; r->image_count++; break;
+		default:		r->other_bytes += sz; r->other_count++; break;
+		}
+	}
+}
+
