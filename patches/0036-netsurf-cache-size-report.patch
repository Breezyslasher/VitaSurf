diff --git a/content/hlcache.h b/content/hlcache.h
index 986bdd3f4..cea697e49 100644
--- a/content/hlcache.h
+++ b/content/hlcache.h
@@ -45,6 +45,26 @@ typedef struct hlcache_event {
 	union content_msg_data data;	/**< Event data */
 } hlcache_event;
 
+/**
+ * What the high-level cache is holding, by content type (VitaSurf).
+ *
+ * memory_cache_size bounds the low-level cache's source data, not the
+ * parsed representations the high-level cache keeps -- a page's parsed
+ * stylesheets outweigh their source several times over. Reporting both
+ * the total and the part with no users left says whether memory that
+ * stayed behind after a navigation is still in use or merely uncollected.
+ */
+struct hlcache_size_report {
+	unsigned int total_bytes, count;
+	unsigned int unused_bytes, unused_count;
+	unsigned int css_bytes, css_count;
+	unsigned int html_bytes, html_count;
+	unsigned int image_bytes, image_count;
+	unsigned int other_bytes, other_count;
+};
+
+void hlcache_size_report(struct hlcache_size_report *r);
+
 struct hlcache_parameters {
 	/** How frequently the background cache clean process is run (ms) */
 	unsigned int bg_clean_time;
