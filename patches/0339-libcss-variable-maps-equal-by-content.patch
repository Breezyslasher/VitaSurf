diff --git a/src/select/arena.c b/src/select/arena.c
index 2cefd04..0709a46 100644
--- a/src/select/arena.c
+++ b/src/select/arena.c
@@ -13,6 +13,7 @@
 
 #include "select/arena_hash.h"
 #include "select/computed.h"
+#include "select/custom.h"
 #include "select/autogenerated_overlay.h"
 
 #define TU_SIZE 3037
@@ -31,7 +32,7 @@ static inline uint32_t css__arena_hash_style(struct css_computed_style *s)
 	 * new style against 28 others, each comparison a memcmp of the
 	 * whole block before the pointer that told them apart.
 	 */
-	uint32_t c = (uint32_t) ((uintptr_t) s->custom >> 4);
+	uint32_t c = css__custom_map_sig(s->custom);
 
 	return h ^ (c * 0x9e3779b1u);
 }
@@ -152,7 +153,9 @@ static inline bool css__arena_style_is_equal(
 	 * this is a pointer comparison nearly every time -- and so it
 	 * goes before the memcmp of the whole block.
 	 */
-	if (a->custom != b->custom) {
+	if (a->custom != b->custom &&
+			css__custom_map_sig(a->custom) !=
+			css__custom_map_sig(b->custom)) {
 		return false;
 	}
 
@@ -226,6 +229,13 @@ static inline bool css__arena_style_is_equal(
 		return false;
 	}
 
+	/* maps that hash alike are compared entry by entry, last, as the
+	 * dearest test (VitaSurf) */
+	if (a->custom != b->custom &&
+			!css__custom_map_equal(a->custom, b->custom)) {
+		return false;
+	}
+
 	return true;
 }
 
diff --git a/src/select/custom.c b/src/select/custom.c
index a3c9e8c..191d208 100644
--- a/src/select/custom.c
+++ b/src/select/custom.c
@@ -227,6 +227,67 @@ css_error css__custom_map_set(css_custom_map **map, lwc_string *name,
 	e->n_tokens = n_tokens;
 	e->specificity = specificity;
 	e->important = important;
+	(*map)->sig_valid = false;
 
 	return CSS_OK;
 }
+
+uint32_t css__custom_map_sig(css_custom_map *map)
+{
+	uint32_t h, i;
+
+	if (map == NULL)
+		return 0;
+	if (map->sig_valid)
+		return map->sig;
+
+	/* a sum, so the order the slots hold them in does not matter */
+	h = 0;
+	for (i = 0; i < map->n_slots; i++) {
+		const css_custom_entry *e = &map->slots[i];
+		uint32_t x;
+
+		if (e->name == NULL)
+			continue;
+		x = (uint32_t) ((uintptr_t) e->name >> 4) * 0x9e3779b1u;
+		x ^= (uint32_t) ((uintptr_t) e->tokens >> 3) * 0x85ebca6bu;
+		x ^= e->n_tokens * 0xc2b2ae35u;
+		if (e->important)
+			x ^= 0x27d4eb2fu;
+		h += x;
+	}
+	h ^= map->count * 0x165667b1u;
+	h = h * 31u + css__custom_map_sig(map->parent);
+
+	map->sig = h;
+	map->sig_valid = true;
+	return h;
+}
+
+bool css__custom_map_equal(css_custom_map *a, css_custom_map *b)
+{
+	uint32_t i;
+
+	if (a == b)
+		return true;
+	if (a == NULL || b == NULL)
+		return false;
+	if (a->count != b->count ||
+			css__custom_map_sig(a) != css__custom_map_sig(b))
+		return false;
+	if (!css__custom_map_equal(a->parent, b->parent))
+		return false;
+	for (i = 0; i < a->n_slots; i++) {
+		const css_custom_entry *e = &a->slots[i];
+		const css_custom_entry *f;
+
+		if (e->name == NULL)
+			continue;
+		f = _find_own(b, e->name);
+		if (f == NULL || f->tokens != e->tokens ||
+				f->n_tokens != e->n_tokens ||
+				f->important != e->important)
+			return false;
+	}
+	return true;
+}
diff --git a/src/select/custom.h b/src/select/custom.h
index 595ec6a..6d0a7d0 100644
--- a/src/select/custom.h
+++ b/src/select/custom.h
@@ -42,6 +42,8 @@ typedef struct css_custom_map {
 	uint32_t n_slots;		/**< a power of two, or 0 */
 	css_custom_entry *slots;	/**< open addressed by name */
 	struct css_custom_map *parent;	/**< the inherited map, a ref */
+	uint32_t sig;			/**< css__custom_map_sig(), once known */
+	bool sig_valid;
 } css_custom_map;
 
 css_custom_map *css__custom_map_ref(css_custom_map *map);
@@ -81,4 +83,21 @@ const css_custom_entry *css__custom_map_get_own(const css_custom_map *map,
 /** Make the map one this element alone writes to. */
 css_error css__custom_map_own(css_custom_map **map);
 
+/**
+ * A hash of what a map holds, and what the maps above it hold
+ * (VitaSurf): the same for two maps built from the same declarations,
+ * whatever their addresses. Kept in the map once worked out.
+ */
+uint32_t css__custom_map_sig(css_custom_map *map);
+
+/**
+ * Whether two maps give every variable the same value (VitaSurf): the
+ * same declarations, by the rule that made them, here and above. The
+ * root's map is made afresh each time it is selected, so the root of a
+ * page that declares its design tokens there came out a different style
+ * on every reselection -- and so did every element under it, which
+ * inherits the map -- and a change of :hover restyled the whole page.
+ */
+bool css__custom_map_equal(css_custom_map *a, css_custom_map *b);
+
 #endif
