 			error = _insert_into_chain(hash,
 					&hash->attrs.slots[index], selector);
+			if (error == CSS_OK)
+				hash->attrs.n_entries++;
 			css_hash_in_attr++;
 
 			return error;
@@ -808,8 +810,11 @@ css_error css__selector_hash_remove(css_selector_hash *hash,
 			mask = hash->attrs.n_slots - 1;
 			index = key & mask;
 
-			return _remove_from_chain(hash,
+			error = _remove_from_chain(hash,
 					&hash->attrs.slots[index], selector);
