 		/* Universal chain */
 		error = _remove_from_chain(hash,
@@ -1787,3 +1792,26 @@ css_error _iterate_universal(
 	return CSS_OK;
 }
 
+
+/* exported: see select/hash.h (VitaSurf) */
+uint32_t css__selector_hash_tables(const css_selector_hash *hash)
+{
+	uint32_t mask = 0;
+
+	if (hash == NULL)
+		return 0;
+	if (hash->elements.n_entries != 0)
+		mask |= CSS_HASH_HAS_ELEMENTS;
+	if (hash->classes.n_entries != 0)
+		mask |= CSS_HASH_HAS_CLASSES;
+	if (hash->ids.n_entries != 0)
+		mask |= CSS_HASH_HAS_IDS;
+	if (hash->attrs.n_entries != 0)
+		mask |= CSS_HASH_HAS_ATTRS;
+	if (hash->universal.sel != NULL)
+		mask |= CSS_HASH_HAS_UNIVERSAL;
+	if (hash->universal_state.sel != NULL)
+		mask |= CSS_HASH_HAS_STATE;
+
+	return mask;
+}
diff --git a/src/select/hash.h b/src/select/hash.h
index 5f4b527..37e1f96 100644
--- a/src/select/hash.h
+++ b/src/select/hash.h
@@ -167,5 +167,23 @@ css_error css__selector_hash_find_by_attr(css_selector_hash *hash,
 
 css_error css__selector_hash_size(css_selector_hash *hash, size_t *size);
 
+/*
+ * Which of a sheet's tables hold anything at all (VitaSurf).
+ *
+ * A sheet visit asks each table for the node's chains -- one find per
+ * class, one per attribute bucket, one each for the element, the id,
+ * the universal chain and the state chain -- and a GitHub page makes
+ * 2,565,620 visits over sheets that are mostly small, so most of those
+ * finds reach an empty table. One word says which to skip, and a
+ * sheet with nothing in it is skipped whole.
+ */
+#define CSS_HASH_HAS_ELEMENTS	(1u << 0)
+#define CSS_HASH_HAS_CLASSES	(1u << 1)
+#define CSS_HASH_HAS_IDS	(1u << 2)
+#define CSS_HASH_HAS_ATTRS	(1u << 3)
+#define CSS_HASH_HAS_UNIVERSAL	(1u << 4)
+#define CSS_HASH_HAS_STATE	(1u << 5)
+uint32_t css__selector_hash_tables(const css_selector_hash *hash);
+
 #endif
 
