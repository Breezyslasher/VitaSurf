--- a/content/handlers/css/utils.h
+++ b/content/handlers/css/utils.h
@@ -148,4 +148,22 @@ static inline uint8_t ns_computed_min_width_px(
 	return value;
 }
 
+/**
+ * A held math function (CSS_UNIT_EXPR) in device pixels (VitaSurf), with
+ * what a percentage in it is of, already in device pixels at \a scale;
+ * -1 when there is nothing. The lengths in it are scaled, as the caller
+ * scales the ones it converts with css_unit_len2device_px().
+ */
+static inline int ns_expr_device_px(const css_computed_style *style,
+		const css_unit_ctx *unit_len_ctx, css_fixed id, int basis,
+		float scale)
+{
+	int px = 0;
+
+	if (!css_computed_expr_px(style, unit_len_ctx,
+			basis < 0 ? -1 : (int) (basis / scale), id, &px))
+		return 0;
+	return (int) (px * scale);
+}
+
 #endif
