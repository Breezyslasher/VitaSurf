  */
 extern const char *vitasurf_languages(void) __attribute__((weak));
 
+/**
+ * How far a VitaSurf counter moved since an earlier reading of it. The
+ * counters go back to zero when a page starts loading, which can happen
+ * in the middle of the span being measured (a frame navigating inside a
+ * timed callback), so a reading below the earlier one counts from the
+ * reset rather than wrapping round to four thousand million (VitaSurf).
+ */
+static inline unsigned int vitasurf_since(unsigned int now, unsigned int then)
+{
+	return now >= then ? now - then : now;
+}
