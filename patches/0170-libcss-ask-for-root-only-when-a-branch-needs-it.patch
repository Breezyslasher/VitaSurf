+/**
+ * Whether this node is not the root, asking at most once (VitaSurf).
+ *
+ * Used by NOT_ROOT() below so that a pseudo-class which does not care
+ * never asks. A failure is remembered in \a err for the caller to
+ * return, and is treated as "not the root" so the chain still reaches a
+ * branch rather than matching one it should not.
+ */
+static bool detail_not_root(css_select_state *state, void *node,
+		bool *is_root, bool *known, css_error *err)
+{
+	if (*known == false) {
+		*err = state->handler->node_is_root(state->pw, node, is_root);
+		if (*err != CSS_OK)
+			*is_root = false;
+		*known = true;
+	}
+
+	return *is_root == false;
+}
