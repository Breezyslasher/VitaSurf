+			return;
+		if (dom_element_has_attribute(n, corestring_dom_reversed,
+				&reversed) != DOM_NO_ERR)
+			reversed = false;
+		if (dom_element_has_attribute(n, corestring_dom_start,
+				&has) != DOM_NO_ERR)
+			has = false;
+		if (has && dom_html_olist_element_get_start(
+				(dom_html_olist_element *) n, &start) !=
+				DOM_NO_ERR)
+			has = false;
+
+		if (reversed) {
+			if (!has) {
+				/* the number of items: reversed(list-item)
+				 * counts down to 1 */
+				dom_node *child = NULL, *next;
+				dom_html_element_type ct;
+				dom_node_type nt;
+
+				start = 0;
+				if (dom_node_get_first_child(n, &child) !=
+						DOM_NO_ERR)
+					child = NULL;
+				while (child != NULL) {
+					if (dom_node_get_node_type(child,
+							&nt) == DOM_NO_ERR &&
+							nt == DOM_ELEMENT_NODE &&
+							dom_html_element_get_tag_type(
+							child, &ct) ==
+							DOM_NO_ERR && ct ==
