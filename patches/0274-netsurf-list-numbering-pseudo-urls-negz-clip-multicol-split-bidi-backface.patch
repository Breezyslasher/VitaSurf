+/* exported interface documented in html/bidi.h */
+unsigned int html_bidi_strength(const char *text, size_t len)
+{
+	const unsigned char *p = (const unsigned char *) text;
+	unsigned int out = 0;
+	size_t i = 0;
+
+	while (i < len && out != (HTML_BIDI_HAS_L | HTML_BIDI_HAS_R)) {
+		uint32_t c = p[i];
+		enum bidi_class k;
+
+		if (c < 0x80) {
+			i++;
+		} else if (c >= 0xf0 && i + 3 < len) {
+			c = ((c & 0x07) << 18) | ((p[i + 1] & 0x3f) << 12) |
+					((p[i + 2] & 0x3f) << 6) |
+					(p[i + 3] & 0x3f);
+			i += 4;
+		} else if (c >= 0xe0 && i + 2 < len) {
+			c = ((c & 0x0f) << 12) | ((p[i + 1] & 0x3f) << 6) |
+					(p[i + 2] & 0x3f);
+			i += 3;
+		} else if (c >= 0xc0 && i + 1 < len) {
+			c = ((c & 0x1f) << 6) | (p[i + 1] & 0x3f);
+			i += 2;
+		} else {
+			i++;
+			continue;
+		}
+		k = bidi_class_of(c);
+		if (k == BC_L)
+			out |= HTML_BIDI_HAS_L;
+		else if (k == BC_R || k == BC_AL)
+			out |= HTML_BIDI_HAS_R;
+	}
+	return out;
+}
+
+
+/* exported interface documented in html/bidi.h */
+size_t html_bidi_override(const char *text, size_t len, const char **out)
+{
+	unsigned int n, i;
+	bool any_arabic = false;
+
+	if (len == 0)
+		return 0;
+	n = bidi_decode(text, len);
+	if (n > BIDI_MAX)
+		return 0;
+	for (i = 0; i < n; i++) {
+		if (bidi_class_of(bidi_cp[i]) == BC_AL)
+			any_arabic = true;
+	}
+	if (any_arabic)
+		n = bidi_arabic_shape(n);
+
+	/* every character right to left: the run reversed, its brackets
+	 * facing the other way */
+	for (i = 0; i < n / 2; i++) {
+		uint32_t t = bidi_cp[i];
+
+		bidi_cp[i] = bidi_cp[n - 1 - i];
+		bidi_cp[n - 1 - i] = t;
+	}
+	for (i = 0; i < n; i++)
+		bidi_cp[i] = bidi_mirror(bidi_cp[i]);
+
+	{
+		size_t len_out = bidi_encode(n);
+		const char *kept = bidi_keep(bidi_out, len_out);
+
+		if (kept == NULL)
+			return 0;
+		*out = kept;
+		return len_out;
+	}
+}
