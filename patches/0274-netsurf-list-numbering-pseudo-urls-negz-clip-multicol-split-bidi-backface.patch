+/** Most boxes on a line put in bidirectional order (VitaSurf). */
+#define LAYOUT_BIDI_MAX 256
+
+/**
+ * Put a line's boxes in bidirectional order (VitaSurf): a run of boxes
+ * whose text goes the other way from the block's -- right-to-left words
+ * in a left-to-right paragraph, split between elements, or an element
+ * with a direction of its own -- is shown in its own order, the first
+ * of it at its far end, as UAX #9's reordering of levels (L2) does
+ * across a line. Boxes with no letters of either direction, spaces and
+ * the edges of inline elements, go with the run when it is on both
+ * sides of them. What is inside each text box is ordered when it is
+ * drawn.
+ */
+static void layout__bidi_line(struct box *first, struct box *end, bool rtl)
+{
+	struct box *bx[LAYOUT_BIDI_MAX];
+	int l[LAYOUT_BIDI_MAX], r[LAYOUT_BIDI_MAX];
+	int8_t lv[LAYOUT_BIDI_MAX];	/* 1 raised, 0 base, -1 neutral */
+	unsigned int n = 0, i, j;
+	bool any = false;
+	struct box *d;
+
+	for (d = first; d != end; d = d->next) {
+		int8_t level = -1;
+
+		if (n == LAYOUT_BIDI_MAX)
+			return;
+		if (d->type == BOX_TEXT) {
+			if (d->style != NULL && (css_computed_direction(
+					d->style) == CSS_DIRECTION_RTL) != rtl) {
+				level = 1;
+			} else if (d->text != NULL) {
+				unsigned int k = html_bidi_strength(d->text,
+						d->length);
+				unsigned int other = rtl ? HTML_BIDI_HAS_L :
+						HTML_BIDI_HAS_R;
+
+				if (k == other)
+					level = 1;
+				else if (k != 0)
+					level = 0;
+			}
+			l[n] = d->x;
+			r[n] = d->x + d->width;
+		} else if (d->type == BOX_BR || d->type == BOX_INLINE_END ||
+				(d->type == BOX_INLINE &&
+				 lh__box_is_replace(d) == false)) {
+			l[n] = r[n] = d->x;
+		} else if (d->type == BOX_INLINE ||
+				d->type == BOX_INLINE_BLOCK ||
+				d->type == BOX_INLINE_FLEX) {
+			if (d->style != NULL &&
+					(css_computed_position(d->style) ==
+						CSS_POSITION_ABSOLUTE ||
+					 css_computed_position(d->style) ==
+						CSS_POSITION_FIXED))
+				continue;
+			l[n] = d->x - d->border[LEFT].width - d->margin[LEFT];
+			r[n] = d->x + d->padding[LEFT] + d->width +
+					d->padding[RIGHT] +
+					d->border[RIGHT].width +
+					d->margin[RIGHT];
+		} else {
+			continue;
+		}
+		if (level == 1)
+			any = true;
+		bx[n] = d;
+		lv[n] = level;
+		n++;
+	}
+	if (!any)
+		return;
+
+	/* the boxes with no direction of their own go with what is on
+	 * both sides of them, the base where the sides differ */
+	for (i = 0; i < n; ) {
+		int8_t before, after;
+
+		if (lv[i] >= 0) {
+			i++;
+			continue;
+		}
+		for (j = i; j < n && lv[j] < 0; j++)
+			;
+		before = i > 0 ? lv[i - 1] : 0;
+		after = j < n ? lv[j] : 0;
+		for (; i < j; i++)
+			lv[i] = (before == 1 && after == 1) ? 1 : 0;
+	}
+
+	/* each run of raised boxes, mirrored within the space it takes */
+	for (i = 0; i < n; ) {
+		int a0, a1;
+
+		if (lv[i] != 1) {
+			i++;
+			continue;
+		}
+		a0 = l[i];
+		a1 = r[i];
+		for (j = i; j < n && lv[j] == 1; j++) {
+			if (l[j] < a0) a0 = l[j];
+			if (r[j] > a1) a1 = r[j];
+		}
+		if (j - i > 1) {
+			for (; i < j; i++)
+				bx[i]->x += a0 + a1 - r[i] - l[i];
+		}
+		i = j;
+	}
+}
