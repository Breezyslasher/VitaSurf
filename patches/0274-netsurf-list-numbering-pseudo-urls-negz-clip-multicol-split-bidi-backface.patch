+		if (dom_html_li_element_get_value(
+				(dom_html_li_element *) n, &value) !=
+				DOM_NO_ERR)
+			return;
+		e = box_counter_get(c, corestring_lwc_list_item, scope);
+		if (e != NULL)
+			e->value = value;
