+/*
+ * Values from style attributes (VitaSurf). The attribute's sheet is
+ * freed once its element's style is selected, so the map keeps a copy;
+ * equal values share one, so cards that all say --column-size: 12 keep
+ * one copy and compare equal. Each copy has a serial for the compile
+ * cache, which names a value by its tokens' address: a freed copy's
+ * address is soon another value's, and a cache that took it for the
+ * old one handed every Bubble Card button the colour of the first.
+ */
+#define CUSTOM_INLINE_BUCKETS 256
+
+struct css_custom_inline {
+	struct css_custom_inline *next;
+	uint32_t hash;
+	uint32_t refs;
+	uintptr_t key;			/**< odd, so never an address */
+	uint32_t n;
+	css_token tokens[];
+};
+
+static struct css_custom_inline *_inline_table[CUSTOM_INLINE_BUCKETS];
+static uintptr_t _inline_serial;
+
+static uint32_t _inline_hash(const css_token *t, uint32_t n)
+{
+	uint32_t h = n * 0x9e3779b1u, i;
+
+	for (i = 0; i < n; i++) {
+		h = (h ^ (uint32_t) t[i].type) * 0x01000193u;
+		h = (h ^ (uint32_t) ((uintptr_t) t[i].idata >> 3)) *
+				0x01000193u;
+	}
+	return h;
+}
+
+/* Interned strings make a value equal when its types and strings are. */
+static bool _inline_same(const struct css_custom_inline *v,
+		const css_token *t, uint32_t n)
+{
+	uint32_t i;
+
+	if (v->n != n)
+		return false;
+	for (i = 0; i < n; i++) {
+		if (v->tokens[i].type != t[i].type ||
+				v->tokens[i].idata != t[i].idata)
+			return false;
+	}
+	return true;
+}
+
+static struct css_custom_inline *_inline_get(const css_token *t, uint32_t n)
+{
+	uint32_t h = _inline_hash(t, n), i;
+	struct css_custom_inline **b =
+			&_inline_table[h & (CUSTOM_INLINE_BUCKETS - 1)];
+	struct css_custom_inline *v;
+
+	for (v = *b; v != NULL; v = v->next) {
+		if (v->hash == h && _inline_same(v, t, n)) {
+			v->refs++;
+			return v;
+		}
+	}
+	v = malloc(sizeof(*v) + n * sizeof(css_token));
+	if (v == NULL)
+		return NULL;
+	v->hash = h;
+	v->refs = 1;
+	v->n = n;
+	v->key = (++_inline_serial << 1) | 1;
+	for (i = 0; i < n; i++) {
+		v->tokens[i] = t[i];
+		if (v->tokens[i].idata != NULL)
+			lwc_string_ref(v->tokens[i].idata);
+	}
+	v->next = *b;
+	*b = v;
+	return v;
+}
+
+static void _inline_put(struct css_custom_inline *v)
+{
+	struct css_custom_inline **pp;
+	uint32_t i;
+
+	if (v == NULL || --v->refs > 0)
+		return;
+	for (pp = &_inline_table[v->hash & (CUSTOM_INLINE_BUCKETS - 1)];
+			*pp != NULL; pp = &(*pp)->next) {
+		if (*pp == v) {
+			*pp = v->next;
+			break;
+		}
+	}
+	for (i = 0; i < v->n; i++) {
+		if (v->tokens[i].idata != NULL)
+			lwc_string_unref(v->tokens[i].idata);
+	}
+	free(v);
+}
+
+/** Let go of an entry's interned value, if it has one. */
+static void _drop_tokens(css_custom_entry *e)
+{
+	_inline_put(e->inl);
+	e->inl = NULL;
+	e->key = 0;
+}
