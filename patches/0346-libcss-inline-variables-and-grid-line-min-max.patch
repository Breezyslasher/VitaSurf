+ * card min(var(--column-size,1), var(--grid-column-count)) columns.
+ */
+static int int_math_function(const css_token *token)
+{
+	static const char *const names[] = { "calc", "min", "max", "clamp" };
+	size_t len;
+	int i;
+
+	if (token == NULL || token->type != CSS_TOKEN_FUNCTION)
+		return 0;
+	len = lwc_string_length(token->idata);
+	for (i = 0; i < 4; i++) {
+		if (len == strlen(names[i]) &&
+				strncasecmp(lwc_string_data(token->idata),
+						names[i], len) == 0)
+			return i + 1;
+	}
+	return 0;
+}
