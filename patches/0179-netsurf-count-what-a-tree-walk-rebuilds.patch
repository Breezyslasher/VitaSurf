+/**
+ * What a tree walk costs (VitaSurf).
+ *
+ * One promise job on a GitHub load runs 11,727 ms and the bindings
+ * counted so far come to about 3.2 s of it. That job was handed a node
+ * 148,096 times for a document of 6,270 elements -- two dozen handoffs
+ * each -- and childNodes builds a fresh array every time it is read,
+ * wrapping every child again. A loop of the shape
+ * "for (i = 0; i < n.childNodes.length; i++) n.childNodes[i]" is then
+ * quadratic in the children. Count the rebuilds and the children they
+ * produce, so the average list length is in the log, and time the
+ * sibling and parent walks beside them.
+ */
+extern unsigned int vitasurf_js_childnodes;
+extern unsigned int vitasurf_js_childnodes_items;
+extern unsigned int vitasurf_ms_js_childnodes;
+extern unsigned int vitasurf_js_tree_reads;
+extern unsigned int vitasurf_ms_js_tree_reads;
+extern unsigned int vitasurf_job_max_childnodes;
+extern unsigned int vitasurf_job_max_tree_reads;
 
