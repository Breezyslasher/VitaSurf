+nserror browser_window_history_set_url(struct browser_window *bw,
+		struct nsurl *url)
+{
+	struct history *history;
+
+	if (bw == NULL || url == NULL) {
+		return NSERROR_BAD_PARAMETER;
+	}
+	history = bw->history;
+	if (history == NULL || history->current == NULL) {
+		return NSERROR_INVALID;
+	}
+	nsurl_unref(history->current->page.url);
+	history->current->page.url = nsurl_ref(url);
+	if (history->current->page.frag_id != NULL) {
+		lwc_string_unref(history->current->page.frag_id);
+		history->current->page.frag_id = NULL;
+	}
+	return NSERROR_OK;
+}
