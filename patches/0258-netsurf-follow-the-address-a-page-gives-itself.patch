+/* Exported interface, documented in netsurf/browser_window.h */
+nserror browser_window_set_script_url(struct browser_window *bw,
+		struct nsurl *url, bool replace)
+{
+	struct nsurl *was;
+
+	if (bw == NULL || url == NULL || bw->current_content == NULL) {
+		return NSERROR_BAD_PARAMETER;
+	}
+	was = bw->script_url != NULL ? bw->script_url :
+		hlcache_handle_get_url(bw->current_content);
+	if (was != NULL && nsurl_compare(was, url, NSURL_COMPLETE)) {
+		return NSERROR_OK;
+	}
+	/* the global history: the new address was visited, and one that
+	 * was replaced was never really seen */
+	if (replace && was != NULL) {
+		urldb_reset_url_visit_data(was);
+	}
+	if (urldb_add_url(url)) {
+		const char *title = content_get_title(bw->current_content);
+
+		urldb_update_url_visit_data(url);
+		if (title != NULL) {
+			urldb_set_url_title(url, title);
+		}
+	}
+	browser_window_history_set_url(bw, url);
+	if (bw->script_url != NULL) {
+		nsurl_unref(bw->script_url);
+	}
+	bw->script_url = nsurl_ref(url);
+	return browser_window_refresh_url_bar(bw);
+}
