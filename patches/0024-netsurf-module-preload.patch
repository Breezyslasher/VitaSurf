+/**
+ * Callback for a preloaded module (VitaSurf).
+ *
+ * Nothing runs here. The fetch exists so the source is in hand when
+ * something imports the module; all this has to do is keep the active
+ * fetch count straight and let the conversion proceed once it reaches
+ * zero, exactly as the deferred callback does.
+ */
+static nserror
+convert_script_preload_cb(hlcache_handle *script,
+			  const hlcache_event *event,
+			  void *pw)
+{
+	html_content *parent = pw;
+	unsigned int i;
+	struct html_script *s;
+
+	for (i = 0, s = parent->scripts; i != parent->scripts_count; i++, s++) {
+		if (s->type == HTML_SCRIPT_PRELOAD && s->data.handle == script)
+			break;
+	}
+	if (i == parent->scripts_count) {
+		return NSERROR_OK;
+	}
+
+	switch (event->type) {
+	case CONTENT_MSG_DONE:
+		NSLOG(netsurf, INFO, "modulepreload %d done '%s'", i,
+		      nsurl_access(hlcache_handle_get_url(script)));
+		parent->base.active--;
+		break;
+
+	case CONTENT_MSG_ERROR:
+		NSLOG(netsurf, INFO, "modulepreload %s failed: %s",
+		      nsurl_access(hlcache_handle_get_url(script)),
+		      event->data.errordata.errormsg);
+		hlcache_handle_release(script);
+		s->data.handle = NULL;
+		parent->base.active--;
+		break;
+
+	default:
+		break;
+	}
+
+	if (parent->base.status != CONTENT_STATUS_DONE &&
+	    html_can_begin_conversion(parent)) {
+		html_begin_conversion(parent);
+	}
+
+	return NSERROR_OK;
+}
+
+/* exported internal interface documented in html/private.h */
+bool html_process_module_preload(html_content *c, dom_string *href)
+{
+	nserror ns_error;
+	nsurl *joined;
+	hlcache_child_context child;
+	struct html_script *nscript;
+
+	/*
+	 * A module named only by <link rel="modulepreload"> is never
+	 * fetched as a script, so nothing ever compiles it and every
+	 * import of it fails. Fetch it here so the source is in hand,
+	 * and leave it at that: the engine compiles it when something
+	 * imports it, which is both the right moment for a module body
+	 * to run and the only one that does not depend on where in the
+	 * document the link happened to sit.
+	 */
+	if (c->jsthread == NULL) {
+		union content_msg_data msg_data;
+
+		msg_data.jsthread = &c->jsthread;
+		content_broadcast(&c->base, CONTENT_MSG_GETTHREAD, &msg_data);
+		if (c->jsthread == NULL) {
+			return false;
+		}
+	}
+
+	ns_error = nsurl_join(c->base_url, dom_string_data(href), &joined);
+	if (ns_error != NSERROR_OK) {
+		return false;
+	}
+
+	/*
+	 * A module can be asked for more than once -- a bundler retries a
+	 * chunk whose import failed -- and one fetch of it is enough.
+	 */
+	{
+		unsigned int i;
+
+		for (i = 0; i != c->scripts_count; i++) {
+			if (c->scripts[i].type != HTML_SCRIPT_INLINE &&
+			    c->scripts[i].data.handle != NULL &&
+			    nsurl_compare(hlcache_handle_get_url(
+						c->scripts[i].data.handle),
+					  joined, NSURL_COMPLETE)) {
+				nsurl_unref(joined);
+				return false;
+			}
+		}
+	}
+
+	NSLOG(netsurf, INFO, "modulepreload '%s'", nsurl_access(joined));
+
+	nscript = html_process_new_script(c, corestring_dom_text_javascript,
+					  HTML_SCRIPT_PRELOAD);
+	if (nscript == NULL) {
+		nsurl_unref(joined);
+		return false;
+	}
+
+	child.charset = c->encoding;
+	child.quirks = c->base.quirks;
+
+	ns_error = hlcache_handle_retrieve(joined, 0,
+					   content_get_url(&c->base), NULL,
+					   convert_script_preload_cb, c, &child,
+					   CONTENT_SCRIPT, &nscript->data.handle);
+	nsurl_unref(joined);
+
+	if (ns_error != NSERROR_OK) {
+		nscript->already_started = true;
+		return false;
+	}
+	c->base.active++;
+	return true;
+}
