+/** What a position test reads of the node's siblings (VitaSurf). */
+static unsigned self_order(enum css_self_test test)
+{
+	switch (test) {
+	case CSS_SELF_FIRST_CHILD:
+	case CSS_SELF_FIRST_OF_TYPE:
+		return CSS_ORDER_PREV;
+	case CSS_SELF_LAST_CHILD:
+	case CSS_SELF_LAST_OF_TYPE:
+		return CSS_ORDER_NEXT;
+	case CSS_SELF_ONLY_CHILD:
+	case CSS_SELF_ONLY_OF_TYPE:
+		return CSS_ORDER_PREV | CSS_ORDER_NEXT;
+	case CSS_SELF_NTH_CHILD:
+	case CSS_SELF_NTH_OF_TYPE:
+		return CSS_ORDER_PRECEDING;
+	case CSS_SELF_NTH_LAST_CHILD:
+	case CSS_SELF_NTH_LAST_OF_TYPE:
+		return CSS_ORDER_FOLLOWING;
+	case CSS_SELF_EMPTY:
+		return CSS_ORDER_CHILDREN;
+	default:
+		return 0;
+	}
 }
 
