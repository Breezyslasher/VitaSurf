+static nserror html_transform_bitmap(const struct redraw_context *ctx,
+		struct bitmap *bitmap, int x, int y, int width, int height,
+		colour bg, bitmap_flags_t flags)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	struct rect src, dest;
+	struct bitmap *copy = NULL;
+	nserror res;
+
+	src.x0 = x;
+	src.y0 = y;
+	src.x1 = x + width;
+	src.y1 = y + height;
+	html_transform_rect(lv, &src, &dest, false);
+
+	/* a tiled background cannot be tiled through a turn; the first
+	 * tile is drawn where it lands */
+	flags &= ~(BITMAPF_REPEAT_X | BITMAPF_REPEAT_Y);
+
+	if (lv->axis == false || lv->m[0] < 0 || lv->m[3] < 0) {
+		copy = html_transform_resample(lv, bitmap, x, y, width,
+				height, &dest);
+		if (copy != NULL) {
+			HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->bitmap(
+					&rctx_, copy, dest.x0, dest.y0,
+					dest.x1 - dest.x0, dest.y1 - dest.y0,
+					bg, flags));
+			guit->bitmap->destroy(copy);
+			return res;
+		}
+	}
+
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->bitmap(&rctx_, bitmap,
+			dest.x0, dest.y0, dest.x1 - dest.x0,
+			dest.y1 - dest.y0, bg, flags));
+	return res;
+}
