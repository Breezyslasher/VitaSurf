+/** The most pixels a resampled bitmap may hold; beyond it, the
+ * picture is drawn unturned in the box it would cover. */
+#define HTML_TRANSFORM_BITMAP_MAX (512 * 512)
+
+/**
+ * Resample a bitmap through the level's matrix into a copy that covers
+ * the box around where the picture lands.
+ *
+ * \return the copy, or NULL if it could not be made
+ */
+static struct bitmap *html_transform_resample(
+		const struct html_transform_level *lv,
+		struct bitmap *bitmap, int x, int y, int width, int height,
+		const struct rect *dest)
+{
+	int bw = guit->bitmap->get_width(bitmap);
+	int bh = guit->bitmap->get_height(bitmap);
+	int dw = dest->x1 - dest->x0, dh = dest->y1 - dest->y0;
+	const uint8_t *src;
+	uint8_t *dst;
+	size_t ss, ds;
+	struct bitmap *copy;
+	bool opaque;
+	int px, py;
+
+	if (bw <= 0 || bh <= 0 || width <= 0 || height <= 0 ||
+			dw <= 0 || dh <= 0 || dw * dh > HTML_TRANSFORM_BITMAP_MAX)
+		return NULL;
+
+	copy = guit->bitmap->create(dw, dh, BITMAP_NONE);
+	if (copy == NULL)
+		return NULL;
+
+	src = guit->bitmap->get_buffer(bitmap);
+	dst = guit->bitmap->get_buffer(copy);
+	ss = guit->bitmap->get_rowstride(bitmap);
+	ds = guit->bitmap->get_rowstride(copy);
+	if (src == NULL || dst == NULL) {
+		guit->bitmap->destroy(copy);
+		return NULL;
+	}
+	opaque = guit->bitmap->get_opaque(bitmap);
+
+	for (py = 0; py < dh; py++) {
+		uint8_t *dp = dst + py * ds;
+
+		for (px = 0; px < dw; px++, dp += 4) {
+			float ux, uy;
+			int sx, sy;
+
+			/* where this device pixel's centre came from */
+			html_transform_unpoint(lv, dest->x0 + px + 0.5f,
+					dest->y0 + py + 0.5f, &ux, &uy);
+			sx = (int) ((ux - x) * bw / width);
+			sy = (int) ((uy - y) * bh / height);
+			if (ux < x || uy < y || sx < 0 || sy < 0 ||
+					sx >= bw || sy >= bh) {
+				dp[bitmap_layout.r] = 0;
+				dp[bitmap_layout.g] = 0;
+				dp[bitmap_layout.b] = 0;
+				dp[bitmap_layout.a] = 0;
+			} else {
+				const uint8_t *sp = src + sy * ss + sx * 4;
+
+				dp[0] = sp[0];
+				dp[1] = sp[1];
+				dp[2] = sp[2];
+				dp[3] = sp[3];
+				if (opaque)
+					dp[bitmap_layout.a] = 0xff;
+			}
+		}
+	}
+
+	guit->bitmap->set_opaque(copy, false);
+	guit->bitmap->modified(copy);
+	return copy;
+}
