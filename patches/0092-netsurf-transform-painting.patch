+/* Exported function documented in html/box_inspect.h */
+bool box_transform(const css_unit_ctx *unit_len_ctx, const struct box *box,
+		float m[4], int *ox, int *oy)
+{
+	css_fixed a, b, c, d;
+	css_fixed hl = 0, vl = 0;
+	css_unit hu = CSS_UNIT_PCT, vu = CSS_UNIT_PCT;
+	int bw, bh;
+
+	if (box->style == NULL)
+		return false;
+
+	/* a text box shares its element's style, and a transform does not
+	 * apply to an inline box; the element's block handles it */
+	if (box->type == BOX_TEXT || box->type == BOX_INLINE ||
+			box->type == BOX_INLINE_END ||
+			box->type == BOX_INLINE_CONTAINER ||
+			box->type == BOX_BR)
+		return false;
+
+	if (css_computed_transform_matrix(box->style, &a, &b, &c, &d) !=
+			CSS_TRANSFORM_SET)
+		return false;
+
+	if (a == INTTOFIX(1) && b == 0 && c == 0 && d == INTTOFIX(1))
+		return false;
+
+	m[0] = FIXTOFLT(a);
+	m[1] = FIXTOFLT(b);
+	m[2] = FIXTOFLT(c);
+	m[3] = FIXTOFLT(d);
+
+	/* FPCT_OF_INT_TOINT does not bracket its arguments, so the size
+	 * has to be worked out before it is handed over. */
+	bw = box->border[LEFT].width + box->padding[LEFT] + box->width +
+			box->padding[RIGHT] + box->border[RIGHT].width;
+	bh = box->border[TOP].width + box->padding[TOP] + box->height +
+			box->padding[BOTTOM] + box->border[BOTTOM].width;
+
+	if (css_computed_transform_origin(box->style, &hl, &hu, &vl, &vu) !=
+			CSS_TRANSFORM_ORIGIN_SET) {
+		hl = INTTOFIX(50);
+		vl = INTTOFIX(50);
+		hu = vu = CSS_UNIT_PCT;
+	}
+
+	if (hu == CSS_UNIT_PCT)
+		*ox = FPCT_OF_INT_TOINT(hl, bw);
+	else
+		*ox = FIXTOINT(css_unit_len2device_px(box->style, unit_len_ctx,
+				hl, hu));
+
+	if (vu == CSS_UNIT_PCT)
+		*oy = FPCT_OF_INT_TOINT(vl, bh);
+	else
+		*oy = FIXTOINT(css_unit_len2device_px(box->style, unit_len_ctx,
+				vl, vu));
+
+	return true;
+}
