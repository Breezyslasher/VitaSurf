+/**
+ * Put a box's transform in front of the plotters (VitaSurf).
+ *
+ * \param html   the content
+ * \param box    the box about to be painted
+ * \param x_parent, y_parent  where its parent is, in content coordinates
+ * \param scale  the page scale
+ * \param clip   the clip in force, in device coordinates
+ * \param ctx    the redraw context; updated to draw through the level
+ * \param fctx   storage for the new context
+ * \param bclip  updated to the clip the box should see, in its own
+ *               untransformed coordinates
+ * \return 1 if a level was pushed, 0 if the box has no transform,
+ *         -1 if it is scaled to nothing and paints nothing
+ */
+static int html_transform_push(const html_content *html, struct box *box,
+		int x_parent, int y_parent, float scale,
+		const struct rect *clip, const struct redraw_context **ctx,
+		struct redraw_context *fctx, struct rect *bclip)
+{
+	struct html_transform_level *lv;
+	float m[4], det;
+	int ox, oy;
+
+	if (box->style == NULL ||
+			box_transform(&html->unit_len_ctx, box, m, &ox, &oy) ==
+					false)
+		return 0;
+
+	det = m[0] * m[3] - m[1] * m[2];
+	if (det > -0.0001f && det < 0.0001f)
+		return -1;
+
+	if (html_transform_depth >= HTML_TRANSFORM_DEPTH)
+		return 0;
+
+	lv = &html_transform_stack[html_transform_depth++];
+	lv->real = (*ctx)->plot;
+	memcpy(lv->m, m, sizeof(m));
+	lv->inv[0] = m[3] / det;
+	lv->inv[1] = -m[1] / det;
+	lv->inv[2] = -m[2] / det;
+	lv->inv[3] = m[0] / det;
+	lv->ox = (x_parent + box->x - box->border[LEFT].width + ox) * scale;
+	lv->oy = (y_parent + box->y - box->border[TOP].width + oy) * scale;
+	lv->outer = *clip;
+	lv->axis = (m[1] > -0.0001f && m[1] < 0.0001f &&
+			m[2] > -0.0001f && m[2] < 0.0001f);
+	lv->sy = sqrtf(m[2] * m[2] + m[3] * m[3]);
+
+	/* the clip the box should test itself and its children against,
+	 * in the coordinates it paints in; a pixel each way for rounding */
+	html_transform_rect(lv, clip, bclip, true);
+	bclip->x0--;
+	bclip->y0--;
+	bclip->x1++;
+	bclip->y1++;
+
+	*fctx = **ctx;
+	fctx->plot = &html_transform_plotters;
+	*ctx = fctx;
+	html_transform_box_level = lv;
+
+	return 1;
+}
