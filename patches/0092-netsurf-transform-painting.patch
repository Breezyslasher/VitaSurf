+/*
+ * Painting through a transform (VitaSurf).
+ *
+ * The translation part of a transform is applied at layout, where hit
+ * testing and scrolling see it. What is left -- the rotation, scale and
+ * skew -- is applied here: a box with such a transform, and everything
+ * in it, is painted through a plotter table that stands in front of the
+ * real one and maps every coordinate through the box's matrix about its
+ * transform-origin. A rectangle that stays a rectangle is passed on as
+ * one; a turned one becomes a polygon, or four lines for its edge. Text
+ * is placed at its mapped anchor with its size scaled, since the
+ * plotters cannot turn glyphs. A bitmap is resampled into a copy that
+ * covers where it lands, so an icon flipped with scaleX(-1) or a turned
+ * picture comes out as the author meant. The clip is mapped to the box
+ * around where it lands, which is exact for a scale and generous for a
+ * turn. Levels nest, and stack with the filter levels above.
+ */
+#define HTML_TRANSFORM_DEPTH 8
+
+struct html_transform_level {
+	const struct plotter_table *real;
+	float m[4];		/**< a b c d */
+	float inv[4];		/**< the inverse, for bitmaps and the clip */
+	float ox, oy;		/**< the origin, in device coordinates */
+	struct rect outer;	/**< the clip in force outside the level */
+	bool axis;		/**< true when rectangles stay rectangles */
+	float sy;		/**< what a text size is multiplied by */
+};
+
+static struct html_transform_level html_transform_stack[HTML_TRANSFORM_DEPTH];
+static int html_transform_depth;
+
+/** The level html_redraw_box pushed for the box about to be painted. */
+static struct html_transform_level *html_transform_box_level;
+
+static inline void html_transform_point(
+		const struct html_transform_level *lv,
+		float x, float y, float *rx, float *ry)
+{
+	float dx = x - lv->ox, dy = y - lv->oy;
+
+	*rx = lv->ox + lv->m[0] * dx + lv->m[2] * dy;
+	*ry = lv->oy + lv->m[1] * dx + lv->m[3] * dy;
+}
+
+static inline void html_transform_unpoint(
+		const struct html_transform_level *lv,
+		float x, float y, float *rx, float *ry)
+{
+	float dx = x - lv->ox, dy = y - lv->oy;
+
+	*rx = lv->ox + lv->inv[0] * dx + lv->inv[2] * dy;
+	*ry = lv->oy + lv->inv[1] * dx + lv->inv[3] * dy;
+}
+
+/** The box around where a rectangle lands. */
+static void html_transform_rect(const struct html_transform_level *lv,
+		const struct rect *r, struct rect *out, bool inverse)
+{
+	float minx = 1e9f, miny = 1e9f, maxx = -1e9f, maxy = -1e9f;
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		float px = (i & 1) ? r->x1 : r->x0;
+		float py = (i & 2) ? r->y1 : r->y0;
+		float tx, ty;
+
+		if (inverse)
+			html_transform_unpoint(lv, px, py, &tx, &ty);
+		else
+			html_transform_point(lv, px, py, &tx, &ty);
+		if (tx < minx) minx = tx;
+		if (tx > maxx) maxx = tx;
+		if (ty < miny) miny = ty;
+		if (ty > maxy) maxy = ty;
+	}
+
+	out->x0 = (int) floorf(minx);
+	out->y0 = (int) floorf(miny);
+	out->x1 = (int) ceilf(maxx);
+	out->y1 = (int) ceilf(maxy);
+}
+
+#define HTML_TRANSFORM_FORWARD(lvvar, ctxvar, call)			\
+	do {								\
+		struct redraw_context rctx_ = *(ctxvar);		\
+		html_transform_depth--;					\
+		rctx_.plot = (lvvar)->real;				\
+		res = (call);						\
+		html_transform_depth++;					\
+	} while (0)
+
+static nserror html_transform_clip(const struct redraw_context *ctx,
+		const struct rect *clip)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	struct rect r;
+	nserror res;
+
+	html_transform_rect(lv, clip, &r, false);
+	if (r.x0 < lv->outer.x0) r.x0 = lv->outer.x0;
+	if (r.y0 < lv->outer.y0) r.y0 = lv->outer.y0;
+	if (r.x1 > lv->outer.x1) r.x1 = lv->outer.x1;
+	if (r.y1 > lv->outer.y1) r.y1 = lv->outer.y1;
+	if (r.x1 < r.x0) r.x1 = r.x0;
+	if (r.y1 < r.y0) r.y1 = r.y0;
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->clip(&rctx_, &r));
+	return res;
+}
+
+static int html_transform_radius(const struct html_transform_level *lv,
+		int radius)
+{
+	float det = lv->m[0] * lv->m[3] - lv->m[1] * lv->m[2];
+
+	if (det < 0)
+		det = -det;
+	return (int) (radius * sqrtf(det) + 0.5f);
+}
+
+static nserror html_transform_arc(const struct redraw_context *ctx,
+		const plot_style_t *pstyle, int x, int y, int radius,
+		int angle1, int angle2)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	float tx, ty;
+	nserror res;
+
+	html_transform_point(lv, x, y, &tx, &ty);
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->arc(&rctx_, pstyle,
+			(int) (tx + 0.5f), (int) (ty + 0.5f),
+			html_transform_radius(lv, radius), angle1, angle2));
+	return res;
+}
+
+static nserror html_transform_disc(const struct redraw_context *ctx,
+		const plot_style_t *pstyle, int x, int y, int radius)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	float tx, ty;
+	nserror res;
+
+	html_transform_point(lv, x, y, &tx, &ty);
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->disc(&rctx_, pstyle,
+			(int) (tx + 0.5f), (int) (ty + 0.5f),
+			html_transform_radius(lv, radius)));
+	return res;
+}
+
+static nserror html_transform_line(const struct redraw_context *ctx,
+		const plot_style_t *pstyle, const struct rect *line)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	struct rect l;
+	float x0, y0, x1, y1;
+	nserror res;
+
+	html_transform_point(lv, line->x0, line->y0, &x0, &y0);
+	html_transform_point(lv, line->x1, line->y1, &x1, &y1);
+	l.x0 = (int) (x0 + 0.5f);
+	l.y0 = (int) (y0 + 0.5f);
+	l.x1 = (int) (x1 + 0.5f);
+	l.y1 = (int) (y1 + 0.5f);
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->line(&rctx_, pstyle, &l));
+	return res;
+}
+
+static nserror html_transform_rectangle(const struct redraw_context *ctx,
+		const plot_style_t *pstyle, const struct rect *rectangle)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	nserror res = NSERROR_OK;
+
+	if (lv->axis) {
+		struct rect r;
+
+		html_transform_rect(lv, rectangle, &r, false);
+		HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->rectangle(&rctx_,
+				pstyle, &r));
+		return res;
+	}
+
+	/* turned: the fill as a polygon, the edge as four lines */
+	{
+		int p[8];
+		int i;
+
+		for (i = 0; i < 4; i++) {
+			/* corners in order round the rectangle */
+			float px = (i == 1 || i == 2) ? rectangle->x1 :
+					rectangle->x0;
+			float py = (i >= 2) ? rectangle->y1 : rectangle->y0;
+			float tx, ty;
+
+			html_transform_point(lv, px, py, &tx, &ty);
+			p[i * 2] = (int) (tx + 0.5f);
+			p[i * 2 + 1] = (int) (ty + 0.5f);
+		}
+
+		if (pstyle->fill_type != PLOT_OP_TYPE_NONE) {
+			plot_style_t st = *pstyle;
+
+			st.stroke_type = PLOT_OP_TYPE_NONE;
+			HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->polygon(
+					&rctx_, &st, p, 4));
+			if (res != NSERROR_OK)
+				return res;
+		}
+
+		if (pstyle->stroke_type != PLOT_OP_TYPE_NONE) {
+			plot_style_t st = *pstyle;
+
+			st.fill_type = PLOT_OP_TYPE_NONE;
+			for (i = 0; i < 4; i++) {
+				struct rect l;
+				int j = (i + 1) & 3;
+
+				l.x0 = p[i * 2];
+				l.y0 = p[i * 2 + 1];
+				l.x1 = p[j * 2];
+				l.y1 = p[j * 2 + 1];
+				HTML_TRANSFORM_FORWARD(lv, ctx,
+						rctx_.plot->line(&rctx_, &st,
+								&l));
+				if (res != NSERROR_OK)
+					return res;
+			}
+		}
+	}
+
+	return res;
+}
+
+static nserror html_transform_polygon(const struct redraw_context *ctx,
+		const plot_style_t *pstyle, const int *p, unsigned int n)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	int *q;
+	unsigned int i;
+	nserror res;
+
+	q = malloc(sizeof(int) * 2 * (n == 0 ? 1 : n));
+	if (q == NULL)
+		return NSERROR_NOMEM;
+
+	for (i = 0; i < n; i++) {
+		float tx, ty;
+
+		html_transform_point(lv, p[i * 2], p[i * 2 + 1], &tx, &ty);
+		q[i * 2] = (int) (tx + 0.5f);
+		q[i * 2 + 1] = (int) (ty + 0.5f);
+	}
+
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->polygon(&rctx_, pstyle,
+			q, n));
+	free(q);
+	return res;
+}
+
+static nserror html_transform_path(const struct redraw_context *ctx,
+		const plot_style_t *pstyle, const float *p, unsigned int n,
+		const float transform[6])
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	float t[6];
+	const float *m = lv->m;
+	nserror res;
+
+	/* ours after theirs: M T p + (O - M O) */
+	t[0] = m[0] * transform[0] + m[2] * transform[1];
+	t[1] = m[1] * transform[0] + m[3] * transform[1];
+	t[2] = m[0] * transform[2] + m[2] * transform[3];
+	t[3] = m[1] * transform[2] + m[3] * transform[3];
+	t[4] = m[0] * transform[4] + m[2] * transform[5] +
+			lv->ox - (m[0] * lv->ox + m[2] * lv->oy);
+	t[5] = m[1] * transform[4] + m[3] * transform[5] +
+			lv->oy - (m[1] * lv->ox + m[3] * lv->oy);
+
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->path(&rctx_, pstyle, p, n,
+			t));
+	return res;
+}
