+static nserror html_transform_text(const struct redraw_context *ctx,
+		const plot_font_style_t *fstyle, int x, int y,
+		const char *text, size_t length)
+{
+	struct html_transform_level *lv =
+			&html_transform_stack[html_transform_depth - 1];
+	plot_font_style_t st = *fstyle;
+	float tx, ty;
+	nserror res = NSERROR_OK;
+
+	st.size = (plot_style_fixed) (fstyle->size * lv->sy + 0.5f);
+	if (st.size <= 0)
+		return NSERROR_OK;
+
+	html_transform_point(lv, x, y, &tx, &ty);
+	HTML_TRANSFORM_FORWARD(lv, ctx, rctx_.plot->text(&rctx_, &st,
+			(int) (tx + 0.5f), (int) (ty + 0.5f), text, length));
+	return res;
+}
