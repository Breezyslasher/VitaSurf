+/**
+ * Grow a bounding box, given relative to a box's padding edge, to cover
+ * where the box's transform paints it (VitaSurf).
+ *
+ * The matrix is applied about the transform-origin when the box is
+ * painted, so a rotated or enlarged box reaches outside where it was
+ * laid out; the redraw region and the clip its ancestors set have to
+ * include that or a scroll leaves pieces behind.
+ */
+static void
+layout_transform_bbox(
+		const css_unit_ctx *unit_len_ctx,
+		struct box *box,
+		int *x0, int *y0, int *x1, int *y1)
+{
+	float m[4];
+	int ox, oy;
+	float cx, cy, minx, miny, maxx, maxy;
+	int i;
+
+	if (box->style == NULL ||
+			box_transform(unit_len_ctx, box, m, &ox, &oy) == false)
+		return;
+
+	/* the origin is from the border edge; the bbox is from the
+	 * padding edge */
+	cx = ox - box->border[LEFT].width;
+	cy = oy - box->border[TOP].width;
+
+	minx = miny = 1e9f;
+	maxx = maxy = -1e9f;
+	for (i = 0; i < 4; i++) {
+		float px = (i & 1) ? *x1 : *x0;
+		float py = (i & 2) ? *y1 : *y0;
+		float dx = px - cx, dy = py - cy;
+		float tx = cx + m[0] * dx + m[2] * dy;
+		float ty = cy + m[1] * dx + m[3] * dy;
+
+		if (tx < minx) minx = tx;
+		if (tx > maxx) maxx = tx;
+		if (ty < miny) miny = ty;
+		if (ty > maxy) maxy = ty;
+	}
+
+	*x0 = (int) floorf(minx);
+	*y0 = (int) floorf(miny);
+	*x1 = (int) ceilf(maxx);
+	*y1 = (int) ceilf(maxy);
+}
