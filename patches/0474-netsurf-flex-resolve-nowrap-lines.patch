+/**
+ * Whether a box's white-space keeps its text on one line (VitaSurf).
+ */
+static bool layout_box_nowrap(const struct box *b)
+{
+	const css_computed_style *style = b->style;
+	uint8_t ws;
+
+	if (style == NULL && b->inline_end != NULL)
+		style = b->inline_end->style;
+	if (style == NULL)
+		return false;
+	ws = css_computed_white_space(style);
+	return ws == CSS_WHITE_SPACE_NOWRAP || ws == CSS_WHITE_SPACE_PRE;
+}
+
+/**
+ * Whether a white-space value keeps text on one line (VitaSurf).
+ */
+static bool layout_style_nowrap(const css_computed_style *style)
+{
+	uint8_t ws;
+
+	if (style == NULL)
+		return false;
+	ws = css_computed_white_space(style);
+	return ws == CSS_WHITE_SPACE_NOWRAP || ws == CSS_WHITE_SPACE_PRE;
+}
+
+/**
+ * The style of the element holding both of two boxes of a line, the
+ * second after the first with only the starts and ends of inline
+ * elements between them (VitaSurf): the innermost inline open before
+ * the first and still open at the second, else the block.
+ */
+static const css_computed_style *layout_common_style(const struct box *q,
+		const struct box *n)
+{
+	const struct box *x;
+	int pending = 0, closed = 0, depth = 0;
+
+	/* inlines that end between them hold the first only */
+	for (x = q->next; x != NULL && x != n; x = x->next) {
+		if (x->type == BOX_INLINE && !lh__box_is_replace(x))
+			pending++;
+		else if (x->type == BOX_INLINE_END) {
+			if (pending > 0)
+				pending--;
+			else
+				closed++;
+		}
+	}
+	for (x = q->prev; x != NULL; x = x->prev) {
+		if (x->type == BOX_INLINE_END) {
+			depth++;
+		} else if (x->type == BOX_INLINE && !lh__box_is_replace(x)) {
+			if (depth > 0)
+				depth--;
+			else if (closed > 0)
+				closed--;
+			else
+				return x->style;
+		}
+	}
+	if (n->parent != NULL && n->parent->parent != NULL)
+		return n->parent->parent->style;
+	return NULL;
+}
+
+/**
+ * Whether a line may not break before a box because white-space says so
+ * (VitaSurf). The opportunity at a space is the white-space of the text
+ * the space follows; between two boxes with no space, that of the
+ * element holding both, as CSS Text has it for atomic inlines. An inline's start or end has no width, so the
+ * content after it is asked about. NetSurf had broken a line at every
+ * element's edge, so a nowrap title holding a <b> or two inline-blocks
+ * wrapped all the same.
+ */
+static bool layout_break_forbidden(const struct box *b)
+{
+	const struct box *n = b, *q;
+
+	if (b->type == BOX_BR || lh__box_is_float_box(b))
+		return false;
+	while (n != NULL && ((n->type == BOX_INLINE &&
+			!lh__box_is_replace(n)) ||
+			n->type == BOX_INLINE_END))
+		n = n->next;
+	if (n == NULL || n->type == BOX_BR || lh__box_is_float_box(n))
+		n = b;
+	for (q = n->prev; q != NULL; q = q->prev) {
+		if (q->space != 0)
+			return layout_box_nowrap(q);
+		if ((q->type == BOX_INLINE && !lh__box_is_replace(q)) ||
+				q->type == BOX_INLINE_END)
+			continue;
+		if (q->type == BOX_BR || lh__box_is_float_box(q))
+			return false;
+		return layout_style_nowrap(layout_common_style(q, n));
+	}
+	return false;
+}
