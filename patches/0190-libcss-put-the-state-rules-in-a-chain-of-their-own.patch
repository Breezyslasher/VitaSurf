 }
 
+/**
+ * Find the first universal rule that needs a node state (VitaSurf)
+ *
+ * Only worth calling for a node that is in some state at all: no node
+ * is ever in a shadow tree here, so the :host rules that fill this
+ * chain on a GitHub page are never looked at.
+ */
+css_error css__selector_hash_find_by_state(css_selector_hash *hash,
+		const struct css_hash_selection_requirments *req,
+		css_selector_hash_iterator *iterator,
+		const css_selector ***matched)
+{
+	hash_entry *head;
+
+	if (hash == NULL || req == NULL || iterator == NULL || matched == NULL)
+		return CSS_BADPARM;
+
+	head = &hash->universal_state;
+
+	if (head->sel != NULL) {
+		/* Search through chain for first match */
+		while (head != NULL) {
+			css_select_steps_universal++;
+			if (RULE_HAS_BYTECODE(head) &&
+			    RULE_WANTS_WHAT_NODE_HAS(head, req) &&
+			    css_bloom_in_bloom(
+					head->sel_chain_bloom,
+					req->node_bloom) &&
+			    mq_rule_good_for_media(head->sel->rule,
+					req->unit_ctx, req->media,
+					req->str)) {
+				/* Found a match */
+				break;
+			}
+
+			head = head->next;
+		}
+
+		if (head == NULL)
+			head = &empty_slot;
+	}
+
+	/* the same walk, so the same iterator serves */
+	(*iterator) = _iterate_attrs;
+	(*matched) = (const css_selector **) head;
+
+	return CSS_OK;
+}
+
 css_error css__selector_hash_find_universal(css_selector_hash *hash,
 		const struct css_hash_selection_requirments *req,
 		css_selector_hash_iterator *iterator,
