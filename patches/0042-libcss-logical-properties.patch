@@ -0,0 +1,208 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * Logical properties (VitaSurf).
+ *
+ * padding-inline-start and its relatives name a side by the direction
+ * text runs rather than by the edge of the screen. They are written as
+ * often as the physical ones now, and every one of them was thrown
+ * away: about 1600 declarations of real spacing across the stylesheets
+ * measured here, which is why pages sat flush against the screen edge.
+ *
+ * Each is parsed as the physical property it corresponds to. That
+ * mapping is the one for horizontal writing with text running left to
+ * right, which is what this browser lays out; a right-to-left page gets
+ * its inline-start and inline-end the wrong way round, which is still
+ * better than losing the padding altogether. Resolving them properly
+ * means carrying them to the computed style and choosing there, once
+ * direction and writing-mode are known.
+ */
+
+/** Parse one value as the named physical property. */
+static css_error parse_as(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, enum css_properties_e prop)
+{
+	switch (prop) {
+	case CSS_PROP_PADDING_TOP:
+	case CSS_PROP_PADDING_RIGHT:
+	case CSS_PROP_PADDING_BOTTOM:
+	case CSS_PROP_PADDING_LEFT:
+		return css__parse_padding_side(c, vector, ctx, result, prop);
+	case CSS_PROP_MARGIN_TOP:
+	case CSS_PROP_MARGIN_RIGHT:
+	case CSS_PROP_MARGIN_BOTTOM:
+	case CSS_PROP_MARGIN_LEFT:
+		return css__parse_margin_side(c, vector, ctx, result, prop);
+	default:
+		return css__parse_side(c, vector, ctx, result, prop);
+	}
+}
+
+/**
+ * Parse a pair shorthand: one value for both sides, or one each.
+ */
+static css_error parse_pair(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result,
+		enum css_properties_e first, enum css_properties_e second)
+{
+	int32_t orig_ctx = *ctx;
+	int32_t after_first;
+	const css_token *token;
+	css_error error;
+
+	error = parse_as(c, vector, ctx, result, first);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	after_first = *ctx;
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && tokenIsChar(token, '!') == false) {
+		int32_t before_second = *ctx;
+
+		error = parse_as(c, vector, ctx, result, second);
+		if (error == CSS_OK) {
+			return CSS_OK;
+		}
+		*ctx = before_second;
+	}
+
+	/* only one value, so it serves for both sides */
+	*ctx = orig_ctx;
+	error = parse_as(c, vector, ctx, result, second);
+	*ctx = after_first;
+
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
+
+#define ALIAS(name, phys)						\
+	css_error css__parse_##name(css_language *c,			\
+			const parserutils_vector *vector, int32_t *ctx,	\
+			css_style *result)				\
+	{								\
+		return parse_as(c, vector, ctx, result, phys);		\
+	}
+
+#define PAIR(name, a, b)						\
+	css_error css__parse_##name(css_language *c,			\
+			const parserutils_vector *vector, int32_t *ctx,	\
+			css_style *result)				\
+	{								\
+		return parse_pair(c, vector, ctx, result, a, b);	\
+	}
+
+ALIAS(padding_block_start, CSS_PROP_PADDING_TOP)
+ALIAS(padding_block_end, CSS_PROP_PADDING_BOTTOM)
+ALIAS(padding_inline_start, CSS_PROP_PADDING_LEFT)
+ALIAS(padding_inline_end, CSS_PROP_PADDING_RIGHT)
+PAIR(padding_block, CSS_PROP_PADDING_TOP, CSS_PROP_PADDING_BOTTOM)
+PAIR(padding_inline, CSS_PROP_PADDING_LEFT, CSS_PROP_PADDING_RIGHT)
+
+ALIAS(margin_block_start, CSS_PROP_MARGIN_TOP)
+ALIAS(margin_block_end, CSS_PROP_MARGIN_BOTTOM)
+ALIAS(margin_inline_start, CSS_PROP_MARGIN_LEFT)
+ALIAS(margin_inline_end, CSS_PROP_MARGIN_RIGHT)
+PAIR(margin_block, CSS_PROP_MARGIN_TOP, CSS_PROP_MARGIN_BOTTOM)
+PAIR(margin_inline, CSS_PROP_MARGIN_LEFT, CSS_PROP_MARGIN_RIGHT)
+
+ALIAS(inset_block_start, CSS_PROP_TOP)
+ALIAS(inset_block_end, CSS_PROP_BOTTOM)
+ALIAS(inset_inline_start, CSS_PROP_LEFT)
+ALIAS(inset_inline_end, CSS_PROP_RIGHT)
+PAIR(inset_block, CSS_PROP_TOP, CSS_PROP_BOTTOM)
+PAIR(inset_inline, CSS_PROP_LEFT, CSS_PROP_RIGHT)
+
+#undef ALIAS
+#undef PAIR
+
+/**
+ * Parse inset: <'top'>{1,4}
+ *
+ * The values run clockwise from the top, as every other four-sided
+ * shorthand does.
+ */
+css_error css__parse_inset(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const enum css_properties_e sides[4] = {
+		CSS_PROP_TOP, CSS_PROP_RIGHT,
+		CSS_PROP_BOTTOM, CSS_PROP_LEFT
+	};
+	int32_t orig_ctx = *ctx;
+	int32_t start[4];
+	int32_t after[4];
+	const css_token *token;
+	css_error error;
+	int n = 0, i;
+
+	/* read as many values as the author wrote, up to four */
+	while (n < 4) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!')) {
+			break;
+		}
+
+		start[n] = *ctx;
+		error = parse_as(c, vector, ctx, result, sides[n]);
+		if (error != CSS_OK) {
+			if (n == 0) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			*ctx = start[n];
+			break;
+		}
+		after[n] = *ctx;
+		n++;
+	}
+
+	if (n == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	/*
+	 * Fill in the sides the author left out by parsing the value
+	 * that stands for them a second time, under the other property.
+	 */
+	for (i = n; i < 4; i++) {
+		int32_t from = (i == 3 && n > 1) ? start[1] : start[i % n];
+		int32_t resume = *ctx;
+
+		*ctx = from;
+		error = parse_as(c, vector, ctx, result, sides[i]);
+		*ctx = resume;
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	}
+
+	*ctx = after[n - 1];
+
+	return CSS_OK;
+}
