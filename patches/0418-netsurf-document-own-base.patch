+			nsurl_unref(c->inherited_base);
+			c->inherited_base = NULL;
+		}
 
 		lwc_string_unref(c->universal);
 		c->universal = NULL;
@@ -856,6 +862,10 @@ html_create_html_data(html_content *c, const http_parameter *params)
 		c->parser = NULL;
 		nsurl_unref(c->base_url);
