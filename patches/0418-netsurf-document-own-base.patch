+			nsurl_unref(c->inherited_base);
+			c->inherited_base = NULL;
+		}
 
 		lwc_string_unref(c->universal);
 		c->universal = NULL;
@@ -2106,6 +2116,8 @@ static void html_destroy(struct content *c)
 
 	if (html->base_url)
 		nsurl_unref(html->base_url);
+	if (html->inherited_base != NULL)
+		nsurl_unref(html->inherited_base);
 
 	/* At this point we can be moderately confident the JS is offline
 	 * so we destroy the JS thread.
