+/**
+ * The style a text box is measured and painted with (VitaSurf): its
+ * block's ::first-line style composed over its own while it sits on
+ * that line, its own otherwise.
+ */
+static inline const css_computed_style *box_text_style(const struct box *b)
+{
+	if ((b->flags & FIRST_LINE) && b->first_line_style != NULL)
+		return b->first_line_style;
+	return b->style;
