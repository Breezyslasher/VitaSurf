+				CALC_PUSH(u, v < 0 ? -v : v);
+			} else {
+				CALC_PUSH(UNIT_CALC_NUMBER,
+					v > 0 ? INTTOFIX(1) :
+					v < 0 ? INTTOFIX(-1) : 0);
+			}
+			break;
+		}
