+		case CALC_REM:
+		case CALC_ROUND:
+		case CALC_ROUND_UP:
+		case CALC_ROUND_DOWN:
+		case CALC_ROUND_ZERO: {
+			/*
+			 * mod(), rem() and round() (VitaSurf). A plain
+			 * number step against a length is the step in the
+			 * length's units, which is what round(x) with its
+			 * step left out needs.
+			 */
+			unit u_left, u_right;
+			css_fixed v_left, v_right;
+			double a, b, q;
