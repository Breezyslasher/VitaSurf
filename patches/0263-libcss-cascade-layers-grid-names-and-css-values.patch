+/******************************************************************************
+ * @scope (VitaSurf)                                                          *
+ ******************************************************************************/
+
+/* exported interface documented in parse/nesting.h */
+css_error css__rewrite_scope(const char *src, size_t len,
+			     char **out, size_t *outlen)
+{
+	struct sbuf b = { NULL, 0, 0, false };
+	int depth = 0;
+	/* the brace depths at which @scope blocks opened */
+	int scopes[32];
+	int n_scopes = 0;
+	size_t i = 0, start = 0, j;
+	bool any = false;
+
+	*out = NULL;
+	*outlen = 0;
+	for (j = 0; j + 6 <= len && !any; j++) {
+		if (src[j] == '@' && strncasecmp(src + j, "@scope", 6) == 0)
+			any = true;
+	}
+	if (!any)
+		return CSS_OK;
+
+	while (i < len) {
+		char c = src[i];
+
+		if (c == '"' || c == '\'') {
+			char q = c;
+
+			for (i++; i < len && src[i] != q; i++)
+				if (src[i] == '\\')
+					i++;
+			i++;
+			continue;
+		}
+		if (c == '/' && i + 1 < len && src[i + 1] == '*') {
+			const char *e = NULL;
+			size_t k;
+
+			for (k = i + 2; k + 1 < len; k++) {
+				if (src[k] == '*' && src[k + 1] == '/') {
+					e = src + k;
+					break;
+				}
+			}
+			i = e ? (size_t) (e - src) + 2 : len;
+			continue;
+		}
+		if (c == '{') {
+			depth++;
+			i++;
+			continue;
+		}
+		if (c == '}') {
+			if (n_scopes > 0 && scopes[n_scopes - 1] == depth)
+				n_scopes--;
+			depth--;
+			i++;
+			continue;
+		}
+		if (c == '@' && i + 6 <= len &&
+				strncasecmp(src + i, "@scope", 6) == 0 &&
+				(i + 6 == len || src[i + 6] == ' ' ||
+				 src[i + 6] == '(' || src[i + 6] == '{' ||
+				 src[i + 6] == '\n' || src[i + 6] == '\t')) {
+			size_t k = i + 6, root0 = 0, root1 = 0;
+
+			/* the scope root, "(A)"; "to (B)" is passed over */
+			while (k < len && src[k] != '{' && src[k] != ';' &&
+					src[k] != '(')
+				k++;
+			if (k < len && src[k] == '(') {
+				size_t close = sel_close(src, len, k);
+
+				if (close == 0)
+					break;
+				root0 = k + 1;
+				root1 = close - 1;
+				k = close;
+			}
+			while (k < len && src[k] != '{' && src[k] != ';')
+				k++;
+			if (k >= len || src[k] != '{')
+				break;
+
+			sb_put(&b, src + start, i - start);
+			/* no specificity of its own, as @scope adds none;
+			 * a sheet's own @scope with no root applies from
+			 * the root down */
+			sb_put(&b, ":where(", 7);
+			if (root1 > root0)
+				sb_put(&b, src + root0, root1 - root0);
+			else
+				sb_put(&b, ":root", 5);
+			sb_put(&b, ") {", 3);
+			depth++;
+			if (n_scopes < 32)
+				scopes[n_scopes++] = depth;
+			i = k + 1;
+			start = i;
+			continue;
+		}
+		if (c == ':' && n_scopes > 0 && i + 6 <= len &&
+				strncasecmp(src + i, ":scope", 6) == 0 &&
+				(i + 6 == len || !(isalnum((unsigned char)
+					src[i + 6]) || src[i + 6] == '-'))) {
+			/* :scope inside the block is its root */
+			sb_put(&b, src + start, i - start);
+			sb_put(&b, "&", 1);
+			i += 6;
+			start = i;
+			continue;
+		}
+		i++;
+	}
+
+	if (b.p == NULL && !b.fail)
+		return CSS_OK;
+	sb_put(&b, src + start, len - start);
+	if (b.fail) {
+		free(b.p);
+		return CSS_NOMEM;
+	}
+	*out = b.p;
+	*outlen = b.n;
+	return CSS_OK;
+}
