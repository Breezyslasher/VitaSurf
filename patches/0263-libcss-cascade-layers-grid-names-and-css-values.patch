+		case CSS_UNIT_CM:
+		case CSS_UNIT_MM:
+		case CSS_UNIT_PT:
+		case CSS_UNIT_PC:
+		case CSS_UNIT_Q:
+			return FDIV(FMUL(css_unit__absolute_len2pt(style,
+					viewport_height, viewport_width,
+					len.value, unit), F_96), F_72);
+		default:
+			break;
+		}
+		break;
+	default:
+		break;
+	}
+	return FMUL(fs, FLTTOFIX(1.2));
+}
