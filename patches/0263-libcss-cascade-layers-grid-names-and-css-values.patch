+/**
+ * The id of a cascade layer the sheet names, adding it if new (VitaSurf).
+ *
+ * A dotted name's parents are added first, so the list holds every layer
+ * after the layers it is inside, in the order the sheet first named them.
+ *
+ * \param sheet  the sheet
+ * \param name   the layer's full name, "a.b" for b inside a
+ * \param len    its length
+ * \return the id, from 1, or 0 if it could not be added
+ */
+uint16_t css__stylesheet_layer_id(css_stylesheet *sheet, const char *name,
+		size_t len)
+{
+	lwc_string *s;
+	uint32_t i;
+	size_t k;
+
+	if (len == 0)
+		return 0;
+	for (k = 0; k + 1 < len; k++) {
+		if (name[k] == '.')
+			css__stylesheet_layer_id(sheet, name, k);
+	}
+	if (lwc_intern_string(name, len, &s) != lwc_error_ok)
+		return 0;
+	for (i = 0; i < sheet->n_layers; i++) {
+		if (sheet->layers[i] == s) {
+			lwc_string_unref(s);
+			return (uint16_t) (i + 1);
+		}
+	}
+	if (sheet->n_layers >= 0xfff0) {
+		lwc_string_unref(s);
+		return 0;
+	}
+	{
+		lwc_string **grown = realloc(sheet->layers,
+				(sheet->n_layers + 1) * sizeof(*grown));
+
+		if (grown == NULL) {
+			lwc_string_unref(s);
+			return 0;
+		}
+		sheet->layers = grown;
+	}
+	sheet->layers[sheet->n_layers++] = s;
+	return (uint16_t) sheet->n_layers;
+}
