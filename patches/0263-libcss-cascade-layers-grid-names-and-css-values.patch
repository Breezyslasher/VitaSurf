+/*
+ * Cascade layer order (VitaSurf).
+ *
+ * Every layer the document's sheets name, taken in the order they are
+ * first named, is ranked so that a layer comes after those named before
+ * it and after the layers inside it -- "a.b" before "a", whose own
+ * rules beat its sublayers' -- and rules in no layer come after all of
+ * them. The rank is written into each rule, where the cascade reads it
+ * next to the specificity.
+ */
+static lwc_string **layer_all;
+static uint32_t layer_n;
+
+static uint32_t layer_pos(const char *name, size_t len)
+{
+	uint32_t i;
+
+	for (i = 0; i < layer_n; i++) {
+		if (lwc_string_length(layer_all[i]) == len &&
+				memcmp(lwc_string_data(layer_all[i]), name,
+				len) == 0)
+			return i;
+	}
+	return UINT32_MAX;
+}
+
+static int layer_cmp(const void *pa, const void *pb)
+{
+	lwc_string *a = layer_all[*(const uint32_t *) pa];
+	lwc_string *b = layer_all[*(const uint32_t *) pb];
+	const char *da = lwc_string_data(a), *db = lwc_string_data(b);
+	size_t la = lwc_string_length(a), lb = lwc_string_length(b);
+	size_t i = 0, ea, eb;
+
+	/* the first component where they part */
+	for (;;) {
+		ea = i;
+		while (ea < la && da[ea] != '.')
+			ea++;
+		eb = i;
+		while (eb < lb && db[eb] != '.')
+			eb++;
+		if (ea != eb || memcmp(da + i, db + i, ea - i) != 0)
+			break;
+		if (ea == la || eb == lb) {
+			/* one is inside the other, and goes first */
+			if (la == lb)
+				return 0;
+			return la > lb ? -1 : 1;
+		}
+		i = ea + 1;
+	}
+	/* siblings there: whichever was named first */
+	{
+		uint32_t pa_ = layer_pos(da, ea), pb_ = layer_pos(db, eb);
+
+		return pa_ < pb_ ? -1 : (pa_ > pb_ ? 1 : 0);
+	}
+}
+
+static void layer_rank_rules(css_rule *r, const uint16_t *rank,
+		uint32_t n_local)
+{
+	for (; r != NULL; r = r->next) {
+		r->layer_rank = (r->layer != 0 && r->layer <= n_local) ?
+				rank[r->layer - 1] : CSS_LAYER_NONE;
+		if (r->type == CSS_RULE_MEDIA)
+			layer_rank_rules(((css_rule_media *) r)->first_child,
+					rank, n_local);
+	}
+}
+
+static void select_ctx_rank_layers(css_select_ctx *ctx)
+{
+	uint32_t i, j, *order = NULL;
+	uint16_t *rank_of = NULL;
+
+	layer_n = 0;
+	free(layer_all);
+	layer_all = NULL;
+
+	for (i = 0; i < ctx->n_flat; i++) {
+		const css_stylesheet *s = ctx->flat[i].sheet;
+
+		for (j = 0; j < s->n_layers; j++) {
+			uint32_t k;
+
+			for (k = 0; k < layer_n; k++) {
+				if (layer_all[k] == s->layers[j])
+					break;
+			}
+			if (k < layer_n)
+				continue;
+			if ((layer_n & 15) == 0) {
+				lwc_string **g = realloc(layer_all,
+						(layer_n + 16) * sizeof(*g));
+
+				if (g == NULL)
+					goto out;
+				layer_all = g;
+			}
+			layer_all[layer_n++] = s->layers[j];
+		}
+	}
+
+	if (layer_n > 0) {
+		order = malloc(layer_n * sizeof(*order));
+		rank_of = malloc(layer_n * sizeof(*rank_of));
+		if (order == NULL || rank_of == NULL)
+			goto out;
+		for (i = 0; i < layer_n; i++)
+			order[i] = i;
+		qsort(order, layer_n, sizeof(*order), layer_cmp);
+		for (i = 0; i < layer_n; i++)
+			rank_of[order[i]] = (uint16_t) (i + 1);
+	}
+
+	for (i = 0; i < ctx->n_flat; i++) {
+		css_stylesheet *s = (css_stylesheet *) ctx->flat[i].sheet;
+		uint16_t local[256], *map = local;
+
+		if (s->n_layers > 256) {
+			map = malloc(s->n_layers * sizeof(*map));
+			if (map == NULL)
+				continue;
+		}
+		for (j = 0; j < s->n_layers; j++) {
+			uint32_t k;
+
+			map[j] = CSS_LAYER_NONE;
+			for (k = 0; rank_of != NULL && k < layer_n; k++) {
+				if (layer_all[k] == s->layers[j]) {
+					map[j] = rank_of[k];
+					break;
+				}
+			}
+		}
+		layer_rank_rules(s->rule_list, map, s->n_layers);
+		if (map != local)
+			free(map);
+	}
+
+out:
+	free(order);
+	free(rank_of);
+}
