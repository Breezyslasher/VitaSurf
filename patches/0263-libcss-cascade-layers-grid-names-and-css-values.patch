+	case CSS_LINE_HEIGHT_DIMENSION:
+		switch (unit) {
+		case CSS_UNIT_PX:
+			return len.value;
+		case CSS_UNIT_EM:
+			return FMUL(fs, len.value);
+		case CSS_UNIT_PCT:
+			return FDIV(FMUL(fs, len.value), F_100);
