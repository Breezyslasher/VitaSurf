+/**
+ * Read the names an @layer prelude gives (VitaSurf): "a", "a.b",
+ * "a, b". Each is registered with the sheet, inside the layer the
+ * at-rule is itself in, and the last one's id is returned; one with no
+ * name is a layer of its own that nothing else can name.
+ */
+static uint16_t layerNames(css_language *c, const parserutils_vector *vector,
+		int32_t ctx, css_rule *parent)
+{
+	static uint32_t anonymous;
+	char name[512];
+	size_t len, plen = 0;
+	uint16_t id = 0;
+	const css_token *t;
+
+	if (parent != NULL && parent->layer != 0 &&
+			parent->layer <= c->sheet->n_layers) {
+		lwc_string *p = c->sheet->layers[parent->layer - 1];
+
+		plen = lwc_string_length(p);
+		if (plen + 2 >= sizeof(name))
+			return parent->layer;
+		memcpy(name, lwc_string_data(p), plen);
+		name[plen++] = '.';
+	}
+
+	for (;;) {
+		consumeWhitespace(vector, &ctx);
+		t = parserutils_vector_peek(vector, ctx);
+		if (t == NULL || t->type != CSS_TOKEN_IDENT)
+			break;
+		len = plen;
+		for (;;) {
+			size_t n = lwc_string_length(t->idata);
+
+			if (len + n + 1 >= sizeof(name))
+				return id;
+			memcpy(name + len, lwc_string_data(t->idata), n);
+			len += n;
+			parserutils_vector_iterate(vector, &ctx);
+			t = parserutils_vector_peek(vector, ctx);
+			if (t == NULL || !tokenIsChar(t, '.'))
+				break;
+			t = parserutils_vector_peek(vector, ctx + 1);
+			if (t == NULL || t->type != CSS_TOKEN_IDENT)
+				break;
+			name[len++] = '.';
+			parserutils_vector_iterate(vector, &ctx);
+		}
+		id = css__stylesheet_layer_id(c->sheet, name, len);
+		consumeWhitespace(vector, &ctx);
+		t = parserutils_vector_peek(vector, ctx);
+		if (t == NULL || !tokenIsChar(t, ','))
+			break;
+		parserutils_vector_iterate(vector, &ctx);
+	}
+
+	if (id == 0) {
+		/* "@layer { }": anonymous, and distinct from every other */
+		len = plen + (size_t) snprintf(name + plen,
+				sizeof(name) - plen, "\x01%u", ++anonymous);
+		id = css__stylesheet_layer_id(c->sheet, name, len);
+	}
+	return id;
+}
