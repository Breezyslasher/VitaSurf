+/*
+ * Grid line and area names (VitaSurf). One table for the process, only
+ * ever added to: a placement names a line with an id rather than a
+ * string, and the names a page uses are few.
+ */
+static lwc_string **grid_names;
+static uint32_t n_grid_names;
+
+uint32_t css__grid_name_id(const char *name, size_t len)
+{
+	lwc_string *s;
+	uint32_t i;
+
+	if (len == 0 || lwc_intern_string(name, len, &s) != lwc_error_ok)
+		return 0;
+	for (i = 0; i < n_grid_names; i++) {
+		if (grid_names[i] == s) {
+			lwc_string_unref(s);
+			return i + 1;
+		}
+	}
+	if (n_grid_names + 1 >= CSS_GRID_LINE_NAME_BASE) {
+		lwc_string_unref(s);
+		return 0;
