+				break;
+			case CALC_REM:
+				a = a - b * trunc(q);
+				break;
+			case CALC_ROUND_UP:
+				a = ceil(q) * b;
+				break;
+			case CALC_ROUND_DOWN:
+				a = floor(q) * b;
+				break;
+			case CALC_ROUND_ZERO:
+				a = trunc(q) * b;
+				break;
+			default:
+				a = floor(q + 0.5) * b;
+				break;
+			}
+			CALC_PUSH(u_left, FLTTOFIX(a));
+			break;
+		}
 		case CALC_FINISH: /* Should not happen */
 		default:
