+/**
+ * A box's mask image when it is a gradient (VitaSurf), which is painted
+ * rather than fetched: the gradient's spec after "gradient:", or NULL.
+ */
+static const char *html_mask_gradient(struct box *box)
+{
+	lwc_string *uri = NULL;
+
+	/* text shares its element's style, and is masked with it */
+	if (box->type == BOX_TEXT)
+		return NULL;
+	if (box->style == NULL || css_computed_mask_image(box->style,
+			&uri) != CSS_MASK_IMAGE_IMAGE || uri == NULL ||
+			strncmp(lwc_string_data(uri), "gradient:", 9) != 0)
+		return NULL;
+	return lwc_string_data(uri) + 9;
+}
+
+/**
+ * Copy a gradient spec with every stop in one colour, keeping each
+ * stop's alpha scaled by the colour's (VitaSurf). A gradient mask is a
+ * run of alphas, and this turns it into the colour to paint through it.
+ *
+ * \param spec    Gradient spec, after "gradient:"
+ * \param argb    Colour to paint, 0xAARRGGBB as libcss gives it
+ * \param out     Where the new spec goes
+ * \param outlen  Size of out
+ * \return false if out is too small
+ */
+static bool html_gradient_recolour(const char *spec, uint32_t argb,
+		char *out, size_t outlen)
+{
+	const char *p = strchr(spec, ':');
+	size_t n;
+
+	if (p == NULL || (size_t) (p + 1 - spec) >= outlen)
+		return false;
+	n = p + 1 - spec;
+	memcpy(out, spec, n);
+	p++;
+	while (*p != '\0') {
+		char *end;
+		uint32_t c = (uint32_t) strtoul(p, &end, 16);
+		uint32_t a = ((c >> 24) * (argb >> 24) + 127) / 255;
+		const char *next = strchr(end, ',');
+		size_t rest = next != NULL ? (size_t) (next + 1 - end) :
+				strlen(end);
+		int w;
+
+		if (end == p)
+			return false;
+		w = snprintf(out + n, outlen - n, "%08x",
+				(unsigned int) ((a << 24) |
+				(argb & 0xffffff)));
+		if (w < 0 || n + (size_t) w + rest >= outlen)
+			return false;
+		n += (size_t) w;
+		memcpy(out + n, end, rest);
+		n += rest;
+		p = end + rest;
+	}
+	out[n] = '\0';
+	return true;
+}
