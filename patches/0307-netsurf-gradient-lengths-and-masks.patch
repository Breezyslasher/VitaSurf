+/**
+ * Add the lengths in a gradient's stops to their positions, now that the
+ * gradient line's length is known, and keep each stop no earlier than
+ * the one before it (VitaSurf). libcss could do neither, not knowing
+ * the box.
+ *
+ * \param pos    Stop positions in tenths of a percent, updated
+ * \param px     Lengths in CSS pixels to add to them
+ * \param n      Number of stops
+ * \param len    The gradient line's length in device pixels
+ * \param scale  Device pixels to a CSS pixel
+ */
+static void html_gradient_lengths(int *pos, const int *px, int n, int len,
+		float scale)
+{
+	bool any = false;
+	int i;
+
+	for (i = 0; i < n; i++) {
+		if (px[i] != 0) {
+			pos[i] += (int) (px[i] * scale * 1000.0f / len);
+			any = true;
+		}
+	}
+	if (!any)
+		return;
+	for (i = 1; i < n; i++) {
+		if (pos[i] < pos[i - 1])
+			pos[i] = pos[i - 1];
+	}
+}
