+/**
+ * Plot a bitmap as a CSS mask (VitaSurf): a temporary copy carries the
+ * source alpha and the mask colour in every pixel.
+ */
+static bool image_bitmap_plot_mask(struct bitmap *bitmap,
+		       struct content_redraw_data *data,
+		       const struct rect *clip,
+		       const struct redraw_context *ctx)
+{
+	int width = guit->bitmap->get_width(bitmap);
+	int height = guit->bitmap->get_height(bitmap);
+	struct bitmap *tinted;
+	const uint8_t *src;
+	uint8_t *dst;
+	size_t src_stride, dst_stride;
+	int x, y;
+	bool ok;
+
+	(void)clip;
+	if (width <= 0 || height <= 0) {
+		return true;
+	}
+	tinted = guit->bitmap->create(width, height, BITMAP_NONE);
+	if (tinted == NULL) {
+		return false;
+	}
+	src = guit->bitmap->get_buffer(bitmap);
+	dst = guit->bitmap->get_buffer(tinted);
+	src_stride = guit->bitmap->get_rowstride(bitmap);
+	dst_stride = guit->bitmap->get_rowstride(tinted);
+	if (src == NULL || dst == NULL) {
+		guit->bitmap->destroy(tinted);
+		return false;
+	}
+	for (y = 0; y < height; y++) {
+		const uint8_t *s = src + y * src_stride;
+		uint8_t *d = dst + y * dst_stride;
+
+		for (x = 0; x < width; x++) {
+			colour c = bitmap_pixel_to_colour(s);
+
+			d[bitmap_layout.r] = (data->mask_colour >> 0) & 0xff;
+			d[bitmap_layout.g] = (data->mask_colour >> 8) & 0xff;
+			d[bitmap_layout.b] = (data->mask_colour >> 16) & 0xff;
+			d[bitmap_layout.a] = (c >> 24) & 0xff;
+			s += 4;
+			d += 4;
+		}
+	}
+	guit->bitmap->set_opaque(tinted, false);
+	guit->bitmap->modified(tinted);
+	ok = (ctx->plot->bitmap(ctx, tinted, data->x, data->y,
+				data->width, data->height,
+				data->background_colour,
+				BITMAPF_NONE) == NSERROR_OK);
+	guit->bitmap->destroy(tinted);
+	return ok;
+}
+
 bool image_bitmap_plot(struct bitmap *bitmap,
 		       struct content_redraw_data *data,
 		       const struct rect *clip,
