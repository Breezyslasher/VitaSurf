  * \return true if successful, false otherwise
  */
 
+/**
+ * Whether a box has a CSS mask image (VitaSurf).
+ */
+static bool html_box_masked(struct box *box)
+{
+	lwc_string *uri = NULL;
+
+	return box->style != NULL &&
+		css_computed_mask_image(box->style, &uri) == CSS_MASK_IMAGE_IMAGE &&
+		uri != NULL;
+}
+
+/**
+ * Paint a masked box: its background colour through the mask image, which
+ * is fitted inside the padding box and centred, as mask-size: contain and
+ * mask-position: center would. Nothing is painted until the mask has
+ * loaded, since a missing mask hides the element entirely.
+ *
+ * \param x, y   padding box origin in device pixels
+ * \param pw, ph padding box size in device pixels
+ */
+static bool html_redraw_mask(int x, int y, int pw, int ph, struct box *box,
+		float scale, const struct rect *clip,
+		const struct redraw_context *ctx)
+{
+	css_color bgcol;
+	struct content_redraw_data data;
+	struct rect r = *clip;
+	int iw, ih, mw, mh;
+
+	if (box->mask == NULL ||
+	    (content_get_status(box->mask) != CONTENT_STATUS_READY &&
+	     content_get_status(box->mask) != CONTENT_STATUS_DONE)) {
+		return true;
+	}
+	css_computed_background_color(box->style, &bgcol);
+	if (nscss_color_is_transparent(bgcol)) {
+		return true;
+	}
+	iw = content_get_width(box->mask);
+	ih = content_get_height(box->mask);
+	if (iw <= 0 || ih <= 0 || pw <= 0 || ph <= 0) {
+		return true;
+	}
+	mw = iw * scale;
+	mh = ih * scale;
+	if (mw > pw || mh > ph) {
+		/* contain */
+		if ((long)mw * ph > (long)mh * pw) {
+			mh = mh * pw / mw;
+			mw = pw;
+		} else {
+			mw = mw * ph / mh;
+			mh = ph;
+		}
+	}
+	if (mw <= 0 || mh <= 0) {
+		return true;
+	}
+	if (r.x0 < x) r.x0 = x;
+	if (r.y0 < y) r.y0 = y;
+	if (r.x1 > x + pw) r.x1 = x + pw;
+	if (r.y1 > y + ph) r.y1 = y + ph;
+	if (r.x0 >= r.x1 || r.y0 >= r.y1) {
+		return true;
+	}
+	if (ctx->plot->clip(ctx, &r) != NSERROR_OK) {
+		return false;
+	}
+	data.x = x + (pw - mw) / 2;
+	data.y = y + (ph - mh) / 2;
+	data.width = mw;
+	data.height = mh;
+	data.background_colour = nscss_color_to_ns(bgcol);
+	data.scale = scale;
+	data.repeat_x = false;
+	data.repeat_y = false;
+	data.mask = true;
+	data.mask_colour = nscss_color_to_ns(bgcol);
+	content_redraw(box->mask, &data, &r, ctx);
+	return ctx->plot->clip(ctx, clip) == NSERROR_OK;
+}
