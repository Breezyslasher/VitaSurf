+/*
+ * "[object X]" for a built-in tag X (VitaSurf), the same atom each time:
+ * Object.prototype.toString.call(v) is how libraries test a value's kind
+ * (video.js's merge on Amazon, lodash, jQuery), and each call made the
+ * string afresh to compare it with a literal; as an atom it is the
+ * literal's own string, which compares by address. key is a predefined
+ * atom, never freed.
+ */
+static JSValue js_object_tostring_atom(JSContext *ctx, JSAtom key,
+                                       const char *name)
+{
+    JSRuntime *rt = ctx->rt;
+    char buf[64], tmp[ATOM_GET_STR_BUF_SIZE];
+    JSAtom a;
+    int i;
+
+    for (i = 0; i < rt->tostring_count; i++) {
+        if (rt->tostring_key[i] == key)
+            return JS_AtomToString(ctx, rt->tostring_val[i]);
+    }
+    if (!name)
+        name = JS_AtomGetStr(ctx, tmp, sizeof(tmp), key);
+    snprintf(buf, sizeof(buf), "[object %s]", name);
+    a = JS_NewAtom(ctx, buf);
+    if (a == JS_ATOM_NULL)
+        return JS_EXCEPTION;
+    if (rt->tostring_count < countof(rt->tostring_key)) {
+        rt->tostring_key[rt->tostring_count] = key;
+        rt->tostring_val[rt->tostring_count++] = a;
+        return JS_AtomToString(ctx, a);
+    }
+    {
+        JSValue v = JS_AtomToString(ctx, a);
+        JS_FreeAtom(ctx, a);
+        return v;
+    }
+}
+
 static JSValue js_object_toString(JSContext *ctx, JSValueConst this_val,
                                   int argc, JSValueConst *argv)
 {
@@ -43817,9 +43863,9 @@ static JSValue js_object_toString(JSContext *ctx, JSValueConst this_val,
     JSObject *p;
 
     if (JS_IsNull(this_val)) {
-        tag = js_new_string8(ctx, "Null");
+        return js_object_tostring_atom(ctx, JS_ATOM_null, "Null");
     } else if (JS_IsUndefined(this_val)) {
-        tag = js_new_string8(ctx, "Undefined");
+        return js_object_tostring_atom(ctx, JS_ATOM_undefined, "Undefined");
     } else {
         obj = JS_ToObject(ctx, this_val);
         if (JS_IsException(obj))
@@ -43857,7 +43903,7 @@ static JSValue js_object_toString(JSContext *ctx, JSValueConst this_val,
             return JS_EXCEPTION;
         if (!JS_IsString(tag)) {
             JS_FreeValue(ctx, tag);
-            tag = JS_AtomToString(ctx, atom);
+            return js_object_tostring_atom(ctx, atom, NULL);
         }
     }
     return JS_ConcatString3(ctx, "[object ", tag, "]");
