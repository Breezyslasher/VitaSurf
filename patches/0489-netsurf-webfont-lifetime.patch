+/* the advance cache, below, keeps rows by face */
+static void fb_adv_forget(FTC_FaceID face_id);
+
+/** One web face's entry, out of FreeType's cache and ours (VitaSurf). */
+static void fb_web_face_free(fb_faceid_t *f)
+{
+	if (f == NULL)
+		return;
+	FTC_Manager_RemoveFaceID(ft_cmanager, (FTC_FaceID) f);
+	fb_adv_forget((FTC_FaceID) f);
+	free(f->liga);
+	free(f->liga_pool);
+	free(f->liga_starts);
+	free(f->liga_seconds);
+	free(f);
+}
+
+/**
+ * Let go of a web font face (VitaSurf). See gui_layout_table.remove_face.
+ * Its weighted instances share its bytes, which go last.
+ */
+static nserror fb_font_remove_face(const char *family, int weight,
+		bool italic)
+{
+	struct fb_webface **pp, *wf;
+
+	for (pp = &fb_webfaces; (wf = *pp) != NULL; pp = &wf->next) {
+		uint8_t *data;
+		int i;
+
+		if (wf->weight != weight || wf->italic != italic ||
+				strcasecmp(wf->family, family) != 0)
+			continue;
+		*pp = wf->next;
+		data = wf->face->data;
+		for (i = 0; i < 9; i++)
+			fb_web_face_free(wf->at_weight[i]);
+		fb_web_face_free(wf->face);
+		free(data);
+		free(wf->family);
+		free(wf);
+		return NSERROR_OK;
+	}
+	return NSERROR_NOT_FOUND;
+}
