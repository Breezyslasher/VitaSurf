+		llcache_handle_abort(wf->fetch);
+		llcache_handle_release(wf->fetch);
+		wf->fetch = NULL;
+	}
+	if (wf->state == WEBFONT_LOADED) {
+		guit->layout->remove_face(wf->family, wf->weight, wf->italic);
