+/** Note a page as using a face; false if it could not be noted. */
+static bool webfont_use(struct webfont *wf, struct html_content *html)
+{
+	unsigned i;
+
+	for (i = 0; i < wf->n_users; i++) {
+		if (wf->users[i] == html)
+			return true;
+	}
+	if (wf->n_users == wf->cap_users) {
+		unsigned ncap = wf->cap_users == 0 ? 2 : wf->cap_users * 2;
+		struct html_content **n = realloc(wf->users,
+				ncap * sizeof(*n));
+
+		if (n == NULL)
+			return false;
+		wf->users = n;
+		wf->cap_users = ncap;
+	}
+	wf->users[wf->n_users++] = html;
+	return true;
