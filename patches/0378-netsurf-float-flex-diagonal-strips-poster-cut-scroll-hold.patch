+/*
+ * How long the view has to have been still before arriving objects lay
+ * the page out again (VitaSurf). Yamtrack's posters arrive as the page
+ * is scrolled, and each batch laid the whole page out again, 176 ms on
+ * the Vita, in the middle of the scroll. Their boxes are drawn with the
+ * pictures meanwhile at the size they were laid out at; the layout
+ * follows once scrolling stops.
+ */
+#define HTML_OBJECT_STILL_MS 300
+
+static bool html_object_view_moving(uint64_t ms_now)
+{
+	return vitasurf_view_moved_ms != 0 &&
+		ms_now - vitasurf_view_moved_ms < HTML_OBJECT_STILL_MS;
+}
