diff --git a/frontends/framebuffer/framebuffer.c b/frontends/framebuffer/framebuffer.c
index f4619d65c..d03ed01e2 100644
--- a/frontends/framebuffer/framebuffer.c
+++ b/frontends/framebuffer/framebuffer.c
@@ -1269,6 +1269,54 @@ framebuffer_plot_bitmap(const struct redraw_context *ctx,
 
 
 #ifdef FB_USE_FREETYPE
+/**
+ * A glyph whose colour is partly transparent (VitaSurf): libnsfb's glyph
+ * plotters take the colour's alpha as opaque, so its coverage is scaled
+ * by the alpha into a buffer of its own, which glyph8 then lays over
+ * what is there. A glyph too big for the buffer is drawn as it is.
+ */
+static void
+fb_plot_glyph_alpha(nsfb_bbox_t *loc, const FT_Bitmap *bm,
+		nsfb_colour_t colour, unsigned int alpha)
+{
+	static uint8_t *buf = NULL;
+	static size_t buf_size = 0;
+	size_t need = (size_t) bm->width * bm->rows;
+	unsigned int r, c;
+	bool mono = bm->pixel_mode == FT_PIXEL_MODE_MONO;
+
+	if (need == 0)
+		return;
+	if (need > buf_size) {
+		uint8_t *n = need <= 65536 ? realloc(buf, need) : NULL;
+
+		if (n == NULL) {
+			if (mono)
+				nsfb_plot_glyph1(nsfb, loc, bm->buffer,
+						 bm->pitch, colour);
+			else
+				nsfb_plot_glyph8(nsfb, loc, bm->buffer,
+						 bm->pitch, colour);
+			return;
+		}
+		buf = n;
+		buf_size = need;
+	}
+	for (r = 0; r < bm->rows; r++) {
+		const uint8_t *row = bm->buffer + (int) r * bm->pitch;
+		uint8_t *out = buf + (size_t) r * bm->width;
+
+		for (c = 0; c < bm->width; c++) {
+			unsigned int cover = mono ?
+				((row[c >> 3] >> (7 - (c & 7))) & 1) * 255 :
+				row[c];
+
+			out[c] = (uint8_t) ((cover * alpha + 127) / 255);
+		}
+	}
+	nsfb_plot_glyph8(nsfb, loc, buf, (int) bm->width, colour);
+}
+
