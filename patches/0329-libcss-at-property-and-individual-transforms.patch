+
+/*
+ * scale (VitaSurf). The parser writes it as a transform holding
+ * that one function would be written: the translation, the matrix and
+ * the angle. Only the two factors, the matrix's
+ * diagonal, are kept.
+ */
+static uint16_t scale_read(uint32_t opv, css_style *style,
+		css_fixed t[2], uint32_t tu[2], css_fixed m[4], css_fixed *angle)
+{
+	uint16_t value = CSS_SCALE_INHERIT;
+	int i;
+
+	t[0] = t[1] = 0;
+	tu[0] = tu[1] = UNIT_PX;
+	m[0] = m[3] = INTTOFIX(1);
+	m[1] = m[2] = 0;
+	*angle = 0;
+
+	if (hasFlagValue(opv) == false) {
+		value = (getValue(opv) == TRANSFORM_NONE) ?
+				CSS_SCALE_NONE : CSS_SCALE_SET;
+	}
+
+	if (value == CSS_SCALE_SET) {
+		for (i = 0; i < 2; i++) {
+			t[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(t[i]));
+			tu[i] = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(tu[i]));
+		}
+		for (i = 0; i < 4; i++) {
+			m[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(m[i]));
+		}
+		*angle = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(*angle));
+	}
+
+	return value;
+}
+
+css_error css__cascade_scale(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	css_fixed t[2], m[4], angle;
+	uint32_t tu[2];
+	uint16_t value = scale_read(opv, style, t, tu, m, &angle);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_scale(state->computed, value, m[0], m[3]);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_scale_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
+	UNUSED(style);
+	return CSS_OK;
+}
+
+css_error css__initial_scale(css_select_state *state)
+{
+	return set_scale(state->computed, CSS_SCALE_NONE,
+			INTTOFIX(1), INTTOFIX(1));
+}
+
+css_error css__copy_scale(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed x = INTTOFIX(1), y = INTTOFIX(1);
+	uint8_t type = get_scale(from, &x, &y);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_scale(to, type, x, y);
+}
+
+css_error css__compose_scale(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed x = INTTOFIX(1), y = INTTOFIX(1);
+	uint8_t type = get_scale(child, &x, &y);
+
+	return css__copy_scale(
+			type == CSS_SCALE_INHERIT ? parent : child,
+			result);
+}
