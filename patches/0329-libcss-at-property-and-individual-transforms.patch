+/*
+ * translate (VitaSurf). The parser writes it as a transform holding
+ * that one function would be written: the translation, the matrix and
+ * the angle. Only the translation is kept.
+ */
+static uint16_t translate_read(uint32_t opv, css_style *style,
+		css_fixed t[2], uint32_t tu[2], css_fixed m[4], css_fixed *angle)
+{
+	uint16_t value = CSS_TRANSLATE_INHERIT;
+	int i;
+
+	t[0] = t[1] = 0;
+	tu[0] = tu[1] = UNIT_PX;
+	m[0] = m[3] = INTTOFIX(1);
+	m[1] = m[2] = 0;
+	*angle = 0;
+
+	if (hasFlagValue(opv) == false) {
+		value = (getValue(opv) == TRANSFORM_NONE) ?
+				CSS_TRANSLATE_NONE : CSS_TRANSLATE_SET;
+	}
+
+	if (value == CSS_TRANSLATE_SET) {
+		for (i = 0; i < 2; i++) {
+			t[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(t[i]));
+			tu[i] = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(tu[i]));
+		}
+		for (i = 0; i < 4; i++) {
+			m[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(m[i]));
+		}
+		*angle = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(*angle));
+	}
+
+	return value;
+}
+
+css_error css__cascade_translate(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	css_fixed t[2], m[4], angle;
+	uint32_t tu[2];
+	uint16_t value = translate_read(opv, style, t, tu, m, &angle);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_translate(state->computed, value,
+				t[0], css__to_css_unit(tu[0]),
+				t[1], css__to_css_unit(tu[1]));
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_translate_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
