+/*
+ * Custom properties registered by @property (VitaSurf).
+ *
+ * The registrations live on the sheet that made them, so they go where
+ * the sheet goes, cached and shared between documents or not. A var()
+ * is resolved while its declaring sheet is parsed and again while each
+ * element is selected; during selection the other sheets of the
+ * selection are searched too, since a site may register in one sheet
+ * and spend in another. subst_inherited is the map the element's
+ * parent had: an element whose map is that one declared no variable
+ * of its own.
+ */
+static const css_stylesheet *const *subst_sheets;
+static uint32_t subst_n_sheets;
+static const css_custom_map *subst_inherited;
+static bool subst_scoped;
+
+/* exported interface documented in parse/language.h */
+void css__language_subst_scope(const css_stylesheet *const *sheets,
+		uint32_t n, const css_custom_map *inherited)
+{
+	subst_sheets = sheets;
+	subst_n_sheets = (sheets != NULL) ? n : 0;
+	subst_inherited = inherited;
+	subst_scoped = (sheets != NULL);
+}
+
+static inline uint32_t registeredSlot(uint32_t n_slots, lwc_string *name)
+{
+	uint32_t h = (uint32_t) ((uintptr_t) name >> 4);
+
+	h *= 2654435761u;
+	return (h >> 7) & (n_slots - 1);
+}
+
+static const css_registered_prop *registeredIn(const css_stylesheet *sheet,
+		lwc_string *name)
+{
+	uint32_t i;
+
+	if (sheet == NULL || sheet->n_registered == 0)
+		return NULL;
+
+	for (i = registeredSlot(sheet->n_registered_slots, name); ;
+			i = (i + 1) & (sheet->n_registered_slots - 1)) {
+		const css_registered_prop *rp = &sheet->registered[i];
+
+		if (rp->name == NULL)
+			return NULL;
+		if (rp->name == name)
+			return rp;
+	}
+}
+
+static const css_registered_prop *findRegistered(css_language *c,
+		lwc_string *name)
+{
+	const css_registered_prop *rp = registeredIn(c->sheet, name);
+	uint32_t i;
+
+	for (i = 0; rp == NULL && i < subst_n_sheets; i++) {
+		if (subst_sheets[i] != c->sheet)
+			rp = registeredIn(subst_sheets[i], name);
+	}
+	return rp;
+}
+
+/** Register a property; a later registration of the name replaces it. */
+static css_error registerProperty(css_stylesheet *sheet, lwc_string *name,
+		css_token *initial, uint32_t n_initial, bool inherits)
+{
+	css_registered_prop *rp;
+	uint32_t i;
+
+	if ((sheet->n_registered + 1) * 2 > sheet->n_registered_slots) {
+		uint32_t want = (sheet->n_registered_slots == 0) ? 16 :
+				sheet->n_registered_slots * 2;
+		css_registered_prop *fresh = calloc(want, sizeof(*fresh));
+
+		if (fresh == NULL)
+			return CSS_NOMEM;
+		for (i = 0; i < sheet->n_registered_slots; i++) {
+			uint32_t j;
+
+			if (sheet->registered[i].name == NULL)
+				continue;
+			for (j = registeredSlot(want,
+					sheet->registered[i].name);
+					fresh[j].name != NULL;
+					j = (j + 1) & (want - 1))
+				;
+			fresh[j] = sheet->registered[i];
+		}
+		free(sheet->registered);
+		sheet->registered = fresh;
+		sheet->n_registered_slots = want;
+	}
+
+	for (i = registeredSlot(sheet->n_registered_slots, name);
+			sheet->registered[i].name != NULL &&
+			sheet->registered[i].name != name;
+			i = (i + 1) & (sheet->n_registered_slots - 1))
+		;
+	rp = &sheet->registered[i];
+	if (rp->name != NULL) {
+		freeCustomTokens(rp->initial, rp->n_initial);
+	} else {
+		rp->name = lwc_string_ref(name);
+		sheet->n_registered++;
+	}
+	rp->initial = initial;
+	rp->n_initial = n_initial;
+	rp->inherits = inherits;
+	return CSS_OK;
+}
+
+static void propRuleReset(css_language *c)
+{
+	if (c->prop_name != NULL)
+		lwc_string_unref(c->prop_name);
+	c->prop_name = NULL;
+	if (c->prop_initial != NULL)
+		freeCustomTokens(c->prop_initial, c->prop_n_initial);
+	c->prop_initial = NULL;
+	c->prop_n_initial = 0;
+	c->prop_inherits = -1;
+	c->prop_syntax = -1;
+}
+
+/**
+ * Read one descriptor of an @property rule: syntax, inherits or
+ * initial-value. Anything else is ignored.
+ */
+static css_error handlePropertyDescriptor(css_language *c,
+		const parserutils_vector *vector)
+{
+	const css_token *ident, *token;
+	int32_t ctx = 0, end, i;
+
+	consumeWhitespace(vector, &ctx);
+	ident = parserutils_vector_iterate(vector, &ctx);
+	if (ident == NULL || ident->type != CSS_TOKEN_IDENT)
+		return CSS_INVALID;
+	consumeWhitespace(vector, &ctx);
+	token = parserutils_vector_iterate(vector, &ctx);
+	if (token == NULL || tokenIsChar(token, ':') == false)
+		return CSS_INVALID;
+	consumeWhitespace(vector, &ctx);
+
+	end = ctx;
+	while (parserutils_vector_peek(vector, end) != NULL)
+		end++;
+	while (end > ctx && ((token = parserutils_vector_peek(vector,
+			end - 1)) == NULL || token->type == CSS_TOKEN_S ||
+			tokenIsChar(token, ';')))
+		end--;
+
+	if (nameIs(ident->idata, "inherits")) {
+		token = parserutils_vector_peek(vector, ctx);
+		if (end != ctx + 1 || token->type != CSS_TOKEN_IDENT)
+			return CSS_INVALID;
+		if (nameIs(token->idata, "true"))
+			c->prop_inherits = 1;
+		else if (nameIs(token->idata, "false"))
+			c->prop_inherits = 0;
+		else
+			return CSS_INVALID;
+	} else if (nameIs(ident->idata, "syntax")) {
+		const char *d;
+		size_t len, k, stars = 0, other = 0;
+
+		token = parserutils_vector_peek(vector, ctx);
+		if (end != ctx + 1 || token->type != CSS_TOKEN_STRING)
+			return CSS_INVALID;
+		d = lwc_string_data(token->idata);
+		len = lwc_string_length(token->idata);
+		for (k = 0; k < len; k++) {
+			if (d[k] == '*')
+				stars++;
+			else if (d[k] != ' ' && d[k] != '\t')
+				other++;
+		}
+		c->prop_syntax = (stars == 1 && other == 0) ? 1 : 0;
+	} else if (nameIs(ident->idata, "initial-value")) {
+		uint32_t n = (uint32_t) (end - ctx);
+		css_token *tokens = NULL;
+
+		if (n > 0) {
+			tokens = malloc(n * sizeof(css_token));
+			if (tokens == NULL)
+				return CSS_NOMEM;
+			for (i = 0; i < (int32_t) n; i++)
+				copyToken(&tokens[i], parserutils_vector_peek(
+						vector, ctx + i));
+		}
+		if (c->prop_initial != NULL)
+			freeCustomTokens(c->prop_initial, c->prop_n_initial);
+		c->prop_initial = tokens;
+		c->prop_n_initial = n;
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Make the registration an @property rule describes, now its block is
+ * read. syntax and inherits are required, and initial-value is too
+ * unless the syntax is the universal one.
+ */
+static css_error propRuleCommit(css_language *c)
+{
+	css_error error = CSS_OK;
+
+	if (c->prop_name != NULL && c->prop_syntax >= 0 &&
+			c->prop_inherits >= 0 &&
+			(c->prop_syntax == 1 || c->prop_n_initial > 0)) {
+		error = registerProperty(c->sheet, c->prop_name,
+				c->prop_initial, c->prop_n_initial,
+				c->prop_inherits == 1);
+		if (error == CSS_OK) {
+			/* the sheet owns the tokens now */
+			c->prop_initial = NULL;
+			c->prop_n_initial = 0;
+		}
+	}
+	propRuleReset(c);
+	return error;
+}
