diff --git a/src/select/properties/rotate.c b/src/select/properties/rotate.c
new file mode 100644
index 0000000..0d3ad9f
--- /dev/null
+++ b/src/select/properties/rotate.c
@@ -0,0 +1,113 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/*
+ * rotate (VitaSurf). The parser writes it as a transform holding
+ * that one function would be written: the translation, the matrix and
+ * the angle. The matrix is kept, and the angle
+ * is handed to an animation, which blends it as an angle.
+ */
+static uint16_t rotate_read(uint32_t opv, css_style *style,
+		css_fixed t[2], uint32_t tu[2], css_fixed m[4], css_fixed *angle)
+{
+	uint16_t value = CSS_ROTATE_INHERIT;
+	int i;
+
+	t[0] = t[1] = 0;
+	tu[0] = tu[1] = UNIT_PX;
+	m[0] = m[3] = INTTOFIX(1);
+	m[1] = m[2] = 0;
+	*angle = 0;
+
+	if (hasFlagValue(opv) == false) {
+		value = (getValue(opv) == TRANSFORM_NONE) ?
+				CSS_ROTATE_NONE : CSS_ROTATE_SET;
+	}
+
+	if (value == CSS_ROTATE_SET) {
+		for (i = 0; i < 2; i++) {
+			t[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(t[i]));
+			tu[i] = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(tu[i]));
+		}
+		for (i = 0; i < 4; i++) {
+			m[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(m[i]));
+		}
+		*angle = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(*angle));
+	}
+
+	return value;
+}
+
+css_error css__cascade_rotate(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	css_fixed t[2], m[4], angle;
+	uint32_t tu[2];
+	uint16_t value = rotate_read(opv, style, t, tu, m, &angle);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		state->rotate_angle = angle;
+		return set_rotate(state->computed, value,
+				m[0], m[1], m[2], m[3]);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_rotate_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
+	UNUSED(style);
+	return CSS_OK;
+}
+
+css_error css__initial_rotate(css_select_state *state)
+{
+	return set_rotate(state->computed, CSS_ROTATE_NONE,
+			INTTOFIX(1), 0, 0, INTTOFIX(1));
+}
+
+css_error css__copy_rotate(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed a = INTTOFIX(1), b = 0, c = 0, d = INTTOFIX(1);
+	uint8_t type = get_rotate(from, &a, &b, &c, &d);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_rotate(to, type, a, b, c, d);
+}
+
+css_error css__compose_rotate(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed a = INTTOFIX(1), b = 0, c = 0, d = INTTOFIX(1);
+	uint8_t type = get_rotate(child, &a, &b, &c, &d);
+
+	return css__copy_rotate(
+			type == CSS_ROTATE_INHERIT ? parent : child,
+			result);
+}
