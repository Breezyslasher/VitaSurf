+/**
+ * Add a length to one axis of a translation (VitaSurf). Lengths in
+ * different units cannot be added without the box's size, so when both
+ * are non-zero and differ the one already there stands.
+ */
+static void tf_add_len(css_fixed *v, css_unit *u, css_fixed add, css_unit au)
+{
+	if (add == 0)
+		return;
+	if (*v == 0) {
+		*v = add;
+		*u = au;
+	} else if (*u == au) {
+		*v += add;
+	}
+}
+
+/* exported interface documented in select/computed.h */
+uint8_t css__composed_transform(const css_computed_style *style,
+		css_fixed t[2], css_unit tu[2], css_fixed m[4])
+{
+	css_fixed tx[2] = { 0, 0 };
+	css_unit txu[2] = { CSS_UNIT_PX, CSS_UNIT_PX };
+	css_fixed r[4] = { INTTOFIX(1), 0, 0, INTTOFIX(1) };
+	css_fixed x[4] = { INTTOFIX(1), 0, 0, INTTOFIX(1) };
+	css_fixed sx = INTTOFIX(1), sy = INTTOFIX(1);
+	css_fixed rs[4], mx[2];
+	bool any = false;
+
+	t[0] = t[1] = 0;
+	tu[0] = tu[1] = CSS_UNIT_PX;
+
+	if (get_translate(style, &t[0], &tu[0], &t[1], &tu[1]) ==
+			CSS_TRANSLATE_SET) {
+		any = true;
+	} else {
+		t[0] = t[1] = 0;
+		tu[0] = tu[1] = CSS_UNIT_PX;
+	}
+	if (get_rotate(style, &r[0], &r[1], &r[2], &r[3]) == CSS_ROTATE_SET) {
+		any = true;
+	} else {
+		r[0] = r[3] = INTTOFIX(1);
+		r[1] = r[2] = 0;
+	}
+	if (get_scale(style, &sx, &sy) == CSS_SCALE_SET) {
+		any = true;
+	} else {
+		sx = sy = INTTOFIX(1);
+	}
+	if (get_transform(style, &tx[0], &txu[0], &tx[1], &txu[1],
+			&x[0], &x[1], &x[2], &x[3]) == CSS_TRANSFORM_SET) {
+		any = true;
+	} else {
+		tx[0] = tx[1] = 0;
+		txu[0] = txu[1] = CSS_UNIT_PX;
+		x[0] = x[3] = INTTOFIX(1);
+		x[1] = x[2] = 0;
+	}
+
+	if (any == false) {
+		m[0] = m[3] = INTTOFIX(1);
+		m[1] = m[2] = 0;
+		return CSS_TRANSFORM_NONE;
+	}
+
+	/* R S, with S the diagonal of the scale */
+	rs[0] = FMUL(r[0], sx);
+	rs[1] = FMUL(r[1], sx);
+	rs[2] = FMUL(r[2], sy);
+	rs[3] = FMUL(r[3], sy);
+
+	/* R S X */
+	m[0] = FMUL(rs[0], x[0]) + FMUL(rs[2], x[1]);
+	m[1] = FMUL(rs[1], x[0]) + FMUL(rs[3], x[1]);
+	m[2] = FMUL(rs[0], x[2]) + FMUL(rs[2], x[3]);
+	m[3] = FMUL(rs[1], x[2]) + FMUL(rs[3], x[3]);
+
+	/*
+	 * transform's own translation goes through the rotation and
+	 * scale in front of it, which can only be done here when both of
+	 * its axes are in one unit; otherwise it is taken as it stands.
+	 */
+	if ((tx[0] != 0 || tx[1] != 0) && (rs[0] != INTTOFIX(1) ||
+			rs[1] != 0 || rs[2] != 0 || rs[3] != INTTOFIX(1)) &&
+			(txu[0] == txu[1] || tx[0] == 0 || tx[1] == 0)) {
+		css_unit u = (tx[0] != 0) ? txu[0] : txu[1];
+
+		mx[0] = FMUL(rs[0], tx[0]) + FMUL(rs[2], tx[1]);
+		mx[1] = FMUL(rs[1], tx[0]) + FMUL(rs[3], tx[1]);
+		txu[0] = txu[1] = u;
+		tx[0] = mx[0];
+		tx[1] = mx[1];
+	}
+	tf_add_len(&t[0], &tu[0], tx[0], txu[0]);
+	tf_add_len(&t[1], &tu[1], tx[1], txu[1]);
+
+	return CSS_TRANSFORM_SET;
+}
