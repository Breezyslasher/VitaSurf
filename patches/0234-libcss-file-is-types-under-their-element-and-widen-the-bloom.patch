+/**
+ * Name the element type a compound requires where :is() hid it (VitaSurf)
+ *
+ * The :is() expansion turns ":is(a, iframe) x" into "*:is(a) x" and
+ * "*:is(iframe) x": the type stays in the compound as an extra element
+ * detail and the compound's own type is left as "*". The selector hash
+ * files a rule by that first type, so these went into the universal
+ * chain and were offered to every element on the page -- on a saved
+ * GitHub page one of them was offered 3,635 times and matched almost
+ * none. The ancestor bloom skipped them the same way.
+ *
+ * Copying the hidden type into the compound's own detail files the rule
+ * under its element and puts the name in the ancestor bloom. The extra
+ * detail stays where it is: matching the type twice gives the same
+ * answer, and specificity was counted when the detail was appended.
+ *
+ * \param selector  The selector chain to fix up
+ */
+static void name_hidden_types(css_selector *selector)
+{
+	for (; selector != NULL; selector = selector->combinator) {
+		css_selector_detail *first = &selector->data;
+		css_selector_detail *d;
+
+		if (first->type != CSS_SELECTOR_ELEMENT || first->negate ||
+				lwc_string_length(first->qname.name) != 1 ||
+				lwc_string_data(first->qname.name)[0] != '*')
+			continue;
+
+		for (d = first; d->next; ) {
+			d++;
+			if (d->type != CSS_SELECTOR_ELEMENT || d->negate)
+				continue;
+			if (lwc_string_length(d->qname.name) == 1 &&
+					lwc_string_data(d->qname.name)[0] ==
+					'*')
+				continue;
+			/* The hash and the bloom read the caseless name */
+			if (d->qname.name->insensitive == NULL)
+				break;
+
+			/* Only the name: the compound's own namespace
+			 * still applies, and the extra detail checks its */
+			lwc_string_unref(first->qname.name);
+			first->qname.name = lwc_string_ref(d->qname.name);
+			break;
+		}
+	}
+}
