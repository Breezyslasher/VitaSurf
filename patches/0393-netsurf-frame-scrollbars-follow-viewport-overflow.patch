+/**
+ * The overflow a frame's document gives its viewport (VitaSurf): the
+ * root element's, or the body's when the root's is visible, which is
+ * where box construction leaves them (CSS 2.1 section 11.1.1). The
+ * frame's scrollbars were chosen from the size of its content alone, so
+ * a document that hides its overflow, as a widget sized to its frame
+ * does, still had both, and they took its room.
+ */
+static void
+browser_window_viewport_overflow(struct hlcache_handle *h,
+				 uint8_t *ox, uint8_t *oy)
+{
+	const css_computed_style *style;
+	struct box *root, *b;
+
+	*ox = *oy = CSS_OVERFLOW_VISIBLE;
+	if (content_get_type(h) != CONTENT_HTML) {
+		return;
+	}
+	root = html_get_box_tree(h);
+	if (root == NULL || root->style == NULL) {
+		return;
+	}
+	style = root->style;
+	if (css_computed_overflow_x(style) == CSS_OVERFLOW_VISIBLE &&
+	    css_computed_overflow_y(style) == CSS_OVERFLOW_VISIBLE) {
+		for (b = root->children; b != NULL; b = b->next) {
+			if ((b->flags & OVERFLOW_VIEWPORT) && b->style != NULL) {
+				style = b->style;
+				break;
+			}
+		}
+	}
+	*ox = css_computed_overflow_x(style);
+	*oy = css_computed_overflow_y(style);
+}
