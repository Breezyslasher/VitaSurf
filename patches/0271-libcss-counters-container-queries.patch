diff --git a/src/parse/properties/container.c b/src/parse/properties/container.c
new file mode 100644
index 0000000..3969c99
--- /dev/null
+++ b/src/parse/properties/container.c
@@ -0,0 +1,207 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+/*
+ * container-type, container-name and the container shorthand
+ * (VitaSurf): what makes an element a container that @container asks
+ * about. The type is normal, size or inline-size; the names are kept
+ * as one string, separated by spaces.
+ */
+
+#include <assert.h>
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+static bool ct_ident_is(const css_token *t, const char *name)
+{
+	size_t n = strlen(name);
+
+	return t != NULL && t->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(t->idata) == n &&
+			strncasecmp(lwc_string_data(t->idata), name, n) == 0;
+}
+
+/** A type keyword, as its opcode, or -1. scroll-state is taken as
+ * normal: nothing here scrolls a container to query. */
+static int ct_type(const css_token *t)
+{
+	if (ct_ident_is(t, "normal") || ct_ident_is(t, "scroll-state"))
+		return CONTAINER_TYPE_NORMAL;
+	if (ct_ident_is(t, "size"))
+		return CONTAINER_TYPE_SIZE;
+	if (ct_ident_is(t, "inline-size"))
+		return CONTAINER_TYPE_INLINE_SIZE;
+	return -1;
+}
+
+/** Read names up to the end or a '/', into \a buf. */
+static css_error ct_names(const parserutils_vector *vector, int32_t *ctx,
+		char *buf, size_t size, bool *none)
+{
+	size_t used = 0;
+
+	*none = false;
+	buf[0] = '\0';
+	for (;;) {
+		const css_token *t;
+		size_t n;
+
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_peek(vector, *ctx);
+		if (t == NULL || t->type != CSS_TOKEN_IDENT)
+			break;
+		if (ct_ident_is(t, "none")) {
+			if (used > 0)
+				return CSS_INVALID;
+			parserutils_vector_iterate(vector, ctx);
+			*none = true;
+			return CSS_OK;
+		}
+		n = lwc_string_length(t->idata);
+		if (used + n + 2 > size)
+			return CSS_INVALID;
+		if (used > 0)
+			buf[used++] = ' ';
+		memcpy(buf + used, lwc_string_data(t->idata), n);
+		used += n;
+		buf[used] = '\0';
+		parserutils_vector_iterate(vector, ctx);
+	}
+	return used > 0 ? CSS_OK : CSS_INVALID;
+}
+
+static css_error ct_emit_names(css_language *c, css_style *result,
+		const char *buf, bool none)
+{
+	lwc_string *s;
+	uint32_t snumber;
+	css_error error;
+
+	if (none || buf[0] == '\0')
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_CONTAINER_NAME, 0,
+				CONTAINER_NAME_NONE);
+	if (lwc_intern_string(buf, strlen(buf), &s) != lwc_error_ok)
+		return CSS_NOMEM;
+	error = css__stylesheet_string_add(c->sheet, s, &snumber);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_CONTAINER_NAME, 0, CONTAINER_NAME_SET);
+	if (error != CSS_OK)
+		return error;
+	return css__stylesheet_style_append(result, snumber);
+}
+
+css_error css__parse_container_type(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig = *ctx;
+	const css_token *t = parserutils_vector_iterate(vector, ctx);
+	enum flag_value flag_value;
+	int type;
+
+	if (t == NULL) {
+		*ctx = orig;
+		return CSS_INVALID;
+	}
+	flag_value = get_css_flag_value(c, t);
+	if (flag_value != FLAG_VALUE__NONE)
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_CONTAINER_TYPE);
+	type = ct_type(t);
+	if (type < 0) {
+		*ctx = orig;
+		return CSS_INVALID;
+	}
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_CONTAINER_TYPE, 0, type);
+}
+
+css_error css__parse_container_name(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig = *ctx;
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+	char buf[128];
+	bool none;
+	css_error error;
+
+	if (t == NULL)
+		return CSS_INVALID;
+	flag_value = get_css_flag_value(c, t);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_CONTAINER_NAME);
+	}
+	error = ct_names(vector, ctx, buf, sizeof(buf), &none);
+	if (error == CSS_OK)
+		error = ct_emit_names(c, result, buf, none);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+}
+
+/* container: <name>+ [ / <type> ]? | none [ / <type> ]? */
+css_error css__parse_container(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig = *ctx;
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+	char buf[128];
+	bool none;
+	int type = CONTAINER_TYPE_NORMAL;
+	css_error error;
+
+	if (t == NULL)
+		return CSS_INVALID;
+	flag_value = get_css_flag_value(c, t);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		error = css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_CONTAINER_NAME);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result,
+					flag_value, CSS_PROP_CONTAINER_TYPE);
+		return error;
+	}
+	error = ct_names(vector, ctx, buf, sizeof(buf), &none);
+	if (error != CSS_OK) {
+		*ctx = orig;
+		return error;
+	}
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_peek(vector, *ctx);
+	if (t != NULL && tokenIsChar(t, '/')) {
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		type = t != NULL ? ct_type(t) : -1;
+		if (type < 0) {
+			*ctx = orig;
+			return CSS_INVALID;
+		}
+	}
+	error = ct_emit_names(c, result, buf, none);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_CONTAINER_TYPE, 0, type);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+}
