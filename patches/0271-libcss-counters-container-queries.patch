+/*
+ * Container queries (VitaSurf): the sizes asked about for the element
+ * being selected, by container name, so each is asked of the client
+ * once per element. Set by css_select_style around its matching.
+ */
+struct css_container_ask {
+	lwc_string *name;
+	uint8_t status;
+	css_fixed width, height;
+};
+
+struct css_container_ctx {
+	void *node;
+	struct css_select_handler *handler;
+	void *pw;
+	unsigned n;
+	struct css_container_ask ask[4];
+};
+
+extern struct css_container_ctx *css__container_ctx;
+
+/** The size of the element's container of a name (NULL: the nearest). */
+static inline uint8_t mq__container_size(lwc_string *name,
+		css_fixed *width, css_fixed *height)
+{
+	struct css_container_ctx *c = css__container_ctx;
+	struct css_container_ask *a;
+	unsigned i;
+
+	if (c == NULL || c->handler->node_container_size == NULL)
+		return 2;
+	for (i = 0; i < c->n; i++) {
+		a = &c->ask[i];
+		if (a->name == name) {
+			*width = a->width;
+			*height = a->height;
+			return a->status;
+		}
+	}
+	a = &c->ask[c->n < 4 ? c->n : 3];
+	a->name = name;
+	a->status = 2;
+	a->width = a->height = 0;
+	if (c->handler->node_container_size(c->pw, c->node, name,
+			&a->width, &a->height, &a->status) != CSS_OK)
+		a->status = 2;
+	if (c->n < 4)
+		c->n++;
+	*width = a->width;
+	*height = a->height;
+	return a->status;
+}
