 	vita_gen_id = id;
 }
 
+/*
+ * When an attribute of each name last changed (VitaSurf): the value of
+ * `any` just after the change, for the names that hash to each bucket,
+ * case folded. A client keeps an answer that reads only some names
+ * while none of their buckets has moved past it.
+ */
+static uint32_t vita_attr_gens[DOM_VITA_ATTR_BUCKETS];
+static uint32_t vita_attr_local;
+
+unsigned dom_vita_attr_bucket(const char *name, size_t len)
+{
+	uint32_t h = 2166136261u;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		unsigned char c = (unsigned char) name[i];
+
+		if (c >= 'A' && c <= 'Z')
+			c = (unsigned char) (c + 32);
+		h = (h ^ c) * 16777619u;
+	}
+	return (h ^ (h >> 16)) & (DOM_VITA_ATTR_BUCKETS - 1);
+}
+
+uint32_t dom_vita_attr_changed_at(unsigned bucket)
+{
+	return vita_attr_gens[bucket & (DOM_VITA_ATTR_BUCKETS - 1)];
+}
+
+void _dom_vita_attr_changed(dom_string *name)
+{
+	uint32_t now = vita_gen_any != NULL ? *vita_gen_any : ++vita_attr_local;
+	unsigned b;
+
+	if (name == NULL) {
+		for (b = 0; b < DOM_VITA_ATTR_BUCKETS; b++)
+			vita_attr_gens[b] = now;
+		return;
+	}
+	vita_attr_gens[dom_vita_attr_bucket(dom_string_data(name),
+			dom_string_byte_length(name))] = now;
+}
