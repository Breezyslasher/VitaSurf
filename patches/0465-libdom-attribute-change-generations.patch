+/*
+ * Which attributes have changed since (VitaSurf): names are hashed,
+ * ASCII case folded, into DOM_VITA_ATTR_BUCKETS buckets, and
+ * dom_vita_attr_changed_at gives the value `any` had just after the last
+ * change to an attribute whose name falls in that bucket, or 0. A change
+ * after `any` read g leaves its bucket past g.
+ */
+#define DOM_VITA_ATTR_BUCKETS 256
+unsigned dom_vita_attr_bucket(const char *name, size_t len);
+uint32_t dom_vita_attr_changed_at(unsigned bucket);
