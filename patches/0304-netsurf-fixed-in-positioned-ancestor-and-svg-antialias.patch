+	/*
+	 * Drawn larger and averaged down (VitaSurf). The framebuffer fills
+	 * a path pixel by pixel, all or nothing, so an icon drawn at its own
+	 * size had stepped edges and read heavier than a browser's: Home
+	 * Assistant's Material icons looked slightly wrong. At 4x each pixel
+	 * is the average of sixteen, which is anti-aliasing; a larger
+	 * graphic gets 2x, and one past that is drawn as before.
+	 */
+	{
+		int ss = 1;
+
+		if ((size_t)data->width * (size_t)data->height <= 64 * 64)
+			ss = 4;
+		else if ((size_t)data->width * (size_t)data->height <=
+				160 * 160)
+			ss = 2;
+		d.svg = svg;
+		d.width = data->width * ss;
+		d.height = data->height * ss;
+		d.scale = data->scale * ss;
+		d.background = data->background_colour;
+		if (vitasurf_raster(d.width, d.height, svg_raster_draw_cb,
+				    &d, &bm) != NSERROR_OK || bm == NULL) {
+			return NULL;
+		}
+		if (ss > 1) {
+			struct bitmap *down = svg_downsample(bm,
+					data->width, data->height, ss);
+
+			guit->bitmap->destroy(bm);
+			if (down == NULL)
+				return NULL;
+			bm = down;
+		}
 	}
 	r = &svg->raster[svg->raster_n++];
 	r->width = data->width;
