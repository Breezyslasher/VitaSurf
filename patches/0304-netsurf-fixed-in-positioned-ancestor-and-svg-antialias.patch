+/**
+ * A bitmap ss times the size, averaged down to width by height
+ * (VitaSurf). Colours are weighted by their alpha, so the transparent
+ * pixels around a shape do not darken its edge.
+ */
+static struct bitmap *
+svg_downsample(struct bitmap *big, int width, int height, int ss)
+{
+	struct bitmap *out;
+	const uint8_t *src;
+	uint8_t *dst;
+	size_t sstride, dstride;
+	int x, y, i, j, n = ss * ss;
+
+	if (guit->bitmap->get_width(big) != width * ss ||
+	    guit->bitmap->get_height(big) != height * ss) {
+		return NULL;
+	}
+	out = guit->bitmap->create(width, height, BITMAP_NONE);
+	if (out == NULL) {
+		return NULL;
+	}
+	src = guit->bitmap->get_buffer(big);
+	dst = guit->bitmap->get_buffer(out);
+	if (src == NULL || dst == NULL) {
+		guit->bitmap->destroy(out);
+		return NULL;
+	}
+	sstride = guit->bitmap->get_rowstride(big);
+	dstride = guit->bitmap->get_rowstride(out);
+	for (y = 0; y < height; y++) {
+		uint8_t *dp = dst + (size_t)y * dstride;
+
+		for (x = 0; x < width; x++, dp += 4) {
+			unsigned int sa = 0, sr = 0, sg = 0, sb = 0;
+
+			for (j = 0; j < ss; j++) {
+				const uint8_t *sp = src +
+						(size_t)(y * ss + j) * sstride +
+						(size_t)(x * ss) * 4;
+
+				for (i = 0; i < ss; i++, sp += 4) {
+					unsigned int a =
+						sp[bitmap_layout.a];
+
+					sa += a;
+					sr += sp[bitmap_layout.r] * a;
+					sg += sp[bitmap_layout.g] * a;
+					sb += sp[bitmap_layout.b] * a;
+				}
+			}
+			dp[bitmap_layout.a] = (uint8_t)(sa / n);
+			if (sa > 0) {
+				dp[bitmap_layout.r] = (uint8_t)(sr / sa);
+				dp[bitmap_layout.g] = (uint8_t)(sg / sa);
+				dp[bitmap_layout.b] = (uint8_t)(sb / sa);
+			} else {
+				dp[bitmap_layout.r] = 0;
+				dp[bitmap_layout.g] = 0;
+				dp[bitmap_layout.b] = 0;
+			}
+		}
+	}
+	guit->bitmap->set_opaque(out, false);
+	guit->bitmap->modified(out);
+	return out;
+}
