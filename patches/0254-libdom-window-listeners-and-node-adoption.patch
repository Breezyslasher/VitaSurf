+/* Exported function documented in element.h (VitaSurf) */
+void _dom_element_each_attr(struct dom_element *ele,
+		void (*fn)(struct dom_node_internal *node, void *pw), void *pw)
+{
+	dom_attr_list *attr = ele->attributes;
+
+	if (attr == NULL)
+		return;
+	do {
+		if (attr->attr != NULL)
+			fn((struct dom_node_internal *) attr->attr, pw);
+		attr = _dom_element_attr_list_next(attr);
+	} while (attr != ele->attributes);
+}
