+/*
+ * Move a subtree into another document, as it is (VitaSurf). The DOM
+ * adopts a node that is inserted into a document other than its own;
+ * libdom refused with WRONG_DOCUMENT_ERR, and the page's scripts, which
+ * never see that error, had nodes a DOMParser made go nowhere when put
+ * into the page. dom_document_adopt_node makes copies, which the page's
+ * references to the originals would not follow, so the owner changes
+ * in place: the strings are shared between documents already.
+ */
+static void adopt_one(dom_node_internal *n, void *pw)
+{
+	struct dom_document *to = pw;
+	dom_node_internal *c;
+	bool pending = n->pending_list.prev != &n->pending_list;
+
+	if (n->owner != to && n->type != DOM_DOCUMENT_NODE) {
+		if (pending)
+			list_del(&n->pending_list);
+		n->owner = to;
+		if (pending)
+			list_append(&to->pending_nodes, &n->pending_list);
+	}
+	if (n->type == DOM_ELEMENT_NODE)
+		_dom_element_each_attr((struct dom_element *) n, adopt_one, to);
+	for (c = n->first_child; c != NULL; c = c->next)
+		adopt_one(c, to);
+}
+
+static dom_exception adopt_in_place(dom_node_internal *node,
+		struct dom_document *to)
+{
+	struct dom_document *from = node->owner;
+	dom_node_internal *removed = NULL;
+	dom_exception err;
+
+	if (from == NULL || from == to || to == NULL)
+		return DOM_NO_ERR;
+	if (node->type == DOM_DOCUMENT_NODE)
+		return DOM_NOT_SUPPORTED_ERR;
+	/* out of its old tree first, which leaves it pending in the old
+	 * document */
+	if (node->parent != NULL) {
+		err = dom_node_remove_child(node->parent, node, &removed);
+		if (err != DOM_NO_ERR)
+			return err;
+		if (removed != NULL)
+			dom_node_unref(removed);
+	}
+	/* the old document may be kept alive by its pending node alone */
+	dom_node_ref(from);
+	adopt_one(node, to);
+	dom_node_unref(from);
+	return DOM_NO_ERR;
+}
