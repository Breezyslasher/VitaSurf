+/*
+ * The window above a document (VitaSurf). libdom knows no window, so a
+ * client that has one gives this hook: a dispatch whose target is in a
+ * document calls it with capture true before the capture phase, and with
+ * capture false after the bubbling phase of an event that bubbles. It
+ * may stop propagation or prevent the default, as a listener can.
+ */
+struct dom_document;
+typedef void (*dom_event_window_hook)(struct dom_event *evt,
+		struct dom_document *doc, bool capture, void *pw);
+void dom_event_set_window_hook(dom_event_window_hook hook, void *pw);
+
 static inline dom_exception dom_event_target_dispatch_event(
 		dom_event_target *et, struct dom_event *evt, bool *success)
 {
