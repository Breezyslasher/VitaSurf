diff --git a/content/handlers/html/box_construct.h b/content/handlers/html/box_construct.h
index 8937a4d66..87af8d7c6 100644
--- a/content/handlers/html/box_construct.h
+++ b/content/handlers/html/box_construct.h
@@ -124,4 +124,29 @@ struct box *box_for_node(struct dom_node *node);
  */
 bool box_extract_link(const struct html_content *content, const struct dom_string *dsrel, struct nsurl *base, struct nsurl **result);
 
+/**
+ * The tree boxes are built from, when it is not the DOM (VitaSurf).
+ *
+ * Shadow DOM is kept as light DOM by the script engine, so a component's
+ * own children sit beside what it rendered and would be drawn after it.
+ * The engine knows which of a host's children go into which of its
+ * <slot> elements, and which go nowhere; box construction asks it for a
+ * node's parent, first child and next sibling in that composed tree.
+ *
+ * PREPARE is asked once as a conversion starts, with n the root, so the
+ * engine can bring what it knows up to date. For the others the hook
+ * answers true and sets *out to a new reference, or NULL, when it has
+ * an answer, and false to have the DOM asked instead.
+ */
+enum vitasurf_composed_op {
+	VITASURF_COMPOSED_PREPARE,
+	VITASURF_COMPOSED_PARENT,
+	VITASURF_COMPOSED_FIRST_CHILD,
+	VITASURF_COMPOSED_NEXT_SIBLING
+};
+typedef bool (*vitasurf_composed_hook)(struct html_content *c,
+		enum vitasurf_composed_op op, struct dom_node *n,
+		struct dom_node **out);
+extern vitasurf_composed_hook vitasurf_composed;
+
 #endif
