+static dom_exception
+composed_first_child(html_content *c, dom_node *n, dom_node **out)
+{
+	if (vitasurf_composed != NULL &&
+	    vitasurf_composed(c, VITASURF_COMPOSED_FIRST_CHILD, n, out))
+		return DOM_NO_ERR;
+	return dom_node_get_first_child(n, out);
+}
+
+static dom_exception
+composed_next_sibling(html_content *c, dom_node *n, dom_node **out)
+{
+	if (vitasurf_composed != NULL &&
+	    vitasurf_composed(c, VITASURF_COMPOSED_NEXT_SIBLING, n, out))
+		return DOM_NO_ERR;
+	return dom_node_get_next_sibling(n, out);
+}
+
+static dom_exception
+composed_has_children(html_content *c, dom_node *n, bool *has)
+{
+	dom_node *first = NULL;
+	dom_exception err;
+
+	if (vitasurf_composed == NULL)
+		return dom_node_has_child_nodes(n, has);
+	err = composed_first_child(c, n, &first);
+	if (err != DOM_NO_ERR)
+		return err;
+	*has = (first != NULL);
+	if (first != NULL)
+		dom_node_unref(first);
+	return DOM_NO_ERR;
+}
