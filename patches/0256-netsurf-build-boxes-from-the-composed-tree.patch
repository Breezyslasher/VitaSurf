+/* A node's parent, first child and next sibling in the tree boxes are
+ * built from: the composed tree when the script engine keeps one, the
+ * DOM otherwise (VitaSurf). */
+static dom_exception
+composed_parent(html_content *c, dom_node *n, dom_node **out)
+{
+	if (vitasurf_composed != NULL &&
+	    vitasurf_composed(c, VITASURF_COMPOSED_PARENT, n, out))
+		return DOM_NO_ERR;
+	return dom_node_get_parent_node(n, out);
+}
