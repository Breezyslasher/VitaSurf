+/*
+ * A function tree to make again in other realms (VitaSurf). Each realm
+ * of a page and of its frames runs the same prelude, and reading its
+ * bytecode back with JS_ReadObject was a sixth of a realm's start: every
+ * function's code copied, every atom in it looked up, every name and
+ * string made again, for a tree that differs from the last realm's only
+ * in the realm its functions run in. A template is such a tree with no
+ * realm, and a clone of it is made of a JSFunctionBytecode a function
+ * and its constant pool: the code, the variable and closure tables, the
+ * names and the positions are the template's, which each clone holds a
+ * reference to. Nothing writes to them once a function is made. A tree
+ * qualifies when no function in it is waiting to be compiled and its
+ * constants are values or functions, not objects (a tagged template's
+ * strings), which belong to a realm.
+ */
+static int js_function_template_check(JSFunctionBytecode *b, int depth)
+{
+    int i;
+
+    if (b->lazy || b->code_owner || depth > 1000)
+        return -1;
+    for(i = 0; i < b->cpool_count; i++) {
+        JSValueConst v = b->cpool[i];
+
+        if (JS_VALUE_GET_TAG(v) == JS_TAG_FUNCTION_BYTECODE) {
+            if (js_function_template_check(JS_VALUE_GET_PTR(v), depth + 1))
+                return -1;
+        } else if (JS_VALUE_HAS_REF_COUNT(v) &&
+                   JS_VALUE_GET_TAG(v) != JS_TAG_STRING &&
+                   JS_VALUE_GET_TAG(v) != JS_TAG_STRING_ROPE &&
+                   JS_VALUE_GET_TAG(v) != JS_TAG_BIG_INT &&
+                   JS_VALUE_GET_TAG(v) != JS_TAG_SYMBOL) {
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static void js_function_template_unrealm(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    int i;
+
+    if (b->realm) {
+        JS_FreeContext(b->realm);
+        b->realm = NULL;
+    }
+    for(i = 0; i < b->cpool_count; i++) {
+        if (JS_VALUE_GET_TAG(b->cpool[i]) == JS_TAG_FUNCTION_BYTECODE)
+            js_function_template_unrealm(rt, JS_VALUE_GET_PTR(b->cpool[i]));
+    }
+}
+
+/* Make fn, a function tree from JS_ReadObject or a compile, a template:
+   0 if it can be one, -1 if not, when it is left as it was. */
+int JS_MakeFunctionTemplate(JSContext *ctx, JSValueConst fn)
+{
+    if (JS_VALUE_GET_TAG(fn) != JS_TAG_FUNCTION_BYTECODE ||
+        js_function_template_check(JS_VALUE_GET_PTR(fn), 0))
+        return -1;
+    js_function_template_unrealm(ctx->rt, JS_VALUE_GET_PTR(fn));
+    return 0;
+}
+
+static JSValue js_function_clone(JSContext *ctx, JSFunctionBytecode *t)
+{
+    JSFunctionBytecode *b;
+    int i, size = sizeof(*b) + t->cpool_count * sizeof(JSValue);
+
+    b = js_malloc(ctx, size);
+    if (!b)
+        return JS_EXCEPTION;
+    memcpy(b, t, sizeof(*b));
+    b->header.ref_count = 1;
+    b->realm = JS_DupContext(ctx);
+    b->code_owner = t;
+    js_dup(JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, t));
+    b->cpool = t->cpool_count ? (void *)((uint8_t *)b + sizeof(*b)) : NULL;
+    /* filled before anything can fail, so that freeing it frees them */
+    for(i = 0; i < t->cpool_count; i++)
+        b->cpool[i] = JS_UNDEFINED;
+    add_gc_object(ctx->rt, &b->header, JS_GC_OBJ_TYPE_FUNCTION_BYTECODE);
+    for(i = 0; i < t->cpool_count; i++) {
+        JSValueConst v = t->cpool[i];
+
+        if (JS_VALUE_GET_TAG(v) == JS_TAG_FUNCTION_BYTECODE) {
+            JSValue c = js_function_clone(ctx, JS_VALUE_GET_PTR(v));
+
+            if (JS_IsException(c)) {
+                JS_FreeValue(ctx, JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, b));
+                return JS_EXCEPTION;
+            }
+            b->cpool[i] = c;
+        } else {
+            b->cpool[i] = js_dup(v);
+        }
+    }
+    return JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, b);
+}
+
+/* The template's tree made again for ctx's realm, as JS_ReadObject would
+   have read it. */
+JSValue JS_CloneFunctionTemplate(JSContext *ctx, JSValueConst tmpl)
+{
+    if (JS_VALUE_GET_TAG(tmpl) != JS_TAG_FUNCTION_BYTECODE)
+        return JS_ThrowTypeError(ctx, "not a function template");
+    return js_function_clone(ctx, JS_VALUE_GET_PTR(tmpl));
+}
