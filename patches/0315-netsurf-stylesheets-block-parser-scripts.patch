+/*
+ * Script-blocking stylesheets (VitaSurf).
+ *
+ * A browser does not run a parser script while a stylesheet the parser
+ * met before it is still loading: a script that reads a style or a size
+ * gets the page as styled. Here the parser is paused on the script, as
+ * it is for a script being fetched, and the script runs when the last
+ * such stylesheet arrives or fails. A stylesheet that never arrives
+ * would hold the page for ever, so after a while the script runs
+ * without it, as it did before.
+ */
+#define SCRIPT_CSS_WAIT_MS 10000
+
+static void html_script_run_blocked(html_content *c);
+
+static void html_script_css_timeout(void *p)
+{
+	html_content *c = p;
+
+	if (c->blocked_script == NULL)
+		return;
+	vita_log("script: stylesheets still loading after %u ms; the "
+		 "script runs without them", (unsigned) SCRIPT_CSS_WAIT_MS);
+	html_script_run_blocked(c);
+}
+
+static void html_script_run_blocked(html_content *c)
+{
+	dom_node *node = c->blocked_script;
+	dom_hubbub_error err;
+
+	if (node == NULL)
+		return;
+	c->blocked_script = NULL;
+	guit->misc->schedule(-1, html_script_css_timeout, c);
+
+	err = html_process_script(c, node);
+	dom_node_unref(node);
+
+	/* an external script now being fetched keeps the parser paused,
+	 * and lifts the pause itself once it has run */
+	if (err != (DOM_HUBBUB_HUBBUB_ERR | HUBBUB_PAUSED) &&
+	    c->parser != NULL) {
+		c->parsing++;
+		dom_hubbub_parser_pause(c->parser, false);
+		c->parsing--;
+	}
+}
+
+/* exported internal interface documented in html/private.h */
+void html_script_css_settled(html_content *c)
+{
+	if (c->blocked_script != NULL && !html_css_blocks_scripts(c))
+		html_script_run_blocked(c);
+}
+
+/** Whether a parser script runs as soon as it is met: a classic one,
+ * inline or fetched without async or defer. */
+static bool script_runs_now(dom_node *node)
+{
+	dom_string *type = NULL, *src = NULL;
+	bool now = true, flag = false;
+
+	if (dom_element_get_attribute(node, corestring_dom_type, &type) ==
+			DOM_NO_ERR && type != NULL) {
+		if (script_type_is_module(type))
+			now = false;
+		dom_string_unref(type);
+	}
+	if (now && dom_element_get_attribute(node, corestring_dom_src,
+			&src) == DOM_NO_ERR && src != NULL) {
+		dom_string_unref(src);
+		if ((dom_element_has_attribute(node, corestring_dom_async,
+				&flag) == DOM_NO_ERR && flag) ||
+		    (dom_element_has_attribute(node, corestring_dom_defer,
+				&flag) == DOM_NO_ERR && flag))
+			now = false;
+	}
+	return now;
+}
+
+/* exported internal interface documented in html/private.h */
+dom_hubbub_error html_process_script_parser(void *ctx, dom_node *node)
+{
+	html_content *c = (html_content *) ctx;
+
+	if (c->parser != NULL && !c->parse_completed &&
+	    c->blocked_script == NULL && c->script_depth == 0 &&
+	    script_runs_now(node) && html_css_blocks_scripts(c)) {
+		/* not run twice by the pass that finds dropped scripts */
+		script_mark_seen(node);
+		c->blocked_script = dom_node_ref(node);
+		guit->misc->schedule(SCRIPT_CSS_WAIT_MS,
+				     html_script_css_timeout, c);
+		return DOM_HUBBUB_HUBBUB_ERR | HUBBUB_PAUSED;
+	}
+	return html_process_script(ctx, node);
+}
