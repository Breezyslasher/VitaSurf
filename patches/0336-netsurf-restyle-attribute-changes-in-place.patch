+/* attributes nothing reads but selectors and the code below */
+static bool html_attr_any(const char *name)
+{
+	static const char *const names[] = {
+		"class", "style", "id", "title", "hidden", "role",
+		"tabindex", "lang", "dir", "draggable", "spellcheck",
+		"translate", "inert", "accesskey", "autofocus", "srcset",
+		"sizes", "loading", "decoding", "fetchpriority", "nonce",
+	};
+	size_t i;
+
+	if (strncasecmp(name, "data-", 5) == 0 ||
+			strncasecmp(name, "aria-", 5) == 0 ||
+			strncasecmp(name, "x-", 2) == 0 ||
+			name[0] == ':' || name[0] == '@')
+		return true;
+	for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (strcasecmp(name, names[i]) == 0)
+			return true;
+	}
+	return false;
+}
+
+/** Whether an element is in the SVG namespace. */
+static bool html_node_is_svg(dom_node *n)
+{
+	dom_string *ns = NULL;
+	bool svg = false;
+
+	if (dom_node_get_namespace(n, &ns) == DOM_NO_ERR && ns != NULL) {
+		svg = dom_string_isequal(ns, corestring_dom_svg_namespace);
+		dom_string_unref(ns);
+	}
+	return svg;
+}
+
+/** Restyle an element's following siblings (and what is under them). */
+static enum box_restyle html_restyle_siblings(html_content *c, dom_node *n,
+		bool deep, unsigned *budget)
+{
+	enum box_restyle result = BOX_RESTYLE_SAME, r;
+	dom_node *sib = NULL, *next;
+
+	if (dom_node_get_next_sibling(n, &sib) != DOM_NO_ERR)
+		return BOX_RESTYLE_LAYOUT;
+	while (sib != NULL && result != BOX_RESTYLE_LAYOUT) {
+		dom_node_type type;
+
+		if (dom_node_get_node_type(sib, &type) == DOM_NO_ERR &&
+				type == DOM_ELEMENT_NODE) {
+			r = box_restyle(c, sib, deep, budget);
+			if (r > result)
+				result = r;
+		}
+		next = NULL;
+		if (dom_node_get_next_sibling(sib, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(sib);
+		sib = next;
+	}
+	if (sib != NULL)
+		dom_node_unref(sib);
+	return result;
+}
+
+/** How many elements one batch of changes may select again. */
+#define HTML_ATTR_BUDGET 3000
+
+/* exported interface documented in html/private.h */
+bool html_restyle_attrs(html_content *c,
+		const struct html_attr_change *changes, unsigned n,
+		int *result, char *why, size_t why_len)
+{
+	unsigned budget = HTML_ATTR_BUDGET, i;
+	enum box_restyle res = BOX_RESTYLE_SAME, r;
+
+	why[0] = '\0';
+	if (c->layout == NULL || c->bctx == NULL || c->reflowing ||
+			c->base.locked || c->box_conversion_context != NULL ||
+			(c->base.status != CONTENT_STATUS_READY &&
+			 c->base.status != CONTENT_STATUS_DONE))
+		return false;
+
+#define ATTR_WHY(...) snprintf(why, why_len, __VA_ARGS__)
+
+	for (i = 0; i < n && res != BOX_RESTYLE_LAYOUT; i++) {
+		const struct html_attr_change *ch = &changes[i];
+		struct html_reach_change rc;
+		const char *name = dom_string_data(ch->name);
+		dom_string *tag = NULL, *now = NULL;
+		struct box *box = box_for_node(ch->node);
+		bool special = false, is_img = false, subtree, sibs, deep;
+		size_t t;
+
+		if (dom_node_get_node_name(ch->node, &tag) == DOM_NO_ERR &&
+				tag != NULL) {
+			for (t = 0; t < sizeof(html_attr_special_tags) /
+					sizeof(html_attr_special_tags[0]); t++) {
+				if (strcasecmp(dom_string_data(tag),
+					html_attr_special_tags[t]) == 0) {
+					special = true;
+					break;
+				}
+			}
+			is_img = strcasecmp(dom_string_data(tag), "IMG") == 0;
+		}
+		if (html_node_is_svg(ch->node) ||
+				strcasecmp(name, "slot") == 0 ||
+				(special && !html_attr_any(name) &&
+				 !(is_img && strcasecmp(name, "src") == 0))) {
+			ATTR_WHY("%s on <%s>", name, tag != NULL ?
+					dom_string_data(tag) : "?");
+			if (tag != NULL)
+				dom_string_unref(tag);
+			res = BOX_RESTYLE_LAYOUT;
+			break;
+		}
+		if (box != NULL && strcasecmp(name, "class") != 0 &&
+				strcasecmp(name, "style") != 0 &&
+				html_box_shows_attr(box, ch->name)) {
+			ATTR_WHY("%s on <%s>, which content: attr() shows",
+					name, tag != NULL ?
+					dom_string_data(tag) : "?");
+			if (tag != NULL)
+				dom_string_unref(tag);
+			res = BOX_RESTYLE_LAYOUT;
+			break;
+		}
+
+		if (dom_element_get_attribute(ch->node, ch->name, &now) !=
+				DOM_NO_ERR)
+			now = NULL;
+
+		/* what a sheet could key on */
+		memset(&rc, 0, sizeof(rc));
+		rc.attr = ch->name;
+		if (strcasecmp(name, "class") == 0) {
+			const char *a = ch->old != NULL ?
+				dom_string_data(ch->old) : "";
+			const char *b = now != NULL ? dom_string_data(now) : "";
+			size_t al = ch->old != NULL ?
+				dom_string_byte_length(ch->old) : 0;
+			size_t bl = now != NULL ?
+				dom_string_byte_length(now) : 0;
+
+			html_class_diff(&rc, a, al, b, bl);
+			html_class_diff(&rc, b, bl, a, al);
+		} else if (strcasecmp(name, "id") == 0) {
+			rc.ids[0] = ch->old;
+			rc.ids[1] = now;
+		}
+
+		if (html_reach_hit(c, CSS_REACH_HAS, &rc)) {
+			ATTR_WHY("%s on <%s>, which a :has() selector asks "
+					"about", name, tag != NULL ?
+					dom_string_data(tag) : "?");
+			res = BOX_RESTYLE_LAYOUT;
+		} else {
+			subtree = html_reach_hit(c, CSS_REACH_DESCENDANTS, &rc);
+			deep = html_reach_hit(c, CSS_REACH_SIBLINGS_DEEP, &rc);
+			sibs = deep || html_reach_hit(c, CSS_REACH_SIBLINGS,
+					&rc);
+			r = box_restyle(c, ch->node, subtree, &budget);
+			if (r > res)
+				res = r;
+			if (sibs && res != BOX_RESTYLE_LAYOUT) {
+				r = html_restyle_siblings(c, ch->node, deep,
+						&budget);
+				if (r > res)
+					res = r;
+			}
+			if (res == BOX_RESTYLE_LAYOUT)
+				ATTR_WHY("%s on <%s>: %s", name,
+						tag != NULL ?
+						dom_string_data(tag) : "?",
+						budget == 0 ? "more than may "
+						"be restyled in place" :
+						box_restyle_why());
+		}
+		for (t = 0; t < rc.n_classes; t++)
+			lwc_string_unref(rc.classes[t]);
+		if (tag != NULL)
+			dom_string_unref(tag);
+		if (res == BOX_RESTYLE_LAYOUT) {
+			if (now != NULL)
+				dom_string_unref(now);
+			break;
+		}
+
+		/* what the box keeps of the attribute itself */
+		box = box_for_node(ch->node);
+		if (box != NULL && strcasecmp(name, "id") == 0) {
+			lwc_string *id = NULL;
+
+			if (now != NULL && dom_string_intern(now, &id) !=
+					DOM_NO_ERR)
+				id = NULL;
+			if (box->id != NULL)
+				lwc_string_unref(box->id);
+			box->id = id;
+		} else if (box != NULL && strcasecmp(name, "title") == 0) {
+			char *sq = now != NULL ?
+				squash_whitespace(dom_string_data(now)) : NULL;
+
+			box->title = sq != NULL ?
+				talloc_strdup(c->bctx, sq) : NULL;
+			free(sq);
+		} else if (box != NULL && is_img &&
+				strcasecmp(name, "src") == 0) {
+			nsurl *url = NULL;
+			int got = -1;
+
+			if (now != NULL && box_extract_link(c, now,
+					c->base_url, &url) && url != NULL) {
+				got = html_object_set_src(c, box, url);
+				nsurl_unref(url);
+			}
+			if (got < 0) {
+				ATTR_WHY("src on an <img> with no image "
+						"to replace");
+				res = BOX_RESTYLE_LAYOUT;
+			} else if (got > 0 && res < BOX_RESTYLE_PAINT) {
+				res = BOX_RESTYLE_PAINT;
+			}
+		}
+		if (now != NULL)
+			dom_string_unref(now);
+	}
+#undef ATTR_WHY
+
+	if (res == BOX_RESTYLE_REFLOW && !html_reflow_now(c)) {
+		snprintf(why, why_len, "the page could not be laid out now");
+		res = BOX_RESTYLE_LAYOUT;
+	}
+	if (res == BOX_RESTYLE_PAINT)
+		content__request_redraw(&c->base, 0, 0,
+				c->base.width, c->base.height);
+	*result = (int) res;
+	return true;
+}
