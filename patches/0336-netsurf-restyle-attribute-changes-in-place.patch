+/* exported interface documented in html/object.h */
+int html_object_set_src(html_content *c, struct box *box, nsurl *url)
+{
+	struct content_html_object *o;
+	hlcache_child_context child;
+	nserror error;
+
+	for (o = c->object_list; o != NULL; o = o->next) {
+		if (o->box == box && !o->background && !o->mask)
+			break;
+	}
+	if (o == NULL)
+		return -1;
+	if (o->content != NULL &&
+	    nsurl_compare(hlcache_handle_get_url(o->content), url,
+			  NSURL_COMPLETE)) {
+		return 0;
+	}
+
+	if (o->content != NULL) {
+		if (content_get_status(o->content) != CONTENT_STATUS_DONE) {
+			c->base.active--;
+		}
+		hlcache_handle_release(o->content);
+		o->content = NULL;
+		box->object = NULL;
+	}
+
+	child.charset = c->encoding;
+	child.quirks = c->base.quirks;
+	error = hlcache_handle_retrieve(url, HLCACHE_RETRIEVE_SNIFF_TYPE,
+			content_get_url(&c->base), NULL,
+			html_object_callback, o, &child,
+			o->permitted_types, &o->content);
+	if (error != NSERROR_OK) {
+		o->content = NULL;
+		return -1;
+	}
+	if (o->permitted_types & CONTENT_IMAGE)
+		vitasurf_images_asked++;
+	c->base.active++;
+	return 1;
+}
