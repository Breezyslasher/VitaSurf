+/*
+ * Whether new styles build the same boxes as the old (VitaSurf), so that
+ * laying the tree out again is all a change of size needs. Box
+ * construction also read a replaced element's width and height (whether
+ * its size is known before its image is) and the overflow of the root
+ * and the body (whether they scroll the viewport), so those must stay.
+ */
+static bool restyle_same_boxes(const html_content *c, const struct box *box,
+		const css_select_results *a, const css_select_results *b)
+{
+	const css_computed_style *sa = a->styles[CSS_PSEUDO_ELEMENT_NONE];
+	const css_computed_style *sb = b->styles[CSS_PSEUDO_ELEMENT_NONE];
+	int i;
+
+	for (i = 0; i < CSS_PSEUDO_ELEMENT_COUNT; i++) {
+		if ((a->styles[i] == NULL) != (b->styles[i] == NULL))
+			return false;
+		if (a->styles[i] != NULL && !css_computed_style_same_boxes(
+				a->styles[i], b->styles[i]))
+			return false;
+	}
+	if (sa == NULL || sb == NULL)
+		return sa == sb;
+	if ((box->flags & IS_REPLACED) != 0) {
+		css_fixed va = 0, vb = 0;
+		css_unit ua = CSS_UNIT_PX, ub = CSS_UNIT_PX;
+
+		if (css_computed_width(sa, &va, &ua) !=
+				css_computed_width(sb, &vb, &ub) ||
+				va != vb || ua != ub)
+			return false;
+		va = vb = 0;
+		ua = ub = CSS_UNIT_PX;
+		if (css_computed_height(sa, &va, &ua) !=
+				css_computed_height(sb, &vb, &ub) ||
+				va != vb || ua != ub)
+			return false;
+	}
+	if ((box->flags & OVERFLOW_VIEWPORT) != 0 || box == c->layout) {
+		if (css_computed_overflow_x(sa) != css_computed_overflow_x(sb) ||
+				css_computed_overflow_y(sa) !=
+				css_computed_overflow_y(sb))
+			return false;
+	}
+	return true;
+}
