+/** The same for every box an element owns, as restyle_remap walks them. */
+static void restyle_unmeasure(struct box *owner, struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->node != NULL && b->node != owner->node) {
+			if (b->type == BOX_INLINE && b->inline_end != NULL)
+				b = b->inline_end;
+			continue;
+		}
+		restyle_unmeasure_one(b);
+		if (b->list_marker != NULL)
+			restyle_unmeasure_one(b->list_marker);
+		restyle_unmeasure(owner, b->children);
+	}
+}
