+		a = NULL;
+	if (css_computed_filter(fresh, &b) != CSS_FILTER_SET)
+		b = NULL;
+	if (a == b)
+		return;
+	box->filter = b != NULL ? box_parse_filter(box, lwc_string_data(b)) :
+		NULL;
+}
