+/* ------------------------------------------------------------------------ */
+/* Attribute changes made by scripts (VitaSurf)                             */
+
+/*
+ * A script that sets a class, a style or an image's src used to have the
+ * whole box tree built again, every element selected and every box made
+ * anew: a second and a half on the Vita for Yamtrack's 4500 elements,
+ * three times while it settled. Most such changes need much less. The
+ * element is selected again, and so is what a sheet can reach from it --
+ * what is under it if a sheet keys a descendant selector on the class
+ * that changed, its following siblings for a sibling selector -- and the
+ * new styles are put on the boxes in place. A change of colour is then
+ * drawn again, and a change of size laid out again; only a change to the
+ * boxes themselves (display, position, content, a :has() selector that
+ * reaches up the tree) still rebuilds.
+ */
+
+/** What changed, for matching against a sheet's reach keys. */
+struct html_reach_change {
+	lwc_string *classes[64];	/**< classes added or taken away */
+	uint32_t n_classes;
+	bool classes_lost;		/**< more than fit in classes */
+	dom_string *ids[2];		/**< the id before and after */
+	dom_string *attr;		/**< the attribute's name */
+};
+
+static bool html_reach_sheet_hit(const css_stylesheet *sheet,
+		uint32_t reach, const struct html_reach_change *ch)
+{
+	const css_dynamic_key *keys;
+	uint32_t n, i, j;
+	bool any = false;
+
+	css_stylesheet_reach_keys(sheet, reach, &keys, &n, &any);
+	if (any)
+		return true;
+	for (i = 0; i < n; i++) {
+		bool eq = false;
+
+		switch (keys[i].kind) {
+		case CSS_DYNAMIC_KEY_CLASS:
+			if (ch->classes_lost && n > 0)
+				return true;
+			for (j = 0; j < ch->n_classes; j++) {
+				if (lwc_string_caseless_isequal(ch->classes[j],
+						keys[i].name, &eq) ==
+						lwc_error_ok && eq)
+					return true;
+			}
+			break;
+		case CSS_DYNAMIC_KEY_ID:
+			for (j = 0; j < 2; j++) {
+				if (ch->ids[j] != NULL &&
+				    dom_string_caseless_lwc_isequal(
+						ch->ids[j], keys[i].name))
+					return true;
+			}
+			break;
+		case CSS_DYNAMIC_KEY_ATTRIBUTE:
+			if (ch->attr != NULL &&
+			    dom_string_caseless_lwc_isequal(ch->attr,
+					keys[i].name))
+				return true;
+			break;
+		default:
+			break;
+		}
+	}
+	return false;
+}
+
+/** Whether any of the document's sheets reaches that way on the change. */
+static bool html_reach_hit(html_content *c, uint32_t reach,
+		const struct html_reach_change *ch)
+{
+	uint32_t i, k;
+
+	for (i = 0; i < c->stylesheet_count; i++) {
+		struct hlcache_handle *h = c->stylesheets[i].sheet;
+		struct nscss_import *imports;
+		uint32_t ni = 0;
+
+		if (!dynamic_sheet_ready(h))
+			continue;
+		if (html_reach_sheet_hit(nscss_get_stylesheet(h), reach, ch))
+			return true;
+		imports = nscss_get_imports(h, &ni);
+		for (k = 0; k < ni; k++) {
+			if (dynamic_sheet_ready(imports[k].c) &&
+			    html_reach_sheet_hit(nscss_get_stylesheet(
+					imports[k].c), reach, ch))
+				return true;
+		}
+	}
+	return false;
+}
+
+/** Whether a class list holds a class, as whitespace separated words. */
+static bool html_class_in(const char *list, size_t list_len,
+		const char *word, size_t len)
+{
+	size_t i = 0;
+
+	while (i < list_len) {
+		size_t start;
+
+		while (i < list_len && ascii_is_space(list[i]))
+			i++;
+		start = i;
+		while (i < list_len && !ascii_is_space(list[i]))
+			i++;
+		if (i - start == len && memcmp(list + start, word, len) == 0)
+			return true;
+	}
+	return false;
+}
+
+/** Note the words of one class list missing from the other. */
+static void html_class_diff(struct html_reach_change *ch,
+		const char *a, size_t a_len, const char *b, size_t b_len)
+{
+	size_t i = 0;
+
+	while (i < a_len) {
+		size_t start;
+
+		while (i < a_len && ascii_is_space(a[i]))
+			i++;
+		start = i;
+		while (i < a_len && !ascii_is_space(a[i]))
+			i++;
+		if (i == start || html_class_in(b, b_len, a + start,
+				i - start))
+			continue;
+		if (ch->n_classes == sizeof(ch->classes) /
+				sizeof(ch->classes[0]) ||
+		    lwc_intern_string(a + start, i - start,
+				&ch->classes[ch->n_classes]) != lwc_error_ok) {
+			ch->classes_lost = true;
+			continue;
+		}
+		ch->n_classes++;
+	}
+}
+
+/** Whether generated content on the element shows an attribute. */
+static bool html_box_shows_attr(const struct box *box, dom_string *name)
+{
+	int i;
+
+	if (box->styles == NULL)
+		return false;
+	for (i = 0; i < CSS_PSEUDO_ELEMENT_COUNT; i++) {
+		const css_computed_content_item *item = NULL;
+
+		if (box->styles->styles[i] == NULL ||
+		    css_computed_content(box->styles->styles[i], &item) !=
+				CSS_CONTENT_SET || item == NULL)
+			continue;
+		for (; item->type != CSS_COMPUTED_CONTENT_NONE; item++) {
+			if (item->type == CSS_COMPUTED_CONTENT_ATTR &&
+			    dom_string_caseless_lwc_isequal(name,
+					item->data.attr))
+				return true;
+		}
+	}
+	return false;
+}
