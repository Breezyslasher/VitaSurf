+static void tf_rotation3d(double x, double y, double z, double radians,
+		double l[4])
+{
+	double len = sqrt(x * x + y * y + z * z);
+	double s = sin(radians), co = cos(radians), t = 1 - co;
+
+	if (len == 0) {
+		l[0] = 1; l[1] = 0; l[2] = 0; l[3] = 1;
+		return;
