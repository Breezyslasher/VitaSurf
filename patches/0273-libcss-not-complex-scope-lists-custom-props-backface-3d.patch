+	x /= len; y /= len; z /= len;
+	/* a b c d, as matrix() writes them: x' = a x + c y */
+	l[0] = t * x * x + co;
+	l[1] = t * x * y + s * z;
+	l[2] = t * x * y - s * z;
+	l[3] = t * y * y + co;
