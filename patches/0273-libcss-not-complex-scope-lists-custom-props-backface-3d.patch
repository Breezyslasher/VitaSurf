 }
 
+
+
+/* Append \a len bytes of \a data to \a buf, keeping count of the length
+ * a buffer big enough would have needed. */
+static void custom_put(char *buf, size_t size, size_t *at,
+		const char *data, size_t len)
+{
+	if (*at < size) {
+		size_t room = size - *at;
+		memcpy(buf + *at, data, len < room ? len : room);
+	}
+	*at += len;
+}
+
+/* exported interface documented in libcss/computed.h */
+css_error css_computed_custom_property(const css_computed_style *style,
+		lwc_string *name, char *buffer, size_t buffer_length,
+		size_t *value_length)
+{
+	const css_custom_entry *ent = NULL;
+	const css_token *t = NULL;
+	uint32_t n = 0, i;
+	size_t at = 0;
+	bool space = false;
+
+	if (style == NULL || name == NULL || value_length == NULL)
+		return CSS_BADPARM;
+
+	if (style->custom != NULL)
+		ent = css__custom_map_get(style->custom, name);
+	if (ent != NULL) {
+		t = ent->tokens;
+		n = ent->n_tokens;
+	} else if (!css__custom_root_get(name, &t, &n)) {
+		return CSS_PROPERTY_NOT_SET;
+	}
+
+	for (i = 0; i < n; i++) {
+		const char *d = t[i].idata != NULL ?
+				lwc_string_data(t[i].idata) :
+				(const char *) t[i].data.data;
+		size_t dl = t[i].idata != NULL ?
+				lwc_string_length(t[i].idata) : t[i].data.len;
+
+		if (t[i].type == CSS_TOKEN_S ||
+				t[i].type == CSS_TOKEN_COMMENT) {
+			space = at > 0;
+			continue;
+		}
+		if (d == NULL)
+			dl = 0;
+		if (space) {
+			custom_put(buffer, buffer_length, &at, " ", 1);
+			space = false;
+		}
+		switch (t[i].type) {
+		case CSS_TOKEN_ATKEYWORD:
+			custom_put(buffer, buffer_length, &at, "@", 1);
+			custom_put(buffer, buffer_length, &at, d, dl);
+			break;
+		case CSS_TOKEN_HASH:
+			custom_put(buffer, buffer_length, &at, "#", 1);
+			custom_put(buffer, buffer_length, &at, d, dl);
+			break;
+		case CSS_TOKEN_FUNCTION:
+			custom_put(buffer, buffer_length, &at, d, dl);
+			custom_put(buffer, buffer_length, &at, "(", 1);
+			break;
+		case CSS_TOKEN_STRING:
+		case CSS_TOKEN_INVALID_STRING:
+			custom_put(buffer, buffer_length, &at, "\"", 1);
+			custom_put(buffer, buffer_length, &at, d, dl);
+			custom_put(buffer, buffer_length, &at, "\"", 1);
+			break;
+		case CSS_TOKEN_URI:
+			custom_put(buffer, buffer_length, &at, "url(", 4);
+			custom_put(buffer, buffer_length, &at, d, dl);
+			custom_put(buffer, buffer_length, &at, ")", 1);
+			break;
+		case CSS_TOKEN_UNICODE_RANGE:
+			custom_put(buffer, buffer_length, &at, "U+", 2);
+			custom_put(buffer, buffer_length, &at, d, dl);
+			break;
+		case CSS_TOKEN_PERCENTAGE:
+			custom_put(buffer, buffer_length, &at, d, dl);
+			custom_put(buffer, buffer_length, &at, "%", 1);
+			break;
+		case CSS_TOKEN_INCLUDES:
+			custom_put(buffer, buffer_length, &at, "~=", 2);
+			break;
+		case CSS_TOKEN_DASHMATCH:
+			custom_put(buffer, buffer_length, &at, "|=", 2);
+			break;
+		case CSS_TOKEN_PREFIXMATCH:
+			custom_put(buffer, buffer_length, &at, "^=", 2);
+			break;
+		case CSS_TOKEN_SUFFIXMATCH:
+			custom_put(buffer, buffer_length, &at, "$=", 2);
+			break;
+		case CSS_TOKEN_SUBSTRINGMATCH:
+			custom_put(buffer, buffer_length, &at, "*=", 2);
+			break;
+		case CSS_TOKEN_CDO:
+			custom_put(buffer, buffer_length, &at, "<!--", 4);
+			break;
+		case CSS_TOKEN_CDC:
+			custom_put(buffer, buffer_length, &at, "-->", 3);
+			break;
+		case CSS_TOKEN_EOF:
+			break;
+		default:
+			custom_put(buffer, buffer_length, &at, d, dl);
+			break;
+		}
+	}
+	/* terminated when it fits */
+	if (at < buffer_length)
+		buffer[at] = '\0';
+	*value_length = at;
+	return CSS_OK;
+}
