+/**
+ * Match a complex selector at a node, without cascading anything
+ * (VitaSurf): what :-vita-not() and :-vita-scope-not() ask. The chain
+ * is matched from its subject leftwards as match_selector_chain does,
+ * with the reject cache left alone, since \a node need not be the
+ * element being selected for.
+ */
+static css_error match_chain_at(css_select_ctx *ctx, const css_selector *s,
+		void *node, css_select_state *state, bool *match)
+{
+	css_error error;
+
+	error = match_has_compound(ctx, node, s, state, match);
+	if (error != CSS_OK || *match == false)
+		return error;
+
+	while (s->data.comb != CSS_COMBINATOR_NONE && s->combinator != NULL) {
+		void *next_node = NULL;
+
+		if (s->combinator->data.qname.name != ctx->str.universal) {
+			error = match_named_combinator(ctx, s->data.comb,
+					s->combinator, state, node,
+					&next_node);
+		} else {
+			bool rejected = false;
+
+			error = match_universal_combinator(ctx, s->data.comb,
+					s->combinator, state, node, false,
+					&rejected, &next_node);
+		}
+		if (error != CSS_OK)
+			return error;
+		if (next_node == NULL) {
+			*match = false;
+			return CSS_OK;
+		}
+		s = s->combinator;
+		node = next_node;
+	}
+	*match = true;
+	return CSS_OK;
+}
