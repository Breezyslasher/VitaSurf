+/* exported interface documented in desktop/frames.h */
+void browser_window_iframe_rename(struct browser_window *bw, const char *name)
+{
+	char *copy = NULL;
+
+	if (bw == NULL)
+		return;
+	if (name != NULL) {
+		copy = strdup(name);
+		if (copy == NULL)
+			return;
+	}
+	free(bw->name);
+	bw->name = copy;
+}
