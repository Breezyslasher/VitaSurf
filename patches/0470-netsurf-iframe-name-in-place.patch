+/** An iframe's attributes that change nothing drawn (VitaSurf): its
+ * name, and what its page may do, which counts from its next load. */
+static bool html_iframe_attr_quiet(const char *name)
+{
+	static const char *const names[] = {
+		"name", "allow", "allowfullscreen", "allowpaymentrequest",
+		"referrerpolicy", "credentialless", "sandbox",
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (strcasecmp(name, names[i]) == 0)
+			return true;
+	}
+	return false;
+}
