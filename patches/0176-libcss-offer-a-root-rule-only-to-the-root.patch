diff --git a/src/select/hash.h b/src/select/hash.h
index 5f48a38..906fc37 100644
--- a/src/select/hash.h
+++ b/src/select/hash.h
@@ -22,6 +22,26 @@ struct css_selector;
 
 typedef struct css_selector_hash css_selector_hash;
 
+/**
+ * A key compound that can only match the document root (VitaSurf).
+ *
+ * :root matches exactly one element in a document, and a rule whose key
+ * compound carries no name, class or id is filed in the universal chain
+ * and handed to every element there is. On a GitHub load 15,564,220 of
+ * the 15,615,612 pseudo-class refusals are of this kind, and on the
+ * saved copy of that page 94% of them are :root -- 69,824 refusals for
+ * rules that could only ever have matched the html element. Themes and
+ * design tokens are written as :root blocks, so a site ships a great
+ * many of them.
+ *
+ * The rule records that it needs the root, the element is asked once
+ * whether it is, and the chain steps over the rest. Nothing that could
+ * have matched is skipped: it is the same question match_detail asks,
+ * and a negated :root is left alone because that matches everything
+ * else.
+ */
+#define CSS_NODE_STATE_ROOT	(1u << 0)
+
 struct css_hash_selection_requirments {
 	css_qname qname;		/* Element name, or universal "*" */
 	lwc_string *class;		/* Name of class, or NULL */
@@ -30,6 +50,7 @@ struct css_hash_selection_requirments {
 	const css_media *media;		/* Media spec we're selecting for */
 	const css_unit_ctx *unit_ctx;	/* Document unit conversion context. */
 	const css_bloom *node_bloom;	/* Node's bloom filter */
+	uint32_t node_state;		/* CSS_NODE_STATE_* the node is in */
 };
 
