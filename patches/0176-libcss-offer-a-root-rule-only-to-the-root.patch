 	 */
 	state.custom = css__custom_map_ref((css_custom_map *) ctx->parent_custom);
 
+	/*
+	 * Whether this is the document root, asked once (VitaSurf). A
+	 * rule whose key compound wants :root is offered to every element
+	 * otherwise, and on a GitHub load that is most of the 15,564,220
+	 * refusals nothing else accounts for. This is the same handler
+	 * match_detail would have called for the same question.
+	 */
+	{
