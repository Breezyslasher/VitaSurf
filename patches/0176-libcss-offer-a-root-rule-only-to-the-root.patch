@@ -2835,7 +2868,24 @@ css_error match_details(css_select_ctx *ctx, void *node,
 					} else if (pn == ctx->str.has) {
 						css_select_pseudo_has++;
 					} else {
+						unsigned k;
+
 						css_select_pseudo_other++;
