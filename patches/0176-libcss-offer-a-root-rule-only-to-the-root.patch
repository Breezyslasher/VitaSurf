+				strncasecmp(lwc_string_data(d->qname.name),
+					"root", 4) == 0) {
+			return CSS_NODE_STATE_ROOT;
+		}
+	} while (d->next != 0 && (d = d + 1) != NULL);
+
+	return 0;
