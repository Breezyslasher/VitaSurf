+/*
+ * And the names behind "other", which is 15,564,220 of a GitHub load's
+ * 15,615,612 pseudo-class refusals -- not dynamic, not structural, not
+ * form, not :has. Whatever it is refuses nearly every candidate the
+ * page offers, so name it rather than infer it from the stylesheets.
+ * A small table is enough: the refusals are concentrated, and anything
+ * past it is counted without a name.
+ */
+#define PSEUDO_NAME_SLOTS 8
+struct css_select_pseudo_name {
+	lwc_string *name;
+	unsigned int count;
+};
+struct css_select_pseudo_name css_select_pseudo_names[PSEUDO_NAME_SLOTS];
+unsigned int css_select_pseudo_unnamed;
 
