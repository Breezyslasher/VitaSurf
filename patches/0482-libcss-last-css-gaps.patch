+/* exported interface documented in libcss/computed.h */
+css_error css_computed_style_compose_first_letter(
+		const css_computed_style *restrict parent,
+		const css_computed_style *restrict child,
+		const css_unit_ctx *unit_ctx,
+		css_computed_style **restrict result)
+{
+	css_computed_style *letter, *s;
+	css_fixed_or_calc pfs = { .value = 0 };
+	css_unit unit = CSS_UNIT_PX;
+	css_fixed size = 0, sink = 0;
+	float fs, lh, cap_span, f, base, l;
+	css_error error;
+	size_t i;
+
+	error = css_computed_style_compose(parent, child, unit_ctx, &letter);
+	if (error != CSS_OK)
+		return error;
+	*result = letter;
+	if (parent == NULL || get_initial_letter(letter, &size, &sink) !=
+			CSS_INITIAL_LETTER_SET ||
+			get_font_size(parent, &pfs, &unit) !=
+			CSS_FONT_SIZE_DIMENSION || unit != CSS_UNIT_PX)
+		return CSS_OK;
+
+	/*
+	 * The letter's capitals reach from the top of the first line's to
+	 * the baseline of the size-th line, and it sinks to the sink-th
+	 * line's baseline: a capital is taken as 0.7 of the em, and a
+	 * line's baseline 0.75 of the way down it, where NetSurf sets
+	 * text. Its line is as tall as puts its baseline there, and its
+	 * bottom margin takes the float back to sink lines.
+	 */
+	fs = FIXTOFLT(pfs.value);
+	lh = initial_letter_line(parent, fs);
