+static inline css_error set_shape_margin(css_computed_style *style, uint8_t
+		type, css_fixed length, css_unit unit)
+{
+	uint32_t *bits = &style->i.bits[SHAPE_MARGIN_INDEX];
+
+	/* 7bits: uuuuutt : unit | type */
+	*bits = (*bits & ~SHAPE_MARGIN_MASK) | ((((uint32_t)type & 0x3) | (unit
+			<< 2)) << SHAPE_MARGIN_SHIFT);
+
+	style->i.shape_margin = length;
+
+	return CSS_OK;
+}
