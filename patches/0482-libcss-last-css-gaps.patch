diff --git a/include/libcss/types.h b/include/libcss/types.h
index 77cd6f1..cc6830c 100644
--- a/include/libcss/types.h
+++ b/include/libcss/types.h
@@ -78,6 +78,33 @@ typedef enum css_origin {
 /** CSS colour -- AARRGGBB */
 typedef uint32_t css_color;
 
+/*
+ * color-mix() of currentColor and transparent (VitaSurf): currentColor
+ * at a fraction of its alpha, which is how pages fade the text's own
+ * colour. The colour it stands for is not known until the element's
+ * colour is, so it is kept as this fully transparent value, the weight
+ * in its green channel, and the computed style holds the colour it
+ * resolves to. A painter that meets it in a value it reads itself, a
+ * shadow's colour, resolves it with css_color_resolve_current().
+ */
+#define CSS_COLOR_CURRENT_MIX(w) ((css_color) (0x00C00001u | \
+		(((uint32_t) (w) & 0xffu) << 8)))
+#define CSS_COLOR_IS_CURRENT_MIX(c) \
+		(((uint32_t) (c) & 0xffff00ffu) == 0x00C00001u)
+
+/** A colour with any currentColor mix in it resolved against current. */
+static inline css_color css_color_resolve_current(css_color c,
+		css_color current)
+{
+	uint32_t w, a;
+
+	if (!CSS_COLOR_IS_CURRENT_MIX(c))
+		return c;
+	w = (c >> 8) & 0xffu;
+	a = ((current >> 24) & 0xffu) * w / 255u;
+	return (current & 0x00ffffffu) | (a << 24);
+}
+
 /* CSS unit */
 typedef enum css_unit {
 	CSS_UNIT_PX                 = 0x00,
