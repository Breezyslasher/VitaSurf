+	RESOLVE_MIX(border_right_color, current);
+	RESOLVE_MIX(border_bottom_color, current);
+	RESOLVE_MIX(border_left_color, current);
+	RESOLVE_MIX(outline_color, current);
+	RESOLVE_MIX(column_rule_color, current);
+	RESOLVE_MIX(text_decoration_color, current);
+	return CSS_OK;
+}
+
+#undef RESOLVE_MIX
+
 /**
  * Compute the absolute values of a style
  *
@@ -2849,7 +3166,9 @@ css_error css__compute_absolute_values(const css_computed_style *parent,
 	if (error != CSS_OK)
 		return error;
 
-	return CSS_OK;
+	/* currentColor mixed with transparent, now that the colour it
+	 * stands for is known (VitaSurf) */
+	return compute_current_mixes(parent, style);
 }
 
 
