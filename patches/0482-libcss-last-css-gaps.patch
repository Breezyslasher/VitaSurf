--- /dev/null
+++ b/src/parse/properties/last_gaps.c
@@ -0,0 +1,997 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * The last of what the census found dropped (VitaSurf):
+ * font-feature-settings, font-size-adjust, text-emphasis and its
+ * longhands, text-indent's hanging and each-line, image-rendering,
+ * shape-outside, shape-margin and shape-image-threshold (checked and
+ * kept nowhere, as only an image's shape would read it), and
+ * initial-letter.
+ */
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+#include "utils/utils.h"
+
+/** Whether a token is an identifier that is the word, in any case. */
+static bool is_word(const css_token *t, const char *word)
+{
+	size_t len = strlen(word);
+
+	return t != NULL && t->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(t->idata) == len &&
+			strncasecmp(lwc_string_data(t->idata), word, len) == 0;
+}
+
+/** Which of the words a token is, or -1. */
+static int word_index(const css_token *t, const char *const *words,
+		size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		if (is_word(t, words[i]))
+			return (int) i;
+	}
+	return -1;
+}
+
+/** inherit, initial and the rest, for one property. */
+static bool take_flag(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, css_style *result, opcode_t prop,
+		css_error *error)
+{
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag = get_css_flag_value(c, t);
+
+	if (flag == FLAG_VALUE__NONE)
+		return false;
+	parserutils_vector_iterate(vector, ctx);
+	*error = css_stylesheet_style_flag_value(result, flag, prop);
+	return true;
+}
+
+/** The next token that is not whitespace, taken. */
+static const css_token *next_token(const parserutils_vector *vector,
+		int32_t *ctx)
+{
+	consumeWhitespace(vector, ctx);
+	return parserutils_vector_iterate(vector, ctx);
+}
+
+/** The next token that is not whitespace, left where it is. */
+static const css_token *peek_token(const parserutils_vector *vector,
+		int32_t *ctx)
+{
+	consumeWhitespace(vector, ctx);
+	return parserutils_vector_peek(vector, *ctx);
+}
+
+/** A number token's value, if it is one and all of it is the number. */
+static bool token_number(const css_token *t, bool int_only, css_fixed *v)
+{
+	size_t consumed = 0;
+
+	if (t == NULL || t->type != CSS_TOKEN_NUMBER)
+		return false;
+	*v = css__number_from_lwc_string(t->idata, int_only, &consumed);
+	return consumed == lwc_string_length(t->idata);
+}
+
+/** One opcode and a string to go with it. */
+static css_error append_string(css_language *c, css_style *result,
+		opcode_t prop, uint16_t value, const char *text, size_t len)
+{
+	lwc_string *str;
+	uint32_t snumber;
+	css_error error;
+
+	if (lwc_intern_string(text, len, &str) != lwc_error_ok)
+		return CSS_NOMEM;
+	error = css__stylesheet_string_add(c->sheet, str, &snumber);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_appendOPV(result, prop, 0, value);
+	if (error != CSS_OK)
+		return error;
+	return css__stylesheet_style_append(result, snumber);
+}
+
+/* font-feature-settings ------------------------------------------------ */
+
+/**
+ * normal | [ <string> [ <integer [0,inf]> | on | off ]? ]#, each tag
+ * four printable ASCII characters. The text is kept as Chrome reads it
+ * back ("tnum", "liga" 0), and the features this renderer can honour,
+ * tabular figures and small capitals, are noted in the opcode.
+ */
+css_error css__parse_font_feature_settings(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	char text[512];
+	size_t len = 0;
+	uint16_t features = 0;
+	const css_token *t;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_FONT_FEATURE_SETTINGS,
+			&error))
+		return error;
+
+	t = parserutils_vector_peek(vector, *ctx);
+	if (is_word(t, "normal")) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_FONT_FEATURE_SETTINGS, 0,
+				FONT_FEATURE_SETTINGS_NORMAL);
+	}
+
+	for (;;) {
+		const char *tag;
+		int32_t at, value = 1;
+		css_fixed n;
+		size_t i;
+
+		t = next_token(vector, ctx);
+		if (t == NULL || t->type != CSS_TOKEN_STRING ||
+				lwc_string_length(t->idata) != 4)
+			goto invalid;
+		tag = lwc_string_data(t->idata);
+		for (i = 0; i < 4; i++) {
+			if (tag[i] < 0x20 || tag[i] > 0x7e)
+				goto invalid;
+		}
+
+		at = *ctx;
+		t = peek_token(vector, &at);
+		if (token_number(t, true, &n)) {
+			if (n < 0)
+				goto invalid;
+			value = FIXTOINT(n);
+			*ctx = at + 1;
+		} else if (is_word(t, "on") || is_word(t, "off")) {
+			value = is_word(t, "on") ? 1 : 0;
+			*ctx = at + 1;
+		}
+
+		if (strncmp(tag, "tnum", 4) == 0) {
+			features &= ~(CSS_FONT_FEATURE_TNUM_ON |
+					CSS_FONT_FEATURE_TNUM_OFF);
+			features |= value ? CSS_FONT_FEATURE_TNUM_ON :
+					CSS_FONT_FEATURE_TNUM_OFF;
+		} else if (strncmp(tag, "smcp", 4) == 0) {
+			features &= ~(CSS_FONT_FEATURE_SMCP_ON |
+					CSS_FONT_FEATURE_SMCP_OFF);
+			features |= value ? CSS_FONT_FEATURE_SMCP_ON :
+					CSS_FONT_FEATURE_SMCP_OFF;
+		}
+
+		if (len + 24 >= sizeof(text))
+			goto invalid;
+		len += (size_t) snprintf(text + len, sizeof(text) - len,
+				"%s\"%.4s\"", len ? ", " : "", tag);
+		if (value != 1)
+			len += (size_t) snprintf(text + len,
+					sizeof(text) - len, " %d",
+					(int) value);
+
+		at = *ctx;
+		t = peek_token(vector, &at);
+		if (!tokenIsChar(t, ','))
+			break;
+		*ctx = at + 1;
+	}
+
+	error = append_string(c, result, CSS_PROP_FONT_FEATURE_SETTINGS,
+			FONT_FEATURE_SETTINGS_SET | (features << 1), text, len);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+
+invalid:
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
+
+/* font-size-adjust ----------------------------------------------------- */
+
+static const char *const metric_words[] = {
+	"ex-height", "cap-height", "ch-width", "ic-width", "ic-height"
+};
+
+/** none | [ ex-height | cap-height | ... ]? [ from-font | <number> ] */
+css_error css__parse_font_size_adjust(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *t;
+	css_error error;
+	css_fixed n = 0;
+	int metric;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_FONT_SIZE_ADJUST,
+			&error))
+		return error;
+
+	t = parserutils_vector_iterate(vector, ctx);
+	if (is_word(t, "none"))
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_FONT_SIZE_ADJUST, 0,
+				FONT_SIZE_ADJUST_NONE);
+	metric = word_index(t, metric_words, 5);
+	if (metric >= 0)
+		t = next_token(vector, ctx);
+	else
+		metric = 0;
+
+	if (is_word(t, "from-font"))
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_FONT_SIZE_ADJUST, 0,
+				FONT_SIZE_ADJUST_FROM_FONT | (metric << 2));
+	if (!token_number(t, false, &n) || n < 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_FONT_SIZE_ADJUST, 0,
+			FONT_SIZE_ADJUST_NUMBER | (metric << 2));
+	if (error == CSS_OK)
+		error = css__stylesheet_style_append(result, n);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/* text-emphasis -------------------------------------------------------- */
+
+static const char *const fill_words[] = { "filled", "open" };
+static const char *const mark_words[] = {
+	"dot", "circle", "double-circle", "triangle", "sesame"
+};
+
+/**
+ * One text-emphasis-style value: none | [ filled | open ] || <shape> |
+ * <string>, read from the tokens at *ctx. A shorthand gives
+ * stop_at_other, and the value then ends at the first token that is
+ * none of these, which is left where it is; it is CSS_INVALID if
+ * there is none.
+ */
+static css_error read_emphasis_style(const parserutils_vector *vector,
+		int32_t *ctx, bool stop_at_other, uint16_t *value,
+		const css_token **string)
+{
+	int fill = -1, mark = -1;
+	bool none = false;
+
+	*string = NULL;
+	for (;;) {
+		int32_t at = *ctx;
+		const css_token *t = peek_token(vector, &at);
+		int i;
+
+		if (t == NULL)
+			break;
+		if (t->type == CSS_TOKEN_STRING && fill < 0 && mark < 0 &&
+				!none && *string == NULL) {
+			*string = t;
+		} else if (is_word(t, "none") && fill < 0 && mark < 0 &&
+				!none && *string == NULL) {
+			none = true;
+		} else if (fill < 0 && *string == NULL && !none &&
+				(i = word_index(t, fill_words, 2)) >= 0) {
+			fill = i;
+		} else if (mark < 0 && *string == NULL && !none &&
+				(i = word_index(t, mark_words, 5)) >= 0) {
+			mark = i;
+		} else if (stop_at_other) {
+			break;
+		} else {
+			return CSS_INVALID;
+		}
+		*ctx = at + 1;
+	}
+
+	if (none)
+		*value = TEXT_EMPHASIS_STYLE_NONE;
+	else if (*string != NULL)
+		*value = TEXT_EMPHASIS_STYLE_STRING;
+	else if (fill >= 0 || mark >= 0)
+		*value = TEXT_EMPHASIS_STYLE_MARK |
+				((fill == 1 ? 1 : 0) << 2) |
+				((mark < 0 ? TEXT_EMPHASIS_STYLE_AUTO_SHAPE :
+				  mark) << 3);
+	else
+		return CSS_INVALID;
+	return CSS_OK;
+}
+
+static css_error append_emphasis_style(css_language *c, css_style *result,
+		uint16_t value, const css_token *string)
+{
+	if (string != NULL)
+		return append_string(c, result,
+				CSS_PROP_TEXT_EMPHASIS_STYLE, value,
+				lwc_string_data(string->idata),
+				lwc_string_length(string->idata));
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_TEXT_EMPHASIS_STYLE, 0, value);
+}
+
+css_error css__parse_text_emphasis_style(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *string;
+	uint16_t value;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_TEXT_EMPHASIS_STYLE,
+			&error))
+		return error;
+	error = read_emphasis_style(vector, ctx, false, &value, &string);
+	if (error == CSS_OK)
+		error = append_emphasis_style(c, result, value, string);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/** <style> || <color>, the one not given its initial value. */
+css_error css__parse_text_emphasis(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx, at;
+	const css_token *string = NULL, *t;
+	uint16_t style_value = TEXT_EMPHASIS_STYLE_NONE;
+	uint16_t colour_value = TEXT_EMPHASIS_COLOR_CURRENT_COLOR;
+	uint32_t colour = 0;
+	bool have_style = false, have_colour = false;
+	enum flag_value flag;
+	css_error error;
+
+	t = parserutils_vector_peek(vector, *ctx);
+	flag = get_css_flag_value(c, t);
+	if (flag != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		error = css_stylesheet_style_flag_value(result, flag,
+				CSS_PROP_TEXT_EMPHASIS_STYLE);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result, flag,
+					CSS_PROP_TEXT_EMPHASIS_COLOR);
+		return error;
+	}
+
+	while ((t = peek_token(vector, ctx)) != NULL) {
+		at = *ctx;
+		if (!have_style && read_emphasis_style(vector, &at, true,
+				&style_value, &string) == CSS_OK) {
+			have_style = true;
+			*ctx = at;
+			continue;
+		}
+		at = *ctx;
+		if (!have_colour && css__parse_colour_specifier(c, vector,
+				&at, &colour_value, &colour) == CSS_OK) {
+			have_colour = true;
+			*ctx = at;
+			continue;
+		}
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	if (!have_style && !have_colour) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	error = append_emphasis_style(c, result, style_value,
+			have_style ? string : NULL);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TEXT_EMPHASIS_COLOR, 0, colour_value);
+	if (error == CSS_OK && colour_value == COLOR_SET)
+		error = css__stylesheet_style_append(result, colour);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/** [ over | under ] && [ right | left ]? */
+css_error css__parse_text_emphasis_position(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	int side = -1, under = -1, i;
+	const css_token *t;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result,
+			CSS_PROP_TEXT_EMPHASIS_POSITION, &error))
+		return error;
+
+	for (i = 0; i < 2; i++) {
+		int32_t at = *ctx;
+
+		t = peek_token(vector, &at);
+		if (under < 0 && (is_word(t, "over") || is_word(t, "under")))
+			under = is_word(t, "under") ? 1 : 0;
+		else if (side < 0 && (is_word(t, "right") ||
+				is_word(t, "left")))
+			side = is_word(t, "left") ? 1 : 0;
+		else
+			break;
+		*ctx = at + 1;
+	}
+	if (under < 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_TEXT_EMPHASIS_POSITION, 0,
+			TEXT_EMPHASIS_POSITION_OVER_RIGHT |
+			(side > 0 ? 1 : 0) | (under << 1));
+}
+
+/* text-indent ---------------------------------------------------------- */
+
+/**
+ * <length-percentage> && hanging? && each-line?: the length is the
+ * text-indent property, and the keywords are a second, so a
+ * text-indent without them takes them away as it should.
+ */
+css_error css__parse_text_indent(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	uint16_t mode = 0;
+	bool have_length = false;
+	enum flag_value flag;
+	const css_token *t;
+	css_error error;
+
+	t = parserutils_vector_peek(vector, *ctx);
+	flag = get_css_flag_value(c, t);
+	if (flag != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		error = css_stylesheet_style_flag_value(result, flag,
+				CSS_PROP_TEXT_INDENT);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result, flag,
+					CSS_PROP_TEXT_INDENT_MODE);
+		return error;
+	}
+
+	while ((t = peek_token(vector, ctx)) != NULL) {
+		if (is_word(t, "hanging") &&
+				!(mode & CSS_TEXT_INDENT_HANGING)) {
+			mode |= CSS_TEXT_INDENT_HANGING;
+			parserutils_vector_iterate(vector, ctx);
+		} else if (is_word(t, "each-line") &&
+				!(mode & CSS_TEXT_INDENT_EACH_LINE)) {
+			mode |= CSS_TEXT_INDENT_EACH_LINE;
+			parserutils_vector_iterate(vector, ctx);
+		} else if (!have_length && t->type != CSS_TOKEN_IDENT) {
+			error = css__parse_text_indent_length(c, vector, ctx,
+					result);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			have_length = true;
+		} else {
+			break;
+		}
+	}
+	if (!have_length) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_TEXT_INDENT_MODE, 0,
+			TEXT_INDENT_MODE_NONE | mode);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/* image-rendering ------------------------------------------------------ */
+
+css_error css__parse_image_rendering(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	/* the standard's values, its legacy aliases of crisp-edges and
+	 * smooth, and the prefixed forms Chrome and Firefox take */
+	static const struct {
+		const char *word;
+		uint16_t value;
+	} words[] = {
+		{ "auto", IMAGE_RENDERING_AUTO },
+		{ "smooth", IMAGE_RENDERING_SMOOTH },
+		{ "high-quality", IMAGE_RENDERING_HIGH_QUALITY },
+		{ "pixelated", IMAGE_RENDERING_PIXELATED },
+		{ "crisp-edges", IMAGE_RENDERING_CRISP_EDGES },
+		{ "optimizespeed", IMAGE_RENDERING_CRISP_EDGES },
+		{ "optimizequality", IMAGE_RENDERING_SMOOTH },
+		{ "-webkit-optimize-contrast", IMAGE_RENDERING_CRISP_EDGES },
+		{ "-moz-crisp-edges", IMAGE_RENDERING_CRISP_EDGES },
+		{ "-webkit-crisp-edges", IMAGE_RENDERING_CRISP_EDGES },
+	};
+	int32_t orig_ctx = *ctx;
+	const css_token *t;
+	css_error error;
+	size_t i;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_IMAGE_RENDERING,
+			&error))
+		return error;
+	t = parserutils_vector_iterate(vector, ctx);
+	for (i = 0; i < sizeof(words) / sizeof(words[0]); i++) {
+		if (is_word(t, words[i].word))
+			return css__stylesheet_style_appendOPV(result,
+					CSS_PROP_IMAGE_RENDERING, 0,
+					words[i].value);
+	}
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
+
+/* shape-outside -------------------------------------------------------- */
+
+/** One argument of a basic shape: a length-percentage, a keyword, or a
+ * comma or a slash between them. */
+enum shape_arg_kind {
+	SHAPE_ARG_LP,		/* a length or percentage, or a zero */
+	SHAPE_ARG_WORD,
+	SHAPE_ARG_COMMA,
+	SHAPE_ARG_SLASH
+};
+
+struct shape_arg {
+	enum shape_arg_kind kind;
+	const css_token *t;
+	bool negative;
+};
+
+#define SHAPE_ARGS_MAX 160
+
+/** Whether a token is a length (with a unit Chrome takes), percentage
+ * or zero, and so a <length-percentage>. */
+static bool token_is_lp(css_language *c, const css_token *t, bool *negative)
+{
+	if (t == NULL)
+		return false;
+	if (t->type == CSS_TOKEN_PERCENTAGE ||
+			t->type == CSS_TOKEN_DIMENSION) {
+		const char *d = lwc_string_data(t->idata);
+
+		*negative = d[0] == '-';
+		if (t->type == CSS_TOKEN_DIMENSION) {
+			size_t consumed = 0, len = lwc_string_length(t->idata);
+			uint32_t unit;
+
+			css__number_from_lwc_string(t->idata, false,
+					&consumed);
+			if (css__parse_unit_keyword(d + consumed,
+					len - consumed, &unit) != CSS_OK ||
+					(unit & UNIT_LENGTH) == 0)
+				return false;
+		}
+		return true;
+	}
+	if (t->type == CSS_TOKEN_NUMBER) {
+		css_fixed n = 0;
+
+		*negative = false;
+		return token_number(t, false, &n) && n == 0;
+	}
+	UNUSED(c);
+	return false;
+}
+
+/** A shape's position, from arg i: 1 to 4 lengths or keywords. */
+static bool shape_position(const struct shape_arg *a, int n, int *i)
+{
+	static const char *const pos_words[] = {
+		"left", "right", "top", "bottom", "center"
+	};
+	int k = 0;
+
+	while (*i < n && k < 4 && (a[*i].kind == SHAPE_ARG_LP ||
+			(a[*i].kind == SHAPE_ARG_WORD &&
+			 word_index(a[*i].t, pos_words, 5) >= 0))) {
+		(*i)++;
+		k++;
+	}
+	return k > 0;
+}
+
+/** round <border-radius>, from arg i, if it is there. */
+static bool shape_round(const struct shape_arg *a, int n, int *i)
+{
+	int k = 0;
+
+	if (*i >= n || a[*i].kind != SHAPE_ARG_WORD ||
+			!is_word(a[*i].t, "round"))
+		return true;
+	(*i)++;
+	while (*i < n && k < 4 && a[*i].kind == SHAPE_ARG_LP &&
+			!a[*i].negative) {
+		(*i)++;
+		k++;
+	}
+	if (k == 0)
+		return false;
+	if (*i < n && a[*i].kind == SHAPE_ARG_SLASH) {
+		(*i)++;
+		k = 0;
+		while (*i < n && k < 4 && a[*i].kind == SHAPE_ARG_LP &&
+				!a[*i].negative) {
+			(*i)++;
+			k++;
+		}
+		if (k == 0)
+			return false;
+	}
+	return true;
+}
+
+/** Whether the arguments are what the shape function takes. */
+static bool shape_args_valid(const char *fn, const struct shape_arg *a,
+		int n)
+{
+	int i = 0, k;
+
+	if (strcmp(fn, "circle") == 0 || strcmp(fn, "ellipse") == 0) {
+		int radii = strcmp(fn, "circle") == 0 ? 1 : 2;
+
+		for (k = 0; k < radii && i < n; k++) {
+			if ((a[i].kind == SHAPE_ARG_LP && !a[i].negative) ||
+					(a[i].kind == SHAPE_ARG_WORD &&
+					 (is_word(a[i].t, "closest-side") ||
+					  is_word(a[i].t, "farthest-side"))))
+				i++;
+			else
+				break;
+		}
+		if (k != 0 && k != radii)
+			return false;
+		if (i < n && a[i].kind == SHAPE_ARG_WORD &&
+				is_word(a[i].t, "at")) {
+			i++;
+			if (!shape_position(a, n, &i))
+				return false;
+		}
+		return i == n;
+	}
+	if (strcmp(fn, "inset") == 0) {
+		for (k = 0; k < 4 && i < n && a[i].kind == SHAPE_ARG_LP; k++)
+			i++;
+		return k > 0 && shape_round(a, n, &i) && i == n;
+	}
+	if (strcmp(fn, "xywh") == 0) {
+		for (k = 0; k < 4 && i < n && a[i].kind == SHAPE_ARG_LP &&
+				(k < 2 || !a[i].negative); k++)
+			i++;
+		return k == 4 && shape_round(a, n, &i) && i == n;
+	}
+	if (strcmp(fn, "rect") == 0) {
+		for (k = 0; k < 4 && i < n && (a[i].kind == SHAPE_ARG_LP ||
+				(a[i].kind == SHAPE_ARG_WORD &&
+				 is_word(a[i].t, "auto"))); k++)
+			i++;
+		return k == 4 && shape_round(a, n, &i) && i == n;
+	}
+	if (strcmp(fn, "polygon") == 0) {
+		if (i < n && a[i].kind == SHAPE_ARG_WORD &&
+				(is_word(a[i].t, "nonzero") ||
+				 is_word(a[i].t, "evenodd"))) {
+			i++;
+			if (i >= n || a[i].kind != SHAPE_ARG_COMMA)
+				return false;
+			i++;
+		}
+		for (;;) {
+			if (i + 1 >= n || a[i].kind != SHAPE_ARG_LP ||
+					a[i + 1].kind != SHAPE_ARG_LP)
+				return false;
+			i += 2;
+			if (i == n)
+				return true;
+			if (a[i].kind != SHAPE_ARG_COMMA)
+				return false;
+			i++;
+		}
+	}
+	return false;
+}
+
+/**
+ * A basic shape at *ctx, the function token taken, written into text
+ * as its name, its arguments with single spaces and commas, and its
+ * close.
+ */
+static bool read_basic_shape(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		const css_token *fn_token, char *text, size_t size,
+		size_t *len)
+{
+	static const char *const shape_fns[] = {
+		"circle", "ellipse", "inset", "polygon", "xywh", "rect"
+	};
+	struct shape_arg args[SHAPE_ARGS_MAX];
+	int n = 0, fn, i;
+	size_t l = 0;
+
+	for (fn = 0; fn < 6; fn++) {
+		size_t fl = strlen(shape_fns[fn]);
+
+		if (lwc_string_length(fn_token->idata) == fl &&
+				strncasecmp(lwc_string_data(fn_token->idata),
+					shape_fns[fn], fl) == 0)
+			break;
+	}
+	if (fn == 6)
+		return false;
+
+	for (;;) {
+		const css_token *t = next_token(vector, ctx);
+		bool neg = false;
+
+		if (t == NULL)
+			return false;
+		if (tokenIsChar(t, ')'))
+			break;
+		if (n == SHAPE_ARGS_MAX)
+			return false;
+		args[n].t = t;
+		args[n].negative = false;
+		if (tokenIsChar(t, ','))
+			args[n].kind = SHAPE_ARG_COMMA;
+		else if (tokenIsChar(t, '/'))
+			args[n].kind = SHAPE_ARG_SLASH;
+		else if (t->type == CSS_TOKEN_IDENT)
+			args[n].kind = SHAPE_ARG_WORD;
+		else if (token_is_lp(c, t, &neg)) {
+			args[n].kind = SHAPE_ARG_LP;
+			args[n].negative = neg;
+		} else
+			return false;
+		n++;
+	}
+	if (!shape_args_valid(shape_fns[fn], args, n))
+		return false;
+
+	l = (size_t) snprintf(text, size, "%s(", shape_fns[fn]);
+	for (i = 0; i < n && l < size; i++) {
+		const struct shape_arg *a = &args[i];
+
+		if (a->kind == SHAPE_ARG_COMMA) {
+			l += (size_t) snprintf(text + l, size - l, ",");
+			continue;
+		}
+		if (i > 0 && l < size)
+			text[l++] = ' ';
+		if (a->kind == SHAPE_ARG_SLASH) {
+			l += (size_t) snprintf(text + l, size - l, "/");
+		} else {
+			const char *d = lwc_string_data(a->t->idata);
+			size_t dl = lwc_string_length(a->t->idata), k;
+
+			for (k = 0; k < dl && l < size; k++) {
+				char ch = d[k];
+
+				text[l++] = (ch >= 'A' && ch <= 'Z') ?
+						ch + 32 : ch;
+			}
+			if (a->t->type == CSS_TOKEN_PERCENTAGE && l < size)
+				text[l++] = '%';
+		}
+	}
+	if (l + 1 >= size)
+		return false;
+	text[l++] = ')';
+	text[l] = '\0';
+	*len = l;
+	return true;
+}
+
+/**
+ * none | [ <basic-shape> || <shape-box> ] | <image>. An image is taken,
+ * as Chrome takes it, and the float keeps its margin box: its picture
+ * is not read for a shape.
+ */
+css_error css__parse_shape_outside(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const char *const box_words[] = {
+		"margin-box", "border-box", "padding-box", "content-box"
+	};
+	int32_t orig_ctx = *ctx;
+	char text[1024];
+	size_t len = 0;
+	int box = -1;
+	bool shape = false;
+	const css_token *t;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_SHAPE_OUTSIDE,
+			&error))
+		return error;
+
+	t = parserutils_vector_peek(vector, *ctx);
+	if (is_word(t, "none")) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_SHAPE_OUTSIDE, 0,
+				SHAPE_OUTSIDE_NONE);
+	}
+	if (t != NULL && (t->type == CSS_TOKEN_URI ||
+			(t->type == CSS_TOKEN_FUNCTION &&
+			 strstr(lwc_string_data(t->idata), "gradient") !=
+			 NULL))) {
+		/* an image: checked as background-image checks it */
+		css_style *tmp;
+
+		error = css__stylesheet_style_create(c->sheet, &tmp);
+		if (error != CSS_OK)
+			return error;
+		error = css__parse_background_image(c, vector, ctx, tmp);
+		css__stylesheet_style_destroy(tmp);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		/* an address is kept to read back, a gradient is not */
+		if (t->type == CSS_TOKEN_URI) {
+			len = (size_t) snprintf(text, sizeof(text),
+					"url(\"%.*s\")|", (int) lwc_string_length(
+						t->idata),
+					lwc_string_data(t->idata));
+			if (len >= sizeof(text))
+				len = (size_t) snprintf(text, sizeof(text),
+						"image|");
+		} else {
+			len = (size_t) snprintf(text, sizeof(text),
+					"image|");
+		}
+		error = append_string(c, result, CSS_PROP_SHAPE_OUTSIDE,
+				SHAPE_OUTSIDE_SET, text, len);
+		if (error != CSS_OK)
+			*ctx = orig_ctx;
+		return error;
+	}
+
+	while ((t = peek_token(vector, ctx)) != NULL) {
+		int b;
+
+		if (box < 0 && (b = word_index(t, box_words, 4)) >= 0) {
+			box = b;
+			parserutils_vector_iterate(vector, ctx);
+		} else if (!shape && t->type == CSS_TOKEN_FUNCTION) {
+			parserutils_vector_iterate(vector, ctx);
+			if (!read_basic_shape(c, vector, ctx, t, text,
+					sizeof(text) - 16, &len))
+				goto invalid;
+			shape = true;
+		} else {
+			break;
+		}
+	}
+	if (!shape && box < 0)
+		goto invalid;
+	len += (size_t) snprintf(text + len, sizeof(text) - len, "|%s",
+			box >= 0 ? box_words[box] : "");
+	error = append_string(c, result, CSS_PROP_SHAPE_OUTSIDE,
+			SHAPE_OUTSIDE_SET, text, len);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+
+invalid:
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
+
+/** <number> | <percentage>, as only an image's shape would read it. */
+css_error css__parse_shape_image_threshold(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *t;
+	css_fixed n;
+
+	UNUSED(result);
+
+	/* kept nowhere, so a flag is not either */
+	t = parserutils_vector_iterate(vector, ctx);
+	if (get_css_flag_value(c, t) != FLAG_VALUE__NONE)
+		return CSS_OK;
+	if (token_number(t, false, &n) ||
+			(t != NULL && t->type == CSS_TOKEN_PERCENTAGE))
+		return CSS_OK;
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
+
+/* initial-letter ------------------------------------------------------- */
+
+/**
+ * normal | <number [1,inf]> <integer [1,inf]> | <number [1,inf]> &&
+ * [ drop | raise ]?: the size in lines, and how many it sinks, drop
+ * being the size's whole lines and raise one.
+ */
+css_error css__parse_initial_letter(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx, at;
+	const css_token *t;
+	css_error error;
+	css_fixed size = 0, sink = 0;
+	int how = -1;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_INITIAL_LETTER,
+			&error))
+		return error;
+
+	t = parserutils_vector_iterate(vector, ctx);
+	if (is_word(t, "normal"))
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_INITIAL_LETTER, 0,
+				INITIAL_LETTER_NORMAL);
+	if (is_word(t, "drop") || is_word(t, "raise")) {
+		how = is_word(t, "raise") ? 1 : 0;
+		t = next_token(vector, ctx);
+	}
+	if (!token_number(t, false, &size) || size < INTTOFIX(1))
+		goto invalid;
+
+	at = *ctx;
+	t = peek_token(vector, &at);
+	if (how < 0 && (is_word(t, "drop") || is_word(t, "raise"))) {
+		how = is_word(t, "raise") ? 1 : 0;
+		*ctx = at + 1;
+	} else if (how < 0 && t != NULL && t->type == CSS_TOKEN_NUMBER) {
+		if (!token_number(t, true, &sink) || sink < INTTOFIX(1))
+			goto invalid;
+		*ctx = at + 1;
+	}
+	if (sink == 0)
+		sink = how == 1 ? INTTOFIX(1) :
+				INTTOFIX(FIXTOINT(size) < 1 ? 1 :
+					FIXTOINT(size));
+
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_INITIAL_LETTER, 0, INITIAL_LETTER_SET);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_vappend(result, 2, size, sink);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+
+invalid:
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
