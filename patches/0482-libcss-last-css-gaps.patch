+
+static inline css_error set_shape_outside(css_computed_style *style, uint8_t
+		type, lwc_string *string)
+{
+	uint32_t *bits = &style->i.bits[SHAPE_OUTSIDE_INDEX];
+
+	/* 2bits: tt : type */
+	*bits = (*bits & ~SHAPE_OUTSIDE_MASK) | (((uint32_t)type & 0x3) <<
+			SHAPE_OUTSIDE_SHIFT);
+
+	lwc_string *old_string = style->i.shape_outside;
+
+	if (string != NULL) {
+		style->i.shape_outside = lwc_string_ref(string);
+	} else {
+		style->i.shape_outside = NULL;
+	}
+
+	lwc_string_unref(old_string);
+
+	return CSS_OK;
+}
