diff --git a/src/select/properties/last_gaps.c b/src/select/properties/last_gaps.c
new file mode 100644
index 0000000..ce6d2be
--- /dev/null
+++ b/src/select/properties/last_gaps.c
@@ -0,0 +1,580 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * The last of what the census found dropped (VitaSurf):
+ * font-feature-settings, font-size-adjust, text-emphasis-style, -color
+ * and -position, text-indent's hanging and each-line, image-rendering,
+ * shape-outside, shape-margin and initial-letter.
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/** A string-valued property's string, read from the bytecode. */
+static lwc_string *bytecode_string(css_style *style)
+{
+	lwc_string *str = NULL;
+
+	css__stylesheet_string_get(style->sheet,
+			*((css_code_t *) style->bytecode), &str);
+	advance_bytecode(style, sizeof(css_code_t));
+	return str;
+}
+
+/* font-feature-settings ------------------------------------------------ */
+
+css_error css__cascade_font_feature_settings(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_FONT_FEATURE_SETTINGS_INHERIT;
+	lwc_string *text = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		if (getValue(opv) & FONT_FEATURE_SETTINGS_SET) {
+			value = CSS_FONT_FEATURE_SETTINGS_SET +
+					(getValue(opv) >> 1);
+			text = bytecode_string(style);
+		} else {
+			value = CSS_FONT_FEATURE_SETTINGS_NORMAL;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_font_feature_settings(state->computed, value, text);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_font_feature_settings_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error = set_font_feature_settings(style, hint->status,
+			hint->data.string);
+
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+	return error;
+}
+
+css_error css__initial_font_feature_settings(css_select_state *state)
+{
+	return set_font_feature_settings(state->computed,
+			CSS_FONT_FEATURE_SETTINGS_NORMAL, NULL);
+}
+
+css_error css__copy_font_feature_settings(const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *text;
+	uint8_t type = get_font_feature_settings(from, &text);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_font_feature_settings(to, type, text);
+}
+
+css_error css__compose_font_feature_settings(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *text;
+	uint8_t type = get_font_feature_settings(child, &text);
+
+	return css__copy_font_feature_settings(
+			type == CSS_FONT_FEATURE_SETTINGS_INHERIT ?
+			parent : child, result);
+}
+
+/* font-size-adjust ----------------------------------------------------- */
+
+css_error css__cascade_font_size_adjust(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_FONT_SIZE_ADJUST_INHERIT;
+	css_fixed n = 0;
+
+	if (hasFlagValue(opv) == false) {
+		uint16_t v = getValue(opv);
+
+		switch (v & 3) {
+		case FONT_SIZE_ADJUST_NONE:
+			value = CSS_FONT_SIZE_ADJUST_NONE;
+			break;
+		case FONT_SIZE_ADJUST_FROM_FONT:
+			value = CSS_FONT_SIZE_ADJUST_SET + 2 * (v >> 2) + 1;
+			break;
+		default:
+			value = CSS_FONT_SIZE_ADJUST_SET + 2 * (v >> 2);
+			n = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(n));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_font_size_adjust(state->computed, value, n);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_font_size_adjust_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_font_size_adjust(style, hint->status, hint->data.fixed);
+}
+
+css_error css__initial_font_size_adjust(css_select_state *state)
+{
+	return set_font_size_adjust(state->computed,
+			CSS_FONT_SIZE_ADJUST_NONE, 0);
+}
+
+css_error css__copy_font_size_adjust(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed n = 0;
+	uint8_t type = get_font_size_adjust(from, &n);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_font_size_adjust(to, type, n);
+}
+
+css_error css__compose_font_size_adjust(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed n = 0;
+	uint8_t type = get_font_size_adjust(child, &n);
+
+	return css__copy_font_size_adjust(
+			type == CSS_FONT_SIZE_ADJUST_INHERIT ? parent : child,
+			result);
+}
+
+/* text-emphasis-style -------------------------------------------------- */
+
+css_error css__cascade_text_emphasis_style(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_TEXT_EMPHASIS_STYLE_INHERIT;
+	lwc_string *text = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		uint16_t v = getValue(opv);
+
+		if (v == TEXT_EMPHASIS_STYLE_NONE) {
+			value = CSS_TEXT_EMPHASIS_STYLE_NONE;
+		} else if (v == TEXT_EMPHASIS_STYLE_STRING) {
+			value = CSS_TEXT_EMPHASIS_STYLE_STRING;
+			text = bytecode_string(style);
+		} else {
+			unsigned open = (v >> 2) & 1, shape = v >> 3;
+
+			/* a fill alone is a circle in horizontal text */
+			if (shape == TEXT_EMPHASIS_STYLE_AUTO_SHAPE ||
+					shape > CSS_TEXT_EMPHASIS_MARK_SESAME)
+				shape = CSS_TEXT_EMPHASIS_MARK_CIRCLE;
+			value = CSS_TEXT_EMPHASIS_STYLE_MARK + 5 * open +
+					shape;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_text_emphasis_style(state->computed, value, text);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_text_emphasis_style_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error = set_text_emphasis_style(style, hint->status,
+			hint->data.string);
+
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+	return error;
+}
+
+css_error css__initial_text_emphasis_style(css_select_state *state)
+{
+	return set_text_emphasis_style(state->computed,
+			CSS_TEXT_EMPHASIS_STYLE_NONE, NULL);
+}
+
+css_error css__copy_text_emphasis_style(const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *text;
+	uint8_t type = get_text_emphasis_style(from, &text);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_text_emphasis_style(to, type, text);
+}
+
+css_error css__compose_text_emphasis_style(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *text;
+	uint8_t type = get_text_emphasis_style(child, &text);
+
+	return css__copy_text_emphasis_style(
+			type == CSS_TEXT_EMPHASIS_STYLE_INHERIT ?
+			parent : child, result);
+}
+
+/* text-emphasis-color -------------------------------------------------- */
+
+css_error css__cascade_text_emphasis_color(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_TEXT_EMPHASIS_COLOR_INHERIT;
+	css_color color = 0;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case TEXT_EMPHASIS_COLOR_TRANSPARENT:
+			value = CSS_TEXT_EMPHASIS_COLOR_COLOR;
+			break;
+		case TEXT_EMPHASIS_COLOR_CURRENT_COLOR:
+			value = CSS_TEXT_EMPHASIS_COLOR_CURRENT_COLOR;
+			break;
+		case TEXT_EMPHASIS_COLOR_SET:
+			value = CSS_TEXT_EMPHASIS_COLOR_COLOR;
+			color = *((css_color *) style->bytecode);
+			advance_bytecode(style, sizeof(color));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_text_emphasis_color(state->computed, value, color);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_text_emphasis_color_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_text_emphasis_color(style, hint->status, hint->data.color);
+}
+
+css_error css__initial_text_emphasis_color(css_select_state *state)
+{
+	return set_text_emphasis_color(state->computed,
+			CSS_TEXT_EMPHASIS_COLOR_CURRENT_COLOR, 0);
+}
+
+css_error css__copy_text_emphasis_color(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_color color;
+	uint8_t type = get_text_emphasis_color(from, &color);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_text_emphasis_color(to, type, color);
+}
+
+css_error css__compose_text_emphasis_color(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_color color;
+	uint8_t type = get_text_emphasis_color(child, &color);
+
+	return css__copy_text_emphasis_color(
+			type == CSS_TEXT_EMPHASIS_COLOR_INHERIT ?
+			parent : child, result);
+}
+
+/* the keyword properties ----------------------------------------------- */
+
+/*
+ * text-emphasis-position, text-indent's mode and image-rendering: each
+ * one keyword, the computed value 1 + the opcode's.
+ */
+#define KEYWORD_PROPERTY(name, INHERIT, INITIAL)			\
+css_error css__cascade_##name(uint32_t opv, css_style *style,		\
+		css_select_state *state)				\
+{									\
+	uint16_t value = INHERIT;					\
+									\
+	UNUSED(style);							\
+									\
+	if (hasFlagValue(opv) == false)					\
+		value = 1 + getValue(opv);				\
+									\
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv),	\
+			state, getFlagValue(opv))) {			\
+		return set_##name(state->computed, value);		\
+	}								\
+									\
+	return CSS_OK;							\
+}									\
+									\
+css_error css__set_##name##_from_hint(const css_hint *hint,		\
+		css_computed_style *style)				\
+{									\
+	return set_##name(style, hint->status);				\
+}									\
+									\
+css_error css__initial_##name(css_select_state *state)			\
+{									\
+	return set_##name(state->computed, INITIAL);			\
+}									\
+									\
+css_error css__copy_##name(const css_computed_style *from,		\
+		css_computed_style *to)					\
+{									\
+	if (from == to) {						\
+		return CSS_OK;						\
+	}								\
+									\
+	return set_##name(to, get_##name(from));			\
+}									\
+									\
+css_error css__compose_##name(const css_computed_style *parent,	\
+		const css_computed_style *child,			\
+		css_computed_style *result)				\
+{									\
+	return css__copy_##name(get_##name(child) == INHERIT ?		\
+			parent : child, result);			\
+}
+
+KEYWORD_PROPERTY(text_emphasis_position,
+		CSS_TEXT_EMPHASIS_POSITION_INHERIT,
+		CSS_TEXT_EMPHASIS_POSITION_OVER_RIGHT)
+KEYWORD_PROPERTY(text_indent_mode, CSS_TEXT_INDENT_MODE_INHERIT,
+		CSS_TEXT_INDENT_MODE_NONE)
+KEYWORD_PROPERTY(image_rendering, CSS_IMAGE_RENDERING_INHERIT,
+		CSS_IMAGE_RENDERING_AUTO)
+
+#undef KEYWORD_PROPERTY
+
+/* shape-outside -------------------------------------------------------- */
+
+css_error css__cascade_shape_outside(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_SHAPE_OUTSIDE_INHERIT;
+	lwc_string *text = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		if (getValue(opv) == SHAPE_OUTSIDE_SET) {
+			value = CSS_SHAPE_OUTSIDE_SET;
+			text = bytecode_string(style);
+		} else {
+			value = CSS_SHAPE_OUTSIDE_NONE;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_shape_outside(state->computed, value, text);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_shape_outside_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error = set_shape_outside(style, hint->status,
+			hint->data.string);
+
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+	return error;
+}
+
+css_error css__initial_shape_outside(css_select_state *state)
+{
+	return set_shape_outside(state->computed, CSS_SHAPE_OUTSIDE_NONE,
+			NULL);
+}
+
+css_error css__copy_shape_outside(const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *text;
+	uint8_t type = get_shape_outside(from, &text);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_shape_outside(to, type, text);
+}
+
+css_error css__compose_shape_outside(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *text;
+	uint8_t type = get_shape_outside(child, &text);
+
+	return css__copy_shape_outside(type == CSS_SHAPE_OUTSIDE_INHERIT ?
+			parent : child, result);
+}
+
+/* shape-margin --------------------------------------------------------- */
+
+css_error css__cascade_shape_margin(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_SHAPE_MARGIN_INHERIT;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false) {
+		value = CSS_SHAPE_MARGIN_SET;
+		length = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(length));
+		unit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(unit));
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_shape_margin(state->computed, value, length,
+				css__to_css_unit(unit));
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_shape_margin_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_shape_margin(style, hint->status, hint->data.length.value,
+			hint->data.length.unit);
+}
+
+css_error css__initial_shape_margin(css_select_state *state)
+{
+	return set_shape_margin(state->computed, CSS_SHAPE_MARGIN_SET, 0,
+			CSS_UNIT_PX);
+}
+
+css_error css__copy_shape_margin(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t type = get_shape_margin(from, &length, &unit);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_shape_margin(to, type, length, unit);
+}
+
+css_error css__compose_shape_margin(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t type = get_shape_margin(child, &length, &unit);
+
+	return css__copy_shape_margin(type == CSS_SHAPE_MARGIN_INHERIT ?
+			parent : child, result);
+}
+
+/* initial-letter ------------------------------------------------------- */
+
+css_error css__cascade_initial_letter(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_INITIAL_LETTER_INHERIT;
+	css_fixed size = 0, sink = 0;
+
+	if (hasFlagValue(opv) == false) {
+		if (getValue(opv) == INITIAL_LETTER_SET) {
+			value = CSS_INITIAL_LETTER_SET;
+			size = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(size));
+			sink = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(sink));
+		} else {
+			value = CSS_INITIAL_LETTER_NORMAL;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_initial_letter(state->computed, value, size, sink);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_initial_letter_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_initial_letter(style, hint->status,
+			hint->data.position.h.value,
+			hint->data.position.v.value);
+}
+
+css_error css__initial_initial_letter(css_select_state *state)
+{
+	return set_initial_letter(state->computed,
+			CSS_INITIAL_LETTER_NORMAL, 0, 0);
+}
+
+css_error css__copy_initial_letter(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed size = 0, sink = 0;
+	uint8_t type = get_initial_letter(from, &size, &sink);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_initial_letter(to, type, size, sink);
+}
+
+css_error css__compose_initial_letter(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed size = 0, sink = 0;
+	uint8_t type = get_initial_letter(child, &size, &sink);
+
+	return css__copy_initial_letter(type == CSS_INITIAL_LETTER_INHERIT ?
+			parent : child, result);
+}
