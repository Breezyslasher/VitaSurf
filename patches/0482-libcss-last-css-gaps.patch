+/** A line height in px, of a style whose font size is in px. */
+static float initial_letter_line(const css_computed_style *s, float fs)
+{
+	css_fixed_or_calc lh = { .value = 0 };
+	css_unit unit = CSS_UNIT_PX;
+
+	switch (get_line_height(s, &lh, &unit)) {
+	case CSS_LINE_HEIGHT_NUMBER:
+		return FIXTOFLT(lh.value) * fs;
+	case CSS_LINE_HEIGHT_DIMENSION:
+		if (unit == CSS_UNIT_PX)
+			return FIXTOFLT(lh.value);
+		break;
+	default:
+		break;
+	}
+	return 1.2f * fs;
+}
