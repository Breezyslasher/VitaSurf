  */
+/**
+ * May a word in this box be broken in the middle? (VitaSurf)
+ *
+ * A word longer than its container otherwise runs out of the box and
+ * over whatever is beside it, which is what sites ask to avoid with
+ * overflow-wrap and word-break. break-all allows a break anywhere;
+ * keep-all forbids one; overflow-wrap only matters once the word has
+ * been found not to fit, which is the only place this is asked.
+ */
+static bool layout_may_break_word(const struct box *box)
+{
+	if (box->style == NULL || box->text == NULL || box->length < 2) {
+		return false;
+	}
+
+	switch (css_computed_word_break(box->style)) {
+	case CSS_WORD_BREAK_BREAK_ALL:
+		return true;
+	case CSS_WORD_BREAK_KEEP_ALL:
+		return false;
+	default:
+		break;
+	}
+
+	switch (css_computed_overflow_wrap(box->style)) {
+	case CSS_OVERFLOW_WRAP_BREAK_WORD:
+	case CSS_OVERFLOW_WRAP_ANYWHERE:
+		return true;
+	default:
+		return false;
+	}
+}
+
