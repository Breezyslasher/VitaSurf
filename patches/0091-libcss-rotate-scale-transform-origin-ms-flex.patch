+					/* Second pass, so ignore */
+					break;
+				} else {
+					/* First pass, so invalid */
+					*ctx = orig_ctx;
+					return CSS_INVALID;
+				}
+			}
+
+			consumeWhitespace(vector, ctx);
+		}
+
+		assert(i != 0);
+
+		/* Now, sort out the mess we've got */
+		if (i == 1) {
+			assert(TRANSFORM_ORIGIN_VERT_CENTER ==
+					TRANSFORM_ORIGIN_HORZ_CENTER);
+
+			/* Only one value, so the other is center */
+			switch (value[0]) {
+			case TRANSFORM_ORIGIN_HORZ_LEFT:
+			case TRANSFORM_ORIGIN_HORZ_RIGHT:
+			case TRANSFORM_ORIGIN_VERT_CENTER:
+			case TRANSFORM_ORIGIN_VERT_TOP:
+			case TRANSFORM_ORIGIN_VERT_BOTTOM:
+				break;
+			case TRANSFORM_ORIGIN_VERT_SET:
+				value[0] = TRANSFORM_ORIGIN_HORZ_SET;
+				break;
+			}
+
+			value[1] = TRANSFORM_ORIGIN_VERT_CENTER;
+		} else if (value[0] != TRANSFORM_ORIGIN_VERT_SET &&
+				value[1] != TRANSFORM_ORIGIN_VERT_SET) {
+			/* Two keywords. Verify the axes differ */
+			if (((value[0] & 0xf) != 0 && (value[1] & 0xf) != 0) ||
+					((value[0] & 0xf0) != 0 &&
+						(value[1] & 0xf0) != 0)) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		} else {
+			/* One or two non-keywords. First is horizontal */
+			if (value[0] == TRANSFORM_ORIGIN_VERT_SET)
+				value[0] = TRANSFORM_ORIGIN_HORZ_SET;
+
+			/* Verify the axes differ */
+			if (((value[0] & 0xf) != 0 && (value[1] & 0xf) != 0) ||
+					((value[0] & 0xf0) != 0 &&
+						(value[1] & 0xf0) != 0)) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		}
+
+		/* A third value is the depth: read and dropped */
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token != NULL && (token->type == CSS_TOKEN_DIMENSION ||
+				token->type == CSS_TOKEN_NUMBER)) {
+			css_fixed z = 0;
+			uint32_t zunit = UNIT_PX;
+
+			error = css__parse_unit_specifier(c, vector, ctx,
+					UNIT_PX, &z, &zunit);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+		}
+	}
+
+	error = css__stylesheet_style_appendOPV(result,
+					       CSS_PROP_TRANSFORM_ORIGIN,
+					       flags,
+					       value[0] | value[1]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	if ((flags & FLAG_INHERIT) == false) {
+		if (value[0] == TRANSFORM_ORIGIN_HORZ_SET) {
+			error = css__stylesheet_style_append(result, length[0]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+
+			error = css__stylesheet_style_append(result, unit[0]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+		}
+		if (value[1] == TRANSFORM_ORIGIN_VERT_SET) {
+			error = css__stylesheet_style_append(result, length[1]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+
+			error = css__stylesheet_style_append(result, unit[1]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+		}
+	}
+
+	return CSS_OK;
+}
diff --git a/src/parse/properties/vendor.c b/src/parse/properties/vendor.c
new file mode 100644
index 0000000..c300475
--- /dev/null
+++ b/src/parse/properties/vendor.c
@@ -0,0 +1,125 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * Internet Explorer's flexbox draft (VitaSurf). Autoprefixer still
+ * writes -ms-flex-align, -ms-flex-pack and their relatives next to the
+ * standard properties, and the draft spelt some keywords differently:
+ * start and end for flex-start and flex-end, justify and distribute for
+ * space-between and space-around. A declaration in the old spelling
+ * is read as the standard property it stands for, so it neither drops
+ * the rule nor differs from the standard declaration beside it.
+ */
+
+struct ms_keyword {
+	int string;		/**< index into c->strings */
+	uint16_t value;		/**< opcode value for the standard property */
+};
+
+/**
+ * Read one of the draft's keywords, or hand over to the standard parser.
+ */
+static css_error parse_ms_keywords(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, uint16_t prop,
+		const struct ms_keyword *table, size_t n,
+		css_error (*standard)(css_language *c,
+				const parserutils_vector *vector, int32_t *ctx,
+				css_style *result))
+{
+	const css_token *token;
+	bool match;
+	size_t i;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && token->type == CSS_TOKEN_IDENT) {
+		for (i = 0; i < n; i++) {
+			if (lwc_string_caseless_isequal(token->idata,
+					c->strings[table[i].string],
+					&match) == lwc_error_ok && match) {
+				parserutils_vector_iterate(vector, ctx);
+				return css__stylesheet_style_appendOPV(result,
+						prop, 0, table[i].value);
+			}
+		}
+	}
+
+	return standard(c, vector, ctx, result);
+}
+
+/** -ms-flex-align: start | end | center | baseline | stretch */
+css_error css__parse_ms_flex_align(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct ms_keyword table[] = {
+		{ START, ALIGN_ITEMS_FLEX_START },
+		{ END, ALIGN_ITEMS_FLEX_END },
+	};
+
+	return parse_ms_keywords(c, vector, ctx, result,
+			CSS_PROP_ALIGN_ITEMS, table, 2,
+			css__parse_align_items);
+}
+
+/** -ms-flex-item-align, -ms-align-self: auto | start | end | ... */
+css_error css__parse_ms_align_self(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct ms_keyword table[] = {
+		{ START, ALIGN_SELF_FLEX_START },
+		{ END, ALIGN_SELF_FLEX_END },
+	};
+
+	return parse_ms_keywords(c, vector, ctx, result,
+			CSS_PROP_ALIGN_SELF, table, 2,
+			css__parse_align_self);
+}
+
+/** -ms-flex-pack: start | end | center | justify | distribute */
+css_error css__parse_ms_flex_pack(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct ms_keyword table[] = {
+		{ START, JUSTIFY_CONTENT_FLEX_START },
+		{ END, JUSTIFY_CONTENT_FLEX_END },
+		{ JUSTIFY, JUSTIFY_CONTENT_SPACE_BETWEEN },
+		{ DISTRIBUTE, JUSTIFY_CONTENT_SPACE_AROUND },
+	};
+
+	return parse_ms_keywords(c, vector, ctx, result,
+			CSS_PROP_JUSTIFY_CONTENT, table, 4,
+			css__parse_justify_content);
+}
+
+/** -ms-flex-line-pack: start | end | center | justify | distribute |
+ *  stretch */
+css_error css__parse_ms_flex_line_pack(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct ms_keyword table[] = {
+		{ START, ALIGN_CONTENT_FLEX_START },
+		{ END, ALIGN_CONTENT_FLEX_END },
+		{ JUSTIFY, ALIGN_CONTENT_SPACE_BETWEEN },
+		{ DISTRIBUTE, ALIGN_CONTENT_SPACE_AROUND },
+	};
+
+	return parse_ms_keywords(c, vector, ctx, result,
+			CSS_PROP_ALIGN_CONTENT, table, 4,
+			css__parse_align_content);
+}
