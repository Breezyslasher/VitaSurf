diff --git a/content/handlers/html/object.c b/content/handlers/html/object.c
index 24d920eca..35fef8c66 100644
--- a/content/handlers/html/object.c
+++ b/content/handlers/html/object.c
@@ -191,12 +191,32 @@ html_object_callback(hlcache_handle *object,
 
 			/* Adjust parent content for new object size */
 			html_object_done(box, object, o->background, o->mask);
+			/*
+			 * Only if the object can still change the shape of
+			 * the page (VitaSurf).
+			 *
+			 * This laid the whole document out again for every
+			 * object that became ready. A GitHub profile loads
+			 * 296 images and is laid out 143 times, every one of
+			 * those passes taking 100 ms or more and 23059 ms
+			 * between them -- a sixth of the load, spent
+			 * re-answering a question whose answer had not
+			 * changed. REPLACE_DIM means the box's size is
+			 * already fixed by its attributes or its CSS, so
+			 * what the object turned out to be cannot move
+			 * anything; the DONE case below already relies on
+			 * exactly that to redraw rather than reformat.
+			 */
+			vitasurf_object_ready++;
 			if (c->layout != NULL &&
+					(box->flags & REPLACE_DIM) == 0 &&
 					(c->base.status == CONTENT_STATUS_READY ||
-					c->base.status == CONTENT_STATUS_DONE))
+					c->base.status == CONTENT_STATUS_DONE)) {
+				vitasurf_object_reformats++;
 				content__reformat(&c->base, false,
 						c->base.available_width,
 						c->base.available_height);
+			}
 		}
 		break;
 
