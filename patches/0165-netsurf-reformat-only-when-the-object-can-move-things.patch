 unsigned int vitasurf_images_converted;
 unsigned int vitasurf_image_kpixels;
 unsigned int vitasurf_ms_image_max;
@@ -699,6 +701,8 @@ void vitasurf_profile_reset(void)
 	vitasurf_ms_layout_max = 0;
 	vitasurf_layout_slow = 0;
 	vitasurf_ms_layout_slow = 0;
+	vitasurf_object_ready = 0;
+	vitasurf_object_reformats = 0;
 	vitasurf_images_converted = 0;
 	vitasurf_image_kpixels = 0;
 	vitasurf_ms_image_max = 0;
