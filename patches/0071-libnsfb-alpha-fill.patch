index 9626acf..7d8e304 100644
--- a/src/plot/32bpp-common.c
+++ b/src/plot/32bpp-common.c
@@ -56,6 +56,47 @@ static bool fill(nsfb_t *nsfb, nsfb_bbox_t *rect, nsfb_colour_t c)
         return true;
 }
 
+/**
+ * Fill a rectangle, blending the colour by its alpha (VitaSurf).
+ *
+ * A box-shadow is a low-alpha colour laid over whatever is there, and so
+ * is an rgba() background; the opaque fill above paints both solid. The
+ * blend is nsfb_plot_ablend, the one the bitmap plotter already uses, so
+ * the arithmetic and the 0xAABBGGRR convention are the same as for an
+ * image with an alpha channel.
+ */
+static bool fill_alpha(nsfb_t *nsfb, nsfb_bbox_t *rect, nsfb_colour_t c)
+{
+        int w;
+        uint32_t *pvid;
+        uint32_t llen;
+        uint32_t width;
+        uint32_t height;
+
+        if (!nsfb_plot_clip_ctx(nsfb, rect))
+                return true; /* fill lies outside current clipping region */
+
+        width = rect->x1 - rect->x0;
+        height = rect->y1 - rect->y0;
+        llen = (nsfb->linelen >> 2) - width;
+
+        pvid = get_xy_loc(nsfb, rect->x0, rect->y0);
+
+        while (height-- > 0) {
+                w = width;
+                while (w > 0) {
+                        *pvid = colour_to_pixel(nsfb,
+                                nsfb_plot_ablend(c,
+                                        pixel_to_colour(nsfb, *pvid)));
+                        pvid++;
+                        w--;
+                }
+                pvid += llen;
+        }
+
+        return true;
+}
