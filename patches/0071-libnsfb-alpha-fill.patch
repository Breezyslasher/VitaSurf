+/* exported interface documented in libnsfb_plot.h */
+bool nsfb_plot_rectangle_fill_alpha(nsfb_t *nsfb, nsfb_bbox_t *rect, nsfb_colour_t c)
+{
+    if ((c >> 24) == 0) {
+        return true; /* nothing to see */
+    }
+    if ((c >> 24) == 0xff || nsfb->plotter_fns->fill_alpha == NULL) {
+        return nsfb->plotter_fns->fill(nsfb, rect, c);
+    }
+    return nsfb->plotter_fns->fill_alpha(nsfb, rect, c);
+}
