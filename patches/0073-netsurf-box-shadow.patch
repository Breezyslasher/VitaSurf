+/**
+ * Paint the shadow a box casts (VitaSurf).
+ *
+ * The plotter has no blur, so the blur is approximated: the band the
+ * blur would fade across, from half the radius inside the shadow's edge
+ * to half outside, is painted as a few concentric rings of falling
+ * alpha, each ring being four strips. That is a handful of small blended
+ * fills per box rather than a pass over every pixel, which is what the
+ * Vita can afford. Without blur the shadow is one rectangle. The box's
+ * own background is painted afterwards and covers whatever fell inside
+ * its border box, which is where the specification says a shadow does
+ * not show; a box with no background shows a little of the inner half
+ * of the blur, which is the approximation's one visible seam.
+ *
+ * Inset shadows are stored and not drawn.
+ *
+ * \param html      The html content
+ * \param box       The box
+ * \param bx0       Left edge of the border box, in painter coordinates
+ * \param by0       Top edge
+ * \param bx1       Right edge
+ * \param by1       Bottom edge
+ * \param scale     Scale
+ * \param ctx       Redraw context
+ * \return true on success, false otherwise
+ */
+static bool html_redraw_box_shadow(const html_content *html,
+		struct box *box, int bx0, int by0, int bx1, int by1,
+		float scale, const struct redraw_context *ctx)
+{
+	css_fixed len[4] = { 0, 0, 0, 0 };
+	css_unit unit[4] = { CSS_UNIT_PX, CSS_UNIT_PX, CSS_UNIT_PX,
+			CSS_UNIT_PX };
+	css_color colour = 0;
+	int px[4], i, ox, oy, blur, spread, alpha, bands;
+	plot_style_t pstyle = { .fill_type = PLOT_OP_TYPE_SOLID,
+			.stroke_type = PLOT_OP_TYPE_NONE };
+
+	if (css_computed_box_shadow(box->style, &len[0], &unit[0],
+			&len[1], &unit[1], &len[2], &unit[2],
+			&len[3], &unit[3], &colour) != CSS_BOX_SHADOW_SET) {
+		return true;
+	}
+
+	if (colour == 0x00000001) {
+		/* no colour written: the element's own */
+		css_computed_color(box->style, &colour);
+	}
+	alpha = colour >> 24;
+	if (alpha == 0) {
+		return true;
+	}
+
+	for (i = 0; i < 4; i++) {
+		px[i] = FIXTOINT(css_unit_len2device_px(box->style,
+				&html->unit_len_ctx, len[i], unit[i]));
+		if (scale != 1.0) {
+			px[i] = px[i] * scale;
+		}
+	}
+	ox = px[0];
+	oy = px[1];
+	blur = px[2] < 0 ? 0 : px[2];
+	spread = px[3];
+
+	bands = blur > 0 ? 4 : 1;
+
+	for (i = 0; i < bands; i++) {
+		/* this ring's inner and outer expansion of the shadow's
+		 * edge, and how much of the colour it carries */
+		int inner, outer, band_alpha;
+		struct rect o, in;
+		css_color c;
+
+		if (blur > 0) {
+			inner = -blur / 2 + (i * blur) / bands;
+			outer = -blur / 2 + ((i + 1) * blur) / bands;
+			band_alpha = alpha * (2 * (bands - i) - 1) /
+					(2 * bands);
+		} else {
+			inner = 0;
+			outer = 0;
+			band_alpha = alpha;
+		}
+		if (band_alpha <= 0) {
+			continue;
+		}
+
+		o.x0 = bx0 + ox - spread - outer;
+		o.y0 = by0 + oy - spread - outer;
+		o.x1 = bx1 + ox + spread + outer;
+		o.y1 = by1 + oy + spread + outer;
+		if (o.x1 <= o.x0 || o.y1 <= o.y0) {
+			continue;
+		}
+
+		c = (colour & 0x00ffffff) | ((css_color) band_alpha << 24);
+		pstyle.fill_colour = nscss_color_to_ns(c);
+
+		if (blur == 0) {
+			if (ctx->plot->rectangle(ctx, &pstyle, &o) != NSERROR_OK)
+				return false;
+			continue;
+		}
+
+		in.x0 = bx0 + ox - spread - inner;
+		in.y0 = by0 + oy - spread - inner;
+		in.x1 = bx1 + ox + spread + inner;
+		in.y1 = by1 + oy + spread + inner;
+
+		/* four strips make the ring between the two rectangles */
+		{
+			struct rect strip[4] = {
+				{ o.x0, o.y0, o.x1, in.y0 },	/* top */
+				{ o.x0, in.y1, o.x1, o.y1 },	/* bottom */
+				{ o.x0, in.y0, in.x0, in.y1 },	/* left */
+				{ in.x1, in.y0, o.x1, in.y1 },	/* right */
+			};
+			int k;
+
+			for (k = 0; k < 4; k++) {
+				if (strip[k].x1 <= strip[k].x0 ||
+						strip[k].y1 <= strip[k].y0)
+					continue;
+				if (ctx->plot->rectangle(ctx, &pstyle,
+						&strip[k]) != NSERROR_OK)
+					return false;
+			}
+		}
+	}
+
+	return true;
+}
