+		is = strcasecmp(t, "hidden") != 0;
+		*text = strcasecmp(t, "checkbox") != 0 &&
+			strcasecmp(t, "radio") != 0 &&
+			strcasecmp(t, "button") != 0 &&
+			strcasecmp(t, "submit") != 0 &&
+			strcasecmp(t, "reset") != 0 &&
+			strcasecmp(t, "image") != 0 &&
+			strcasecmp(t, "file") != 0 &&
+			strcasecmp(t, "range") != 0 &&
+			strcasecmp(t, "color") != 0;
+		if (type != NULL)
+			dom_string_unref(type);
