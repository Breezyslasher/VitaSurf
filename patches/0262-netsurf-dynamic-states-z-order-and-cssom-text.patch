+/* exported interface documented in html/html.h */
+void html_focus_at_point(struct content *c, int x, int y)
+{
+	html_content *html = (html_content *) c;
+	static struct mouse_action_state mas;
+	dom_node *n;
+	bool text = false;
+
+	if (html->layout == NULL ||
+			get_mouse_action_node(html, x, y, &mas) != NSERROR_OK)
+		return;
+	for (n = mas.node != NULL ? dom_node_ref(mas.node) : NULL;
+			n != NULL; ) {
+		dom_node *p = NULL;
+		dom_node_type t;
+
+		if (dom_node_get_node_type(n, &t) != DOM_NO_ERR ||
+				t != DOM_ELEMENT_NODE) {
+			dom_node_unref(n);
+			n = NULL;
+			break;
+		}
+		if (dynamic_focusable(n, &text))
+			break;
+		if (dom_node_get_parent_node(n, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(n);
+		n = p;
+	}
+	/* from the keys, so it is seen */
+	html_set_dynamic(html, NSCSS_FOCUS, n, true);
+	if (n != NULL)
+		dom_node_unref(n);
+}
