+/**
+ * Follow the pointer for :hover, a press for :active and a click for
+ * :focus (VitaSurf). A tap on the Vita is a move, a press and a click,
+ * so what was tapped stays hovered until the next tap, as on a phone.
+ */
+static void html_track_dynamic(html_content *html, browser_mouse_state mouse,
+		dom_node *node)
+{
+	if ((mouse & (BROWSER_MOUSE_DRAG_1 | BROWSER_MOUSE_DRAG_2 |
+			BROWSER_MOUSE_DRAG_ON)) != 0)
+		return;
+
+	html_set_dynamic(html, NSCSS_HOVER, node, false);
+
+	if (mouse & (BROWSER_MOUSE_PRESS_1 | BROWSER_MOUSE_PRESS_2)) {
+		html_set_dynamic(html, NSCSS_ACTIVE, node, false);
+	} else if ((mouse & (BROWSER_MOUSE_HOLDING_1 |
+			BROWSER_MOUSE_HOLDING_2)) == 0) {
+		html_set_dynamic(html, NSCSS_ACTIVE, NULL, false);
+	}
+
+	if (mouse & (BROWSER_MOUSE_CLICK_1 | BROWSER_MOUSE_CLICK_2)) {
+		dom_node *n = node != NULL ? dom_node_ref(node) : NULL;
+		bool text = false;
+
+		while (n != NULL) {
+			dom_node *p = NULL;
+			dom_node_type t;
+
+			if (dom_node_get_node_type(n, &t) != DOM_NO_ERR ||
+					t != DOM_ELEMENT_NODE) {
+				dom_node_unref(n);
+				n = NULL;
+				break;
+			}
+			if (dynamic_focusable(n, &text))
+				break;
+			if (dom_node_get_parent_node(n, &p) != DOM_NO_ERR)
+				p = NULL;
+			dom_node_unref(n);
+			n = p;
+		}
+		html_set_dynamic(html, NSCSS_FOCUS, n, text);
+		if (n != NULL)
+			dom_node_unref(n);
+	}
+}
