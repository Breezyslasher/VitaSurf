+
+
+/*
+ * The attribute names node_is_pseudo reads, made once (VitaSurf).
+ */
+enum pseudo_attr {
+	PA_PLACEHOLDER, PA_REQUIRED, PA_READONLY, PA_CONTENTEDITABLE,
+	PA_DIR, PA_MIN, PA_MAX, PA_OPEN, PA_MUTED, PA_COUNT
+};
+
+static dom_string *pseudo_attr_name(enum pseudo_attr which)
+{
+	static const char *const names[PA_COUNT] = {
+		"placeholder", "required", "readonly", "contenteditable",
+		"dir", "min", "max", "open", "muted"
+	};
+	static dom_string *made[PA_COUNT];
+
+	if (made[which] == NULL &&
+			dom_string_create_interned(
+				(const uint8_t *) names[which],
+				strlen(names[which]),
+				&made[which]) != DOM_NO_ERR) {
+		made[which] = NULL;
+	}
+	return made[which];
+}
+
+static bool pseudo_has(dom_node *n, enum pseudo_attr which)
+{
+	dom_string *name = pseudo_attr_name(which);
+	bool has = false;
+
+	if (name == NULL || dom_element_has_attribute(n, name, &has) !=
+			DOM_NO_ERR)
+		return false;
+	return has;
+}
+
+/** The value of an attribute, or NULL; the caller unrefs it. */
+static dom_string *pseudo_get(dom_node *n, dom_string *name)
+{
+	dom_string *value = NULL;
+
+	if (name == NULL || dom_element_get_attribute(n, name, &value) !=
+			DOM_NO_ERR)
+		return NULL;
+	return value;
+}
+
+static bool pseudo_tag_is(dom_node *n, const char *tag)
+{
+	dom_string *name = NULL;
+	bool is;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR || name == NULL)
+		return false;
+	is = strcasecmp(dom_string_data(name), tag) == 0;
+	dom_string_unref(name);
+	return is;
+}
+
+/** An input's type, lower case, into buf ("text" when it has none). */
+static void pseudo_input_type(dom_node *n, char *buf, size_t len)
+{
+	dom_string *type = pseudo_get(n, corestring_dom_type);
+	size_t i;
+
+	snprintf(buf, len, "%s", type != NULL && dom_string_byte_length(
+			type) > 0 ? dom_string_data(type) : "text");
+	for (i = 0; buf[i] != '\0'; i++)
+		buf[i] = (char) ascii_to_lower(buf[i]);
+	if (type != NULL)
+		dom_string_unref(type);
+}
+
+/** Whether an input of this type takes typed text. */
+static bool pseudo_type_is_text(const char *t)
+{
+	return strcmp(t, "text") == 0 || strcmp(t, "search") == 0 ||
+		strcmp(t, "email") == 0 || strcmp(t, "url") == 0 ||
+		strcmp(t, "tel") == 0 || strcmp(t, "password") == 0 ||
+		strcmp(t, "number") == 0 || strcmp(t, "date") == 0 ||
+		strcmp(t, "time") == 0 || strcmp(t, "datetime-local") == 0 ||
+		strcmp(t, "month") == 0 || strcmp(t, "week") == 0;
+}
+
+/**
+ * A form control's current value, or NULL (VitaSurf): what was typed,
+ * from the gadget when the control has one, else the markup's value.
+ */
+static char *pseudo_value(dom_node *n)
+{
+	dom_string *v = NULL;
+	char *out;
+
+	if (nscss_control_value != NULL) {
+		out = nscss_control_value(n);
+		if (out != NULL)
+			return out;
+	}
+	if (pseudo_tag_is(n, "textarea")) {
+		if (dom_node_get_text_content(n, &v) != DOM_NO_ERR)
+			v = NULL;
+	} else {
+		v = pseudo_get(n, corestring_dom_value);
+	}
+	out = strdup(v != NULL ? dom_string_data(v) : "");
+	if (v != NULL)
+		dom_string_unref(v);
+	return out;
+}
+
+char *(*nscss_control_value)(dom_node *n) = NULL;
+
+/** Whether a node is an element that takes typing. */
+static bool pseudo_read_write(dom_node *n)
+{
+	char type[24];
+	dom_node *a;
+	unsigned depth = 0;
+
+	if (pseudo_tag_is(n, "textarea")) {
+		return !pseudo_has(n, PA_READONLY) &&
+			!node_has_disabled_attribute(n);
+	}
+	if (pseudo_tag_is(n, "input")) {
+		pseudo_input_type(n, type, sizeof(type));
+		return pseudo_type_is_text(type) &&
+			!pseudo_has(n, PA_READONLY) &&
+			!node_has_disabled_attribute(n);
+	}
+	/* contenteditable, on the element or inherited */
+	for (a = dom_node_ref(n); a != NULL && depth++ < 64; ) {
+		dom_string *ce = pseudo_get(a,
+				pseudo_attr_name(PA_CONTENTEDITABLE));
+		dom_node *p = NULL;
+
+		if (ce != NULL) {
+			bool on = strcasecmp(dom_string_data(ce), "false")
+					!= 0;
+
+			dom_string_unref(ce);
+			dom_node_unref(a);
+			return on;
+		}
+		if (dom_node_get_parent_node(a, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(a);
+		a = p;
+		if (a != NULL) {
+			dom_node_type t;
+
+			if (dom_node_get_node_type(a, &t) != DOM_NO_ERR ||
+					t != DOM_ELEMENT_NODE) {
+				dom_node_unref(a);
+				a = NULL;
+			}
+		}
+	}
+	if (a != NULL)
+		dom_node_unref(a);
+	return false;
+}
+
+/** Whether a node is a control that constraint validation looks at. */
+static bool pseudo_validates(dom_node *n)
+{
+	return pseudo_tag_is(n, "input") || pseudo_tag_is(n, "select") ||
+		pseudo_tag_is(n, "textarea");
+}
+
+/** Whether a control fails validation: a required one left empty, an
+ * email address with no @. */
+static bool pseudo_invalid(dom_node *n)
+{
+	char type[24] = "";
+	char *value;
+	bool bad = false;
+
+	if (pseudo_tag_is(n, "input")) {
+		pseudo_input_type(n, type, sizeof(type));
+		if (strcmp(type, "checkbox") == 0 ||
+				strcmp(type, "radio") == 0) {
+			bool checked = false;
+
+			node_is_checked(NULL, n, &checked);
+			return pseudo_has(n, PA_REQUIRED) && !checked &&
+				strcmp(type, "checkbox") == 0;
+		}
+	}
+	value = pseudo_value(n);
+	if (value == NULL)
+		return false;
+	if (value[0] == '\0') {
+		bad = pseudo_has(n, PA_REQUIRED);
+	} else if (strcmp(type, "email") == 0) {
+		bad = strchr(value, '@') == NULL;
+	}
+	free(value);
+	return bad;
+}
+
+/** For :in-range and :out-of-range: 1 in range, 0 out, -1 neither. */
+static int pseudo_range(dom_node *n)
+{
+	char type[24];
+	dom_string *lo, *hi;
+	char *value, *end;
+	double v;
+	int in = -1;
+
+	if (!pseudo_tag_is(n, "input"))
+		return -1;
+	pseudo_input_type(n, type, sizeof(type));
+	if (strcmp(type, "number") != 0 && strcmp(type, "range") != 0)
+		return -1;
+	lo = pseudo_get(n, pseudo_attr_name(PA_MIN));
+	hi = pseudo_get(n, pseudo_attr_name(PA_MAX));
+	if (lo == NULL && hi == NULL)
+		return -1;
+	in = 1;
+	value = pseudo_value(n);
+	if (value != NULL && value[0] != '\0') {
+		v = strtod(value, &end);
+		if (end != value) {
+			if (lo != NULL && v < strtod(dom_string_data(lo),
+					NULL))
+				in = 0;
+			if (hi != NULL && v > strtod(dom_string_data(hi),
+					NULL))
+				in = 0;
+		}
+	}
+	free(value);
+	if (lo != NULL)
+		dom_string_unref(lo);
+	if (hi != NULL)
+		dom_string_unref(hi);
+	return in;
+}
+
+/** The direction in force at a node, from the nearest dir attribute. */
+static bool pseudo_is_rtl(dom_node *n)
+{
+	dom_node *a = dom_node_ref(n);
+	unsigned depth = 0;
+
+	while (a != NULL && depth++ < 256) {
+		dom_string *dir = pseudo_get(a, pseudo_attr_name(PA_DIR));
+		dom_node *p = NULL;
+		dom_node_type t;
+
+		if (dir != NULL) {
+			bool rtl = strcasecmp(dom_string_data(dir), "rtl")
+					== 0;
+			bool set = rtl || strcasecmp(dom_string_data(dir),
+					"ltr") == 0;
+
+			dom_string_unref(dir);
+			if (set) {
+				dom_node_unref(a);
+				return rtl;
+			}
+		}
+		if (dom_node_get_parent_node(a, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(a);
+		a = p;
+		if (a != NULL && (dom_node_get_node_type(a, &t) !=
+				DOM_NO_ERR || t != DOM_ELEMENT_NODE)) {
+			dom_node_unref(a);
+			a = NULL;
+		}
+	}
+	if (a != NULL)
+		dom_node_unref(a);
+	return false;
+}
+
+static bool pseudo_named(lwc_string *name, const char *want)
+{
+	size_t n = strlen(want);
+
+	return lwc_string_length(name) == n &&
+		strncasecmp(lwc_string_data(name), want, n) == 0;
+}
+
+/**
+ * The pseudo-classes libcss knows only by name (VitaSurf). See
+ * parsePseudoKnown in libcss's parse/language.c for the list; what is
+ * not answered here does not match.
+ */
+static css_error node_is_pseudo(void *pw, void *node, lwc_string *name,
+		lwc_string *arg, bool *match)
+{
+	dom_node *n = node;
+
+	(void)pw;
+	*match = false;
+
+	if (pseudo_named(name, "focus-visible")) {
+		*match = focus_visible && dynamic[NSCSS_FOCUS].n > 0 &&
+			dynamic[NSCSS_FOCUS].chain[0] == node;
+	} else if (pseudo_named(name, "focus-within")) {
+		*match = dynamic_chain_has(NSCSS_FOCUS, node);
+	} else if (pseudo_named(name, "target-within")) {
+		*match = dynamic_chain_has(NSCSS_TARGET, node);
+	} else if (pseudo_named(name, "any-link") ||
+			pseudo_named(name, "-webkit-any-link")) {
+		if (pseudo_tag_is(n, "a") || pseudo_tag_is(n, "area")) {
+			dom_element_has_attribute(n, corestring_dom_href,
+					match);
+		}
+	} else if (pseudo_named(name, "placeholder-shown")) {
+		if ((pseudo_tag_is(n, "input") ||
+				pseudo_tag_is(n, "textarea")) &&
+				pseudo_has(n, PA_PLACEHOLDER)) {
+			char *value = pseudo_value(n);
+
+			*match = value != NULL && value[0] == '\0';
+			free(value);
+		}
+	} else if (pseudo_named(name, "required")) {
+		*match = pseudo_validates(n) && pseudo_has(n, PA_REQUIRED);
+	} else if (pseudo_named(name, "optional")) {
+		*match = pseudo_validates(n) && !pseudo_has(n, PA_REQUIRED);
+	} else if (pseudo_named(name, "read-write")) {
+		*match = pseudo_read_write(n);
+	} else if (pseudo_named(name, "read-only")) {
+		*match = !pseudo_read_write(n);
+	} else if (pseudo_named(name, "invalid")) {
+		*match = pseudo_validates(n) && pseudo_invalid(n);
+	} else if (pseudo_named(name, "valid")) {
+		*match = (pseudo_validates(n) && !pseudo_invalid(n)) ||
+			pseudo_tag_is(n, "form") ||
+			pseudo_tag_is(n, "fieldset");
+	} else if (pseudo_named(name, "default")) {
+		if (pseudo_tag_is(n, "option")) {
+			dom_element_has_attribute(n, corestring_dom_selected,
+					match);
+		} else if (pseudo_tag_is(n, "input")) {
+			dom_element_has_attribute(n, corestring_dom_checked,
+					match);
+		}
+	} else if (pseudo_named(name, "indeterminate")) {
+		/* a progress bar with no value; a checkbox made
+		 * indeterminate from script is not seen from here */
+		if (pseudo_tag_is(n, "progress")) {
+			bool has = false;
+
+			dom_element_has_attribute(n, corestring_dom_value,
+					&has);
+			*match = !has;
+		}
+	} else if (pseudo_named(name, "defined")) {
+		/* no way to know from here which custom elements are
+		 * defined; the page's own are, by the time it is drawn */
+		*match = true;
+	} else if (pseudo_named(name, "in-range")) {
+		*match = pseudo_range(n) == 1;
+	} else if (pseudo_named(name, "out-of-range")) {
+		*match = pseudo_range(n) == 0;
+	} else if (pseudo_named(name, "open")) {
+		*match = (pseudo_tag_is(n, "details") ||
+				pseudo_tag_is(n, "dialog")) &&
+			pseudo_has(n, PA_OPEN);
+	} else if (pseudo_named(name, "closed")) {
+		*match = (pseudo_tag_is(n, "details") ||
+				pseudo_tag_is(n, "dialog")) &&
+			!pseudo_has(n, PA_OPEN);
+	} else if (pseudo_named(name, "paused")) {
+		/* media never plays here */
+		*match = pseudo_tag_is(n, "video") ||
+			pseudo_tag_is(n, "audio");
+	} else if (pseudo_named(name, "muted")) {
+		*match = (pseudo_tag_is(n, "video") ||
+				pseudo_tag_is(n, "audio")) &&
+			pseudo_has(n, PA_MUTED);
+	} else if (pseudo_named(name, "scope")) {
+		/* outside @scope, :scope is the root */
+		dom_node *p = NULL;
+		dom_node_type t = DOM_ELEMENT_NODE;
+
+		if (dom_node_get_parent_node(n, &p) == DOM_NO_ERR &&
+				p != NULL) {
+			dom_node_get_node_type(p, &t);
+			dom_node_unref(p);
+			*match = (t == DOM_DOCUMENT_NODE);
+		}
+	} else if (pseudo_named(name, "dir")) {
+		if (arg != NULL) {
+			bool rtl = pseudo_is_rtl(n);
+
+			*match = pseudo_named(arg, rtl ? "rtl" : "ltr");
+		}
+	}
+
+	return CSS_OK;
+}
