+	old = box->styles;
+	if (old == NULL) {
+		css_select_results_destroy(fresh);
+		return BOX_RESTYLE_LAYOUT;
+	}
+	if (restyle_results_equal(old, fresh)) {
+		css_select_results_destroy(fresh);
+		return BOX_RESTYLE_SAME;
+	}
+	*changed = true;
+	/* display: contents puts what it owns in its ancestors' boxes,
+	 * where it cannot be told apart; a form control's own drawing
+	 * keeps the colours it was made with, but its box takes the rest */
+	if ((box->flags & DISPLAY_CONTENTS) != 0 ||
+			!restyle_same_layout(old, fresh)) {
+		css_select_results_destroy(fresh);
+		return BOX_RESTYLE_LAYOUT;
+	}
+
+	/* the element's own box, then what it owns */
+	restyle_remap_one(box, old, fresh);
+	if (box->list_marker != NULL)
+		restyle_remap_one(box->list_marker, old, fresh);
