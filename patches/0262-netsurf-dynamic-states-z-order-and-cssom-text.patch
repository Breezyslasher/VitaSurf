+static enum box_restyle restyle_worse(enum box_restyle a, enum box_restyle b)
+{
+	return a > b ? a : b;
+}
+
+/* exported interface documented in html/box_construct.h */
+enum box_restyle box_restyle(html_content *c, dom_node *n, bool subtree,
+		unsigned *budget)
+{
+	enum box_restyle result;
+	dom_node *child = NULL, *next;
+	bool changed = false;
+
+	if (*budget == 0)
+		return BOX_RESTYLE_LAYOUT;
+	(*budget)--;
+
+	result = restyle_element(c, n, &changed);
+	if (result == BOX_RESTYLE_LAYOUT)
+		return result;
+
+	/* what is inside inherits the change, or is selected by it */
+	if (!(subtree || changed) || box_for_node(n) == NULL)
+		return result;
+
+	if (composed_first_child(c, n, &child) != DOM_NO_ERR)
+		return BOX_RESTYLE_LAYOUT;
+	while (child != NULL) {
+		dom_node_type type;
+
+		if (dom_node_get_node_type(child, &type) == DOM_NO_ERR &&
+				type == DOM_ELEMENT_NODE) {
+			result = restyle_worse(result, box_restyle(c, child,
+					subtree, budget));
+			if (result == BOX_RESTYLE_LAYOUT) {
+				dom_node_unref(child);
+				return result;
+			}
+		}
+		next = NULL;
+		if (composed_next_sibling(c, child, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(child);
+		child = next;
+	}
+	return result;
+}
