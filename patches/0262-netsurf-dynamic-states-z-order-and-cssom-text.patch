+			if (b == box->inline_end) {
+				restyle_remap_one(b, old, fresh);
+				break;
+			}
+			if (b->node != NULL && b->node != n) {
+				if (b->type == BOX_INLINE &&
+						b->inline_end != NULL)
+					b = b->inline_end;
+				continue;
+			}
+			restyle_remap_one(b, old, fresh);
+		}
+	} else {
+		restyle_remap(box, box->children, old, fresh);
+	}
+	for (i = 0; i < CSS_PSEUDO_ELEMENT_COUNT; i++) {
+		if (box->style == old->styles[i])
+			box->style = fresh->styles[i];
+	}
