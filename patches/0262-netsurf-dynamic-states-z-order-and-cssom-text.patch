 void nscss_clear_node_data(dom_node *n);
 
+/**
+ * The states an element can be in that selectors ask about and markup
+ * does not say (VitaSurf).
+ */
+enum nscss_dynamic {
+	NSCSS_HOVER,		/**< :hover, under the pointer */
+	NSCSS_ACTIVE,		/**< :active, being pressed */
+	NSCSS_FOCUS,		/**< :focus, :focus-within, :focus-visible */
+	NSCSS_TARGET,		/**< :target, named by the fragment */
+	NSCSS_DYNAMIC_COUNT
+};
+
+/**
+ * Put an element in a state, taking it from whichever had it.
+ *
+ * \param which    the state
+ * \param node     the element, or NULL for none
+ * \param visible  for NSCSS_FOCUS, whether it matches :focus-visible:
+ *                 focus from the keys, or a field that takes typing
+ * \return true if the element in that state changed
+ */
+bool nscss_set_dynamic(enum nscss_dynamic which, dom_node *node,
+		bool visible);
+
+/** The element in a state, or NULL; not referenced. */
+dom_node *nscss_dynamic_node(enum nscss_dynamic which);
+
+/**
+ * The element in a state and its ancestors, nearest first.
+ *
+ * \return how many; the nodes stay referenced by the state
+ */
+unsigned nscss_dynamic_chain(enum nscss_dynamic which, dom_node ***chain);
+
+/**
+ * What a form control holds now, for :placeholder-shown, :invalid and
+ * :in-range: set by the HTML handler, which has the gadgets. The result
+ * is malloc'd; NULL means the markup's value is to be used.
+ */
+extern char *(*nscss_control_value)(dom_node *n);
+
 #endif
