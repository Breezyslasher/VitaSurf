+/** Whether a node is in a chain. */
+static bool dynamic_in(dom_node *n, dom_node **chain, unsigned count)
+{
+	unsigned i;
+
+	for (i = 0; i < count; i++) {
+		if (chain[i] == n)
+			return true;
+	}
+	return false;
+}
+
+/*
+ * How many elements a change of state may restyle before the layout is
+ * rebuilt instead, and how close to the element an ancestor has to be
+ * for its whole subtree to be restyled when a sheet asks for that
+ * (".menu:hover .submenu" -- the menu is rarely far above what the
+ * pointer is on, and the root always is).
+ */
+#define DYNAMIC_BUDGET 600
+#define DYNAMIC_SUBTREE_DEPTH 6
+
+/* exported interface documented in html/private.h */
+void html_set_dynamic(html_content *c, enum nscss_dynamic which,
+		dom_node *node, bool visible)
+{
+	dom_node *old[64], **chain;
+	unsigned n_old, n_new, i, budget = DYNAMIC_BUDGET;
+	enum box_restyle result = BOX_RESTYLE_SAME, r;
+	bool subtree_wanted;
+	int pass;
+
+	/* the pointer moving within the same element */
+	if (which != NSCSS_FOCUS && node == nscss_dynamic_node(which))
+		return;
+
+	n_old = nscss_dynamic_chain(which, &chain);
+	if (n_old > 64)
+		n_old = 64;
+	for (i = 0; i < n_old; i++)
+		old[i] = dom_node_ref(chain[i]);
+
+	if (!nscss_set_dynamic(which, node, visible)) {
+		/* the same element; for the focus, perhaps now seen */
+		for (i = 0; i < n_old; i++)
+			dom_node_unref(old[i]);
+		if (which != NSCSS_FOCUS || node == NULL)
+			return;
+		n_old = 0;
+	}
+	n_new = nscss_dynamic_chain(which, &chain);
+
+	if (c->layout == NULL || c->bctx == NULL || c->reflowing ||
+			c->box_conversion_context != NULL) {
+		/* no tree to restyle; the next one is built in the new
+		 * state */
+		goto out;
+	}
+
+	subtree_wanted = (dynamic_ancestor_bits(c) & dynamic_bit(which)) != 0;
+
+	/*
+	 * An element whose state changed is in one chain and not the
+	 * other; the ends change too, whichever chain they share, since
+	 * :focus and :target ask about the element itself. Ancestors
+	 * first, so each is selected against its parent's new style.
+	 */
+	for (pass = 0; pass < 2 && result != BOX_RESTYLE_LAYOUT; pass++) {
+		dom_node **list = pass == 0 ? old : chain;
+		dom_node **other = pass == 0 ? chain : old;
+		unsigned count = pass == 0 ? n_old : n_new;
+		unsigned other_n = pass == 0 ? n_new : n_old;
+
+		for (i = count; i-- > 0 && result != BOX_RESTYLE_LAYOUT; ) {
+			bool end = (i == 0);
+
+			if (!end && dynamic_in(list[i], other, other_n))
+				continue;
+			if (pass == 1 && dynamic_in(list[i], old, n_old) &&
+					!end)
+				continue;
+			r = box_restyle(c, list[i], subtree_wanted &&
+					i < DYNAMIC_SUBTREE_DEPTH, &budget);
+			if (r > result)
+				result = r;
+		}
+	}
+
+	if (result == BOX_RESTYLE_LAYOUT) {
+		if (!c->dynamic_relayout_pending) {
+			c->dynamic_relayout_pending = true;
+			guit->misc->schedule(0, html_dynamic_relayout, c);
+		}
+	} else if (result == BOX_RESTYLE_PAINT) {
+		content__request_redraw(&c->base, 0, 0,
+				c->base.width, c->base.height);
+	}
+
+out:
+	for (i = 0; i < n_old; i++)
+		dom_node_unref(old[i]);
+}
+
+/* exported interface documented in html/private.h */
+void html_drop_dynamic(html_content *c)
+{
+	int which;
+
+	if (c->dynamic_relayout_pending) {
+		guit->misc->schedule(-1, html_dynamic_relayout, c);
+		c->dynamic_relayout_pending = false;
+	}
+	for (which = 0; which < NSCSS_DYNAMIC_COUNT; which++) {
+		dom_node *n = nscss_dynamic_node(which);
+		dom_document *doc = NULL;
+
+		if (n == NULL)
+			continue;
+		if (dom_node_get_owner_document(n, &doc) == DOM_NO_ERR &&
+				doc != NULL) {
+			if ((dom_node *) doc == (dom_node *) c->document)
+				nscss_set_dynamic(which, NULL, false);
+			dom_node_unref(doc);
+		}
+	}
+}
