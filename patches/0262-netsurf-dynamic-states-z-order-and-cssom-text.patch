+		return false;
+	tag = dom_string_data(name);
+
+	if (strcasecmp(tag, "input") == 0) {
+		const char *t = "text";
+
+		if (dom_element_get_attribute(n, corestring_dom_type, &type)
+				== DOM_NO_ERR && type != NULL)
