+/*
+ * The element under the pointer, the one being pressed, the one with the
+ * focus and the one the address's fragment names (VitaSurf). NetSurf had
+ * none of them and matched :hover, :active, :focus and :target against
+ * nothing. Each is kept with the chain of its ancestors, referenced,
+ * because :hover, :active and :focus-within match all the way up.
+ */
+#define DYNAMIC_CHAIN_MAX 64
+
+static struct {
+	dom_node *chain[DYNAMIC_CHAIN_MAX];
+	unsigned n;
+} dynamic[NSCSS_DYNAMIC_COUNT];
+
+static bool focus_visible;
+
+static bool dynamic_chain_has(enum nscss_dynamic which, void *node)
+{
+	unsigned i;
+
+	for (i = 0; i < dynamic[which].n; i++) {
+		if (dynamic[which].chain[i] == node)
+			return true;
+	}
+	return false;
+}
+
+/* exported interface documented in css/select.h */
+dom_node *nscss_dynamic_node(enum nscss_dynamic which)
+{
+	return dynamic[which].n > 0 ? dynamic[which].chain[0] : NULL;
+}
+
+/* exported interface documented in css/select.h */
+unsigned nscss_dynamic_chain(enum nscss_dynamic which, dom_node ***chain)
+{
+	*chain = dynamic[which].chain;
+	return dynamic[which].n;
+}
+
+/* exported interface documented in css/select.h */
+bool nscss_set_dynamic(enum nscss_dynamic which, dom_node *node,
+		bool visible)
+{
+	dom_node *n;
+	unsigned i;
+
+	if (which == NSCSS_FOCUS)
+		focus_visible = visible;
+	if (node == nscss_dynamic_node(which))
+		return false;
+
+	for (i = 0; i < dynamic[which].n; i++)
+		dom_node_unref(dynamic[which].chain[i]);
+	dynamic[which].n = 0;
+
+	for (n = node != NULL ? dom_node_ref(node) : NULL; n != NULL; ) {
+		dom_node *parent = NULL;
+		dom_node_type type;
+
+		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR ||
+				type != DOM_ELEMENT_NODE ||
+				dynamic[which].n == DYNAMIC_CHAIN_MAX) {
+			dom_node_unref(n);
+			break;
+		}
+		dynamic[which].chain[dynamic[which].n++] = n;
+		if (dom_node_get_parent_node(n, &parent) != DOM_NO_ERR)
+			parent = NULL;
+		n = parent;
+	}
+	return true;
+}
