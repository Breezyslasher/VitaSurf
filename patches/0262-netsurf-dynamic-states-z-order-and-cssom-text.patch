+/**
+ * Keep a set of selection results alive with the box tree (VitaSurf).
+ * A box missed by the remapping below still points into them, so they
+ * go when the tree does rather than now.
+ */
+static int restyle_old_destructor(css_select_results **held)
+{
+	if (*held != NULL)
+		css_select_results_destroy(*held);
+	return 0;
+}
+
+static void restyle_keep(html_content *c, css_select_results *old)
+{
+	css_select_results **held = talloc(c->bctx, css_select_results *);
+
+	if (held == NULL) {
+		/* leaked rather than freed under a box still using it */
+		return;
+	}
+	*held = old;
+	talloc_set_destructor(held, restyle_old_destructor);
+}
+
+static void restyle_remap_one(struct box *b, const css_select_results *old,
+		const css_select_results *new)
+{
+	int i;
+
+	for (i = 0; i < CSS_PSEUDO_ELEMENT_COUNT; i++) {
+		if (old->styles[i] == NULL)
+			continue;
+		if (b->style == old->styles[i])
+			b->style = new->styles[i];
+		if (b->first_line_style == old->styles[i])
+			b->first_line_style = new->styles[i];
+	}
+}
+
+/**
+ * Point every box an element owns at its new styles: its text, its
+ * anonymous wrappers, its generated content and its marker, but not the
+ * boxes of the elements inside it, which may hold the very same style
+ * pointer, since libcss keeps one copy of identical styles.
+ */
+static void restyle_remap(struct box *owner, struct box *b,
+		const css_select_results *old, const css_select_results *new)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->node != NULL && b->node != owner->node) {
+			/* another element's: an inline one owns the run up
+			 * to its end, the rest own their subtree */
+			if (b->type == BOX_INLINE && b->inline_end != NULL)
+				b = b->inline_end;
+			continue;
+		}
+		restyle_remap_one(b, old, new);
+		if (b->list_marker != NULL)
+			restyle_remap_one(b->list_marker, old, new);
+		restyle_remap(owner, b->children, old, new);
+	}
