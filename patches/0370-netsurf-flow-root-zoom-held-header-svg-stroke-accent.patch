+/** Whether a box has rounded corners (VitaSurf). */
+static bool html_held_rounded(const css_computed_style *style)
+{
+	uint8_t (*get[4])(const css_computed_style *, css_fixed *,
+			css_unit *, css_fixed *, css_unit *) = {
+		css_computed_border_top_left_radius,
+		css_computed_border_top_right_radius,
+		css_computed_border_bottom_right_radius,
+		css_computed_border_bottom_left_radius
+	};
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		css_fixed h = 0, v = 0;
+		css_unit hu = CSS_UNIT_PX, vu = CSS_UNIT_PX;
+
+		get[i](style, &h, &hu, &v, &vu);
+		if (h != 0 || v != 0)
+			return true;
+	}
+	return false;
+}
+
+/**
+ * Whether a box is painted as it is laid out, with nothing between it
+ * and the screen (VitaSurf): no opacity, filter, transform, blend, clip
+ * or mask, and no stacking context of its own other than a z-index.
+ */
+static bool html_held_plain(html_content *c, const struct box *b)
+{
+	const css_computed_style *style = b->style;
+	css_fixed op = INTTOFIX(1);
+	lwc_string *str = NULL;
+	css_fixed f[4];
+	css_unit u[4];
+	float m[4];
+	int ox, oy;
+
+	if (css_computed_opacity(style, &op) == CSS_OPACITY_SET &&
+			op < INTTOFIX(1))
+		return false;
+	if (b->filter != NULL)
+		return false;
+	if (box_transform(&c->unit_len_ctx, b, m, &ox, &oy))
+		return false;
+	if (css_computed_mix_blend_mode(style) != CSS_MIX_BLEND_MODE_NORMAL &&
+			css_computed_mix_blend_mode(style) !=
+					CSS_MIX_BLEND_MODE_INHERIT)
+		return false;
+	if (css_computed_backdrop_filter(style, &str) ==
+			CSS_BACKDROP_FILTER_SET)
+		return false;
+	str = NULL;
+	if (css_computed_mask_image(style, &str) != CSS_MASK_IMAGE_NONE &&
+			str != NULL)
+		return false;
+	if (css_computed_clip_path(style, &f[0], &u[0], &f[1], &u[1],
+			&f[2], &u[2], &f[3], &u[3]) != CSS_CLIP_PATH_NONE)
+		return false;
+	return true;
+}
+
+/**
+ * Whether anything outside box b could be painted over it (VitaSurf): a
+ * positioned box with a z-index as high as its own among the root's
+ * layers. Asked of the whole tree, since a positioned box takes its
+ * place there wherever it is in it, unless a stacking context round it
+ * keeps it in its own: Yamtrack's cards hold z-10 buttons inside an
+ * overlay at opacity 0, which stay under its z-10 header.
+ */
+static bool html_held_covered(html_content *c, const struct box *b,
+		int32_t z)
+{
+	struct box *x = c->layout;
+
+	while (x != NULL) {
+		bool skip = (x == b);
+
+		if (!skip && x->style != NULL) {
+			uint8_t pos = css_computed_position(x->style);
+			int32_t xz = 0;
+
+			if (pos != CSS_POSITION_STATIC &&
+					css_computed_z_index(x->style, &xz) ==
+						CSS_Z_INDEX_SET) {
+				/* a pinned one is drawn again where it is */
+				if (xz >= z && pos != CSS_POSITION_STICKY &&
+						pos != CSS_POSITION_FIXED)
+					return true;
+				skip = true;
+			} else if (x != c->layout && !html_held_plain(c, x)) {
+				/* a context of its own, among the root's
+				 * layers at zero */
+				skip = true;
+			}
+		}
+		if (!skip && x->children != NULL) {
+			x = x->children;
+		} else {
+			while (x != NULL && x->next == NULL)
+				x = x->parent;
+			if (x != NULL)
+				x = x->next;
+		}
+	}
+	return false;
+}
