+/* the stroke geometry a style can write over the markup's (VitaSurf) */
+static const char *const svg_geometry_names[] = {
+	"stroke-dasharray", "stroke-dashoffset", "stroke-linecap",
+	"stroke-linejoin", "stroke-miterlimit"
+};
+#define SVG_GEOMETRY_N 5
+
+/**
+ * Write the stroke geometry the stylesheet gives, each bit of *wrote
+ * saying which (VitaSurf). Initial values are left out, as stroke-width's
+ * is: a style that never mentioned them reads the same, and the
+ * markup's own attribute then stands.
+ */
+static void svg_geometry_attributes(struct svg_buf *b,
+				    const css_computed_style *style,
+				    unsigned int *wrote)
+{
+	static const char *const caps[] = { NULL, "butt", "round", "square" };
+	static const char *const joins[] = { NULL, "miter", "round", "bevel",
+		"miter-clip", "arcs" };
+	lwc_string *dashes = NULL;
+	css_fixed v = 0;
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t t;
+	char w[64];
+
+	if (css_computed_stroke_dasharray(style, &dashes) ==
+			CSS_STROKE_DASHARRAY_SET && dashes != NULL) {
+		svg_buf_lit(b, " stroke-dasharray=\"");
+		svg_buf_escaped(b, lwc_string_data(dashes),
+				lwc_string_length(dashes));
+		svg_buf_lit(b, "\"");
+		*wrote |= 1u << 0;
+	}
+	if (css_computed_stroke_dashoffset(style, &v, &unit) ==
+			CSS_STROKE_DASHOFFSET_SET && v != 0 &&
+			unit == CSS_UNIT_PX) {
+		snprintf(w, sizeof(w), " stroke-dashoffset=\"%s%d.%03d\"",
+				v < 0 ? "-" : "", abs(FIXTOINT(v)),
+				(int) ((abs(v) & 0x3ff) * 1000 / 1024));
+		svg_buf_lit(b, w);
+		*wrote |= 1u << 1;
+	}
+	t = css_computed_stroke_linecap(style);
+	if (t > CSS_STROKE_LINECAP_BUTT && t <= CSS_STROKE_LINECAP_SQUARE) {
+		snprintf(w, sizeof(w), " stroke-linecap=\"%s\"", caps[t]);
+		svg_buf_lit(b, w);
+		*wrote |= 1u << 2;
+	}
+	t = css_computed_stroke_linejoin(style);
+	if (t > CSS_STROKE_LINEJOIN_MITER && t <= CSS_STROKE_LINEJOIN_ARCS) {
+		snprintf(w, sizeof(w), " stroke-linejoin=\"%s\"", joins[t]);
+		svg_buf_lit(b, w);
+		*wrote |= 1u << 3;
+	}
+	if (css_computed_stroke_miterlimit(style, &v) ==
+			CSS_STROKE_MITERLIMIT_SET && v != INTTOFIX(4)) {
+		snprintf(w, sizeof(w), " stroke-miterlimit=\"%d.%03d\"",
+				FIXTOINT(v), (int) ((v & 0x3ff) * 1000 / 1024));
+		svg_buf_lit(b, w);
+		*wrote |= 1u << 4;
+	}
+}
