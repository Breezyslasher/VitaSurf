+/**
+ * The display a box is laid out with, for the values libcss keeps apart
+ * but layout treats as others (VitaSurf): flow-root is a block, which
+ * box_construct makes a formatting context of its own, and the old
+ * WebKit box is a flex container, or with -webkit-line-clamp the
+ * clamped block that pattern means in every browser.
+ */
+static inline uint8_t ns_display_for_layout(
+		const css_computed_style *style, uint8_t value)
+{
+	css_fixed clamp;
+
+	switch (value) {
+	case CSS_DISPLAY_FLOW_ROOT:
+		return CSS_DISPLAY_BLOCK;
+	case CSS_DISPLAY_WEBKIT_BOX:
+		return css_computed_line_clamp(style, &clamp) ==
+				CSS_LINE_CLAMP_SET ? CSS_DISPLAY_BLOCK :
+				CSS_DISPLAY_FLEX;
+	case CSS_DISPLAY_WEBKIT_INLINE_BOX:
+		return css_computed_line_clamp(style, &clamp) ==
+				CSS_LINE_CLAMP_SET ? CSS_DISPLAY_INLINE_BLOCK :
+				CSS_DISPLAY_INLINE_FLEX;
+	default:
+		return value;
+	}
+}
