+/* exported interface documented in html/html.h */
+bool html_pinned_held(struct hlcache_handle *h, const struct rect *view,
+		int scroll_y, int dy, struct rect *held, struct rect *pin)
+{
+	html_content *c;
+	int i;
+
+	if (h == NULL || content_get_type(h) != CONTENT_HTML || dy == 0)
+		return false;
+	c = (html_content *) hlcache_handle_get_content(h);
+	if (c == NULL || c->layout == NULL || c->reflowing ||
+			c->visible_select_menu != NULL ||
+			c->pinned_boxes > c->pinned_alloc)
+		return false;
+
+	for (i = 0; i < c->pinned_boxes; i++) {
+		struct box *b = c->pinned[i];
+		const struct box *a;
+		css_color bg = 0;
+		lwc_string *img = NULL;
+		uint8_t pos;
+		int32_t z = 0;
+		int px, py, top;
+
+		if (b == NULL || !b->pin_drawn || b->style == NULL ||
+				(b->flags & ANCHORED) || b->parent == NULL)
+			continue;
+		/* drawn across the top edge of the view, and all of it */
+		if (b->pin_x0 > view->x0 || b->pin_x1 < view->x1 ||
+				b->pin_y0 > view->y0 || b->pin_y1 <= view->y0)
+			continue;
+		if (b->type != BOX_BLOCK && b->type != BOX_FLEX)
+			continue;
+
+		/* above the page's own layers */
+		pos = css_computed_position(b->style);
+		if (css_computed_z_index(b->style, &z) != CSS_Z_INDEX_SET ||
+				z <= 0)
+			continue;
+
+		/* an opaque background over the whole border box, and no
+		 * top border to fall between */
+		css_computed_background_color(b->style, &bg);
+		if ((bg >> 24) != 0xff || b->background != NULL ||
+				(css_computed_background_image(b->style, &img) !=
+					CSS_BACKGROUND_IMAGE_NONE &&
+				 img != NULL) ||
+				b->border[TOP].width != 0 ||
+				html_held_rounded(b->style) ||
+				!html_held_plain(c, b))
+			continue;
+
+		/* nothing round it that turns, fades or scrolls */
+		for (a = b->parent; a != NULL; a = a->parent) {
+			uint8_t apos;
+			int32_t az = 0;
+
+			if (a->style == NULL)
+				continue;
+			apos = css_computed_position(a->style);
+			if (apos == CSS_POSITION_STICKY ||
+					apos == CSS_POSITION_FIXED ||
+					(apos != CSS_POSITION_STATIC &&
+					 css_computed_z_index(a->style, &az) ==
+						CSS_Z_INDEX_SET) ||
+					scrollbar_get_offset(a->scroll_y) != 0 ||
+					scrollbar_get_offset(a->scroll_x) != 0 ||
+					!html_held_plain(c, a))
+				break;
+		}
+		if (a != NULL)
+			continue;
+
+		/* where the scroll leaves it: a fixed box stays; a sticky
+		 * one stays while it is held at its offset either side of
+		 * the move */
+		if (pos == CSS_POSITION_STICKY) {
+			int now, then;
+
+			box_coords(b->parent, &px, &py);
+			now = html_sticky_shift_at(c, b, py, scroll_y,
+					view->y1 - view->y0);
+			then = html_sticky_shift_at(c, b, py, scroll_y + dy,
+					view->y1 - view->y0);
+			if (now == 0 || then - now != dy)
+				continue;
+		} else if (pos != CSS_POSITION_FIXED) {
+			continue;
+		}
+
+		if (html_held_covered(c, b, z))
+			continue;
+
+		/* the rows its background fills: the pin rectangle is
+		 * where its descendants reach, so its padding box is
+		 * worked out from where it was drawn */
+		top = b->pin_y0 + (box_overflow_y(b) != CSS_OVERFLOW_VISIBLE ?
+				0 : -b->descendant_y0);
+		if (box_overflow_y(b) != CSS_OVERFLOW_VISIBLE)
+			top += b->border[TOP].width;
+		if (top > view->y0)
+			continue;
+		held->x0 = view->x0;
+		held->x1 = view->x1;
+		held->y0 = view->y0;
+		held->y1 = top + b->padding[TOP] + b->height +
+				b->padding[BOTTOM];
+		if (held->y1 > view->y1)
+			held->y1 = view->y1;
+		if (held->y1 <= held->y0)
+			continue;
+		pin->x0 = b->pin_x0;
+		pin->y0 = b->pin_y0;
+		pin->x1 = b->pin_x1;
+		pin->y1 = b->pin_y1;
+		return true;
+	}
+	return false;
+}
