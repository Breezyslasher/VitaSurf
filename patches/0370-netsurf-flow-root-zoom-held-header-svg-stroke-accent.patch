+/** Whether an attribute is one of the stroke geometry written (VitaSurf). */
+static bool svg_geometry_written(const char *name, size_t len,
+				 unsigned int wrote)
+{
+	int i;
+
+	for (i = 0; i < SVG_GEOMETRY_N; i++) {
+		if ((wrote & (1u << i)) &&
+		    strlen(svg_geometry_names[i]) == len &&
+		    strncmp(svg_geometry_names[i], name, len) == 0)
+			return true;
+	}
+	return false;
+}
