+/*
+ * Select an element's style (VitaSurf).
+ *
+ * 'revert' goes back to what the UA and user styles gave, so those are
+ * kept while the author's are matched: a copy of the property table and
+ * of the styles at each change of origin, 40 KB written for every
+ * element. A sheet that says 'revert' anywhere had every element pay
+ * for it, and Stack Overflow's three focus outlines were a third of the
+ * time each of its elements took. They are kept now only for an
+ * element where a user or author 'revert' wins, which is selected a
+ * second time with them; a 'revert' that loses to a later declaration
+ * costs nothing.
+ */
+css_error css_select_style(css_select_ctx *ctx, void *node,
+		const css_unit_ctx *unit_ctx,
+		const css_media *media, const css_stylesheet *inline_style,
+		css_select_handler *handler, void *pw,
+		css_select_results **result)
+{
+	bool again = false;
+	css_error error = select_style(ctx, node, unit_ctx, media,
+			inline_style, handler, pw, result, false, &again);
+
+	if (error == CSS_OK && again) {
+		again = false;
+		error = select_style(ctx, node, unit_ctx, media,
+				inline_style, handler, pw, result, true,
+				&again);
+	}
+	return error;
+}
