 	}
 	return true;
 }
+
+/** Double the table, refiling every entry. */
+static css_error _grow(css_custom_map *map)
+{
+	return _grow_to(map, (map->n_slots == 0) ? CUSTOM_MAP_FIRST_SLOTS :
+			map->n_slots * 2);
+}
+
+css_error css__custom_map_reserve(css_custom_map **map, uint32_t n)
+{
+	css_error error = css__custom_map_own(map);
+	uint32_t want, need;
+
+	if (error != CSS_OK)
+		return error;
+	if (n > CUSTOM_MAP_MAX)
+		n = CUSTOM_MAP_MAX;
+	/* as _grow keeps it: at most half the slots full */
+	need = ((*map)->count + n) * 2;
+	if (need <= (*map)->n_slots)
+		return CSS_OK;
+	want = ((*map)->n_slots == 0) ? CUSTOM_MAP_FIRST_SLOTS :
+			(*map)->n_slots;
+	while (want < need)
+		want *= 2;
+	return _grow_to(*map, want);
+}
