+/**
+ * Whether the node being selected for has no sibling of a kind, or for
+ * CSS_SIDE_EMPTY no content (VitaSurf).
+ *
+ * Answered once per selection. Counting the siblings walked all of
+ * them; this stops at the first, which for :first-child is the one
+ * before the node.
+ */
+static css_error side_none(css_select_state *state, enum css_side side,
+		bool *none)
+{
+	const uint8_t bit = 1u << side;
+	css_select_handler *h = state->handler;
+	void *node = state->node;
+
+	if ((state->side_known & bit) == 0) {
+		css_error error = CSS_OK;
+		bool is_none;
+		void *n = NULL;
+
+		if (side < CSS_SIDE_EMPTY &&
+				(state->count_known & bit) != 0) {
+			is_none = (state->count[side] == 0);
+		} else if (side == CSS_SIDE_EMPTY) {
+			error = h->node_is_empty(state->pw, node, &is_none);
+		} else if (side == CSS_SIDE_BEFORE) {
+			error = h->sibling_node(state->pw, node, &n);
+			is_none = (n == NULL);
+		} else if (side == CSS_SIDE_BEFORE_TYPE) {
+			error = h->named_generic_sibling_node(state->pw, node,
+					&state->element, &n);
+			is_none = (n == NULL);
+		} else if (h->next_sibling_node != NULL) {
+			error = h->next_sibling_node(state->pw, node, &n);
+			while (error == CSS_OK && n != NULL &&
+					side == CSS_SIDE_AFTER_TYPE) {
+				bool same = false;
+
+				error = h->node_has_name(state->pw, n,
+						&state->element, &same);
+				if (error != CSS_OK || same)
+					break;
+				error = h->next_sibling_node(state->pw, n, &n);
+			}
+			is_none = (n == NULL);
+		} else {
+			int32_t count = 0;
+
+			error = h->node_count_siblings(state->pw, node,
+					side == CSS_SIDE_AFTER_TYPE, true,
+					&count);
+			is_none = (count == 0);
+		}
+		if (error != CSS_OK)
+			return error;
+
+		state->side_known |= bit;
+		if (is_none)
+			state->side_none |= bit;
+	}
+
+	*none = (state->side_none & bit) != 0;
+
+	return CSS_OK;
+}
+
+/**
+ * How many siblings of a kind the node being selected for has
+ * (VitaSurf), counted once per selection.
+ */
+static css_error side_count(css_select_state *state, enum css_side side,
+		int32_t *count)
+{
+	const uint8_t bit = 1u << side;
+
+	if ((state->count_known & bit) == 0) {
+		css_error error;
+
+		error = state->handler->node_count_siblings(state->pw,
+				state->node,
+				side == CSS_SIDE_BEFORE_TYPE ||
+				side == CSS_SIDE_AFTER_TYPE,
+				side == CSS_SIDE_AFTER ||
+				side == CSS_SIDE_AFTER_TYPE,
+				&state->count[side]);
+		if (error != CSS_OK)
+			return error;
+		state->count_known |= bit;
+	}
+
+	*count = state->count[side];
+
+	return CSS_OK;
+}
+
+/**
+ * Answer a test of the node being selected for (VitaSurf).
+ *
+ * The same answers match_detail gave, but a position is found at most
+ * once per selection rather than counted for each rule. The root has
+ * no siblings, and no position pseudo-class matches it.
+ */
+static css_error self_test(css_select_state *state, enum css_self_test kind,
+		int32_t a, int32_t b, bool *match)
+{
+	css_select_handler *h = state->handler;
+	css_error error = CSS_OK;
+	bool before = false, after = false;
+	int32_t count = 0;
+
+	*match = false;
+
+	switch (kind) {
+	case CSS_SELF_ROOT:
+		*match = (state->node_state & CSS_NODE_STATE_ROOT) != 0;
+		return CSS_OK;
+	case CSS_SELF_EMPTY:
+		return side_none(state, CSS_SIDE_EMPTY, match);
+	case CSS_SELF_TARGET:
+		return h->node_is_target(state->pw, state->node, match);
+	case CSS_SELF_ENABLED:
+		return h->node_is_enabled(state->pw, state->node, match);
+	case CSS_SELF_DISABLED:
+		return h->node_is_disabled(state->pw, state->node, match);
+	case CSS_SELF_CHECKED:
+		return h->node_is_checked(state->pw, state->node, match);
+	default:
+		break;
+	}
+
+	if ((state->node_state & CSS_NODE_STATE_ROOT) != 0)
+		return CSS_OK;
+
+	switch (kind) {
+	case CSS_SELF_FIRST_CHILD:
+		error = side_none(state, CSS_SIDE_BEFORE, match);
+		break;
+	case CSS_SELF_LAST_CHILD:
+		error = side_none(state, CSS_SIDE_AFTER, match);
+		break;
+	case CSS_SELF_ONLY_CHILD:
+		error = side_none(state, CSS_SIDE_BEFORE, &before);
+		if (error == CSS_OK && before)
+			error = side_none(state, CSS_SIDE_AFTER, &after);
+		*match = before && after;
+		break;
+	case CSS_SELF_FIRST_OF_TYPE:
+		error = side_none(state, CSS_SIDE_BEFORE_TYPE, match);
+		break;
+	case CSS_SELF_LAST_OF_TYPE:
+		error = side_none(state, CSS_SIDE_AFTER_TYPE, match);
+		break;
+	case CSS_SELF_ONLY_OF_TYPE:
+		error = side_none(state, CSS_SIDE_BEFORE_TYPE, &before);
+		if (error == CSS_OK && before)
+			error = side_none(state, CSS_SIDE_AFTER_TYPE, &after);
+		*match = before && after;
+		break;
+	case CSS_SELF_NTH_CHILD:
+		error = side_count(state, CSS_SIDE_BEFORE, &count);
+		*match = match_nth(a, b, count + 1);
+		break;
+	case CSS_SELF_NTH_LAST_CHILD:
+		error = side_count(state, CSS_SIDE_AFTER, &count);
+		*match = match_nth(a, b, count + 1);
+		break;
+	case CSS_SELF_NTH_OF_TYPE:
+		error = side_count(state, CSS_SIDE_BEFORE_TYPE, &count);
+		*match = match_nth(a, b, count + 1);
+		break;
+	case CSS_SELF_NTH_LAST_OF_TYPE:
+		error = side_count(state, CSS_SIDE_AFTER_TYPE, &count);
+		*match = match_nth(a, b, count + 1);
+		break;
+	default:
+		break;
+	}
+
+	if (error != CSS_OK)
+		*match = false;
+
+	return error;
+}
+
+/**
+ * Keep a test's answer with the node (VitaSurf), so a sibling can
+ * repeat it; see struct css_node_data. False when there is
+ * no room, and the node must be tainted instead.
+ */
+static bool self_note(css_select_state *state, enum css_self_test kind,
+		int32_t a, int32_t b, bool match)
+{
+	struct css_node_data *nd = state->node_data;
+	uint32_t i;
+
+	if (kind < CSS_SELF_NTH_CHILD) {
+		nd->self_tested |= 1u << kind;
+		if (match)
+			nd->self_result |= 1u << kind;
+		return true;
+	}
+
+	if (a < INT8_MIN || a > INT8_MAX || b < INT8_MIN || b > INT8_MAX)
+		return false;
+
+	for (i = 0; i < CSS_NTH_OUTCOMES; i++) {
+		css_nth_outcome *o = &nd->nth[i];
+
+		if (o->kind == 0) {
+			o->kind = (uint8_t) (kind - CSS_SELF_NTH_CHILD + 1);
+			o->a = (int8_t) a;
+			o->b = (int8_t) b;
+			o->result = match ? 1 : 0;
+			return true;
+		}
+		if (o->kind == kind - CSS_SELF_NTH_CHILD + 1 &&
+				o->a == a && o->b == b)
+			return true;
+	}
+
+	return false;
+}
+
+/**
+ * Whether every test of itself a sibling's rules asked gives the node
+ * being selected for the same answer (VitaSurf).
+ */
+static css_error self_same(css_select_state *state,
+		const struct css_node_data *nd, bool *same)
+{
+	css_error error;
+	uint32_t i;
+	bool match;
+
+	*same = false;
+
+	for (i = 0; i < CSS_SELF_NTH_CHILD; i++) {
+		if ((nd->self_tested & (1u << i)) == 0)
+			continue;
+		error = self_test(state, (enum css_self_test) i, 0, 0, &match);
+		if (error != CSS_OK)
+			return error;
+		if (match != ((nd->self_result & (1u << i)) != 0))
+			return CSS_OK;
+	}
+
+	for (i = 0; i < CSS_NTH_OUTCOMES && nd->nth[i].kind != 0; i++) {
+		const css_nth_outcome *o = &nd->nth[i];
+
+		error = self_test(state, (enum css_self_test)
+				(CSS_SELF_NTH_CHILD + o->kind - 1),
+				o->a, o->b, &match);
+		if (error != CSS_OK)
+			return error;
+		if (match != (o->result != 0))
+			return CSS_OK;
+	}
+
+	*same = true;
+
+	return CSS_OK;
+}
+
+/**
+ * The test of the node itself a pseudo-class name asks for, or
+ * CSS_SELF_NONE (VitaSurf).
+ */
+static enum css_self_test self_kind(const css_select_ctx *ctx,
+		const lwc_string *name)
+{
+	if (name == ctx->str.first_child)
+		return CSS_SELF_FIRST_CHILD;
+	if (name == ctx->str.last_child)
+		return CSS_SELF_LAST_CHILD;
+	if (name == ctx->str.nth_child)
+		return CSS_SELF_NTH_CHILD;
+	if (name == ctx->str.nth_last_child)
+		return CSS_SELF_NTH_LAST_CHILD;
+	if (name == ctx->str.nth_of_type)
+		return CSS_SELF_NTH_OF_TYPE;
+	if (name == ctx->str.nth_last_of_type)
+		return CSS_SELF_NTH_LAST_OF_TYPE;
+	if (name == ctx->str.first_of_type)
+		return CSS_SELF_FIRST_OF_TYPE;
+	if (name == ctx->str.last_of_type)
+		return CSS_SELF_LAST_OF_TYPE;
+	if (name == ctx->str.only_child)
+		return CSS_SELF_ONLY_CHILD;
+	if (name == ctx->str.only_of_type)
+		return CSS_SELF_ONLY_OF_TYPE;
+	if (name == ctx->str.empty)
+		return CSS_SELF_EMPTY;
+	if (name == ctx->str.target)
+		return CSS_SELF_TARGET;
+	if (name == ctx->str.root)
+		return CSS_SELF_ROOT;
+	if (name == ctx->str.disabled)
+		return CSS_SELF_DISABLED;
+	if (name == ctx->str.enabled)
+		return CSS_SELF_ENABLED;
+	if (name == ctx->str.checked)
+		return CSS_SELF_CHECKED;
+	return CSS_SELF_NONE;
+}
