+/**
+ * Whether a sibling's class attribute is the same string as this
+ * node's (VitaSurf).
+ *
+ * A rule such as [class*="col-"] reads the attribute rather than the
+ * list, and a GitHub element meets a dozen of them, which tainted it
+ * as any attribute test did. Its classes already match this node's,
+ * one by one; if both attributes also equal those classes joined by
+ * single spaces, by the handler's own test of equality, then every
+ * such rule reads the same string and gives the same answer. Anything
+ * else, a double space or a list too long for the buffer, is refused.
+ */
+static css_error class_attr_same(css_select_ctx *ctx,
+		css_select_state *state, void *candidate, bool *same)
+{
+	css_qname qname = { NULL, ctx->str.class_attr };
+	char buf[256];
+	size_t len = 0;
+	lwc_string *joined;
+	css_error error;
+	bool match = false;
+	uint32_t i;
+
+	*same = false;
+
+	if (state->n_classes == 0)
+		return CSS_OK;
+
+	for (i = 0; i < state->n_classes; i++) {
+		size_t n = lwc_string_length(state->classes[i]);
+
+		if (len + n + 1 > sizeof(buf))
+			return CSS_OK;
+		if (i > 0)
+			buf[len++] = ' ';
+		memcpy(buf + len, lwc_string_data(state->classes[i]), n);
+		len += n;
+	}
+
+	if (lwc_intern_string(buf, len, &joined) != lwc_error_ok)
+		return CSS_NOMEM;
+
+	error = state->handler->node_has_attribute_equal(state->pw,
+			state->node, &qname, joined, &match);
+	if (error == CSS_OK && match) {
+		error = state->handler->node_has_attribute_equal(state->pw,
+				candidate, &qname, joined, &match);
+		if (error == CSS_OK && match)
+			*same = true;
+	}
+
+	lwc_string_unref(joined);
+
+	return error;
+}
