+/*
+ * The maps elements were given (VitaSurf), one of each, by signature.
+ * Elements that set the same variables each built a map of their own,
+ * and interning their styles compared those maps a variable at a time,
+ * and then their parents' maps the same way: half of Stack Overflow's
+ * style interning. The table holds no references; a map leaves it as
+ * it is freed.
+ */
+#define CUSTOM_CANON_BUCKETS 1024
+
+static css_custom_map *_canon[CUSTOM_CANON_BUCKETS];
+
+unsigned int css_custom_interned;
+unsigned int css_custom_intern_hits;
+
+static void _canon_remove(css_custom_map *map)
+{
+	css_custom_map **pp;
+
+	for (pp = &_canon[map->sig & (CUSTOM_CANON_BUCKETS - 1)];
+			*pp != NULL; pp = &(*pp)->canon_next) {
+		if (*pp == map) {
+			*pp = map->canon_next;
+			break;
+		}
+	}
+	map->interned = false;
+}
