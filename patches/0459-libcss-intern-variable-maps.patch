 }
+
+css_custom_map *css__custom_map_intern(css_custom_map *map)
+{
+	css_custom_map *m;
+	uint32_t sig;
+
+	if (map == NULL || map->interned)
+		return map;
+
+	sig = css__custom_map_sig(map);
+	for (m = _canon[sig & (CUSTOM_CANON_BUCKETS - 1)]; m != NULL;
+			m = m->canon_next) {
+		if (m->sig == sig && css__custom_map_equal(m, map)) {
+			css__custom_map_ref(m);
+			css__custom_map_unref(map);
+			css_custom_intern_hits++;
+			return m;
+		}
+	}
+	map->interned = true;
+	map->canon_next = _canon[sig & (CUSTOM_CANON_BUCKETS - 1)];
+	_canon[sig & (CUSTOM_CANON_BUCKETS - 1)] = map;
+	css_custom_interned++;
+	return map;
+}
