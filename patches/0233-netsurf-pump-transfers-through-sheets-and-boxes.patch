diff --git a/content/fetchers/curl.c b/content/fetchers/curl.c
index a61e44558..32c429c4b 100644
--- a/content/fetchers/curl.c
+++ b/content/fetchers/curl.c
@@ -2162,6 +2162,34 @@ static void fetch_curl_flush_held(void)
 	}
 }
 
+/* how often a long stretch of work lets transfers read their sockets */
+#define PUMP_INTERVAL_MS 30
+
+/* exported interface documented in content/fetchers/curl.h */
+void fetch_curl_pump_tick(void)
+{
+	static uint64_t last_ms;
+	static int wanted = -1;
+	uint64_t now;
+
+	if (wanted < 0) {
+#ifdef __vita__
+		wanted = vita_curl_pump_wanted() ? 1 : 0;
+#else
+		wanted = getenv("VITASURF_NOPUMP") == NULL ? 1 : 0;
+#endif
+	}
+	if (wanted == 0 || inside_curl) {
+		return;
+	}
+	nsu_getmonotonic_ms(&now);
+	if (now - last_ms < PUMP_INTERVAL_MS) {
+		return;
+	}
+	last_ms = now;
+	fetch_curl_pump();
+}
+
 /* exported interface documented in content/fetchers/curl.h */
 void fetch_curl_pump(void)
 {
diff --git a/content/fetchers/curl.h b/content/fetchers/curl.h
index 7d1473138..4f474f51d 100644
--- a/content/fetchers/curl.h
+++ b/content/fetchers/curl.h
@@ -45,4 +45,11 @@ extern CURLM *fetch_curl_multi;
  */
 void fetch_curl_pump(void);
 
+/**
+ * fetch_curl_pump at most every 30 ms, and not at all when the nopump
+ * flag file (VITASURF_NOPUMP natively) says so (VitaSurf). Cheap enough
+ * to call from any long loop.
+ */
+void fetch_curl_pump_tick(void);
+
 #endif
