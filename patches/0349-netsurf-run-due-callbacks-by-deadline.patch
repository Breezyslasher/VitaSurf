+ * callbacks in the order the Vita does. This list is newest first, so
+ * of two due at the same time the later in it was asked for first.
+ */
+static struct nscallback *
+earliest_due(const struct timeval *now, struct nscallback **prev_out)
+{
+	struct nscallback *cb, *prev = NULL, *best = NULL, *best_prev = NULL;
