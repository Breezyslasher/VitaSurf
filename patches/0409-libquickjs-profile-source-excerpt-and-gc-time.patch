+/* VitaSurf: the source around where the innermost script frame is, for
+   the profiler to show what a hot position is; see quickjs.h */
+int JS_GetSourceExcerpt(JSContext *ctx, char *buf, int buf_len, int before)
+{
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    JSFunctionBytecode *b;
+    JSObject *p;
+    int line, col, l, c, i, pos, start, n;
+
+    if (!sf || !buf || buf_len < 2)
+        return 0;
+    buf[0] = '\0';
+    if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!js_class_has_bytecode(p->class_id))
+        return 0;
+    b = p->u.func.function_bytecode;
+    if (!b || b->lazy || !b->source || b->source_len <= 0 || !sf->cur_pc)
+        return 0;
+    line = find_line_num(ctx, b, sf->cur_pc - b->byte_code_buf - 1, &col);
+    if (line < 0)
+        return 0;
+    /* walk the function's own text from where it starts to there */
+    l = b->line_num;
+    c = b->col_num;
+    pos = -1;
+    for (i = 0; i < b->source_len; i++) {
+        if (l > line || (l == line && c >= col)) {
+            pos = i;
+            break;
+        }
+        if (b->source[i] == '\n') {
+            l++;
+            c = 1;
+        } else {
+            c++;
+        }
+    }
+    if (pos < 0)
+        return 0;
+    start = pos > before ? pos - before : 0;
+    n = b->source_len - start;
+    if (n > buf_len - 1)
+        n = buf_len - 1;
+    for (i = 0; i < n; i++) {
+        unsigned char ch = (unsigned char)b->source[start + i];
+        buf[i] = (ch < 0x20 || ch == 0x7f) ? ' ' : (char)ch;
+    }
+    buf[n] = '\0';
+    return n;
+}
 
