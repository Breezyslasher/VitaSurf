+/** The line a name gives in one axis's names, or -1. */
+static int grid_find_line(const struct grid_line_name *names, unsigned n,
+		uint32_t id)
+{
+	unsigned i;
+
+	if (id == 0) {
+		return -1;
+	}
+	for (i = 0; i < n; i++) {
+		if (names[i].id == id) {
+			return names[i].line;
+		}
+	}
+	return -1;
+}
