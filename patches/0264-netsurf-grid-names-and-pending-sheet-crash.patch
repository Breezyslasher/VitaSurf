+/**
+ * Read grid-template-areas into the areas' rectangles (VitaSurf). The
+ * value is its rows joined by '|', cells by single spaces, '.' for an
+ * empty cell. An area is the box around every cell with its name.
+ */
+static void grid_read_areas(struct grid_ctx *ctx)
+{
+	lwc_string *spec = NULL;
+	const char *p;
+	int row = 0, col = 0;
+
+	if (css_computed_grid_template_areas(ctx->grid->style, &spec) !=
+			CSS_GRID_TEMPLATE_AREAS_SET || spec == NULL) {
+		return;
+	}
+	p = lwc_string_data(spec);
+	while (*p != '\0') {
+		const char *s = p;
+		size_t n;
+
+		while (*p != '\0' && *p != ' ' && *p != '|') {
+			p++;
+		}
+		n = (size_t) (p - s);
+		if (n > 0 && !(n == 1 && s[0] == '.')) {
+			unsigned i;
+			lwc_string *name;
+
+			if (lwc_intern_string(s, n, &name) == lwc_error_ok) {
+				for (i = 0; i < ctx->n_areas; i++) {
+					if (ctx->areas[i].name == name) {
+						break;
+					}
+				}
+				if (i == ctx->n_areas) {
+					struct grid_area *g = realloc(ctx->areas,
+							(i + 1) * sizeof(*g));
+
+					if (g == NULL) {
+						lwc_string_unref(name);
+						return;
+					}
+					ctx->areas = g;
+					g[i].name = lwc_string_ref(name);
+					g[i].row0 = row;
+					g[i].row1 = row + 1;
+					g[i].col0 = col;
+					g[i].col1 = col + 1;
+					ctx->n_areas++;
+				} else {
+					struct grid_area *a = &ctx->areas[i];
+
+					if (row < a->row0) a->row0 = row;
+					if (row + 1 > a->row1) a->row1 = row + 1;
+					if (col < a->col0) a->col0 = col;
+					if (col + 1 > a->col1) a->col1 = col + 1;
+				}
+				lwc_string_unref(name);
+			}
+		}
+		if (*p == ' ') {
+			col++;
+			p++;
+		} else if (*p == '|') {
+			row++;
+			col = 0;
+			p++;
+		}
+	}
+}
