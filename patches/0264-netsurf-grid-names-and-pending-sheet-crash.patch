+/**
+ * Turn a placement that names a line or an area into a line number
+ * (VitaSurf): "head" as a start is the start of the area head, or the
+ * line head-start, or the line head; as an end, the same with -end. A
+ * name that is none of those leaves the placement auto.
+ */
+static void grid_resolve_name(const struct grid_ctx *ctx, bool columns,
+		bool start, uint8_t *type, int32_t *value)
+{
+	const struct grid_line_name *names = columns ? ctx->col_names :
+			ctx->row_names;
+	unsigned n_names = columns ? ctx->n_col_names : ctx->n_row_names;
+	lwc_string *name;
+	char buf[256];
+	size_t len;
+	unsigned i;
+	int line = -1;
+
+	if (*type != CSS_GRID_LINE_SET || *value < CSS_GRID_LINE_NAME_BASE) {
+		return;
+	}
+	name = css_grid_line_name((uint32_t) (*value -
+			CSS_GRID_LINE_NAME_BASE));
+	*type = CSS_GRID_LINE_AUTO;
+	*value = 0;
+	if (name == NULL) {
+		return;
+	}
+
+	for (i = 0; i < ctx->n_areas && line < 0; i++) {
+		bool match = false;
+
+		if (lwc_string_isequal(ctx->areas[i].name, name, &match) ==
+				lwc_error_ok && match) {
+			const struct grid_area *a = &ctx->areas[i];
+
+			line = columns ? (start ? a->col0 : a->col1) :
+					(start ? a->row0 : a->row1);
+		}
+	}
+
+	len = lwc_string_length(name);
+	if (line < 0 && len + 7 < sizeof(buf)) {
+		memcpy(buf, lwc_string_data(name), len);
+		memcpy(buf + len, start ? "-start" : "-end",
+				start ? 6 : 4);
+		line = grid_find_line(names, n_names, css_grid_line_name_find(
+				buf, len + (start ? 6 : 4)));
+	}
+	if (line < 0) {
+		line = grid_find_line(names, n_names, css_grid_line_name_find(
+				lwc_string_data(name), len));
+	}
+	if (line >= 0) {
+		*type = CSS_GRID_LINE_SET;
+		*value = line + 1;
+	}
+}
