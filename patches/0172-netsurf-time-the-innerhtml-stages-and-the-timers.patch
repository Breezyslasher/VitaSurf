+/**
+ * Where an innerHTML assignment's time goes (VitaSurf).
+ *
+ * One job on a GitHub load runs for 14253 ms and the page makes exactly
+ * one innerHTML set, of 412727 bytes. Hubbub parses the whole 690 KB
+ * document in 46 ms, so the parse cannot be it; the same call also
+ * empties the target and moves the parsed nodes into a live tree, and
+ * the same job makes 2198 attribute sets and 737 tree edits. Time each
+ * of them apart.
+ */
+extern unsigned int vitasurf_ms_html_js_parse;
+extern unsigned int vitasurf_ms_html_js_empty;
+extern unsigned int vitasurf_ms_html_js_move;
+extern unsigned int vitasurf_ms_js_attr_time;
+extern unsigned int vitasurf_ms_js_edit_time;
+/**
+ * The shape of the timers, and which one is the worst (VitaSurf).
+ *
+ * Wikipedia spends 23103 ms in 89 timers -- 260 ms each -- while making
+ * 216 tree edits and reading two computed styles in the whole load, so
+ * it is not the DOM. An average cannot tell 89 middling callbacks from
+ * one enormous one, and the name of the worst says which module of the
+ * page it is.
+ */
+extern unsigned int vitasurf_ms_js_timer_max;
+extern unsigned int vitasurf_js_timers_slow;
+extern unsigned int vitasurf_ms_js_timers_slow;
+/** The name of the longest timer's callback, or "?". */
+extern char vitasurf_js_timer_max_name[64];
 
