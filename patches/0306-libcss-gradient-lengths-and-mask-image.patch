  */
 
+/*
+ * mask-image, written out by hand (VitaSurf). It began as the parser
+ * gen_parser produces from properties.gen and reads the same for none
+ * and url(); like background-image it also takes a gradient, carried
+ * as an image the renderer draws itself, and a comma-separated list of
+ * layers, of which the first is kept. -webkit-mask-image, which
+ * stylesheets still ship alongside the unprefixed property, produces
+ * the same bytecode.
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
 #include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/**
+ * Parse mask_image
+ *
+ * \param c	  Parsing context
+ * \param vector  Vector of tokens to process
+ * \param ctx	  Pointer to vector iteration context
+ * \param result  resulting style
+ * \return CSS_OK on success,
+ *	   CSS_NOMEM on memory exhaustion,
+ *	   CSS_INVALID if the input is not valid
+ *
+ * Post condition: \a *ctx is updated with the next token to process
+ *		   If the input is invalid, then \a *ctx remains unchanged.
+ */
+css_error css__parse_mask_image(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	css_error error;
+	const css_token *token;
+	lwc_string *uri = NULL;
+	uint32_t uri_snumber;
+	bool match;
+
+	token = parserutils_vector_iterate(vector, ctx);
+	if ((token == NULL) || ((token->type != CSS_TOKEN_IDENT) &&
+			(token->type != CSS_TOKEN_URI) &&
+			(token->type != CSS_TOKEN_FUNCTION))) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if ((token->type == CSS_TOKEN_IDENT) &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[INHERIT],
+			&match) == lwc_error_ok && match)) {
+		error = css_stylesheet_style_inherit(result,
+				CSS_PROP_MASK_IMAGE);
+	} else if ((token->type == CSS_TOKEN_IDENT) &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[INITIAL],
+			&match) == lwc_error_ok && match)) {
+		error = css_stylesheet_style_initial(result,
+				CSS_PROP_MASK_IMAGE);
+	} else if ((token->type == CSS_TOKEN_IDENT) &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[REVERT],
+			&match) == lwc_error_ok && match)) {
+		error = css_stylesheet_style_revert(result,
+				CSS_PROP_MASK_IMAGE);
+	} else if ((token->type == CSS_TOKEN_IDENT) &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[UNSET],
+			&match) == lwc_error_ok && match)) {
+		error = css_stylesheet_style_unset(result,
+				CSS_PROP_MASK_IMAGE);
+	} else if ((token->type == CSS_TOKEN_IDENT) &&
+			(lwc_string_caseless_isequal(
+			token->idata, c->strings[NONE],
+			&match) == lwc_error_ok && match)) {
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_MASK_IMAGE, 0, MASK_IMAGE_NONE);
+		if (error == CSS_OK)
+			css__skip_background_layers(vector, ctx);
+	} else if (token->type == CSS_TOKEN_IDENT) {
+		error = CSS_INVALID;
+	} else {
+		if (token->type == CSS_TOKEN_URI) {
+			error = c->sheet->resolve(c->sheet->resolve_pw,
+					c->sheet->url, token->idata, &uri);
+		} else {
+			/* a gradient: the whole function is read again
+			 * from its name */
+			*ctx = orig_ctx;
+			error = css__parse_gradient(c, vector, ctx, &uri);
+		}
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+
+		error = css__stylesheet_string_add(c->sheet, uri,
+				&uri_snumber);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_MASK_IMAGE, 0, MASK_IMAGE_URI);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+
+		error = css__stylesheet_style_append(result, uri_snumber);
+		if (error == CSS_OK)
+			css__skip_background_layers(vector, ctx);
+	}
+
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+
+	return error;
+}
 
