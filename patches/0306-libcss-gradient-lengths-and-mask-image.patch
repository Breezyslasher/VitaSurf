diff --git a/src/parse/properties/mask_image.c b/src/parse/properties/mask_image.c
index bd6ae50..0f4e114 100644
--- a/src/parse/properties/mask_image.c
+++ b/src/parse/properties/mask_image.c
@@ -2,13 +2,134 @@
