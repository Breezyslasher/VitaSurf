+/**
+ * Join a pending :is()/:where() prefix chain into the selector
+ * (VitaSurf).
+ *
+ * "before" is what the chain attaches to on its left -- the compound
+ * already parsed, or NULL when the chain starts the selector -- and
+ * "comb" is the combinator that was written between them. The chain
+ * itself, then the subject, follow.
+ *
+ * Combining is left to right so that each selector picks up the
+ * specificity of everything ahead of it, which is what
+ * css__stylesheet_selector_combine() does one link at a time.
+ *
+ * With no chain pending this is just the combine parseSelector() would
+ * have done itself, so it is safe to call every time.
+ */
+static css_error splicePrefixChain(css_language *c, css_selector *before,
+		css_combinator comb, css_selector *subject)
+{
+	css_combinator next = comb;
+	css_error error;
+	int i;
+
+	for (i = 0; i < c->prefix_n; i++) {
+		if (before != NULL) {
+			error = css__stylesheet_selector_combine(c->sheet,
+					next, before, c->prefix[i]);
+			if (error != CSS_OK) {
+				dropPrefixChain(c);
+				return error;
+			}
+		}
+		before = c->prefix[i];
+		next = (css_combinator) c->prefix_comb[i];
+		c->prefix[i] = NULL;
+	}
+	c->prefix_n = 0;
+
+	if (before == NULL)
+		return CSS_OK;	/* nothing to the left of the subject */
+
+	return css__stylesheet_selector_combine(c->sheet, next, before,
+			subject);
+}
+
+/**
+ * Does this :is() or :where() argument contain a combinator? (VitaSurf)
+ *
+ * Scans from the argument's first token to the ',' or ')' that ends it,
+ * at bracket depth zero. Whitespace counts only when something other
+ * than the end follows it, because the whitespace before ')' is not a
+ * descendant combinator.
+ */
+static bool groupArgHasCombinator(const parserutils_vector *vector,
+		int32_t ctx)
+{
+	int32_t i = ctx;
+	int depth = 0;
+	const css_token *t;
+
+	while ((t = parserutils_vector_peek(vector, i)) != NULL) {
+		if (tokenIsChar(t, '(') || tokenIsChar(t, '[')) {
+			depth++;
+		} else if (tokenIsChar(t, ']')) {
+			if (depth > 0) depth--;
+		} else if (tokenIsChar(t, ')')) {
+			if (depth == 0)
+				break;
+			depth--;
+		} else if (depth == 0) {
+			if (tokenIsChar(t, ','))
+				break;
+			if (tokenIsChar(t, '>') || tokenIsChar(t, '+') ||
+					tokenIsChar(t, '~'))
+				return true;
+			if (t->type == CSS_TOKEN_S) {
+				const css_token *n =
+					parserutils_vector_peek(vector, i + 1);
+				if (n != NULL && !tokenIsChar(n, ')') &&
+						!tokenIsChar(n, ',') &&
+						!tokenIsChar(n, '>') &&
+						!tokenIsChar(n, '+') &&
+						!tokenIsChar(n, '~'))
+					return true;
+			}
+		}
+		i++;
+	}
+	return false;
+}
+
+/** Release a prefix chain that will not be used. */
+static void dropPrefixChain(css_language *c)
+{
+	int i;
+
+	for (i = 0; i < c->prefix_n; i++) {
+		if (c->prefix[i] != NULL) {
+			css__stylesheet_selector_destroy(c->sheet,
+					c->prefix[i]);
+			c->prefix[i] = NULL;
+		}
+	}
+	c->prefix_n = 0;
+}
+
+/**
+ * Parse an :is() or :where() argument that has combinators in it
+ * (VitaSurf).
+ *
+ * ":is(.a .b)" is ".a .b" with the enclosing compound's own details on
+ * the .b. So every compound but the last is parsed as a selector of its
+ * own and left in c->prefix for parseSelector() to join in front, and
+ * the last one's details are merged into the compound being built, the
+ * same as an argument with no combinator.
+ *
+ * Specificity comes out right because nothing is combined here:
+ * css__stylesheet_selector_combine() propagates as it goes, so the
+ * combining has to happen strictly left to right, which only
+ * parseSelector() is in a position to do.
+ */
+static css_error parseGroupChain(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_selector **parent)
+{
+	css_selector *last = NULL;
+	const css_selector_detail *det;
+	const css_token *token;
+	css_error error;
+
+	/* One pending chain at a time: ":is(.a .b):is(.c .d)" would need
+	 * two, and getting it wrong matches elements the page never
+	 * meant. */
+	if (c->prefix_n != 0)
+		return CSS_INVALID;
+
+	for (;;) {
+		css_selector *cur = NULL;
+		css_combinator comb = CSS_COMBINATOR_NONE;
+
+		error = parseSimpleSelector(c, vector, ctx, &cur);
+		if (error != CSS_OK) {
+			dropPrefixChain(c);
+			return error;
+		}
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL) {
+			css__stylesheet_selector_destroy(c->sheet, cur);
+			dropPrefixChain(c);
+			return CSS_INVALID;
+		}
+		if (tokenIsChar(token, ')') || tokenIsChar(token, ',')) {
+			last = cur;
+			break;
+		}
+
+		if (tokenIsChar(token, '>')) {
+			comb = CSS_COMBINATOR_PARENT;
+		} else if (tokenIsChar(token, '+')) {
+			comb = CSS_COMBINATOR_SIBLING;
+		} else if (tokenIsChar(token, '~')) {
+			comb = CSS_COMBINATOR_GENERIC_SIBLING;
+		} else {
+			/* consumeWhitespace ate it, so this is a descendant */
+			comb = CSS_COMBINATOR_ANCESTOR;
+		}
+		if (comb != CSS_COMBINATOR_ANCESTOR) {
+			parserutils_vector_iterate(vector, ctx);
+			consumeWhitespace(vector, ctx);
+		}
+
+		if (c->prefix_n >= CSS_GROUP_PREFIX_MAX) {
+			css__stylesheet_selector_destroy(c->sheet, cur);
+			dropPrefixChain(c);
+			return CSS_INVALID;
+		}
+		c->prefix[c->prefix_n] = cur;
+		c->prefix_comb[c->prefix_n] = (int) comb;
+		c->prefix_n++;
+	}
+
+	/*
+	 * Merge the last compound's details into the compound being
+	 * built. parseSimpleSelector() writes a universal element detail
+	 * when the argument named no element, and appending that would
+	 * only cost a comparison that is always true, so it is skipped.
+	 */
+	for (det = &last->data; det != NULL;
+			det = (det->next != 0) ? det + 1 : NULL) {
+		if (det == &last->data &&
+				det->type == CSS_SELECTOR_ELEMENT &&
+				det->negate == 0 &&
+				nameIs(det->qname.name, "*"))
+			continue;
+		error = css__stylesheet_selector_append_specific(c->sheet,
+				parent, det);
+		if (error != CSS_OK) {
+			css__stylesheet_selector_destroy(c->sheet, last);
+			dropPrefixChain(c);
+			return error;
+		}
+	}
+	(*parent)->specificity += last->specificity;
+	css__stylesheet_selector_destroy(c->sheet, last);
+
+	return CSS_OK;
+}
