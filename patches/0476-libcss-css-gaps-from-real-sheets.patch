+/*
+ * calc() over times and numbers (VitaSurf): animate.css writes every
+ * duration as calc(1s * 0.75) and every count as calc(1 * 2), and those
+ * declarations had been dropped. CSS Values 4's rules on types: a sum's
+ * terms are all times or all numbers, a product has a number on one
+ * side, and a division's divisor is a number other than zero.
+ */
+struct calc_val {
+	double v;	/* milliseconds for a time */
+	bool time;
+};
+
+static bool calc_sum(const parserutils_vector *vector, int32_t *ctx,
+		struct calc_val *out, int depth);
+
+static const css_token *calc_next(const parserutils_vector *vector,
+		int32_t *ctx)
+{
+	const css_token *t;
+
+	while ((t = parserutils_vector_peek(vector, *ctx)) != NULL &&
+			t->type == CSS_TOKEN_S)
+		parserutils_vector_iterate(vector, ctx);
+	return t;
+}
+
+static bool calc_value(const parserutils_vector *vector, int32_t *ctx,
+		struct calc_val *out, int depth)
+{
+	const css_token *t = calc_next(vector, ctx);
+	size_t consumed = 0, len;
+	const char *unit;
+	css_fixed n;
+
+	if (t == NULL)
+		return false;
+	parserutils_vector_iterate(vector, ctx);
+	if (t->type == CSS_TOKEN_NUMBER) {
+		n = css__number_from_lwc_string(t->idata, false, &consumed);
+		if (consumed != lwc_string_length(t->idata))
+			return false;
+		out->v = FIXTOFLT(n);
+		out->time = false;
+		return true;
+	}
+	if (t->type == CSS_TOKEN_DIMENSION) {
+		n = css__number_from_lwc_string(t->idata, false, &consumed);
+		len = lwc_string_length(t->idata);
+		unit = lwc_string_data(t->idata) + consumed;
+		if (len - consumed == 1 && (unit[0] == 's' || unit[0] == 'S'))
+			out->v = FIXTOFLT(n) * 1000.0;
+		else if (len - consumed == 2 && strncasecmp(unit, "ms", 2) == 0)
+			out->v = FIXTOFLT(n);
+		else
+			return false;
+		out->time = true;
+		return true;
+	}
+	if ((t->type == CSS_TOKEN_FUNCTION &&
+			lwc_string_length(t->idata) == 4 &&
+			strncasecmp(lwc_string_data(t->idata), "calc", 4) == 0) ||
+			tokenIsChar(t, '(')) {
+		if (depth > 16 || !calc_sum(vector, ctx, out, depth + 1))
+			return false;
+		t = calc_next(vector, ctx);
+		if (t == NULL || !tokenIsChar(t, ')'))
+			return false;
+		parserutils_vector_iterate(vector, ctx);
+		return true;
+	}
+	return false;
+}
+
+static bool calc_product(const parserutils_vector *vector, int32_t *ctx,
+		struct calc_val *out, int depth)
+{
+	struct calc_val r;
+	const css_token *t;
+
+	if (!calc_value(vector, ctx, out, depth))
+		return false;
+	while ((t = calc_next(vector, ctx)) != NULL &&
+			(tokenIsChar(t, '*') || tokenIsChar(t, '/'))) {
+		bool divide = tokenIsChar(t, '/');
+
+		parserutils_vector_iterate(vector, ctx);
+		if (!calc_value(vector, ctx, &r, depth))
+			return false;
+		if (divide) {
+			if (r.time || r.v == 0)
+				return false;
+			out->v /= r.v;
+		} else {
+			if (out->time && r.time)
+				return false;
+			out->v *= r.v;
+			out->time = out->time || r.time;
+		}
+	}
+	return true;
+}
+
+static bool calc_sum(const parserutils_vector *vector, int32_t *ctx,
+		struct calc_val *out, int depth)
+{
+	struct calc_val r;
+	const css_token *t;
+
+	if (!calc_product(vector, ctx, out, depth))
+		return false;
+	while ((t = calc_next(vector, ctx)) != NULL &&
+			(tokenIsChar(t, '+') || tokenIsChar(t, '-'))) {
+		bool minus = tokenIsChar(t, '-');
+
+		parserutils_vector_iterate(vector, ctx);
+		if (!calc_product(vector, ctx, &r, depth) ||
+				r.time != out->time)
+			return false;
+		out->v += minus ? -r.v : r.v;
+	}
+	return true;
+}
+
+/**
+ * A calc() of a time or a number, the function token taken, into *out
+ * if it is of the kind asked for (VitaSurf).
+ */
+static bool read_calc(const css_token *token,
+		const parserutils_vector *vector, int32_t *ctx, bool time,
+		double *out)
+{
+	struct calc_val v;
+	const css_token *t;
+
+	if (token->type != CSS_TOKEN_FUNCTION ||
+			lwc_string_length(token->idata) != 4 ||
+			strncasecmp(lwc_string_data(token->idata), "calc", 4) != 0)
+		return false;
+	if (!calc_sum(vector, ctx, &v, 0) || v.time != time)
+		return false;
+	t = calc_next(vector, ctx);
+	if (t == NULL || !tokenIsChar(t, ')'))
+		return false;
+	parserutils_vector_iterate(vector, ctx);
+	*out = v.v;
+	return true;
+}
