diff --git a/src/select/properties/appearance.c b/src/select/properties/appearance.c
new file mode 100644
index 0000000..30b0fdb
--- /dev/null
+++ b/src/select/properties/appearance.c
@@ -0,0 +1,132 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* appearance and scrollbar-width (VitaSurf): neither is inherited */
+
+css_error css__cascade_appearance(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_APPEARANCE_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		value = getValue(opv) == APPEARANCE_NONE ?
+				CSS_APPEARANCE_NONE : CSS_APPEARANCE_AUTO;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_appearance(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_appearance_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_appearance(style, hint->status);
+}
+
+css_error css__initial_appearance(css_select_state *state)
+{
+	return set_appearance(state->computed, CSS_APPEARANCE_AUTO);
+}
+
+css_error css__copy_appearance(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_appearance(to, get_appearance(from));
+}
+
+css_error css__compose_appearance(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_appearance(child);
+
+	return css__copy_appearance(
+			type == CSS_APPEARANCE_INHERIT ? parent : child,
+			result);
+}
+
+css_error css__cascade_scrollbar_width(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_SCROLLBAR_WIDTH_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case SCROLLBAR_WIDTH_THIN:
+			value = CSS_SCROLLBAR_WIDTH_THIN;
+			break;
+		case SCROLLBAR_WIDTH_NONE:
+			value = CSS_SCROLLBAR_WIDTH_NONE;
+			break;
+		default:
+			value = CSS_SCROLLBAR_WIDTH_AUTO;
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_scrollbar_width(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_scrollbar_width_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_scrollbar_width(style, hint->status);
+}
+
+css_error css__initial_scrollbar_width(css_select_state *state)
+{
+	return set_scrollbar_width(state->computed, CSS_SCROLLBAR_WIDTH_AUTO);
+}
+
+css_error css__copy_scrollbar_width(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_scrollbar_width(to, get_scrollbar_width(from));
+}
+
+css_error css__compose_scrollbar_width(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_scrollbar_width(child);
+
+	return css__copy_scrollbar_width(
+			type == CSS_SCROLLBAR_WIDTH_INHERIT ? parent : child,
+			result);
+}
