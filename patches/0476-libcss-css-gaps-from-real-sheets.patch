+
+/*
+ * text-align: match-parent (VitaSurf), and Chrome's -webkit-match-parent:
+ * the parent's alignment, its start or end taken on the parent's side,
+ * which is inheriting it but where the child's direction differs.
+ */
+css_error css__parse_text_align_match(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, enum css_properties_e op)
+{
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+
+	if (is_word(c, token, MATCH_PARENT) ||
+			is_word(c, token, WEBKIT_MATCH_PARENT)) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_inherit(result, op);
+	}
+	return css__parse_text_align_base(c, vector, ctx, result);
+}
