diff --git a/src/parse/properties/appearance.c b/src/parse/properties/appearance.c
new file mode 100644
index 0000000..094c210
--- /dev/null
+++ b/src/parse/properties/appearance.c
@@ -0,0 +1,99 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * appearance and scrollbar-width (VitaSurf).
+ *
+ * appearance (and -webkit-appearance, -moz-appearance): none | auto |
+ * base | base-select | textfield | menulist-button | <compat-auto>, as
+ * CSS Basic User Interface 4 has it. Whether a control is drawn as the
+ * browser's own is all that differs here, so every value but none is
+ * auto: a page that says none draws its checkbox or select itself, and
+ * the browser's mark or arrow had been drawn over it.
+ *
+ * scrollbar-width: auto | thin | none (CSS Scrollbars 1).
+ */
+
+#include <assert.h>
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+static bool word_in(const css_token *token, const char *const *words,
+		size_t n, size_t *which)
+{
+	size_t i, len;
+
+	if (token == NULL || token->type != CSS_TOKEN_IDENT)
+		return false;
+	len = lwc_string_length(token->idata);
+	for (i = 0; i < n; i++) {
+		if (strlen(words[i]) == len && strncasecmp(words[i],
+				lwc_string_data(token->idata), len) == 0) {
+			*which = i;
+			return true;
+		}
+	}
+	return false;
+}
+
+css_error css__parse_appearance(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const char *const words[] = {
+		"none", "auto", "base", "base-select", "textfield",
+		"menulist-button", "searchfield", "textarea", "checkbox",
+		"radio", "menulist", "listbox", "meter", "progress-bar",
+		"button",
+	};
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag;
+	size_t which = 0;
+
+	flag = get_css_flag_value(c, token);
+	if (flag != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag,
+				CSS_PROP_APPEARANCE);
+	}
+	if (!word_in(token, words, sizeof(words) / sizeof(words[0]), &which))
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+	return css__stylesheet_style_appendOPV(result, CSS_PROP_APPEARANCE, 0,
+			which == 0 ? APPEARANCE_NONE : APPEARANCE_AUTO);
+}
+
+css_error css__parse_scrollbar_width(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const char *const words[] = { "auto", "thin", "none" };
+	static const uint16_t values[] = {
+		SCROLLBAR_WIDTH_AUTO, SCROLLBAR_WIDTH_THIN,
+		SCROLLBAR_WIDTH_NONE,
+	};
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag;
+	size_t which = 0;
+
+	flag = get_css_flag_value(c, token);
+	if (flag != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag,
+				CSS_PROP_SCROLLBAR_WIDTH);
+	}
+	if (!word_in(token, words, sizeof(words) / sizeof(words[0]), &which))
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_SCROLLBAR_WIDTH, 0, values[which]);
+}
diff --git a/src/parse/properties/background_position.c b/src/parse/properties/background_position.c
index ba6c2a0..52003d9 100644
--- a/src/parse/properties/background_position.c
+++ b/src/parse/properties/background_position.c
@@ -13,6 +13,218 @@
 #include "parse/properties/properties.h"
 #include "parse/properties/utils.h"
 
+/*
+ * The three and four value forms (VitaSurf): "right 10px bottom 5px",
+ * "top -10px center", each edge keyword optionally followed by its
+ * offset, as CSS Backgrounds 3 has them. Only the one and two value
+ * forms had been read, so every icon placed from the right or bottom
+ * edge sat at the top left. An offset from the left or top is the
+ * position; one from the right or bottom is 100% less it, a percentage
+ * when it is one and otherwise calc(100% - offset), which the painter
+ * resolves against the room the image leaves.
+ */
+enum bp_kw { BP_NONE, BP_LEFT, BP_RIGHT, BP_TOP, BP_BOTTOM, BP_CENTER };
+
+struct bp_item {
+	enum bp_kw kw;
+	int32_t start, end;	/* an offset's tokens */
+	css_fixed length;
+	uint32_t unit;
+};
+
+static enum bp_kw bp_keyword(css_language *c, const css_token *token)
+{
+	static const struct { int s; enum bp_kw kw; } words[] = {
+		{ LEFT, BP_LEFT }, { RIGHT, BP_RIGHT }, { TOP, BP_TOP },
+		{ BOTTOM, BP_BOTTOM }, { CENTER, BP_CENTER },
+	};
+	bool match;
+	size_t i;
+
+	if (token == NULL || token->type != CSS_TOKEN_IDENT)
+		return BP_NONE;
+	for (i = 0; i < sizeof(words) / sizeof(words[0]); i++) {
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[words[i].s], &match) ==
+				lwc_error_ok && match)
+			return words[i].kw;
+	}
+	return BP_NONE;
+}
+
+/** calc(100% - the offset's tokens), as a length and unit. */
+static css_error bp_from_end(css_language *c,
+		const parserutils_vector *vector, const struct bp_item *it,
+		css_fixed *length, uint32_t *unit)
+{
+	static const char *const text[] = { "calc", "100", " ", "-", ")" };
+	lwc_string *s[5] = { NULL };
+	parserutils_vector *v = NULL;
+	css_token t;
+	css_error error = CSS_NOMEM;
+	int32_t i, ictx = 0;
+
+	if (it->unit == UNIT_PCT) {
+		*length = INTTOFIX(100) - it->length;
+		*unit = UNIT_PCT;
+		return CSS_OK;
+	}
+	for (i = 0; i < 5; i++) {
+		if (lwc_intern_string(text[i], strlen(text[i]), &s[i]) !=
+				lwc_error_ok)
+			goto out;
+	}
+	if (parserutils_vector_create(sizeof(css_token), 16, &v) !=
+			PARSERUTILS_OK)
+		goto out;
+	memset(&t, 0, sizeof(t));
+#define BP_PUT(ty, str) do { t.type = (ty); t.idata = (str); \
+		if (parserutils_vector_append(v, &t) != PARSERUTILS_OK) \
+			goto out; } while (0)
+	BP_PUT(CSS_TOKEN_FUNCTION, s[0]);
+	BP_PUT(CSS_TOKEN_PERCENTAGE, s[1]);
+	BP_PUT(CSS_TOKEN_S, s[2]);
+	BP_PUT(CSS_TOKEN_CHAR, s[3]);
+	BP_PUT(CSS_TOKEN_S, s[2]);
+	for (i = it->start; i < it->end; i++) {
+		int32_t at = i;
+		const css_token *o = parserutils_vector_iterate(vector, &at);
+
+		if (o == NULL)
+			goto out;
+		if (parserutils_vector_append(v, (void *) o) != PARSERUTILS_OK)
+			goto out;
+	}
+	BP_PUT(CSS_TOKEN_CHAR, s[4]);
+#undef BP_PUT
+	error = css__parse_unit_specifier(c, v, &ictx, UNIT_PX, length, unit);
+out:
+	if (v != NULL)
+		parserutils_vector_destroy(v);
+	for (i = 0; i < 5; i++) {
+		if (s[i] != NULL)
+			lwc_string_unref(s[i]);
+	}
+	return error;
+}
+
+/**
+ * Read the three or four value form at *ctx. CSS_INVALID with *ctx
+ * unchanged when there are not three or four items, so the caller reads
+ * the shorter forms; *done is set when they were there, valid or not.
+ */
+static css_error bp_long_form(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		uint16_t value[2], css_fixed length[2], uint32_t unit[2],
+		bool *done)
+{
+	int32_t at = *ctx;
+	struct bp_item it[4];
+	int n = 0, i, g = 0;
+	const struct bp_item *grp[2][2] = { { NULL } };
+
+	*done = false;
+	while (n < 4) {
+		const css_token *token;
+		enum bp_kw kw;
+
+		consumeWhitespace(vector, &at);
+		token = parserutils_vector_peek(vector, at);
+		if (token == NULL)
+			break;
+		kw = bp_keyword(c, token);
