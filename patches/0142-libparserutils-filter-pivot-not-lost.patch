index 00ee7eb..8a84715 100644
--- a/src/input/filter.c
+++ b/src/input/filter.c
@@ -292,6 +292,31 @@ parserutils_error parserutils__filter_process_chunk(parserutils_filter *input,
 #endif
 }
 
+/**
+ * Whether the filter still holds data it has not been able to write out.
+ *
+ * The internal codec path decodes up to a pivot buffer's worth of
+ * characters at a time and then writes them to the output. When the
+ * output fills, the characters that did not fit stay in the pivot and
+ * the input they came from has already been consumed. The stream above
+ * only asks whether the raw buffer still holds anything, so without this
+ * those characters are never asked for again: the last few dozen bytes
+ * of a document are decoded, dropped, and then reported as end of input
+ * in the middle of whatever tag they fell in. (VitaSurf)
+ *
+ * \param input  The input filter to query
+ * \return true if a further call would produce more output
+ */
+bool parserutils__filter_has_pending(parserutils_filter *input)
+{
+#ifdef WITHOUT_ICONV_FILTER
+	return input != NULL && input->leftover && input->pivot_len > 0;
+#else
+	(void) input;
+	return false;
+#endif
+}
+
