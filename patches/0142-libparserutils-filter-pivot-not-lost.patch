+	f->read_pending = false;
 	f->pivot_left = NULL;
 	f->pivot_len = 0;
 #endif
@@ -233,6 +237,8 @@ parserutils_error parserutils__filter_process_chunk(parserutils_filter *input,
 
 	return PARSERUTILS_OK;
 #else
+	parserutils_error read_error;
+
 	if (input->leftover) {
 		parserutils_error write_error;
 
@@ -255,8 +261,10 @@ parserutils_error parserutils__filter_process_chunk(parserutils_filter *input,
 		input->leftover = false;
 	}
 
+	read_error = PARSERUTILS_OK;
+
 	while (*len > 0) {
-		parserutils_error read_error, write_error;
+		parserutils_error write_error;
 		size_t pivot_len = sizeof(input->pivot_buf);
 		uint8_t *pivot = (uint8_t *) input->pivot_buf;
 
@@ -283,11 +291,60 @@ parserutils_error parserutils__filter_process_chunk(parserutils_filter *input,
 			}
 		}
 
+		input->read_pending = (read_error == PARSERUTILS_NOMEM);
+
 		if (read_error != PARSERUTILS_OK && 
 				read_error != PARSERUTILS_NOMEM)
 			return read_error;
 	}
 
+	/*
+	 * A character whose output did not fit in the pivot is kept by the
+	 * codec and handed over on the next call. When the input ran out on
+	 * exactly that character there is nothing for the loop above to go
+	 * round for, so the character is dropped -- the last one of every
+	 * sixty-fifth document, with nothing to say so. An empty source is
+	 * all the flush the codec needs, and the flag lives on the filter
+	 * because the input can run out on one call and the room to write
+	 * the character only appear on the next. (VitaSurf)
+	 */
+	while (input->read_pending) {
+		parserutils_error write_error;
+		const uint8_t *none = (const uint8_t *) "";
+		size_t nonelen = 0;
+		size_t pivot_len = sizeof(input->pivot_buf);
+		uint8_t *pivot = (uint8_t *) input->pivot_buf;
+
+		read_error = parserutils_charset_codec_decode(input->read_codec,
+				&none, &nonelen,
+				(uint8_t **) &pivot, &pivot_len);
+
+		pivot = (uint8_t *) input->pivot_buf;
+		pivot_len = sizeof(input->pivot_buf) - pivot_len;
+
+		/* Nothing came out, so there was nothing left to come */
+		if (pivot_len == 0) {
+			input->read_pending = false;
+			break;
+		}
+
+		input->read_pending = (read_error == PARSERUTILS_NOMEM);
+
+		write_error = parserutils_charset_codec_encode(
+				input->write_codec,
+				(const uint8_t **) &pivot,
+				&pivot_len,
+				output, outlen);
+
+		if (write_error != PARSERUTILS_OK) {
+			input->leftover = true;
+			input->pivot_left = pivot;
+			input->pivot_len = pivot_len;
+
+			return write_error;
+		}
+	}
+
 	return PARSERUTILS_OK;
 #endif
 }
