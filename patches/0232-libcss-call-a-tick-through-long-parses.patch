diff --git a/src/parse/parse.c b/src/parse/parse.c
index 1b2b034..f661236 100644
--- a/src/parse/parse.c
+++ b/src/parse/parse.c
@@ -300,6 +300,27 @@ css_error css__parser_setopt(css_parser *parser, css_parser_opttype type,
  * \param len     Length of chunk
  * \return CSS_OK on success, appropriate error otherwise
  */
+/*
+ * Called now and then from a long parse (VitaSurf), so that an embedder
+ * can keep other work moving: NetSurf lets its transfers read their
+ * sockets, which stood still for the 0.6 s a 400 KB sheet takes on the
+ * Vita. It must not reenter libcss. NULL for none.
+ */
+void (*css_parse_tick)(void);
+
+/** parser steps between calls of css_parse_tick; a power of two */
+#define PARSE_TICK_STEPS 512
+
+static inline void parse_tick(void)
+{
+	static unsigned int steps;
+
+	if (css_parse_tick != NULL &&
+			(++steps & (PARSE_TICK_STEPS - 1)) == 0) {
+		css_parse_tick();
+	}
+}
+
 css_error css__parser_parse_chunk(css_parser *parser, const uint8_t *data,
 		size_t len)
 {
@@ -320,6 +341,7 @@ css_error css__parser_parse_chunk(css_parser *parser, const uint8_t *data,
 			break;
 
 		error = parseFuncs[state->state](parser);
+		parse_tick();
 	} while (error == CSS_OK);
 
 	return error;
@@ -352,6 +374,7 @@ css_error css__parser_completed(css_parser *parser)
 			break;
 
 		error = parseFuncs[state->state](parser);
+		parse_tick();
 	} while (error == CSS_OK);
 
 	return error;
