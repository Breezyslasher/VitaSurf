diff --git a/content/handlers/html/box_inspect.h b/content/handlers/html/box_inspect.h
index a218326d8..be288a6b9 100644
--- a/content/handlers/html/box_inspect.h
+++ b/content/handlers/html/box_inspect.h
@@ -24,6 +24,32 @@
 #ifndef NETSURF_HTML_BOX_INSPECT_H
 #define NETSURF_HTML_BOX_INSPECT_H
 
+#include "content/handlers/html/box.h"
+
+/**
+ * Used overflow of a box (VitaSurf).
+ *
+ * The overflow of the root element, or of the body when the root's is
+ * visible, propagates to the viewport and the box itself renders as
+ * visible (CSS 2.1 section 11.1.1). NetSurf's viewport always scrolls,
+ * so those boxes just report visible here.
+ */
+static inline enum css_overflow_e box_overflow_x(const struct box *box)
+{
+	if (box->flags & OVERFLOW_VIEWPORT) {
+		return CSS_OVERFLOW_VISIBLE;
+	}
+	return css_computed_overflow_x(box->style);
+}
+
+static inline enum css_overflow_e box_overflow_y(const struct box *box)
+{
+	if (box->flags & OVERFLOW_VIEWPORT) {
+		return CSS_OVERFLOW_VISIBLE;
+	}
+	return css_computed_overflow_y(box->style);
+}
+
