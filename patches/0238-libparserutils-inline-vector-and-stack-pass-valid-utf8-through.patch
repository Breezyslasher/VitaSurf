+#ifdef WITHOUT_ICONV_FILTER
+/**
+ * How long the character at s is, if the UTF-8 codec would give back
+ * exactly its bytes; 0 if it would not, or if it does not all fit
+ * (VitaSurf).
+ *
+ * A run of ASCII already went straight across, but each other
+ * character sent the codec off to decode the next 64 characters one by
+ * one: GitHub's style sheets have enough of them in strings and content
+ * values that the round trip was still 6 % of their parse. A sequence
+ * of 2 to 4 bytes that the decoder accepts -- not overlong, not a
+ * surrogate, not U+FFFE or U+FFFF -- is re-encoded to the same bytes;
+ * past U+10FFFF, and anything else, is left to the codec.
+ */
+static inline size_t utf8_valid_length(const uint8_t *s, size_t room)
+{
+	uint32_t c, min;
+	size_t n, i;
+
+	if (s[0] < 0x80)
+		return 1;
+	if ((s[0] & 0xE0) == 0xC0) {
+		c = s[0] & 0x1F; n = 2; min = 0x80;
+	} else if ((s[0] & 0xF0) == 0xE0) {
+		c = s[0] & 0x0F; n = 3; min = 0x800;
+	} else if ((s[0] & 0xF8) == 0xF0) {
+		c = s[0] & 0x07; n = 4; min = 0x10000;
+	} else {
+		return 0;
+	}
+	if (n > room)
+		return 0;
+	for (i = 1; i < n; i++) {
+		if ((s[i] & 0xC0) != 0x80)
+			return 0;
+		c = (c << 6) | (s[i] & 0x3F);
+	}
+	if (c < min || (c >= 0xD800 && c <= 0xDFFF) || c == 0xFFFE ||
+			c == 0xFFFF || c > 0x10FFFF)
+		return 0;
+
+	return n;
+}
+#endif
