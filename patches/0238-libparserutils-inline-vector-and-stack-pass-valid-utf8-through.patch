+#ifndef PARSERUTILS_NO_INLINE
+/* Inline forms of the calls above (VitaSurf); same results */
+static inline parserutils_error parserutils__stack_push_inline(
+		parserutils_stack *stack, const void *item)
+{
+	int32_t slot;
+
+	if (stack == NULL || item == NULL || stack->current_item < -1 ||
+			stack->current_item == INT32_MAX)
+		return parserutils_stack_push(stack, item);
+
+	slot = stack->current_item + 1;
+	if ((size_t) slot >= stack->items_allocated)
+		return parserutils_stack_push(stack, item);
+
+	memcpy((uint8_t *) stack->items + (slot * stack->item_size),
+			item, stack->item_size);
+	stack->current_item = slot;
+
+	return PARSERUTILS_OK;
+}
+
+static inline parserutils_error parserutils__stack_pop_inline(
+		parserutils_stack *stack, void *item)
+{
+	if (stack == NULL)
+		return PARSERUTILS_BADPARM;
+	if (stack->current_item < 0)
+		return PARSERUTILS_INVALID;
+
+	if (item != NULL) {
+		memcpy(item, (uint8_t *) stack->items +
+				(stack->current_item * stack->item_size),
+				stack->item_size);
+	}
+	stack->current_item -= 1;
+
+	return PARSERUTILS_OK;
+}
+
+static inline void *parserutils__stack_get_current_inline(
+		parserutils_stack *stack)
+{
+	if (stack == NULL || stack->current_item < 0)
+		return NULL;
+
+	return (uint8_t *) stack->items +
+			(stack->current_item * stack->item_size);
+}
+
+#define parserutils_stack_push(s, i) \
+	parserutils__stack_push_inline((s), (i))
+#define parserutils_stack_pop(s, i) \
+	parserutils__stack_pop_inline((s), (i))
+#define parserutils_stack_get_current(s) \
+	parserutils__stack_get_current_inline((s))
+#endif
+
 #ifdef __cplusplus
 }
 #endif
