diff --git a/src/select/select.h b/src/select/select.h
index 4f272c7..0250922 100644
--- a/src/select/select.h
+++ b/src/select/select.h
@@ -58,6 +58,13 @@ struct css_node_data {
 	css_select_results partial;
 	css_bloom *bloom;
 	css_node_flags flags;
+	/*
+	 * The names of the node's attributes when it was selected
+	 * (VitaSurf). A sibling may share this node's style only if it
+	 * carries the same names; see
+	 * css_select_style__get_sharable_node_data_for_candidate.
+	 */
+	css_attr_bloom attr_bloom;
 };
 
 struct revert_data {
