+/**
+ * What laying the page out actually did (VitaSurf).
+ *
+ * A four kilobyte local page spends 1666 ms in layout where a real
+ * site spends 180, which is the wrong way round, and the millisecond
+ * total cannot say why. These can: how many times the document was
+ * laid out at all, and how much text was measured doing it. Counting
+ * is two increments, so unlike timing it does not change the thing it
+ * is counting.
+ */
+extern unsigned int vitasurf_layout_runs;
+extern unsigned int vitasurf_font_calls;
+extern unsigned int vitasurf_font_chars;
+/**
+ * Microseconds the font engine was inside (VitaSurf).
+ *
+ * The counts said a four kilobyte page measures text 192 times over
+ * 3339 characters and is laid out once, which cannot be 1719 ms, so
+ * either the font engine is far slower per call than it measures on a
+ * host or the time is somewhere else in layout. 192 calls is few
+ * enough that a clock read at each end costs nothing.
+ */
+extern unsigned int vitasurf_us_font;
+/**
+ * The part of that spent inside FreeType, and how often (VitaSurf).
+ *
+ * 1837 ms for 192 calls over 3339 characters is half a millisecond a
+ * character, which is far more than rendering one costs. These split
+ * it: how many characters reached FTC_ImageCache_LookupScaler at all
+ * rather than being answered from the advance cache, and how long
+ * those took. What is left is our own code around them.
+ */
+extern unsigned int vitasurf_font_lookups;
+extern unsigned int vitasurf_us_lookup;
 /**
  * Milliseconds spent inside script, however it was entered: a
