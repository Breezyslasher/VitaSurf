+	}
+
 	if (sheet->title != NULL)
 		free(sheet->title);
 
@@ -853,6 +858,72 @@ css_error css_stylesheet_used_root_hints(css_stylesheet *sheet, uint32_t *sig)
  *	   CSS_BADPARM on bad parameters,
  *	   CSS_NOMEM on memory exhaustion
  */
+/**
+ * Note that a declaration was thrown away (VitaSurf).
+ *
+ * A page whose rules are dropped renders wrongly with nothing said
+ * about it, so each property is remembered, with a count, for the
+ * client to report once the sheet is parsed.
+ *
+ * \param sheet       The stylesheet
+ * \param name        The property's name
+ * \param kind  0 unknown, 1 value not understood, 2 of no effect
+ */
+void css__stylesheet_note_gap(css_stylesheet *sheet, lwc_string *name,
+		uint32_t kind)
+{
+	uint32_t i;
+
+	if (sheet == NULL || name == NULL) {
+		return;
+	}
+
+	for (i = 0; i < sheet->n_gaps; i++) {
+		bool match = false;
+
+		if (lwc_string_caseless_isequal(sheet->gaps[i].name, name,
+				&match) == lwc_error_ok && match &&
+		    sheet->gaps[i].kind == kind) {
+			sheet->gaps[i].count++;
+			return;
+		}
+	}
+
+	if (sheet->n_gaps == CSS_STYLESHEET_GAPS) {
+		return;
+	}
+
+	sheet->gaps[sheet->n_gaps].name = lwc_string_ref(name);
+	sheet->gaps[sheet->n_gaps].count = 1;
+	sheet->gaps[sheet->n_gaps].kind = kind;
+	sheet->n_gaps++;
+}
+
+
+/* exported function documented in libcss/stylesheet.h */
+uint32_t css_stylesheet_gap_count(const css_stylesheet *sheet)
+{
+	return sheet == NULL ? 0 : sheet->n_gaps;
+}
+
+
+/* exported function documented in libcss/stylesheet.h */
+css_error css_stylesheet_get_gap(const css_stylesheet *sheet, uint32_t index,
+		lwc_string **name, uint32_t *count, uint32_t *kind)
+{
+	if (sheet == NULL || index >= sheet->n_gaps || name == NULL ||
+			count == NULL || kind == NULL) {
+		return CSS_BADPARM;
+	}
+
+	*name = sheet->gaps[index].name;
+	*count = sheet->gaps[index].count;
+	*kind = sheet->gaps[index].kind;
+
+	return CSS_OK;
+}
+
