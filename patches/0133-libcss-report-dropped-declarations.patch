 css_error css_stylesheet_destroy(css_stylesheet *sheet)
 {
+	uint32_t gap;
 	uint32_t index;
 	css_rule *r, *s;
 
 	if (sheet == NULL)
 		return CSS_BADPARM;
 
+	for (gap = 0; gap < sheet->n_gaps; gap++) {
