+/*
+ * The decode thread (VitaSurf).
+ *
+ * Pacing decodes keeps several from piling into one frame, but a single
+ * large one still holds its frame for as long as it takes. A handler
+ * whose convert routine touches nothing but the content's source data
+ * and a new bitmap marks its entries threadsafe, and those are decoded
+ * on a thread of their own: the redraw queues the entry and draws
+ * nothing, the thread decodes, and the main thread takes the bitmap at
+ * the start of a frame and has the place drawn again. This is what
+ * Vita_Suwayomi does with its covers.
+ *
+ * Only the main thread touches the cache's entries. The thread sees a
+ * job: the content, whose source data stays put while the content
+ * lives, and the convert routine. An entry freed with a job still out
+ * takes the job back, or waits for the thread to finish it.
+ */
+
+/* jobs waiting at most; past it the oldest is dropped, and its image
+ * queued again if it is drawn again */
+#define DECODER_QUEUE_MAX 64
+/* the thread's stack: the decoders' own state is on the heap */
+#define DECODER_STACK_SIZE (256 * 1024)
+
+struct decode_job {
+	struct decode_job *next;
+	struct image_cache_entry_s *centry;
+	struct content *content;
+	image_cache_convert_fn *convert;
+	struct bitmap *result;
+	uint64_t us;
+};
+
+static pthread_mutex_t decoder_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t decoder_wake = PTHREAD_COND_INITIALIZER;
+static pthread_cond_t decoder_idle = PTHREAD_COND_INITIALIZER;
+static pthread_t decoder_thread;
+static bool decoder_on;
+static bool decoder_quit;
+static struct decode_job *decoder_head, *decoder_tail;
+static unsigned int decoder_waiting;
+static struct decode_job *decoder_running;
+static struct decode_job *decoder_done;
+static void (*decoder_started)(void);
+
+static void *image_cache_decoder_main(void *arg)
+{
+	(void)arg;
+	if (decoder_started != NULL) {
+		decoder_started();
+	}
+	pthread_mutex_lock(&decoder_lock);
+	while (!decoder_quit) {
+		struct decode_job *job;
+		uint64_t t0;
+
+		if (decoder_head == NULL) {
+			pthread_cond_wait(&decoder_wake, &decoder_lock);
+			continue;
+		}
+		job = decoder_head;
+		decoder_head = job->next;
+		if (decoder_head == NULL) {
+			decoder_tail = NULL;
+		}
+		decoder_waiting--;
+		decoder_running = job;
+		pthread_mutex_unlock(&decoder_lock);
+
+		t0 = vitasurf_clock_us();
+		job->result = job->convert(job->content);
+		job->us = vitasurf_clock_us() - t0;
+
+		pthread_mutex_lock(&decoder_lock);
+		decoder_running = NULL;
+		job->next = decoder_done;
+		decoder_done = job;
+		pthread_cond_broadcast(&decoder_idle);
+	}
+	pthread_mutex_unlock(&decoder_lock);
+	return NULL;
+}
+
+/* exported interface documented in image_cache.h */
+bool image_cache_start_decoder(void (*started)(void))
+{
+	pthread_attr_t attr;
+	bool ok;
+
+	if (decoder_on) {
+		return true;
+	}
+	decoder_started = started;
+	decoder_quit = false;
+	if (pthread_attr_init(&attr) != 0) {
+		return false;
+	}
+	pthread_attr_setstacksize(&attr, DECODER_STACK_SIZE);
+	ok = pthread_create(&decoder_thread, &attr,
+			    image_cache_decoder_main, NULL) == 0;
+	pthread_attr_destroy(&attr);
+	decoder_on = ok;
+	return ok;
+}
+
+/** Stop the thread and throw away what it has not handed over. */
+static void image_cache_decoder_stop(void)
+{
+	struct decode_job *job;
+
+	if (!decoder_on) {
+		return;
+	}
+	pthread_mutex_lock(&decoder_lock);
+	decoder_quit = true;
+	pthread_cond_broadcast(&decoder_wake);
+	pthread_mutex_unlock(&decoder_lock);
+	pthread_join(decoder_thread, NULL);
+	decoder_on = false;
+
+	while ((job = decoder_head) != NULL) {
+		decoder_head = job->next;
+		job->centry->queued = false;
+		free(job);
+	}
+	decoder_tail = NULL;
+	decoder_waiting = 0;
+	while ((job = decoder_done) != NULL) {
+		decoder_done = job->next;
+		job->centry->queued = false;
+		if (job->result != NULL) {
+			guit->bitmap->destroy(job->result);
+		}
+		free(job);
+	}
+}
+
+/** Hand an entry to the thread; main thread, entry not queued. */
+static void image_cache_decoder_queue(struct image_cache_entry_s *centry)
+{
+	struct decode_job *job = calloc(1, sizeof(*job));
+	struct decode_job *dropped = NULL;
+
+	if (job == NULL) {
+		return;
+	}
+	job->centry = centry;
+	job->content = centry->content;
+	job->convert = centry->convert;
+	centry->queued = true;
+
+	pthread_mutex_lock(&decoder_lock);
+	if (decoder_waiting >= DECODER_QUEUE_MAX) {
+		/* the oldest is the least likely still to be in view */
+		dropped = decoder_head;
+		decoder_head = dropped->next;
+		if (decoder_head == NULL) {
+			decoder_tail = NULL;
+		}
+		decoder_waiting--;
+	}
+	if (decoder_tail != NULL) {
+		decoder_tail->next = job;
+	} else {
+		decoder_head = job;
+	}
+	decoder_tail = job;
+	decoder_waiting++;
+	pthread_cond_signal(&decoder_wake);
+	pthread_mutex_unlock(&decoder_lock);
+
+	if (dropped != NULL) {
+		dropped->centry->queued = false;
+		decode_stats.dropped++;
+		free(dropped);
+	}
+	decode_stats.queued++;
+}
+
+/**
+ * Take an entry's job back before the entry is freed: out of the
+ * queue, or out of the finished list once the thread has done with it.
+ */
+static void image_cache_decoder_forget(struct image_cache_entry_s *centry)
+{
+	struct decode_job **pp, *job, *prev = NULL;
+
+	pthread_mutex_lock(&decoder_lock);
+	for (job = decoder_head; job != NULL; prev = job, job = job->next) {
+		if (job->centry == centry) {
+			if (prev != NULL) {
+				prev->next = job->next;
+			} else {
+				decoder_head = job->next;
+			}
+			if (decoder_tail == job) {
+				decoder_tail = prev;
+			}
+			decoder_waiting--;
+			free(job);
+			break;
+		}
+	}
+	while (decoder_running != NULL && decoder_running->centry == centry) {
+		pthread_cond_wait(&decoder_idle, &decoder_lock);
+	}
+	for (pp = &decoder_done; *pp != NULL; pp = &(*pp)->next) {
+		if ((*pp)->centry == centry) {
+			job = *pp;
+			*pp = job->next;
+			if (job->result != NULL) {
+				guit->bitmap->destroy(job->result);
+			}
+			free(job);
+			break;
+		}
+	}
+	pthread_mutex_unlock(&decoder_lock);
+	centry->queued = false;
+}
+
+/** Take what the thread has finished; main thread, once a frame. */
+static void image_cache_decoder_collect(void)
+{
+	struct decode_job *job;
+
+	if (!decoder_on) {
+		return;
+	}
+	pthread_mutex_lock(&decoder_lock);
+	job = decoder_done;
+	decoder_done = NULL;
+	pthread_mutex_unlock(&decoder_lock);
+
+	while (job != NULL) {
+		struct decode_job *next = job->next;
+		struct image_cache_entry_s *centry = job->centry;
+		unsigned int ms = (unsigned int)(job->us / 1000);
+		unsigned int kpx = (unsigned int)
+			(((uint64_t)centry->content->width *
+			  (uint64_t)centry->content->height) / 1000);
+
+		centry->queued = false;
+		decode_stats.threaded++;
+		decode_threaded_us += job->us;
+		if (ms > decode_stats.threaded_max_ms) {
+			decode_stats.threaded_max_ms = ms;
+			decode_stats.threaded_max_kpixels = kpx;
+		}
+		if (ms >= IMAGE_CACHE_SLOW_DECODE_MS) {
+			const char *url = nsurl_access_leaf(
+					llcache_handle_get_url(
+						centry->content->llcache));
+
+			vita_log("images: the decode thread took %u ms "
+				 "for %dx%d %s", ms,
+				 centry->content->width,
+				 centry->content->height,
+				 url != NULL ? url : "?");
+		}
+		if (job->result == NULL) {
+			centry->decode_failed = true;
+		} else if (centry->bitmap != NULL) {
+			/* decoded meanwhile on this thread */
+			guit->bitmap->destroy(job->result);
+		} else {
+			centry->bitmap = job->result;
+			image_cache_stats_bitmap_add(centry, centry->bitmap);
+			image_cache->miss_count++;
+			image_cache->miss_size += centry->bitmap_size;
+		}
+		free(job);
+		job = next;
+	}
+}
+
+/* exported interface documented in image_cache.h */
+bool image_cache_decoder_busy(void)
+{
+	bool busy;
+
+	if (!decoder_on) {
+		return false;
+	}
+	pthread_mutex_lock(&decoder_lock);
+	busy = decoder_head != NULL || decoder_running != NULL ||
+		decoder_done != NULL;
+	pthread_mutex_unlock(&decoder_lock);
+	return busy;
+}
+
+/* exported interface documented in image_cache.h */
+bool image_cache_ready(const void *key)
+{
+	struct image_cache_entry_s *centry;
+
+	if (key == NULL) {
+		return true;
+	}
+	centry = image_cache__find(key);
+	/* gone, or dropped from the queue: drawing it again does no
+	 * harm, and queues it again if it is still wanted */
+	return centry == NULL || !centry->queued;
+}
+
+/* exported interface documented in image_cache.h */
+void image_cache_set_threadsafe(struct content *c)
+{
+	struct image_cache_entry_s *centry = image_cache__find(c);
+
+	if (centry != NULL) {
+		centry->threadsafe = true;
+	}
+}
