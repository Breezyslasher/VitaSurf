diff --git a/content/handlers/html/box_construct.c b/content/handlers/html/box_construct.c
index 3ded9d2e0..77a076a5b 100644
--- a/content/handlers/html/box_construct.c
+++ b/content/handlers/html/box_construct.c
@@ -291,9 +291,17 @@ box_get_style(html_content *c,
 	ctx.root_style = root_style;
 	ctx.parent_style = parent_style;
 
-	/* Select style for element */
-	styles = nscss_get_style(&ctx, n, &c->media, &c->unit_len_ctx,
-			inline_style);
+	/* Select style for element, and time it (VitaSurf) */
+	{
+		uint64_t sel_t0 = 0, sel_t1 = 0;
+
+		nsu_getmonotonic_ms(&sel_t0);
+		styles = nscss_get_style(&ctx, n, &c->media, &c->unit_len_ctx,
+				inline_style);
+		nsu_getmonotonic_ms(&sel_t1);
+		vitasurf_ms_select += (unsigned int)(sel_t1 - sel_t0);
+		vitasurf_box_elements++;
+	}
 
 	/* No longer need inline style */
 	if (inline_style != NULL)
