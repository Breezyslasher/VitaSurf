diff --git a/utils/utils.h b/utils/utils.h
index bdd434dd3..c03876c96 100644
--- a/utils/utils.h
+++ b/utils/utils.h
@@ -271,6 +271,16 @@ extern unsigned int vitasurf_ms_js_finds;
  * ran for twenty-three seconds with the whole browser stopped behind
  * it, and the scheduler does not record which callback it was.
  */
+/*
+ * Inside the boxes-and-styles bucket (VitaSurf). A build 375 log spends
+ * 72391 ms of a 137526 ms GitHub load there, against 7792 ms of script
+ * -- so the page is not bound by JavaScript at all, and the bucket
+ * covers two quite different jobs. Selecting an element's style is a
+ * walk of every rule that could match it; building its box is not.
+ */
+extern unsigned int vitasurf_ms_select;
+extern unsigned int vitasurf_box_elements;
+
 extern unsigned int vitasurf_sched_calls;
 extern unsigned int vitasurf_ms_sched;
 extern unsigned int vitasurf_ms_sched_max;
