+/**
+ * How far a position: sticky box is shifted at the current scroll
+ * (VitaSurf).
+ *
+ * The box is laid out where static would put it. When the viewport
+ * has scrolled past that by more than its top offset it is drawn
+ * lower, held at the offset, until it would leave its containing
+ * block's content box, where it stops. A bottom offset holds it up
+ * the same way from the viewport's bottom edge. Left and right are
+ * not honoured: this frontend does not scroll sideways.
+ *
+ * \param html      Content the box belongs to, with the viewport of
+ *                  this redraw in view_y and view_h
+ * \param box       The sticky box
+ * \param y_parent  Top of the parent's padding box as plotted
+ * \return the shift to add to box->y, in content px
+ */
+static int html_sticky_offset(const html_content *html, struct box *box,
+		int y_parent)
+{
+	struct box *parent = box->parent;
+	int top_px = 0, bottom_px = 0;
+	int box_top, box_bottom, dy = 0;
+
+	if (html->view_h <= 0 || parent == NULL)
+		return 0;
+
+	/* y_parent is where the parent was plotted; the content's own
+	 * origin was plotted at view_origin_y */
+	y_parent -= html->view_origin_y;
+
+	/* the border edges of the box, as laid out */
+	box_top = y_parent + box->y - box->border[TOP].width;
+	box_bottom = y_parent + box->y + box->padding[TOP] + box->height +
+			box->padding[BOTTOM] + box->border[BOTTOM].width;
+
+	if (css_computed_top_px(box->style, &html->unit_len_ctx,
+			html->view_h, &top_px) == CSS_TOP_SET) {
+		int want = html->view_y + top_px;
+
+		if (box_top < want)
+			dy = want - box_top;
+	}
+	if (dy == 0 && css_computed_bottom_px(box->style,
+			&html->unit_len_ctx, html->view_h, &bottom_px) ==
+			CSS_BOTTOM_SET) {
+		int want = html->view_y + html->view_h - bottom_px;
+
+		if (box_bottom > want)
+			dy = want - box_bottom;
+	}
+
+	if (dy > 0) {
+		/* no further than the bottom of the containing block */
+		int cb_bottom = y_parent + parent->padding[TOP] +
+				parent->height;
+		int room = cb_bottom - (box_bottom + box->margin[BOTTOM]);
+
+		if (room < 0)
+			room = 0;
+		if (dy > room)
+			dy = room;
+	} else if (dy < 0) {
+		int cb_top = y_parent + parent->padding[TOP];
+		int room = cb_top - (box_top - box->margin[TOP]);
+
+		if (room > 0)
+			room = 0;
+		if (dy < room)
+			dy = room;
+	}
+
+	return dy;
+}
