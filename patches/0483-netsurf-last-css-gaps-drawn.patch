+		{ "\xe2\x80\xa2", "\xe2\x97\xa6" },	/* dot */
+		{ "\xe2\x97\x8f", "\xe2\x97\x8b" },	/* circle */
+		{ "\xe2\x97\x89", "\xe2\x97\x8e" },	/* double-circle */
+		{ "\xe2\x96\xb2", "\xe2\x96\xb3" },	/* triangle */
+		{ "\xef\xb9\x85", "\xef\xb9\x86" },	/* sesame */
+	};
+	plot_font_style_t mstyle = *text_style;
+	lwc_string *str = NULL;
+	const char *mark;
+	size_t mark_len, i;
