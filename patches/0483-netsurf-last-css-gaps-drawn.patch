+
+static void html_bg_axis(struct html_bg_axis *a, bool spaced, bool repeat,
+		int pos, int area, int size, int c0, int c1, float scale)
+{
+	if (spaced) {
+		/* the first and the last at the edges, the rest of the
+		 * room shared between them */
+		int n = area / size;
+		float gap = n > 1 ? (float) (area - n * size) / (n - 1) : 0;
+
+		a->first = pos;
+		a->step = (size + gap) * scale;
+		a->n = n;
+	} else if (repeat) {
+		/* tiled from where background-position put one, back to
+		 * the clip's start and on to its end */
+		float step = size * scale;
+		float first = pos - ceilf((pos - c0) / step) * step;
+
+		a->first = first;
+		a->step = step;
+		a->n = (int) ceilf((c1 - first) / step);
+	} else {
+		a->first = pos;
+		a->step = 0;
+		a->n = 1;
+	}
