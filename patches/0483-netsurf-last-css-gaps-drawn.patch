+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * A bitmap scaled smooth (VitaSurf), for image-rendering: auto. Kept
+ * apart from the plotters so tests/images/scale-test.c can hold it to
+ * its sums natively.
+ */
+
+#ifndef NETSURF_FB_SCALE_SMOOTH_H
+#define NETSURF_FB_SCALE_SMOOTH_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+/** One output pixel's source pixels along an axis, and their weights
+ * in 256ths. */
+struct scale_taps {
+	int at[4];
+	uint16_t weight[4];
+	int n;
+};
+
+static void scale_axis(struct scale_taps *t, int i, int dst, int src)
+{
+	if (src > dst) {
+		/* shrinking: samples spread over the footprint */
+		int n = (src + dst - 1) / dst, k;
+
+		if (n > 4)
+			n = 4;
+		t->n = n;
+		for (k = 0; k < n; k++) {
+			int64_t num = (int64_t) (2 * i * n + 2 * k + 1) * src;
+			int at = (int) (num / (2 * (int64_t) dst * n));
+
+			t->at[k] = at < src ? at : src - 1;
+			t->weight[k] = (uint16_t) (256 / n +
+					(k < 256 % n ? 1 : 0));
+		}
+	} else {
+		/* growing: the two nearest, by distance */
+		int64_t c = ((int64_t) (2 * i + 1) * src * 256) /
+				(2 * (int64_t) dst) - 128;
+		int at, f;
+
+		if (c < 0)
+			c = 0;
+		at = (int) (c >> 8);
+		f = (int) (c & 255);
+		if (at >= src - 1) {
+			at = src - 1;
+			f = 0;
+		}
+		t->at[0] = at;
+		t->weight[0] = (uint16_t) (256 - f);
+		t->at[1] = at + 1 < src ? at + 1 : at;
+		t->weight[1] = (uint16_t) f;
+		t->n = f ? 2 : 1;
+		if (f == 0)
+			t->weight[0] = 256;
+	}
+}
+
+/**
+ * A bitmap drawn smooth at w by h (VitaSurf). With alpha the colours
+ * are averaged by it, so a transparent pixel's colour does not bleed
+ * into the edge of what is next to it.
+ */
+static bool scale_smooth(const uint8_t *bptr, int bw, int bh, int bstride,
+		uint8_t *dptr, int w, int h, int dstride, bool alpha)
+{
+	struct scale_taps *xt = malloc(sizeof(*xt) * (size_t) w);
+	struct scale_taps yt;
+	int x, y;
+
+	if (xt == NULL)
+		return false;
+	for (x = 0; x < w; x++)
+		scale_axis(&xt[x], x, w, bw);
+	for (y = 0; y < h; y++) {
+		uint32_t *dp = (uint32_t *)(void *)
+			(dptr + (size_t) y * (size_t) dstride);
+
+		scale_axis(&yt, y, h, bh);
+		for (x = 0; x < w; x++) {
+			const struct scale_taps *t = &xt[x];
+			uint32_t sa = 0, sr = 0, sg = 0, sb = 0;
+			int j, k;
+
+			for (j = 0; j < yt.n; j++) {
+				const uint32_t *sp = (const uint32_t *)(const
+					void *) (bptr + (size_t) yt.at[j] *
+						(size_t) bstride);
+
+				for (k = 0; k < t->n; k++) {
+					uint32_t p = sp[t->at[k]];
+					uint32_t wt = (uint32_t) yt.weight[j] *
+							t->weight[k];
+					uint32_t a = alpha ? p >> 24 : 255;
+
+					/* premultiplied to 8 bits, so the
+					 * sums stay within 32 */
+					sa += a * wt;
+					sr += ((p & 0xff) * a / 255) * wt;
+					sg += (((p >> 8) & 0xff) * a / 255) *
+							wt;
+					sb += (((p >> 16) & 0xff) * a / 255) *
+							wt;
+				}
+			}
+			if (sa == 0) {
+				dp[x] = 0;
+			} else {
+				uint32_t r = (uint32_t) (((uint64_t) sr * 255 +
+						sa / 2) / sa);
+				uint32_t g = (uint32_t) (((uint64_t) sg * 255 +
+						sa / 2) / sa);
+				uint32_t b = (uint32_t) (((uint64_t) sb * 255 +
+						sa / 2) / sa);
+				uint32_t a = (sa + 32768) >> 16;
+
+				if (r > 255) r = 255;
+				if (g > 255) g = 255;
+				if (b > 255) b = 255;
+				if (a > 255) a = 255;
+				dp[x] = r | (g << 8) | (b << 16) |
+						((alpha ? a : 255u) << 24);
+			}
+		}
+	}
+	free(xt);
+	return true;
+}
+
+#endif
