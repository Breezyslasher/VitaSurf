+ * text-emphasis (VitaSurf): a mark over or under each character but a
+ * space or a control, half the text's size, centred on the character,
+ * in text-emphasis-color.
+ */
+static bool html_redraw_emphasis(const html_content *html,
+		const struct box *box, const css_computed_style *style,
+		const plot_font_style_t *text_style, int x, int y,
+		float scale, const struct redraw_context *ctx)
+{
