+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * shape-outside (VitaSurf): the float area a line box wraps around.
+ *
+ * libcss keeps the value as text, "<basic shape>|<box>". It is read
+ * once, when the float is sized, into a shape in the float box's own
+ * pixels, kept on the float box; a line asks it how far the float
+ * reaches across a band of rows. circle(), ellipse(), inset(), xywh(),
+ * rect() and polygon() are shaped, a box alone is its rectangle, and
+ * an image is the margin box: its picture is not read. Rounded corners
+ * of inset() and of a box are not followed. As the standard has it,
+ * the shape is clipped to the margin box and only line boxes see it:
+ * other floats and block formatting contexts still avoid the margin
+ * box.
+ */
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "utils/talloc.h"
+#include "css/utils.h"
+
+#include "html/box.h"
+#include "html/layout_shape.h"
+
+#define SHAPE_POINTS_MAX 64
+
+/** A shape, in the float box's pixels. */
+struct box_float_shape {
+	enum { SHAPE_RECT, SHAPE_ELLIPSE, SHAPE_POLYGON } kind;
+	float x0, y0, x1, y1;	/**< a rectangle, or an ellipse's bounds */
+	float margin;		/**< shape-margin */
+	int n;			/**< a polygon's points */
+	float pts[2 * SHAPE_POINTS_MAX];
+	float width, height;	/**< the margin box it is clipped to */
+};
+
+/** One value of the shape's text: a length or a percentage, or a
+ * word, or a comma. */
+struct shape_tok {
+	enum { TOK_LEN, TOK_PCT, TOK_WORD, TOK_COMMA, TOK_SLASH } kind;
+	float v;
+	css_unit unit;
+	char word[16];
+};
+
+#define SHAPE_TOKS_MAX (2 * SHAPE_POINTS_MAX + 16)
+
+/** A unit's text, as libcss takes it for a length. */
+static bool shape_unit(const char *u, size_t len, css_unit *unit)
+{
+	static const struct {
+		const char *name;
+		css_unit unit;
+	} units[] = {
+		{ "px", CSS_UNIT_PX }, { "em", CSS_UNIT_EM },
+		{ "rem", CSS_UNIT_REM }, { "ex", CSS_UNIT_EX },
+		{ "ch", CSS_UNIT_CH }, { "in", CSS_UNIT_IN },
+		{ "cm", CSS_UNIT_CM }, { "mm", CSS_UNIT_MM },
+		{ "pt", CSS_UNIT_PT }, { "pc", CSS_UNIT_PC },
+		{ "q", CSS_UNIT_Q }, { "lh", CSS_UNIT_LH },
+		{ "rlh", CSS_UNIT_RLH }, { "vh", CSS_UNIT_VH },
+		{ "vw", CSS_UNIT_VW }, { "vi", CSS_UNIT_VI },
+		{ "vb", CSS_UNIT_VB }, { "vmin", CSS_UNIT_VMIN },
+		{ "vmax", CSS_UNIT_VMAX }, { "dvh", CSS_UNIT_VH },
+		{ "svh", CSS_UNIT_VH }, { "lvh", CSS_UNIT_VH },
+		{ "dvw", CSS_UNIT_VW }, { "svw", CSS_UNIT_VW },
+		{ "lvw", CSS_UNIT_VW },
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(units) / sizeof(units[0]); i++) {
+		if (strlen(units[i].name) == len &&
+				strncasecmp(units[i].name, u, len) == 0) {
+			*unit = units[i].unit;
+			return true;
+		}
+	}
+	return false;
+}
+
+/** The arguments between the brackets, as tokens. */
+static int shape_tokens(const char *s, const char *end,
+		struct shape_tok *t, int max)
+{
+	int n = 0;
+
+	while (s < end && n < max) {
+		if (*s == ' ') {
+			s++;
+		} else if (*s == ',') {
+			t[n++].kind = TOK_COMMA;
+			s++;
+		} else if (*s == '/') {
+			t[n++].kind = TOK_SLASH;
+			s++;
+		} else if ((*s >= '0' && *s <= '9') || *s == '.' ||
+				*s == '-' || *s == '+') {
+			char *e;
+			const char *u;
+
+			t[n].v = strtof(s, &e);
+			if (e == s)
+				return -1;
+			u = e;
+			while (e < end && *e != ' ' && *e != ',' && *e != '/')
+				e++;
+			if (u == e) {
+				t[n].kind = TOK_LEN;	/* a zero */
+				t[n].unit = CSS_UNIT_PX;
+			} else if (*u == '%' && e == u + 1) {
+				t[n].kind = TOK_PCT;
+			} else if (shape_unit(u, (size_t) (e - u),
+					&t[n].unit)) {
+				t[n].kind = TOK_LEN;
+			} else {
+				return -1;
+			}
+			n++;
+			s = e;
+		} else {
+			size_t l = 0;
+
+			while (s < end && *s != ' ' && *s != ',' &&
+					*s != '/') {
+				if (l + 1 < sizeof(t[n].word))
+					t[n].word[l++] = *s;
+				s++;
+			}
+			t[n].word[l] = '\0';
+			t[n++].kind = TOK_WORD;
+		}
+	}
+	return n;
+}
+
+/** What to resolve lengths with. */
+struct shape_ctx {
+	const css_computed_style *style;
+	const css_unit_ctx *unit_ctx;
+};
+
+/** A length or percentage in pixels, a percentage of basis. */
+static bool shape_px(const struct shape_ctx *c, const struct shape_tok *t,
+		float basis, float *px)
+{
+	if (t->kind == TOK_PCT) {
+		*px = basis * t->v / 100;
+		return true;
+	}
+	if (t->kind != TOK_LEN)
+		return false;
+	*px = FIXTOFLT(css_unit_len2device_px(c->style, c->unit_ctx,
+			FLTTOFIX(t->v), t->unit));
+	return true;
+}
+
+static bool shape_word(const struct shape_tok *t, const char *w)
+{
+	return t->kind == TOK_WORD && strcasecmp(t->word, w) == 0;
+}
+
+/** Which way a position keyword points: 'x', 'y', 'c' for center. */
+static char shape_side(const struct shape_tok *t, bool *far)
+{
+	*far = shape_word(t, "right") || shape_word(t, "bottom");
+	if (shape_word(t, "left") || shape_word(t, "right"))
+		return 'x';
+	if (shape_word(t, "top") || shape_word(t, "bottom"))
+		return 'y';
+	if (shape_word(t, "center"))
+		return 'c';
+	return 0;
+}
+
+/**
+ * A <position>, the tokens from *i to the end, within a w by h box:
+ * one or two values, keywords in either order; or three or four, each
+ * keyword with an offset from its side.
+ */
+static bool shape_position(const struct shape_ctx *c,
+		const struct shape_tok *t, int n, int *i, float w, float h,
+		float *x, float *y)
+{
+	const struct shape_tok *v = &t[*i];
+	int count = n - *i, k;
+	bool far;
+
+	*x = w / 2;
+	*y = h / 2;
+	if (count < 1 || count > 4)
+		return false;
+	if (count <= 2) {
+		const struct shape_tok *a = &v[0];
+		const struct shape_tok *b = count == 2 ? &v[1] : NULL;
+		char sa = shape_side(a, &far);
+
+		/* a vertical keyword first, or a horizontal one second,
+		 * is the other way round */
+		if (b != NULL) {
+			char sb = shape_side(b, &far);
+
+			if (sa == 'y' || sb == 'x') {
+				const struct shape_tok *tmp = a;
+
+				a = b;
+				b = tmp;
+			}
+		} else if (sa == 'y') {
+			b = a;
+			a = NULL;
+		}
+		if (a != NULL) {
+			sa = shape_side(a, &far);
+			if (sa == 'x')
+				*x = far ? w : 0;
+			else if (sa != 'c' && !shape_px(c, a, w, x))
+				return false;
+		}
+		if (b != NULL) {
+			char sb = shape_side(b, &far);
+
+			if (sb == 'y')
+				*y = far ? h : 0;
+			else if (sb != 'c' && !shape_px(c, b, h, y))
+				return false;
+		}
+		*i = n;
+		return true;
+	}
+	for (k = 0; k < count; k++) {
+		char side = shape_side(&v[k], &far);
+		float off = 0;
+
+		if (side == 0)
+			return false;
+		if (k + 1 < count && (v[k + 1].kind == TOK_LEN ||
+				v[k + 1].kind == TOK_PCT)) {
+			if (!shape_px(c, &v[k + 1], side == 'y' ? h : w, &off))
+				return false;
+			k++;
+		}
+		if (side == 'x')
+			*x = far ? w - off : off;
+		else if (side == 'y')
+			*y = far ? h - off : off;
+	}
+	*i = n;
+	return true;
+}
+
+/** One radius of circle() or ellipse(), from the centre to the sides. */
+static bool shape_radius(const struct shape_ctx *c, const struct shape_tok *t,
+		float basis, float near, float far, float *r)
+{
+	if (shape_word(t, "closest-side")) {
+		*r = near;
+		return true;
+	}
+	if (shape_word(t, "farthest-side")) {
+		*r = far;
+		return true;
+	}
+	return shape_px(c, t, basis, r);
+}
+
+/** Four lengths, as margin's shorthand gives them. */
+static int shape_four(const struct shape_ctx *c, const struct shape_tok *t,
+		int n, int i, float w, float h, float v[4])
+{
+	float got[4];
+	int k = 0;
+
+	while (k < 4 && i + k < n && (t[i + k].kind == TOK_LEN ||
+			t[i + k].kind == TOK_PCT)) {
+		shape_px(c, &t[i + k], (k % 2) ? w : h, &got[k]);
+		k++;
+	}
+	if (k == 0)
+		return 0;
+	v[0] = got[0];
+	v[1] = k > 1 ? got[1] : got[0];
+	v[2] = k > 2 ? got[2] : got[0];
+	v[3] = k > 3 ? got[3] : v[1];
+	return k;
+}
+
+/** The basic shape's text in rx0..ry1, the reference box. */
+static bool shape_read(struct box_float_shape *s, const struct shape_ctx *c,
+		const char *text, size_t len, float rx0, float ry0, float rx1,
+		float ry1)
+{
+	struct shape_tok t[SHAPE_TOKS_MAX];
+	const char *open = memchr(text, '(', len);
+	float w = rx1 - rx0, h = ry1 - ry0;
+	int n, i = 0;
+
+	if (open == NULL || text[len - 1] != ')')
+		return false;
+	n = shape_tokens(open + 1, text + len - 1, t, SHAPE_TOKS_MAX);
+	if (n < 0)
+		return false;
+
+	if (strncmp(text, "circle(", 7) == 0 ||
+			strncmp(text, "ellipse(", 8) == 0) {
+		bool circle = text[0] == 'c';
+		const struct shape_tok *r[2] = { NULL, NULL };
+		float cx = w / 2, cy = h / 2, rx, ry;
+
+		while (i < n && i < (circle ? 1 : 2) &&
+				!shape_word(&t[i], "at")) {
+			r[i] = &t[i];
+			i++;
+		}
+		if (i < n && shape_word(&t[i], "at")) {
+			i++;
+			if (!shape_position(c, t, n, &i, w, h, &cx, &cy))
+				return false;
+		}
+		if (circle) {
+			float near = fminf(fminf(cx, w - cx), fminf(cy, h - cy));
+			float far = fmaxf(fmaxf(cx, w - cx), fmaxf(cy, h - cy));
+
+			rx = near;
+			if (r[0] != NULL && !shape_radius(c, r[0],
+					sqrtf(w * w + h * h) / sqrtf(2),
+					near, far, &rx))
+				return false;
+			ry = rx;
+		} else {
+			rx = fminf(cx, w - cx);
+			ry = fminf(cy, h - cy);
+			if (r[0] != NULL && !shape_radius(c, r[0], w,
+					fminf(cx, w - cx), fmaxf(cx, w - cx),
+					&rx))
+				return false;
+			if (r[1] != NULL && !shape_radius(c, r[1], h,
+					fminf(cy, h - cy), fmaxf(cy, h - cy),
+					&ry))
+				return false;
+		}
+		s->kind = SHAPE_ELLIPSE;
+		s->x0 = rx0 + cx - rx;
+		s->x1 = rx0 + cx + rx;
+		s->y0 = ry0 + cy - ry;
+		s->y1 = ry0 + cy + ry;
+		return rx >= 0 && ry >= 0;
+	}
+	if (strncmp(text, "inset(", 6) == 0) {
+		float v[4];
+
+		if (shape_four(c, t, n, 0, w, h, v) == 0)
+			return false;
+		s->kind = SHAPE_RECT;
+		s->x0 = rx0 + v[3];
+		s->y0 = ry0 + v[0];
+		s->x1 = rx1 - v[1];
+		s->y1 = ry1 - v[2];
+		return true;
+	}
+	if (strncmp(text, "xywh(", 5) == 0) {
+		float v[4];
+
+		if (n < 4 || !shape_px(c, &t[0], w, &v[0]) ||
+				!shape_px(c, &t[1], h, &v[1]) ||
+				!shape_px(c, &t[2], w, &v[2]) ||
+				!shape_px(c, &t[3], h, &v[3]))
+			return false;
+		s->kind = SHAPE_RECT;
+		s->x0 = rx0 + v[0];
+		s->y0 = ry0 + v[1];
+		s->x1 = s->x0 + v[2];
+		s->y1 = s->y0 + v[3];
+		return true;
+	}
+	if (strncmp(text, "rect(", 5) == 0) {
+		float v[4] = { 0, w, h, 0 };
+		int k;
+
+		for (k = 0; k < 4 && k < n; k++) {
+			if (!shape_word(&t[k], "auto") &&
+					!shape_px(c, &t[k], (k % 2) ? w : h,
+						&v[k]))
+				return false;
+		}
+		s->kind = SHAPE_RECT;
+		s->x0 = rx0 + v[3];
+		s->y0 = ry0 + v[0];
+		s->x1 = rx0 + v[1];
+		s->y1 = ry0 + v[2];
+		return true;
+	}
+	if (strncmp(text, "polygon(", 8) == 0) {
+		if (i < n && (shape_word(&t[i], "nonzero") ||
+				shape_word(&t[i], "evenodd")))
+			i += 2;
+		s->kind = SHAPE_POLYGON;
+		s->n = 0;
+		while (i + 1 < n && s->n < SHAPE_POINTS_MAX) {
+			float px, py;
+
+			if (!shape_px(c, &t[i], w, &px) ||
+					!shape_px(c, &t[i + 1], h, &py))
+				return false;
+			s->pts[2 * s->n] = rx0 + px;
+			s->pts[2 * s->n + 1] = ry0 + py;
+			s->n++;
+			i += 2;
+			if (i < n && t[i].kind == TOK_COMMA)
+				i++;
+		}
+		return s->n >= 3;
+	}
+	return false;
+}
+
+/* exported interface documented in html/layout_shape.h */
+void layout_float_shape(struct box *fl, const struct box *d,
+		const css_unit_ctx *unit_ctx)
+{
+	struct box_float_shape *s;
+	struct shape_ctx c;
+	lwc_string *str = NULL;
+	css_fixed margin = 0;
+	css_unit munit = CSS_UNIT_PX;
+	const char *text, *bar;
+	size_t len;
+	float rx0, ry0, rx1, ry1;
+
+	talloc_free(fl->float_shape);
+	fl->float_shape = NULL;
+	if (d == NULL || d->style == NULL ||
+			css_computed_shape_outside(d->style, &str) !=
+			CSS_SHAPE_OUTSIDE_SET || str == NULL)
+		return;
+	text = lwc_string_data(str);
+	len = lwc_string_length(str);
+	bar = memchr(text, '|', len);
+	if (bar == NULL || strncmp(text, "image|", 6) == 0 ||
+			strncmp(text, "url(", 4) == 0)
+		return;
+
+	/* the reference box: margin-box unless the value says */
+	rx0 = 0;
+	ry0 = 0;
+	rx1 = fl->width;
+	ry1 = fl->height;
+	if (strcmp(bar + 1, "margin-box") != 0 && bar[1] != '\0') {
+		rx0 += d->margin[LEFT];
+		ry0 += d->margin[TOP];
+		rx1 -= d->margin[RIGHT];
+		ry1 -= d->margin[BOTTOM];
+		if (strcmp(bar + 1, "border-box") != 0) {
+			rx0 += d->border[LEFT].width;
+			ry0 += d->border[TOP].width;
+			rx1 -= d->border[RIGHT].width;
+			ry1 -= d->border[BOTTOM].width;
+		}
+		if (strcmp(bar + 1, "content-box") == 0) {
+			rx0 += d->padding[LEFT];
+			ry0 += d->padding[TOP];
+			rx1 -= d->padding[RIGHT];
+			ry1 -= d->padding[BOTTOM];
+		}
+	}
+
+	s = talloc_zero(fl, struct box_float_shape);
+	if (s == NULL)
+		return;
+	c.style = d->style;
+	c.unit_ctx = unit_ctx;
+	if (bar == text) {
+		/* a box alone */
+		s->kind = SHAPE_RECT;
+		s->x0 = rx0;
+		s->y0 = ry0;
+		s->x1 = rx1;
+		s->y1 = ry1;
+	} else if (!shape_read(s, &c, text, (size_t) (bar - text),
+			rx0, ry0, rx1, ry1)) {
+		talloc_free(s);
+		return;
+	}
+	if (css_computed_shape_margin(d->style, &margin, &munit) ==
+			CSS_SHAPE_MARGIN_SET) {
+		if (munit == CSS_UNIT_PCT)
+			s->margin = (rx1 - rx0) * FIXTOFLT(margin) / 100;
+		else
+			s->margin = FIXTOFLT(css_unit_len2device_px(d->style,
+					unit_ctx, margin, munit));
+		if (s->margin < 0)
+			s->margin = 0;
+	}
+	s->width = fl->width;
+	s->height = fl->height;
+	fl->float_shape = s;
+}
+
+/** How far right (or left) an ellipse reaches between rows a and b. */
+static bool ellipse_reach(const struct box_float_shape *s, float a, float b,
+		bool right, float *edge)
+{
+	float cx = (s->x0 + s->x1) / 2, cy = (s->y0 + s->y1) / 2;
+	float rx = (s->x1 - s->x0) / 2 + s->margin;
+	float ry = (s->y1 - s->y0) / 2 + s->margin;
+	float d, f;
+
+	if (rx <= 0 || ry <= 0 || b < cy - ry || a > cy + ry)
+		return false;
+	d = (cy >= a && cy <= b) ? 0 : fminf(fabsf(cy - a), fabsf(cy - b));
+	f = 1 - (d / ry) * (d / ry);
+	f = f > 0 ? sqrtf(f) : 0;
+	*edge = right ? cx + rx * f : cx - rx * f;
+	return true;
+}
+
+/** How far right (or left) a polygon reaches between rows a and b. */
+static bool polygon_reach(const struct box_float_shape *s, float a, float b,
+		bool right, float *edge)
+{
+	bool any = false;
+	float best = 0;
+	int i;
+
+	a -= s->margin;
+	b += s->margin;
+	for (i = 0; i < s->n; i++) {
+		float x0 = s->pts[2 * i], y0 = s->pts[2 * i + 1];
+		float x1 = s->pts[2 * ((i + 1) % s->n)];
+		float y1 = s->pts[2 * ((i + 1) % s->n) + 1];
+		float lo = fmaxf(fminf(y0, y1), a), hi = fminf(fmaxf(y0, y1), b);
+		float xa, xb;
+
+		if (lo > hi)
+			continue;
+		if (y1 == y0) {
+			xa = x0;
+			xb = x1;
+		} else {
+			xa = x0 + (x1 - x0) * (lo - y0) / (y1 - y0);
+			xb = x0 + (x1 - x0) * (hi - y0) / (y1 - y0);
+		}
+		if (right) {
+			float m = fmaxf(xa, xb);
+
+			if (!any || m > best)
+				best = m;
+		} else {
+			float m = fminf(xa, xb);
+
+			if (!any || m < best)
+				best = m;
+		}
+		any = true;
+	}
+	if (!any)
+		return false;
+	*edge = right ? best + s->margin : best - s->margin;
+	return true;
+}
+
+/* exported interface documented in html/layout_shape.h */
+bool layout_float_shape_edge(const struct box *fl, int y0, int y1, int *edge)
+{
+	const struct box_float_shape *s = fl->float_shape;
+	bool right = fl->type == BOX_FLOAT_LEFT;
+	float a = (float) (y0 - fl->y), b = (float) (y1 - fl->y), e = 0;
+	bool hit;
+
+	if (s == NULL) {
+		*edge = right ? fl->x + fl->width : fl->x;
+		return true;
+	}
+	if (b < a)
+		b = a;
+	switch (s->kind) {
+	case SHAPE_ELLIPSE:
+		hit = ellipse_reach(s, a, b, right, &e);
+		break;
+	case SHAPE_POLYGON:
+		hit = polygon_reach(s, a, b, right, &e);
+		break;
+	default:
+		hit = b >= s->y0 - s->margin && a <= s->y1 + s->margin &&
+				s->x1 > s->x0;
+		e = right ? s->x1 + s->margin : s->x0 - s->margin;
+		break;
+	}
+	if (!hit)
+		return false;
+	/* clipped to the margin box */
+	if (e < 0)
+		e = 0;
+	if (e > s->width)
+		e = s->width;
+	if (right && e <= 0)
+		return false;
+	if (!right && e >= s->width)
+		return false;
+	*edge = fl->x + (int) (right ? ceilf(e) : floorf(e));
+	return true;
+}
