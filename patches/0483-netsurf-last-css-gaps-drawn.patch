diff --git a/frontends/framebuffer/scale_smooth.h b/frontends/framebuffer/scale_smooth.h
new file mode 100644
index 000000000..290d48336
--- /dev/null
+++ b/frontends/framebuffer/scale_smooth.h
@@ -0,0 +1,153 @@
