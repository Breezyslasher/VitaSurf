+/**
+ * A glyph's height above the baseline or its advance, in font units
+ * (VitaSurf), for a metric the font's tables do not give.
+ */
+static int fb_glyph_units(FT_Face face, uint32_t ucs4, bool advance)
+{
+	FT_UInt g = FT_Get_Char_Index(face, ucs4);
+
+	if (g == 0 || FT_Load_Glyph(face, g, FT_LOAD_NO_SCALE) != 0)
+		return 0;
+	return (int) (advance ? face->glyph->metrics.horiAdvance :
+			face->glyph->metrics.horiBearingY);
+}
+
+/**
+ * One of font-size-adjust's metrics over the em (VitaSurf): the x
+ * height and cap height from the OS/2 table, or else measured from
+ * "x" and "H"; the advance of "0"; and the advance and height of the
+ * water ideograph, else the em.
+ */
+static nserror fb_font_aspect(const plot_font_style_t *fstyle, int metric,
+		float *aspect)
+{
+	FTC_ScalerRec srec;
+	fb_faceid_t *fb_face;
+	FT_Face face;
+	TT_OS2 *os2;
+	int units = 0;
+
+	if (metric < 0 || metric > 4)
+		return NSERROR_BAD_PARAMETER;
+	fb_fill_scalar(fstyle, &srec);
+	fb_face = (fb_faceid_t *) srec.face_id;
+	if (fb_face->aspect_known & (1 << metric)) {
+		*aspect = fb_face->aspect[metric];
+		return *aspect > 0 ? NSERROR_OK : NSERROR_NOT_FOUND;
+	}
+	if (FTC_Manager_LookupFace(ft_cmanager, srec.face_id, &face) != 0 ||
+			face->units_per_EM == 0)
+		return NSERROR_NOT_FOUND;
+	os2 = (TT_OS2 *) FT_Get_Sfnt_Table(face, FT_SFNT_OS2);
+	switch (metric) {
+	case 0:
+		if (os2 != NULL && os2->version >= 2 && os2->sxHeight > 0)
+			units = os2->sxHeight;
+		else
+			units = fb_glyph_units(face, 'x', false);
+		break;
+	case 1:
+		if (os2 != NULL && os2->version >= 2 && os2->sCapHeight > 0)
+			units = os2->sCapHeight;
+		else
+			units = fb_glyph_units(face, 'H', false);
+		break;
+	case 2:
+		units = fb_glyph_units(face, '0', true);
+		break;
+	default:
+		units = fb_glyph_units(face, 0x6c34, metric == 3);
+		if (units <= 0)
+			units = face->units_per_EM;
+		break;
+	}
+	fb_face->aspect[metric] = units > 0 ?
+			(float) units / face->units_per_EM : 0;
+	fb_face->aspect_known |= (uint8_t) (1 << metric);
+	*aspect = fb_face->aspect[metric];
+	return *aspect > 0 ? NSERROR_OK : NSERROR_NOT_FOUND;
+}
