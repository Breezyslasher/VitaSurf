+/**
+ * Whether background-size leaves an axis auto (VitaSurf), as round on
+ * the other axis alone then scales it to keep the picture's shape.
+ */
+static bool html_background_size_auto(const struct box *box, bool x)
+{
+	css_fixed hl = 0, vl = 0;
+	css_unit hu = CSS_UNIT_PX, vu = CSS_UNIT_PX;
+	uint8_t type;
+
+	if (box->style == NULL)
+		return true;
+	type = css_computed_background_size(box->style, &hl, &hu, &vl, &vu);
+	if (type == CSS_BACKGROUND_SIZE_COVER ||
+			type == CSS_BACKGROUND_SIZE_CONTAIN)
+		return false;
+	if (type != CSS_BACKGROUND_SIZE_SET)
+		return true;
+	return (x ? hl : vl) == 0;
+}
+
+/**
+ * Whether image-rendering asks for an image scaled by nearest pixel
+ * (VitaSurf): pixelated and crisp-edges; auto, smooth and high-quality
+ * are scaled smooth.
+ */
+static bool html_pixelated(const css_computed_style *style)
+{
+	uint8_t r;
+
+	if (style == NULL)
+		return false;
+	r = css_computed_image_rendering(style);
+	return r == CSS_IMAGE_RENDERING_PIXELATED ||
+			r == CSS_IMAGE_RENDERING_CRISP_EDGES;
+}
