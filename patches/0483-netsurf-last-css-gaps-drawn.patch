+	kind = css_computed_text_emphasis_style(style, &str, &open, &shape);
+	if (kind == CSS_TEXT_EMPHASIS_STYLE_NONE || box->length == 0 ||
+			html->font_func == NULL)
+		return true;
+	if (kind == CSS_TEXT_EMPHASIS_STYLE_STRING) {
+		if (str == NULL || lwc_string_length(str) == 0)
+			return true;
+		mark = lwc_string_data(str);
+		/* its first character */
+		mark_len = utf8_next(mark, lwc_string_length(str), 0);
+	} else {
+		mark = marks[shape < 5 ? shape : 1][open ? 1 : 0];
+		mark_len = strlen(mark);
+	}
+
+	css_computed_text_emphasis_color(style, &colour);
+	if (nscss_color_is_transparent(colour))
+		return true;
+	mstyle.foreground = nscss_color_to_ns(colour);
+	mstyle.size = text_style->size / 2;
+	if (mstyle.size < 1)
+		mstyle.size = 1;
+	mstyle.flags &= ~FONTF_SMALLCAPS;
+	html->font_func->width(&mstyle, mark, mark_len, &mw);
