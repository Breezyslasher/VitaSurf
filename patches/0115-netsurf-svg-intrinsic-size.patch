 				width, height, c->source_size);*/
 	//c->size += ?;
+
+	/* The graphic's own size, which layout takes as the intrinsic
+	 * size of an <img> of it, comes from a parse with no viewport
+	 * (VitaSurf). It used to be whatever the last reformat parsed
+	 * at, so an <img> with only a height took its width from the
+	 * width of the box it had before the graphic arrived. */
+	svg_parse_at(svg, 0, 0);
+	c->width = svg->diagram->width;
+	c->height = svg->diagram->height;
+
 	content_set_ready(c);
 	content_set_done(c);
 	/* Done: update status bar */
