+/**
+ * Parse the graphic for a viewport (VitaSurf).
+ *
+ * The parse is what sizes a graphic with no width and height of its
+ * own, so it is redone for each viewport it is drawn into; the shapes
+ * of the last parse are dropped first, since svgtiny_parse appends to
+ * its diagram and the stale copies were drawn on every redraw and
+ * leaked memory.
+ */
+static bool svg_parse_at(svg_content *svg, int width, int height)
+{
+	struct content *c = &svg->base;
+	struct svgtiny_diagram *fresh;
+	const uint8_t *source_data;
+	size_t source_size;
+
+	fresh = svgtiny_create();
+	if (fresh == NULL) {
+		return false;
+	}
+	svgtiny_free(svg->diagram);
+	svg->diagram = fresh;
+
+	source_data = content__get_source_data(c, &source_size);
+
+	svgtiny_parse(svg->diagram,
+		      (const char *)source_data,
+		      source_size,
+		      nsurl_access(content_get_url(c)),
+		      width,
+		      height);
+
+	svg->current_width = width;
+	svg->current_height = height;
+	return true;
+}
+
+
