@@ -313,6 +313,13 @@ static inline dom_exception dom_node_get_attributes(struct dom_node *node,
 	return ((dom_node_vtable *) node->vtable)->dom_node_get_attributes(
 			(dom_node_internal *) node, result);
 }
+/**
+ * Whether a node was attached while its document was quiet, and so
+ * still owes the embedder the notice its attach would have given
+ * (VitaSurf). Answers once: the mark is cleared as it is read.
+ */
+bool dom_node_take_quiet(struct dom_node *node);
+
 #define dom_node_get_attributes(n, r) dom_node_get_attributes( \
 		(dom_node *) (n), (struct dom_namednodemap **) (r))
 
diff --git a/src/core/document.c b/src/core/document.c
index e8cbdd4..7671f6a 100644
--- a/src/core/document.c
+++ b/src/core/document.c
@@ -287,6 +287,7 @@ dom_exception _dom_document_initialise(dom_document *doc,
 	}
 
 	doc->dispatching_mutation = 0;
+	doc->quiet_mutations = 0;
 
 	/* We should not pass a NULL when all things hook up */
 	return _dom_document_event_internal_initialise(&doc->dei, daf, daf_ctx);
@@ -1555,3 +1556,14 @@ dom_exception _dom_document_set_quirks_mode(dom_document *doc,
 	doc->quirks = quirks;
 	return DOM_NO_ERR;
 }
+
+/* exported: see include/dom/core/document.h */
+void dom_document_quiet_mutations(struct dom_document *doc, int delta)
+{
+	if (doc == NULL)
+		return;
+	if (delta < 0 && doc->quiet_mutations < (uint32_t) -delta)
+		doc->quiet_mutations = 0;
+	else
+		doc->quiet_mutations += delta;
+}
diff --git a/src/core/document.h b/src/core/document.h
index 97dedec..ea0f3ed 100644
--- a/src/core/document.h
+++ b/src/core/document.h
@@ -72,6 +72,22 @@ struct dom_document {
 	dom_string *_memo_domsubtreemodified; /**< DOMSubtreeModified */
 
 	uint32_t dispatching_mutation; /**< Mutation event semaphore */
+
+	/*
+	 * While this is raised, attaching a node marks it quiet instead
+	 * of dispatching DOMNodeInserted and DOMSubtreeModified (VitaSurf).
+	 *
+	 * A deep clone appends every node of the copy one at a time, and
+	 * each append built two mutation events, ran them through the
+	 * whole capture and bubble path and into the embedder's default
+	 * action -- for a subtree nothing can observe, because it is not
+	 * in the document yet. A GitHub page clones a template of 1818
+	 * elements that way and it took 893 ms, half a millisecond a
+	 * node. The embedder is told about the nodes it was not told
+	 * about when the subtree does enter the document, through the
+	 * quiet flag on each of them.
+	 */
+	uint32_t quiet_mutations;
 };
 
