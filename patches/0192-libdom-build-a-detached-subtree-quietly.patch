@@ -136,6 +136,14 @@ static inline dom_exception dom_document_get_doctype(struct dom_document *doc,
 	return ((dom_document_vtable *) ((dom_node *) doc)->vtable)->
 			dom_document_get_doctype(doc, result);
 }
+/**
+ * Raise or lower the document's quiet count (VitaSurf). While it is
+ * raised, attaching a node marks it instead of dispatching mutation
+ * events; the embedder settles the marks when the subtree enters the
+ * document. Pair every +1 with a -1.
+ */
+void dom_document_quiet_mutations(struct dom_document *doc, int delta);
+
 #define dom_document_get_doctype(d, r) dom_document_get_doctype( \
 		(dom_document *) (d), (struct dom_document_type **) (r))
 
