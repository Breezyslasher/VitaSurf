+			if (dom_node_get_previous_sibling(at, &next) !=
+					DOM_NO_ERR)
+				next = NULL;
+			dom_node_unref(at);
+			at = next;
+		}
+		if (at != NULL)
+			dom_node_unref(at);
+	}
