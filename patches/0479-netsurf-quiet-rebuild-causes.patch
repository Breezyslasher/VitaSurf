+/**
+ * Whether new content in an element that is not displayed changes no
+ * boxes (VitaSurf): a script's text runs, a sheet's is parsed, a title
+ * is the window's, and each has handlers of its own that do it; a
+ * head's new children are those, or links and metadata, whose own
+ * handlers do the same, but for a <base>, which every link resolves
+ * against. Build 751's log gave "content that is more than boxes" as
+ * why eight rebuilds were made, 4.6 s in all.
+ */
+static bool rebuild_text_unshown(dom_node *n)
+{
+	static const char *const tags[] = {
+		"SCRIPT", "STYLE", "TITLE", "NOSCRIPT", "TEMPLATE", "HEAD",
+	};
+	dom_string *name = NULL, *ns = NULL;
+	dom_node *child = NULL, *next;
+	bool quiet = false, html;
+	size_t i;
+
+	if (dom_node_get_namespace(n, &ns) != DOM_NO_ERR || ns == NULL)
+		return false;
+	html = dom_string_isequal(ns, corestring_dom_html_namespace);
+	dom_string_unref(ns);
+	if (!html || dom_node_get_node_name(n, &name) != DOM_NO_ERR ||
+			name == NULL)
+		return false;
+	for (i = 0; i < sizeof(tags) / sizeof(tags[0]); i++) {
+		if (strcasecmp(dom_string_data(name), tags[i]) == 0) {
+			quiet = true;
+			break;
+		}
+	}
+	if (!quiet || strcasecmp(dom_string_data(name), "HEAD") != 0) {
+		dom_string_unref(name);
+		return quiet;
+	}
+	dom_string_unref(name);
+
+	if (dom_node_get_first_child(n, &child) != DOM_NO_ERR)
+		return false;
+	while (child != NULL && quiet) {
+		name = NULL;
+		if (dom_node_get_node_name(child, &name) == DOM_NO_ERR &&
+				name != NULL) {
+			if (strcasecmp(dom_string_data(name), "BASE") == 0)
+				quiet = false;
+			dom_string_unref(name);
+		}
+		next = NULL;
+		if (dom_node_get_next_sibling(child, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(child);
+		child = next;
+	}
+	if (child != NULL)
+		dom_node_unref(child);
+	return quiet;
+}
