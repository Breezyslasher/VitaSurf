+/**
+ * Where the :has() pseudo-classes are of the sheets a change reaches
+ * through :has() (VitaSurf): their css_has_shape bits together.
+ */
+static uint32_t html_reach_has_shape(html_content *c,
+		const struct html_reach_change *ch)
+{
+	uint32_t i, k, shape = 0;
+
+	for (i = 0; i < c->stylesheet_count; i++) {
+		struct hlcache_handle *h = c->stylesheets[i].sheet;
+		struct nscss_import *imports;
+		const css_stylesheet *s;
+		uint32_t ni = 0;
+
+		if (!dynamic_sheet_ready(h))
+			continue;
+		s = nscss_get_stylesheet(h);
+		if (html_reach_sheet_hit(s, CSS_REACH_HAS, ch))
+			shape |= css_stylesheet_has_shape(s);
+		imports = nscss_get_imports(h, &ni);
+		for (k = 0; k < ni; k++) {
+			if (!dynamic_sheet_ready(imports[k].c))
+				continue;
+			s = nscss_get_stylesheet(imports[k].c);
+			if (html_reach_sheet_hit(s, CSS_REACH_HAS, ch))
+				shape |= css_stylesheet_has_shape(s);
+		}
+	}
+	return shape;
