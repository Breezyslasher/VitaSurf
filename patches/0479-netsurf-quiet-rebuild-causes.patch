+/* exported interface documented in html/box_construct.h */
+bool box_child_quiet(html_content *c, dom_node *e, dom_node *child)
+{
+	struct box_construct_props props;
+	const css_computed_style *root_style, *style;
+	css_select_results *fresh;
+	dom_node *parent = NULL;
+	dom_node_type type;
+	bool in, none;
+
+	if (c->layout == NULL || box_for_node(e) == NULL ||
+			nscss_children_ordered(e) ||
+			dom_node_get_node_type(child, &type) != DOM_NO_ERR)
+		return false;
+	if (type == DOM_COMMENT_NODE ||
+			type == DOM_PROCESSING_INSTRUCTION_NODE)
+		return true;
+	if (type != DOM_ELEMENT_NODE)
+		return false;
+
+	if (dom_node_get_parent_node(child, &parent) != DOM_NO_ERR)
+		return false;
+	in = parent == e;
+	if (parent != NULL)
+		dom_node_unref(parent);
+	if (!in) {
+		/* taken out: nothing of it was drawn */
+		return box_for_node(child) == NULL;
+	}
+	if (box_for_node(child) != NULL)
+		return false;
+
+	/* put in: not drawn, and nothing else's style asks about it */
+	box_extract_properties(c, child, &props);
+	if (props.parent_style == NULL)
+		return false;
+	root_style = props.node_is_root ? NULL : c->layout->style;
+	nscss_clear_node_data(child);
+	fresh = box_get_style(c, props.parent_style, root_style, child);
+	if (fresh == NULL)
+		return false;
+	style = fresh->styles[CSS_PSEUDO_ELEMENT_NONE];
+	none = style != NULL && ns_computed_display(style,
+			props.node_is_root) == CSS_DISPLAY_NONE;
+	css_select_results_destroy(fresh);
+	return none;
+}
