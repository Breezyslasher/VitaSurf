+ * nothing holds the address it had, so nothing but its style can
+ * change, unless a box inside it does (display: contents), which the
+ * address it had finds. A carousel's hidden slides, and a menu's
+ * hidden links, had the whole page built again for each change.
+ */
+static bool html_relink_unboxed(html_content *c, dom_string *old)
+{
+	nsurl *was = NULL;
+	bool held;
+
+	if (old == NULL || !box_extract_link(c, old, c->base_url, &was))
+		return false;
+	if (was == NULL)
+		return false;
+	held = html_box_holds_href(c->layout, was);
+	nsurl_unref(was);
+	return !held;
