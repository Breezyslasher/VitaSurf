+/** Whether a box in a tree holds an address for following it. */
+static bool html_box_holds_href(struct box *b, nsurl *u)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->href != NULL && nsurl_compare(b->href, u,
+				NSURL_COMPLETE))
+			return true;
+		if (b->list_marker != NULL &&
+				html_box_holds_href(b->list_marker, u))
+			return true;
+		if (b->children != NULL && html_box_holds_href(b->children, u))
+			return true;
+	}
+	return false;
+}
