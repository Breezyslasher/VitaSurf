+/** Mark an element whose children's order or presence a selector reads. */
+static void mark_children_ordered(dom_node *n)
+{
+	void *old = NULL;
+
+	if (dom_node_get_user_data(n, corestring_dom___ns_key_children_ordered,
+			&old) == DOM_NO_ERR && old != NULL)
+		return;
+	dom_node_set_user_data(n, corestring_dom___ns_key_children_ordered,
+			(void *) 1, NULL, &old);
+}
+
+/*
+ * A selector looked at a node's place among its siblings, or at its
+ * children (VitaSurf): the element whose children those are is marked,
+ * so that a child put into it or taken out is known to restyle more
+ * than itself (nscss_children_ordered). The mark stays with the element.
+ */
+static void note_order(void *pw, void *node, bool children)
+{
+	dom_node *n = node, *parent = NULL;
+	dom_node_type type;
+
+	(void)pw;
+	if (children) {
+		mark_children_ordered(n);
+		return;
+	}
+	if (dom_node_get_parent_node(n, &parent) != DOM_NO_ERR ||
+			parent == NULL)
+		return;
+	if (dom_node_get_node_type(parent, &type) == DOM_NO_ERR &&
+			type == DOM_ELEMENT_NODE)
+		mark_children_ordered(parent);
+	dom_node_unref(parent);
+}
+
+/* exported function documented in css/select.h */
+bool nscss_children_ordered(dom_node *n)
+{
+	void *mark = NULL;
+
+	return dom_node_get_user_data(n,
+			corestring_dom___ns_key_children_ordered, &mark) !=
+			DOM_NO_ERR || mark != NULL;
+}
