+	if (sibling) {
+		if (dom_node_get_previous_sibling(n, &at) != DOM_NO_ERR)
+			return BOX_RESTYLE_LAYOUT;
+		while (at != NULL && result != BOX_RESTYLE_LAYOUT) {
+			if (dom_node_get_node_type(at, &type) == DOM_NO_ERR &&
+					type == DOM_ELEMENT_NODE) {
