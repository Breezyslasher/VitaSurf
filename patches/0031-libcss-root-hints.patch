+uint32_t css__n_root_hints;
+uint32_t css__root_hints_sig;
+
+static void css__clear_root_hints(void)
+{
+	uint32_t i;
+
+	for (i = 0; i < css__n_root_hints; i++) {
+		lwc_string_unref(css__root_hints[i].name);
+		lwc_string_unref(css__root_hints[i].value);
+	}
+	free(css__root_hints);
+	css__root_hints = NULL;
+	css__n_root_hints = 0;
+	if (css__root_hint_element != NULL) {
+		lwc_string_unref(css__root_hint_element);
+		css__root_hint_element = NULL;
+	}
+	css__root_hints_sig = 0;
+}
+
+/** FNV-1a over one string, folded into a running signature. */
+static uint32_t css__hint_hash(uint32_t h, const char *s)
+{
+	while (*s != '\0') {
+		h ^= (uint32_t) (unsigned char) *s++;
+		h *= 0x01000193u;
+	}
+	/* A separator, so ("ab","c") and ("a","bc") differ. */
+	h ^= 0xffu;
+	h *= 0x01000193u;
+	return h;
+}
+
+/** Intern a string, lowercasing ASCII letters if asked. */
+static lwc_string *css__intern_hint(const char *s, bool lower)
+{
+	lwc_string *out = NULL;
+	size_t len = strlen(s);
+	char *buf;
+	size_t i;
+
+	/* Hints are set once per document, so a copy costs nothing here. */
+	if (lower == false || len == 0) {
+		if (lwc_intern_string(s, len, &out) != lwc_error_ok)
+			return NULL;
+		return out;
+	}
+
+	buf = malloc(len);
+	if (buf == NULL)
+		return NULL;
+	for (i = 0; i < len; i++) {
+		char c = s[i];
+		buf[i] = ('A' <= c && c <= 'Z') ? (char) (c + 'a' - 'A') : c;
+	}
+	if (lwc_intern_string(buf, len, &out) != lwc_error_ok)
+		out = NULL;
+	free(buf);
+	return out;
+}
