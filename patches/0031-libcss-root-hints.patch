+/**
+ * A value identifying the hints currently set (VitaSurf).
+ *
+ * Equal signatures mean equal hints, so a sheet parsed under one can be
+ * reused under the other. Zero means no hints are set.
+ */
+uint32_t css_root_hints_signature(void);
+
+/**
+ * The root hints this sheet's parse depended on (VitaSurf).
+ *
+ * Zero means it never consulted them, so the sheet parses the same for
+ * any document and a cache is free to hand it to another one. Anything
+ * else must be compared with css_root_hints_signature() before reuse:
+ * the same sheet under a different theme is a different sheet.
+ */
+css_error css_stylesheet_used_root_hints(css_stylesheet *sheet,
+		uint32_t *sig);
+
