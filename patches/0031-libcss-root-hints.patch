+	}
+
+	css__root_hint_element = css__intern_hint(element, true);
+	if (css__root_hint_element == NULL)
+		return CSS_NOMEM;
+	sig = css__hint_hash(sig, element);
+
+	if (n_attrs > 0) {
+		css__root_hints = calloc(n_attrs, sizeof(*css__root_hints));
+		if (css__root_hints == NULL) {
+			css__clear_root_hints();
+			return CSS_NOMEM;
+		}
+	}
+	for (i = 0; i < n_attrs; i++) {
+		if (attrs[i].name == NULL || attrs[i].value == NULL)
+			continue;
+		css__root_hints[css__n_root_hints].name =
+				css__intern_hint(attrs[i].name, true);
+		css__root_hints[css__n_root_hints].value =
+				css__intern_hint(attrs[i].value, false);
+		if (css__root_hints[css__n_root_hints].name == NULL ||
+		    css__root_hints[css__n_root_hints].value == NULL) {
+			if (css__root_hints[css__n_root_hints].name != NULL)
+				lwc_string_unref(css__root_hints[
+						css__n_root_hints].name);
+			if (css__root_hints[css__n_root_hints].value != NULL)
+				lwc_string_unref(css__root_hints[
+						css__n_root_hints].value);
+			css__clear_root_hints();
+			return CSS_NOMEM;
+		}
+		css__n_root_hints++;
+		sig = css__hint_hash(sig, attrs[i].name);
+		sig = css__hint_hash(sig, attrs[i].value);
+	}
+
+	/* Zero means "no hints", so never let a real set land on it. */
+	css__root_hints_sig = sig != 0 ? sig : 1;
+
+	if (css__root_hints_sig != old_sig)
+		css__free_custom_props();
+
+	return CSS_OK;
+}
+
+/* exported interface documented in libcss/stylesheet.h */
+uint32_t css_root_hints_signature(void)
+{
+	return css__root_hints_sig;
+}
+
+/* exported interface documented in libcss/stylesheet.h */
+css_error css_stylesheet_used_root_hints(css_stylesheet *sheet, uint32_t *sig)
+{
+	if (sheet == NULL || sig == NULL)
+		return CSS_BADPARM;
+
+	*sig = sheet->used_root_hints;
+
+	return CSS_OK;
+}
