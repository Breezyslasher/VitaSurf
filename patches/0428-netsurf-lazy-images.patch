+/*
+ * Lazy images (VitaSurf). An <img loading=lazy> is asked for once it
+ * comes within LAZY_MARGIN of the rows a redraw showed, as Chrome asks
+ * at 1250 px on a fast network, and the page's load does not wait for
+ * one not yet asked for. Every image had been fetched as its box was
+ * made: cnn.com's carousels asked for two hundred at once, most of them
+ * far below the screen, and the page's own images queued behind them
+ * for half a minute.
+ */
+#define LAZY_MARGIN 1250
+
+/** Ask for one lazy image now. */
+static void html_object_lazy_start(html_content *c,
+				   struct content_html_object *o)
+{
+	hlcache_child_context child;
+	nsurl *url = o->lazy_url;
+	nserror error;
+
+	o->lazy_url = NULL;
+	if (c->lazy_pending > 0)
+		c->lazy_pending--;
+	child.charset = c->encoding;
+	child.quirks = c->base.quirks;
+	error = hlcache_handle_retrieve(url, HLCACHE_RETRIEVE_SNIFF_TYPE,
+			content_get_url(&c->base), NULL,
+			html_object_callback, o, &child,
+			o->permitted_types, &o->content);
+	nsurl_unref(url);
+	if (error != NSERROR_OK) {
+		o->content = NULL;
+		return;
+	}
+	if (o->permitted_types & CONTENT_IMAGE)
+		vitasurf_images_asked++;
+	c->base.active++;
+}
+
+static void html_object_lazy_check(void *p)
+{
+	html_content *c = p;
+	struct content_html_object *o;
+	int top = c->lazy_top - LAZY_MARGIN;
+	int bottom = c->lazy_bottom + LAZY_MARGIN;
+
+	c->lazy_sched = false;
+	if (c->lazy_pending == 0 || c->layout == NULL || c->aborted)
+		return;
+	for (o = c->object_list; o != NULL && c->lazy_pending > 0;
+	     o = o->next) {
+		int x, y, h;
+
+		if (o->lazy_url == NULL || o->box == NULL)
+			continue;
+		box_coords(o->box, &x, &y);
+		h = o->box->padding[TOP] + o->box->height +
+			o->box->padding[BOTTOM] + o->box->border[TOP].width +
+			o->box->border[BOTTOM].width;
+		if (y + h >= top && y <= bottom)
+			html_object_lazy_start(c, o);
+	}
+}
+
+/* exported interface documented in html/object.h */
+void html_object_lazy_seen(html_content *html, int top, int bottom)
+{
+	html->lazy_top = top;
+	html->lazy_bottom = bottom;
+	if (html->lazy_pending == 0 || html->lazy_sched)
+		return;
+	html->lazy_sched = true;
+	guit->misc->schedule(0, html_object_lazy_check, html);
+}
