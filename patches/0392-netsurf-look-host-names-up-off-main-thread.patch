 		struct curl_fetch_info **pp, *prev = NULL;
 
@@ -1643,6 +1826,11 @@ static void fetch_curl_free(void *vf)
 	if (f->headers) {
 		curl_slist_free_all(f->headers);
 	}
+#ifdef FETCH_CURL_RESOLVE
+	if (f->resolve) {
