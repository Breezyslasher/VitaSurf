+#endif
 		codem = curl_multi_remove_handle(fetch_curl_multi,
 				f->curl_handle);
 		assert(codem == CURLM_OK);
@@ -1617,6 +1795,11 @@ static void fetch_curl_free(void *vf)
 	int i;
 
 	fetch_curl_drop_held(f);
