+#ifdef FETCH_CURL_RESOLVE
+/*
+ * Looking host names up off the main thread (VitaSurf).
+ *
+ * curl is built without its threaded resolver, so it looked each new
+ * host up inside curl_multi_perform and the browser stopped until the
+ * answer came: on claude.ai a Cloudflare host that never answered held
+ * everything for 32 s, from inside a script that was keeping transfers
+ * moving. A fetch to a host name now waits on vita_resolve, which looks
+ * it up on a thread of its own, and goes to curl with the address in
+ * CURLOPT_RESOLVE, so curl finds it in its DNS cache and never asks. The
+ * fetch holds its place in the fetch ring while it waits, so the queue
+ * and the poll treat it as the transfer it is about to be.
+ */
+
+/** Whether curl would look this fetch's host up, rather than connect to
+ * an address or a proxy. */
+static bool fetch_curl_resolve_wanted(struct curl_fetch_info *f)
+{
+	const char *host = lwc_string_data(f->host);
+	size_t len = lwc_string_length(f->host);
+
+	if (len == 0 || host[0] == '[' ||
+	    strspn(host, "0123456789.") == len ||
+	    strcasecmp(host, "localhost") == 0) {
+		return false;
+	}
+	/* through a proxy, curl looks up the proxy's name, not this */
+	if (nsoption_bool(http_proxy) &&
+	    nsoption_charp(http_proxy_host) != NULL) {
+		return false;
+	}
+	return true;
+}
+
+/**
+ * Give the fetch to curl if its host's address is known.
+ *
+ * 
+eturn 1 if curl has it now, 0 while the lookup goes on, -1 if the
+ *	   host has no address (fetch_error_buffer says why).
+ */
+static int fetch_curl_resolve_try(struct curl_fetch_info *f)
+{
+	const char *host = lwc_string_data(f->host);
+	char addrs[16], why[64], entry[300];
+	lwc_string *port;
+	long portnum;
+	CURLMcode codem;
+
+	switch (vita_resolve(host, addrs, sizeof addrs, why, sizeof why)) {
+	case VITA_RESOLVE_PENDING:
+		return 0;
+	case VITA_RESOLVE_FAILED:
+		snprintf(fetch_error_buffer, sizeof fetch_error_buffer,
+			 "Could not resolve host: %s (%s)", host, why);
+		return -1;
+	default:
+		break;
+	}
+	port = nsurl_get_component(f->url, NSURL_PORT);
+	if (port != NULL) {
+		portnum = strtol(lwc_string_data(port), NULL, 10);
+		lwc_string_unref(port);
+	} else {
+		portnum = nsurl_get_scheme_type(f->url) == NSURL_SCHEME_HTTPS ?
+			443 : 80;
+	}
+	/* "+" so that curl lets it go when its own DNS cache would */
+	snprintf(entry, sizeof entry, "+%s:%ld:%s", host, portnum, addrs);
+	f->resolve = curl_slist_append(NULL, entry);
+	if (f->resolve != NULL) {
+		curl_easy_setopt(f->curl_handle, CURLOPT_RESOLVE, f->resolve);
+	}
+	codem = curl_multi_add_handle(fetch_curl_multi, f->curl_handle);
+	assert(codem == CURLM_OK || codem == CURLM_CALL_MULTI_PERFORM);
+	f->outside_curl = false;
+	return 1;
+}
+
+/** Take a fetch off the resolving list. */
+static void fetch_curl_resolve_unlink(struct curl_fetch_info *f)
+{
+	struct curl_fetch_info **pp;
+
+	for (pp = &resolving_fetches; *pp != NULL; pp = &(*pp)->resolve_next) {
+		if (*pp == f) {
+			*pp = f->resolve_next;
+			break;
+		}
+	}
+	f->resolve_next = NULL;
+	f->resolving = false;
+}
+
+/**
+ * Hand curl the fetches whose hosts have addresses now. Only the poll
+ * may finish one whose host has none: that reaches the rest of NetSurf,
+ * which the pump must not.
+ */
+static void fetch_curl_resolve_poll(bool may_finish)
+{
+	struct curl_fetch_info **pp, *f;
+	int r;
+
+again:
+	pp = &resolving_fetches;
+	while ((f = *pp) != NULL) {
+		if (f->abort) {
+			/* aborted while the poll ran: nothing to tell */
+			fetch_curl_resolve_unlink(f);
+			fetch_curl_stop(f);
+			fetch_free(f->fetch_handle);
+			continue;
+		}
+		r = fetch_curl_resolve_try(f);
+		if (r == 0 || (r < 0 && !may_finish)) {
+			pp = &f->resolve_next;
+			continue;
+		}
+		fetch_curl_resolve_unlink(f);
+		if (r < 0) {
+			/* as curl would have said it; the callbacks this
+			 * makes may change the list, so start again */
+			fetch_curl_done(f->curl_handle,
+					CURLE_COULDNT_RESOLVE_HOST);
+			goto again;
+		}
+	}
+}
+#endif
+
 /**
