+#endif
 	fetch_curl_free_postdata(f->postdata);
 	NSCURL_POSTDATA_FREE(f->curl_postdata);
 
@@ -2002,6 +2190,9 @@ static void fetch_curl_poll(lwc_string *scheme_ignored)
 	/* first what arrived while a script ran, then the transfers that
 	 * ended then (VitaSurf) */
 	fetch_curl_flush_held();
+#ifdef FETCH_CURL_RESOLVE
+	fetch_curl_resolve_poll(true);
+#endif
 	while (done_fetches != NULL) {
 		struct curl_fetch_info *f = done_fetches;
 
@@ -2469,6 +2660,11 @@ bool fetch_curl_pump(void)
 	    curl_held_bytes >= CURL_HELD_MAX) {
 		return false;
 	}
+#ifdef FETCH_CURL_RESOLVE
+	/* a fetch whose host's address came while a script ran starts
+	 * now; one whose host has none waits for the poll to say so */
+	fetch_curl_resolve_poll(false);
+#endif
 	nsu_getmonotonic_ms(&t0);
 	inside_curl = true;
 	curl_holding = true;
