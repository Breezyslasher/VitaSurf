  *
@@ -1465,6 +1622,20 @@ fetch_curl_initiate_fetch(struct curl_fetch_info *fetch, CURL *handle)
 		return false;
 	}
 
+#ifdef FETCH_CURL_RESOLVE
+	/* curl has it once its host's address is known; nothing may be
+	 * said to the caller from here, so a failure waits for the poll */
+	if (fetch_curl_resolve_wanted(fetch)) {
+		fetch->outside_curl = true;
+		if (fetch_curl_resolve_try(fetch) != 1) {
+			fetch->resolving = true;
+			fetch->resolve_next = resolving_fetches;
+			resolving_fetches = fetch;
+		}
+		return true;
+	}
+#endif
+
 	/* add to the global curl multi handle */
 	codem = curl_multi_add_handle(fetch_curl_multi, fetch->curl_handle);
 	assert(codem == CURLM_OK || codem == CURLM_CALL_MULTI_PERFORM);
@@ -1572,6 +1743,13 @@ static void fetch_curl_stop(struct curl_fetch_info *f)
 
 	if (f->curl_handle) {
 		/* remove from curl multi handle */
