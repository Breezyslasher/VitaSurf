+/*
+ * An attribute name, interned once instead of once per test (VitaSurf).
+ *
+ * Every attribute selector libcss tries against an element arrives here
+ * with the same lwc_string, because libcss interns each name once per
+ * sheet, and each of the seven callbacks below used to build a fresh
+ * dom_string from it and throw it away again. A GitHub page offers 2738
+ * candidate rules to each of its 6270 elements and two thirds of the
+ * universal ones are keyed on an attribute, so that is millions of
+ * internings inside the 36 seconds the page spends selecting styles.
+ *
+ * The cache holds a reference to the lwc_string as well as to the
+ * dom_string it made, so a name that is freed cannot be replaced by a
+ * different one at the same address and read back as a hit. What it
+ * returns is borrowed: the cache owns it, and the callbacks must not
+ * drop it.
+ */
+#define QNAME_CACHE_SLOTS 128
+
+static struct {
+	lwc_string *key;
+	dom_string *name;
+} qname_cache[QNAME_CACHE_SLOTS];
+
+static dom_string *qname_interned(const css_qname *qname)
+{
+	uintptr_t bits = (uintptr_t) qname->name;
+	unsigned slot = (unsigned) ((bits >> 3) & (QNAME_CACHE_SLOTS - 1));
+	dom_exception err;
+	dom_string *name;
+
+	if (qname_cache[slot].key == qname->name) {
+		vitasurf_attr_interned_hits++;
+		return qname_cache[slot].name;
+	}
+
+	err = dom_string_create_interned(
+			(const uint8_t *) lwc_string_data(qname->name),
+			lwc_string_length(qname->name), &name);
+	if (err != DOM_NO_ERR) {
+		return NULL;
+	}
+
+	if (qname_cache[slot].name != NULL) {
+		dom_string_unref(qname_cache[slot].name);
+		lwc_string_unref(qname_cache[slot].key);
+	}
+	qname_cache[slot].key = lwc_string_ref(qname->name);
+	qname_cache[slot].name = name;
+	vitasurf_attr_interned_misses++;
+
+	return name;
+}
