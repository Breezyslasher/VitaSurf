+	dom_node *n = node;
+	dom_string *name;
+	dom_exception err;
 
 	*match = false;
 
+	err = dom_node_get_node_name(n, &name);
+	if (err != DOM_NO_ERR || name == NULL)
+		return CSS_OK;
+
+	if (dom_string_caseless_isequal(name, corestring_dom_input)) {
+		if (dom_element_has_attribute(n, corestring_dom_checked,
