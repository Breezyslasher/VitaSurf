+	} else if (dom_string_caseless_isequal(name, corestring_dom_option)) {
+		if (dom_element_has_attribute(n, corestring_dom_selected,
+				match) != DOM_NO_ERR)
+			*match = false;
+	}
+
+	dom_string_unref(name);
+
 	return CSS_OK;
 }
 
