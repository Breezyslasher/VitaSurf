+/**
+ * Find the first child element of a node (VitaSurf, for :has()).
+ *
+ * \param pw       Pointer to client-specific data (unused)
+ * \param node     DOM node
+ * \param child    Pointer to location to receive the child, or NULL
+ * \return CSS_OK.
+ *
+ * The reference is dropped straight away, the same as sibling_node:
+ * the document keeps every node alive for as long as selection runs.
+ */
+css_error first_child_node(void *pw, void *node, void **child)
+{
+	dom_node *n;
+	dom_exception err;
+
+	*child = NULL;
+
+	err = dom_node_get_first_child(node, &n);
+	if (err != DOM_NO_ERR || n == NULL)
+		return CSS_OK;
+
+	while (n != NULL) {
+		dom_node_type type;
+		dom_node *next;
+
+		err = dom_node_get_node_type(n, &type);
+		if (err != DOM_NO_ERR) {
+			dom_node_unref(n);
+			return CSS_OK;
+		}
+
+		if (type == DOM_ELEMENT_NODE)
+			break;
+
+		err = dom_node_get_next_sibling(n, &next);
+		if (err != DOM_NO_ERR) {
+			dom_node_unref(n);
+			return CSS_OK;
+		}
+
+		dom_node_unref(n);
+		n = next;
+	}
+
+	if (n != NULL) {
+		dom_node_unref(n);
+		*child = n;
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Find the next sibling element of a node (VitaSurf, for :has()).
+ *
+ * \param pw       Pointer to client-specific data (unused)
+ * \param node     DOM node
+ * \param sibling  Pointer to location to receive the sibling, or NULL
+ * \return CSS_OK.
+ */
+css_error next_sibling_node(void *pw, void *node, void **sibling)
+{
+	dom_node *n;
+	dom_exception err;
+
+	*sibling = NULL;
+
+	err = dom_node_get_next_sibling(node, &n);
+	if (err != DOM_NO_ERR || n == NULL)
+		return CSS_OK;
+
+	while (n != NULL) {
+		dom_node_type type;
+		dom_node *next;
+
+		err = dom_node_get_node_type(n, &type);
+		if (err != DOM_NO_ERR) {
+			dom_node_unref(n);
+			return CSS_OK;
+		}
+
+		if (type == DOM_ELEMENT_NODE)
+			break;
+
+		err = dom_node_get_next_sibling(n, &next);
+		if (err != DOM_NO_ERR) {
+			dom_node_unref(n);
+			return CSS_OK;
+		}
+
+		dom_node_unref(n);
+		n = next;
+	}
+
+	if (n != NULL) {
+		dom_node_unref(n);
+		*sibling = n;
+	}
+
+	return CSS_OK;
+}
