+/*
+ * Whether a key set has a key, and adding one (VitaSurf). Each test had
+ * read the whole set, so a sheet whose rules name a few thousand
+ * ancestor classes took a quadratic time to read: 5000 such rules spent
+ * two fifths of their parse here. Names are interned, so a key is found
+ * by its name's address and its kind.
+ */
+static uint32_t dyn_key_hash(uint32_t kind, const lwc_string *name)
+{
+	uint32_t h = (uint32_t) ((uintptr_t) name >> 3) ^ (kind * 0x9e3779b9u);
+
+	h ^= h >> 16;
+	h *= 0x85ebca6bu;
+	h ^= h >> 13;
+	return h;
+}
+
+static bool dyn_key_has(css_stylesheet *sheet, int set, uint32_t kind,
+		const lwc_string *name)
+{
+	uint32_t mask, at, j;
+
+	if (sheet->dynamic_keys[set].n_slots == 0) {
+		/* no index: a short set, or no memory for one */
+		for (j = 0; j < sheet->dynamic_keys[set].n; j++) {
+			if (sheet->dynamic_keys[set].keys[j].kind == kind &&
+					sheet->dynamic_keys[set].keys[j].name ==
+					name)
+				return true;
+		}
+		return false;
+	}
+	mask = sheet->dynamic_keys[set].n_slots - 1;
+	for (at = dyn_key_hash(kind, name) & mask;
+			sheet->dynamic_keys[set].slots[at] != 0;
+			at = (at + 1) & mask) {
+		const css_dynamic_key *k = &sheet->dynamic_keys[set].keys[
+				sheet->dynamic_keys[set].slots[at] - 1];
+
+		if (k->kind == kind && k->name == name)
+			return true;
+	}
+	return false;
+}
+
+/** File the set's last key in its index, growing it when half full. */
+static void dyn_key_index_last(css_stylesheet *sheet, int set)
+{
+	uint32_t n = sheet->dynamic_keys[set].n, mask, at, j;
+
+	if (n < 16 && sheet->dynamic_keys[set].n_slots == 0)
+		return;
+	if (n * 2 > sheet->dynamic_keys[set].n_slots) {
+		uint32_t want = sheet->dynamic_keys[set].n_slots ?
+				sheet->dynamic_keys[set].n_slots * 2 : 64;
+		uint32_t *fresh = calloc(want, sizeof(*fresh));
+
+		if (fresh == NULL) {
+			/* the search reads the whole set again */
+			free(sheet->dynamic_keys[set].slots);
+			sheet->dynamic_keys[set].slots = NULL;
+			sheet->dynamic_keys[set].n_slots = 0;
+			return;
+		}
+		free(sheet->dynamic_keys[set].slots);
+		sheet->dynamic_keys[set].slots = fresh;
+		sheet->dynamic_keys[set].n_slots = want;
+		mask = want - 1;
+		for (j = 0; j < n; j++) {
+			const css_dynamic_key *k =
+					&sheet->dynamic_keys[set].keys[j];
+
+			for (at = dyn_key_hash(k->kind, k->name) & mask;
+					fresh[at] != 0; at = (at + 1) & mask)
+				;
+			fresh[at] = j + 1;
+		}
+		return;
+	}
+	mask = sheet->dynamic_keys[set].n_slots - 1;
+	{
+		const css_dynamic_key *k = &sheet->dynamic_keys[set].keys[n - 1];
+
+		for (at = dyn_key_hash(k->kind, k->name) & mask;
+				sheet->dynamic_keys[set].slots[at] != 0;
+				at = (at + 1) & mask)
+			;
+		sheet->dynamic_keys[set].slots[at] = n;
+	}
+}
