+/**
+ * Add a node's name, id and classes to a bloom filter, as
+ * css__create_node_bloom does for the node selected.
+ */
+static css_error css__bloom_add_node(void *node,
+		css_select_handler *handler, void *pw, css_bloom *bloom)
+{
+	css_qname name = { NULL, NULL };
+	lwc_string *id = NULL;
+	lwc_string **classes = NULL;
+	uint32_t n_classes = 0, i;
+	lwc_hash hash;
+	css_error error;
+
+	error = handler->node_name(pw, node, &name);
+	if (error != CSS_OK)
+		return error;
+	if (name.name != NULL && lwc_string_caseless_hash_value(name.name,
+			&hash) == lwc_error_ok)
+		css_bloom_add_hash(bloom, hash);
+	lwc_string_unref(name.ns);
+	lwc_string_unref(name.name);
+
+	error = handler->node_id(pw, node, &id);
+	if (error != CSS_OK)
+		return error;
+	if (id != NULL) {
+		if (lwc_string_caseless_hash_value(id, &hash) ==
+				lwc_error_ok)
+			css_bloom_add_hash(bloom, hash);
+		lwc_string_unref(id);
+	}
+
+	error = handler->node_classes(pw, node, &classes, &n_classes);
+	if (error != CSS_OK)
+		return error;
+	if (classes != NULL) {
+		for (i = 0; i < n_classes; i++) {
+			if (lwc_string_caseless_hash_value(classes[i],
+					&hash) == lwc_error_ok)
+				css_bloom_add_hash(bloom, hash);
+			lwc_string_unref(classes[i]);
+		}
+	}
+	return CSS_OK;
+}
+
+/**
+ * The bloom of a node and its ancestors, made by walking up to the root
+ * (VitaSurf). A node selected outside a full pass -- a script's computed
+ * style read, before the first layout or of an element with no box --
+ * had a saturated filter instead, which rejects nothing: every rule
+ * whose last compound matched walked its combinators, and reddit.com's
+ * reads of three elements took seconds. The walk goes the way the bloom
+ * of a selected node is made, across shadow roots, and reads every
+ * ancestor as it is now: one selected for the boxes keeps a bloom of its
+ * classes then, which a script may have changed since. Any failure
+ * leaves it saturated, which is still valid.
+ */
+static void css__build_ancestor_bloom(void *node,
+		css_select_handler *handler, void *pw, css_bloom *bloom)
+{
+	void *n = node;
+	uint32_t i;
+
+	while (n != NULL) {
+		void *up = NULL;
+
+		if (css__bloom_add_node(n, handler, pw, bloom) != CSS_OK)
+			goto saturate;
+		if ((handler->parent_node_cross != NULL ?
+				handler->parent_node_cross :
+				handler->parent_node)(pw, n, &up) != CSS_OK)
+			goto saturate;
+		n = up;
+	}
+	return;
+
+saturate:
+	for (i = 0; i < CSS_BLOOM_SIZE; i++)
+		bloom[i] = ~0;
+}
