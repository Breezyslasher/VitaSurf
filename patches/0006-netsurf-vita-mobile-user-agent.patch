diff --git a/utils/useragent.c b/utils/useragent.c
index 547999c7c..64317a1cb 100644
--- a/utils/useragent.c
+++ b/utils/useragent.c
@@ -52,6 +52,14 @@ user_agent_build_string(void)
                         sysname = "X11; Linux";
                 }
         }
+#ifdef __vita__
+        /*
+         * VitaSurf: ask for mobile pages. A 960x544 screen and a slow
+         * CPU are much better served by them, and sites such as Wikipedia
+         * redirect to the desktop version unless the UA says Mobile.
+         */
+        sysname = "PlayStation Vita; Mobile";
+#endif
 
         len = snprintf(NULL, 0, NETSURF_UA_FORMAT_STRING,
                        sysname,
@@ -74,6 +82,20 @@ user_agent_build_string(void)
               core_user_agent_string);
 }
 
+#ifdef __vita__
+/* VitaSurf: replace the user agent at runtime (see vita_flaresolverr.c) */
+void
+user_agent_override(const char *ua)
+{
+	char *copy = strdup(ua);
+
+	if (copy == NULL)
+		return;
+	free_user_agent_string();
+	core_user_agent_string = copy;
+}
+#endif
+
 /* This is a function so that later we can override it trivially */
 const char *
 user_agent_string(void)
