--- a/utils/useragent.h
+++ b/utils/useragent.h
@@ -34,4 +34,13 @@ const char * user_agent_string(void);
  */
 void free_user_agent_string(void);
 
+#ifdef __vita__
+/**
+ * Replace the user agent string for every later fetch (VitaSurf).
+ *
+ * \param ua The new user agent, copied.
+ */
+void user_agent_override(const char *ua);
+#endif
+
 #endif
