+	band[2].x0 = s->x0 + r->bl_h;  band[2].y0 = s->y1 - bottom;
+	band[2].x1 = s->x1 - r->br_h;  band[2].y1 = s->y1;
+	/* the corners, painted aside and cut to their curves */
+	corner[0].x0 = s->x0;          corner[0].y0 = s->y0;
