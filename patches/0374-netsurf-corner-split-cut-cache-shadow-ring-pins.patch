+/* exported interface documented in html/private.h */
+nserror
+html_plot_rounded_ring(const struct redraw_context *ctx, colour c,
+		       const struct rect *r,
+		       const struct html_corner_radii *radii, int bw)
+{
+	nserror res = NSERROR_OK;
+	plot_style_t style = {
+		.stroke_type = PLOT_OP_TYPE_SOLID,
+		.fill_type = PLOT_OP_TYPE_NONE,
+		.stroke_colour = c,
+		.stroke_width = plot_style_int_to_fixed(bw),
+	};
+	struct rect centre;
+	struct html_corner_radii mid = *radii;
+
+	if (bw <= 0)
+		return NSERROR_OK;
+	if (rounded_ring_smooth(ctx, c, r, radii, bw, &res))
+		return res;
+
+	/* a stroke along the middle of the ring */
+	centre.x0 = r->x0 + bw / 2;
+	centre.y0 = r->y0 + bw / 2;
+	centre.x1 = r->x1 - (bw - bw / 2);
+	centre.y1 = r->y1 - (bw - bw / 2);
+#define MID(v) do { (v) -= bw / 2; if ((v) < 0) (v) = 0; } while (0)
+	MID(mid.tl_h); MID(mid.tl_v); MID(mid.tr_h); MID(mid.tr_v);
+	MID(mid.br_h); MID(mid.br_v); MID(mid.bl_h); MID(mid.bl_v);
