+/**
+ * Whether anything in a box is painted (VitaSurf): a background, a
+ * border, a shadow, an outline, text or a replaced object anywhere in
+ * it. At most budget boxes are looked at; one too big to tell is taken
+ * to paint.
+ */
+static bool html_box_paints(const struct box *b, int *budget)
+{
+	const struct box *c;
+
+	if (--*budget <= 0)
+		return true;
+	if (b->object != NULL || b->gadget != NULL || b->iframe != NULL ||
+			(b->text != NULL && b->length > 0) ||
+			b->background != NULL)
+		return true;
+	if (b->style != NULL) {
+		css_color bg = 0;
+		lwc_string *img = NULL;
+		css_fixed f[4];
+		css_unit u[4];
+		css_color sc = 0;
+
+		css_computed_background_color(b->style, &bg);
+		if ((bg >> 24) != 0)
+			return true;
+		if (css_computed_background_image(b->style, &img) ==
+				CSS_BACKGROUND_IMAGE_IMAGE && img != NULL)
+			return true;
+		if (b->border[TOP].width || b->border[RIGHT].width ||
+				b->border[BOTTOM].width ||
+				b->border[LEFT].width)
+			return true;
+		if (css_computed_box_shadow(b->style, &f[0], &u[0], &f[1],
+				&u[1], &f[2], &u[2], &f[3], &u[3], &sc) !=
+				CSS_BOX_SHADOW_NONE)
+			return true;
+		if (css_computed_outline_style(b->style) !=
+				CSS_OUTLINE_STYLE_NONE)
+			return true;
+	}
+	if (b->list_marker != NULL)
+		return true;
+	for (c = b->children; c != NULL; c = c->next) {
+		if (html_box_paints(c, budget))
+			return true;
+	}
+	return false;
+}
