+/*
+ * Rounded images kept as they were cut (VitaSurf). An avatar with
+ * border-radius: 50% was painted aside and cut to its circle on every
+ * redraw that reached it: GitHub's profile picture, 255 pixels across,
+ * cost a tenth of a second each time, and a scroll redrew it at every
+ * step. The cut picture is kept and plotted again until the image, its
+ * size or its corners change. Animated images are not kept.
+ */
+#define HTML_CUT_CACHE_N 16
+#define HTML_CUT_CACHE_BYTES (2 * 1024 * 1024)
+
+struct html_cut_entry {
+	struct nsurl *url;		/**< the image's address, kept */
+	struct bitmap *src;		/**< the image's own bitmap */
+	struct bitmap *bm;		/**< the cut picture */
+	int w, h;			/**< its size */
+	int dx, dy, dw, dh;		/**< the image's place in it */
+	struct html_corner_radii r;
+	bool ellipse;
+	unsigned int used;		/**< for dropping the oldest */
+};
+
+static struct html_cut_entry html_cut_cache[HTML_CUT_CACHE_N];
+static unsigned int html_cut_clock;
+
+static void html_cut_drop(struct html_cut_entry *e)
+{
+	if (e->bm != NULL)
+		guit->bitmap->destroy(e->bm);
+	if (e->url != NULL)
+		nsurl_unref(e->url);
+	memset(e, 0, sizeof(*e));
+}
+
+/**
+ * Plot an image cut to a rounded shape from the kept pictures, making
+ * it if it is not kept (VitaSurf).
+ *
+ * \return true if it was plotted this way, with *ok its result; false
+ *         if it cannot be kept, and nothing was plotted
+ */
+static bool html_composite_object_kept(const struct redraw_context *ctx,
+		struct hlcache_handle *obj, const struct content_redraw_data *d,
+		const struct rect *area, float scale,
+		const struct html_shape *s, bool *ok)
+{
+	struct html_cut_entry *e = NULL;
+	struct bitmap *src;
+	struct nsurl *url;
+	lwc_string *mime;
+	int w = area->x1 - area->x0, h = area->y1 - area->y0;
+	size_t need = (size_t) w * h * 4;
+	int i;
+
+	if (!ctx->interactive || scale != 1.0f || w <= 0 || h <= 0 ||
+			need > HTML_CUT_CACHE_BYTES / 2)
+		return false;
+	src = content_get_bitmap(obj);
+	url = hlcache_handle_get_url(obj);
+	if (src == NULL || url == NULL)
+		return false;
+	mime = content_get_mime_type(obj);
+	if (mime != NULL) {
+		bool gif = lwc_string_length(mime) == 9 &&
+				strncasecmp(lwc_string_data(mime),
+					"image/gif", 9) == 0;
+
+		lwc_string_unref(mime);
+		if (gif)
+			return false;
+	}
+
+	/* kept already? */
+	for (i = 0; i < HTML_CUT_CACHE_N && e == NULL; i++) {
+		struct html_cut_entry *c = &html_cut_cache[i];
+
+		if (c->bm != NULL && c->src == src && c->w == w &&
+				c->h == h &&
+				c->dx == d->x - area->x0 &&
+				c->dy == d->y - area->y0 &&
+				c->dw == d->width && c->dh == d->height &&
+				c->ellipse == s->ellipse &&
+				memcmp(&c->r, &s->r, sizeof(c->r)) == 0 &&
+				nsurl_compare(c->url, url, NSURL_COMPLETE))
+			e = c;
+	}
+
+	if (e == NULL) {
+		struct html_composite_object ow = { obj, d };
+		struct bitmap *bm = NULL;
+		int ox = 0, oy = 0;
+
+		/* a free place and room for it, the oldest going first */
+		while (e == NULL) {
+			struct html_cut_entry *free_slot = NULL, *lru = NULL;
+			size_t held = 0;
+
+			for (i = 0; i < HTML_CUT_CACHE_N; i++) {
+				struct html_cut_entry *c = &html_cut_cache[i];
+
+				if (c->bm == NULL) {
+					if (free_slot == NULL)
+						free_slot = c;
+					continue;
+				}
+				held += (size_t) c->w * c->h * 4;
+				if (lru == NULL || c->used < lru->used)
+					lru = c;
+			}
+			if (free_slot != NULL &&
+					held + need <= HTML_CUT_CACHE_BYTES) {
+				e = free_slot;
+			} else if (lru != NULL) {
+				html_cut_drop(lru);
+			} else {
+				return false;
+			}
+		}
+		if (!html_composite_raster(area, area, scale,
+				html_composite_object_draw, &ow, &bm, &ox,
+				&oy) || bm == NULL)
+			return false;
+		html_shape_apply(bm, ox, oy, s);
+		e->url = nsurl_ref(url);
+		e->src = src;
+		e->bm = bm;
+		e->w = w;
+		e->h = h;
+		e->dx = d->x - area->x0;
+		e->dy = d->y - area->y0;
+		e->dw = d->width;
+		e->dh = d->height;
+		e->r = s->r;
+		e->ellipse = s->ellipse;
+	}
+	e->used = ++html_cut_clock;
+
+	*ok = ctx->plot->bitmap(ctx, e->bm, area->x0, area->y0, w, h, 0,
+			BITMAPF_NONE) == NSERROR_OK;
+	/* plotted now, while it is surely kept */
+	if (ctx->plot->flush != NULL)
+		ctx->plot->flush(ctx);
+	return true;
+}
