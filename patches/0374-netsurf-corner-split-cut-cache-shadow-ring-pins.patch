+	out->x0 = a->x0 > clip->x0 ? a->x0 : clip->x0;
+	out->y0 = a->y0 > clip->y0 ? a->y0 : clip->y0;
+	out->x1 = a->x1 < clip->x1 ? a->x1 : clip->x1;
+	out->y1 = a->y1 < clip->y1 ? a->y1 : clip->y1;
