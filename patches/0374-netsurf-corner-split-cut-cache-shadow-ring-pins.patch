+	corner[1].x0 = s->x1 - r->tr_h; corner[1].y0 = s->y0;
+	corner[1].x1 = s->x1;          corner[1].y1 = s->y0 + top;
+	corner[2].x0 = s->x0;          corner[2].y0 = s->y1 - bottom;
+	corner[2].x1 = s->x0 + r->bl_h; corner[2].y1 = s->y1;
+	corner[3].x0 = s->x1 - r->br_h; corner[3].y0 = s->y1 - bottom;
+	corner[3].x1 = s->x1;          corner[3].y1 = s->y1;
