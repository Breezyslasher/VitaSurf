+/**
+ * Whether a box's clip-path keeps all it and its descendants paint
+ * inside its border box (VitaSurf): an inset() of no negative length.
+ * A fixed descendant is cut by it too, though it leaves the box's
+ * overflow clip, so a point outside the box reaches none of them: CNN's
+ * header ad, a fixed box shown through such a wrapper, took the taps
+ * meant for the page under it once the wrapper had scrolled away.
+ */
+static bool box_clip_path_inside(const struct box *box)
+{
+	css_fixed v[4];
+	css_unit u[4];
+	int i;
+
+	if (box->style == NULL ||
+	    css_computed_clip_path(box->style, &v[0], &u[0], &v[1], &u[1],
+			&v[2], &u[2], &v[3], &u[3]) != CSS_CLIP_PATH_INSET) {
+		return false;
+	}
+	for (i = 0; i < 4; i++) {
+		if (u[i] == CSS_UNIT_EXPR || v[i] < 0)
+			return false;
+	}
+	return true;
+}
+
