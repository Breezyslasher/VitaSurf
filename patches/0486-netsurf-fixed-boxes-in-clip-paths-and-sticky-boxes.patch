+/**
+ * Draw the i-th fixed box set aside in this redraw, cut to the
+ * clip-path insets of the ancestors it was met in (VitaSurf).
+ */
+static bool html_redraw_fixed(const html_content *html, int i,
+		const struct rect *clip, float scale, colour bg,
+		const struct redraw_context *ctx)
+{
+	struct rect c = *clip;
+	bool ok;
+
+	if (html->fixed_cp_set[i]) {
+		const struct rect *cp = &html->fixed_cp[i];
+
+		if (c.x0 < cp->x0) c.x0 = cp->x0;
+		if (c.y0 < cp->y0) c.y0 = cp->y0;
+		if (c.x1 > cp->x1) c.x1 = cp->x1;
+		if (c.y1 > cp->y1) c.y1 = cp->y1;
+		if (c.x0 >= c.x1 || c.y0 >= c.y1)
+			return true;
+	}
+	html_cp_rect = html->fixed_cp[i];
+	html_cp_set = html->fixed_cp_set[i];
+	ok = html_redraw_box(html, html->fixed_box[i], html->fixed_x[i],
+			html->fixed_y[i], &c, scale, bg, ctx);
+	html_cp_set = false;
+	return ok;
+}
