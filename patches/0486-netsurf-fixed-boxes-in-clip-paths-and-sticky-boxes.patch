diff --git a/desktop/browser_window.c b/desktop/browser_window.c
index 04ecb9587..b6487766d 100644
--- a/desktop/browser_window.c
+++ b/desktop/browser_window.c
@@ -278,6 +278,29 @@ browser_window_scroll_offsets(struct browser_window *bw, int *sx, int *sy)
 }
 
 
+/* exported interface documented in netsurf/browser_window.h */
+bool
+browser_window_viewport(struct browser_window *bw, int *x, int *y,
+		int *w, int *h)
+{
+	int sx = 0, sy = 0;
+
+	if (bw == NULL || !browser_window_scroll_offsets(bw, &sx, &sy))
+		return false;
+	*x = sx / bw->scale;
+	*y = sy / bw->scale;
+	*w = bw->width;
+	*h = bw->height;
+	/* a window not reformatted yet has its size with the frontend */
+	if ((*w <= 0 || *h <= 0) && bw->window != NULL &&
+	    guit->window->get_dimensions != NULL &&
+	    guit->window->get_dimensions(bw->window, w, h) != NSERROR_OK) {
+		*w = *h = 0;
+	}
+	return true;
+}
+
