 extern unsigned int vitasurf_ms_html_parse;
 extern unsigned int vitasurf_ms_css;
+/** A microsecond clock, for timing work too short for milliseconds. */
+uint64_t vitasurf_clock_us(void);
+/* composing selected styles with their parents' (VitaSurf) */
+extern unsigned int vitasurf_us_compose;
+/*
+ * Module compiles (VitaSurf). An import is compiled inside the loader,
+ * while its importer runs or inside a promise job, so none of it reaches
+ * the script compile figure; and a top-level module is first parsed as a
+ * classic script, which fails, and then again as a module.
+ */
+extern unsigned int vitasurf_ms_js_import_compile;
+extern unsigned int vitasurf_js_import_compiles;
+extern unsigned int vitasurf_js_import_kb;
+extern unsigned int vitasurf_ms_js_reparse;
+extern unsigned int vitasurf_js_reparses;
+extern unsigned int vitasurf_js_reparse_kb;
+/* imports read back from the compiled script cache instead */
+extern unsigned int vitasurf_ms_js_import_cached;
+extern unsigned int vitasurf_js_import_cache_hits;
+extern unsigned int vitasurf_js_import_cached_kb;
 /* the merged selector index: how often it was built and for how long */
 extern unsigned int vitasurf_css_index_builds;
 extern unsigned int vitasurf_ms_css_index;
