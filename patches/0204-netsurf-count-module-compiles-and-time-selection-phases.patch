 unsigned int vitasurf_ms_html_parse;
 unsigned int vitasurf_ms_css;
+unsigned int vitasurf_us_compose;
+
+#ifdef __vita__
+unsigned long long vita_now_us(void);
+#endif
+
+/* exported: see utils.h (VitaSurf) */
+uint64_t vitasurf_clock_us(void)
+{
+#ifdef __vita__
+	return (uint64_t) vita_now_us();
+#else
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t) ts.tv_sec * 1000000u +
+		(uint64_t) (ts.tv_nsec / 1000);
+#endif
+}
