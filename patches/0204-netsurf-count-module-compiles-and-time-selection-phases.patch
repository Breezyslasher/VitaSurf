diff --git a/content/handlers/css/select.c b/content/handlers/css/select.c
index b56b4a6d7..2303ec6c1 100644
--- a/content/handlers/css/select.c
+++ b/content/handlers/css/select.c
@@ -259,11 +259,15 @@ static void nscss_dom_user_data_handler(dom_node_operation operation,
  * \return Pointer to selection results (containing computed styles),
  *         or NULL on failure
  */
+/* libcss's phase clock (VitaSurf); see css_select_style */
+extern uint64_t (*css_select_clock_us)(void);
+
 css_select_results *nscss_get_style(nscss_select_ctx *ctx, dom_node *n,
 		const css_media *media,
 		const css_unit_ctx *unit_len_ctx,
 		const css_stylesheet *inline_style)
 {
+	uint64_t t_compose = 0;
 	css_computed_style *composed;
 	css_select_results *styles;
 	int pseudo_element;
@@ -275,6 +279,8 @@ css_select_results *nscss_get_style(nscss_select_ctx *ctx, dom_node *n,
 	 * this element can be resolved against them (VitaSurf).
 	 */
 	css_select_ctx_set_parent(ctx->ctx, ctx->parent_style);
+	/* libcss times its phases with our clock (VitaSurf) */
+	css_select_clock_us = vitasurf_clock_us;
 
 	error = css_select_style(ctx->ctx, n, unit_len_ctx, media, inline_style,
 			&selection_handler, ctx, &styles);
@@ -286,6 +292,7 @@ css_select_results *nscss_get_style(nscss_select_ctx *ctx, dom_node *n,
 
 	/* If there's a parent style, compose with partial to obtain
 	 * complete computed style for element */
+	t_compose = vitasurf_clock_us();
 	if (ctx->parent_style != NULL) {
 		/* Complete the computed style, by composing with the parent
 		 * element's style */
@@ -335,6 +342,8 @@ css_select_results *nscss_get_style(nscss_select_ctx *ctx, dom_node *n,
 		styles->styles[pseudo_element] = composed;
 	}
 
+	vitasurf_us_compose += (unsigned int)
+			(vitasurf_clock_us() - t_compose);
 	return styles;
 }
 
diff --git a/utils/utils.c b/utils/utils.c
