diff --git a/src/parse/properties/anchor.c b/src/parse/properties/anchor.c
new file mode 100644
index 0000000..1f945ad
--- /dev/null
+++ b/src/parse/properties/anchor.c
@@ -0,0 +1,335 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+/*
+ * Anchor positioning (VitaSurf).
+ *
+ * anchor-name, position-anchor, position-area and position-try are kept
+ * as the text they were written as. An inset written with anchor() --
+ * "top: anchor(--menu bottom)", or inside a calc() -- is kept the same
+ * way, in a property of its own beside the inset, which is itself set to
+ * auto: the client lays the page out, finds the anchor, and places the
+ * box from the text. anchor-size() in width and height is kept likewise.
+ * An ordinary value is parsed as it always was and says nothing of
+ * anchors, so a later "top: 10px" wins over an earlier anchor() by
+ * leaving top set, which the client checks.
+ */
+
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+#define ANCHOR_TEXT_MAX 256
+
+static bool an_ident_is(const css_token *t, const char *lit)
+{
+	size_t n = strlen(lit);
+
+	return t != NULL && t->idata != NULL &&
+			lwc_string_length(t->idata) == n &&
+			strncasecmp(lwc_string_data(t->idata), lit, n) == 0;
+}
+
+/** Whether the value from ctx on has a function of this name in it. */
+static bool an_has_function(const parserutils_vector *vector, int32_t ctx,
+		const char *name)
+{
+	const css_token *t;
+	int depth = 0;
+
+	while ((t = parserutils_vector_peek(vector, ctx)) != NULL) {
+		if (tokenIsChar(t, '!'))
+			break;
+		if (t->type == CSS_TOKEN_FUNCTION && an_ident_is(t, name))
+			return true;
+		if (t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '('))
+			depth++;
+		else if (tokenIsChar(t, ')') && depth-- == 0)
+			break;	/* the end of an @supports test */
+		ctx++;
+	}
+	return false;
+}
+
+static bool an_put(char *buf, size_t size, size_t *at, const char *s,
+		size_t n)
+{
+	if (*at + n + 1 > size)
+		return false;
+	memcpy(buf + *at, s, n);
+	*at += n;
+	buf[*at] = '\0';
+	return true;
+}
+
+/**
+ * The text of the value from ctx to its end (or its "!important"),
+ * spaces collapsed; ctx is left at the end.
+ */
+static css_error an_text(const parserutils_vector *vector, int32_t *ctx,
+		char *buf, size_t size)
+{
+	const css_token *t;
+	size_t at = 0;
+	bool space = false;
+	int depth = 0;
+
+	buf[0] = '\0';
+	while ((t = parserutils_vector_peek(vector, *ctx)) != NULL) {
+		const char *d = t->idata != NULL ?
+				lwc_string_data(t->idata) :
+				(const char *) t->data.data;
+		size_t n = t->idata != NULL ? lwc_string_length(t->idata) :
+				t->data.len;
+		bool ok = true;
+
+		if (tokenIsChar(t, '!'))
+			break;
+		/* a bracket closing what the value did not open ends it,
+		 * as in an @supports test */
+		if (t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '('))
+			depth++;
+		else if (tokenIsChar(t, ')') && depth-- == 0)
+			break;
+		parserutils_vector_iterate(vector, ctx);
+		if (t->type == CSS_TOKEN_S || t->type == CSS_TOKEN_COMMENT) {
+			space = at > 0;
+			continue;
+		}
+		if (d == NULL)
+			n = 0;
+		if (space) {
+			ok = an_put(buf, size, &at, " ", 1);
+			space = false;
+		}
+		switch (t->type) {
+		case CSS_TOKEN_FUNCTION:
+			ok = ok && an_put(buf, size, &at, d, n) &&
+					an_put(buf, size, &at, "(", 1);
+			break;
+		case CSS_TOKEN_PERCENTAGE:
+			ok = ok && an_put(buf, size, &at, d, n) &&
+					an_put(buf, size, &at, "%", 1);
+			break;
+		case CSS_TOKEN_IDENT:
+		case CSS_TOKEN_CHAR:
+		case CSS_TOKEN_NUMBER:
+		case CSS_TOKEN_DIMENSION:
+			ok = ok && an_put(buf, size, &at, d, n);
+			break;
+		default:
+			return CSS_INVALID;
+		}
+		if (!ok)
+			return CSS_INVALID;
+	}
+	return at > 0 ? CSS_OK : CSS_INVALID;
+}
+
+/** Append a string property's value: the text, or none for NULL. */
+static css_error an_emit(css_language *c, css_style *result,
+		enum css_properties_e op, const char *text)
+{
+	lwc_string *s;
+	uint32_t snumber;
+	css_error error;
+
+	/* every string property here has none 0 and set 1 */
+	if (text == NULL || text[0] == '\0')
+		return css__stylesheet_style_appendOPV(result, op, 0,
+				ANCHOR_NAME_NONE);
+	if (lwc_intern_string(text, strlen(text), &s) != lwc_error_ok)
+		return CSS_NOMEM;
+	error = css__stylesheet_string_add(c->sheet, s, &snumber);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_appendOPV(result, op, 0,
+			ANCHOR_NAME_SET);
+	if (error != CSS_OK)
+		return error;
+	return css__stylesheet_style_append(result, snumber);
+}
+
+/** A flag value (inherit and the like), if that is what the value is. */
+static bool an_flag(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, css_style *result, enum css_properties_e op,
+		css_error *error)
+{
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+
+	if (t == NULL)
+		return false;
+	flag_value = get_css_flag_value(c, t);
+	if (flag_value == FLAG_VALUE__NONE)
+		return false;
+	parserutils_vector_iterate(vector, ctx);
+	*error = css_stylesheet_style_flag_value(result, flag_value, op);
+	return true;
+}
+
+/*
+ * A list of idents, those a property takes: dashed names for
+ * anchor-name and position-anchor, keywords for position-area and
+ * position-try. \a none_word is the keyword that means none.
+ */
+static css_error an_list(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, css_style *result, enum css_properties_e op,
+		const char *none_word, bool dashed, bool commas, int max)
+{
+	int32_t orig = *ctx;
+	char buf[ANCHOR_TEXT_MAX];
+	size_t at = 0;
+	int count = 0;
+	css_error error;
+	const css_token *t;
+
+	if (an_flag(c, vector, ctx, result, op, &error))
+		return error;
+
+	buf[0] = '\0';
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_peek(vector, *ctx);
+	if (t != NULL && t->type == CSS_TOKEN_IDENT &&
+			an_ident_is(t, none_word)) {
+		parserutils_vector_iterate(vector, ctx);
+		return an_emit(c, result, op, NULL);
+	}
+	while ((t = parserutils_vector_peek(vector, *ctx)) != NULL &&
+			!tokenIsChar(t, '!') && !tokenIsChar(t, ')')) {
+		if (t->type == CSS_TOKEN_S) {
+			parserutils_vector_iterate(vector, ctx);
+			continue;
+		}
+		if (tokenIsChar(t, ',')) {
+			if (!commas || count == 0)
+				goto invalid;
+			if (!an_put(buf, sizeof(buf), &at, ",", 1))
+				goto invalid;
+			parserutils_vector_iterate(vector, ctx);
+			continue;
+		}
+		if (t->type != CSS_TOKEN_IDENT)
+			goto invalid;
+		if (dashed && (lwc_string_length(t->idata) < 3 ||
+				strncmp(lwc_string_data(t->idata), "--", 2)))
+			goto invalid;
+		if (++count > max)
+			goto invalid;
+		if ((at > 0 && !an_put(buf, sizeof(buf), &at, " ", 1)) ||
+				!an_put(buf, sizeof(buf), &at,
+					lwc_string_data(t->idata),
+					lwc_string_length(t->idata)))
+			goto invalid;
+		parserutils_vector_iterate(vector, ctx);
+	}
+	if (count == 0)
+		goto invalid;
+	return an_emit(c, result, op, buf);
+
+invalid:
+	*ctx = orig;
+	return CSS_INVALID;
+}
+
+css_error css__parse_anchor_name(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return an_list(c, vector, ctx, result, CSS_PROP_ANCHOR_NAME, "none",
+			true, true, 16);
+}
+
+css_error css__parse_position_anchor(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return an_list(c, vector, ctx, result, CSS_PROP_POSITION_ANCHOR,
+			"auto", true, false, 1);
+}
+
+css_error css__parse_position_area(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return an_list(c, vector, ctx, result, CSS_PROP_POSITION_AREA,
+			"none", false, false, 2);
+}
+
+css_error css__parse_position_try(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return an_list(c, vector, ctx, result, CSS_PROP_POSITION_TRY,
+			"none", false, true, 16);
+}
+
+/** The property an inset's or a size's anchor() text is kept in. */
+static enum css_properties_e an_kept(enum css_properties_e op)
+{
+	switch (op) {
+	case CSS_PROP_TOP: return CSS_PROP_ANCHOR_TOP;
+	case CSS_PROP_RIGHT: return CSS_PROP_ANCHOR_RIGHT;
+	case CSS_PROP_BOTTOM: return CSS_PROP_ANCHOR_BOTTOM;
+	case CSS_PROP_LEFT: return CSS_PROP_ANCHOR_LEFT;
+	case CSS_PROP_WIDTH: return CSS_PROP_ANCHOR_WIDTH;
+	default: return CSS_PROP_ANCHOR_HEIGHT;
+	}
+}
+
+/* exported interface documented in parse/properties/properties.h */
+css_error css__parse_side_anchor(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, enum css_properties_e op)
+{
+	int32_t orig = *ctx;
+	char buf[ANCHOR_TEXT_MAX];
+	css_error error;
+
+	if (!an_has_function(vector, *ctx, "anchor"))
+		return css__parse_side(c, vector, ctx, result, op);
+
+	error = an_text(vector, ctx, buf, sizeof(buf));
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result, op, 0,
+				BOTTOM_AUTO);
+	if (error == CSS_OK)
+		error = an_emit(c, result, an_kept(op), buf);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+}
+
+/* exported interface documented in parse/properties/properties.h */
+css_error css__parse_size_anchor(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, enum css_properties_e op)
+{
+	int32_t orig = *ctx;
+	char buf[ANCHOR_TEXT_MAX];
+	css_error error;
+
+	if (!an_has_function(vector, *ctx, "anchor-size"))
+		return op == CSS_PROP_WIDTH ?
+				css__parse_width_base(c, vector, ctx, result) :
+				css__parse_height_base(c, vector, ctx, result);
+
+	error = an_text(vector, ctx, buf, sizeof(buf));
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result, op, 0,
+				op == CSS_PROP_WIDTH ? WIDTH_AUTO :
+				HEIGHT_AUTO);
+	if (error == CSS_OK)
+		error = an_emit(c, result, an_kept(op), buf);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+}
