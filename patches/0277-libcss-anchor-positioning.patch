diff --git a/src/select/properties/anchor_bottom.c b/src/select/properties/anchor_bottom.c
new file mode 100644
index 0000000..f9b74e5
--- /dev/null
+++ b/src/select/properties/anchor_bottom.c
@@ -0,0 +1,89 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_anchor_bottom(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_ANCHOR_BOTTOM_INHERIT;
+	lwc_string *name = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case ANCHOR_BOTTOM_NONE:
+			value = CSS_ANCHOR_BOTTOM_NONE;
+			break;
+		case ANCHOR_BOTTOM_SET:
+			value = CSS_ANCHOR_BOTTOM_SET;
+			css__stylesheet_string_get(style->sheet,
+					*((css_code_t *) style->bytecode),
+					&name);
+			advance_bytecode(style, sizeof(css_code_t));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_anchor_bottom(state->computed, value, name);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_anchor_bottom_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error;
+
+	error = set_anchor_bottom(style, hint->status, hint->data.string);
+
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+
+	return error;
+}
+
+css_error css__initial_anchor_bottom(css_select_state *state)
+{
+	return set_anchor_bottom(state->computed, CSS_ANCHOR_BOTTOM_NONE,
+			NULL);
+}
+
+css_error css__copy_anchor_bottom(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *name;
+	uint8_t type = get_anchor_bottom(from, &name);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_anchor_bottom(to, type, name);
+}
+
+css_error css__compose_anchor_bottom(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *name;
+	uint8_t type = get_anchor_bottom(child, &name);
+
+	return css__copy_anchor_bottom(
+			type == CSS_ANCHOR_BOTTOM_INHERIT ? parent : child,
+			result);
+}
