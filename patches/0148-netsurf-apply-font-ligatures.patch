+/**
+ * The glyph a code point maps to, remembering the ASCII ones.
+ *
+ * Measuring text reached the advance cache without asking FreeType
+ * anything; finding a glyph index for every character would undo that,
+ * so the answers for the characters nearly all text is made of are
+ * kept on the face. (VitaSurf)
+ */
+static FT_UInt fb_glyph_for(fb_faceid_t *fb_face, FTC_FaceID face_id,
+			    uint32_t ucs4)
+{
+	uint32_t held;
+
+	if (ucs4 >= 128) {
+		return FTC_CMapCache_Lookup(ft_cmap_cache, face_id,
+					    fb_face->cidx, ucs4);
+	}
+	held = fb_face->cmap_ascii[ucs4];
+	if (held == 0) {
+		held = FB_CMAP_KNOWN | FTC_CMapCache_Lookup(ft_cmap_cache,
+				face_id, fb_face->cidx, ucs4);
+		fb_face->cmap_ascii[ucs4] = held;
+	}
+	return (FT_UInt) (held & ~FB_CMAP_KNOWN);
+}
+
+/**
+ * Whether this byte is one the advance cache alone can answer.
+ *
+ * Below 0x80, already measured at this size, and not a character this
+ * face builds a ligature from -- which is nearly every character of
+ * nearly every page, and the case that has to stay quick. (VitaSurf)
+ */
+static inline bool fb_plain_char(const fb_faceid_t *fb_face,
+				 const struct adv_style *slot,
+				 unsigned char c)
+{
+	return c < ADV_CHARS && slot->adv[c] != ADV_UNKNOWN &&
+	       fb_face->liga_read &&
+	       (fb_face->liga_start_char[c >> 3] & (1 << (c & 7))) == 0;
+}
+
+/** A run of characters drawn as one glyph has no single code point. */
+#define FB_LIGA_NO_CHAR 0xFFFFFFFFu
+
+/**
+ * The glyph for the next run of characters, and where that run ends.
+ *
+ * Usually one character to one glyph. When the face has a ligature
+ * whose components the characters that follow match, the whole run
+ * becomes the one glyph the ligature names -- which is how an icon
+ * font draws an icon from its name. (VitaSurf)
+ *
+ * \param fb_face  The face, whose ligatures are read on first use.
+ * \param face_id  The same face, as the cache manager knows it.
+ * \param s        The text.
+ * \param len      Its length in bytes.
+ * \param off      Where to read from; moved past the whole run.
+ * \param ucs4     The code point read, or FB_LIGA_NO_CHAR for a run.
+ * \return the glyph index to draw.
+ */
+static FT_UInt fb_next_glyph(fb_faceid_t *fb_face, FTC_FaceID face_id,
+			     const char *s, size_t len, size_t *off,
+			     uint32_t *ucs4)
+{
+	const struct fb_liga *e;
+	FT_UInt g;
+
+	*ucs4 = fb_next_char(s, len, off);
+	g = fb_glyph_for(fb_face, face_id, *ucs4);
+
+	if (fb_face->liga_read == false) {
+		fb_liga_load(fb_face, face_id);
+	}
+	e = fb_liga_find(fb_face, g);
+	if (e == NULL) {
+		return g;
+	}
+
+	/* nothing can match unless what follows can be a second */
+	{
+		size_t at = *off;
+		FT_UInt g2;
+
+		if (at >= len) {
