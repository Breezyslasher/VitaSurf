+/*
+ * Ligature substitution (VitaSurf).
+ *
+ * An icon font is a ligature font: the page writes the icon's name as
+ * text -- <span class="material-symbols">home</span> -- and the font
+ * carries a rule turning the glyphs h, o, m, e into the house. Without
+ * the rule applied the page draws the word, at icon size, which is what
+ * made Audiobookshelf's sidebar read HOM, IMP, VIE and GRO, and made it
+ * three times too wide.
+ *
+ * HarfBuzz would do this and a great deal more, but it is a large
+ * dependency for one lookup type, and our FreeType is built without it.
+ * The liga feature's ligature substitution is a table walk, so walk it.
+ * Everything else in GSUB is left alone.
+ *
+ * The bytes are from the web, so every read is bounds checked against
+ * the table length before it happens.
+ */
+#define FB_LIGA_MAX_COUNT  16384	/* ligatures kept from one face */
+#define FB_LIGA_MAX_POOL   262144	/* components kept from one face */
+#define FB_LIGA_MAX_COMP   64		/* components in one ligature */
+
+static uint16_t fb_rd16(const uint8_t *p)
+{
+	return (uint16_t) ((p[0] << 8) | p[1]);
+}
+
+static uint32_t fb_rd32(const uint8_t *p)
+{
+	return ((uint32_t) p[0] << 24) | ((uint32_t) p[1] << 16) |
+	       ((uint32_t) p[2] << 8) | (uint32_t) p[3];
+}
+
+/** Room to read \a want bytes at \a off of a table \a len long. */
+static bool fb_fits(size_t off, size_t want, size_t len)
+{
+	return off <= len && want <= len - off;
+}
+
+struct fb_liga_build {
+	struct fb_liga *liga;
+	unsigned count;
+	uint16_t *pool;
+	unsigned pool_n;
+	unsigned pool_max;
+	unsigned liga_max;
+};
+
+/** One LigatureSubstFormat1 subtable. */
+static void fb_liga_subtable(const uint8_t *t, size_t len, size_t at,
+			     struct fb_liga_build *b)
+{
+	uint16_t set_count;
+	uint16_t cov_off;
+	size_t cov;
+	unsigned i;
+
+	if (!fb_fits(at, 6, len) || fb_rd16(t + at) != 1) {
+		return;
+	}
+	cov_off = fb_rd16(t + at + 2);
+	set_count = fb_rd16(t + at + 4);
+	cov = at + cov_off;
+	if (!fb_fits(at + 6, (size_t) set_count * 2, len)) {
+		return;
+	}
+
+	for (i = 0; i < set_count; i++) {
+		size_t set = at + fb_rd16(t + at + 6 + i * 2);
+		uint16_t first;
+		uint16_t lig_count;
+		unsigned j;
+
+		/*
+		 * The nth ligature set belongs to the nth glyph in the
+		 * coverage table, which is how the run's first glyph is
+		 * found again later.
+		 */
+		if (!fb_fits(cov, 4, len)) {
+			return;
+		}
+		if (fb_rd16(t + cov) == 1) {
+			uint16_t n = fb_rd16(t + cov + 2);
+
+			if (i >= n || !fb_fits(cov + 4, (size_t) n * 2, len)) {
+				continue;
+			}
+			first = fb_rd16(t + cov + 4 + i * 2);
+		} else if (fb_rd16(t + cov) == 2) {
+			uint16_t n = fb_rd16(t + cov + 2);
+			unsigned r;
+			bool found = false;
+
+			if (!fb_fits(cov + 4, (size_t) n * 6, len)) {
+				continue;
+			}
+			first = 0;
+			for (r = 0; r < n; r++) {
+				const uint8_t *rec = t + cov + 4 + r * 6;
+				uint16_t start = fb_rd16(rec);
+				uint16_t end = fb_rd16(rec + 2);
+				uint16_t base = fb_rd16(rec + 4);
+
+				if (i >= base && i - base <= (unsigned)
+						(end - start)) {
+					first = (uint16_t) (start + (i - base));
+					found = true;
+					break;
+				}
+			}
+			if (!found) {
+				continue;
+			}
+		} else {
+			return;
+		}
+
+		if (!fb_fits(set, 2, len)) {
+			continue;
+		}
+		lig_count = fb_rd16(t + set);
+		if (!fb_fits(set + 2, (size_t) lig_count * 2, len)) {
+			continue;
+		}
+
+		for (j = 0; j < lig_count; j++) {
+			size_t lig = set + fb_rd16(t + set + 2 + j * 2);
+			uint16_t glyph;
+			uint16_t ncomp;
+			unsigned k;
+			struct fb_liga *e;
+
+			if (!fb_fits(lig, 4, len)) {
+				continue;
+			}
+			glyph = fb_rd16(t + lig);
+			ncomp = fb_rd16(t + lig + 2);
+			if (ncomp < 1 || ncomp > FB_LIGA_MAX_COMP) {
+				continue;
+			}
+			ncomp--;	/* the first is the coverage glyph */
+			if (!fb_fits(lig + 4, (size_t) ncomp * 2, len)) {
+				continue;
+			}
+			if (b->count >= b->liga_max ||
+			    b->pool_n + ncomp > b->pool_max) {
+				return;		/* full; keep what we have */
+			}
+
+			e = &b->liga[b->count++];
+			e->first = first;
+			e->glyph = glyph;
+			e->ncomp = ncomp;
+			e->comp = b->pool_n;
+			for (k = 0; k < ncomp; k++) {
+				b->pool[b->pool_n++] =
+					fb_rd16(t + lig + 4 + k * 2);
+			}
+		}
+	}
+}
+
+/** Longest first within one starting glyph, so the first match wins. */
+static int fb_liga_cmp(const void *a, const void *b)
+{
+	const struct fb_liga *x = a;
+	const struct fb_liga *y = b;
+
+	if (x->first != y->first) {
+		return x->first < y->first ? -1 : 1;
+	}
+	if (x->ncomp != y->ncomp) {
+		return x->ncomp > y->ncomp ? -1 : 1;
+	}
+	return 0;
+}
+
+/** Walk one Lookup, following an extension lookup to what it wraps. */
+static void fb_liga_lookup(const uint8_t *t, size_t len, size_t at,
+			   struct fb_liga_build *b, int depth)
+{
+	uint16_t type;
+	uint16_t subs;
+	unsigned i;
+
+	if (depth > 2 || !fb_fits(at, 6, len)) {
+		return;
+	}
+	type = fb_rd16(t + at);
+	subs = fb_rd16(t + at + 4);
+	if (!fb_fits(at + 6, (size_t) subs * 2, len)) {
+		return;
+	}
+
+	for (i = 0; i < subs; i++) {
+		size_t sub = at + fb_rd16(t + at + 6 + i * 2);
+
+		if (type == 4) {
+			fb_liga_subtable(t, len, sub, b);
+		} else if (type == 7) {
+			/* an extension is a type and a 32 bit offset */
+			uint16_t inner;
+
+			if (!fb_fits(sub, 8, len) || fb_rd16(t + sub) != 1) {
+				continue;
+			}
+			inner = fb_rd16(t + sub + 2);
+			if (inner == 4) {
+				fb_liga_subtable(t, len,
+						 sub + fb_rd32(t + sub + 4), b);
+			}
+		}
+	}
+}
+
+/** Read the face's liga feature. Called once per face. */
+static void fb_liga_load(fb_faceid_t *fb_face, FTC_FaceID face_id)
+{
+	FT_Face face = NULL;
+	FT_ULong len = 0;
+	uint8_t *t = NULL;
+	struct fb_liga_build b;
+	size_t feat_at;
+	size_t look_at;
+	uint16_t feat_count;
+	uint16_t look_count;
+	unsigned i;
+	unsigned glyphs;
+
+	fb_face->liga_read = true;
+
+	if (FTC_Manager_LookupFace(ft_cmanager, face_id, &face) != 0 ||
+	    face == NULL) {
+		return;
+	}
+	glyphs = (unsigned) face->num_glyphs;
+	if (glyphs == 0) {
+		return;
+	}
+
+	if (FT_Load_Sfnt_Table(face, FT_MAKE_TAG('G', 'S', 'U', 'B'), 0,
+			       NULL, &len) != 0 || len < 10) {
+		return;		/* no GSUB, which is most faces */
+	}
+	t = malloc(len);
+	if (t == NULL) {
+		return;
+	}
+	if (FT_Load_Sfnt_Table(face, FT_MAKE_TAG('G', 'S', 'U', 'B'), 0,
+			       t, &len) != 0) {
+		free(t);
+		return;
+	}
+
+	feat_at = fb_rd16(t + 6);
+	look_at = fb_rd16(t + 8);
+	if (!fb_fits(feat_at, 2, len) || !fb_fits(look_at, 2, len)) {
+		free(t);
+		return;
+	}
+	feat_count = fb_rd16(t + feat_at);
+	look_count = fb_rd16(t + look_at);
+	if (!fb_fits(feat_at + 2, (size_t) feat_count * 6, len) ||
+	    !fb_fits(look_at + 2, (size_t) look_count * 2, len)) {
+		free(t);
+		return;
+	}
+
+	/*
+	 * Sizing it would mean walking the table twice, so take the
+	 * whole allowance and give back what is not used at the end.
+	 * Material Symbols has thousands of these; DejaVu has a handful.
+	 */
+	memset(&b, 0, sizeof(b));
+	b.liga_max = FB_LIGA_MAX_COUNT;
+	b.pool_max = FB_LIGA_MAX_POOL;
+	b.liga = malloc(sizeof(*b.liga) * FB_LIGA_MAX_COUNT);
+	b.pool = malloc(sizeof(*b.pool) * FB_LIGA_MAX_POOL);
+	if (b.liga == NULL || b.pool == NULL) {
+		free(b.liga);
+		free(b.pool);
+		free(t);
+		return;
+	}
+
+	for (i = 0; i < feat_count; i++) {
+		const uint8_t *rec = t + feat_at + 2 + i * 6;
+		size_t f;
+		uint16_t n;
+		unsigned j;
+
+		if (memcmp(rec, "liga", 4) != 0) {
+			continue;
+		}
+		f = feat_at + fb_rd16(rec + 4);
+		if (!fb_fits(f, 4, len)) {
+			continue;
+		}
+		n = fb_rd16(t + f + 2);
+		if (!fb_fits(f + 4, (size_t) n * 2, len)) {
+			continue;
+		}
+		for (j = 0; j < n; j++) {
+			uint16_t li = fb_rd16(t + f + 4 + j * 2);
+
+			if (li >= look_count) {
+				continue;
+			}
+			fb_liga_lookup(t, len,
+				       look_at + fb_rd16(t + look_at + 2 +
+							 li * 2),
+				       &b, 0);
+		}
+	}
+	free(t);
+
+	if (b.count == 0) {
+		free(b.liga);
+		free(b.pool);
+		return;
+	}
+
+	qsort(b.liga, b.count, sizeof(*b.liga), fb_liga_cmp);
+
+	/*
+	 * One bit per glyph saying whether it can start a ligature, so
+	 * that ordinary text pays a bit test per character and nothing
+	 * more.
+	 */
+	fb_face->liga_starts = calloc((glyphs + 7) / 8, 1);
+	fb_face->liga_seconds = calloc((glyphs + 7) / 8, 1);
+	if (fb_face->liga_starts == NULL || fb_face->liga_seconds == NULL) {
+		free(fb_face->liga_starts);
+		free(fb_face->liga_seconds);
+		fb_face->liga_starts = NULL;
+		fb_face->liga_seconds = NULL;
+		free(b.liga);
+		free(b.pool);
+		return;
+	}
+	fb_face->liga_glyphs = glyphs;
+	for (i = 0; i < b.count; i++) {
+		uint16_t g = b.liga[i].first;
+		uint16_t g2 = b.pool[b.liga[i].comp];
+
+		if (g < glyphs) {
+			fb_face->liga_starts[g / 8] |= (uint8_t) (1 << (g % 8));
+		}
+		/*
+		 * What may follow it. A space begins a ligature in DejaVu,
+		 * so without this every space in a paragraph walked the
+		 * whole set of them before giving up.
+		 */
+		if (g2 < glyphs) {
+			fb_face->liga_seconds[g2 / 8] |=
+					(uint8_t) (1 << (g2 % 8));
+		}
+	}
+
+	/* and the same for the characters, so measuring ordinary text
+	 * need not find a glyph for each one */
+	for (i = 0; i < 128; i++) {
+		FT_UInt g = FTC_CMapCache_Lookup(ft_cmap_cache, face_id,
+						 fb_face->cidx, i);
+
+		if (g < glyphs &&
+		    (fb_face->liga_starts[g / 8] & (1 << (g % 8))) != 0) {
+			fb_face->liga_start_char[i / 8] |=
+					(uint8_t) (1 << (i % 8));
+		}
+	}
+
+	{
+		struct fb_liga *nl = realloc(b.liga,
+				sizeof(*b.liga) * b.count);
+		uint16_t *np = b.pool_n > 0 ?
+				realloc(b.pool, sizeof(*b.pool) * b.pool_n) :
+				b.pool;
+
+		if (nl != NULL) {
+			b.liga = nl;
+		}
+		if (np != NULL) {
+			b.pool = np;
+		}
+	}
+
+	fb_face->liga = b.liga;
+	fb_face->liga_pool = b.pool;
+	fb_face->liga_count = b.count;
+
+	NSLOG(netsurf, INFO, "face %s has %u ligatures",
+	      fb_face->fontfile != NULL ? fb_face->fontfile : "from memory",
+	      b.count);
+}
+
+/** The first ligature entry for a glyph, or NULL. Longest comes first. */
+static const struct fb_liga *fb_liga_find(fb_faceid_t *fb_face, FT_UInt g)
+{
+	unsigned lo = 0;
+	unsigned hi;
+
+	if (fb_face->liga_count == 0 || g >= fb_face->liga_glyphs ||
+	    (fb_face->liga_starts[g / 8] & (1 << (g % 8))) == 0) {
+		return NULL;
+	}
+	hi = fb_face->liga_count;
+	while (lo < hi) {
+		unsigned mid = lo + (hi - lo) / 2;
+
+		if (fb_face->liga[mid].first < g) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	if (lo < fb_face->liga_count && fb_face->liga[lo].first == g) {
+		return &fb_face->liga[lo];
+	}
+	return NULL;
+}
