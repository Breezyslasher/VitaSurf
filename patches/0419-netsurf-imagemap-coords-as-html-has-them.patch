+/** Whether a byte separates the numbers of a coords attribute. */
+static bool imagemap_coords_sep(char ch)
+{
+	return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\f' ||
+	       ch == '\r' || ch == ',' || ch == ';';
+}
+
+/**
+ * The numbers in a coords attribute, by HTML's rules for parsing a list
+ * of floating-point numbers (VitaSurf): separated by spaces, commas or
+ * semicolons, garbage before a number passed over, what follows its
+ * digits ignored, and a token with no number in it read as zero.
+ * NetSurf had split the attribute's own text in place with strtok,
+ * writing into libdom's string, and on commas alone, so a polygon
+ * written with spaces had no points and hovering over it asserted.
+ *
+ * \param data   The attribute's text
+ * \param len    Its length in bytes
+ * \param out    Receives a malloc'd array of the numbers, or NULL
+ * eturn how many numbers there are, or -1 on memory exhaustion
+ */
+static int
+imagemap_parse_coords(const char *data, size_t len, float **out)
+{
+	size_t pos = 0;
+	int n = 0, cap = 0;
+	float *nums = NULL;
+
+	*out = NULL;
+	while (pos < len && imagemap_coords_sep(data[pos]))
+		pos++;
+	while (pos < len) {
+		double v = 0, scale;
+		bool neg = false, digits = false;
+		size_t end;
+
+		/* leading garbage */
+		while (pos < len && !imagemap_coords_sep(data[pos]) &&
+		       !(data[pos] >= '0' && data[pos] <= '9') &&
+		       data[pos] != '.' && data[pos] != '-')
+			pos++;
+		end = pos;
+		while (end < len && !imagemap_coords_sep(data[end]))
+			end++;
+		/* the rules for parsing floating-point number values, on
+		 * the token from pos to end */
+		if (pos < end && data[pos] == '-') {
+			neg = true;
+			pos++;
+		}
+		while (pos < end && data[pos] >= '0' && data[pos] <= '9') {
+			v = v * 10 + (data[pos++] - '0');
+			digits = true;
+		}
+		if (pos + 1 < end && data[pos] == '.' &&
+		    data[pos + 1] >= '0' && data[pos + 1] <= '9') {
+			pos++;
+			for (scale = 0.1; pos < end &&
+			     data[pos] >= '0' && data[pos] <= '9'; scale /= 10) {
+				v += (data[pos++] - '0') * scale;
+				digits = true;
+			}
+		}
+		if (digits && pos < end && (data[pos] == 'e' ||
+					    data[pos] == 'E')) {
+			size_t e = pos + 1;
+			bool eneg = false;
+			int exp = 0;
+
+			if (e < end && (data[e] == '-' || data[e] == '+')) {
+				eneg = data[e] == '-';
+				e++;
+			}
+			if (e < end && data[e] >= '0' && data[e] <= '9') {
+				while (e < end && data[e] >= '0' &&
+				       data[e] <= '9') {
+					if (exp < 100)
+						exp = exp * 10 + (data[e] - '0');
+					e++;
+				}
+				while (exp-- > 0)
+					v = eneg ? v / 10 : v * 10;
+			}
+		}
+		if (!digits)
+			v = 0;
+		else if (neg)
+			v = -v;
+
+		if (n == cap) {
+			float *grown;
+
+			cap = cap == 0 ? 8 : cap * 2;
+			grown = realloc(nums, cap * sizeof(float));
+			if (grown == NULL) {
+				free(nums);
+				return -1;
+			}
+			nums = grown;
+		}
+		nums[n++] = (float) v;
+
+		pos = end;
+		while (pos < len && imagemap_coords_sep(data[pos]))
+			pos++;
+	}
+	*out = nums;
+	return n;
+}
