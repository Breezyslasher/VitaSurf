+/**
+ * The containment a box has (VitaSurf), a mask of css_contain_e kinds:
+ * those its contain property names, and those content-visibility auto
+ * and hidden imply (layout, style and paint, and size for hidden). A
+ * non-atomic inline box, a table's row or row group, and a box with no
+ * style of its own have none, as CSS Containment says.
+ */
+static inline unsigned box_containment(const struct box *box)
+{
+	unsigned kinds;
+
+	if (box->style == NULL)
+		return 0;
+	switch (box->type) {
+	case BOX_INLINE:
+	case BOX_INLINE_END:
+	case BOX_INLINE_CONTAINER:
+	case BOX_TEXT:
+	case BOX_BR:
+	case BOX_TABLE_ROW:
+	case BOX_TABLE_ROW_GROUP:
+	case BOX_NONE:
+		return 0;
+	default:
+		break;
+	}
+	kinds = css_computed_contain(box->style) & ~CSS_CONTAIN_NONE;
+	switch (css_computed_content_visibility(box->style)) {
+	case CSS_CONTENT_VISIBILITY_HIDDEN:
+		kinds |= CSS_CONTAIN_SIZE | CSS_CONTAIN_LAYOUT |
+				CSS_CONTAIN_STYLE | CSS_CONTAIN_PAINT;
+		break;
+	case CSS_CONTENT_VISIBILITY_AUTO:
+		kinds |= CSS_CONTAIN_LAYOUT | CSS_CONTAIN_STYLE |
+				CSS_CONTAIN_PAINT;
+		break;
+	default:
+		break;
+	}
+	return kinds;
+}
+
+/**
+ * Whether a box is a containing block for its absolutely positioned
+ * descendants and its own formatting context because of containment,
+ * as layout and paint containment make it (VitaSurf).
+ */
+static inline bool box_contains_layout(const struct box *box)
+{
+	return (box_containment(box) &
+			(CSS_CONTAIN_LAYOUT | CSS_CONTAIN_PAINT)) != 0;
+}
+
 static inline enum css_overflow_e box_overflow_x(const struct box *box)
 {
+	enum css_overflow_e overflow;
+
 	if (box->flags & OVERFLOW_VIEWPORT) {
 		return CSS_OVERFLOW_VISIBLE;
 	}
-	return css_computed_overflow_x(box->style);
+	overflow = css_computed_overflow_x(box->style);
+	/* paint containment clips what overflows, as clip does */
+	if (overflow == CSS_OVERFLOW_VISIBLE &&
+			(box_containment(box) & CSS_CONTAIN_PAINT) != 0)
+		return CSS_OVERFLOW_CLIP;
+	return overflow;
 }
 
 static inline enum css_overflow_e box_overflow_y(const struct box *box)
 {
+	enum css_overflow_e overflow;
+
 	if (box->flags & OVERFLOW_VIEWPORT) {
 		return CSS_OVERFLOW_VISIBLE;
 	}
-	return css_computed_overflow_y(box->style);
+	overflow = css_computed_overflow_y(box->style);
+	if (overflow == CSS_OVERFLOW_VISIBLE &&
+			(box_containment(box) & CSS_CONTAIN_PAINT) != 0)
+		return CSS_OVERFLOW_CLIP;
+	return overflow;
 }
 
