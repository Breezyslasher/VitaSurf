+/**
+ * An item's minimum contribution across, which an auto minimum track
+ * takes (CSS Grid 6.6, 12.5) (VitaSurf). While its width is auto or a
+ * percentage it is the item at its minimum width: its min-width when it
+ * has one, nothing of its content when it is a scroll container, else
+ * its content's min-content width. The min-content width alone had been
+ * taken, so a "1fr" column could not be narrower than its longest
+ * headline whatever the item said: yahoo.com's story cards, min-w-0 in
+ * a 130px and 1fr grid, laid their headlines out 1501px wide in 680.
+ */
+static int grid_item_min_contribution(const struct grid_item *it,
+		bool horizontal, int minc)
+{
+	const struct box *b = it->box;
+	css_fixed len = 0;
+	css_unit unit = CSS_UNIT_PX;
+	int outer;
+
+	if (!horizontal || b->style == NULL)
+		return minc;
+	if (css_computed_width(b->style, &len, &unit) != CSS_WIDTH_AUTO &&
+			unit != CSS_UNIT_PCT)
+		return minc;
+	if (!css_computed_min_width_is_auto(b->style)) {
+		outer = (it->min_width > 0 ? it->min_width : 0) +
+				lh__delta_outer_width(b);
+		return outer < 0 ? 0 : outer;
+	}
+	if (box_overflow_contains(css_computed_overflow_x(b->style))) {
+		outer = lh__delta_outer_width(b);
+		return outer < minc ? (outer < 0 ? 0 : outer) : minc;
+	}
+	return minc;
+}
