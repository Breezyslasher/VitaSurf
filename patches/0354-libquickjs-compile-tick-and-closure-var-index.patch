+/*
+ * A function the parser calls every few thousand tokens (VitaSurf).
+ * The interrupt handler is only ever called by the interpreter, so a
+ * compile of a large bundle, seconds on a slow machine, gave its
+ * embedder no chance to do anything else in that time. The handler
+ * cannot stop the compile.
+ */
+void JS_SetCompileTickHandler(JSRuntime *rt, JSCompileTickHandler *cb,
+                              void *opaque)
+{
+    rt->compile_tick = cb;
+    rt->compile_tick_opaque = opaque;
+    rt->compile_tick_count = JS_COMPILE_TICK_TOKENS;
+}
