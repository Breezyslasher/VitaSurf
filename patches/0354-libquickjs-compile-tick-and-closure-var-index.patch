+/*
+ * Indexes of a function's closure variables (VitaSurf). Looking one up
+ * walked the whole list, for every reference to an outer variable and
+ * for every name left for the global scope: a bundle whose functions
+ * capture hundreds of variables spent over half its compile in those
+ * walks (Speedtest's 4 MB bundle, 13.9 s on the Vita). Each index gives
+ * the first entry with its key, as the walks found, and is brought up
+ * to date with the list when used: entries are only ever appended, and
+ * a list emptied and refilled is indexed again from the start. Short
+ * lists are still walked.
+ */
+#define CV_INDEX_MIN 24
+
+static inline bool cv_is_special(JSAtom name)
+{
+    return name == JS_ATOM__var_ || name == JS_ATOM__arg_var_ ||
+           name == JS_ATOM__with_;
+}
+
+static inline uint32_t cv_ref_key(int var_idx, int closure_type)
+{
+    return ((uint32_t)var_idx << 3) | (uint32_t)closure_type;
+}
+
+static inline uint32_t cv_mix(uint32_t k)
+{
+    return k * 2654435761u;
+}
+
+/* false if there is no index (too short, or no memory): walk instead */
+static bool cv_index_update(JSContext *ctx, JSFunctionDef *fd)
+{
+    int n = fd->closure_var_count, i;
+    uint32_t mask;
+
+    if (n < CV_INDEX_MIN)
+        return false;
+    if (fd->cv_tab_count > n || n * 2 > fd->cv_tab_size) {
+        int size = 64, *ref, *name;
+        while (size < n * 4)
+            size <<= 1;
+        ref = js_malloc(ctx, sizeof(int) * size);
+        name = js_malloc(ctx, sizeof(int) * size);
+        if (!ref || !name) {
+            js_free(ctx, ref);
+            js_free(ctx, name);
+            return false;
+        }
+        memset(ref, 0xff, sizeof(int) * size);
+        memset(name, 0xff, sizeof(int) * size);
+        js_free(ctx, fd->cv_ref_tab);
+        js_free(ctx, fd->cv_name_tab);
+        fd->cv_ref_tab = ref;
+        fd->cv_name_tab = name;
+        fd->cv_tab_size = size;
+        fd->cv_tab_count = 0;
+        fd->cv_first_special = INT32_MAX;
+    }
+    mask = fd->cv_tab_size - 1;
+    for (i = fd->cv_tab_count; i < n; i++) {
+        JSClosureVar *cv = &fd->closure_var[i];
+        uint32_t key = cv_ref_key(cv->var_idx, cv->closure_type), h;
+        int j;
+
+        for (h = cv_mix(key) & mask; (j = fd->cv_ref_tab[h]) >= 0;
+             h = (h + 1) & mask) {
+            if (cv_ref_key(fd->closure_var[j].var_idx,
+                           fd->closure_var[j].closure_type) == key)
+                break;
+        }
+        if (j < 0)
+            fd->cv_ref_tab[h] = i;
+        for (h = cv_mix(cv->var_name) & mask; (j = fd->cv_name_tab[h]) >= 0;
+             h = (h + 1) & mask) {
+            if (fd->closure_var[j].var_name == cv->var_name)
+                break;
+        }
+        if (j < 0)
+            fd->cv_name_tab[h] = i;
+        if (cv_is_special(cv->var_name) && i < fd->cv_first_special)
+            fd->cv_first_special = i;
+    }
+    fd->cv_tab_count = n;
+    return true;
+}
+
+/* the first entry with this var_idx and closure_type, or -1 */
+static int cv_find_ref(JSFunctionDef *fd, int var_idx, int closure_type)
+{
+    uint32_t key = cv_ref_key(var_idx, closure_type), mask, h;
+    int j;
+
+    mask = fd->cv_tab_size - 1;
+    for (h = cv_mix(key) & mask; (j = fd->cv_ref_tab[h]) >= 0;
+         h = (h + 1) & mask) {
+        if (cv_ref_key(fd->closure_var[j].var_idx,
+                       fd->closure_var[j].closure_type) == key)
+            return j;
+    }
+    return -1;
+}
+
+/* the first entry with this name, or -1 */
+static int cv_find_name(JSFunctionDef *fd, JSAtom var_name)
+{
+    uint32_t mask = fd->cv_tab_size - 1, h;
+    int j;
+
+    for (h = cv_mix(var_name) & mask; (j = fd->cv_name_tab[h]) >= 0;
+         h = (h + 1) & mask) {
+        if (fd->closure_var[j].var_name == var_name)
+            return j;
+    }
+    return -1;
+}
