diff --git a/src/select/properties/line_clamp.c b/src/select/properties/line_clamp.c
new file mode 100644
index 0000000..d03674a
--- /dev/null
+++ b/src/select/properties/line_clamp.c
@@ -0,0 +1,79 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_line_clamp(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_LINE_CLAMP_INHERIT;
+	css_fixed count = 0;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case LINE_CLAMP_SET:
+			value = CSS_LINE_CLAMP_SET;
+			count = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(count));
+			break;
+		case LINE_CLAMP_NONE:
+			value = CSS_LINE_CLAMP_NONE;
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_line_clamp(state->computed, value, count);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_line_clamp_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_line_clamp(style, hint->status, hint->data.integer);
+}
+
+css_error css__initial_line_clamp(css_select_state *state)
+{
+	return set_line_clamp(state->computed, CSS_LINE_CLAMP_NONE, 0);
+}
+
+css_error css__copy_line_clamp(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	int32_t count = 0;
+	uint8_t type = get_line_clamp(from, &count);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_line_clamp(to, type, count);
+}
+
+css_error css__compose_line_clamp(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	int32_t count = 0;
+	uint8_t type = get_line_clamp(child, &count);
+
+	return css__copy_line_clamp(
+			type == CSS_LINE_CLAMP_INHERIT ? parent : child,
+			result);
+}
