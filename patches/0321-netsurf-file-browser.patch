+/** The most entries a folder lists; the page says how many it left out. */
+#define FILES_MAX_ENTRIES 2000
+
+/** The most of a text file shown, in bytes. */
+#define FILES_VIEW_MAX (512 * 1024)
+
+/** What the browser does with a file. */
+enum files_action {
+	FILES_NONE, /**< listed, not opened yet */
+	FILES_PAGE, /**< opened at its file: URL */
+	FILES_TEXT, /**< shown here as text */
+};
+
+/** A kind of file, by its extension (lower case, without the dot). */
+struct files_kind {
+	const char *ext;
+	const char *label;
+	enum files_action action;
+};
+
+static const struct files_kind kinds[] = {
+	{ "html", "HTML page", FILES_PAGE },
+	{ "htm", "HTML page", FILES_PAGE },
+	{ "xhtml", "HTML page", FILES_PAGE },
+	/* known, but not opened yet; a page loads its stylesheets */
+	{ "css", "Stylesheet", FILES_NONE },
+	{ "txt", "Text", FILES_NONE },
+	{ "log", "Text", FILES_NONE },
+	{ "ini", "Text", FILES_NONE },
+	{ "cfg", "Text", FILES_NONE },
+	{ "md", "Text", FILES_NONE },
+	{ "js", "Script", FILES_NONE },
