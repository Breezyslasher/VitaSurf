+	{ "jpeg", "Image", FILES_NONE },
+	{ "gif", "Image", FILES_NONE },
+	{ "webp", "Image", FILES_NONE },
+	{ "bmp", "Image", FILES_NONE },
+	{ "ico", "Image", FILES_NONE },
+	{ "ttf", "Font", FILES_NONE },
+	{ "otf", "Font", FILES_NONE },
+	{ "woff", "Font", FILES_NONE },
+	{ "woff2", "Font", FILES_NONE },
+	{ "mp3", "Audio", FILES_NONE },
+	{ "ogg", "Audio", FILES_NONE },
+	{ "wav", "Audio", FILES_NONE },
+	{ "mp4", "Video", FILES_NONE },
+	{ "pdf", "PDF", FILES_NONE },
+	{ "zip", "Archive", FILES_NONE },
+	{ "7z", "Archive", FILES_NONE },
+	{ "rar", "Archive", FILES_NONE },
+	{ "vpk", "Package", FILES_NONE },
+};
