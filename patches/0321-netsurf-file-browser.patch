+/**
+ * \file
+ * content generator for the about scheme file browser (VitaSurf)
+ *
+ * about:files lists the places to start from: on the Vita, its storage
+ * devices (vita/platform/vita_file.c), elsewhere the root folder.
+ * about:files?path=FOLDER/ lists a folder, folders first. A file is
+ * offered by what kinds[] says of its extension: a page opens at its
+ * file: URL (and loads the stylesheets it links to, as any page does),
+ * and the rest are listed without a link until the browser can open
+ * them. Adding a type is a row in kinds[]; FILES_TEXT shows a file here
+ * as text, for a kind that wants it.
+ *
+ * Only the browser itself may ask: a fetch that a page made (it has a
+ * referer, and that is not another about: page) is refused, so a site
+ * cannot list the files on the machine.
+ */
+
+#include <stdbool.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
