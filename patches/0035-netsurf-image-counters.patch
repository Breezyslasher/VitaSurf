 #include "utils/nsoption.h"
 #include "netsurf/content.h"
 #include "netsurf/misc.h"
@@ -203,6 +204,10 @@ html_object_callback(hlcache_handle *object,
 		c->base.active--;
 		NSLOG(netsurf, INFO, "%d fetches active", c->base.active);
 
+		/* for the load profile (VitaSurf) */
+		if (content_get_type(object) == CONTENT_IMAGE)
+			vitasurf_images_done++;
+
 		html_object_done(box, object, o->background, o->mask);
 
 		if (c->base.status != CONTENT_STATUS_LOADING &&
@@ -236,6 +241,9 @@ html_object_callback(hlcache_handle *object,
 		c->base.active--;
 		NSLOG(netsurf, INFO, "%d fetches active", c->base.active);
 
+		/* for the load profile (VitaSurf) */
+		vitasurf_images_failed++;
+
 		html_object_failed(box, c, o->background);
 
 		break;
@@ -803,6 +811,10 @@ html_fetch_object_role(html_content *c,
 		return error != NSERROR_NOMEM;
 	}
 
+	/* for the load profile (VitaSurf) */
+	if (object->permitted_types & CONTENT_IMAGE)
+		vitasurf_images_asked++;
+
 	/* add to content object list */
 	object->next = c->object_list;
 	c->object_list = object;
