+/**
+ * Images the page asked for, decoded, and failed (VitaSurf).
+ *
+ * "images 0 ms" on a page full of pictures says nothing about whether
+ * any were fetched: an image that never arrives costs no decode time
+ * and neither does one the build cannot decode. These three do say it.
+ */
+extern unsigned int vitasurf_images_asked;
+extern unsigned int vitasurf_images_done;
+extern unsigned int vitasurf_images_failed;
 extern unsigned int vitasurf_ms_boxes;
