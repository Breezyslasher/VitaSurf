--- a/content/handlers/image/svg.c
+++ b/content/handlers/image/svg.c
@@ -135,6 +135,18 @@ static void svg_reformat(struct content *c, int width, int height)
 
 	/* Avoid reformats to same width/height as we already reformatted to */
 	if (width != svg->current_width || height != svg->current_height) {
+		struct svgtiny_diagram *fresh;
+
+		/* svgtiny_parse appends to the diagram, so parsing again at
+		 * a new size kept every earlier shape (VitaSurf): the stale
+		 * copies were drawn on every redraw and leaked memory. */
+		fresh = svgtiny_create();
+		if (fresh == NULL) {
+			return;
+		}
+		svgtiny_free(svg->diagram);
+		svg->diagram = fresh;
+
 		source_data = content__get_source_data(c, &source_size);
 
