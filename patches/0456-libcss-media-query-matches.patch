+/*
+ * Whether a media query list matches the media given (VitaSurf): the
+ * same parse and match an @media rule or a sheet's media attribute
+ * gets, for a client that has a media query outside any sheet, as the
+ * HTML standard's <source media> and sizes attribute are. An empty
+ * list matches; one that does not parse does not.
+ */
+css_error css_media_query_matches(const char *mq, size_t len,
+		const css_unit_ctx *unit_ctx, const css_media *media,
+		bool *match)
+{
+	css_select_strings str;
+	lwc_string **strings;
+	css_mq_query *q = NULL;
+	css_error error;
+
+	if (mq == NULL || unit_ctx == NULL || media == NULL || match == NULL)
+		return CSS_BADPARM;
+
+	*match = false;
+	while (len > 0 && (*mq == ' ' || *mq == '\t' || *mq == '\n' ||
+			*mq == '\r' || *mq == '\f')) {
+		mq++;
+		len--;
+	}
+	if (len == 0) {
+		*match = true;
+		return CSS_OK;
+	}
+
+	error = css__propstrings_get(&strings);
+	if (error != CSS_OK)
+		return error;
+
+	error = css_parse_media_query(strings, (const uint8_t *) mq, len, &q);
+	if (error == CSS_OK && q != NULL) {
+		memset(&str, 0, sizeof(str));
+		error = css_select_strings_intern(&str);
+		if (error == CSS_OK) {
+			*match = mq__list_match(q, unit_ctx, media, &str);
+			css_select_strings_unref(&str);
+		}
+		css__mq_query_destroy(q);
+	} else if (error != CSS_NOMEM) {
+		error = CSS_OK;
+	}
+
+	css__propstrings_unref();
+	return error;
+}
