+/**
+ * Should this element's attribute names be folded to lower case?
+ *
+ * Only HTML is case insensitive (VitaSurf). Folding every name also
+ * renamed the attributes of foreign elements, so an inline <svg> was
+ * left holding viewbox and gradientunits, which mean nothing to an SVG
+ * parser and left every such graphic unscaled.
+ */
+static bool html_element_folds_case(struct dom_element *element)
+{
+	dom_string *namespace = NULL;
+	bool folds = true;
+
+	if (dom_node_get_namespace(element, &namespace) != DOM_NO_ERR) {
+		return true;
+	}
+	if (namespace != NULL) {
+		folds = dom_string_isequal(namespace,
+				dom_namespaces[DOM_NAMESPACE_HTML]);
+		dom_string_unref(namespace);
+	}
+	return folds;
+}
+
