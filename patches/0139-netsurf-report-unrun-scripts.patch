+/* exported interface documented in html/private.h */
+void html_report_scripts(html_content *c)
+{
+	unsigned int i, ran = 0, meant = 0;
+	struct html_script *s;
+	static const char *kind[] = {
+		"inline", "sync", "defer", "async", "preload"
+	};
+
+	if (c == NULL || c->scripts_count == 0 || c->scripts_reported) {
+		return;
+	}
+
+	/* a preload is fetched to be ready, never to be run on its own */
+	for (i = 0, s = c->scripts; i != c->scripts_count; i++, s++) {
+		if (s->type == HTML_SCRIPT_PRELOAD) {
+			continue;
+		}
+		meant++;
+		if (s->already_started) {
+			ran++;
+		}
+	}
+	if (ran == meant) {
+		return;		/* nothing to explain */
+	}
+
+	/*
+	 * A page whose last bundle is the one that mounts its app looks
+	 * exactly like a page still loading, and until now the log said
+	 * only how many scripts had compiled, never which ones were left
+	 * (VitaSurf).
+	 */
+	c->scripts_reported = true;
+	vita_log("scripts: %u of %u ran", ran, meant);
+	for (i = 0, s = c->scripts; i != c->scripts_count; i++, s++) {
+		if (s->already_started || s->type == HTML_SCRIPT_PRELOAD) {
+			continue;
+		}
+		{
+			nsurl *url = NULL;
+
+			if (s->type != HTML_SCRIPT_INLINE &&
+					s->data.handle != NULL) {
+				url = hlcache_handle_get_url(s->data.handle);
+			}
+			vita_log("scripts: %u %s not run, %s: %s", i,
+				 (unsigned) s->type < 5 ? kind[s->type] : "?",
+				 s->data.handle == NULL ? "no content" :
+					(content_get_status(s->data.handle) ==
+						CONTENT_STATUS_DONE ?
+						"content is complete and "
+						"waiting" :
+						"content is still arriving"),
+				 url != NULL ? nsurl_access(url) : "<no url>");
+		}
+	}
+}
+
