+css_error css__cascade_webkit_text_fill_color(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	enum flag_value flag_value = getFlagValue(opv);
+	uint16_t value = CSS_WEBKIT_TEXT_FILL_COLOR_INHERIT;
+	css_color color = 0;
+
+	if (flag_value == FLAG_VALUE__NONE) {
