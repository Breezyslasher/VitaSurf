+/**
+ * Parse outline-offset (VitaSurf): a length, or a calc() that reduces to
+ * one, as GitHub's calc(.0625rem * -1) does.
+ */
+css_error css__parse_outline_offset_length(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, enum css_properties_e op)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_fixed length = 0;
+	uint32_t unit = 0;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value, op);
+	}
+
+	if (token->type == CSS_TOKEN_FUNCTION) {
+		error = css__parse_calc_reduced(c, vector, ctx, &length, &unit);
+	} else {
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				&length, &unit);
+	}
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	if ((unit & UNIT_MASK_OUTLINE_OFFSET) == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	error = css__stylesheet_style_appendOPV(result, op, 0,
+			OUTLINE_OFFSET_SET);
+	if (error == CSS_OK) {
+		error = css__stylesheet_style_vappend(result, 2, length, unit);
+	}
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+	return error;
+}
