diff --git a/src/select/properties/white_space.c b/src/select/properties/white_space.c
index edc35cd..429a74a 100644
--- a/src/select/properties/white_space.c
+++ b/src/select/properties/white_space.c
@@ -14,13 +14,114 @@
 #include "select/properties/properties.h"
 #include "select/properties/helpers.h"
 
+/*
+ * white-space as its two halves (VitaSurf): how spaces and newlines are
+ * kept (collapse), and whether lines wrap. 0 for a half means not
+ * given, to be had from the parent.
+ */
+enum { WS_C_INHERIT, WS_C_COLLAPSE, WS_C_PRESERVE, WS_C_BREAKS };
+enum { WS_W_INHERIT, WS_W_WRAP, WS_W_NOWRAP };
+
+static void ws_split(uint8_t v, int *c, int *w)
+{
+	switch (v) {
+	case CSS_WHITE_SPACE_NORMAL: *c = WS_C_COLLAPSE; *w = WS_W_WRAP; break;
+	case CSS_WHITE_SPACE_NOWRAP: *c = WS_C_COLLAPSE; *w = WS_W_NOWRAP; break;
+	case CSS_WHITE_SPACE_PRE: *c = WS_C_PRESERVE; *w = WS_W_NOWRAP; break;
+	case CSS_WHITE_SPACE_PRE_WRAP: *c = WS_C_PRESERVE; *w = WS_W_WRAP; break;
+	case CSS_WHITE_SPACE_PRE_LINE: *c = WS_C_BREAKS; *w = WS_W_WRAP; break;
+	case CSS_WHITE_SPACE_INHERIT_WRAP: *c = WS_C_INHERIT; *w = WS_W_WRAP; break;
+	case CSS_WHITE_SPACE_INHERIT_NOWRAP: *c = WS_C_INHERIT; *w = WS_W_NOWRAP; break;
+	case CSS_WHITE_SPACE_INHERIT_COLLAPSE: *c = WS_C_COLLAPSE; *w = WS_W_INHERIT; break;
+	case CSS_WHITE_SPACE_INHERIT_PRESERVE: *c = WS_C_PRESERVE; *w = WS_W_INHERIT; break;
+	case CSS_WHITE_SPACE_INHERIT_PRESERVE_BREAKS: *c = WS_C_BREAKS; *w = WS_W_INHERIT; break;
+	default: *c = WS_C_INHERIT; *w = WS_W_INHERIT; break;
+	}
+}
+
+static uint8_t ws_join(int c, int w)
+{
+	if (c == WS_C_INHERIT && w == WS_W_INHERIT)
+		return CSS_WHITE_SPACE_INHERIT;
+	if (c == WS_C_INHERIT)
+		return w == WS_W_WRAP ? CSS_WHITE_SPACE_INHERIT_WRAP :
+				CSS_WHITE_SPACE_INHERIT_NOWRAP;
+	if (w == WS_W_INHERIT)
+		return c == WS_C_COLLAPSE ? CSS_WHITE_SPACE_INHERIT_COLLAPSE :
+				c == WS_C_PRESERVE ?
+				CSS_WHITE_SPACE_INHERIT_PRESERVE :
+				CSS_WHITE_SPACE_INHERIT_PRESERVE_BREAKS;
+	if (c == WS_C_COLLAPSE)
+		return w == WS_W_WRAP ? CSS_WHITE_SPACE_NORMAL :
+				CSS_WHITE_SPACE_NOWRAP;
+	if (c == WS_C_PRESERVE)
+		return w == WS_W_WRAP ? CSS_WHITE_SPACE_PRE_WRAP :
+				CSS_WHITE_SPACE_PRE;
+	/* preserve-breaks without wrapping has no white-space of its
+	 * own; newlines are kept as pre keeps them */
+	return w == WS_W_WRAP ? CSS_WHITE_SPACE_PRE_LINE :
+			CSS_WHITE_SPACE_PRE;
+}
+
+/** Fill the halves a value leaves open from another. */
+static uint8_t ws_over(uint8_t v, uint8_t base)
+{
+	int c, w, bc, bw;
+
+	ws_split(v, &c, &w);
+	ws_split(base, &bc, &bw);
+	return ws_join(c != WS_C_INHERIT ? c : bc, w != WS_W_INHERIT ? w : bw);
+}
+
+/* exported function documented in select/computed.h (VitaSurf) */
+uint8_t css__white_space_resolved(uint8_t v)
+{
+	return ws_over(v, CSS_WHITE_SPACE_NORMAL);
+}
+
 css_error css__cascade_white_space(uint32_t opv, css_style *style,
 		css_select_state *state)
 {
 	uint16_t value = CSS_WHITE_SPACE_INHERIT;
+	uint16_t half = 0;
 
 	UNUSED(style);
 
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case WHITE_SPACE_SET_WRAP:
+			half = CSS_WHITE_SPACE_INHERIT_WRAP;
+			break;
+		case WHITE_SPACE_SET_NOWRAP:
+			half = CSS_WHITE_SPACE_INHERIT_NOWRAP;
+			break;
+		case WHITE_SPACE_SET_COLLAPSE:
+			half = CSS_WHITE_SPACE_INHERIT_COLLAPSE;
+			break;
+		case WHITE_SPACE_SET_PRESERVE:
+			half = CSS_WHITE_SPACE_INHERIT_PRESERVE;
+			break;
+		case WHITE_SPACE_SET_PRESERVE_BREAKS:
+			half = CSS_WHITE_SPACE_INHERIT_PRESERVE_BREAKS;
+			break;
+		}
+	}
+
+	if (half != 0) {
+		/* the other half is whatever this element was given before,
+		 * or its parent's if nothing yet (VitaSurf) */
+		bool had = state->props[CSS_PROP_WHITE_SPACE][
+				state->current_pseudo].set;
+		uint8_t before = get_white_space(state->computed);
+
+		if (css__outranks_existing(getOpcode(opv), isImportant(opv),
+				state, FLAG_VALUE__NONE)) {
+			return set_white_space(state->computed,
+					had ? ws_over(half, before) : half);
+		}
+		return CSS_OK;
+	}
+
 	if (hasFlagValue(opv) == false) {
 		switch (getValue(opv)) {
 		case WHITE_SPACE_NORMAL:
@@ -77,6 +178,11 @@ css_error css__compose_white_space(const css_computed_style *parent,
 {
 	uint8_t type = get_white_space(child);
 
+	/* one half given, the other the parent's (VitaSurf) */
+	if (type >= CSS_WHITE_SPACE_INHERIT_WRAP)
+		return set_white_space(result,
+				ws_over(type, get_white_space(parent)));
+
 	return css__copy_white_space(
 			type == CSS_WHITE_SPACE_INHERIT ? parent : child,
 			result);
diff --git a/src/select/properties/zoom.c b/src/select/properties/zoom.c
new file mode 100644
index 0000000..2080802
--- /dev/null
+++ b/src/select/properties/zoom.c
@@ -0,0 +1,83 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/*
+ * zoom (VitaSurf). The cascade stores the element's own factor; the
+ * composed style holds the effective zoom, that factor times the
+ * parent's effective zoom, which is what a length on the element is
+ * multiplied by. An element that gives none inherits its parent's.
+ */
+
+css_error css__cascade_zoom(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_ZOOM_INHERIT;
+	css_fixed zoom = INTTOFIX(1);
+
+	if (hasFlagValue(opv) == false) {
+		value = CSS_ZOOM_SET;
+		zoom = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(zoom));
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_zoom(state->computed, value, zoom);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_zoom_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_zoom(style, hint->status, hint->data.fixed);
+}
+
+css_error css__initial_zoom(css_select_state *state)
+{
+	return set_zoom(state->computed, CSS_ZOOM_SET, INTTOFIX(1));
+}
+
+css_error css__copy_zoom(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed zoom = INTTOFIX(1);
+	uint8_t type = get_zoom(from, &zoom);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_zoom(to, type, zoom);
+}
+
+css_error css__compose_zoom(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed zoom = INTTOFIX(1), pzoom = INTTOFIX(1);
+	uint8_t type = get_zoom(child, &zoom);
+
+	if (type == CSS_ZOOM_INHERIT)
+		return css__copy_zoom(parent, result);
+
+	/* own factor times the parent's effective zoom */
+	if (get_zoom(parent, &pzoom) != CSS_ZOOM_SET)
+		pzoom = INTTOFIX(1);
+	return set_zoom(result, CSS_ZOOM_SET, FMUL(zoom, pzoom));
+}
