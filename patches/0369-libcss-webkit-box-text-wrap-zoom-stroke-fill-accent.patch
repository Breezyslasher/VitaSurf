 }
+
+/*
+ * The old WebKit flexbox (VitaSurf): display: -webkit-box is a flex
+ * container (see CSS_DISPLAY_WEBKIT_BOX), and its properties are read
+ * as the standard ones they became. -webkit-box-align and
+ * -webkit-box-pack take the same keywords as the IE draft's
+ * -ms-flex-align and -ms-flex-pack, -webkit-box-flex is flex-grow and
+ * -webkit-box-ordinal-group is order. A page that wrote both spellings
+ * gets the same answer from either.
+ */
+
+/** Read one keyword into a standard property, or fail. */
+static css_error parse_box_keyword(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, uint16_t prop,
+		const struct ms_keyword *table, size_t n)
+{
+	const css_token *token;
+	bool match;
+	size_t i;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL || token->type != CSS_TOKEN_IDENT)
+		return CSS_INVALID;
+	for (i = 0; i < n; i++) {
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[table[i].string],
+				&match) == lwc_error_ok && match) {
+			parserutils_vector_iterate(vector, ctx);
+			if (prop == 0)
+				return CSS_OK;	/* accepted, no effect */
+			return css__stylesheet_style_appendOPV(result,
+					prop, 0, table[i].value);
+		}
+	}
+	return CSS_INVALID;
+}
+
+/** -webkit-box-orient: horizontal | inline-axis | vertical | block-axis */
+css_error css__parse_webkit_box_orient(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct ms_keyword table[] = {
+		{ HORIZONTAL, FLEX_DIRECTION_ROW },
+		{ INLINE_AXIS, FLEX_DIRECTION_ROW },
+		{ VERTICAL, FLEX_DIRECTION_COLUMN },
+		{ BLOCK_AXIS, FLEX_DIRECTION_COLUMN },
+	};
+
+	return parse_box_keyword(c, vector, ctx, result,
+			CSS_PROP_FLEX_DIRECTION, table, 4);
+}
+
+/**
+ * -webkit-box-direction: normal | reverse. Accepted: the reverse of a
+ * direction depends on the orient beside it, which may be in another
+ * rule, and pages write it as normal all but always.
+ */
+css_error css__parse_webkit_box_direction(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct ms_keyword table[] = {
+		{ NORMAL, 0 },
+		{ REVERSE, 0 },
+	};
+
+	return parse_box_keyword(c, vector, ctx, result, 0, table, 2);
+}
+
+/** -webkit-box-lines: single | multiple */
+css_error css__parse_webkit_box_lines(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct ms_keyword table[] = {
+		{ SINGLE, FLEX_WRAP_NOWRAP },
+		{ MULTIPLE, FLEX_WRAP_WRAP },
+	};
+
+	return parse_box_keyword(c, vector, ctx, result,
+			CSS_PROP_FLEX_WRAP, table, 2);
+}
