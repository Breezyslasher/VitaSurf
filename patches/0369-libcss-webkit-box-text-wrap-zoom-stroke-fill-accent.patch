diff --git a/src/select/properties/stroke.c b/src/select/properties/stroke.c
new file mode 100644
index 0000000..2ed8ab0
--- /dev/null
+++ b/src/select/properties/stroke.c
@@ -0,0 +1,357 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/*
+ * SVG's stroke geometry (VitaSurf): stroke-dasharray, stroke-dashoffset,
+ * stroke-linecap, stroke-linejoin and stroke-miterlimit, all inherited.
+ */
+
+/* stroke-dasharray */
+
+css_error css__cascade_stroke_dasharray(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_STROKE_DASHARRAY_INHERIT;
+	lwc_string *dashes = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case STROKE_DASHARRAY_NONE:
+			value = CSS_STROKE_DASHARRAY_NONE;
+			break;
+		case STROKE_DASHARRAY_SET:
+			value = CSS_STROKE_DASHARRAY_SET;
+			css__stylesheet_string_get(style->sheet,
+					*((css_code_t *) style->bytecode),
+					&dashes);
+			advance_bytecode(style, sizeof(css_code_t));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_stroke_dasharray(state->computed, value, dashes);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_stroke_dasharray_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error;
+
+	error = set_stroke_dasharray(style, hint->status, hint->data.string);
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+	return error;
+}
+
+css_error css__initial_stroke_dasharray(css_select_state *state)
+{
+	return set_stroke_dasharray(state->computed,
+			CSS_STROKE_DASHARRAY_NONE, NULL);
+}
+
+css_error css__copy_stroke_dasharray(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *dashes;
+	uint8_t type = get_stroke_dasharray(from, &dashes);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_stroke_dasharray(to, type, dashes);
+}
+
+css_error css__compose_stroke_dasharray(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *dashes;
+	uint8_t type = get_stroke_dasharray(child, &dashes);
+
+	return css__copy_stroke_dasharray(
+			type == CSS_STROKE_DASHARRAY_INHERIT ? parent : child,
+			result);
+}
+
+/* stroke-dashoffset */
+
+css_error css__cascade_stroke_dashoffset(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_STROKE_DASHOFFSET_INHERIT;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false) {
+		value = CSS_STROKE_DASHOFFSET_SET;
+		length = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(length));
+		unit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(unit));
+	}
+
+	unit = css__to_css_unit(unit);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_stroke_dashoffset(state->computed, value, length,
+				unit);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_stroke_dashoffset_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_stroke_dashoffset(style, hint->status,
+			hint->data.length.value, hint->data.length.unit);
+}
+
+css_error css__initial_stroke_dashoffset(css_select_state *state)
+{
+	return set_stroke_dashoffset(state->computed,
+			CSS_STROKE_DASHOFFSET_SET, 0, CSS_UNIT_PX);
+}
+
+css_error css__copy_stroke_dashoffset(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
