+			break;
+		case WEBKIT_TEXT_FILL_COLOR_SET:
+			value = CSS_WEBKIT_TEXT_FILL_COLOR_COLOR;
+			color = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(color));
+			break;
+		}
+	}
