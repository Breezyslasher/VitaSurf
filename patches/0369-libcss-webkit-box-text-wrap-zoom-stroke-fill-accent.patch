diff --git a/src/select/properties/accent_color.c b/src/select/properties/accent_color.c
new file mode 100644
index 0000000..c65c75c
--- /dev/null
+++ b/src/select/properties/accent_color.c
@@ -0,0 +1,89 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2012 Michael Drake <tlsa@netsurf-browser.org>
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_accent_color(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	enum flag_value flag_value = getFlagValue(opv);
+	uint16_t value = CSS_ACCENT_COLOR_INHERIT;
+	css_color color = 0;
+
+	if (flag_value == FLAG_VALUE__NONE) {
+		switch (getValue(opv)) {
+		case ACCENT_COLOR_TRANSPARENT:
+			value = CSS_ACCENT_COLOR_COLOR;
+			break;
+		case ACCENT_COLOR_CURRENT_COLOR:
+			/* kept as the keyword, which inherits as one
+			 * (VitaSurf) */
+			value = CSS_ACCENT_COLOR_CURRENT_COLOR;
+			break;
+		case ACCENT_COLOR_AUTO:
+			value = CSS_ACCENT_COLOR_AUTO;
+			break;
+		case ACCENT_COLOR_SET:
+			value = CSS_ACCENT_COLOR_COLOR;
+			color = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(color));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			flag_value)) {
+		return set_accent_color(state->computed, value, color);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_accent_color_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_accent_color(style, hint->status, hint->data.color);
+}
+
+css_error css__initial_accent_color(css_select_state *state)
+{
+	return set_accent_color(state->computed, CSS_ACCENT_COLOR_AUTO, 0);
+}
+
+css_error css__copy_accent_color(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_color color;
+	uint8_t type = get_accent_color(from, &color);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_accent_color(to, type, color);
+}
+
+css_error css__compose_accent_color(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_color color;
+	uint8_t type = get_accent_color(child, &color);
+
+	return css__copy_accent_color(
+			type == CSS_ACCENT_COLOR_INHERIT ? parent : child,
+			result);
+}
+
