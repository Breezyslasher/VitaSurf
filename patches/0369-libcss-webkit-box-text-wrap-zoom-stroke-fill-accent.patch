index 0000000..209ca14
--- /dev/null
+++ b/src/parse/properties/stroke.c
@@ -0,0 +1,330 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * SVG's stroke geometry (VitaSurf): stroke-dasharray, stroke-dashoffset,
+ * stroke-linecap, stroke-linejoin and stroke-miterlimit. NetSurf draws
+ * an inline SVG from its markup, with the root's paint written into it
+ * from its computed style, so these are read the same way. A dash array
+ * is kept as its lengths in pixels, joined by commas, as the markup's
+ * attribute would give them.
+ */
+
+/** Pixels in an absolute length, or false for a relative one. */
+static bool stroke_px(css_fixed v, uint32_t unit, css_fixed *px)
+{
+	switch (unit) {
+	case UNIT_PX: *px = v; return true;
+	case UNIT_IN: *px = FMUL(v, INTTOFIX(96)); return true;
+	case UNIT_CM: *px = FMUL(v, FLTTOFIX(37.795276f)); return true;
+	case UNIT_MM: *px = FMUL(v, FLTTOFIX(3.7795276f)); return true;
+	case UNIT_Q:  *px = FMUL(v, FLTTOFIX(0.9448819f)); return true;
+	case UNIT_PT: *px = FDIV(FMUL(v, INTTOFIX(4)), INTTOFIX(3));
+		return true;
+	case UNIT_PC: *px = FMUL(v, INTTOFIX(16)); return true;
+	default: return false;
+	}
+}
+
+/** A flag value (inherit, initial and the rest), if that is what's next. */
+static bool stroke_flag(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, css_style *result, enum css_properties_e op,
+		css_error *error)
+{
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+
+	if (token == NULL)
+		return false;
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value == FLAG_VALUE__NONE)
+		return false;
+	parserutils_vector_iterate(vector, ctx);
+	*error = css_stylesheet_style_flag_value(result, flag_value, op);
+	return true;
+}
+
+/**
+ * Parse stroke-dasharray: none | [ <length> | <number> ]#, the list
+ * separated by commas, spaces or both. Percentages and lengths relative
+ * to a font are not reduced, and such a list is dropped.
+ */
+css_error css__parse_stroke_dasharray(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	char buf[256];
+	size_t len = 0;
+	int n = 0;
+	css_error error;
+	bool match;
+	lwc_string *str;
+	uint32_t snumber;
+
+	if (stroke_flag(c, vector, ctx, result, CSS_PROP_STROKE_DASHARRAY,
+			&error))
+		return error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+	if (token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[NONE], &match) == lwc_error_ok &&
+			match) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_STROKE_DASHARRAY, 0,
+				STROKE_DASHARRAY_NONE);
+	}
+
+	while (1) {
+		css_fixed v = 0, px = 0;
+		uint32_t unit = UNIT_PX;
+		int w;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || token->type == CSS_TOKEN_EOF ||
+				tokenIsChar(token, '!') ||
+				tokenIsChar(token, ';'))
+			break;
+		if (n > 0 && tokenIsChar(token, ',')) {
+			parserutils_vector_iterate(vector, ctx);
+			consumeWhitespace(vector, ctx);
+			token = parserutils_vector_peek(vector, *ctx);
+			if (token == NULL)
+				break;
+		}
+
+		if (token->type == CSS_TOKEN_NUMBER) {
+			size_t consumed = 0;
+
+			v = css__number_from_lwc_string(token->idata, false,
+					&consumed);
+			if (consumed != lwc_string_length(token->idata)) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			parserutils_vector_iterate(vector, ctx);
+			px = v;
+		} else if (token->type == CSS_TOKEN_FUNCTION) {
+			error = css__parse_calc_reduced(c, vector, ctx, &v,
+					&unit);
+			if (error != CSS_OK || !stroke_px(v, unit, &px)) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		} else {
+			error = css__parse_unit_specifier(c, vector, ctx,
+					UNIT_PX, &v, &unit);
+			if (error != CSS_OK || !stroke_px(v, unit, &px)) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		}
+		if (px < 0 || n == 32) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+
+		w = snprintf(buf + len, sizeof(buf) - len, "%s%d.%03d",
+				n > 0 ? "," : "", FIXTOINT(px),
+				(int) ((px & 0x3ff) * 1000 / 1024));
+		if (w < 0 || (size_t) w >= sizeof(buf) - len) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		len += w;
+		n++;
+	}
+	if (n == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (lwc_intern_string(buf, len, &str) != lwc_error_ok) {
+		*ctx = orig_ctx;
+		return CSS_NOMEM;
+	}
+	error = css__stylesheet_string_add(c->sheet, str, &snumber);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_STROKE_DASHARRAY, 0,
+				STROKE_DASHARRAY_SET);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_append(result, snumber);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/**
+ * Parse stroke-dashoffset: <length-percentage> | <number>
+ */
+css_error css__parse_stroke_dashoffset(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+	css_error error;
+
+	if (stroke_flag(c, vector, ctx, result, CSS_PROP_STROKE_DASHOFFSET,
+			&error))
+		return error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+	if (token->type == CSS_TOKEN_NUMBER) {
+		size_t consumed = 0;
+
+		length = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+		if (consumed != lwc_string_length(token->idata))
+			return CSS_INVALID;
+		parserutils_vector_iterate(vector, ctx);
+	} else if (token->type == CSS_TOKEN_FUNCTION) {
+		error = css__parse_calc_reduced(c, vector, ctx, &length,
+				&unit);
+		if (error != CSS_OK)
+			return error;
+	} else {
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				&length, &unit);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	}
+	if ((unit & (UNIT_LENGTH | UNIT_PCT)) == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_STROKE_DASHOFFSET, 0, STROKE_DASHOFFSET_SET);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_vappend(result, 2, length, unit);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/** One keyword of a list, as its value, or -1. */
+static int stroke_keyword(css_language *c, const css_token *token,
+		const int *names, const int *values, int n)
+{
+	bool match;
+	int i;
+
+	if (token == NULL || token->type != CSS_TOKEN_IDENT)
+		return -1;
+	for (i = 0; i < n; i++) {
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[names[i]], &match) ==
+				lwc_error_ok && match)
+			return values[i];
+	}
+	return -1;
+}
+
+/**
+ * Parse stroke-linecap: butt | round | square
+ */
+css_error css__parse_stroke_linecap(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const int names[] = { BUTT, ROUND, SQUARE };
+	static const int values[] = { STROKE_LINECAP_BUTT,
+		STROKE_LINECAP_ROUND, STROKE_LINECAP_SQUARE };
+	css_error error;
+	int v;
+
+	if (stroke_flag(c, vector, ctx, result, CSS_PROP_STROKE_LINECAP,
+			&error))
+		return error;
+	v = stroke_keyword(c, parserutils_vector_peek(vector, *ctx), names,
+			values, 3);
+	if (v < 0)
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_STROKE_LINECAP, 0, v);
+}
+
+/**
+ * Parse stroke-linejoin: miter | miter-clip | round | bevel | arcs
+ */
+css_error css__parse_stroke_linejoin(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const int names[] = { MITER, MITER_CLIP, ROUND, BEVEL, ARCS };
+	static const int values[] = { STROKE_LINEJOIN_MITER,
+		STROKE_LINEJOIN_MITER_CLIP, STROKE_LINEJOIN_ROUND,
+		STROKE_LINEJOIN_BEVEL, STROKE_LINEJOIN_ARCS };
+	css_error error;
+	int v;
+
+	if (stroke_flag(c, vector, ctx, result, CSS_PROP_STROKE_LINEJOIN,
+			&error))
+		return error;
+	v = stroke_keyword(c, parserutils_vector_peek(vector, *ctx), names,
+			values, 5);
+	if (v < 0)
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_STROKE_LINEJOIN, 0, v);
+}
+
+/**
+ * Parse stroke-miterlimit: <number>, at least 1
+ */
+css_error css__parse_stroke_miterlimit(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	const css_token *token;
+	css_fixed limit;
+	size_t consumed = 0;
+	css_error error;
+
+	if (stroke_flag(c, vector, ctx, result, CSS_PROP_STROKE_MITERLIMIT,
+			&error))
+		return error;
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL || token->type != CSS_TOKEN_NUMBER)
+		return CSS_INVALID;
+	limit = css__number_from_lwc_string(token->idata, false, &consumed);
+	if (consumed != lwc_string_length(token->idata) ||
+			limit < INTTOFIX(1))
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_STROKE_MITERLIMIT, 0, STROKE_MITERLIMIT_SET);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_append(result, limit);
+	return error;
+}
diff --git a/src/parse/properties/text_wrap.c b/src/parse/properties/text_wrap.c
new file mode 100644
index 0000000..fdc34da
--- /dev/null
+++ b/src/parse/properties/text_wrap.c
@@ -0,0 +1,207 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * The halves of white-space (VitaSurf). CSS Text 4 split white-space
+ * into white-space-collapse (how spaces and newlines are kept) and
+ * text-wrap-mode (whether lines wrap), with text-wrap the shorthand for
+ * text-wrap-mode and text-wrap-style. Tailwind's text-nowrap is
+ * text-wrap: nowrap, and was ignored. Each is stored as a white-space
+ * declaration that sets one half, which the cascade combines with the
+ * other half from the element's white-space or, failing that, its
+ * parent's (see select/properties/white_space.c).
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+static bool is_word(css_language *c, const css_token *token, int string)
+{
+	bool match = false;
+
+	return token != NULL && token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[string], &match) == lwc_error_ok &&
+			match;
+}
+
+/** A keyword that leaves the property as it would be anyway. */
+static bool is_global(css_language *c, const css_token *token)
+{
+	return is_word(c, token, INHERIT) || is_word(c, token, INITIAL) ||
+			is_word(c, token, UNSET) || is_word(c, token, REVERT);
+}
+
+/**
+ * text-wrap: [ wrap | nowrap ] || [ auto | balance | stable | pretty ].
+ * The style is not acted on; the mode not given is wrap, as a
+ * shorthand resets what it leaves out.
+ */
+css_error css__parse_text_wrap(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	bool mode = false, style = false, nowrap = false;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (is_global(c, token)) {
+		parserutils_vector_iterate(vector, ctx);
+		if (is_word(c, token, INHERIT))
+			return CSS_OK;
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_WHITE_SPACE, 0, WHITE_SPACE_SET_WRAP);
+	}
+
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!'))
+			break;
+		if (!mode && (is_word(c, token, WRAP_STRING) ||
+				is_word(c, token, NOWRAP))) {
+			mode = true;
+			nowrap = is_word(c, token, NOWRAP);
+		} else if (!style && (is_word(c, token, AUTO) ||
+				is_word(c, token, BALANCE) ||
+				is_word(c, token, STABLE) ||
+				is_word(c, token, PRETTY))) {
+			style = true;
+		} else {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		parserutils_vector_iterate(vector, ctx);
+	}
+	if (!mode && !style) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	return css__stylesheet_style_appendOPV(result, CSS_PROP_WHITE_SPACE, 0,
+			nowrap ? WHITE_SPACE_SET_NOWRAP : WHITE_SPACE_SET_WRAP);
+}
+
+/** text-wrap-mode: wrap | nowrap */
+css_error css__parse_text_wrap_mode(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	uint16_t value;
+
+	if (is_global(c, token)) {
+		parserutils_vector_iterate(vector, ctx);
+		if (is_word(c, token, INHERIT))
+			return CSS_OK;
+		value = WHITE_SPACE_SET_WRAP;
+	} else if (is_word(c, token, WRAP_STRING)) {
+		parserutils_vector_iterate(vector, ctx);
+		value = WHITE_SPACE_SET_WRAP;
+	} else if (is_word(c, token, NOWRAP)) {
+		parserutils_vector_iterate(vector, ctx);
+		value = WHITE_SPACE_SET_NOWRAP;
+	} else {
+		return CSS_INVALID;
+	}
+
+	return css__stylesheet_style_appendOPV(result, CSS_PROP_WHITE_SPACE, 0,
+			value);
+}
+
+/**
+ * white-space-collapse: collapse | preserve | preserve-breaks |
+ * break-spaces | preserve-spaces. The last two keep spaces as preserve
+ * does; their finer differences are not drawn.
+ */
+css_error css__parse_white_space_collapse(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	uint16_t value;
+
+	if (is_global(c, token)) {
+		parserutils_vector_iterate(vector, ctx);
+		if (is_word(c, token, INHERIT))
+			return CSS_OK;
+		value = WHITE_SPACE_SET_COLLAPSE;
+	} else if (is_word(c, token, COLLAPSE)) {
+		value = WHITE_SPACE_SET_COLLAPSE;
+	} else if (is_word(c, token, PRESERVE) ||
+			is_word(c, token, BREAK_SPACES) ||
+			is_word(c, token, PRESERVE_SPACES)) {
+		value = WHITE_SPACE_SET_PRESERVE;
+	} else if (is_word(c, token, PRESERVE_BREAKS)) {
+		value = WHITE_SPACE_SET_PRESERVE_BREAKS;
+	} else {
+		return CSS_INVALID;
+	}
+	if (!is_global(c, token))
+		parserutils_vector_iterate(vector, ctx);
+
+	return css__stylesheet_style_appendOPV(result, CSS_PROP_WHITE_SPACE, 0,
+			value);
+}
+
+/**
+ * zoom: <number> | <percentage> | normal | reset (VitaSurf). The factor
+ * an element's lengths are scaled by, with its ancestors'. 0 is
+ * treated as 1, as browsers now do; normal and reset are 1.
+ */
+css_error css__parse_zoom(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token = parserutils_vector_iterate(vector, ctx);
+	css_fixed zoom;
+	size_t consumed = 0;
+	css_error error;
+
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	if (is_word(c, token, INHERIT)) {
+		return css_stylesheet_style_inherit(result, CSS_PROP_ZOOM);
+	}
+	if (is_word(c, token, NORMAL) || is_word(c, token, LIBCSS_RESET) ||
+			is_word(c, token, INITIAL) || is_word(c, token, UNSET) ||
+			is_word(c, token, REVERT)) {
+		zoom = INTTOFIX(1);
+	} else if (token->type == CSS_TOKEN_NUMBER ||
+			token->type == CSS_TOKEN_PERCENTAGE) {
+		zoom = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+		if (consumed != lwc_string_length(token->idata) || zoom < 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		if (token->type == CSS_TOKEN_PERCENTAGE)
+			zoom = zoom / 100;
+		if (zoom == 0)
+			zoom = INTTOFIX(1);
+	} else {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_ZOOM, 0,
+			ZOOM_SET);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_append(result, zoom);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
diff --git a/src/parse/properties/utils.c b/src/parse/properties/utils.c
index 16b51d4..9de8ad9 100644
--- a/src/parse/properties/utils.c
+++ b/src/parse/properties/utils.c
@@ -3667,3 +3667,218 @@ cleanup:
 
 	return error;
 }
+
+/*
+ * A calc() reduced to one length at parse time (VitaSurf), for the
+ * properties that hold a length and a unit and not an expression: a
+ * corner radius, a box shadow, outline-offset. A calc() whose terms
+ * share one unit is reduced to that length: calc(56px / 2) is 28px, and
+ * calc(var(--row-height, 56px) / 2) is the same once the variable is in.
+ * Bubble Card writes every radius that way, and GitHub its focus rings
+ * as calc(.25rem / 2). Absolute units in a sum are brought to pixels.
+ * Terms in other units that differ are not reduced, and the value is
+ * dropped as before.
+ */
+struct reduce_term {
+	css_fixed v;
+	uint32_t unit;
+	bool has_unit;
+};
+
+static css_error reduce_calc_sum(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct reduce_term *out, int depth);
+
+/** An absolute length brought to pixels, or false for any other unit. */
+static bool reduce_to_px(struct reduce_term *t)
+{
+	/* pixels in each unit, as 1in is 96px */
+	switch (t->unit) {
+	case UNIT_PX: return true;
+	case UNIT_IN: t->v = FMUL(t->v, INTTOFIX(96)); break;
+	case UNIT_CM: t->v = FMUL(t->v, FLTTOFIX(37.795276f)); break;
+	case UNIT_MM: t->v = FMUL(t->v, FLTTOFIX(3.7795276f)); break;
+	case UNIT_Q:  t->v = FMUL(t->v, FLTTOFIX(0.9448819f)); break;
+	case UNIT_PT: t->v = FDIV(FMUL(t->v, INTTOFIX(4)), INTTOFIX(3)); break;
+	case UNIT_PC: t->v = FMUL(t->v, INTTOFIX(16)); break;
+	default: return false;
+	}
+	t->unit = UNIT_PX;
+	return true;
+}
+
+static css_error reduce_calc_value(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct reduce_term *out, int depth)
+{
+	const css_token *token;
+	css_error error;
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL || depth > 8) {
+		return CSS_INVALID;
+	}
+	if (token->type == CSS_TOKEN_NUMBER) {
+		size_t consumed = 0;
+
+		out->v = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+		if (consumed != lwc_string_length(token->idata)) {
+			return CSS_INVALID;
+		}
+		out->has_unit = false;
+		out->unit = UNIT_PX;
+		parserutils_vector_iterate(vector, ctx);
+		return CSS_OK;
+	}
+	if (token->type == CSS_TOKEN_DIMENSION ||
+			token->type == CSS_TOKEN_PERCENTAGE) {
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				&out->v, &out->unit);
+		out->has_unit = true;
+		return error;
+	}
+	if (token->type == CSS_TOKEN_IDENT) {
+		/* the constants of CSS Values 4: Tailwind v4's rounded-full
+		 * is calc(infinity * 1px) (VitaSurf) */
+		const char *s = lwc_string_data(token->idata);
+		size_t n = lwc_string_length(token->idata);
+
+		if (n == 8 && strncasecmp(s, "infinity", 8) == 0)
+			out->v = INTTOFIX(1000000);
+		else if (n == 2 && strncasecmp(s, "pi", 2) == 0)
+			out->v = FLTTOFIX(3.14159265f);
+		else if (n == 1 && (s[0] == 'e' || s[0] == 'E'))
+			out->v = FLTTOFIX(2.71828183f);
+		else
+			return CSS_INVALID;
+		out->has_unit = false;
+		out->unit = UNIT_PX;
+		parserutils_vector_iterate(vector, ctx);
+		return CSS_OK;
+	}
+	if (tokenIsChar(token, '(') ||
+			(token->type == CSS_TOKEN_FUNCTION &&
+			 lwc_string_length(token->idata) == 4 &&
+			 strncasecmp(lwc_string_data(token->idata),
+					"calc", 4) == 0)) {
+		parserutils_vector_iterate(vector, ctx);
+		error = reduce_calc_sum(c, vector, ctx, out, depth + 1);
+		if (error != CSS_OK) {
+			return error;
+		}
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+		return tokenIsChar(token, ')') ? CSS_OK : CSS_INVALID;
+	}
+	return CSS_INVALID;
+}
+
+static css_error reduce_calc_product(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct reduce_term *out, int depth)
+{
+	const css_token *token;
+	struct reduce_term rhs;
+	css_error error;
+
+	error = reduce_calc_value(c, vector, ctx, out, depth);
+	while (error == CSS_OK) {
+		bool mul;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (tokenIsChar(token, '*')) {
+			mul = true;
+		} else if (tokenIsChar(token, '/')) {
+			mul = false;
+		} else {
+			break;
+		}
+		parserutils_vector_iterate(vector, ctx);
+		error = reduce_calc_value(c, vector, ctx, &rhs, depth);
+		if (error != CSS_OK) {
+			break;
+		}
+		if (mul) {
+			if (out->has_unit && rhs.has_unit) {
+				return CSS_INVALID;
+			}
+			if (rhs.has_unit) {
+				out->unit = rhs.unit;
+				out->has_unit = true;
+			}
+			out->v = FMUL(out->v, rhs.v);
+		} else {
+			if (rhs.has_unit || rhs.v == 0) {
+				return CSS_INVALID;
+			}
+			out->v = FDIV(out->v, rhs.v);
+		}
+	}
+	return error;
+}
+
+static css_error reduce_calc_sum(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct reduce_term *out, int depth)
+{
+	const css_token *token;
+	struct reduce_term rhs;
+	css_error error;
+
+	error = reduce_calc_product(c, vector, ctx, out, depth);
+	while (error == CSS_OK) {
+		bool add;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (tokenIsChar(token, '+')) {
+			add = true;
+		} else if (tokenIsChar(token, '-')) {
+			add = false;
+		} else {
+			break;
+		}
+		parserutils_vector_iterate(vector, ctx);
+		error = reduce_calc_product(c, vector, ctx, &rhs, depth);
+		if (error != CSS_OK) {
+			break;
+		}
+		if (out->has_unit && rhs.has_unit && out->unit != rhs.unit &&
+				reduce_to_px(out) && reduce_to_px(&rhs)) {
+			/* both absolute: now both pixels */
+		} else if (out->has_unit != rhs.has_unit ||
+				(out->has_unit && out->unit != rhs.unit)) {
+			/* a zero term takes the other's unit */
+			if (out->v == 0 && rhs.has_unit) {
+				out->unit = rhs.unit;
+				out->has_unit = true;
+			} else if (!(rhs.v == 0)) {
+				return CSS_INVALID;
+			}
+		}
+		out->v = add ? FADD(out->v, rhs.v) : FSUB(out->v, rhs.v);
+	}
+	return error;
+}
+
+/* exported interface documented in parse/properties/utils.h */
+css_error css__parse_calc_reduced(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_fixed *length, uint32_t *unit)
+{
+	int32_t before = *ctx;
+	struct reduce_term t;
+	css_error error;
+
+	error = reduce_calc_value(c, vector, ctx, &t, 0);
+	if (error != CSS_OK || (!t.has_unit && t.v != 0)) {
+		*ctx = before;
+		return CSS_INVALID;
+	}
+	*length = t.v;
+	*unit = t.unit;
+	return CSS_OK;
+}
