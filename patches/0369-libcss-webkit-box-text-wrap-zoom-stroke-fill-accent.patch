diff --git a/src/select/unit.c b/src/select/unit.c
index e8b9de3..b579ec6 100644
--- a/src/select/unit.c
+++ b/src/select/unit.c
@@ -374,6 +374,29 @@ css_fixed css_unit_len2px_mq(
 	return FMUL(length, TRUNCATEFIX(px_per_unit));
 }
 
+/*
+ * zoom (VitaSurf). A font size is computed with the element's zoom in
+ * it, so a length in em, ex, ch or lh is zoomed already; every other
+ * length is multiplied by the effective zoom when it becomes device
+ * pixels. A length in CSS pixels is the unzoomed one, so a calc()
+ * that adds em to px does not zoom the em part twice.
+ */
+static bool css_unit__font_relative(css_unit unit)
+{
+	return unit == CSS_UNIT_EM || unit == CSS_UNIT_EX ||
+			unit == CSS_UNIT_CH || unit == CSS_UNIT_LH;
+}
+
+static css_fixed css_unit__zoom(const css_computed_style *style)
+{
+	css_fixed zoom = INTTOFIX(1);
+
+	if (style == NULL || get_zoom(style, &zoom) != CSS_ZOOM_SET ||
+			zoom <= 0)
+		return INTTOFIX(1);
+	return zoom;
+}
