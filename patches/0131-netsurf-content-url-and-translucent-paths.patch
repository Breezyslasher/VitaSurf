+/**
+ * A NetSurf colour in libnsfb's convention (VitaSurf).
+ *
+ * NetSurf keeps a colour's alpha inverted in its top byte, 0x00 being
+ * opaque; libnsfb reads that byte as the opacity.
+ */
+static nsfb_colour_t fb_colour(colour c)
+{
+	if (c == NS_TRANSPARENT) {
+		return 0;
+	}
+
+	return (nsfb_colour_t) ((c & 0x00ffffff) |
+			((0xffu - ((c >> 24) & 0xff)) << 24));
+}
