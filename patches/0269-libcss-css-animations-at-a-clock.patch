diff --git a/src/select/properties/animation_delay.c b/src/select/properties/animation_delay.c
new file mode 100644
index 0000000..6132ae6
--- /dev/null
+++ b/src/select/properties/animation_delay.c
@@ -0,0 +1,73 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_animation_delay(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_ANIMATION_DELAY_INHERIT;
+	css_fixed ms = 0;
+
+	if (hasFlagValue(opv) == false) {
+		value = CSS_ANIMATION_DELAY_SET;
+		ms = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(ms));
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_animation_delay(state->computed, value, ms);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_animation_delay_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_animation_delay(style, hint->status, hint->data.fixed);
+}
+
+css_error css__initial_animation_delay(css_select_state *state)
+{
+	return set_animation_delay(state->computed, CSS_ANIMATION_DELAY_SET, 0);
+}
+
+css_error css__copy_animation_delay(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed ms = 0;
+	uint8_t type = get_animation_delay(from, &ms);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_animation_delay(to, type, ms);
+}
+
+css_error css__compose_animation_delay(
+		const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed ms = 0;
+	uint8_t type = get_animation_delay(child, &ms);
+
+	return css__copy_animation_delay(
+			type == CSS_ANIMATION_DELAY_INHERIT ? parent : child,
+			result);
+}
diff --git a/src/select/properties/animation_direction.c b/src/select/properties/animation_direction.c
new file mode 100644
index 0000000..2915ee3
--- /dev/null
+++ b/src/select/properties/animation_direction.c
@@ -0,0 +1,70 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* animation-direction (VitaSurf): the opcode is the computed value less
+ * one */
+
+css_error css__cascade_animation_direction(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_ANIMATION_DIRECTION_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		value = getValue(opv) + 1;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_animation_direction(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_animation_direction_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_animation_direction(style, hint->status);
+}
+
+css_error css__initial_animation_direction(css_select_state *state)
+{
+	return set_animation_direction(state->computed, CSS_ANIMATION_DIRECTION_NORMAL);
+}
+
+css_error css__copy_animation_direction(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_animation_direction(to, get_animation_direction(from));
+}
+
+css_error css__compose_animation_direction(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_animation_direction(child);
+
+	return css__copy_animation_direction(
+			type == CSS_ANIMATION_DIRECTION_INHERIT ? parent : child,
+			result);
+}
