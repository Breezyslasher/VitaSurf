+
+static css_fixed anim_mix(css_fixed a, css_fixed b, float f)
+{
+	return a + (css_fixed) ((float) (b - a) * f);
+}
+
+static css_color anim_mix_colour(css_color a, css_color b, float f)
+{
+	css_color out = 0;
+	int shift;
+
+	for (shift = 0; shift < 32; shift += 8) {
+		int ca = (a >> shift) & 0xff, cb = (b >> shift) & 0xff;
+
+		out |= (css_color) ((ca + (int) ((cb - ca) * f)) & 0xff) <<
+				shift;
+	}
+	return out;
+}
+
+/** The matrix with its rotation taken out: R(-angle) M. */
+static void anim_unrotate(const css_fixed m[4], css_fixed angle, float n[4])
+{
+	float r = FIXTOFLT(angle) * 3.14159265f / 180.0f;
+	float co = cosf(r), s = sinf(r);
+	float a = FIXTOFLT(m[0]), b = FIXTOFLT(m[1]);
+	float c = FIXTOFLT(m[2]), d = FIXTOFLT(m[3]);
+
+	/* R(-r) = [co s; -s co] as [[a c] [b d]] */
+	n[0] = co * a + s * b;
+	n[1] = -s * a + co * b;
+	n[2] = co * c + s * d;
+	n[3] = -s * c + co * d;
+}
+
+/** Write the blend of two sets of values, \a f of the way from a to b. */
+static css_error anim_write(css_computed_style *s, const struct anim_values *a,
+		const struct anim_values *b, float f)
+{
+	css_error error = CSS_OK;
+	int i;
+
+	if (a->op_t == CSS_OPACITY_SET && b->op_t == CSS_OPACITY_SET)
+		error = set_opacity(s, CSS_OPACITY_SET,
+				anim_mix(a->op, b->op, f));
+	if (error == CSS_OK && a->col_t == CSS_COLOR_COLOR &&
+			b->col_t == CSS_COLOR_COLOR)
+		error = set_color(s, CSS_COLOR_COLOR,
+				anim_mix_colour(a->col, b->col, f));
+	if (error == CSS_OK && a->bg_t == CSS_BACKGROUND_COLOR_COLOR &&
+			b->bg_t == CSS_BACKGROUND_COLOR_COLOR)
+		error = set_background_color(s, CSS_BACKGROUND_COLOR_COLOR,
+				anim_mix_colour(a->bg, b->bg, f));
+	if (error == CSS_OK && (a->tf_t == CSS_TRANSFORM_SET ||
+			b->tf_t == CSS_TRANSFORM_SET)) {
+		/* the rotation blended as an angle, what is left of the
+		 * matrix cell by cell, then put back together */
+		float na[4], nb[4], n[4], r, co, sn;
+		css_fixed tl[2], m[4];
+		css_unit tu[2];
+
+		anim_unrotate(a->m, a->angle, na);
+		anim_unrotate(b->m, b->angle, nb);
+		for (i = 0; i < 4; i++)
+			n[i] = na[i] + (nb[i] - na[i]) * f;
+		r = (FIXTOFLT(a->angle) + (FIXTOFLT(b->angle) -
+				FIXTOFLT(a->angle)) * f) * 3.14159265f / 180.0f;
+		co = cosf(r);
+		sn = sinf(r);
+		/* R(r) N */
+		m[0] = FLTTOFIX(co * n[0] - sn * n[1]);
+		m[1] = FLTTOFIX(sn * n[0] + co * n[1]);
+		m[2] = FLTTOFIX(co * n[2] - sn * n[3]);
+		m[3] = FLTTOFIX(sn * n[2] + co * n[3]);
+		for (i = 0; i < 2; i++) {
+			if (a->tu[i] == b->tu[i] || a->tl[i] == 0 ||
+					b->tl[i] == 0) {
+				tu[i] = a->tl[i] == 0 ? b->tu[i] : a->tu[i];
+				tl[i] = anim_mix(a->tl[i], b->tl[i], f);
+			} else {
+				tu[i] = f < 0.5f ? a->tu[i] : b->tu[i];
+				tl[i] = f < 0.5f ? a->tl[i] : b->tl[i];
+			}
+		}
+		error = set_transform(s, CSS_TRANSFORM_SET, tl[0], tu[0],
+				tl[1], tu[1], m[0], m[1], m[2], m[3]);
+	}
+	for (i = 0; i < 6 && error == CSS_OK; i++) {
+		css_fixed_or_calc v;
+
+		if (a->len_t[i] != b->len_t[i] || a->len_t[i] != CSS_WIDTH_SET ||
+				a->len_u[i] != b->len_u[i] ||
+				a->len_u[i] == CSS_UNIT_CALC)
+			continue;
+		v.value = anim_mix(a->len[i].value, b->len[i].value, f);
+		switch (i) {
+		case 0: error = set_width(s, a->len_t[i], v, a->len_u[i]); break;
+		case 1: error = set_height(s, a->len_t[i], v, a->len_u[i]); break;
+		case 2: error = set_left(s, a->len_t[i], v, a->len_u[i]); break;
+		case 3: error = set_top(s, a->len_t[i], v, a->len_u[i]); break;
+		case 4: error = set_right(s, a->len_t[i], v, a->len_u[i]); break;
+		default: error = set_bottom(s, a->len_t[i], v, a->len_u[i]); break;
+		}
+	}
+	return error;
