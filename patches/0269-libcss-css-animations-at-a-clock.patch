+/**
+ * Read a time, "1.5s", "200ms" or a bare 0, into milliseconds. The
+ * token has been taken.
+ */
+static bool read_time(const css_token *token, bool negative_ok,
+		css_fixed *ms)
+{
+	size_t consumed = 0, len;
+	const char *unit;
+	css_fixed n;
+
+	if (token->type == CSS_TOKEN_NUMBER) {
+		n = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+		if (consumed != lwc_string_length(token->idata) || n != 0)
+			return false;
+		*ms = 0;
+		return true;
+	}
+	if (token->type != CSS_TOKEN_DIMENSION)
+		return false;
+	n = css__number_from_lwc_string(token->idata, false, &consumed);
+	len = lwc_string_length(token->idata);
+	unit = lwc_string_data(token->idata) + consumed;
+	if (len - consumed == 1 && (unit[0] == 's' || unit[0] == 'S')) {
+		/* seconds, within what a fixed-point millisecond holds */
+		if (n > INTTOFIX(2000) || n < INTTOFIX(-2000))
+			return false;
+		*ms = FMUL(n, INTTOFIX(1000));
+	} else if (len - consumed == 2 && strncasecmp(unit, "ms", 2) == 0) {
+		*ms = n;
+	} else {
+		return false;
+	}
+	return negative_ok || *ms >= 0;
+}
+
+/** The direction keywords, as their opcode, or -1. */
+static int direction_value(const css_token *token)
+{
+	static const char *const words[] = {
+		"normal", "reverse", "alternate", "alternate-reverse"
+	};
+	size_t i, n;
+
+	if (token->type != CSS_TOKEN_IDENT)
+		return -1;
+	n = lwc_string_length(token->idata);
+	for (i = 0; i < 4; i++) {
+		if (strlen(words[i]) == n && strncasecmp(
+				lwc_string_data(token->idata), words[i],
+				n) == 0)
+			return (int) i;
+	}
+	return -1;
+}
