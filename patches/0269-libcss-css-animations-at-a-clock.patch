+
+static void anim_read(const css_computed_style *s, css_fixed angle,
+		struct anim_values *v)
+{
+	v->op_t = get_opacity(s, &v->op);
+	v->col_t = get_color(s, &v->col);
+	v->bg_t = get_background_color(s, &v->bg);
+	v->tf_t = get_transform(s, &v->tl[0], &v->tu[0], &v->tl[1],
+			&v->tu[1], &v->m[0], &v->m[1], &v->m[2], &v->m[3]);
+	if (v->tf_t != CSS_TRANSFORM_SET) {
+		v->tl[0] = v->tl[1] = 0;
+		v->tu[0] = v->tu[1] = CSS_UNIT_PX;
+		v->m[0] = v->m[3] = INTTOFIX(1);
+		v->m[1] = v->m[2] = 0;
+		angle = 0;
+	}
+	v->angle = angle;
+	v->len_t[0] = get_width(s, &v->len[0], &v->len_u[0]);
+	v->len_t[1] = get_height(s, &v->len[1], &v->len_u[1]);
+	v->len_t[2] = get_left(s, &v->len[2], &v->len_u[2]);
+	v->len_t[3] = get_top(s, &v->len[3], &v->len_u[3]);
+	v->len_t[4] = get_right(s, &v->len[4], &v->len_u[4]);
+	v->len_t[5] = get_bottom(s, &v->len[5], &v->len_u[5]);
