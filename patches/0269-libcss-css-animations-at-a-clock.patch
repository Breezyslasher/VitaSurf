+/*
+ * Running animations (VitaSurf).
+ *
+ * With the context's clock running, an element whose animation-name
+ * names a @keyframes rule is put where its animation is at the clock:
+ * the time since it started, less its delay, gives an iteration and a
+ * point along it, the direction turns that round, the timing function
+ * eases it, and the two keyframes either side of it are cascaded and
+ * the properties that move smoothly -- opacity, transform, the colour
+ * and background colour, and width, height, left, top, right and bottom
+ * where both ends are in the same unit -- are blended between them.
+ * Everything else a keyframe sets comes from the later one. A missing
+ * first or last keyframe is the element's own style.
+ */
+
+/** The values an animation blends. */
+struct anim_values {
+	uint8_t op_t;
+	css_fixed op;
+	uint8_t col_t, bg_t;
+	css_color col, bg;
+	uint8_t tf_t;
+	css_fixed tl[2];
+	css_unit tu[2];
+	css_fixed m[4];
+	css_fixed angle;
+	uint8_t len_t[6];
+	css_fixed_or_calc len[6];
+	css_unit len_u[6];
