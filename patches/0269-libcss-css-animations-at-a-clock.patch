+
+/** Ease \a x, 0 to 1, by an animation-timing-function string. */
+static float anim_ease(lwc_string *fn, float x)
+{
+	int v[4] = { 250, 100, 250, 1000 };
+	const char *s = fn != NULL ? lwc_string_data(fn) : "b";
+	float x1, y1, x2, y2, lo = 0, hi = 1, t = x;
+	int i;
+
+	if (s[0] == 's') {
+		int n = 1, start = 0;
+
+		sscanf(s, "s,%d,%d", &n, &start);
+		if (n < 1)
+			n = 1;
+		x = floorf(x * n + (start ? 1 : 0)) / n;
+		return x > 1 ? 1 : x;
+	}
+	if (fn != NULL)
+		sscanf(s, "b,%d,%d,%d,%d", &v[0], &v[1], &v[2], &v[3]);
+	x1 = v[0] / 1000.0f; y1 = v[1] / 1000.0f;
+	x2 = v[2] / 1000.0f; y2 = v[3] / 1000.0f;
+	if (x1 == y1 && x2 == y2)
+		return x;	/* linear */
+	/* the curve's parameter where its x is x, by halving */
+	for (i = 0; i < 20; i++) {
+		float u = 1 - t;
+		float bx = 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t;
+
+		if (bx < x)
+			lo = t;
+		else
+			hi = t;
+		t = (lo + hi) / 2;
+	}
+	{
+		float u = 1 - t;
+
+		return 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t;
+	}
+}
+
+/** Cascade every keyframe at one offset. */
+static css_error anim_cascade_at(const css_rule_keyframes *kf, uint32_t i,
+		css_select_state *state)
+{
+	css_fixed at = kf->frames[i].offset;
+	css_error error = CSS_OK;
+
+	for (; i < kf->n_frames && kf->frames[i].offset == at &&
+			error == CSS_OK; i++) {
+		const css_rule_selector *rs =
+				(const css_rule_selector *) kf->frames[i].block;
+
+		if (rs->style != NULL)
+			error = cascade_style(rs->style, state);
+	}
+	return error;
+}
+
+/** Put an element where its keyframes are at \a p, 0 to 1. */
+static css_error anim_apply_at(const css_rule_keyframes *kf, float p,
+		css_select_state *state)
+{
+	css_fixed at = FLTTOFIX(p);
+	struct anim_values base, v0, v1;
+	int32_t k0 = -1, k1 = -1;
+	float o0 = 0, o1 = 1, f;
+	uint32_t i;
+	css_error error;
+
+	for (i = 0; i < kf->n_frames; i++) {
+		if (kf->frames[i].offset <= at)
+			k0 = i;
+	}
+	/* the first of the frames at k0's offset */
+	while (k0 > 0 && kf->frames[k0 - 1].offset == kf->frames[k0].offset)
+		k0--;
+	for (i = 0; i < kf->n_frames; i++) {
+		if (kf->frames[i].offset > at) {
+			k1 = i;
+			break;
+		}
+	}
+	if (k0 >= 0)
+		o0 = FIXTOFLT(kf->frames[k0].offset);
+	if (k1 >= 0)
+		o1 = FIXTOFLT(kf->frames[k1].offset);
+	f = o1 > o0 ? (p - o0) / (o1 - o0) : 1;
+	if (f < 0) f = 0;
+	if (f > 1) f = 1;
+
+	anim_read(state->computed, state->transform_angle, &base);
+	v0 = base;
+	if (k0 >= 0) {
+		error = anim_cascade_at(kf, k0, state);
+		if (error != CSS_OK)
+			return error;
+		anim_read(state->computed, state->transform_angle, &v0);
+	}
+	if (k1 < 0 || f <= 0)
+		return k1 < 0 ? anim_write(state->computed, &v0, &base, f) :
+				CSS_OK;
+	error = anim_cascade_at(kf, k1, state);
+	if (error != CSS_OK)
+		return error;
+	anim_read(state->computed, state->transform_angle, &v1);
+	return anim_write(state->computed, &v0, &v1, f);
+}
+
+/**
+ * Run one style's animation at the clock. \a done is set when it was
+ * dealt with here, and left false for an animation the resting state
+ * serves: one with no duration.
+ */
+static css_error anim_run(css_select_ctx *ctx, css_select_state *state,
+		css_computed_style *style, lwc_string *name,
+		const css_rule_keyframes *kf, bool *done)
+{
+	css_fixed dur = 0, delay = 0, count = INTTOFIX(1);
+	lwc_string *fn = NULL;
+	uint32_t start = 0;
+	uint8_t fill, dir;
+	bool infinite;
+	float d, t, c, it, local;
+	int64_t elapsed;
+
+	*done = false;
+	get_animation_duration(style, &dur);
+	get_animation_delay(style, &delay);
+	if (dur <= 0)
+		return CSS_OK;
+	*done = true;
+	infinite = get_animation_iteration_count(style, &count) ==
+			CSS_ANIMATION_ITERATION_COUNT_INFINITE;
+	fill = get_animation_fill_mode(style);
+	dir = get_animation_direction(style);
+	if (get_animation_timing_function(style, &fn) !=
+			CSS_ANIMATION_TIMING_FUNCTION_SET)
+		fn = NULL;
+	if (state->handler->node_animation_start != NULL)
+		state->handler->node_animation_start(state->pw, state->node,
+				name, &start);
+
+	d = FIXTOFLT(dur);
+	c = infinite ? 0 : FIXTOFLT(count);
+	elapsed = (int64_t) ctx->clock_now - start;
+	t = (float) elapsed - FIXTOFLT(delay);
+
+	if (t < 0) {
+		/* waiting on its delay */
+		state->results->animating = true;
+		if (fill != CSS_ANIMATION_FILL_MODE_BACKWARDS &&
+				fill != CSS_ANIMATION_FILL_MODE_BOTH)
+			return CSS_OK;
+		it = 0;
+		local = 0;
+	} else if (!infinite && t >= c * d) {
+		/* finished: where the last iteration ended, if it fills */
+		if (fill != CSS_ANIMATION_FILL_MODE_FORWARDS &&
+				fill != CSS_ANIMATION_FILL_MODE_BOTH)
+			return CSS_OK;
+		it = c > 0 ? ceilf(c) - 1 : 0;
+		local = c - floorf(c);
+		if (local == 0)
+			local = c > 0 ? 1 : 0;
+	} else {
+		state->results->animating = true;
+		it = floorf(t / d);
+		local = (t - it * d) / d;
+	}
+
+	if (dir == CSS_ANIMATION_DIRECTION_REVERSE ||
+			(dir == CSS_ANIMATION_DIRECTION_ALTERNATE &&
+			 ((int) it & 1)) ||
+			(dir == CSS_ANIMATION_DIRECTION_ALTERNATE_REVERSE &&
+			 !((int) it & 1)))
+		local = 1 - local;
+
+	return anim_apply_at(kf, anim_ease(fn, local), state);
+}
