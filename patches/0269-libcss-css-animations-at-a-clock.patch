+css_error css__cascade_animation_timing_function(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_ANIMATION_TIMING_FUNCTION_INHERIT;
+	lwc_string *name = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case ANIMATION_TIMING_FUNCTION_NONE:
+			value = CSS_ANIMATION_TIMING_FUNCTION_NONE;
+			break;
+		case ANIMATION_TIMING_FUNCTION_SET:
+			value = CSS_ANIMATION_TIMING_FUNCTION_SET;
+			css__stylesheet_string_get(style->sheet,
+					*((css_code_t *) style->bytecode),
+					&name);
+			advance_bytecode(style, sizeof(css_code_t));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_animation_timing_function(state->computed, value, name);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_animation_timing_function_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error;
+
+	error = set_animation_timing_function(style, hint->status, hint->data.string);
+
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+
+	return error;
+}
+
+css_error css__initial_animation_timing_function(css_select_state *state)
+{
+	return set_animation_timing_function(state->computed, CSS_ANIMATION_TIMING_FUNCTION_NONE,
+			NULL);
+}
+
+css_error css__copy_animation_timing_function(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *name;
+	uint8_t type = get_animation_timing_function(from, &name);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_animation_timing_function(to, type, name);
+}
+
+css_error css__compose_animation_timing_function(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *name;
+	uint8_t type = get_animation_timing_function(child, &name);
+
+	return css__copy_animation_timing_function(
+			type == CSS_ANIMATION_TIMING_FUNCTION_INHERIT ? parent : child,
+			result);
+}
