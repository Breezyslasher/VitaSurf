+/**
+ * Read a timing function into \a buf: a keyword, cubic-bezier() or
+ * steps(). The token has been taken; a function's arguments are read.
+ */
+static bool read_timing(const parserutils_vector *vector, int32_t *ctx,
+		const css_token *token, char *buf, size_t size)
+{
+	static const struct {
+		const char *name;
+		int x1, y1, x2, y2;
+	} curves[] = {
+		{ "ease", 250, 100, 250, 1000 },
+		{ "linear", 0, 0, 1000, 1000 },
+		{ "ease-in", 420, 0, 1000, 1000 },
+		{ "ease-out", 0, 0, 580, 1000 },
+		{ "ease-in-out", 420, 0, 580, 1000 },
+	};
+	const char *name = lwc_string_data(token->idata);
+	size_t n = lwc_string_length(token->idata), i;
+
+	if (token->type == CSS_TOKEN_IDENT) {
+		for (i = 0; i < sizeof(curves) / sizeof(curves[0]); i++) {
+			if (strlen(curves[i].name) == n &&
+					strncasecmp(name, curves[i].name,
+						n) == 0) {
+				snprintf(buf, size, "b,%d,%d,%d,%d",
+						curves[i].x1, curves[i].y1,
+						curves[i].x2, curves[i].y2);
+				return true;
+			}
+		}
+		if (n == 10 && strncasecmp(name, "step-start", 10) == 0) {
+			snprintf(buf, size, "s,1,1");
+			return true;
+		}
+		if (n == 8 && strncasecmp(name, "step-end", 8) == 0) {
+			snprintf(buf, size, "s,1,0");
+			return true;
+		}
+		return false;
+	}
+	if (token->type != CSS_TOKEN_FUNCTION)
+		return false;
+	if (n == 12 && strncasecmp(name, "cubic-bezier", 12) == 0) {
+		int v[4], k = 0;
+
+		while (k < 4) {
+			const css_token *t;
+			size_t consumed = 0;
+
+			consumeWhitespace(vector, ctx);
+			t = parserutils_vector_iterate(vector, ctx);
+			if (t == NULL || t->type != CSS_TOKEN_NUMBER)
+				return false;
+			v[k++] = FIXTOINT(FMUL(css__number_from_lwc_string(
+					t->idata, false, &consumed),
+					INTTOFIX(1000)));
+			consumeWhitespace(vector, ctx);
+			t = parserutils_vector_iterate(vector, ctx);
+			if (t == NULL || !tokenIsChar(t, k < 4 ? ',' : ')'))
+				return false;
+		}
+		snprintf(buf, size, "b,%d,%d,%d,%d", v[0], v[1], v[2], v[3]);
+		return true;
+	}
+	if (n == 5 && strncasecmp(name, "steps", 5) == 0) {
+		const css_token *t;
+		size_t consumed = 0;
+		int steps, start = 0;
+
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		if (t == NULL || t->type != CSS_TOKEN_NUMBER)
+			return false;
+		steps = FIXTOINT(css__number_from_lwc_string(t->idata, true,
+				&consumed));
+		if (steps < 1)
+			return false;
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		if (t != NULL && tokenIsChar(t, ',')) {
+			consumeWhitespace(vector, ctx);
+			t = parserutils_vector_iterate(vector, ctx);
+			if (t == NULL || t->type != CSS_TOKEN_IDENT)
+				return false;
+			n = lwc_string_length(t->idata);
+			name = lwc_string_data(t->idata);
+			start = (n == 5 && strncasecmp(name, "start", 5) == 0) ||
+				(n == 10 && strncasecmp(name, "jump-start",
+					10) == 0);
+			consumeWhitespace(vector, ctx);
+			t = parserutils_vector_iterate(vector, ctx);
+		}
+		if (t == NULL || !tokenIsChar(t, ')'))
+			return false;
+		snprintf(buf, size, "s,%d,%d", steps, start);
+		return true;
+	}
+	return false;
+}
+
+static css_error emit_ms(css_style *result, opcode_t prop, css_fixed ms)
+{
+	css_error error = css__stylesheet_style_appendOPV(result, prop, 0,
+			ANIMATION_DURATION_SET);
+
+	if (error != CSS_OK)
+		return error;
+	return css__stylesheet_style_append(result, ms);
+}
+
+static css_error emit_timing(css_language *c, css_style *result,
+		const char *buf)
+{
+	lwc_string *s;
+	uint32_t snumber;
+	css_error error;
+
+	if (buf[0] == '\0')
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_ANIMATION_TIMING_FUNCTION, 0,
+				ANIMATION_TIMING_FUNCTION_NONE);
+	if (lwc_intern_string(buf, strlen(buf), &s) != lwc_error_ok)
+		return CSS_NOMEM;
+	error = css__stylesheet_string_add(c->sheet, s, &snumber);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_ANIMATION_TIMING_FUNCTION, 0,
+			ANIMATION_TIMING_FUNCTION_SET);
+	if (error != CSS_OK)
+		return error;
+	return css__stylesheet_style_append(result, snumber);
+}
+
+/** Step over the rest of a comma list, from before its first comma. */
+static bool skip_list_rest(const parserutils_vector *vector, int32_t *ctx)
+{
+	const css_token *token;
+
+	while ((token = parserutils_vector_peek(vector, *ctx)) != NULL &&
+			token->type != CSS_TOKEN_EOF &&
+			!tokenIsChar(token, '!') && !tokenIsChar(token, ';')) {
+		parserutils_vector_iterate(vector, ctx);
+		if (token->type == CSS_TOKEN_FUNCTION &&
+				skip_function(vector, ctx) == false)
+			return false;
+	}
+	return true;
+}
+
+/** animation-duration and animation-delay: a list of times. */
+static css_error parse_time_list(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop, bool negative_ok)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token = parserutils_vector_iterate(vector, ctx);
+	enum flag_value flag_value;
+	css_fixed ms = 0;
+
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE)
+		return css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+	if (!read_time(token, negative_ok, &ms) ||
+			!skip_list_rest(vector, ctx)) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return emit_ms(result, prop, ms);
+}
+
+css_error css__parse_animation_duration(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_time_list(c, vector, ctx, result,
+			CSS_PROP_ANIMATION_DURATION, false);
+}
+
+css_error css__parse_animation_delay(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_time_list(c, vector, ctx, result,
+			CSS_PROP_ANIMATION_DELAY, true);
+}
+
+css_error css__parse_animation_direction(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
