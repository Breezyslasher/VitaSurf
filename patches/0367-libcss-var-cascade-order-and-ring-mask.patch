+/**
+ * Place the declaration just held over after whatever was compiled for
+ * it against the root table (VitaSurf), so that in the cascade it
+ * replaces that, and the declarations written after it still win.
+ */
+static void deferredEndsHere(css_rule *rule)
+{
+	css_rule_selector *rs = (css_rule_selector *) rule;
+
+	if (rule->type == CSS_RULE_SELECTOR && rs->n_deferred > 0) {
+		rs->deferred[rs->n_deferred - 1].at =
+				(rs->style != NULL) ? rs->style->used : 0;
+	}
