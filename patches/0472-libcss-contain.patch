diff --git a/src/select/properties/contain.c b/src/select/properties/contain.c
new file mode 100644
index 0000000..87b900d
--- /dev/null
+++ b/src/select/properties/contain.c
@@ -0,0 +1,81 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* contain (VitaSurf): not inherited, so an element without it is none */
+
+css_error css__cascade_contain(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_CONTAIN_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		uint32_t kinds = getValue(opv);
+
+		value = CSS_CONTAIN_NONE;
+		if (kinds & CONTAIN_SIZE)
+			value |= CSS_CONTAIN_SIZE;
+		if (kinds & CONTAIN_INLINE_SIZE)
+			value |= CSS_CONTAIN_INLINE_SIZE;
+		if (kinds & CONTAIN_LAYOUT)
+			value |= CSS_CONTAIN_LAYOUT;
+		if (kinds & CONTAIN_STYLE)
+			value |= CSS_CONTAIN_STYLE;
+		if (kinds & CONTAIN_PAINT)
+			value |= CSS_CONTAIN_PAINT;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_contain(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_contain_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_contain(style, hint->status);
+}
+
+css_error css__initial_contain(css_select_state *state)
+{
+	return set_contain(state->computed, CSS_CONTAIN_NONE);
+}
+
+css_error css__copy_contain(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_contain(to, get_contain(from));
+}
+
+css_error css__compose_contain(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_contain(child);
+
+	return css__copy_contain(
+			type == CSS_CONTAIN_INHERIT ? parent : child,
+			result);
+}
