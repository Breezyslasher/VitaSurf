diff --git a/src/parse/properties/contain.c b/src/parse/properties/contain.c
new file mode 100644
index 0000000..3961b69
--- /dev/null
+++ b/src/parse/properties/contain.c
@@ -0,0 +1,99 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * contain (VitaSurf): none | strict | content | [ [ size | inline-size ]
+ * || layout || style || paint ]. strict is size layout paint style and
+ * content layout paint style, as CSS Containment has them.
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+static bool is_word(css_language *c, const css_token *token, int string)
+{
+	bool match = false;
+
+	return token != NULL && token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[string], &match) == lwc_error_ok &&
+			match;
+}
+
+css_error css__parse_contain(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct {
+		int string;
+		uint16_t bit;
+	} kinds[] = {
+		{ SIZE_KW, CONTAIN_SIZE },
+		{ INLINE_SIZE, CONTAIN_INLINE_SIZE },
+		{ LAYOUT_KW, CONTAIN_LAYOUT },
+		{ STYLE_KW, CONTAIN_STYLE },
+		{ PAINT_KW, CONTAIN_PAINT },
+	};
+	int32_t orig_ctx = *ctx;
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag;
+	uint16_t value = 0;
+	size_t i;
+
+	flag = get_css_flag_value(c, token);
+	if (flag != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag,
+				CSS_PROP_CONTAIN);
+	}
+	if (is_word(c, token, NONE) || is_word(c, token, STRICT_KW) ||
+			is_word(c, token, CONTENT)) {
+		parserutils_vector_iterate(vector, ctx);
+		if (is_word(c, token, STRICT_KW))
+			value = CONTAIN_SIZE | CONTAIN_LAYOUT |
+					CONTAIN_STYLE | CONTAIN_PAINT;
+		else if (is_word(c, token, CONTENT))
+			value = CONTAIN_LAYOUT | CONTAIN_STYLE |
+					CONTAIN_PAINT;
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_CONTAIN, 0, value);
+	}
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!'))
+			break;
+		for (i = 0; i < sizeof(kinds) / sizeof(kinds[0]); i++) {
+			if (is_word(c, token, kinds[i].string))
+				break;
+		}
+		/* each kind once, and size or inline-size, not both */
+		if (i == sizeof(kinds) / sizeof(kinds[0]) ||
+				(value & kinds[i].bit) != 0 ||
+				(kinds[i].bit == CONTAIN_SIZE &&
+				 (value & CONTAIN_INLINE_SIZE) != 0) ||
+				(kinds[i].bit == CONTAIN_INLINE_SIZE &&
+				 (value & CONTAIN_SIZE) != 0)) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		value |= kinds[i].bit;
+		parserutils_vector_iterate(vector, ctx);
+	}
+	if (value == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	return css__stylesheet_style_appendOPV(result, CSS_PROP_CONTAIN, 0,
+			value);
+}
