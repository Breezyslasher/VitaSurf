diff --git a/src/select/select.c b/src/select/select.c
index d564939..f314302 100644
--- a/src/select/select.c
+++ b/src/select/select.c
@@ -869,6 +869,14 @@ static css_error record_deferred(css_select_state *state,
 static css_error apply_deferred(css_select_ctx *ctx, css_select_state *state)
 {
 	const css_stylesheet *registered[REGISTERED_SHEETS_MAX];
+	/*
+	 * A pseudo-element's own variables, over the element's (VitaSurf).
+	 * What a ::before rule declares is the ::before's alone: they had
+	 * gone into the element's map, so the element and everything
+	 * inside it saw them, and Tailwind's "*, ::before, ::after" set
+	 * each of its variables three times over on every element.
+	 */
+	css_custom_map **pseudo_custom = state->pseudo_custom;
 	uint32_t i, n_registered = 0;
 	css_error result = CSS_OK;
 
@@ -877,7 +885,9 @@ static css_error apply_deferred(css_select_ctx *ctx, css_select_state *state)
 		uint32_t n_custom = 0;
 
 		for (i = 0; i < state->n_deferred; i++) {
-			if (state->deferred[i].decl->custom != NULL)
+			if (state->deferred[i].decl->custom != NULL &&
+					state->deferred[i].pseudo ==
+					CSS_PSEUDO_ELEMENT_NONE)
 				n_custom++;
 		}
 		if (n_custom > 8) {
@@ -892,7 +902,8 @@ static css_error apply_deferred(css_select_ctx *ctx, css_select_state *state)
 		const css_deferred_match *m = &state->deferred[i];
 		css_error error;
 
-		if (m->decl->custom == NULL) {
+		if (m->decl->custom == NULL ||
