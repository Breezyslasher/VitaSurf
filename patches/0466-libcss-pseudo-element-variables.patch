 			continue;
 		}
 		/* a style attribute's sheet goes once this element's
@@ -905,6 +916,64 @@ static css_error apply_deferred(css_select_ctx *ctx, css_select_state *state)
 			return error;
 		}
 	}
+	/*
+	 * A pseudo-element each of whose variables the element already has
+	 * from that same declaration would make a map equal to the
+	 * element's, and shares it: "*, ::before, ::after" gives all three
+	 * the same values, and three maps an element cost more than the
+	 * one map the element had taken them all into.
+	 */
+	{
+		bool differs[CSS_PSEUDO_ELEMENT_COUNT];
+
+		memset(differs, 0, sizeof(differs));
+		for (i = 0; i < state->n_deferred; i++) {
+			const css_deferred_match *m = &state->deferred[i];
+			const css_custom_entry *e;
+
+			if (m->decl->custom == NULL ||
+					m->pseudo == CSS_PSEUDO_ELEMENT_NONE ||
+					m->pseudo >= CSS_PSEUDO_ELEMENT_COUNT ||
+					differs[m->pseudo]) {
+				continue;
+			}
+			e = css__custom_map_get(state->custom,
+					m->decl->custom);
+			if (e == NULL || e->tokens != m->decl->tokens ||
+					e->n_tokens != m->decl->n_tokens)
+				differs[m->pseudo] = true;
+		}
+		state->pseudo_own_mask = 0;
+		for (i = 0; i < CSS_PSEUDO_ELEMENT_COUNT; i++)
+			if (differs[i])
+				state->pseudo_own_mask |= 1u << i;
+	}
+	for (i = 0; i < state->n_deferred; i++) {
+		const css_deferred_match *m = &state->deferred[i];
+		css_custom_map **pm;
+		css_error error;
+
+		if (m->decl->custom == NULL ||
+				m->pseudo == CSS_PSEUDO_ELEMENT_NONE ||
+				m->pseudo >= CSS_PSEUDO_ELEMENT_COUNT ||
+				!(state->pseudo_own_mask & (1u << m->pseudo))) {
+			continue;
+		}
+		pm = &pseudo_custom[m->pseudo];
+		if (*pm == NULL) {
+			/* a map of its own whose parent is the element's */
+			*pm = css__custom_map_ref(state->custom);
+			error = css__custom_map_own(pm);
+			if (error != CSS_OK)
+				return error;
+		}
+		error = css__custom_map_set(pm, m->decl->custom,
+				m->decl->tokens, m->decl->n_tokens,
+				m->specificity, m->decl->important,
+				m->sheet != NULL && m->sheet->inline_style);
+		if (error != CSS_OK)
+			return error;
+	}
 
 	/*
 	 * The sheets that register custom properties, for the var()s
@@ -935,7 +1004,10 @@ static css_error apply_deferred(css_select_ctx *ctx, css_select_state *state)
 		}
 
 		error = css__language_compile_deferred(
-				m->sheet->parser_frontend, state->custom,
+				m->sheet->parser_frontend,
+				m->pseudo < CSS_PSEUDO_ELEMENT_COUNT &&
+				pseudo_custom[m->pseudo] != NULL ?
+				pseudo_custom[m->pseudo] : state->custom,
 				(css_deferred_decl *) m->decl, &style);
 		if (error != CSS_OK) {
 			continue;	/* unset not taken: leave it out */
@@ -2135,6 +2207,14 @@ static void css_select__finalise_selection_state(
 	state->deferred_alloc = 0;
 	css__custom_map_unref(state->custom);
 	state->custom = NULL;
+	{
+		int p;
+
+		for (p = 0; p < CSS_PSEUDO_ELEMENT_COUNT; p++) {
+			css__custom_map_unref(state->pseudo_custom[p]);
+			state->pseudo_custom[p] = NULL;
+		}
+	}
 
 	if (state->results != NULL) {
 		css_select_results_destroy(state->results);
@@ -3318,8 +3398,17 @@ static css_error select_style(css_select_ctx *ctx, void *node,
 	state.custom = css__custom_map_intern(state.custom);
 	for (i = 0; i < CSS_PSEUDO_ELEMENT_COUNT; i++) {
 		if (state.results->styles[i] != NULL) {
-			state.results->styles[i]->custom =
-					css__custom_map_ref(state.custom);
+			css_custom_map *own = NULL;
+
+			/* a pseudo-element's own, over the element's */
+			if (i != CSS_PSEUDO_ELEMENT_NONE &&
+					state.pseudo_custom[i] != NULL) {
+				state.pseudo_custom[i] = css__custom_map_intern(
+						state.pseudo_custom[i]);
+				own = state.pseudo_custom[i];
+			}
+			state.results->styles[i]->custom = css__custom_map_ref(
+					own != NULL ? own : state.custom);
 		}
 	}
 
