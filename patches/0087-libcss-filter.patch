diff --git a/src/parse/properties/filter.c b/src/parse/properties/filter.c
new file mode 100644
index 0000000..d133a70
--- /dev/null
+++ b/src/parse/properties/filter.c
@@ -0,0 +1,412 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+#include "utils/utils.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+/**
+ * filter (VitaSurf).
+ *
+ * Every filter function but blur() and drop-shadow() is a linear map of
+ * the colour, so the whole list is folded here into one affine matrix
+ * and one alpha multiplier, and handed to the renderer as a string:
+ *
+ *   a=<alpha>;m=<12 integers>;s=<x>,<y>,<blur>,<colour>;b=<radius>
+ *
+ * with alpha and the matrix entries in units of 1/4096 (the matrix in
+ * rows of four: the fourth entry of each row is the offset, in the same
+ * units of a 0..1 channel), the shadow's lengths in CSS pixels and its
+ * colour as AARRGGBB, and the blur radius in pixels. "m=" is left out
+ * when the matrix is the identity, "s=" when there is no shadow, "b="
+ * when there is no blur. A url() filter is carried as none, so the rule
+ * survives.
+ */
+
+struct filter_fold {
+	double a[9];	/* row major 3x3 */
+	double b[3];	/* offset */
+	double alpha;
+	bool has_shadow;
+	double sx, sy, sblur;
+	uint32_t scolour;
+	double blur;
+};
+
+static void fold_identity(struct filter_fold *f)
+{
+	memset(f, 0, sizeof(*f));
+	f->a[0] = f->a[4] = f->a[8] = 1.0;
+	f->alpha = 1.0;
+}
+
+/** Apply matrix m (3x3) and offset o after what is already folded. */
+static void fold_apply(struct filter_fold *f, const double m[9],
+		const double o[3])
+{
+	double a[9], b[3];
+	int r, c, k;
+
+	for (r = 0; r < 3; r++) {
+		for (c = 0; c < 3; c++) {
+			a[r * 3 + c] = 0;
+			for (k = 0; k < 3; k++)
+				a[r * 3 + c] += m[r * 3 + k] * f->a[k * 3 + c];
+		}
+		b[r] = o[r];
+		for (k = 0; k < 3; k++)
+			b[r] += m[r * 3 + k] * f->b[k];
+	}
+	memcpy(f->a, a, sizeof(a));
+	memcpy(f->b, b, sizeof(b));
+}
+
+static bool fn_is(const css_token *t, const char *name)
+{
+	size_t len = strlen(name);
+
+	return t != NULL && t->type == CSS_TOKEN_FUNCTION &&
+			lwc_string_length(t->idata) == len &&
+			strncasecmp(lwc_string_data(t->idata), name, len) == 0;
+}
+
+/** A number or percentage argument, as a fraction; a length for blur. */
+static bool parse_amount(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, double *out, bool length)
+{
+	const css_token *token;
+	css_fixed value;
+	uint32_t unit;
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return false;
+	if (token->type == CSS_TOKEN_NUMBER) {
+		size_t consumed = 0;
+
+		value = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+		parserutils_vector_iterate(vector, ctx);
+		*out = FIXTOFLT(value);
+		return true;
+	}
+	if (css__parse_unit_specifier(c, vector, ctx, UNIT_PX, &value,
+			&unit) != CSS_OK)
+		return false;
+	if (unit == UNIT_PCT) {
+		*out = FIXTOFLT(value) / 100.0;
+		return !length;
+	}
+	if (unit & UNIT_ANGLE) {
+		double d = FIXTOFLT(value);
+
+		if (unit == UNIT_GRAD)
+			d *= 0.9;
+		else if (unit == UNIT_RAD)
+			d = d * 180.0 / M_PI;
+		else if (unit == UNIT_TURN)
+			d *= 360.0;
+		*out = d;
+		return true;
+	}
+	if (unit & UNIT_LENGTH) {
+		/* em and rem against the usual 16px; the renderer does not
+		 * have the font here */
+		double d = FIXTOFLT(value);
+
+		if (unit == UNIT_EM || unit == UNIT_REM)
+			d *= 16.0;
+		*out = d;
+		return length;
+	}
+	return false;
+}
+
+static bool expect_close(const parserutils_vector *vector, int32_t *ctx)
+{
+	consumeWhitespace(vector, ctx);
+	return tokenIsChar(parserutils_vector_iterate(vector, ctx), ')');
+}
+
+/**
+ * drop-shadow( [<colour>]? <x> <y> [<blur>]? [<colour>]? )
+ */
+static bool parse_drop_shadow(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct filter_fold *f)
+{
+	const css_token *token;
+	double len[3] = { 0, 0, 0 };
+	int lengths = 0;
+	bool has_colour = false;
+	uint32_t colour = 0xff000000;
+
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL)
+			return false;
+		if (tokenIsChar(token, ')')) {
+			parserutils_vector_iterate(vector, ctx);
+			break;
+		}
+		if (token->type == CSS_TOKEN_DIMENSION ||
+				token->type == CSS_TOKEN_NUMBER) {
+			if (lengths == 3)
+				return false;
+			if (!parse_amount(c, vector, ctx, &len[lengths], true))
+				return false;
+			lengths++;
+			continue;
+		}
+		if (!has_colour) {
+			uint16_t kind = 0;
+
+			if (css__parse_colour_specifier(c, vector, ctx,
+					&kind, &colour) != CSS_OK)
+				return false;
+			if (kind == COLOR_TRANSPARENT)
+				colour = 0;
+			else if (kind == COLOR_CURRENT_COLOR)
+				colour = 0xff000000;
+			has_colour = true;
+			continue;
+		}
+		return false;
+	}
+	if (lengths < 2)
+		return false;
+	f->has_shadow = true;
+	f->sx = len[0];
+	f->sy = len[1];
+	f->sblur = len[2] < 0 ? 0 : len[2];
+	f->scolour = colour;
+	return true;
+}
+
+/* exported interface documented in properties.h */
+css_error css__parse_filter(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	struct filter_fold f;
+	bool match, any = false, identity;
+	char buf[320];
+	size_t len;
+	lwc_string *str = NULL;
+	uint32_t snumber;
+	css_error error;
+	int i;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_FILTER);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+	    lwc_string_caseless_isequal(token->idata, c->strings[NONE],
+			&match) == lwc_error_ok && match) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_FILTER, 0, FILTER_NONE);
+	}
+
+	fold_identity(&f);
+
+	for (;;) {
+		double v;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!'))
+			break;
+		if (token->type == CSS_TOKEN_URI) {
+			/* an SVG filter: nothing to fold, the rule stays */
+			parserutils_vector_iterate(vector, ctx);
+			any = true;
+			continue;
+		}
+		if (token->type != CSS_TOKEN_FUNCTION)
+			goto invalid;
+		parserutils_vector_iterate(vector, ctx);
+		any = true;
+
+		if (fn_is(token, "drop-shadow")) {
+			if (!parse_drop_shadow(c, vector, ctx, &f))
+				goto invalid;
+			continue;
+		}
+
+		/* every other function takes one amount, or none for 1 */
+		consumeWhitespace(vector, ctx);
+		if (tokenIsChar(parserutils_vector_peek(vector, *ctx), ')')) {
+			v = fn_is(token, "blur") ? 0.0 : 1.0;
+		} else if (!parse_amount(c, vector, ctx, &v,
+				fn_is(token, "blur"))) {
+			goto invalid;
+		}
+		if (!expect_close(vector, ctx))
+			goto invalid;
+
+		if (fn_is(token, "blur")) {
+			f.blur += v;
+		} else if (fn_is(token, "brightness")) {
+			double m[9] = { v, 0, 0, 0, v, 0, 0, 0, v };
+			double o[3] = { 0, 0, 0 };
+
+			fold_apply(&f, m, o);
+		} else if (fn_is(token, "contrast")) {
+			double m[9] = { v, 0, 0, 0, v, 0, 0, 0, v };
+			double k = 0.5 * (1.0 - v);
+			double o[3] = { k, k, k };
+
+			fold_apply(&f, m, o);
+		} else if (fn_is(token, "grayscale")) {
+			double g = v > 1.0 ? 1.0 : v;
+			double m[9] = {
+				0.2126 + 0.7874 * (1 - g), 0.7152 - 0.7152 * (1 - g), 0.0722 - 0.0722 * (1 - g),
+				0.2126 - 0.2126 * (1 - g), 0.7152 + 0.2848 * (1 - g), 0.0722 - 0.0722 * (1 - g),
+				0.2126 - 0.2126 * (1 - g), 0.7152 - 0.7152 * (1 - g), 0.0722 + 0.9278 * (1 - g) };
+			double o[3] = { 0, 0, 0 };
+
+			fold_apply(&f, m, o);
+		} else if (fn_is(token, "sepia")) {
+			double s = v > 1.0 ? 1.0 : v;
+			double m[9] = {
+				0.393 + 0.607 * (1 - s), 0.769 - 0.769 * (1 - s), 0.189 - 0.189 * (1 - s),
+				0.349 - 0.349 * (1 - s), 0.686 + 0.314 * (1 - s), 0.168 - 0.168 * (1 - s),
+				0.272 - 0.272 * (1 - s), 0.534 - 0.534 * (1 - s), 0.131 + 0.869 * (1 - s) };
+			double o[3] = { 0, 0, 0 };
+
+			fold_apply(&f, m, o);
+		} else if (fn_is(token, "saturate")) {
+			double m[9] = {
+				0.213 + 0.787 * v, 0.715 - 0.715 * v, 0.072 - 0.072 * v,
+				0.213 - 0.213 * v, 0.715 + 0.285 * v, 0.072 - 0.072 * v,
+				0.213 - 0.213 * v, 0.715 - 0.715 * v, 0.072 + 0.928 * v };
+			double o[3] = { 0, 0, 0 };
+
+			fold_apply(&f, m, o);
+		} else if (fn_is(token, "invert")) {
+			double iv = v > 1.0 ? 1.0 : v;
+			double s = 1.0 - 2.0 * iv;
+			double m[9] = { s, 0, 0, 0, s, 0, 0, 0, s };
+			double o[3] = { iv, iv, iv };
+
+			fold_apply(&f, m, o);
+		} else if (fn_is(token, "opacity")) {
+			f.alpha *= v > 1.0 ? 1.0 : (v < 0 ? 0 : v);
+		} else if (fn_is(token, "hue-rotate")) {
+			double rad = v * M_PI / 180.0, cs = cos(rad), sn = sin(rad);
+			double m[9] = {
+				0.213 + cs * 0.787 - sn * 0.213, 0.715 - cs * 0.715 - sn * 0.715, 0.072 - cs * 0.072 + sn * 0.928,
+				0.213 - cs * 0.213 + sn * 0.143, 0.715 + cs * 0.285 + sn * 0.140, 0.072 - cs * 0.072 - sn * 0.283,
+				0.213 - cs * 0.213 - sn * 0.787, 0.715 - cs * 0.715 + sn * 0.715, 0.072 + cs * 0.928 + sn * 0.072 };
+			double o[3] = { 0, 0, 0 };
+
+			fold_apply(&f, m, o);
+		} else {
+			goto invalid;
+		}
+	}
+
+	if (!any)
+		goto invalid;
+
+	identity = true;
+	for (i = 0; i < 9; i++) {
+		double want = (i % 4 == 0) ? 1.0 : 0.0;
+
+		if (fabs(f.a[i] - want) > 0.0005)
+			identity = false;
+	}
+	for (i = 0; i < 3; i++) {
+		if (fabs(f.b[i]) > 0.0005)
+			identity = false;
+	}
+
+	if (identity && f.alpha >= 0.9995 && !f.has_shadow && f.blur == 0) {
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_FILTER, 0, FILTER_NONE);
+		if (error != CSS_OK)
+			*ctx = orig_ctx;
+		return error;
+	}
+
+	len = (size_t) snprintf(buf, sizeof(buf), "a=%d",
+			(int) lround(f.alpha * 4096.0));
+	if (!identity) {
+		len += (size_t) snprintf(buf + len, sizeof(buf) - len, ";m=");
+		for (i = 0; i < 3; i++) {
+			len += (size_t) snprintf(buf + len, sizeof(buf) - len,
+					"%s%d,%d,%d,%d", i ? "," : "",
+					(int) lround(f.a[i * 3] * 4096.0),
+					(int) lround(f.a[i * 3 + 1] * 4096.0),
+					(int) lround(f.a[i * 3 + 2] * 4096.0),
+					(int) lround(f.b[i] * 4096.0));
+		}
+	}
+	if (f.has_shadow) {
+		len += (size_t) snprintf(buf + len, sizeof(buf) - len,
+				";s=%d,%d,%d,%08x", (int) lround(f.sx),
+				(int) lround(f.sy), (int) lround(f.sblur),
+				(unsigned int) f.scolour);
+	}
+	if (f.blur > 0) {
+		len += (size_t) snprintf(buf + len, sizeof(buf) - len,
+				";b=%d", (int) lround(f.blur));
+	}
+	if (len >= sizeof(buf))
+		goto invalid;
+
+	if (lwc_intern_string(buf, len, &str) != lwc_error_ok)
+		return CSS_NOMEM;
+
+	error = css__stylesheet_string_add(c->sheet, str, &snumber);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_FILTER, 0,
+			FILTER_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	error = css__stylesheet_style_append(result, snumber);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+
+invalid:
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
