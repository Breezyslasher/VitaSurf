+			unit_d << 2) | (unit_c << 7) | (unit_b << 12) | (unit_a
+			<< 17)) << BOX_SHADOW_2_SHIFT);
+
+	style->i.box_shadow_2_a = length_a;
+
+	style->i.box_shadow_2_b = length_b;
+
+	style->i.box_shadow_2_c = length_c;
+
+	style->i.box_shadow_2_d = length_d;
+
+	style->i.box_shadow_2_e = color_e;
+
+	return CSS_OK;
