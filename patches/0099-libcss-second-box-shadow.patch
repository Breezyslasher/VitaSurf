+static inline css_error set_box_shadow_2(css_computed_style *style, uint8_t
+		type, css_fixed length_a, css_unit unit_a, css_fixed length_b,
+		css_unit unit_b, css_fixed length_c, css_unit unit_c, css_fixed
+		length_d, css_unit unit_d, css_color color_e)
+{
+	uint32_t *bits = &style->i.bits[BOX_SHADOW_2_INDEX];
+
+	/* 22bits: aaaaabbbbbcccccdddddtt : unit_a | unit_b | unit_c | unit_d |
+			type */
