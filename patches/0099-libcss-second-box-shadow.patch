diff --git a/src/select/properties/box_shadow_2.c b/src/select/properties/box_shadow_2.c
new file mode 100644
index 0000000..6a18452
--- /dev/null
+++ b/src/select/properties/box_shadow_2.c
@@ -0,0 +1,114 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_box_shadow_2(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_BOX_SHADOW_2_INHERIT;
+	css_fixed length[4] = { 0, 0, 0, 0 };
+	uint32_t unit[4] = { UNIT_PX, UNIT_PX, UNIT_PX, UNIT_PX };
+	css_color colour = 0;
+	int i;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case BOX_SHADOW_2_NONE:
+			value = CSS_BOX_SHADOW_2_NONE;
+			break;
+		case BOX_SHADOW_2_SET:
+			value = CSS_BOX_SHADOW_2_SET;
+			break;
+		case BOX_SHADOW_2_INSET:
+			value = CSS_BOX_SHADOW_2_INSET;
+			break;
+		}
+	}
+
+	if (value == CSS_BOX_SHADOW_2_SET || value == CSS_BOX_SHADOW_2_INSET) {
+		for (i = 0; i < 4; i++) {
+			length[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(length[i]));
+			unit[i] = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(unit[i]));
+		}
+		colour = *((css_color *) style->bytecode);
+		advance_bytecode(style, sizeof(colour));
+	}
+
+	for (i = 0; i < 4; i++) {
+		unit[i] = css__to_css_unit(unit[i]);
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_box_shadow_2(state->computed, value,
+				length[0], unit[0], length[1], unit[1],
+				length[2], unit[2], length[3], unit[3],
+				colour);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_box_shadow_2_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
+	UNUSED(style);
+
+	return CSS_OK;
+}
+
+css_error css__initial_box_shadow_2(css_select_state *state)
+{
+	return set_box_shadow_2(state->computed, CSS_BOX_SHADOW_2_NONE,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX, 0);
+}
+
+css_error css__copy_box_shadow_2(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed a = 0, b = 0, c = 0, d = 0;
+	css_unit ua = CSS_UNIT_PX, ub = CSS_UNIT_PX;
+	css_unit uc = CSS_UNIT_PX, ud = CSS_UNIT_PX;
+	css_color colour = 0;
+	uint8_t type = get_box_shadow_2(from, &a, &ua, &b, &ub, &c, &uc,
+			&d, &ud, &colour);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_box_shadow_2(to, type, a, ua, b, ub, c, uc, d, ud, colour);
+}
+
+css_error css__compose_box_shadow_2(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed a = 0, b = 0, c = 0, d = 0;
+	css_unit ua = CSS_UNIT_PX, ub = CSS_UNIT_PX;
+	css_unit uc = CSS_UNIT_PX, ud = CSS_UNIT_PX;
+	css_color colour = 0;
+	uint8_t type = get_box_shadow_2(child, &a, &ua, &b, &ub, &c, &uc,
+			&d, &ud, &colour);
+
+	return css__copy_box_shadow_2(
+			type == CSS_BOX_SHADOW_2_INHERIT ? parent : child,
+			result);
+}
