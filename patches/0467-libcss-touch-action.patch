+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* touch-action (VitaSurf): not inherited, so an element without it is auto */
+
+css_error css__cascade_touch_action(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_TOUCH_ACTION_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case TOUCH_ACTION_AUTO:
+			value = CSS_TOUCH_ACTION_AUTO;
+			break;
+		case TOUCH_ACTION_NONE:
+			value = CSS_TOUCH_ACTION_NONE;
+			break;
+		case TOUCH_ACTION_PAN_X:
+			value = CSS_TOUCH_ACTION_PAN_X;
+			break;
+		case TOUCH_ACTION_PAN_Y:
+			value = CSS_TOUCH_ACTION_PAN_Y;
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_touch_action(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_touch_action_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_touch_action(style, hint->status);
+}
+
+css_error css__initial_touch_action(css_select_state *state)
+{
+	return set_touch_action(state->computed, CSS_TOUCH_ACTION_AUTO);
+}
+
+css_error css__copy_touch_action(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_touch_action(to, get_touch_action(from));
+}
+
+css_error css__compose_touch_action(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_touch_action(child);
+
+	return css__copy_touch_action(
+			type == CSS_TOUCH_ACTION_INHERIT ? parent : child,
+			result);
+}
