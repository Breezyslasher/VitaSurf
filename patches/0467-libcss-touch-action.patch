diff --git a/src/select/properties/touch_action.c b/src/select/properties/touch_action.c
new file mode 100644
index 0000000..46d5669
--- /dev/null
+++ b/src/select/properties/touch_action.c
@@ -0,0 +1,82 @@
+/*
