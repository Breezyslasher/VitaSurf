diff --git a/src/parse/properties/touch_action.c b/src/parse/properties/touch_action.c
new file mode 100644
index 0000000..1e95a25
--- /dev/null
+++ b/src/parse/properties/touch_action.c
@@ -0,0 +1,88 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * touch-action (VitaSurf): auto | none | [ [ pan-x | pan-left | pan-right ]
+ * || [ pan-y | pan-up | pan-down ] || pinch-zoom ] | manipulation. Only
+ * which ways a touch may pan the page is kept: a slider that says none
+ * is dragged by the finger, where the page had scrolled instead. Panning
+ * one way only (pan-left) is kept as panning that axis.
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+static bool is_word(css_language *c, const css_token *token, int string)
+{
+	bool match = false;
+
+	return token != NULL && token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[string], &match) == lwc_error_ok &&
+			match;
+}
+
+css_error css__parse_touch_action(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	bool x = false, y = false, pinch = false;
+	enum flag_value flag;
+	uint16_t value;
+
+	flag = get_css_flag_value(c, token);
+	if (flag != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag,
+				CSS_PROP_TOUCH_ACTION);
+	}
+	if (is_word(c, token, AUTO) || is_word(c, token, MANIPULATION) ||
+			is_word(c, token, NONE)) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TOUCH_ACTION, 0,
+				is_word(c, token, NONE) ? TOUCH_ACTION_NONE :
+				TOUCH_ACTION_AUTO);
+	}
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!'))
+			break;
+		if (!x && (is_word(c, token, PAN_X) ||
+				is_word(c, token, PAN_LEFT) ||
+				is_word(c, token, PAN_RIGHT))) {
+			x = true;
+		} else if (!y && (is_word(c, token, PAN_Y) ||
+				is_word(c, token, PAN_UP) ||
+				is_word(c, token, PAN_DOWN))) {
+			y = true;
+		} else if (!pinch && is_word(c, token, PINCH_ZOOM)) {
+			pinch = true;
+		} else {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		parserutils_vector_iterate(vector, ctx);
+	}
+	if (!x && !y && !pinch) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	value = (x && y) ? TOUCH_ACTION_AUTO : x ? TOUCH_ACTION_PAN_X :
+			y ? TOUCH_ACTION_PAN_Y : TOUCH_ACTION_NONE;
+
+	return css__stylesheet_style_appendOPV(result, CSS_PROP_TOUCH_ACTION, 0,
+			value);
+}
