+/**
+ * Draw a rounded border of one width and colour all round as a ring
+ * (VitaSurf): the four straight sides as rectangles and each rounded
+ * corner as a cached image of the curved band, smoothed like the fills.
+ * It was one stroked path, which the framebuffer fills scan line by
+ * scan line against every edge of the flattened curves; Yamtrack
+ * scrolled with 3400 path plots a second, 130 ms of it.
+ *
+ * false, with nothing drawn, for a shape it does not cover: a corner
+ * radius over CORNER_MAX, curves that meet, or a border as wide as a
+ * radius, whose inner edge would have a square corner inside the curve.
+ */
+static bool
+rounded_ring_smooth(const struct redraw_context *ctx, colour c,
+		    const struct rect *r,
+		    const struct html_corner_radii *radii, int bw,
+		    nserror *res)
+{
+	struct bitmap *tl = NULL, *tr = NULL, *br = NULL, *bl = NULL;
+	plot_style_t style = {
+		.stroke_type = PLOT_OP_TYPE_NONE,
+		.fill_type = PLOT_OP_TYPE_SOLID,
+		.fill_colour = c
+	};
+	struct rect band;
+	bool rtl = radii->tl_h > 0 && radii->tl_v > 0;
+	bool rtr = radii->tr_h > 0 && radii->tr_v > 0;
+	bool rbr = radii->br_h > 0 && radii->br_v > 0;
+	bool rbl = radii->bl_h > 0 && radii->bl_v > 0;
+
+	if (bw <= 0 ||
+	    radii->tl_h > CORNER_MAX || radii->tl_v > CORNER_MAX ||
+	    radii->tr_h > CORNER_MAX || radii->tr_v > CORNER_MAX ||
+	    radii->br_h > CORNER_MAX || radii->br_v > CORNER_MAX ||
+	    radii->bl_h > CORNER_MAX || radii->bl_v > CORNER_MAX ||
+	    radii->tl_v + radii->bl_v > r->y1 - r->y0 ||
+	    radii->tr_v + radii->br_v > r->y1 - r->y0 ||
+	    radii->tl_h + radii->tr_h > r->x1 - r->x0 ||
+	    radii->bl_h + radii->br_h > r->x1 - r->x0 ||
+	    2 * bw >= r->x1 - r->x0 || 2 * bw >= r->y1 - r->y0 ||
+	    (rtl && (bw >= radii->tl_h || bw >= radii->tl_v)) ||
+	    (rtr && (bw >= radii->tr_h || bw >= radii->tr_v)) ||
+	    (rbr && (bw >= radii->br_h || bw >= radii->br_v)) ||
+	    (rbl && (bw >= radii->bl_h || bw >= radii->bl_v))) {
+		return false;
+	}
+	if (rtl && (tl = corner_image(radii->tl_h, radii->tl_v, bw, c,
+				      CORNER_TL)) == NULL)
+		return false;
+	if (rtr && (tr = corner_image(radii->tr_h, radii->tr_v, bw, c,
+				      CORNER_TR)) == NULL)
+		return false;
+	if (rbr && (br = corner_image(radii->br_h, radii->br_v, bw, c,
+				      CORNER_BR)) == NULL)
+		return false;
+	if (rbl && (bl = corner_image(radii->bl_h, radii->bl_v, bw, c,
+				      CORNER_BL)) == NULL)
+		return false;
+
+	/* The sides, none overlapping another or a corner: a square
+	 * corner belongs to the top or bottom side, so the left and right
+	 * sides start and end a border's width in from it. */
+#define BAND(bx0, by0, bx1, by1) do {					\
+		band.x0 = (bx0); band.y0 = (by0);			\
+		band.x1 = (bx1); band.y1 = (by1);			\
+		if (band.x1 > band.x0 && band.y1 > band.y0) {		\
+			*res = ctx->plot->rectangle(ctx, &style, &band); \
+			if (*res != NSERROR_OK) return true;		\
+		}							\
+	} while (0)
+	BAND(r->x0 + (rtl ? radii->tl_h : 0), r->y0,
+	     r->x1 - (rtr ? radii->tr_h : 0), r->y0 + bw);
+	BAND(r->x0 + (rbl ? radii->bl_h : 0), r->y1 - bw,
+	     r->x1 - (rbr ? radii->br_h : 0), r->y1);
+	BAND(r->x0, r->y0 + (rtl ? radii->tl_v : bw),
+	     r->x0 + bw, r->y1 - (rbl ? radii->bl_v : bw));
+	BAND(r->x1 - bw, r->y0 + (rtr ? radii->tr_v : bw),
+	     r->x1, r->y1 - (rbr ? radii->br_v : bw));
+#undef BAND
+
+	*res = NSERROR_OK;
+	CORNER(tl, r->x0, r->y0, radii->tl_h, radii->tl_v);
+	CORNER(tr, r->x1 - radii->tr_h, r->y0, radii->tr_h, radii->tr_v);
+	CORNER(br, r->x1 - radii->br_h, r->y1 - radii->br_v,
+	       radii->br_h, radii->br_v);
+	CORNER(bl, r->x0, r->y1 - radii->bl_v, radii->bl_h, radii->bl_v);
+	return true;
+}
+#undef CORNER
+
 /**
