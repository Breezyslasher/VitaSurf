+    JSLazyMemo *memo;           /* sorted by start once memo_sorted */
+    int memo_count, memo_size;
+    JSAtom *memo_names;         /* every entry's names, one after another */
+    uint8_t *memo_priv;         /* whether each is a private name */
+    int memo_name_count, memo_name_size;
+    bool memo_sorted;
     char data[];
 } JSSourceBlob;
 
