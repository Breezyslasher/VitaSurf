+/*
+ * What skipping one function's body found, kept from the script's first
+ * parse (VitaSurf). Compiling a lazy function skips each function inside
+ * it to its end with the tokenizer, collecting the names it uses, and a
+ * function nested n deep had its text tokenized again by each of the n
+ * compiles around it: compiling every function of a bundle that way cost
+ * 1.3 to 1.8 times compiling it whole. The first parse reads every body
+ * anyway, so where each one ends and the names it uses from outside are
+ * kept here, for a function inside a lazy one, and a skip looks them up.
+ */
+typedef struct JSLazyMemo {
+    uint32_t start;             /* the function's source, from the script's start */
+    uint32_t ptr, eol, mark;    /* its body's closing '}', and the tokenizer there */
+    int line_num, col_num, last_line_num, last_col_num;
+    uint32_t names;             /* in the blob's memo_names, what it uses
+                                   from outside, as a skip finds */
+    int16_t got_lf;
+    int16_t pad;
+    int name_count;             /* -1: not left for later, so parsed */
+} JSLazyMemo;
+
