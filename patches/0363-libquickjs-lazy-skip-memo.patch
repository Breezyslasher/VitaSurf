 /* leave fd's body for its first call: note the names it uses from
    outside, then drop its code, its variables and the functions in it */
+/*
+ * fd, a lazy function's parse, is about to be thrown away: keep, in the
+ * script's skip memo, what each function in it will need when fd is
+ * compiled (VitaSurf). One left for later is skipped, with the names it
+ * uses, which move from the child, freed with fd. One that was not, too
+ * short or called where it is written, is parsed again, and the memo
+ * says so before a skip reads it to its end to find out; the functions
+ * inside it are skipped in turn, so they are kept as well. A short one
+ * is skipped no faster from the memo than by reading it, and has nothing
+ * long inside it, so nothing is kept for it.
+ */
+static int js_lazy_memo_harvest(JSParseState *s, JSFunctionDef *fd)
+{
+    JSContext *ctx = s->ctx;
+    JSSourceBlob *blob = s->source_blob;
+    struct list_head *el;
+
+    list_for_each(el, &fd->child_list) {
+        JSFunctionDef *c = list_entry(el, JSFunctionDef, link);
+        JSLazyMemo *m;
+
+        if (!c->lazy_end_valid || c->source_blob != blob || !c->source ||
+            c->source_len < JS_LAZY_MIN_SOURCE)
+            continue;
+        if (!c->is_lazy && js_lazy_memo_harvest(s, c))
+            return -1;
+        if (blob->memo_count >= blob->memo_size) {
+            int n = blob->memo_size ? blob->memo_size * 2 : 64;
+            JSLazyMemo *t = js_realloc(ctx, blob->memo, sizeof(*t) * n);
+            if (!t)
+                return -1;
+            blob->memo = t;
+            blob->memo_size = n;
+        }
+        m = &blob->memo[blob->memo_count++];
+        m->start = c->source - blob->data;
+        m->ptr = c->lazy_end_ptr - s->buf_start;
+        m->eol = c->lazy_end_eol - s->buf_start;
+        m->mark = c->lazy_end_mark - s->buf_start;
+        m->line_num = c->lazy_end_line;
+        m->col_num = c->lazy_end_col;
+        m->last_line_num = c->lazy_end_last_line;
+        m->last_col_num = c->lazy_end_last_col;
+        m->got_lf = c->lazy_end_got_lf;
+        m->pad = 0;
+        m->names = blob->memo_name_count;
+        m->name_count = -1;
+        if (c->is_lazy) {
+            int i, n = c->lazy_name_count;
+
+            if (blob->memo_name_count + n > blob->memo_name_size) {
+                int size = blob->memo_name_size ? blob->memo_name_size : 256;
+                JSAtom *names;
+                uint8_t *priv;
+
+                while (blob->memo_name_count + n > size)
+                    size *= 2;
+                names = js_realloc(ctx, blob->memo_names,
+                                   sizeof(JSAtom) * size);
+                if (!names) {
+                    blob->memo_count--;
+                    return -1;
+                }
+                blob->memo_names = names;
+                priv = js_realloc(ctx, blob->memo_priv, size);
+                if (!priv) {
+                    blob->memo_count--;
+                    return -1;
+                }
+                blob->memo_priv = priv;
+                blob->memo_name_size = size;
+            }
+            /* the child is freed with fd: its names move */
+            for (i = 0; i < n; i++) {
+                blob->memo_names[blob->memo_name_count + i] =
+                    c->lazy_names[i];
+                blob->memo_priv[blob->memo_name_count + i] =
+                    c->lazy_private[i];
+            }
+            blob->memo_name_count += n;
+            m->name_count = n;
+            js_free(ctx, c->lazy_names);
+            js_free(ctx, c->lazy_private);
+            c->lazy_names = NULL;
+            c->lazy_private = NULL;
+            c->lazy_name_count = c->lazy_name_size = 0;
+        }
+        blob->memo_sorted = false;
+    }
+    return 0;
+}
+
+static int js_lazy_memo_cmp(const void *a, const void *b)
+{
+    uint32_t x = ((const JSLazyMemo *)a)->start;
+    uint32_t y = ((const JSLazyMemo *)b)->start;
+    return x < y ? -1 : x > y;
+}
+
+/*
+ * Skip fd's body from the script's skip memo (VitaSurf); see
+ * js_lazy_skip_body, whose result this gives without reading the body:
+ * 1 with its closing '}' current and the names it uses given to fd, 0
+ * with nothing changed and *found telling whether the memo knew it.
+ */
+static int js_lazy_skip_memo(JSParseState *s, JSFunctionDef *fd,
+                             const uint8_t *src_start, bool *found)
+{
+    JSContext *ctx = s->ctx;
+    JSSourceBlob *blob = s->source_blob;
+    JSLazyMemo *m = NULL;
+    JSParsePos body_pos, end_pos;
+    JSLazySet set;
+    uint32_t key;
+    int lo, hi, i;
+    bool called;
+
+    *found = false;
+    if (!blob || !blob->memo_count ||
+        s->buf_start != (const uint8_t *)blob->data ||
+        src_start < s->buf_start)
+        return 0;
+    if (!blob->memo_sorted) {
+        qsort(blob->memo, blob->memo_count, sizeof(blob->memo[0]),
+              js_lazy_memo_cmp);
+        blob->memo_sorted = true;
+    }
+    key = src_start - s->buf_start;
+    lo = 0;
+    hi = blob->memo_count - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) >> 1;
+        if (blob->memo[mid].start == key) {
+            m = &blob->memo[mid];
+            break;
+        }
+        if (blob->memo[mid].start < key)
+            lo = mid + 1;
+        else
+            hi = mid - 1;
+    }
+    if (!m || m->ptr <= key || m->ptr >= (uint32_t)blob->len)
+        return 0;
+    *found = true;
+    /* short or called where it is written, as js_lazy_skip_body would
+       find at its end */
+    if (m->name_count < 0 || m->ptr + 1 - key < JS_LAZY_MIN_SOURCE)
+        return 0;
+    js_parse_get_pos(s, &body_pos);
+    end_pos.last_line_num = m->last_line_num;
+    end_pos.last_col_num = m->last_col_num;
+    end_pos.line_num = m->line_num;
+    end_pos.col_num = m->col_num;
+    end_pos.got_lf = m->got_lf;
+    end_pos.ptr = s->buf_start + m->ptr;
+    end_pos.eol = s->buf_start + m->eol;
+    end_pos.mark = s->buf_start + m->mark;
+    if (js_parse_seek_token(s, &end_pos))
+        goto give_up_error;
+    if (s->token.val != '}')
+        goto give_up;
+    /* called where it is written: compiled now */
+    if (next_token(s))
+        goto give_up_error;
+    called = js_lazy_called_here(s);
+    if (js_parse_seek_token(s, &end_pos))
+        return -1;
+    if (called)
+        goto give_up;
+    memset(&set, 0, sizeof(set));
+    if (m->name_count) {
+        set.names = js_malloc(ctx, sizeof(JSAtom) * m->name_count);
+        set.priv = js_malloc(ctx, m->name_count);
+        if (!set.names || !set.priv) {
+            js_free(ctx, set.names);
+            js_free(ctx, set.priv);
+            return -1;
+        }
+        for (i = 0; i < m->name_count; i++) {
+            set.names[i] = JS_DupAtom(ctx, blob->memo_names[m->names + i]);
+            set.priv[i] = blob->memo_priv[m->names + i];
+        }
+        set.count = set.size = m->name_count;
+    }
+    js_lazy_set_give(ctx, fd, &set);
+    return 1;
+ give_up_error:
+    JS_FreeValue(ctx, JS_GetException(ctx));
+ give_up:
+    if (js_parse_seek_token(s, &body_pos))
+        return -1;
+    return 0;
+}
