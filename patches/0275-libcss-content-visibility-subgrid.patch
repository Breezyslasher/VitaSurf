diff --git a/src/parse/properties/grid.c b/src/parse/properties/grid.c
index 4bc873a..1f1b184 100644
--- a/src/parse/properties/grid.c
+++ b/src/parse/properties/grid.c
@@ -34,6 +34,7 @@
 
 #include <assert.h>
 #include <string.h>
+#include <strings.h>
 
 #include <libcss/computed.h>
 
@@ -685,6 +686,37 @@ static css_error parse_grid_template_value(css_language *c,
 				GRID_TEMPLATE_NONE);
 	}
 
+	/* subgrid, and any line names after it, which are passed over
+	 * (VitaSurf): one auto track marked as the parent's */
+	if (token->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(token->idata) == 7 &&
+			strncasecmp(lwc_string_data(token->idata),
+				"subgrid", 7) == 0) {
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+		while ((token = parserutils_vector_peek(vector, *ctx)) !=
+				NULL && tokenIsChar(token, '[')) {
+			error = skip_line_names(vector, ctx);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			consumeWhitespace(vector, ctx);
+		}
+		memset(&tracks[0], 0, sizeof(tracks[0]));
+		tracks[0].min_type = GRID_TRACK_AUTO;
+		tracks[0].max_type = GRID_TRACK_AUTO;
+		tracks[0].flags = GRID_TRACK_FLAG_SUBGRID;
+		n_tracks = 1;
+		error = css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_TEMPLATE_SET);
+		if (error == CSS_OK)
+			error = append_track_list(result, tracks, n_tracks);
+		if (error != CSS_OK)
+			*ctx = orig_ctx;
+		return error;
+	}
+
 	error = parse_track_list(c, vector, ctx, tracks, &n_tracks, true,
 			&seen_auto_repeat, 0);
 	if (error != CSS_OK) {
