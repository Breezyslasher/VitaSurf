diff --git a/src/select/properties/content_visibility.c b/src/select/properties/content_visibility.c
new file mode 100644
index 0000000..2c5a359
--- /dev/null
+++ b/src/select/properties/content_visibility.c
@@ -0,0 +1,69 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* content-visibility (VitaSurf): the opcode is the computed value less one */
+
+css_error css__cascade_content_visibility(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_CONTENT_VISIBILITY_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		value = getValue(opv) + 1;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_content_visibility(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_content_visibility_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_content_visibility(style, hint->status);
+}
+
+css_error css__initial_content_visibility(css_select_state *state)
+{
+	return set_content_visibility(state->computed, CSS_CONTENT_VISIBILITY_VISIBLE);
+}
+
+css_error css__copy_content_visibility(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_content_visibility(to, get_content_visibility(from));
+}
+
+css_error css__compose_content_visibility(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_content_visibility(child);
+
+	return css__copy_content_visibility(
+			type == CSS_CONTENT_VISIBILITY_INHERIT ? parent : child,
+			result);
+}
