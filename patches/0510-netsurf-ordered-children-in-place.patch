+	neighbours[n_neighbours].child = dom_node_ref(child);
+	neighbours[n_neighbours].after = after != NULL ?
+			dom_node_ref(after) : NULL;
+	neighbours[n_neighbours].out = out;
+	neighbours[n_neighbours].order = order;
+	n_neighbours++;
