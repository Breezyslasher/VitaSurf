+				(order & NSCSS_ORDER_PRECEDING) != 0;
+		bool near = side == 0 ? (order & NSCSS_ORDER_NEXT) != 0 :
+				(order & NSCSS_ORDER_PREV) != 0;
+		bool want_el = near, want_type = near;
