+/*
+ * Decode pacing (VitaSurf); see image_cache_frame(). Images at or
+ * under this many pixels decode even while the view moves: an icon
+ * takes well under a millisecond, and leaving one out as the page
+ * goes past shows more than it saves.
+ */
+#define IMAGE_CACHE_HOLD_PIXELS (128 * 128)
+/* a decode longer than this is named in the log */
+#define IMAGE_CACHE_SLOW_DECODE_MS 40
+
+static bool decode_hold;
+static unsigned int decode_budget_us;
+static uint64_t decode_frame_us;
+static unsigned int decode_frame_n;
+/* where skipped images were, merged into the last once full */
+#define IMAGE_CACHE_DEFERRED_MAX 32
+static struct rect deferred[IMAGE_CACHE_DEFERRED_MAX];
+static int deferred_n;
+static struct image_cache_decode_stats decode_stats;
+static uint64_t decode_stats_us;
+
+/* exported interface documented in image_cache.h */
+void image_cache_frame(bool hold, unsigned int budget_us)
+{
+	decode_hold = hold;
+	decode_budget_us = budget_us;
+	decode_frame_us = 0;
+	decode_frame_n = 0;
+}
+
+/* exported interface documented in image_cache.h */
+int image_cache_take_deferred(struct rect *out, int max)
+{
+	int i, n = 0;
+
+	for (i = 0; i < deferred_n; i++) {
+		if (n < max) {
+			out[n++] = deferred[i];
+		} else {
+			struct rect *m = &out[max - 1];
+
+			if (deferred[i].x0 < m->x0) m->x0 = deferred[i].x0;
+			if (deferred[i].y0 < m->y0) m->y0 = deferred[i].y0;
+			if (deferred[i].x1 > m->x1) m->x1 = deferred[i].x1;
+			if (deferred[i].y1 > m->y1) m->y1 = deferred[i].y1;
+		}
+	}
+	deferred_n = 0;
+	return n;
+}
+
+/* exported interface documented in image_cache.h */
+bool image_cache_frame_spent(void)
+{
+	return decode_budget_us != 0 && decode_frame_n > 0 &&
+		decode_frame_us >= decode_budget_us;
+}
+
+/* exported interface documented in image_cache.h */
+void image_cache_take_decode_stats(struct image_cache_decode_stats *s)
+{
+	*s = decode_stats;
+	s->ms = (unsigned int)(decode_stats_us / 1000);
+	memset(&decode_stats, 0, sizeof(decode_stats));
+	decode_stats_us = 0;
+}
+
+/**
+ * Whether an image may be decoded now, in an interactive redraw; if
+ * not, where it would have been drawn is recorded (VitaSurf).
+ */
+static bool image_cache_may_decode(const struct content *c,
+		const struct content_redraw_data *data,
+		const struct rect *clip)
+{
+	struct rect r;
+
+	if (decode_hold &&
+	    (uint64_t)c->width * (uint64_t)c->height >
+			IMAGE_CACHE_HOLD_PIXELS) {
+		decode_stats.held++;
+	} else if (image_cache_frame_spent()) {
+		decode_stats.budgeted++;
+	} else {
+		return true;
+	}
+
+	/* a tiled background can cover the whole clip */
+	r = *clip;
+	if (!data->repeat_x) {
+		if (r.x0 < data->x) r.x0 = data->x;
+		if (r.x1 > data->x + data->width) r.x1 = data->x + data->width;
+	}
+	if (!data->repeat_y) {
+		if (r.y0 < data->y) r.y0 = data->y;
+		if (r.y1 > data->y + data->height) r.y1 = data->y + data->height;
+	}
+	if (r.x1 <= r.x0 || r.y1 <= r.y0) {
+		/* nothing of it shows: nothing to come back for */
+		return false;
+	}
+	{
+		int i;
+		struct rect *m;
+
+		/* the same image met again in the same place */
+		for (i = 0; i < deferred_n; i++) {
+			if (deferred[i].x0 == r.x0 && deferred[i].y0 == r.y0 &&
+			    deferred[i].x1 == r.x1 && deferred[i].y1 == r.y1) {
+				return false;
+			}
+		}
+		if (deferred_n < IMAGE_CACHE_DEFERRED_MAX) {
+			deferred[deferred_n++] = r;
+			return false;
+		}
+		m = &deferred[IMAGE_CACHE_DEFERRED_MAX - 1];
+		if (r.x0 < m->x0) m->x0 = r.x0;
+		if (r.y0 < m->y0) m->y0 = r.y0;
+		if (r.x1 > m->x1) m->x1 = r.x1;
+		if (r.y1 > m->y1) m->y1 = r.y1;
+	}
+	return false;
+}
+
+/** Decode an entry's bitmap, timing it (VitaSurf). */
+static void image_cache_decode(struct image_cache_entry_s *centry)
+{
+	uint64_t t0 = vitasurf_clock_us();
+	uint64_t us;
+	unsigned int kpx;
+
+	centry->bitmap = centry->convert(centry->content);
+	us = vitasurf_clock_us() - t0;
+	decode_frame_us += us;
+	decode_frame_n++;
+	decode_stats_us += us;
+	decode_stats.decodes++;
+	kpx = (unsigned int)(((uint64_t)centry->content->width *
+			      (uint64_t)centry->content->height) / 1000);
+	decode_stats.kpixels += kpx;
+	if (us / 1000 > decode_stats.max_ms) {
+		decode_stats.max_ms = (unsigned int)(us / 1000);
+		decode_stats.max_kpixels = kpx;
+	}
+	if (us / 1000 >= IMAGE_CACHE_SLOW_DECODE_MS) {
+		const char *url = nsurl_access_leaf(
+				llcache_handle_get_url(
+					centry->content->llcache));
+
+		vita_log("images: decoding %dx%d %s took %u ms",
+			 centry->content->width, centry->content->height,
+			 url != NULL ? url : "?", (unsigned int)(us / 1000));
+	}
+}
