+/********* Pacing the decodes a redraw does (VitaSurf) *********/
+
+/**
+ * Start a frame's decoding (VitaSurf).
+ *
+ * An image is decoded the first time it is drawn, inside the redraw,
+ * on the one thread there is: a large one holds that frame for as long
+ * as it takes, and a screenful arriving together holds it for all of
+ * them. The frontend calls this at the top of each frame to say how
+ * much of it decoding may have. An image that may not be decoded yet
+ * is drawn as nothing and its place recorded, for
+ * image_cache_take_deferred() to hand back so it can be drawn again.
+ *
+ * \param hold      The view is moving: only images small enough to
+ *                  decode at once (icons) are decoded.
+ * \param budget_us Once an image has been decoded this frame, no more
+ *                  are after this long; 0 for no limit.
+ */
+void image_cache_frame(bool hold, unsigned int budget_us);
+
+/**
+ * Where images were drawn as nothing since this was last asked, in the
+ * coordinates of the redraws that skipped them: a rectangle each, the
+ * last grown to hold the rest when there are more than max.
+ *
+ * \param out Filled with up to max rectangles.
+ * \param max Room in out, at least 1.
+ * \return how many were filled.
+ */
+int image_cache_take_deferred(struct rect *out, int max);
+
+/** Whether this frame's decoding budget is spent. */
+bool image_cache_frame_spent(void);
+
+/** What decoding cost, for the log (VitaSurf). */
+struct image_cache_decode_stats {
+	unsigned int decodes;      /**< images decoded */
+	unsigned int ms;           /**< time decoding them */
+	unsigned int max_ms;       /**< the longest one */
+	unsigned int max_kpixels;  /**< its size, in thousands of pixels */
+	unsigned int kpixels;      /**< pixels decoded, in thousands */
+	unsigned int held;         /**< draws skipped while the view moved */
+	unsigned int budgeted;     /**< draws skipped for the frame budget */
+};
+
+/** Fill in the decoding figures since the last call, and reset them. */
+void image_cache_take_decode_stats(struct image_cache_decode_stats *s);
+
