+/**
+ * Remember where the redraw just made left images out, in document
+ * pixels (VitaSurf): origin is where the redraw put the document's top
+ * left corner. The list merges into its last entry once full.
+ */
+static void
+fb_images_waited(struct browser_widget_s *bwidget, int ox, int oy)
+{
+	struct rect r[FB_IMAGES_WAITING_MAX];
+	int n, i;
+
+	n = image_cache_take_deferred(r, FB_IMAGES_WAITING_MAX);
+	for (i = 0; i < n; i++) {
+		struct rect d;
+
+		d.x0 = r[i].x0 - ox;
+		d.y0 = r[i].y0 - oy;
+		d.x1 = r[i].x1 - ox;
+		d.y1 = r[i].y1 - oy;
+		fb_images_add(bwidget, &d);
+	}
+}
+
+/**
+ * Draw again the images that waited, one at a time, until this frame's
+ * decoding budget is spent (VitaSurf). One left off the screen by a
+ * scroll since is dropped: it is drawn, and decoded, when it comes
+ * back into view. What is not reached stays for the next frame.
+ */
+static void
+fb_images_draw_waiting(fbtk_widget_t *widget,
+		       struct browser_widget_s *bwidget,
+		       struct browser_window *bw)
+{
+	struct rect left[FB_IMAGES_WAITING_MAX];
+	int n = bwidget->images_waiting_n, i, kept = 0;
+	int width = fbtk_get_width(widget);
+	int height = fbtk_get_height(widget);
+	nsfb_bbox_t queued = bwidget->redraw_box;
+	bool queued_required = bwidget->redraw_required;
+
+	memcpy(left, bwidget->images_waiting, sizeof(left[0]) * n);
+	bwidget->images_waiting_n = 0;
+	for (i = 0; i < n; i++) {
+		int x0 = left[i].x0 - bwidget->scrollx;
+		int y0 = left[i].y0 - bwidget->scrolly;
+		int x1 = left[i].x1 - bwidget->scrollx;
+		int y1 = left[i].y1 - bwidget->scrolly;
+
+		if (x0 < 0) x0 = 0;
+		if (y0 < 0) y0 = 0;
+		if (x1 > width) x1 = width;
+		if (y1 > height) y1 = height;
+		if (x1 <= x0 || y1 <= y0) {
+			continue;
+		}
+		if (image_cache_frame_spent()) {
+			/* for the next frame, with any this one adds */
+			left[kept++] = left[i];
+			continue;
+		}
+		bwidget->redraw_box.x0 = x0;
+		bwidget->redraw_box.y0 = y0;
+		bwidget->redraw_box.x1 = x1;
+		bwidget->redraw_box.y1 = y1;
+		fb_redraw(widget, bwidget, bw);
+	}
+	for (i = 0; i < kept; i++) {
+		fb_images_add(bwidget, &left[i]);
+	}
+	/* fb_redraw cleared these */
+	bwidget->redraw_box = queued;
+	bwidget->redraw_required = queued_required;
+}
