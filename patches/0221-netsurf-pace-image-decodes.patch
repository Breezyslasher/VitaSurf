+/** Add a waiting image's place, once (VitaSurf). */
+static void
+fb_images_add(struct browser_widget_s *bwidget, const struct rect *d)
+{
+	struct rect *m;
+	int j;
+
+	for (j = 0; j < bwidget->images_waiting_n; j++) {
+		struct rect *w = &bwidget->images_waiting[j];
+
+		if (w->x0 == d->x0 && w->y0 == d->y0 &&
+		    w->x1 == d->x1 && w->y1 == d->y1) {
+			return;
+		}
+	}
+	if (bwidget->images_waiting_n < FB_IMAGES_WAITING_MAX) {
+		bwidget->images_waiting[bwidget->images_waiting_n++] = *d;
+		return;
+	}
+	m = &bwidget->images_waiting[FB_IMAGES_WAITING_MAX - 1];
+	if (d->x0 < m->x0) m->x0 = d->x0;
+	if (d->y0 < m->y0) m->y0 = d->y0;
+	if (d->x1 > m->x1) m->x1 = d->x1;
+	if (d->y1 > m->y1) m->y1 = d->y1;
