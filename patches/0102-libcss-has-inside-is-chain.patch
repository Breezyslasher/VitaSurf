diff --git a/src/parse/language.c b/src/parse/language.c
index eda2fa8..830e43b 100644
--- a/src/parse/language.c
+++ b/src/parse/language.c
@@ -3259,6 +3259,19 @@ static css_error parseGroupChain(css_language *c,
 			dropPrefixChain(c);
 			return error;
 		}
+
+		/*
+		 * Strings are referenced again by the append, so the
+		 * copy and the original each own one reference. A :has()
+		 * argument chain is not: the copy points at the same
+		 * selectors, and destroying "last" below would free them
+		 * under the compound that now carries them -- github.com's
+		 * ":is(.a .b:has(.c))" rules freed theirs twice. Hand the
+		 * chain over instead.
+		 */
+		if (det->value_type == CSS_SELECTOR_DETAIL_VALUE_SELECTOR) {
+			((css_selector_detail *) det)->value.selector = NULL;
+		}
 	}
 	(*parent)->specificity += last->specificity;
 	css__stylesheet_selector_destroy(c->sheet, last);
diff --git a/src/stylesheet.c b/src/stylesheet.c
index db2c7db..19201e7 100644
--- a/src/stylesheet.c
+++ b/src/stylesheet.c
@@ -1077,7 +1077,8 @@ css_error css__stylesheet_selector_destroy(css_stylesheet *sheet,
 					detail->value.string != NULL) {
 				lwc_string_unref(detail->value.string);
 			} else if (detail->value_type ==
-					CSS_SELECTOR_DETAIL_VALUE_SELECTOR) {
+					CSS_SELECTOR_DETAIL_VALUE_SELECTOR &&
+					detail->value.selector != NULL) {
 				css__stylesheet_selector_destroy(sheet,
 						detail->value.selector);
 			}
@@ -1099,7 +1100,8 @@ css_error css__stylesheet_selector_destroy(css_stylesheet *sheet,
 				detail->value.string != NULL) {
 			lwc_string_unref(detail->value.string);
 		} else if (detail->value_type ==
-				CSS_SELECTOR_DETAIL_VALUE_SELECTOR) {
+				CSS_SELECTOR_DETAIL_VALUE_SELECTOR &&
+				detail->value.selector != NULL) {
 			css__stylesheet_selector_destroy(sheet,
 					detail->value.selector);
 		}
