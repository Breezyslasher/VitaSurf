 unsigned int css_hash_in_universal;
 unsigned int css_hash_in_attr;
+/*
+ * And which pseudo-class the ones that cannot be bucketed lead with
+ * (VitaSurf). Build 405 files 11312 universal rules under a
+ * pseudo-class and walks 19,097,868 of those chain entries for 6276
+ * elements -- three thousand a piece, and the largest thing left in
+ * selection. Whether they can be narrowed depends entirely on which
+ * names they are: :hover and :focus can be answered from the node's
+ * state, :is() and :where() cannot.
+ */
+struct css_hash_uni_name css_hash_uni_names[CSS_HASH_UNI_NAME_SLOTS];
+unsigned int css_hash_uni_unnamed;
+
+static void _uni_pseudo_named(lwc_string *name)
+{
+	unsigned int k;
+
+	if (name == NULL) {
+		css_hash_uni_unnamed++;
+		return;
+	}
+	for (k = 0; k < CSS_HASH_UNI_NAME_SLOTS; k++) {
+		if (css_hash_uni_names[k].name == name) {
+			css_hash_uni_names[k].count++;
+			return;
+		}
+	}
+	for (k = 0; k < CSS_HASH_UNI_NAME_SLOTS; k++) {
+		if (css_hash_uni_names[k].name == NULL) {
+			css_hash_uni_names[k].name = name;
+			css_hash_uni_names[k].count = 1;
+			return;
+		}
+	}
+	css_hash_uni_unnamed++;
+}
 unsigned int css_hash_uni_attribute;
 unsigned int css_hash_uni_pseudo_class;
 unsigned int css_hash_uni_pseudo_element;
