+/**
+ * Is the text before a '{' a custom property's name and the start of its
+ * value (VitaSurf)? Such a value may hold blocks, "--x: a{b;c}", and the
+ * brace is part of it, not a nested rule. Home Assistant's dark theme
+ * writes one whose value runs on into "@layer wa-utilities{...}"; taken
+ * for a rule, it took the whole style attribute apart and with it every
+ * theme colour after it.
+ */
+static bool nest_custom_decl(const char *pre, size_t pren)
+{
+	size_t i;
+
+	nest_skip_leading(&pre, &pren);
+	if (pren < 3 || pre[0] != '-' || pre[1] != '-')
+		return false;
+	for (i = 2; i < pren; i++) {
+		if (pre[i] == ':')
+			return true;
+		if (pre[i] == ' ' || pre[i] == '\t' || pre[i] == '\n' ||
+				pre[i] == '\r' || pre[i] == ';')
+			break;
+	}
+	while (i < pren && (pre[i] == ' ' || pre[i] == '\t' ||
+			pre[i] == '\n' || pre[i] == '\r'))
+		i++;
+	return i < pren && pre[i] == ':';
+}
+
+/** Past the brace that closes the one at \a i, strings and comments
+ *  stepped over; or the end. */
+static size_t nest_skip_block(const char *s, size_t n, size_t i)
+{
+	size_t depth = 0;
+
+	while (i < n) {
+		if (s[i] == '{') {
+			depth++;
+		} else if (s[i] == '}') {
+			if (--depth == 0)
+				return i + 1;
+		} else {
+			i = nest_step(s, n, i);
+			continue;
+		}
+		i++;
+	}
+	return n;
+}
