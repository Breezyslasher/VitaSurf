diff --git a/content/handlers/html/html.c b/content/handlers/html/html.c
index f236de301..fd887d1e0 100644
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -4838,6 +4838,18 @@ static enum box_restyle html_restyle_siblings(html_content *c, dom_node *n,
 /** How many elements one batch of changes may select again. */
 #define HTML_ATTR_BUDGET 3000
 
+/* exported interface documented in html/html.h */
+void html_fragment_navigated(struct hlcache_handle *h, nsurl *url)
+{
+	struct content *c = hlcache_handle_get_content(h);
+
+	if (c == NULL || url == NULL || content_get_type(h) != CONTENT_HTML)
+		return;
+	if (((html_content *) c)->jsthread != NULL)
+		js_fragment_navigated(((html_content *) c)->jsthread,
+				nsurl_access(url));
+}
+
 /** The boxes from b on that were given a link's address was, given now
  * instead. */
 static void html_relink_boxes(struct box *b, nsurl *was, nsurl *now)
