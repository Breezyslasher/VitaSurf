 	return away;
 }
 
+/*
+ * Whether a box and everything in it lies outside what is being drawn
+ * (VitaSurf). Its descendant bbox covers its shadows, outline, blur and
+ * transform, so nothing of it can show. Asked before anything else: a
+ * positioned box was set aside for its stacking context first, sorted
+ * with the rest and only then found to be off screen, and on a page of
+ * 455 positioned cards every redraw of the sticky header's strip sorted
+ * all of them -- 30 ms a redraw on the Vita, a fifth of a second as the
+ * scroll went further down. Boxes whose place is decided while drawing
+ * (sticky, fixed, anchored, columns) are left to that.
+ */
+static bool html_box_culled(const html_content *html, const struct box *box,
+		int x_parent, int y_parent, const struct rect *clip,
+		float scale)
+{
+	int x0, y0, x1, y1;
+
+	if (box == html->layout || box == html_composite_active ||
+			box == html_z_painting)
+		return false;
+	switch (box->type) {
+	case BOX_BLOCK:
+	case BOX_INLINE_BLOCK:
+	case BOX_FLEX:
+	case BOX_INLINE_FLEX:
+	case BOX_TABLE:
+		break;
+	default:
+		return false;
+	}
+	if (box->flags & (ANCHORED | MULTICOL_PIECES))
+		return false;
+	if (box->style != NULL) {
+		uint8_t position = css_computed_position(box->style);
+
+		if (position == CSS_POSITION_STICKY ||
+				position == CSS_POSITION_FIXED)
+			return false;
+	}
+	x0 = (x_parent + box->x + box->descendant_x0) * scale - 2;
+	y0 = (y_parent + box->y + box->descendant_y0) * scale - 2;
+	x1 = (x_parent + box->x + box->descendant_x1) * scale + 2;
+	y1 = (y_parent + box->y + box->descendant_y1) * scale + 2;
+	return x1 <= clip->x0 || x0 >= clip->x1 ||
+			y1 <= clip->y0 || y0 >= clip->y1;
+}
+
 bool html_redraw_box(const html_content *html, struct box *box,
 		int x_parent, int y_parent,
 		const struct rect *clip, const float scale,
@@ -5693,6 +5774,10 @@ bool html_redraw_box(const html_content *html, struct box *box,
 	bool context;
 	struct html_z_list *z_outer = html_z_top, *zl = NULL;
 
+	if (html_box_culled(html, box, x_parent, y_parent, clip, scale)) {
+		vitasurf_redraw_culled++;
+		return true;
+	}
 	vitasurf_redraw_boxes++;
 
 	/* a positioned box waits for its stacking context (VitaSurf) */
