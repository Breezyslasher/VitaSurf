+++ b/content/handlers/html/redraw.c
@@ -5410,6 +5410,40 @@ static int html_z_cmp(const void *a, const void *b)
  * here sets its own positioned descendants aside in the same list, so
  * the rest is sorted again whenever it grows.
  */
+/*
+ * Sort what a painted box added to the end of a list and merge it into
+ * the sorted rest (VitaSurf), rather than sorting the whole rest again:
+ * every positioned card that set its own positioned children aside had
+ * the hundreds after it sorted once more.
+ */
+static void html_z_merge(struct html_z_list *l, unsigned from,
+		unsigned sorted)
+{
+	unsigned a = from, b = sorted, k = 0, n = l->n - from;
+	struct html_z_entry *tmp;
+
+	qsort(l->e + sorted, l->n - sorted, sizeof(*l->e), html_z_cmp);
+	if (sorted == from)
+		return;
+	tmp = malloc(n * sizeof(*tmp));
+	if (tmp == NULL) {
+		qsort(l->e + from, n, sizeof(*l->e), html_z_cmp);
+		return;
+	}
+	while (a < sorted && b < l->n) {
+		if (html_z_cmp(&l->e[b], &l->e[a]) < 0)
+			tmp[k++] = l->e[b++];
+		else
+			tmp[k++] = l->e[a++];
+	}
+	while (a < sorted)
+		tmp[k++] = l->e[a++];
+	while (b < l->n)
+		tmp[k++] = l->e[b++];
+	memcpy(l->e + from, tmp, n * sizeof(*tmp));
+	free(tmp);
+}
