+static bool inList(const char *const *list, const char *name, size_t n)
+{
+	for (; *list != NULL; list++) {
+		if (strlen(*list) == n && strncasecmp(*list, name, n) == 0)
+			return true;
+	}
+	return false;
+}
+
+/**
+ * Parse a pseudo-class or pseudo-element from the lists above (VitaSurf).
+ * The ':' or '::' has been consumed and \a token is its name.
+ */
+static css_error parsePseudoKnown(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		const css_token *token, bool require_element, bool in_not,
+		css_selector_detail *specific)
+{
+	const char *name = lwc_string_data(token->idata);
+	size_t len = lwc_string_length(token->idata);
+	bool fn = (token->type == CSS_TOKEN_FUNCTION);
+	css_selector_type type;
+	css_selector_detail_value value;
+	css_qname qname;
+	lwc_string *arg = NULL;
+
+	if (require_element) {
+		/* Chrome takes any ::-webkit- name, so sites write them
+		 * next to the standard one in a single list */
+		if (!(fn ? inList(known_element_functions, name, len) :
+				(inList(known_elements, name, len) ||
+				 (len > 8 && strncasecmp(name, "-webkit-",
+						8) == 0))))
+			return CSS_INVALID;
+		if (in_not)
+			return CSS_INVALID;
+		type = CSS_SELECTOR_PSEUDO_ELEMENT;
+	} else {
+		if (!(fn ? inList(known_class_functions, name, len) :
+				inList(known_classes, name, len)))
+			return CSS_INVALID;
+		type = CSS_SELECTOR_PSEUDO_CLASS;
+	}
+
+	if (fn) {
+		/* Keep a single identifier argument, for :dir(); step
+		 * over anything else */
+		int nesting = 0;
+		const css_token *t;
+
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_peek(vector, *ctx);
+		if (t != NULL && t->type == CSS_TOKEN_IDENT)
+			arg = t->idata;
+		for (;;) {
+			t = parserutils_vector_iterate(vector, ctx);
+			if (t == NULL)
+				return CSS_INVALID;
+			if (t->type == CSS_TOKEN_FUNCTION ||
+					tokenIsChar(t, '(')) {
+				nesting++;
+			} else if (tokenIsChar(t, ')')) {
+				if (nesting == 0)
+					break;
+				nesting--;
+			}
+		}
+	}
+
+	/* The name as written: the client compares it without case */
+	qname.ns = NULL;
+	qname.name = token->idata;
+	value.string = arg;
+	return css__stylesheet_selector_detail_init(c->sheet, type, &qname,
+			value, CSS_SELECTOR_DETAIL_VALUE_STRING, false,
+			specific);
+}
