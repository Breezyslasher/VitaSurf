+static bool isIdent(const css_token *t, const char *word)
+{
+	size_t n = strlen(word);
+
+	return t != NULL && t->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(t->idata) == n &&
+			strncasecmp(lwc_string_data(t->idata), word, n) == 0;
