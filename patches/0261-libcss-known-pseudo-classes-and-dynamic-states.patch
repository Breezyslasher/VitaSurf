+            defines, undefs = p.def_undefs
+
+            t.append()
+            t.append(defines)
+            t.append('static inline void overlay_{}(css_computed_style *dst,'
+                     .format(p.name))
+            t.append('\t\tconst css_computed_style *src)')
+            t.append('{')
+            t.indent(1)
+            t.append('dst->i.bits[{0}_INDEX] = (dst->i.bits[{0}_INDEX] & '
+                     '~{0}_MASK) |'.format(p.name.upper()))
+            t.append('\t\t(src->i.bits[{0}_INDEX] & {0}_MASK);'.format(
