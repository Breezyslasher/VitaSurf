+/**
+ * The CSS_DYNAMIC_ bits of the pseudo-classes in a chain of compounds
+ * (VitaSurf): every compound from \a sel on, through its combinators
+ * when \a chain, and the selectors inside :has() and the like.
+ */
+static uint32_t dynamic_bits(const css_selector *sel, bool chain)
+{
+	uint32_t bits = 0;
+
+	for (; sel != NULL; sel = chain ? sel->combinator : NULL) {
+		const css_selector_detail *d = &sel->data;
+
+		for (;;) {
+			/* :not(:hover) depends on it as much as :hover */
+			if (d->type == CSS_SELECTOR_PSEUDO_CLASS) {
+				const char *n = lwc_string_data(d->qname.name);
+
+				if (strcasecmp(n, "hover") == 0)
+					bits |= CSS_DYNAMIC_HOVER;
+				else if (strcasecmp(n, "active") == 0)
+					bits |= CSS_DYNAMIC_ACTIVE;
+				else if (strcasecmp(n, "focus") == 0 ||
+						strcasecmp(n, "focus-within")
+						== 0 ||
+						strcasecmp(n, "focus-visible")
+						== 0)
+					bits |= CSS_DYNAMIC_FOCUS;
+				else if (strcasecmp(n, "target") == 0 ||
+						strcasecmp(n, "target-within")
+						== 0)
+					bits |= CSS_DYNAMIC_TARGET;
+			}
+			if (d->type == CSS_SELECTOR_PSEUDO_CLASS &&
+					d->value_type ==
+					CSS_SELECTOR_DETAIL_VALUE_SELECTOR)
+				bits |= dynamic_bits(d->value.selector, true);
+			if (d->next == 0)
+				break;
+			d++;
+		}
+		if (!chain)
+			break;
+	}
+	return bits;
+}
