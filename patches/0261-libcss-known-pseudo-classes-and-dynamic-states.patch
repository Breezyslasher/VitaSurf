+/*
+ * Whether two styles lay a box out the same way (VitaSurf).
+ *
+ * A copy of \a a is given b's value for every property that only
+ * changes how a box is painted, and then compared with b. What is left
+ * to differ, if anything, moves or sizes something. A property missing
+ * from the list costs a relayout that was not needed, never a stale
+ * layout, which is why the list names what is paint only rather than
+ * what is not. Images are not in it: a new one has to be fetched, and
+ * box construction is what asks for them.
+ */
+bool css_computed_style_same_layout(const css_computed_style *a,
+		const css_computed_style *b)
+{
+	struct css_computed_style tmp;
+
+	if (a == b)
+		return true;
+	if (a == NULL || b == NULL)
+		return false;
+
+	tmp = *a;
+	overlay_animation_fill_mode(&tmp, b);
+	overlay_animation_iteration_count(&tmp, b);
+	overlay_animation_name(&tmp, b);
+	overlay_background_attachment(&tmp, b);
+	overlay_background_clip(&tmp, b);
+	overlay_background_color(&tmp, b);
+	overlay_background_position(&tmp, b);
+	overlay_background_repeat(&tmp, b);
+	overlay_background_size(&tmp, b);
+	overlay_border_bottom_color(&tmp, b);
+	overlay_border_left_color(&tmp, b);
+	overlay_border_right_color(&tmp, b);
+	overlay_border_top_color(&tmp, b);
+	overlay_border_bottom_left_radius(&tmp, b);
+	overlay_border_bottom_right_radius(&tmp, b);
+	overlay_border_top_left_radius(&tmp, b);
+	overlay_border_top_right_radius(&tmp, b);
+	overlay_box_shadow(&tmp, b);
+	overlay_box_shadow_2(&tmp, b);
+	overlay_clip_path(&tmp, b);
+	overlay_color(&tmp, b);
+	overlay_column_rule_color(&tmp, b);
+	overlay_cursor(&tmp, b);
+	overlay_fill(&tmp, b);
+	overlay_fill_opacity(&tmp, b);
+	overlay_filter(&tmp, b);
+	overlay_mask_position(&tmp, b);
+	overlay_mask_size(&tmp, b);
+	overlay_opacity(&tmp, b);
+	overlay_outline_color(&tmp, b);
+	overlay_outline_style(&tmp, b);
+	overlay_outline_width(&tmp, b);
+	overlay_pointer_events(&tmp, b);
+	overlay_stroke(&tmp, b);
+	overlay_stroke_opacity(&tmp, b);
+	overlay_stroke_width(&tmp, b);
+	overlay_text_decoration(&tmp, b);
+	overlay_text_decoration_color(&tmp, b);
+	overlay_text_decoration_style(&tmp, b);
+	overlay_text_decoration_thickness(&tmp, b);
+	overlay_text_shadow(&tmp, b);
+	overlay_text_underline_offset(&tmp, b);
+	overlay_transform(&tmp, b);
+	overlay_transform_origin(&tmp, b);
+	overlay_visibility(&tmp, b);
+	overlay_z_index(&tmp, b);
+
+	/* the variables are inherited, not laid out; a child that uses
+	 * one is restyled and compared in its own right */
+	tmp.custom = b->custom;
+
+	return css__arena_style_is_equal(&tmp,
+			(struct css_computed_style *) b);
+}
