+	"file-selector-button", "cue", "cue-region", "target-text",
+	"spelling-error", "grammar-error", "details-content",
+	"search-text", "scroll-marker", "scroll-marker-group",
+	"scroll-button", "column", "checkmark", "picker-icon",
+	"view-transition", NULL
+};
+
+static const char *const known_element_functions[] = {
+	"part", "highlight", "picker", "cue", "cue-region",
+	"scroll-button", "view-transition-group",
+	"view-transition-image-pair", "view-transition-old",
+	"view-transition-new", NULL
