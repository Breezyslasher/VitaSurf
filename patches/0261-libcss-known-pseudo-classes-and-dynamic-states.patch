+    def make_overlay_h(self):
+        """Output this group's overlay functions for overlay.h (VitaSurf).
+
+        overlay_<name>(dst, src) copies one property's bits and values
+        from src into dst, pointers and all, without taking references:
+        it is for a scratch copy of a style that is compared and then
+        dropped, never destroyed.
