+/**
+ * Parse the "of S" of :nth-child(An+B of S) (VitaSurf).
+ *
+ * The result goes in value.selector, as :has() keeps its arguments, so
+ * that the ownership, copying and freeing already written for those
+ * apply: a compound of its own holds A and B in its nth value and
+ * leads a chain of the argument compounds. Its specificity is the
+ * pseudo-class's own plus that of the most specific argument, which is
+ * how the parent's specificity comes out right when the :has() rule
+ * (the most specific of the chain) is applied to it.
+ */
+static css_error parseNthOf(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_selector_detail_value *value)
+{
+	css_selector *head = NULL, *list = NULL, *s;
+	css_qname qname;
+	uint32_t most = 0;
+	css_error error;
+
+	/* "of" */
+	parserutils_vector_iterate(vector, ctx);
+	consumeWhitespace(vector, ctx);
+
+	error = parseHasArgs(c, vector, ctx, &list);
+	if (error != CSS_OK)
+		return error;
+
+	for (s = list; s != NULL; s = s->combinator) {
+		/* a compound on its own: no combinators */
+		if (s->data.comb != CSS_COMBINATOR_NONE) {
+			css__stylesheet_selector_destroy(c->sheet, list);
+			return CSS_INVALID;
+		}
+		if (s->specificity > most)
+			most = s->specificity;
+	}
+
+	qname.ns = NULL;
+	qname.name = c->strings[UNIVERSAL];
+	error = css__stylesheet_selector_create(c->sheet, &qname, &head);
+	if (error != CSS_OK) {
+		css__stylesheet_selector_destroy(c->sheet, list);
+		return error;
+	}
+	head->data.value.nth.a = value->nth.a;
+	head->data.value.nth.b = value->nth.b;
+	head->data.value_type = CSS_SELECTOR_DETAIL_VALUE_NTH;
+	head->combinator = list;
+	head->specificity = CSS_SPECIFICITY_C + most;
+
+	value->selector = head;
+	return CSS_OK;
