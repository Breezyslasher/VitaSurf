+	/*
+	 * A line that came out of nothing -- no text, no replaced box,
+	 * no inline with a box of its own to draw -- is a line box of no
+	 * height (CSS 2.1 9.4.2), and the empty inlines on it must not
+	 * stretch the scrollable area under the block either. They were
+	 * each a line-height tall, so a page ending in an empty custom
+	 * element, a noscript, or the trailing fragment of an inline that
+	 * wraps the whole document came out a line taller than the
+	 * screen. That is what gave openmediavault a page scrollbar
+	 * beside the one its content area already had (VitaSurf).
+	 */
+	if (used_height == 0) {
+		for (d = first; d != b; d = d->next) {
+			if ((d->type != BOX_INLINE &&
+					d->type != BOX_INLINE_END) ||
+					lh__box_is_replace(d) ||
+					d->padding[TOP] != 0 ||
+					d->padding[BOTTOM] != 0 ||
+					d->border[TOP].width != 0 ||
+					d->border[BOTTOM].width != 0 ||
+					d->margin[TOP] != 0 ||
+					d->margin[BOTTOM] != 0) {
+				continue;
+			}
+			d->height = 0;
+		}
+	}
+
 	/* handle clearance for br */
