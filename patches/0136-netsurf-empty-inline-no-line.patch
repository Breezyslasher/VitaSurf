diff --git a/content/handlers/html/box_special.c b/content/handlers/html/box_special.c
index a3ac4f929..2dacfef18 100644
--- a/content/handlers/html/box_special.c
+++ b/content/handlers/html/box_special.c
@@ -1407,9 +1407,21 @@ box_noscript(dom_node *n,
 	     struct box *box,
 	     bool *convert_children)
 {
-	/* If scripting is enabled, do not display the contents of noscript */
+	/*
+	 * If scripting is enabled, do not display the contents of
+	 * noscript.
+	 *
+	 * The element itself goes too, which it did not before: with no
+	 * rule for it the element is display: inline, and an empty inline
+	 * still makes a line box. openmediavault's dashboard ends with a
+	 * noscript, and those twenty-one pixels put the page past the
+	 * bottom of the screen and gave it a scrollbar of its own beside
+	 * the one its content area already had. The HTML rendering rules
+	 * ask for display: none here when scripting is enabled.
+	 */
 	if (content->enable_scripting) {
 		*convert_children = false;
+		box->type = BOX_NONE;
 	}
 
 	return true;
