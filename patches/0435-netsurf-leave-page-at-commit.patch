+/**
+ * Stop what the page a navigation is leaving still loads (VitaSurf).
+ *
+ * Called when the navigation commits, which is where the HTML standard
+ * unloads the old document and aborts its child navigables' loads.
+ * NetSurf keeps the page on the screen until the next is ready, and
+ * the frames its script made after the navigation began loaded on:
+ * BBC's offer iframe, left for lite.cnn.com, parsed and ran 1 MB of
+ * jQuery and Angular there, 2 s, while the new page waited.
+ *
+ * \param bw browser window whose navigation commits
+ */
+static void browser_window_stop_left(struct browser_window *bw)
+{
+	int index;
+
+	if (bw->current_content != NULL &&
+	    content_get_status(bw->current_content) == CONTENT_STATUS_READY) {
+		hlcache_handle_abort(bw->current_content);
+	}
+	if (bw->children != NULL) {
+		for (index = 0; index < bw->rows * bw->cols; index++) {
+			browser_window_stop(&bw->children[index]);
+		}
+	}
+	for (index = 0; index < bw->iframe_count; index++) {
+		browser_window_stop(bw->iframes[index]);
+	}
+}
