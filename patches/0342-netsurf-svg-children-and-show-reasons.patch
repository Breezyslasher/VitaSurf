+/** Whether a node is an element in the SVG namespace. */
+static bool restyle_in_svg(dom_node *n)
+{
+	dom_string *ns = NULL;
+	bool svg = false;
+
+	if (dom_node_get_namespace(n, &ns) == DOM_NO_ERR && ns != NULL) {
+		svg = dom_string_isequal(ns, corestring_dom_svg_namespace);
+		dom_string_unref(ns);
+	}
+	return svg;
+}
+
+/** Say which hidden element could not be shown in place, and why. */
+static void restyle_show_why(dom_node *n)
+{
+	static char buf[128];
+	dom_string *name = NULL, *cls = NULL;
+	const char *c = "";
+	size_t k = 0, e;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR)
+		name = NULL;
+	if (dom_element_get_attribute(n, corestring_dom_class, &cls) !=
+			DOM_NO_ERR)
+		cls = NULL;
+	if (cls != NULL) {
+		c = dom_string_data(cls);
+		while (c[k] == ' ')
+			k++;
+	}
+	for (e = k; c[e] != '\0' && c[e] != ' '; e++)
+		;
+	snprintf(buf, sizeof(buf), "a hidden <%s%s%.*s> is shown, and "
+			"%s", name != NULL ? dom_string_data(name) : "?",
+			e > k ? "." : "", (int) (e - k), c + k, show_why);
+	if (name != NULL)
+		dom_string_unref(name);
+	if (cls != NULL)
+		dom_string_unref(cls);
+	restyle_why = buf;
+}
