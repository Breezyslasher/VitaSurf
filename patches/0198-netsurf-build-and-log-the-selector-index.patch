diff --git a/content/handlers/html/css.c b/content/handlers/html/css.c
index a1342966c..b207fce45 100644
--- a/content/handlers/html/css.c
+++ b/content/handlers/html/css.c
@@ -30,9 +30,12 @@
 #include <strings.h>
 #include <stdlib.h>
 
+#include <nsutils/time.h>
+
 #include "utils/nsoption.h"
 #include "utils/corestrings.h"
 #include "utils/log.h"
+#include "utils/utils.h"
 #include "netsurf/inttypes.h"
 #include "netsurf/misc.h"
 #include "netsurf/content.h"
@@ -1040,6 +1043,34 @@ html_css_new_selection_context(html_content *c, css_select_ctx **ret_select_ctx)
 		}
 	}
 
+	/*
+	 * Build the merged selector index now rather than on the first
+	 * element, so that its cost is timed and logged (VitaSurf). If
+	 * there is no memory for it selection goes sheet by sheet.
+	 */
+	{
+		uint32_t sheets = 0, entries = 0, bytes = 0;
+		uint64_t t0 = 0, t1 = 0;
+		css_error ierr;
+
+		nsu_getmonotonic_ms(&t0);
+		ierr = css_select_ctx_build_index(select_ctx, &sheets,
+				&entries, &bytes);
+		nsu_getmonotonic_ms(&t1);
+		vitasurf_css_index_builds++;
+		vitasurf_ms_css_index += (unsigned int) (t1 - t0);
+		if (ierr == CSS_OK) {
+			vita_log("css: index of %u rules from %u sheets "
+				 "built in %u ms, %u KB",
+				 (unsigned int) entries, (unsigned int) sheets,
+				 (unsigned int) (t1 - t0),
+				 (unsigned int) (bytes / 1024));
+		} else {
+			vita_log("css: no index (error %d): selection goes "
+				 "sheet by sheet", (int) ierr);
+		}
+	}
+
 	/* return new selection context to caller */
 	*ret_select_ctx = select_ctx;
 	return NSERROR_OK;
