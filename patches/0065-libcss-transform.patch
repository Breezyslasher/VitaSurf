diff --git a/src/parse/properties/transform.c b/src/parse/properties/transform.c
new file mode 100644
index 0000000..65c6bb9
--- /dev/null
+++ b/src/parse/properties/transform.c
@@ -0,0 +1,432 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+#include "utils/utils.h"
+
+/*
+ * Where a box is drawn relative to where it was laid out (VitaSurf).
+ *
+ * transform is the most used property this browser did not understand:
+ * about fourteen hundred declarations across every site the census
+ * measures. What those declarations mostly say is "move this", and a
+ * move is free here -- it is an offset added where the box is painted,
+ * and descendants inherit it because they are painted relative to their
+ * parent. A rotation or a scale is not free: it would mean rasterising
+ * the subtree through a matrix, which this framebuffer cannot afford.
+ *
+ * So the translation is taken and the rest is stepped over. That is not
+ * a guess about what looks acceptable: scale() and rotate() about the
+ * default origin leave the box's centre exactly where it was, so a box
+ * that is only scaled or rotated stays in the right place, and the one
+ * thing that does move it -- the translation -- is exact. Dropping the
+ * whole declaration, which is what happened before, moved every one of
+ * them to the wrong place.
+ *
+ * The translation is stored as a pair of lengths, so a percentage
+ * survives to paint time, where it means a fraction of the box's own
+ * border box.
+ */
+
+/**
+ * Step over one function's arguments, from just after its opening
+ * bracket to just after the bracket that closes it.
+ *
+ * \param vector  Vector of tokens to process
+ * \param ctx     Pointer to vector iteration context
+ * \return true if the function was closed, false if the tokens ran out
+ */
+static bool skip_function_args(const parserutils_vector *vector, int32_t *ctx)
+{
+	const css_token *token;
+	int depth = 1;
+
+	while (depth > 0) {
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL) {
+			return false;
+		}
+		if (token->type == CSS_TOKEN_FUNCTION) {
+			depth++;
+		} else if (tokenIsChar(token, '(')) {
+			depth++;
+		} else if (tokenIsChar(token, ')')) {
+			depth--;
+		}
+	}
+
+	return true;
+}
+
+/**
+ * Read one length, in px unless the value says otherwise.
+ *
+ * A bare number is allowed because that is what a matrix() carries: its
+ * last two arguments are a translation in pixels, written without a unit.
+ */
+static css_error parse_translation(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_fixed *length, uint32_t *unit)
+{
+	css_error error;
+
+	consumeWhitespace(vector, ctx);
+
+	error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+			length, unit);
+	if (error != CSS_OK) {
+		return error;
+	}
+
+	/* A duration or an angle is not a distance. */
+	if ((*unit & UNIT_ANGLE) || (*unit & UNIT_TIME) ||
+			(*unit & UNIT_FREQ) || (*unit & UNIT_RESOLUTION)) {
+		return CSS_INVALID;
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Read the arguments of a function that moves the box, adding what it
+ * moves by to the running total.
+ *
+ * Only a translation in the same unit can be added to a running total
+ * without knowing the box, so a second translation in a different unit
+ * replaces the first rather than being silently dropped: mixing units
+ * across two functions is rare, and the later one is the one an author
+ * is more likely to have meant.
+ */
+static css_error accumulate(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		int axis, css_fixed *total, uint32_t *total_unit)
+{
+	const css_token *token;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+	css_error error;
+
+	consumeWhitespace(vector, ctx);
+
+	/*
+	 * An argument that is itself a function -- calc() and its
+	 * relatives -- is stepped over and contributes nothing. The
+	 * translation is stored as a plain length pair, with nowhere to
+	 * keep an expression, and moving the box by the rest of what the
+	 * declaration says beats throwing all of it away.
+	 */
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && token->type == CSS_TOKEN_FUNCTION) {
+		parserutils_vector_iterate(vector, ctx);
+		if (skip_function_args(vector, ctx) == false) {
+			return CSS_INVALID;
+		}
+		return CSS_OK;
+	}
+
+	error = parse_translation(c, vector, ctx, &length, &unit);
+	if (error != CSS_OK) {
+		return error;
+	}
+
+	if (total[axis] != 0 && total_unit[axis] != unit) {
+		total[axis] = length;
+	} else {
+		total[axis] = total[axis] + length;
+	}
+	total_unit[axis] = unit;
+
+	return CSS_OK;
+}
+
+/**
+ * Parse transform: none | <transform-function>+
+ */
+css_error css__parse_transform(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_fixed length[2] = { 0, 0 };
+	uint32_t unit[2] = { UNIT_PX, UNIT_PX };
+	enum flag_value flag_value;
+	css_error error;
+	bool match;
+	int functions = 0;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_TRANSFORM);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+	    lwc_string_caseless_isequal(token->idata, c->strings[NONE],
+			&match) == lwc_error_ok && match) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TRANSFORM, 0, TRANSFORM_NONE);
+	}
+
+	while (1) {
+		consumeWhitespace(vector, ctx);
+
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || token->type != CSS_TOKEN_FUNCTION) {
+			break;
+		}
+		parserutils_vector_iterate(vector, ctx);
+		functions++;
+
+		if ((lwc_string_caseless_isequal(token->idata,
+				c->strings[TRANSLATE_FN], &match) ==
+				lwc_error_ok && match) ||
+		    (lwc_string_caseless_isequal(token->idata,
+				c->strings[TRANSLATE_3D], &match) ==
+				lwc_error_ok && match)) {
+			/* translate(x[, y]) and translate3d(x, y, z): the
+			 * depth of a 3d translation is nothing here. */
+			error = accumulate(c, vector, ctx, 0, length, unit);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			consumeWhitespace(vector, ctx);
+			token = parserutils_vector_peek(vector, *ctx);
+			if (token != NULL && tokenIsChar(token, ',')) {
+				parserutils_vector_iterate(vector, ctx);
+				error = accumulate(c, vector, ctx, 1,
+						length, unit);
+				if (error != CSS_OK) {
+					*ctx = orig_ctx;
+					return error;
+				}
+			}
+			if (skip_function_args(vector, ctx) == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			continue;
+		}
+
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[TRANSLATE_X], &match) ==
+				lwc_error_ok && match) {
+			error = accumulate(c, vector, ctx, 0, length, unit);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			if (skip_function_args(vector, ctx) == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			continue;
+		}
+
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[TRANSLATE_Y], &match) ==
+				lwc_error_ok && match) {
+			error = accumulate(c, vector, ctx, 1, length, unit);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			if (skip_function_args(vector, ctx) == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			continue;
+		}
+
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[MATRIX], &match) ==
+				lwc_error_ok && match) {
+			/* matrix(a, b, c, d, tx, ty): six plain numbers, of
+			 * which the last two are the translation in pixels.
+			 * They carry no unit, so they are read as numbers
+			 * rather than through the length parser. */
+			int arg;
+
+			for (arg = 0; arg < 6; arg++) {
+				size_t consumed = 0;
+				css_fixed v;
+
+				if (arg > 0) {
+					consumeWhitespace(vector, ctx);
+					token = parserutils_vector_peek(
+							vector, *ctx);
+					if (token == NULL ||
+						!tokenIsChar(token, ',')) {
+						break;
+					}
+					parserutils_vector_iterate(vector, ctx);
+				}
+
+				consumeWhitespace(vector, ctx);
+				token = parserutils_vector_peek(vector, *ctx);
+				if (token == NULL ||
+					token->type != CSS_TOKEN_NUMBER) {
+					break;
+				}
+				parserutils_vector_iterate(vector, ctx);
+
+				v = css__number_from_lwc_string(token->idata,
+						false, &consumed);
+				if (consumed != lwc_string_length(token->idata)) {
+					break;
+				}
+
+				if (arg == 4) {
+					length[0] = v;
+					unit[0] = UNIT_PX;
+				} else if (arg == 5) {
+					length[1] = v;
+					unit[1] = UNIT_PX;
+				}
+			}
+			if (skip_function_args(vector, ctx) == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			continue;
+		}
+
+		/* A function that does not move the box, or one this does
+		 * not know: step over it and keep what the others said. */
+		if (skip_function_args(vector, ctx) == false) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+	}
+
+	if (functions == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_TRANSFORM, 0,
+			TRANSFORM_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = css__stylesheet_style_vappend(result, 4,
+			length[0], unit[0], length[1], unit[1]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
+
+/**
+ * Parse translate: none | <length-percentage> [ <length-percentage>
+ *                                               <length>? ]?
+ *
+ * The individual transform property, which means the same thing as a
+ * transform holding one translate(), and is stored in the same place.
+ * A rule that sets both gets the later one rather than the two composed,
+ * which is what the specification asks for; setting both is rare enough
+ * to be worth the simplicity.
+ */
+css_error css__parse_translate(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_fixed length[2] = { 0, 0 };
+	uint32_t unit[2] = { UNIT_PX, UNIT_PX };
+	enum flag_value flag_value;
+	css_error error;
+	bool match;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_TRANSFORM);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+	    lwc_string_caseless_isequal(token->idata, c->strings[NONE],
+			&match) == lwc_error_ok && match) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TRANSFORM, 0, TRANSFORM_NONE);
+	}
+
+	error = parse_translation(c, vector, ctx, &length[0], &unit[0]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && token->type != CSS_TOKEN_EOF &&
+			!tokenIsChar(token, '!') && !tokenIsChar(token, ';')) {
+		error = parse_translation(c, vector, ctx, &length[1], &unit[1]);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+
+		/* A third value is the depth, which is nothing here. */
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token != NULL && token->type != CSS_TOKEN_EOF &&
+				!tokenIsChar(token, '!') &&
+				!tokenIsChar(token, ';')) {
+			css_fixed z = 0;
+			uint32_t zunit = UNIT_PX;
+
+			error = parse_translation(c, vector, ctx, &z, &zunit);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+		}
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_TRANSFORM, 0,
+			TRANSFORM_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = css__stylesheet_style_vappend(result, 4,
+			length[0], unit[0], length[1], unit[1]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
diff --git a/src/select/properties/transform.c b/src/select/properties/transform.c
new file mode 100644
index 0000000..d75a2dc
--- /dev/null
+++ b/src/select/properties/transform.c
@@ -0,0 +1,103 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_transform(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_TRANSFORM_INHERIT;
+	css_fixed hlength = 0;
+	css_fixed vlength = 0;
+	uint32_t hunit = UNIT_PX;
+	uint32_t vunit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case TRANSFORM_NONE:
+			value = CSS_TRANSFORM_NONE;
+			break;
+		default:
+			value = CSS_TRANSFORM_SET;
+			break;
+		}
+	}
+
+	if (value == CSS_TRANSFORM_SET) {
+		hlength = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(hlength));
+		hunit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(hunit));
+
+		vlength = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(vlength));
+		vunit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(vunit));
+	}
+
+	hunit = css__to_css_unit(hunit);
+	vunit = css__to_css_unit(vunit);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_transform(state->computed, value,
+				hlength, hunit, vlength, vunit);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_transform_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_transform(style, hint->status,
+		hint->data.position.h.value, hint->data.position.h.unit,
+		hint->data.position.v.value, hint->data.position.v.unit);
+}
+
+css_error css__initial_transform(css_select_state *state)
+{
+	return set_transform(state->computed, CSS_TRANSFORM_NONE,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX);
+}
+
+css_error css__copy_transform(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed hlength = 0, vlength = 0;
+	css_unit hunit = CSS_UNIT_PX, vunit = CSS_UNIT_PX;
+	uint8_t type = get_transform(from, &hlength, &hunit,
+			&vlength, &vunit);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_transform(to, type, hlength, hunit, vlength, vunit);
+}
+
+css_error css__compose_transform(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed hlength = 0, vlength = 0;
+	css_unit hunit = CSS_UNIT_PX, vunit = CSS_UNIT_PX;
+	uint8_t type = get_transform(child, &hlength, &hunit,
+			&vlength, &vunit);
+
+	return css__copy_transform(
+			type == CSS_TRANSFORM_INHERIT ? parent : child,
+			result);
+}
