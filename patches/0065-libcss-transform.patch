+static inline uint8_t get_transform(const css_computed_style *style, css_fixed
+		*length_a, css_unit *unit_a, css_fixed *length_b, css_unit
+		*unit_b)
+{
+	uint8_t type;
+	uint32_t bits = style->i.bits[TRANSFORM_INDEX];
+	bits &= TRANSFORM_MASK;
+	bits >>= TRANSFORM_SHIFT;
+
+	/* 12bits: aaaaabbbbbtt : unit_a | unit_b | type */
+	type = bits & 0x3;
+	if (type == CSS_TRANSFORM_SET) {
+		*length_a = style->i.transform_a;
+		*length_b = style->i.transform_b;
+		*unit_a = bits >> 7;
+		*unit_b = (bits & 0x7c) >> 2;
+	}
+
+	return type;
+}
