diff --git a/content/handlers/javascript/js.h b/content/handlers/javascript/js.h
index ce1c554c0..4def16b9a 100644
--- a/content/handlers/javascript/js.h
+++ b/content/handlers/javascript/js.h
@@ -144,6 +144,33 @@ bool js_fire_event(jsthread *thread, const char *type, struct dom_document *doc,
  */
 void js_activate(jsthread *thread, struct dom_node *target, int x, int y);
 
+/**
+ * Submit a form the user submitted with a button, as script submits one
+ * (VitaSurf): the submit event naming the button, the HTML standard's
+ * entry list and formdata event, and the body its method and enctype
+ * give, so a tap sends what requestSubmit() would.
+ *
+ * \param thread The script thread of the form's document.
+ * \param form The form.
+ * \param submitter The button that submitted it.
+ * \param x, y Where an image button was clicked, in its own
+ *             coordinates, or 0.
+ * \return true if script took the submission, false to submit natively.
+ */
+bool js_submit(jsthread *thread, struct dom_node *form,
+	       struct dom_node *submitter, int x, int y);
+
+/**
+ * Submit a form implicitly, as Enter in one of its fields does (VitaSurf):
+ * its default button is clicked, or with none, the form is submitted
+ * when it has only the one field that could take Enter.
+ *
+ * \param thread The script thread of the form's document.
+ * \param form The form.
+ * \return true if script took it, false to submit natively.
+ */
+bool js_implicit_submit(jsthread *thread, struct dom_node *form);
+
