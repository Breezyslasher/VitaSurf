  */
 void vita_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
 
+/**
+ * Whether the caches have been turned off from the menu (VitaSurf).
+ *
+ * Weak: only the Vita build provides one, and the host test build links
+ * the same core without it.
+ */
+extern bool vitasurf_cache_disabled(void) __attribute__((weak));
