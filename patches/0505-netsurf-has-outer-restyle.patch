+/*
+ * A :has() was tried on a node (VitaSurf): it is marked, and its parent
+ * too when the argument looked at its later siblings, so that a change
+ * such a :has() asks about finds where it can be (nscss_has_subject).
+ */
+static void note_has(void *pw, void *node, bool siblings)
+{
+	dom_node *n = node, *parent = NULL;
+	dom_node_type type;
+
+	(void)pw;
+	mark_element(n, MARK_ORDERED | MARK_HAS);
+	if (!siblings || dom_node_get_parent_node(n, &parent) != DOM_NO_ERR ||
+			parent == NULL)
+		return;
+	if (dom_node_get_node_type(parent, &type) == DOM_NO_ERR &&
+			type == DOM_ELEMENT_NODE)
+		mark_element(parent, MARK_ORDERED | MARK_HAS);
+	dom_node_unref(parent);
+}
+
+/* exported function documented in css/select.h */
+bool nscss_has_subject(dom_node *n)
+{
+	void *mark = NULL;
+
+	return dom_node_get_user_data(n,
+			corestring_dom___ns_key_children_ordered, &mark) !=
+			DOM_NO_ERR || ((uintptr_t) mark & MARK_HAS) != 0;
+}
