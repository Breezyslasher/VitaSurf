+/**
+ * Restyle what a :has() left of a combinator can answer differently for
+ * a change to an element (VitaSurf). libcss tells NetSurf each element a
+ * :has() was tried on (the parent too, for an argument that looks at
+ * siblings: note_has), so a :has() that could now answer otherwise is on
+ * a marked ancestor:
+ * the highest one, its subtree and the subtrees of its later siblings
+ * are selected again in place, which holds whatever a combinator after
+ * the :has() reaches. A :has() never tried on an element decides no
+ * style there. cnn.com's page, with 499 such selectors, had been built
+ * again for each change one of them asked about, 2.4 s each.
+ */
+static enum box_restyle html_restyle_has_outer(html_content *c, dom_node *n,
+		unsigned *budget)
+{
+	enum box_restyle result = BOX_RESTYLE_SAME, r;
+	dom_node *at, *next = NULL, *top = NULL;
+	dom_node_type type;
+
+	if (dom_node_get_parent_node(n, &at) != DOM_NO_ERR)
+		return BOX_RESTYLE_LAYOUT;
+	while (at != NULL) {
+		if (dom_node_get_node_type(at, &type) != DOM_NO_ERR ||
+				type != DOM_ELEMENT_NODE)
+			break;
+		if (nscss_has_subject(at)) {
+			if (top != NULL)
+				dom_node_unref(top);
+			top = dom_node_ref(at);
+		}
+		if (dom_node_get_parent_node(at, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(at);
+		at = next;
+	}
+	if (at != NULL)
+		dom_node_unref(at);
+	if (top == NULL)
+		return BOX_RESTYLE_SAME;
+
+	/* the root's subtree is the whole page, which is built again */
+	if (box_for_node(top) == c->layout) {
+		dom_node_unref(top);
+		return BOX_RESTYLE_LAYOUT;
+	}
+	at = top;
+	while (at != NULL && result != BOX_RESTYLE_LAYOUT) {
+		if (dom_node_get_node_type(at, &type) == DOM_NO_ERR &&
+				type == DOM_ELEMENT_NODE) {
+			r = box_restyle(c, at, true, budget);
+			if (r > result)
+				result = r;
+		}
+		if (dom_node_get_next_sibling(at, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(at);
+		at = next;
+	}
+	if (at != NULL)
+		dom_node_unref(at);
+	return result;
+}
