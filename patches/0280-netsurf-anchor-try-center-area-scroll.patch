+			css_computed_anchor_bottom(b->style, &s) ==
+				CSS_ANCHOR_BOTTOM_SET && s != NULL)
+		r->side[SIDE_BOTTOM] = lwc_string_data(s);
+	if (css_computed_left(b->style, &l, &u) == CSS_LEFT_AUTO &&
+			css_computed_anchor_left(b->style, &s) ==
+				CSS_ANCHOR_LEFT_SET && s != NULL)
+		r->side[SIDE_LEFT] = lwc_string_data(s);
+	if (css_computed_right(b->style, &l, &u) == CSS_RIGHT_AUTO &&
+			css_computed_anchor_right(b->style, &s) ==
+				CSS_ANCHOR_RIGHT_SET && s != NULL)
+		r->side[SIDE_RIGHT] = lwc_string_data(s);
+	if (css_computed_position_area(b->style, &s) ==
+			CSS_POSITION_AREA_SET && s != NULL)
+		r->area = lwc_string_data(s);
