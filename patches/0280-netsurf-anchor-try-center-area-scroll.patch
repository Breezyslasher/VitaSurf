+/** How much room the area gives along one axis, from the bounds. */
+static int anchor_area_room(enum area_kind k, int a0, int alen, int lo,
+		int hi)
+{
+	switch (k) {
+	case A_BEFORE:
+		return a0 - lo;
+	case A_AFTER:
+		return hi - (a0 + alen);
+	case A_CENTER:
+		return alen;
+	case A_SPAN_BEFORE:
+		return a0 + alen - lo;
+	case A_SPAN_AFTER:
+		return hi - a0;
+	default:
+		return hi - lo;
+	}
