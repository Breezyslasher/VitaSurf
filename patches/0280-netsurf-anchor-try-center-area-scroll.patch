+/**
+ * A @position-try rule's declarations over a box's rules: the insets,
+ * position-area, position-anchor and the self alignment it sets.
+ * An inset it gives as a length rather than an anchor() stops the
+ * box's own anchor() for that side.
+ */
+static void anchor_rules_try(struct anchor_ctx *a, struct box *b,
+		const char *text, struct anchor_rules *r)
+{
+	const char *p = text;
+
+	while (*p != '\0') {
+		const char *colon, *end, *start;
+		char prop[40], val[128];
+		size_t pl, vl;
+		int side = -1;
+
+		while (*p == ' ' || *p == '\n' || *p == '\t' || *p == ';' ||
+				*p == '\r')
+			p++;
+		if (*p == '\0')
+			break;
+		start = p;
+		colon = strchr(p, ':');
+		if (colon == NULL)
+			break;
+		end = strchr(colon, ';');
+		if (end == NULL)
+			end = colon + strlen(colon);
+		pl = (size_t) (colon - p);
+		while (pl > 0 && (p[pl - 1] == ' ' || p[pl - 1] == '\t'))
+			pl--;
+		vl = (size_t) (end - colon - 1);
+		p = colon + 1;
+		while (vl > 0 && (*p == ' ' || *p == '\t' || *p == '\n')) {
+			p++;
+			vl--;
+		}
+		while (vl > 0 && (p[vl - 1] == ' ' || p[vl - 1] == '\n' ||
+				p[vl - 1] == '\t' || p[vl - 1] == '\r'))
+			vl--;
+		if (pl >= sizeof(prop) || vl >= sizeof(val)) {
+			p = *end ? end + 1 : end;
+			continue;
+		}
+		memcpy(prop, start, pl);
+		prop[pl] = '\0';
+		memcpy(val, p, vl);
+		val[vl] = '\0';
+		p = *end ? end + 1 : end;
+
+		if (strcasecmp(prop, "top") == 0)
+			side = SIDE_TOP;
+		else if (strcasecmp(prop, "right") == 0)
+			side = SIDE_RIGHT;
+		else if (strcasecmp(prop, "bottom") == 0)
+			side = SIDE_BOTTOM;
+		else if (strcasecmp(prop, "left") == 0)
+			side = SIDE_LEFT;
+
+		if (side >= 0) {
+			if (strstr(val, "anchor(") != NULL) {
+				memcpy(r->buf[side], val, vl + 1);
+				r->side[side] = r->buf[side];
+			} else {
+				r->side[side] = NULL;
+			}
+		} else if (strcasecmp(prop, "inset") == 0 &&
+				strstr(val, "anchor(") == NULL) {
+			r->side[0] = r->side[1] = r->side[2] =
+					r->side[3] = NULL;
+		} else if (strcasecmp(prop, "position-area") == 0 ||
+				strcasecmp(prop, "inset-area") == 0) {
+			if (strcasecmp(val, "none") == 0) {
+				r->area = NULL;
+			} else if (vl < sizeof(r->area_buf)) {
+				memcpy(r->area_buf, val, vl + 1);
+				r->area = r->area_buf;
+			}
+		} else if (strcasecmp(prop, "position-anchor") == 0) {
+			r->def = strncmp(val, "--", 2) == 0 ?
+					anchor_find(a, val, vl, b) :
+					anchor_default(a, b);
+		} else if (strcasecmp(prop, "align-self") == 0 ||
+				strcasecmp(prop, "place-self") == 0) {
+			r->center_v = strstr(val, "anchor-center") != NULL;
+			if (prop[0] == 'p' || prop[0] == 'P')
+				r->center_h = r->center_v;
+		} else if (strcasecmp(prop, "justify-self") == 0) {
+			r->center_h = strstr(val, "anchor-center") != NULL;
+		}
+	}
+}
