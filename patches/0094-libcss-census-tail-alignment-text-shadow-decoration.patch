+		{ END, ALIGN_CONTENT_FLEX_END },
+		{ NORMAL, ALIGN_CONTENT_STRETCH },
+		{ BASELINE, ALIGN_CONTENT_FLEX_START },
+	};
+
+	return css__parse_with_keyword_aliases(c, vector, ctx, result,
+			CSS_PROP_ALIGN_CONTENT, table, 4,
+			css__parse_align_content);
+}
+
+css_error css__parse_justify_content_ext(css_language *c,
