new file mode 100644
index 0000000..d2ea3ab
--- /dev/null
+++ b/src/select/properties/text_shadow.c
@@ -0,0 +1,108 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_text_shadow(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_TEXT_SHADOW_INHERIT;
+	css_fixed length[3] = { 0, 0, 0 };
+	uint32_t unit[3] = { UNIT_PX, UNIT_PX, UNIT_PX };
+	css_color colour = 0;
+	int i;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case TEXT_SHADOW_NONE:
+			value = CSS_TEXT_SHADOW_NONE;
+			break;
+		case TEXT_SHADOW_SET:
+			value = CSS_TEXT_SHADOW_SET;
+			break;
+		}
+	}
+
+	if (value == CSS_TEXT_SHADOW_SET) {
+		for (i = 0; i < 3; i++) {
+			length[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(length[i]));
+			unit[i] = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(unit[i]));
+		}
+		colour = *((css_color *) style->bytecode);
+		advance_bytecode(style, sizeof(colour));
+	}
+
+	for (i = 0; i < 3; i++) {
+		unit[i] = css__to_css_unit(unit[i]);
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_text_shadow(state->computed, value,
+				length[0], unit[0], length[1], unit[1],
+				length[2], unit[2], colour);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_text_shadow_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
+	UNUSED(style);
+
+	return CSS_OK;
+}
+
+css_error css__initial_text_shadow(css_select_state *state)
+{
+	return set_text_shadow(state->computed, CSS_TEXT_SHADOW_NONE,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX, 0, CSS_UNIT_PX, 0);
+}
+
+css_error css__copy_text_shadow(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed length[3] = { 0, 0, 0 };
+	css_unit unit[3] = { CSS_UNIT_PX, CSS_UNIT_PX, CSS_UNIT_PX };
+	css_color colour = 0;
+	uint8_t type = get_text_shadow(from, &length[0], &unit[0],
+			&length[1], &unit[1], &length[2], &unit[2], &colour);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_text_shadow(to, type, length[0], unit[0],
+			length[1], unit[1], length[2], unit[2], colour);
+}
+
+css_error css__compose_text_shadow(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed length[3] = { 0, 0, 0 };
+	css_unit unit[3] = { CSS_UNIT_PX, CSS_UNIT_PX, CSS_UNIT_PX };
+	css_color colour = 0;
+	uint8_t type = get_text_shadow(child, &length[0], &unit[0],
+			&length[1], &unit[1], &length[2], &unit[2], &colour);
+
+	return css__copy_text_shadow(
+			type == CSS_TEXT_SHADOW_INHERIT ? parent : child,
+			result);
+}
