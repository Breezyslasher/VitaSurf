new file mode 100644
index 0000000..b1340df
--- /dev/null
+++ b/src/parse/properties/census_tail.c
@@ -0,0 +1,696 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * The tail of the census (VitaSurf): what the fixture sites still
+ * wrote that libcss dropped once the large properties were in. The
+ * alignment keywords the box alignment specification added (start,
+ * end, self-start, normal, left, right), the place-* shorthands,
+ * justify-items and justify-self, text-shadow, the text-decoration
+ * longhands, stroke-width and the all shorthand.
+ */
+
+/**
+ * Read one of a property's extra keywords, or hand over to the
+ * standard parser. A leading safe or unsafe is stepped over.
+ */
+css_error css__parse_with_keyword_aliases(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, uint16_t prop,
+		const struct css_keyword_alias *table, size_t n,
+		css_error (*standard)(css_language *c,
+				const parserutils_vector *vector, int32_t *ctx,
+				css_style *result))
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	bool match;
+	size_t i;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && token->type == CSS_TOKEN_IDENT &&
+			((lwc_string_caseless_isequal(token->idata,
+				c->strings[SAFE], &match) == lwc_error_ok &&
+				match) ||
+			 (lwc_string_caseless_isequal(token->idata,
+				c->strings[UNSAFE], &match) == lwc_error_ok &&
+				match))) {
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+	}
+
+	if (token != NULL && token->type == CSS_TOKEN_IDENT) {
+		for (i = 0; i < n; i++) {
+			if (lwc_string_caseless_isequal(token->idata,
+					c->strings[table[i].string],
+					&match) == lwc_error_ok && match) {
+				parserutils_vector_iterate(vector, ctx);
+				return css__stylesheet_style_appendOPV(result,
+						prop, 0, table[i].value);
+			}
+		}
+	}
+
+	if (standard(c, vector, ctx, result) != CSS_OK) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return CSS_OK;
+}
+
+css_error css__parse_align_items_ext(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct css_keyword_alias table[] = {
+		{ START, ALIGN_ITEMS_FLEX_START },
+		{ END, ALIGN_ITEMS_FLEX_END },
+		{ SELF_START, ALIGN_ITEMS_FLEX_START },
+		{ SELF_END, ALIGN_ITEMS_FLEX_END },
+		{ NORMAL, ALIGN_ITEMS_STRETCH },
+		{ FIRST, ALIGN_ITEMS_BASELINE },
+	};
+
+	return css__parse_with_keyword_aliases(c, vector, ctx, result,
+			CSS_PROP_ALIGN_ITEMS, table, 6,
+			css__parse_align_items);
+}
+
+css_error css__parse_align_self_ext(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct css_keyword_alias table[] = {
+		{ START, ALIGN_SELF_FLEX_START },
+		{ END, ALIGN_SELF_FLEX_END },
+		{ SELF_START, ALIGN_SELF_FLEX_START },
+		{ SELF_END, ALIGN_SELF_FLEX_END },
+		{ NORMAL, ALIGN_SELF_STRETCH },
+	};
+
+	return css__parse_with_keyword_aliases(c, vector, ctx, result,
+			CSS_PROP_ALIGN_SELF, table, 5,
+			css__parse_align_self);
+}
+
+css_error css__parse_align_content_ext(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct css_keyword_alias table[] = {
