+css_error css__set_text_decoration_style_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_text_decoration_style(style, hint->status);
+}
+
+css_error css__initial_text_decoration_style(css_select_state *state)
+{
+	return set_text_decoration_style(state->computed, CSS_TEXT_DECORATION_STYLE_SOLID);
+}
+
+css_error css__copy_text_decoration_style(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_text_decoration_style(to, get_text_decoration_style(from));
+}
+
+css_error css__compose_text_decoration_style(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_text_decoration_style(child);
+
+	return css__copy_text_decoration_style(
+			type == CSS_TEXT_DECORATION_STYLE_INHERIT ? parent : child,
+			result);
+}
