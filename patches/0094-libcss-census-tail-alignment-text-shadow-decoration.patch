+			break;
+		case TEXT_DECORATION_STYLE_DOTTED:
+			value = CSS_TEXT_DECORATION_STYLE_DOTTED;
+			break;
+		case TEXT_DECORATION_STYLE_DASHED:
+			value = CSS_TEXT_DECORATION_STYLE_DASHED;
+			break;
+		case TEXT_DECORATION_STYLE_WAVY:
+			value = CSS_TEXT_DECORATION_STYLE_WAVY;
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_text_decoration_style(state->computed, value);
+	}
+
+	return CSS_OK;
+}
