+		{ SELF_END, JUSTIFY_SELF_FLEX_END },
+		{ NORMAL, JUSTIFY_SELF_STRETCH },
+	};
+
+	return css__parse_with_keyword_aliases(c, vector, ctx, result,
+			CSS_PROP_JUSTIFY_SELF, table, 7,
+			css__parse_justify_self);
+}
+
+/**
+ * A place-* shorthand: the first value for the block axis and, if a
+ * second is given, that for the inline axis; otherwise the one value
+ * for both. Each half is read with its own longhand parser, the
+ * second over the same tokens when it has none of its own.
+ */
+static css_error parse_place(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result,
+		css_error (*block)(css_language *c,
+				const parserutils_vector *vector, int32_t *ctx,
+				css_style *result),
+		css_error (*inline_)(css_language *c,
+				const parserutils_vector *vector, int32_t *ctx,
+				css_style *result))
+{
+	int32_t orig_ctx = *ctx;
+	int32_t second;
+	const css_token *token;
+	css_style *bstyle, *istyle;
+	css_error error;
+
+	error = css__stylesheet_style_create(c->sheet, &bstyle);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_create(c->sheet, &istyle);
+	if (error != CSS_OK) {
+		css__stylesheet_style_destroy(bstyle);
+		return error;
+	}
+
+	error = block(c, vector, ctx, bstyle);
+	if (error != CSS_OK)
+		goto cleanup;
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL || token->type == CSS_TOKEN_EOF ||
+			tokenIsChar(token, '!') || tokenIsChar(token, ';')) {
+		/* one value: the inline axis reads the same tokens */
+		second = orig_ctx;
+		error = inline_(c, vector, &second, istyle);
+	} else {
+		error = inline_(c, vector, ctx, istyle);
+	}
+	if (error != CSS_OK)
+		goto cleanup;
+
+	error = css__stylesheet_merge_style(result, bstyle);
+	if (error == CSS_OK)
+		error = css__stylesheet_merge_style(result, istyle);
+
+cleanup:
+	css__stylesheet_style_destroy(bstyle);
+	css__stylesheet_style_destroy(istyle);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+css_error css__parse_place_items(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_place(c, vector, ctx, result,
+			css__parse_align_items_ext, css__parse_justify_items_ext);
+}
+
+css_error css__parse_place_content(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_place(c, vector, ctx, result,
+			css__parse_align_content_ext,
+			css__parse_justify_content_ext);
+}
+
+css_error css__parse_place_self(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_place(c, vector, ctx, result,
+			css__parse_align_self_ext, css__parse_justify_self_ext);
+}
+
+/**
+ * all: inherit | initial | unset | revert -- every property but
+ * direction and unicode-bidi takes the value.
+ */
+css_error css__parse_all(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_error error;
+	uint16_t prop;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value == FLAG_VALUE__NONE)
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+
+	for (prop = 0; prop < CSS_N_PROPERTIES; prop++) {
+		if (prop == CSS_PROP_DIRECTION ||
+				prop == CSS_PROP_UNICODE_BIDI)
+			continue;
+		error = css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * stroke-width: <length> | <percentage> | <number>, a bare number being
+ * user units, which are pixels here.
+ */
+css_error css__parse_stroke_width(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_STROKE_WIDTH);
+	}
+
+	if (token->type == CSS_TOKEN_NUMBER) {
+		size_t consumed = 0;
+
+		parserutils_vector_iterate(vector, ctx);
+		length = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+		if (consumed != lwc_string_length(token->idata)) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+	} else {
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				&length, &unit);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		if ((unit & (UNIT_LENGTH | UNIT_PCT)) == 0 && length != 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+	}
+	if (length < 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_STROKE_WIDTH,
+			0, STROKE_WIDTH_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	error = css__stylesheet_style_vappend(result, 2, length, unit);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/**
+ * Parse one text shadow: <length>{2,3} && <color>?, leaving ctx after it.
+ */
+static css_error parse_text_shadow(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_fixed length[3], uint32_t unit[3],
+		bool *has_colour, uint32_t *colour)
+{
+	const css_token *token;
+	int lengths = 0;
+
+	*has_colour = false;
+
+	while (1) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || token->type == CSS_TOKEN_EOF ||
+				tokenIsChar(token, ',') ||
+				tokenIsChar(token, '!') ||
+				tokenIsChar(token, ';')) {
+			break;
+		}
+
+		if (token->type == CSS_TOKEN_DIMENSION ||
+				token->type == CSS_TOKEN_NUMBER) {
+			css_error error;
+
+			if (lengths == 3)
+				return CSS_INVALID;
+			error = css__parse_unit_specifier(c, vector, ctx,
+					UNIT_PX, &length[lengths],
+					&unit[lengths]);
+			if (error != CSS_OK)
+				return error;
+			if ((unit[lengths] & UNIT_LENGTH) == 0 &&
+					length[lengths] != 0)
+				return CSS_INVALID;
+			lengths++;
+			continue;
+		}
+
+		if (*has_colour == false) {
+			uint16_t value = 0;
+			int32_t before = *ctx;
+
+			if (css__parse_colour_specifier(c, vector, ctx,
+					&value, colour) == CSS_OK) {
+				if (value == COLOR_TRANSPARENT)
+					*colour = 0;
+				*has_colour = true;
+				continue;
+			}
+			*ctx = before;
+		}
+
+		return CSS_INVALID;
+	}
+
+	if (lengths < 2)
+		return CSS_INVALID;
+	if (lengths == 2) {
+		length[2] = 0;
+		unit[2] = UNIT_PX;
+	}
+	return CSS_OK;
+}
+
+/**
+ * text-shadow: none | <shadow>#, of which the first is kept.
+ */
+css_error css__parse_text_shadow(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_fixed length[3] = { 0, 0, 0 };
+	uint32_t unit[3] = { UNIT_PX, UNIT_PX, UNIT_PX };
+	uint32_t colour = 0;
+	bool has_colour;
+	css_error error;
+	bool match;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_TEXT_SHADOW);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+	    lwc_string_caseless_isequal(token->idata, c->strings[NONE],
+			&match) == lwc_error_ok && match) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TEXT_SHADOW, 0, TEXT_SHADOW_NONE);
+	}
+
+	error = parse_text_shadow(c, vector, ctx, length, unit,
+			&has_colour, &colour);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	/* no colour means currentColor, carried as the same sentinel
+	 * box-shadow uses */
+	if (has_colour == false)
+		colour = 0x00000001;
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	while (token != NULL && tokenIsChar(token, ',')) {
+		css_fixed more[3];
+		uint32_t moreu[3], morec;
+		bool morehc;
+
+		parserutils_vector_iterate(vector, ctx);
+		error = parse_text_shadow(c, vector, ctx, more, moreu,
+				&morehc, &morec);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_TEXT_SHADOW,
+			0, TEXT_SHADOW_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	error = css__stylesheet_style_vappend(result, 7,
+			length[0], unit[0], length[1], unit[1],
+			length[2], unit[2], colour);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/**
+ * text-decoration: <line>+ || <style> || <color> || <thickness>, the
+ * whole shorthand, setting every longhand. A line keyword list alone
+ * is what the old parser read; the rest used to drop the declaration.
+ */
+css_error css__parse_text_decoration_full(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	uint16_t line = 0, style = TEXT_DECORATION_STYLE_SOLID;
+	bool has_line = false, has_style = false, has_colour = false;
+	bool has_thickness = false, none = false;
+	uint32_t colour = 0;
+	css_fixed thickness = 0;
+	uint32_t tunit = UNIT_PX;
+	css_error error;
+	bool match;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		error = css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_TEXT_DECORATION);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result,
+					flag_value,
+					CSS_PROP_TEXT_DECORATION_STYLE);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result,
+					flag_value,
+					CSS_PROP_TEXT_DECORATION_COLOR);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result,
+					flag_value,
+					CSS_PROP_TEXT_DECORATION_THICKNESS);
+		return error;
+	}
+
+#define IS(str) (token->type == CSS_TOKEN_IDENT && \
+		lwc_string_caseless_isequal(token->idata, c->strings[str], \
+			&match) == lwc_error_ok && match)
+
+	while (1) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || token->type == CSS_TOKEN_EOF ||
+				tokenIsChar(token, '!') ||
+				tokenIsChar(token, ';'))
+			break;
+
+		if (IS(NONE) && !has_line) {
+			none = true;
+			has_line = true;
+		} else if (IS(UNDERLINE) && !none) {
+			line |= TEXT_DECORATION_UNDERLINE;
+			has_line = true;
+		} else if (IS(OVERLINE) && !none) {
+			line |= TEXT_DECORATION_OVERLINE;
+			has_line = true;
+		} else if (IS(LINE_THROUGH) && !none) {
+			line |= TEXT_DECORATION_LINE_THROUGH;
+			has_line = true;
+		} else if (IS(BLINK) && !none) {
+			line |= TEXT_DECORATION_BLINK;
+			has_line = true;
+		} else if (IS(SOLID) && !has_style) {
+			style = TEXT_DECORATION_STYLE_SOLID;
+			has_style = true;
+		} else if (IS(LIBCSS_DOUBLE) && !has_style) {
+			style = TEXT_DECORATION_STYLE_DOUBLE;
+			has_style = true;
+		} else if (IS(DOTTED) && !has_style) {
+			style = TEXT_DECORATION_STYLE_DOTTED;
+			has_style = true;
+		} else if (IS(DASHED) && !has_style) {
+			style = TEXT_DECORATION_STYLE_DASHED;
+			has_style = true;
+		} else if (IS(WAVY) && !has_style) {
+			style = TEXT_DECORATION_STYLE_WAVY;
+			has_style = true;
+		} else if ((IS(AUTO) || IS(FROM_FONT)) && !has_thickness) {
+			has_thickness = true;
+			thickness = 0;
+			tunit = 0;	/* auto */
+		} else if ((token->type == CSS_TOKEN_DIMENSION ||
+				token->type == CSS_TOKEN_PERCENTAGE) &&
+				!has_thickness) {
+			/* a bare number is not a thickness here: the
+			 * upstream suite has "blink 0 underline" invalid */
+			error = css__parse_unit_specifier(c, vector, ctx,
+					UNIT_PX, &thickness, &tunit);
+			if (error != CSS_OK)
+				goto invalid;
+			if ((tunit & (UNIT_LENGTH | UNIT_PCT)) == 0 &&
+					thickness != 0)
+				goto invalid;
+			has_thickness = true;
+			continue;
+		} else if (!has_colour) {
+			uint16_t value = 0;
+			int32_t before = *ctx;
+
+			if (css__parse_colour_specifier(c, vector, ctx,
+					&value, &colour) != CSS_OK) {
+				*ctx = before;
+				goto invalid;
+			}
+			if (value == COLOR_TRANSPARENT)
+				colour = 0;
+			else if (value == COLOR_CURRENT_COLOR) {
+				/* currentColor: the initial value */
+				continue;
+			}
+			has_colour = true;
+			continue;
+		} else {
+			goto invalid;
+		}
+		parserutils_vector_iterate(vector, ctx);
+	}
+#undef IS
+
+	if (!has_line && !has_style && !has_colour && !has_thickness)
+		goto invalid;
+
+	/* A longhand the value does not mention is left alone rather
+	 * than reset: the line keywords on their own then compile to
+	 * exactly what they always did. */
+	if (has_line || !(has_style || has_colour || has_thickness)) {
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TEXT_DECORATION, 0,
+				none ? TEXT_DECORATION_NONE : line);
+		if (error != CSS_OK)
+			goto invalid;
+	}
+	if (has_style) {
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TEXT_DECORATION_STYLE, 0, style);
+		if (error != CSS_OK)
+			goto invalid;
+	}
+	if (has_colour) {
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TEXT_DECORATION_COLOR, 0,
+				TEXT_DECORATION_COLOR_SET);
+		if (error == CSS_OK)
+			error = css__stylesheet_style_append(result, colour);
+		if (error != CSS_OK)
+			goto invalid;
+	}
+	if (has_thickness) {
+		if (tunit != 0) {
+			error = css__stylesheet_style_appendOPV(result,
+					CSS_PROP_TEXT_DECORATION_THICKNESS, 0,
+					TEXT_DECORATION_THICKNESS_SET);
+			if (error == CSS_OK)
+				error = css__stylesheet_style_vappend(result, 2,
+						thickness, tunit);
+		} else {
+			error = css__stylesheet_style_appendOPV(result,
+					CSS_PROP_TEXT_DECORATION_THICKNESS, 0,
+					TEXT_DECORATION_THICKNESS_AUTO);
+		}
+		if (error != CSS_OK)
+			goto invalid;
+	}
+
+	return CSS_OK;
+
+invalid:
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
