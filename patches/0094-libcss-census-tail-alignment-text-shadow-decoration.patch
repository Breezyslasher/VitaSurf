+
+	return css__parse_with_keyword_aliases(c, vector, ctx, result,
+			CSS_PROP_JUSTIFY_CONTENT, table, 6,
+			css__parse_justify_content);
+}
+
+css_error css__parse_justify_items_ext(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const struct css_keyword_alias table[] = {
+		{ START, JUSTIFY_ITEMS_FLEX_START },
+		{ END, JUSTIFY_ITEMS_FLEX_END },
+		{ LEFT, JUSTIFY_ITEMS_FLEX_START },
+		{ RIGHT, JUSTIFY_ITEMS_FLEX_END },
+		{ SELF_START, JUSTIFY_ITEMS_FLEX_START },
+		{ SELF_END, JUSTIFY_ITEMS_FLEX_END },
+		{ NORMAL, JUSTIFY_ITEMS_STRETCH },
+		{ LEGACY, JUSTIFY_ITEMS_STRETCH },
+	};
+
+	return css__parse_with_keyword_aliases(c, vector, ctx, result,
