diff --git a/content/handlers/html/html.c b/content/handlers/html/html.c
index e1033a248..a04528b06 100644
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -777,12 +777,35 @@ html_process_data(struct content *c, const char *data, unsigned int size)
 	nserror err = NSERROR_OK; /* assume its all going to be ok */
 	uint64_t t0 = 0, t1 = 0;
 
+	/*
+	 * Parsing runs the scripts it meets (VitaSurf).
+	 *
+	 * dom_hubbub_parser_parse_chunk executes a <script> element
+	 * synchronously as it reaches it, and the first one builds the
+	 * JavaScript thread and runs our prelude. So this bucket used to
+	 * hold every script on the page as well as the parse: a build
+	 * 369 log reads 482 ms to parse a four kilobyte local file whose
+	 * prelude took 463 ms of it, and 1058 ms for a YouTube page
+	 * whose scripts are counted again under script. Take off
+	 * whatever the script and prelude buckets gained while we were
+	 * inside, and what is left is the parser's own time.
+	 */
+	unsigned int s0 = vitasurf_ms_script + vitasurf_ms_prelude;
+	unsigned int spent;
+
 	nsu_getmonotonic_ms(&t0);
 	dom_ret = dom_hubbub_parser_parse_chunk(html->parser,
 					      (const uint8_t *) data,
 					      size);
 	nsu_getmonotonic_ms(&t1);
-	vitasurf_ms_html_parse += (unsigned int)(t1 - t0);
+	spent = (unsigned int)(t1 - t0);
+	{
+		unsigned int in_script =
+			vitasurf_ms_script + vitasurf_ms_prelude - s0;
+
+		vitasurf_ms_html_parse += spent > in_script ?
+				spent - in_script : 0;
+	}
 
 	html->bytes_parsed += size;
 
