diff --git a/utils/utils.h b/utils/utils.h
index 57de52a5b..667ed7ac6 100644
--- a/utils/utils.h
+++ b/utils/utils.h
@@ -201,6 +201,21 @@ extern unsigned int vitasurf_ms_teardown;
  * happens once per page before any of the page's own script.
  */
 extern unsigned int vitasurf_ms_prelude;
+
+/*
+ * Where the script time goes (VitaSurf). A build 369 log puts 4618 ms
+ * of a 7878 ms page in the script bucket, and the load event accounts
+ * for 1906 ms of that in twenty-four script elements. The rest is
+ * JavaScript entered some other way, and until it is split by the way
+ * it was entered there is nothing to aim at.
+ */
+extern unsigned int vitasurf_ms_js_page;	/**< a <script> element */
+extern unsigned int vitasurf_ms_js_timer;
+extern unsigned int vitasurf_ms_js_event;
+extern unsigned int vitasurf_ms_js_xhr;		/**< a fetch or XHR settling */
+extern unsigned int vitasurf_js_timers;
+extern unsigned int vitasurf_js_events;
+extern unsigned int vitasurf_js_xhrs;
 /**
  * Milliseconds the conversion now returning spent, handed up so the
  * conversion that contains it can subtract its own nested work.
