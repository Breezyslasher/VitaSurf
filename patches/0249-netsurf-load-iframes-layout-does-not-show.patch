+/**
+ * Load the iframes layout gave no box, as a browser does: one that is
+ * display: none still runs its page, and pages hide the frames they
+ * talk to by postMessage, or post a form into, that way (VitaSurf).
+ */
+static void start_hidden_iframes(struct browser_window *bw)
+{
+	struct hidden_walk walk;
+
+	if (bw->current_content == NULL ||
+	    content_get_type(bw->current_content) != CONTENT_HTML ||
+	    hlcache_handle_get_content(bw->current_content) == NULL) {
+		return;
+	}
+	walk.bw = bw;
+	walk.root = bw;
+	while (walk.root->parent != NULL) {
+		walk.root = walk.root->parent;
+	}
+	walk.started = 0;
+	html_frame_doc_each_iframe((struct html_content *)
+			hlcache_handle_get_content(bw->current_content),
+			start_hidden_iframe, &walk);
+	if (walk.started > 0) {
+		NSLOG(netsurf, INFO, "started %d iframes layout does not show",
+		      walk.started);
+	}
+}
