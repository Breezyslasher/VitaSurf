+struct hidden_walk {
+	struct browser_window *bw;
+	struct browser_window *root;
+	int started;
+};
+
+static bool start_hidden_iframe(struct dom_node *node, bool *stop, void *pw)
+{
+	struct hidden_walk *walk = pw;
+	struct browser_window *window;
+	int i;
+
+	for (i = 0; i < walk->bw->iframe_count; i++) {
+		if (walk->bw->iframes[i] != NULL &&
+		    walk->bw->iframes[i]->frame_node == node) {
+			return true;
+		}
+	}
+	/* gone from the page: forget it until it is put back */
+	if (frame_node_page(walk->bw, node) == NULL) {
+		return false;
+	}
+	if (browser_window_frame_count(walk->root) >=
+	    BROWSER_WINDOW_FRAME_CAP) {
+		NSLOG(netsurf, INFO, "%d frames already: a hidden iframe "
+		      "waits", BROWSER_WINDOW_FRAME_CAP);
+		*stop = true;
+		return true;
+	}
+	if (iframe_start(walk->bw, node, false, &window) == NSERROR_OK &&
+	    window != NULL) {
+		walk->started++;
+	}
+	return true;
+}
