+/* exported interface documented in html/frame_doc.h */
+void html_frame_doc_note_iframe(html_content *c, dom_node *node)
+{
+	struct frame_el *e;
+
+	for (e = frame_els; e != NULL; e = e->next) {
+		if (e->owner == c && e->node == node) {
+			return;
+		}
+	}
+	e = malloc(sizeof(*e));
+	if (e == NULL) {
+		return;
+	}
+	e->owner = c;
+	e->node = dom_node_ref(node);
+	e->next = frame_els;
+	frame_els = e;
+}
+
+/* exported interface documented in html/frame_doc.h */
+void html_frame_doc_each_iframe(html_content *c,
+		bool (*visit)(dom_node *node, bool *stop, void *pw), void *pw)
+{
+	struct frame_el **p = &frame_els, *e;
+	bool stop = false;
+
+	while (!stop && (e = *p) != NULL) {
+		if (e->owner != c) {
+			p = &e->next;
+			continue;
+		}
+		if (visit(e->node, &stop, pw)) {
+			p = &e->next;
+		} else {
+			*p = e->next;
+			dom_node_unref(e->node);
+			free(e);
+		}
+	}
+}
