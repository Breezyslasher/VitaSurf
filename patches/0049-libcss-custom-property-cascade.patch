diff --git a/src/select/custom.c b/src/select/custom.c
new file mode 100644
index 0000000..438d92d
--- /dev/null
+++ b/src/select/custom.c
@@ -0,0 +1,178 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "select/custom.h"
+
+/* Rounded corners of the cascade: see custom.h (VitaSurf). */
+
+/*
+ * A page can declare a great many variables -- github.com's palette is
+ * 959 colours -- but one element rarely sees more than a few dozen once
+ * they are gathered per element rather than per document. A list is
+ * kept, and capped, because a stylesheet is not allowed to make the
+ * browser spend without limit.
+ */
+#define CUSTOM_MAP_MAX 512
+
+css_custom_map *css__custom_map_ref(css_custom_map *map)
+{
+	if (map != NULL) {
+		map->refcount++;
+	}
+	return map;
+}
+
+static void entry_free(css_custom_entry *e)
+{
+	lwc_string_unref(e->name);
+	free(e);
+}
+
+void css__custom_map_unref(css_custom_map *map)
+{
+	css_custom_entry *e;
+
+	if (map == NULL || --map->refcount > 0) {
+		return;
+	}
+
+	e = map->entries;
+	while (e != NULL) {
+		css_custom_entry *next = e->next;
+		entry_free(e);
+		e = next;
+	}
+	free(map);
+}
+
+const css_custom_entry *css__custom_map_get(const css_custom_map *map,
+		lwc_string *name)
+{
+	const css_custom_entry *e;
+	bool match;
+
+	if (map == NULL || name == NULL) {
+		return NULL;
+	}
+
+	for (e = map->entries; e != NULL; e = e->next) {
+		if (lwc_string_isequal(e->name, name, &match) ==
+				lwc_error_ok && match) {
+			return e;
+		}
+	}
+
+	return NULL;
+}
+
+css_error css__custom_map_own(css_custom_map **map)
+{
+	css_custom_map *copy;
+	const css_custom_entry *e;
+	css_custom_entry **tail;
+
+	if (map == NULL) {
+		return CSS_BADPARM;
+	}
+	if (*map != NULL && (*map)->refcount == 1) {
+		return CSS_OK;	/* already ours alone */
+	}
+
+	copy = calloc(1, sizeof(*copy));
+	if (copy == NULL) {
+		return CSS_NOMEM;
+	}
+	copy->refcount = 1;
+	tail = &copy->entries;
+
+	for (e = (*map != NULL) ? (*map)->entries : NULL; e != NULL;
+			e = e->next) {
+		css_custom_entry *n = malloc(sizeof(*n));
+
+		if (n == NULL) {
+			css__custom_map_unref(copy);
+			return CSS_NOMEM;
+		}
+		*n = *e;
+		n->name = lwc_string_ref(e->name);
+		n->next = NULL;
+		*tail = n;
+		tail = &n->next;
+		copy->count++;
+	}
+
+	css__custom_map_unref(*map);
+	*map = copy;
+
+	return CSS_OK;
+}
+
+css_error css__custom_map_set(css_custom_map **map, lwc_string *name,
+		css_token *tokens, uint32_t n_tokens,
+		uint32_t specificity, bool important)
+{
+	css_custom_entry *e;
+	css_error error;
+	bool match;
+
+	if (map == NULL || name == NULL) {
+		return CSS_BADPARM;
+	}
+
+	/*
+	 * Rules arrive in increasing specificity, so a later declaration
+	 * of the same name normally wins. An important one is only given
+	 * up to another important one.
+	 */
+	e = (*map != NULL) ? (*map)->entries : NULL;
+	for (; e != NULL; e = e->next) {
+		if (lwc_string_isequal(e->name, name, &match) ==
+				lwc_error_ok && match) {
+			if (e->important && !important) {
+				return CSS_OK;
+			}
+			break;
+		}
+	}
+
+	error = css__custom_map_own(map);
+	if (error != CSS_OK) {
+		return error;
+	}
+
+	/* the copy has its own entries, so find it again */
+	for (e = (*map)->entries; e != NULL; e = e->next) {
+		if (lwc_string_isequal(e->name, name, &match) ==
+				lwc_error_ok && match) {
+			break;
+		}
+	}
+
+	if (e == NULL) {
+		if ((*map)->count >= CUSTOM_MAP_MAX) {
+			return CSS_OK;	/* silently dropped, see the cap */
+		}
+		e = malloc(sizeof(*e));
+		if (e == NULL) {
+			return CSS_NOMEM;
+		}
+		e->name = lwc_string_ref(name);
+		e->next = (*map)->entries;
+		(*map)->entries = e;
+		(*map)->count++;
+	}
+
+	e->tokens = tokens;
+	e->n_tokens = n_tokens;
+	e->specificity = specificity;
+	e->important = important;
+
+	return CSS_OK;
+}
