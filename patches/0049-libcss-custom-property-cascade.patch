+ * known, so both are kept as tokens on the rule and resolved while the
+ * cascade runs. The value is stored without its trailing !important,
+ * which is recorded separately.
+ */
+static css_error deferDeclaration(css_rule *rule, lwc_string *property,
+		lwc_string *custom, const parserutils_vector *vector,
+		int32_t ctx)
+{
