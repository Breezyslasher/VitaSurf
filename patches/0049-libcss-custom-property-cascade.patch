+	if (c == NULL || decl == NULL || decl->property == NULL ||
+			out == NULL) {
+		return CSS_BADPARM;
+	}
+
+	for (i = FIRST_PROP; i <= LAST_PROP; i++) {
+		bool match = false;
+
+		if (lwc_string_caseless_isequal(decl->property, c->strings[i],
+				&match) == lwc_error_ok && match) {
+			break;
+		}
+	}
+	if (i == LAST_PROP + 1) {
+		return CSS_INVALID;
+	}
+	handler = property_handlers[i - FIRST_PROP];
+
+	if (parserutils_vector_create(sizeof(css_token), 32, &subst) !=
+			PARSERUTILS_OK) {
+		return CSS_NOMEM;
+	}
+	error = appendSubstituted(c, decl->tokens, decl->n_tokens, subst, 0,
+			map);
+	if (error != CSS_OK) {
+		parserutils_vector_destroy(subst);
+		return error;
+	}
+
+	{
+		int32_t k = 0; const css_token *tk;
+		while ((tk = parserutils_vector_peek(subst, k)) != NULL) {
+			fprintf(stderr, " [%d:%s]", (int) tk->type,
+				tk->idata ? lwc_string_data(tk->idata) : "");
+			k++;
+		}
+		fprintf(stderr, "\n");
+	}
+
+	error = css__stylesheet_style_create(c->sheet, &style);
+	if (error != CSS_OK) {
+		parserutils_vector_destroy(subst);
+		return error;
+	}
+
+	error = handler(c, subst, &sctx, style);
+	if (error == CSS_OK) {
