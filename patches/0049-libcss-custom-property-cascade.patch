+	int32_t end = ctx, i;
+	bool important = false;
+	uint32_t n;
+
+	if (rule == NULL || rule->type != CSS_RULE_SELECTOR) {
+		return CSS_OK;
+	}
+
+	while (parserutils_vector_peek(vector, end) != NULL) {
+		end++;
+	}
+	while (end > ctx && ((token = parserutils_vector_peek(vector,
+			end - 1)) == NULL || token->type == CSS_TOKEN_S)) {
+		end--;
+	}
+
+	/* a trailing "!important", however it was spaced */
+	if (end - ctx >= 2) {
+		int32_t j = end - 1;
+		const css_token *word = parserutils_vector_peek(vector, j);
+
+		if (word != NULL && word->type == CSS_TOKEN_IDENT &&
+		    word->idata != NULL &&
+		    lwc_string_length(word->idata) == 9 &&
+		    strncasecmp((const char *) lwc_string_data(word->idata),
+				"important", 9) == 0) {
+			j--;
+			while (j > ctx && (token = parserutils_vector_peek(
+					vector, j)) != NULL &&
+					token->type == CSS_TOKEN_S) {
+				j--;
+			}
+			token = parserutils_vector_peek(vector, j);
+			if (token != NULL && tokenIsChar(token, '!')) {
+				important = true;
+				end = j;
+				while (end > ctx && (token =
+					parserutils_vector_peek(vector,
+						end - 1)) != NULL &&
+						token->type == CSS_TOKEN_S) {
+					end--;
+				}
+			}
+		}
+	}
+
+	n = (uint32_t) (end - ctx);
+	if (n == 0) {
+		return CSS_OK;
+	}
+
+	grown = realloc(rs->deferred,
+			(rs->n_deferred + 1) * sizeof(*rs->deferred));
+	if (grown == NULL) {
+		return CSS_NOMEM;
+	}
+	rs->deferred = grown;
+
+	d = &rs->deferred[rs->n_deferred];
+	d->property = (property != NULL) ? lwc_string_ref(property) : NULL;
+	d->custom = (custom != NULL) ? lwc_string_ref(custom) : NULL;
+	d->important = important;
+	d->n_tokens = n;
+	d->tokens = malloc(n * sizeof(css_token));
+	if (d->tokens == NULL) {
+		if (d->property != NULL)
+			lwc_string_unref(d->property);
+		if (d->custom != NULL)
+			lwc_string_unref(d->custom);
+		return CSS_NOMEM;
+	}
+	for (i = 0; i < (int32_t) n; i++) {
+		copyToken(&d->tokens[i], parserutils_vector_peek(vector,
+				ctx + i));
+	}
+
+	rs->n_deferred++;
+
+
+	return CSS_OK;
+}
