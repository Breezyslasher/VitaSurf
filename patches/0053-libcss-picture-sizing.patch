diff --git a/src/parse/properties/picture_size.c b/src/parse/properties/picture_size.c
new file mode 100644
index 0000000..fd19530
--- /dev/null
+++ b/src/parse/properties/picture_size.c
@@ -0,0 +1,218 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * How a picture is sized (VitaSurf).
+ *
+ * background-size and object-fit say how a picture is fitted into the
+ * box it is drawn in, and aspect-ratio says what shape a box should be
+ * when only one of its sides is given. Without them a background image
+ * is drawn at its own size however large the box, and a photograph in a
+ * card is stretched to whatever shape the card happens to be.
+ */
+
+/**
+ * Parse background-size: [ auto | <length-percentage> ]{1,2} |
+ *                        cover | contain
+ */
+css_error css__parse_background_size(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_fixed length[2] = { 0, 0 };
+	uint32_t unit[2] = { 0, 0 };
+	enum flag_value flag_value;
+	css_error error;
+	bool match;
+	int n = 0;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_BACKGROUND_SIZE);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT) {
+		if (lwc_string_caseless_isequal(token->idata, c->strings[COVER],
+				&match) == lwc_error_ok && match) {
+			parserutils_vector_iterate(vector, ctx);
+			return css__stylesheet_style_appendOPV(result,
+					CSS_PROP_BACKGROUND_SIZE, 0,
+					BACKGROUND_SIZE_COVER);
+		}
+		if (lwc_string_caseless_isequal(token->idata,
+				c->strings[CONTAIN], &match) == lwc_error_ok &&
+				match) {
+			parserutils_vector_iterate(vector, ctx);
+			return css__stylesheet_style_appendOPV(result,
+					CSS_PROP_BACKGROUND_SIZE, 0,
+					BACKGROUND_SIZE_CONTAIN);
+		}
+	}
+
+	/*
+	 * One or two sizes, each a length, a percentage or auto. auto is
+	 * carried as a zero length in pixels, which is what the drawing
+	 * side reads as "this axis follows the picture".
+	 */
+	while (n < 2) {
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!')) {
+			break;
+		}
+
+		if (token->type == CSS_TOKEN_IDENT &&
+		    lwc_string_caseless_isequal(token->idata, c->strings[AUTO],
+				&match) == lwc_error_ok && match) {
+			parserutils_vector_iterate(vector, ctx);
+			length[n] = 0;
+			unit[n] = UNIT_PX;
+		} else {
+			int32_t before = *ctx;
+
+			error = css__parse_unit_specifier(c, vector, ctx,
+					UNIT_PX, &length[n], &unit[n]);
+			if (error != CSS_OK) {
+				*ctx = before;
+				break;
+			}
+			if ((unit[n] & UNIT_ANGLE) || (unit[n] & UNIT_TIME) ||
+					(unit[n] & UNIT_FREQ) ||
+					length[n] < 0) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+		}
+		n++;
+		consumeWhitespace(vector, ctx);
+	}
+
+	if (n == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	if (n == 1) {
+		length[1] = 0;		/* the other axis follows */
+		unit[1] = UNIT_PX;
+	}
+
+	error = css__stylesheet_style_appendOPV(result,
+			CSS_PROP_BACKGROUND_SIZE, 0, BACKGROUND_SIZE_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = css__stylesheet_style_vappend(result, 4,
+			length[0], unit[0], length[1], unit[1]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
+
+/**
+ * Parse aspect-ratio: auto | <number> [ / <number> ]?
+ */
+css_error css__parse_aspect_ratio(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_fixed width = 0, height = 0;
+	size_t consumed = 0;
+	css_error error;
+	bool match;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_ASPECT_RATIO);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+	    lwc_string_caseless_isequal(token->idata, c->strings[AUTO],
+			&match) == lwc_error_ok && match) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_ASPECT_RATIO, 0, ASPECT_RATIO_AUTO);
+	}
+
+	if (token->type != CSS_TOKEN_NUMBER) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	width = css__number_from_lwc_string(token->idata, false, &consumed);
+	if (consumed != lwc_string_length(token->idata) || width <= 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	parserutils_vector_iterate(vector, ctx);
+	consumeWhitespace(vector, ctx);
+
+	height = INTTOFIX(1);
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && tokenIsChar(token, '/')) {
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL || token->type != CSS_TOKEN_NUMBER) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		height = css__number_from_lwc_string(token->idata, false,
+				&consumed);
+		if (consumed != lwc_string_length(token->idata) ||
+				height <= 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		consumeWhitespace(vector, ctx);
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_ASPECT_RATIO,
+			0, ASPECT_RATIO_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = css__stylesheet_style_vappend(result, 2, width, height);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
