+/*
+ * A declaration whose var() cannot be resolved, or whose value does not
+ * parse once it is, is invalid at computed-value time: CSS Variables has
+ * it compute as unset, at its own place in the cascade, not drop out so
+ * that a weaker declaration wins. Home Assistant's icon buttons are
+ * padded with var(--ha-icon-button-padding-inline, --ha-space-2), whose
+ * fallback is not a length, and come out unpadded and square in a
+ * browser; dropping it let the padding compiled against the document
+ * root's variables stand (VitaSurf).
+ */
+static css_error compileUnset(css_language *c, css_deferred_decl *decl,
+		css_prop_handler handler, css_style **out)
+{
+	parserutils_vector *v = NULL;
+	css_style *style = NULL;
+	css_token unset;
+	css_error error;
+	int32_t ctx = 0;
+
+	if (decl->unset != NULL) {
+		*out = decl->unset;
+		return CSS_OK;
+	}
+	if (parserutils_vector_create(sizeof(css_token), 1, &v) !=
+			PARSERUTILS_OK)
+		return CSS_NOMEM;
+	memset(&unset, 0, sizeof(unset));
+	unset.type = CSS_TOKEN_IDENT;
+	unset.idata = c->strings[UNSET];
+	if (parserutils_vector_append(v, &unset) != PARSERUTILS_OK) {
+		parserutils_vector_destroy(v);
+		return CSS_NOMEM;
+	}
+	error = css__stylesheet_style_create(c->sheet, &style);
+	if (error == CSS_OK) {
+		/* a property that takes no unset is left out, as before */
+		error = handler(c, v, &ctx, style);
+		if (error != CSS_OK)
+			css__stylesheet_style_destroy(style);
+	}
+	parserutils_vector_destroy(v);
+	if (error != CSS_OK)
+		return error;
+	if (decl->important)
+		css__make_style_important(style);
+	decl->unset = style;
+	*out = style;
+	return CSS_OK;
+}
