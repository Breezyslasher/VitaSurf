+/*
+ * The specificity of the most specific argument of the :is() whose
+ * arguments start at ctx, read off the tokens (VitaSurf). Each argument
+ * is parsed into a selector of its own, which on its own would count
+ * only for itself; Selectors 4 gives :is() and :not() the most specific
+ * of their arguments, in every one of them. Nested :is(), :not() and
+ * :has() count for their own most specific argument, :where() for
+ * nothing, and any other functional pseudo-class as one.
+ */
+static uint32_t groupMostSpecific(const parserutils_vector *vector,
+		int32_t ctx, int32_t *end)
+{
+	const css_token *t;
+	uint32_t most = 0, cur = 0;
+
+	while ((t = parserutils_vector_peek(vector, ctx)) != NULL) {
+		if (tokenIsChar(t, ')')) {
+			ctx++;
+			break;
+		}
+		if (tokenIsChar(t, ',')) {
+			if (cur > most)
+				most = cur;
+			cur = 0;
+			ctx++;
+			continue;
+		}
+		if (t->type == CSS_TOKEN_HASH) {
+			cur += CSS_SPECIFICITY_A;
+			ctx++;
+		} else if (tokenIsChar(t, '.')) {
+			cur += CSS_SPECIFICITY_B;
+			ctx += 2;
+		} else if (tokenIsChar(t, '[')) {
+			cur += CSS_SPECIFICITY_B;
+			for (ctx++; (t = parserutils_vector_peek(vector,
+					ctx)) != NULL; ctx++) {
+				if (tokenIsChar(t, ']')) {
+					ctx++;
+					break;
+				}
+			}
+		} else if (tokenIsChar(t, ':')) {
+			t = parserutils_vector_peek(vector, ctx + 1);
+			if (t != NULL && tokenIsChar(t, ':')) {
+				cur += CSS_SPECIFICITY_C;
+				ctx += 2;
+				t = parserutils_vector_peek(vector, ctx);
+				if (t != NULL && t->type == CSS_TOKEN_FUNCTION) {
+					ctx++;
+					skipToCloseParen(vector, &ctx);
+					ctx++;
+				} else {
+					ctx++;
+				}
+			} else if (t != NULL && t->type == CSS_TOKEN_FUNCTION) {
+				int32_t after = ctx + 2;
+
+				if (nameIs(t->idata, "where")) {
+					skipToCloseParen(vector, &after);
+					after++;
+				} else if (nameIs(t->idata, "is") ||
+						nameIs(t->idata, "not") ||
+						nameIs(t->idata, "has") ||
+						nameIs(t->idata, "matches") ||
+						nameIs(t->idata, "-vita-not")) {
+					cur += groupMostSpecific(vector, after,
+							&after);
+				} else {
+					cur += CSS_SPECIFICITY_B;
+					skipToCloseParen(vector, &after);
+					after++;
+				}
+				ctx = after;
+			} else {
+				cur += CSS_SPECIFICITY_B;
+				ctx += 2;
+			}
+		} else if (t->type == CSS_TOKEN_IDENT) {
+			cur += CSS_SPECIFICITY_C;
+			ctx++;
+		} else if (t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '(')) {
+			ctx++;
+			skipToCloseParen(vector, &ctx);
+			ctx++;
+		} else {
+			ctx++;
+		}
+	}
+	if (cur > most)
+		most = cur;
+	if (end != NULL)
+		*end = ctx;
+	return most;
+}
