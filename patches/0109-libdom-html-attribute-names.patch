 	return true;
 }
 
+/**
+ * Test whether the name is a valid attribute name for an HTML document.
+ *
+ * The DOM Standard no longer holds attribute names to the XML Name
+ * production: a name is valid when it is not empty and has no ASCII
+ * whitespace, NUL, '/', '=' or '>', which is exactly what the HTML
+ * tokeniser accepts. Lit writes attributes such as ".prop$lit$" and
+ * "lit$123$0" into a template, and every one of them was refused here,
+ * so the parts of every Lit template were bound one value out of step
+ * (VitaSurf).
+ *
+ * \param name  The name need to be tested
+ * \return true if ::name is valid, false otherwise.
+ */
+bool _dom_validate_attr_name(dom_string *name)
+{
+	const uint8_t *s;
+	size_t slen, i;
+
+	if (name == NULL)
+		return false;
+
+	s = (const uint8_t *) dom_string_data(name);
+	slen = dom_string_byte_length(name);
+	if (slen == 0)
+		return false;
+
+	for (i = 0; i < slen; i++) {
+		switch (s[i]) {
+		case 0x00: case 0x09: case 0x0A: case 0x0C: case 0x0D:
+		case ' ': case '/': case '=': case '>':
+			return false;
+		default:
+			break;
+		}
+	}
+
+	return true;
+}
