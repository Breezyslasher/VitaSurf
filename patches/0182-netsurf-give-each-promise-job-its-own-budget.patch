+/**
+ * The names of a node's attributes, as a bloom (VitaSurf).
+ *
+ * libcss uses this to drop a rule whose key compound needs an
+ * attribute the node has not got, rather than offering it and then
+ * refusing it. 94% of the candidates a GitHub page offers come from
+ * the universal chain and most of those are attribute rules, so one
+ * walk of the node's own attributes here saves hundreds of refusals
+ * per element per sheet.
+ *
+ * The filter only ever removes work: a node whose attributes cannot
+ * be read answers with every bit set, which skips nothing.
+ */
+css_error node_attribute_bloom(void *pw, void *node, uint64_t *bloom)
+{
+	dom_node *n = node;
+	dom_namednodemap *attrs = NULL;
+	dom_exception err;
+	uint32_t i, len = 0;
+	uint64_t bits = 0;
+
+	(void) pw;
+
+	err = dom_node_get_attributes(n, &attrs);
+	if (err != DOM_NO_ERR || attrs == NULL) {
+		*bloom = ~(uint64_t) 0;
+		return CSS_OK;
+	}
+	err = dom_namednodemap_get_length(attrs, &len);
+	if (err != DOM_NO_ERR) {
+		dom_namednodemap_unref(attrs);
+		*bloom = ~(uint64_t) 0;
+		return CSS_OK;
+	}
+	for (i = 0; i < len; i++) {
+		dom_node *attr = NULL;
+		dom_string *name = NULL;
+
+		if (dom_namednodemap_item(attrs, i, &attr) != DOM_NO_ERR ||
+				attr == NULL) {
+			continue;
+		}
+		if (dom_node_get_node_name(attr, &name) == DOM_NO_ERR &&
+				name != NULL) {
+			const char *d = dom_string_data(name);
+			size_t l = dom_string_byte_length(name);
+			const char *colon = memchr(d, ':', l);
+
+			bits |= css_attribute_bloom_bits(d, l);
+			/*
+			 * A selector names the local part on its own, so
+			 * xlink:href must answer to href as well or the
+			 * rule would be skipped rather than tested.
+			 */
+			if (colon != NULL) {
+				bits |= css_attribute_bloom_bits(colon + 1,
+						l - (size_t) (colon + 1 - d));
+			}
+			dom_string_unref(name);
+		}
+		dom_node_unref(attr);
+	}
+	dom_namednodemap_unref(attrs);
+
+	*bloom = bits;
+
+	return CSS_OK;
+}
