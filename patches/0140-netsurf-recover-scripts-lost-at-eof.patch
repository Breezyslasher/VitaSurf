+/**
+ * Hand over the scripts the parse dropped (VitaSurf).
+ *
+ * Hubbub closes a script element out at end of input without telling
+ * anyone about it, so a document whose last bytes go missing leaves its
+ * final <script src> sitting in the tree, never fetched and never run.
+ * Audiobookshelf is that page: its fourth bundle is the one that mounts
+ * the app, and without it the browser sits on the loading spinner for
+ * ever with nothing in the log to say why.
+ *
+ * Once the parse is over, anything in the document with a src and no
+ * entry of its own was dropped that way. Hand it to the usual path.
+ *
+ * \param c  the html content whose parse has just finished
+ * \return the number of scripts handed over
+ */
+/**
+ * The key a script element is marked with once it has been handed over.
+ *
+ * Matching by url is not enough: a preload holds the same url, and a
+ * script whose fetch failed has let its handle go. The element itself is
+ * the only thing that says whether this script was ever dealt with.
+ */
+static dom_string *script_seen_key(void)
+{
+	static dom_string *key = NULL;
+
+	if (key == NULL) {
+		if (dom_string_create((const uint8_t *) "__vitasurf_script",
+				      17, &key) != DOM_NO_ERR) {
+			return NULL;
+		}
+	}
+	return key;
+}
+
+
+/**
+ * Note that a script element has been handed to the client (VitaSurf).
+ */
+static void script_mark_seen(dom_node *node)
+{
+	dom_string *key = script_seen_key();
+	void *old = NULL;
+
+	if (key != NULL) {
+		dom_node_set_user_data(node, key, (void *) 1, NULL, &old);
+	}
+}
+
+
+/**
+ * Whether a script element has already been handed over (VitaSurf).
+ */
+static bool script_was_seen(dom_node *node)
+{
+	dom_string *key = script_seen_key();
+	void *data = NULL;
+
+	if (key == NULL) {
+		return false;
+	}
+	if (dom_node_get_user_data(node, key, &data) != DOM_NO_ERR) {
+		return false;
+	}
+	return data != NULL;
+}
+
+
+unsigned int html_recover_dropped_scripts(html_content *c)
+{
+	dom_nodelist *list = NULL;
+	dom_string *name = NULL;
+	uint32_t n = 0, k;
+	unsigned int recovered = 0;
+
+	if (c == NULL || c->document == NULL || c->scripts_recovered ||
+			c->enable_scripting == false) {
+		return 0;
+	}
+	c->scripts_recovered = true;
+
+	if (dom_string_create((const uint8_t *) "script", 6,
+			      &name) != DOM_NO_ERR) {
+		return 0;
+	}
+	if (dom_document_get_elements_by_tag_name(c->document, name, &list) !=
+			DOM_NO_ERR || list == NULL) {
+		dom_string_unref(name);
+		return 0;
+	}
+	dom_string_unref(name);
+
+	dom_nodelist_get_length(list, &n);
+	for (k = 0; k < n; k++) {
+		dom_node *node = NULL;
+		dom_string *src = NULL;
+
+		if (dom_nodelist_item(list, k, &node) != DOM_NO_ERR ||
+				node == NULL) {
+			continue;
+		}
+		if (script_was_seen(node)) {
+			dom_node_unref(node);
+			continue;
+		}
+		if (dom_element_get_attribute((dom_element *) node,
+				corestring_dom_src, &src) != DOM_NO_ERR ||
+				src == NULL) {
+			/* an inline script the parse never closed has no
+			 * body to run */
+			dom_node_unref(node);
+			continue;
+		}
+
+		vita_log("script: the parse dropped %s, picking it up",
+			 dom_string_data(src));
+		dom_string_unref(src);
+		html_process_script(c, node);
+		recovered++;
+		dom_node_unref(node);
+	}
+	dom_nodelist_unref(list);
+
+	return recovered;
+}
+
 /**
  * Callback for asyncronous scripts
  */
