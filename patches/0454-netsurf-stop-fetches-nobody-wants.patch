diff --git a/content/llcache.c b/content/llcache.c
index 22fa6c3be..d989f4c46 100644
--- a/content/llcache.c
+++ b/content/llcache.c
@@ -358,6 +358,25 @@ static nserror llcache_object_user_destroy(llcache_object_user *user)
  * \param user	  User to remove
  * \return NSERROR_OK.
  */
+/*
+ * A fetch nobody wants any more (VitaSurf). An object whose last user
+ * has let go, when the page that asked for it was left or stopped, went
+ * on fetching to the end so that it could be cached: youtube.com's
+ * preloaded 3.7 MB style sheet and 10.6 MB script went on for three
+ * minutes at 50 KB/s through the next five sites the site test loaded,
+ * and the sheet was then converted, 4.9 s, for nothing. A browser cancels
+ * loads no document wants; so are these. Not a POST, which may be a
+ * beacon meant to arrive whoever is listening, and not an object
+ * another is being checked against.
+ */
+static bool llcache_object_orphaned(const llcache_object *object)
+{
+	return object->users == NULL && object->fetch.fetch != NULL &&
+		object->fetch.post == NULL && object->candidate_count == 0;
+}
+
+static void llcache_orphans_stop(void *p);
+
 static nserror llcache_object_remove_user(llcache_object *object,
 		llcache_object_user *user)
 {
@@ -380,6 +399,10 @@ static nserror llcache_object_remove_user(llcache_object *object,
 	/* record the time the last user was removed from the object */
 	if (object->users == NULL) {
 		object->last_used = time(NULL);
+		/* still fetching what nobody wants: stopped from the
+		 * scheduler, outside whatever let it go (VitaSurf) */
+		if (llcache_object_orphaned(object))
+			guit->misc->schedule(0, llcache_orphans_stop, NULL);
 	}
 
 	NSLOG(llcache, DEBUG, "Removing user %p from %p", user, object);
@@ -3954,6 +3977,37 @@ void llcache_memory(uint32_t *bytes, uint32_t *objects)
 	*objects = n;
 }
 
+
+/** Stop the fetches nobody wants any more; see llcache_object_orphaned. */
+static void llcache_orphans_stop(void *p)
+{
+	llcache_object *lists[2], *object;
+	unsigned int n = 0, i;
+	size_t had = 0;
+
+	(void) p;
+	if (llcache == NULL)
+		return;
+	lists[0] = llcache->uncached_objects;
+	lists[1] = llcache->cached_objects;
+	for (i = 0; i < 2; i++) {
+		for (object = lists[i]; object != NULL; object = object->next) {
+			if (!llcache_object_orphaned(object))
+				continue;
+			had += object->source_len;
+			fetch_abort(object->fetch.fetch);
+			object->fetch.fetch = NULL;
+			llcache_object_failed(object);
+			object->fetch.state = LLCACHE_FETCH_COMPLETE;
+			llcache_invalidate_cache_control_data(object);
+			n++;
+		}
+	}
+	if (n > 0)
+		NSLOG(llcache, INFO, "stopped %u fetches nobody wanted any "
+		      "more, %u KB in", n, (unsigned int) (had / 1024));
+}
+
 /*
  * Attempt to clean the cache
  *
@@ -4157,6 +4211,9 @@ void llcache_finalise(void)
 	llcache_object *object, *next;
 	uint64_t total_bandwidth = 0; /* total bandwidth */
 
+	/* the fetches nobody wanted go with the rest (VitaSurf) */
+	guit->misc->schedule(-1, llcache_orphans_stop, NULL);
+
 	/* Attempt to persist anything we have left lying around */
 	llcache_persist(NULL);
 	/* Now clear the persistence callback */
