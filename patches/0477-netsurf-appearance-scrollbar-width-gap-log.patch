 	 * children of its own */
 	if (box->type != BOX_BLOCK &&
@@ -1166,6 +1186,7 @@ box_construct_generate_inline(dom_node *n, html_content *content,
 	const css_computed_content_item *c_item;
 
 	if (container == NULL || style == NULL ||
+			box_select_drawn_by_page(n) ||
