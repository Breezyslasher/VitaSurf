+/**
+ * Whether an element is a select the page draws itself (VitaSurf):
+ * with appearance: none the browser's arrow, which is this build's
+ * select::after in default.css, goes, and the page's own (a background
+ * image, mostly) is the only one. Both had been drawn. Chrome draws no
+ * ::before or ::after on a select at all.
+ */
+static bool box_select_drawn_by_page(dom_node *n)
+{
+	struct box *b = box_for_node(n);
+
+	return b != NULL && b->gadget != NULL &&
+			b->gadget->type == GADGET_SELECT && b->style != NULL &&
+			css_computed_appearance(b->style) ==
+				CSS_APPEARANCE_NONE;
+}
