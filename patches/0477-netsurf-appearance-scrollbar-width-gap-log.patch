 			(CSS_CONTAIN_LAYOUT | CSS_CONTAIN_PAINT)) != 0;
 }
 
+/**
+ * Whether a box's scrollbars are hidden by scrollbar-width: none
+ * (VitaSurf): it still scrolls, by touch, stick and script, but its
+ * scrollbars take no room, are not drawn and take no taps. Carousels
+ * hide theirs so, and they had been drawn under the slides.
+ */
+static inline bool box_scrollbars_hidden(const struct box *box)
+{
+	return box->style != NULL && css_computed_scrollbar_width(
+			box->style) == CSS_SCROLLBAR_WIDTH_NONE;
+}
