+int html_pinned_rects(struct hlcache_handle *h, struct rect *out, int max)
+{
+	html_content *c;
+	int i, n = 0;
+
+	if (h == NULL || content_get_type(h) != CONTENT_HTML)
+		return -1;
+	c = (html_content *) hlcache_handle_get_content(h);
+	if (c == NULL || c->pinned_boxes > HTML_PINNED_MAX ||
+			c->pinned_boxes > max)
+		return -1;
+	for (i = 0; i < c->pinned_boxes; i++) {
+		struct box *b = c->pinned[i];
+
+		/* one not drawn yet is off screen: it comes in with the
+		 * content, through the strip a pan draws */
+		if (b == NULL || !b->pin_drawn)
+			continue;
+		out[n].x0 = b->pin_x0;
+		out[n].y0 = b->pin_y0;
+		out[n].x1 = b->pin_x1;
+		out[n].y1 = b->pin_y1;
+		n++;
+	}
+	return n;
+}
