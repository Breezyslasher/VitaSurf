diff --git a/content/handlers/html/box_construct.c b/content/handlers/html/box_construct.c
index c07b32d27..49e4107f3 100644
--- a/content/handlers/html/box_construct.c
+++ b/content/handlers/html/box_construct.c
@@ -117,6 +117,7 @@ static const box_type box_map[] = {
 	BOX_INLINE_FLEX,     /* CSS_DISPLAY_INLINE_FLEX */
 	BOX_FLEX,            /* CSS_DISPLAY_GRID (VitaSurf: grid layout) */
 	BOX_INLINE_FLEX,     /* CSS_DISPLAY_INLINE_GRID */
+	BOX_INLINE,          /* CSS_DISPLAY_CONTENTS (VitaSurf) */
 };
 
 
@@ -1049,6 +1050,32 @@ box_construct_element(struct box_construct_ctx *ctx, bool *convert_children)
 		}
 	}
 
+	/*
+	 * display: contents (CSS Display 3): the element generates no box
+	 * and its children are laid out as its parent's. A box is still
+	 * made and tied to the node, for the style its children inherit,
+	 * but it is not put in the tree. Being inline, the search for a
+	 * containing block passes over it, so its children land in its
+	 * parent's block, and are flex items when that is a flex
+	 * container. Bubble Card, the most used Home Assistant card from
+	 * HACS, lays out its icon, name and state this way (VitaSurf).
+	 */
+	if (css_display == CSS_DISPLAY_CONTENTS && !props.node_is_root &&
+			props.containing_block != NULL &&
+			(box->flags & IS_REPLACED) == 0) {
+		box->type = BOX_INLINE;
+		box->flags |= DISPLAY_CONTENTS;
+		if (*convert_children)
+			box->flags |= CONVERT_CHILDREN;
+		err = dom_node_set_user_data(ctx->n,
+				corestring_dom___ns_key_box_node_data, box,
+				NULL, (void *) &old_box);
+		if (err != DOM_NO_ERR)
+			return false;
+		box->node = dom_node_ref(ctx->n);
+		return true;
+	}
+
 	nsu_getmonotonic_ms(&vs_sp0);
 	if (convert_special_elements(ctx->n,
 				     ctx->content,
@@ -1236,6 +1263,10 @@ static void box_construct_element_after(dom_node *n, html_content *content)
 
 	assert(box != NULL);
 
+	/* display: contents has no box of its own to end (VitaSurf) */
+	if (box->flags & DISPLAY_CONTENTS)
+		return;
+
 	box_extract_properties(content, n, &props);
 
 	if (box->type == BOX_INLINE || box->type == BOX_BR) {
