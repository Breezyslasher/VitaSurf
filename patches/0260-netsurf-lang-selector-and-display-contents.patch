diff --git a/content/handlers/css/select.c b/content/handlers/css/select.c
index 1af2c1b8c..fcf312ed7 100644
--- a/content/handlers/css/select.c
+++ b/content/handlers/css/select.c
@@ -1988,9 +1988,48 @@ css_error node_is_target(void *pw, void *node, bool *match)
 css_error node_is_lang(void *pw, void *node,
 		lwc_string *lang, bool *match)
 {
-	/** \todo Support languages */
+	/*
+	 * The language is the nearest lang attribute on the element or
+	 * above it; :lang(en) matches "en" and "en-US" alike (VitaSurf).
+	 * Home Assistant keeps its sidebar off the dashboard with a rule
+	 * that asks whether the page is in a right-to-left language.
+	 */
+	dom_node *n = node, *parent;
+	dom_string *value = NULL;
+	dom_exception err;
+	const char *want = lwc_string_data(lang);
+	size_t wl = lwc_string_length(lang);
+	unsigned depth = 0;
 
+	(void)pw;
 	*match = false;
+	dom_node_ref(n);
+	while (n != NULL && depth++ < 256) {
+		dom_node_type type;
+
+		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR ||
+		    type != DOM_ELEMENT_NODE) {
+			break;
+		}
+		err = dom_element_get_attribute(n, corestring_dom_lang, &value);
+		if (err == DOM_NO_ERR && value != NULL) {
+			const char *v = dom_string_data(value);
+			size_t vl = dom_string_byte_length(value);
+
+			*match = (vl >= wl && strncasecmp(v, want, wl) == 0 &&
+				  (vl == wl || v[wl] == '-'));
+			dom_string_unref(value);
+			break;
+		}
+		if (dom_node_get_parent_node(n, &parent) != DOM_NO_ERR) {
+			parent = NULL;
+		}
+		dom_node_unref(n);
+		n = parent;
+	}
+	if (n != NULL) {
+		dom_node_unref(n);
+	}
 
 	return CSS_OK;
 }
