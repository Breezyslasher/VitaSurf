diff --git a/src/parse/properties/box_shadow.c b/src/parse/properties/box_shadow.c
new file mode 100644
index 0000000..83b0a83
--- /dev/null
+++ b/src/parse/properties/box_shadow.c
@@ -0,0 +1,200 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * The shadow a box casts (VitaSurf).
+ *
+ * box-shadow: none | <shadow>#, where a shadow is inset? && <length>{2,4}
+ * && <color>?, in any order. Cards, buttons and menus lean on it, and
+ * the census counts over a thousand declarations on eight of eleven
+ * sites. Only the first shadow in a list is kept: a second one is
+ * usually a fainter, tighter copy of the first, and the painter draws
+ * an approximation anyway.
+ */
+
+/**
+ * Parse one shadow, leaving ctx after it.
+ */
+static css_error parse_shadow(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		bool *inset, css_fixed length[4], uint32_t unit[4],
+		bool *has_colour, uint32_t *colour)
+{
+	const css_token *token;
+	int lengths = 0;
+	bool match;
+
+	*inset = false;
+	*has_colour = false;
+
+	while (1) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || token->type == CSS_TOKEN_EOF ||
+				tokenIsChar(token, ',') ||
+				tokenIsChar(token, '!') ||
+				tokenIsChar(token, ';')) {
+			break;
+		}
+
+		if (token->type == CSS_TOKEN_IDENT &&
+		    lwc_string_caseless_isequal(token->idata,
+				c->strings[INSET], &match) == lwc_error_ok &&
+				match) {
+			parserutils_vector_iterate(vector, ctx);
+			*inset = true;
+			continue;
+		}
+
+		if (token->type == CSS_TOKEN_DIMENSION ||
+				token->type == CSS_TOKEN_NUMBER) {
+			css_error error;
+
+			if (lengths == 4) {
+				return CSS_INVALID;
+			}
+			error = css__parse_unit_specifier(c, vector, ctx,
+					UNIT_PX, &length[lengths],
+					&unit[lengths]);
+			if (error != CSS_OK) {
+				return error;
+			}
+			if ((unit[lengths] & UNIT_LENGTH) == 0 &&
+					length[lengths] != 0) {
+				/* a shadow has no percentages */
+				return CSS_INVALID;
+			}
+			lengths++;
+			continue;
+		}
+
+		if (*has_colour == false) {
+			uint16_t value = 0;
+			int32_t before = *ctx;
+
+			if (css__parse_colour_specifier(c, vector, ctx,
+					&value, colour) == CSS_OK) {
+				if (value == COLOR_TRANSPARENT) {
+					*colour = 0;
+				}
+				*has_colour = true;
+				continue;
+			}
+			*ctx = before;
+		}
+
+		return CSS_INVALID;
+	}
+
+	if (lengths < 2) {
+		return CSS_INVALID;
+	}
+	/* blur and spread default to nothing */
+	for (; lengths < 4; lengths++) {
+		length[lengths] = 0;
+		unit[lengths] = UNIT_PX;
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Parse box-shadow
+ */
+css_error css__parse_box_shadow(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_fixed length[4] = { 0, 0, 0, 0 };
+	uint32_t unit[4] = { UNIT_PX, UNIT_PX, UNIT_PX, UNIT_PX };
+	uint32_t colour = 0;
+	bool inset, has_colour;
+	css_error error;
+	bool match;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_BOX_SHADOW);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+	    lwc_string_caseless_isequal(token->idata, c->strings[NONE],
+			&match) == lwc_error_ok && match) {
+		parserutils_vector_iterate(vector, ctx);
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_BOX_SHADOW, 0, BOX_SHADOW_NONE);
+	}
+
+	error = parse_shadow(c, vector, ctx, &inset, length, unit,
+			&has_colour, &colour);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	/* A colour left out means currentColor, which the painter reads
+	 * as the element's colour; it is carried as fully transparent
+	 * black with a flag bit the painter knows, so it is kept apart
+	 * from a shadow that really is transparent. */
+	if (has_colour == false) {
+		colour = 0x00000001;
+	}
+
+	/* the rest of a list is stepped over */
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	while (token != NULL && tokenIsChar(token, ',')) {
+		css_fixed more[4];
+		uint32_t moreu[4], morec;
+		bool morei, morehc;
+
+		parserutils_vector_iterate(vector, ctx);
+		error = parse_shadow(c, vector, ctx, &morei, more, moreu,
+				&morehc, &morec);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_BOX_SHADOW,
+			0, inset ? BOX_SHADOW_INSET : BOX_SHADOW_SET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = css__stylesheet_style_vappend(result, 9,
+			length[0], unit[0], length[1], unit[1],
+			length[2], unit[2], length[3], unit[3], colour);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
