+/*
+ * An integer written as calc() (VitaSurf): calc(2*1), calc(1 + 1), as a
+ * repeat() count or a line number. Custom properties are substituted
+ * before a declaration is parsed, so Bubble Card's
+ * repeat(calc(2*var(--row-size,1)), ...) and
+ * grid-row: 1 / calc(var(--row-size,1) + 1) arrive here as plain
+ * arithmetic on integers, and were dropped. A quotient is rounded, as
+ * the spec rounds a calc() that must be an integer.
+ */
+static bool int_calc_sum(const parserutils_vector *vector, int32_t *ctx,
+		int32_t *out, int depth);
+
+static bool int_calc_factor(const parserutils_vector *vector, int32_t *ctx,
+		int32_t *out, int depth)
+{
+	const css_token *token;
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL)
+		return false;
+	if (token->type == CSS_TOKEN_NUMBER)
+		return token_to_integer(token, out);
+	if (tokenIsChar(token, '-')) {
+		if (int_calc_factor(vector, ctx, out, depth) == false)
+			return false;
+		*out = -*out;
+		return true;
+	}
+	if (tokenIsChar(token, '(') ||
+			(token->type == CSS_TOKEN_FUNCTION &&
+			 lwc_string_length(token->idata) == 4 &&
+			 strncasecmp(lwc_string_data(token->idata),
+					"calc", 4) == 0)) {
+		if (int_calc_sum(vector, ctx, out, depth + 1) == false)
+			return false;
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+		return token != NULL && tokenIsChar(token, ')');
+	}
+	return false;
+}
+
+static bool int_calc_product(const parserutils_vector *vector, int32_t *ctx,
+		int32_t *out, int depth)
+{
+	const css_token *token;
+	int32_t rhs;
+
+	if (int_calc_factor(vector, ctx, out, depth) == false)
+		return false;
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL ||
+				(tokenIsChar(token, '*') == false &&
+				 tokenIsChar(token, '/') == false))
+			return true;
+		parserutils_vector_iterate(vector, ctx);
+		if (int_calc_factor(vector, ctx, &rhs, depth) == false)
+			return false;
+		if (tokenIsChar(token, '*')) {
+			*out *= rhs;
+		} else {
+			if (rhs == 0)
+				return false;
+			*out = (*out >= 0) == (rhs > 0) ?
+					(*out + rhs / 2) / rhs :
+					(*out - rhs / 2) / rhs;
+		}
+	}
+}
+
+static bool int_calc_sum(const parserutils_vector *vector, int32_t *ctx,
+		int32_t *out, int depth)
+{
+	const css_token *token;
+	int32_t rhs;
+
+	if (depth > 8)
+		return false;
+	if (int_calc_product(vector, ctx, out, depth) == false)
+		return false;
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL ||
+				(tokenIsChar(token, '+') == false &&
+				 tokenIsChar(token, '-') == false))
+			return true;
+		parserutils_vector_iterate(vector, ctx);
+		if (int_calc_product(vector, ctx, &rhs, depth) == false)
+			return false;
+		*out = tokenIsChar(token, '+') ? *out + rhs : *out - rhs;
+	}
+}
+
+/**
+ * An integer, written out or as calc(), at the token just taken; ctx is
+ * left after it.
+ */
+static bool token_to_integer_or_calc(const parserutils_vector *vector,
+		int32_t *ctx, const css_token *token, int32_t *value)
+{
+	int32_t save = *ctx;
+
+	if (token != NULL && token->type == CSS_TOKEN_FUNCTION &&
+			lwc_string_length(token->idata) == 4 &&
+			strncasecmp(lwc_string_data(token->idata), "calc",
+					4) == 0) {
+		const css_token *close;
+
+		if (int_calc_sum(vector, ctx, value, 1)) {
+			consumeWhitespace(vector, ctx);
+			close = parserutils_vector_iterate(vector, ctx);
+			if (close != NULL && tokenIsChar(close, ')'))
+				return true;
+		}
+		*ctx = save;
+		return false;
+	}
+	return token_to_integer(token, value);
+}
+
