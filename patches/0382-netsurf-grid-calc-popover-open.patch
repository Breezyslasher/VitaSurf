+/* A popover that is not shown has no box, and one that is gets the UA's
+ * popover styles, as HTML's rendering rules have them (VitaSurf); there
+ * is no top layer here. GitHub keeps each tooltip in the page as a
+ * closed popover, and drawn, "Change your avatar" sat over the profile
+ * name under the avatar. */
+[popover] {
+	position: fixed;
+	inset: 0;
+	width: fit-content;
+	height: fit-content;
+	margin: auto;
+	border: solid;
+	padding: 0.25em;
+	overflow: auto;
+	color: CanvasText;
+	background-color: Canvas;
+}
