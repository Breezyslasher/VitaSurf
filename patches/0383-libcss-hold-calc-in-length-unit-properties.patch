+/**
+ * A math function where a length is wanted (VitaSurf). One that reduces
+ * to a single length at parse time is that length, as calc(.25rem / 2)
+ * is; any other, as calc(100% - 2px) or max(1em, 12px), is held as an
+ * expression, resolved where it is used, and its unit says so
+ * (UNIT_CALC_EXPR, or UNIT_CALC_EXPR_PCT if it has a percentage). The
+ * function's token is at ctx.
+ */
+static css_error parse_length_expr(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_fixed *length, uint32_t *unit)
+{
+	int32_t orig_ctx = *ctx;
+	uint32_t expr_index = 0, id;
+	lwc_string *expr = NULL;
+	bool pct = false;
+	css_error error;
+
+	if (css__parse_calc_reduced(c, vector, ctx, length, unit) == CSS_OK)
+		return CSS_OK;
+
+	/* lengths alone, and failing that lengths and percentages */
+	parserutils_vector_iterate(vector, ctx);
+	error = css__parse_calc_expr(c, vector, ctx, CSS_PROP_LETTER_SPACING,
+			&expr_index);
+	if (error == CSS_INVALID) {
+		*ctx = orig_ctx;
+		parserutils_vector_iterate(vector, ctx);
+		error = css__parse_calc_expr(c, vector, ctx, CSS_PROP_WIDTH,
+				&expr_index);
+		pct = true;
+	}
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	css__stylesheet_string_get(c->sheet, expr_index, &expr);
+	id = expr != NULL ? css__calc_expr_id(expr) : 0;
+	if (id == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	*length = (css_fixed) id;
+	*unit = pct ? UNIT_CALC_EXPR_PCT : UNIT_CALC_EXPR;
+	return CSS_OK;
+}
