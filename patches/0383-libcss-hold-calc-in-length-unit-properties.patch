+/*
+ * The math functions held as expressions by the properties that store a
+ * length and a unit (VitaSurf): a box shadow, a corner radius, a
+ * background position. Each distinct expression has an id, kept while
+ * any sheet is. A page uses a few hundred; past the cap a new one is
+ * refused and its declaration dropped, as every one was before.
+ */
+
+uint32_t css__calc_expr_id(lwc_string *expr)
+{
+	uint32_t i;
+
+	/* interned, so the same expression is the same string */
+	for (i = n_calc_exprs; i-- > 0; ) {
+		if (calc_exprs[i] == expr)
+			return i + 1;
+	}
+	if (n_calc_exprs >= CALC_EXPR_MAX)
+		return 0;
+	if ((n_calc_exprs & 63) == 0) {
+		lwc_string **g = realloc(calc_exprs,
+				(n_calc_exprs + 64) * sizeof(*g));
+
+		if (g == NULL)
+			return 0;
+		calc_exprs = g;
+	}
+	calc_exprs[n_calc_exprs++] = lwc_string_ref(expr);
+	return n_calc_exprs;
+}
