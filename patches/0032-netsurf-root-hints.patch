+
 	/* rel=<space separated list, including 'stylesheet'> */
 	exc = dom_element_get_attribute(node, corestring_dom_rel, &rel);
 	if (exc != DOM_NO_ERR || rel == NULL)
diff --git a/content/llcache.c b/content/llcache.c
index 2ec39e8c8..e60b62c77 100644
--- a/content/llcache.c
+++ b/content/llcache.c
@@ -3728,15 +3728,39 @@ static void llcache_catch_up_all_users(void *ignored)
 	 */
 	llcache->all_caught_up = true;
 
-	/* Catch new users up with state of objects */
+	/*
+	 * Catch new users up with state of objects, oldest object first
+	 * (VitaSurf).
+	 *
+	 * Both lists are built by inserting at the head, so walking them
+	 * forwards hands the page its resources in the reverse of the
+	 * order it asked for them: the last stylesheet in the document
+	 * parses first, the last image decodes first. For stylesheets
+	 * that is not merely untidy -- a sheet's custom properties are
+	 * substituted as it parses, so a sheet that spends a colour
+	 * token parsed before the theme sheet that defines it loses
+	 * every colour it asked for.
+	 */
 	for (object = llcache->cached_objects; object != NULL;
 			object = object->next) {
+		if (object->next == NULL)
+			break;
+	}
+	while (object != NULL) {
+		llcache_object *prev = object->prev;
 		llcache_object_notify_users(object);
+		object = prev;
 	}
 
 	for (object = llcache->uncached_objects; object != NULL;
 			object = object->next) {
+		if (object->next == NULL)
+			break;
+	}
+	while (object != NULL) {
+		llcache_object *prev = object->prev;
 		llcache_object_notify_users(object);
+		object = prev;
 	}
 }
 
