+/*
+ * Tell libcss about the document's root element (VitaSurf).
+ *
+ * Custom properties are substituted as a sheet is parsed, so the parser
+ * has to decide there and then whether a --name declaration belongs to
+ * the root. A site does not write its palette on a bare :root: it hangs
+ * it off an attribute on <html> and switches theme by changing that.
+ * github.com ships sixteen mutually exclusive blocks of 959 colours
+ * each, every one of them scoped to data-color-mode and a theme name,
+ * and no unconditional fallback -- so with nothing to match against,
+ * every colour on the page resolves to nothing and the page renders
+ * white. This hands libcss the attributes it needs to pick the block
+ * that applies.
+ *
+ * Called before any sheet of this document is created or reparsed.
+ */
+#define HTML_ROOT_HINT_MAX 32
+
+static void html_css_set_root_hints(html_content *c)
+{
+	css_root_hint_attr attrs[HTML_ROOT_HINT_MAX];
+	char *owned[HTML_ROOT_HINT_MAX * 2];
+	char *element = NULL;
+	unsigned int n_attrs = 0;
+	unsigned int n_owned = 0;
+	unsigned int i;
+	dom_element *root = NULL;
+	dom_namednodemap *map = NULL;
+	dom_string *name = NULL;
+	uint32_t len = 0;
+
+	if (c->document == NULL)
+		return;
+	if (dom_document_get_document_element(c->document, &root) !=
+			DOM_NO_ERR || root == NULL)
+		return;
+
+	if (dom_node_get_node_name(root, &name) == DOM_NO_ERR &&
+			name != NULL) {
+		element = strndup(dom_string_data(name),
+				dom_string_byte_length(name));
+		dom_string_unref(name);
+	}
+	if (element == NULL)
+		goto out;
+
+	if (dom_node_get_attributes(root, &map) == DOM_NO_ERR && map != NULL &&
+	    dom_namednodemap_get_length(map, &len) == DOM_NO_ERR) {
+		for (i = 0; i < len && n_attrs < HTML_ROOT_HINT_MAX; i++) {
+			dom_node *attr = NULL;
+			dom_string *aname = NULL, *avalue = NULL;
+			char *cn = NULL, *cv = NULL;
+
+			if (dom_namednodemap_item(map, i, &attr) !=
+					DOM_NO_ERR || attr == NULL)
+				continue;
+			if (dom_node_get_node_name(attr, &aname) == DOM_NO_ERR &&
+					aname != NULL) {
+				cn = strndup(dom_string_data(aname),
+						dom_string_byte_length(aname));
+				dom_string_unref(aname);
+			}
+			if (dom_node_get_node_value(attr, &avalue) ==
+					DOM_NO_ERR && avalue != NULL) {
+				cv = strndup(dom_string_data(avalue),
+						dom_string_byte_length(avalue));
+				dom_string_unref(avalue);
+			}
+			dom_node_unref(attr);
+
+			if (cn == NULL || cv == NULL) {
+				free(cn);
+				free(cv);
+				continue;
+			}
+			owned[n_owned++] = cn;
+			owned[n_owned++] = cv;
+			attrs[n_attrs].name = cn;
+			attrs[n_attrs].value = cv;
+			n_attrs++;
+		}
+	}
+
+	css_set_root_hints(element, attrs, n_attrs);
+
+out:
+	for (i = 0; i < n_owned; i++)
+		free(owned[i]);
+	free(element);
+	if (map != NULL)
+		dom_namednodemap_unref(map);
+	dom_node_unref(root);
+}
+
+
