  */
 static bool curl_ca_shared;
 
-/** Put the shared CA chain in place of the one libcurl set up. */
+/*
+ * Hosts whose server refused the lean TLS offer and are given mbedTLS's
+ * whole list of suites instead (VitaSurf); see vita_tls_lean_suites().
+ */
+#define TLS_FULL_HOSTS 8
+static lwc_string *tls_full_hosts[TLS_FULL_HOSTS];
+static unsigned int tls_full_next;
+
+static bool fetch_curl_tls_full(lwc_string *host)
+{
+	unsigned int i;
+	bool match;
+
+	if (host == NULL)
+		return false;
+	for (i = 0; i < TLS_FULL_HOSTS; i++) {
+		if (tls_full_hosts[i] != NULL &&
+		    lwc_string_caseless_isequal(tls_full_hosts[i], host,
+						&match) == lwc_error_ok && match)
+			return true;
+	}
+	return false;
+}
+
+static void fetch_curl_tls_full_add(lwc_string *host)
+{
+	if (host == NULL || fetch_curl_tls_full(host))
+		return;
+	if (tls_full_hosts[tls_full_next] != NULL)
+		lwc_string_unref(tls_full_hosts[tls_full_next]);
+	tls_full_hosts[tls_full_next] = lwc_string_ref(host);
+	tls_full_next = (tls_full_next + 1) % TLS_FULL_HOSTS;
+}
+
+/**
+ * Put the shared CA chain in place of the one libcurl set up, and offer
+ * the lean list of suites unless the host has refused it. The handle
+ * may be a WebSocket's or a worker's, copied from the template, so the
+ * host is taken from the URL being connected to.
+ */
 static CURLcode
 fetch_curl_vita_sslctx(CURL *curl_handle, void *ssl_config, void *parm)
 {
-	(void)curl_handle;
+	char *url = NULL;
+	bool full = false;
+
 	(void)parm;
 	vita_tls_ca_attach(ssl_config);
+	if (curl_easy_getinfo(curl_handle, CURLINFO_EFFECTIVE_URL, &url) ==
+	    CURLE_OK && url != NULL) {
+		nsurl *u;
+
+		if (nsurl_create(url, &u) == NSERROR_OK) {
+			lwc_string *host = nsurl_get_component(u, NSURL_HOST);
+
+			full = fetch_curl_tls_full(host);
+			if (host != NULL)
+				lwc_string_unref(host);
+			nsurl_unref(u);
+		}
+	}
+	if (!full)
+		vita_tls_lean_suites(ssl_config);
 	return CURLE_OK;
 }
 #endif
@@ -1633,6 +1689,26 @@ static bool fetch_curl_process_headers(struct curl_fetch_info *f)
 			vitasurf_net_h2++;
 		}
 	}
+#ifdef __vita__
+	/* the cipher a new TLS connection agreed, for the page summary */
+	{
+		long connects = 0;
+		struct curl_tlssessioninfo *tls = NULL;
+
+		if (curl_easy_getinfo(f->curl_handle, CURLINFO_NUM_CONNECTS,
+				      &connects) == CURLE_OK && connects > 0 &&
+		    curl_easy_getinfo(f->curl_handle, CURLINFO_TLS_SSL_PTR,
+				      &tls) == CURLE_OK &&
+		    tls != NULL && tls->backend == CURLSSLBACKEND_MBEDTLS &&
+		    tls->internals != NULL) {
+			switch (vita_tls_cipher_kind(tls->internals)) {
+			case 0: vitasurf_net_tls_chacha++; break;
+			case 1: vitasurf_net_tls_aes++; break;
+			default: vitasurf_net_tls_other++; break;
+			}
+		}
+	}
+#endif
 
 	if ((http_code == HTTP_RESPONSE_NOT_MODIFIED) &&
 	    (f->postdata->type==FETCH_POSTDATA_NONE)) {
@@ -1755,6 +1831,28 @@ static void fetch_curl_done(CURL *curl_handle, CURLcode result)
 	assert(code == CURLE_OK);
 
 	abort_fetch = f->abort;
+#ifdef __vita__
+	/*
+	 * A handshake that failed before any reply, to a server that may
+	 * have refused the lean TLS offer: once more, with mbedTLS's whole
+	 * list, which the host keeps from now on (VitaSurf).
+	 */
+	if (result == CURLE_SSL_CONNECT_ERROR && !abort_fetch &&
+	    !f->stopped && !f->had_headers && curl_ca_shared &&
+	    !fetch_curl_tls_full(f->host)) {
+		fetch_curl_tls_full_add(f->host);
+		NSLOG(netsurf, INFO, "TLS handshake failed (%s); again with "
+		      "every cipher suite: %s",
+		      fetch_error_buffer[0] != '\0' ? fetch_error_buffer :
+		      "no detail", nsurl_access(f->url));
+		vita_log("tls: %s refused the lean cipher offer; trying "
+			 "again with every suite", lwc_string_data(f->host));
+		curl_multi_remove_handle(fetch_curl_multi, curl_handle);
+		if (curl_multi_add_handle(fetch_curl_multi, curl_handle) ==
+		    CURLM_OK)
+			return;
+	}
+#endif
 	NSLOG(netsurf, INFO, "done %s", nsurl_access(f->url));
 	fetch_curl_note_times(curl_handle);
 
