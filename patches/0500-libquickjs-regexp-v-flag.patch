+    while (lo <= hi) {
+        int mid = (lo + hi) / 2, r;
+        const REClassString *m = &cs->strs[mid];
+
+        r = cs_str_cmp(cs->pool + m->off, m->len, cps, len);
+        if (r == 0)
+            return true;
+        if (r < 0)
+            lo = mid + 1;
+        else
+            hi = mid - 1;
+    }
+    return false;
