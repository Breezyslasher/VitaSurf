+static int cs_union(REClassSet *a, const REClassSet *b)
+{
+    int i;
+
+    if (cr_union1(&a->cr, b->cr.points, b->cr.len))
+        return -1;
+    for (i = 0; i < b->count; i++) {
+        if (cs_add_string(a, b->pool + b->strs[i].off, b->strs[i].len))
+            return -1;
+    }
+    cs_sort(a);
+    return 0;
