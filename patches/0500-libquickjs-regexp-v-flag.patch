+    if (alen != blen)
+        return alen < blen ? 1 : -1;    /* longest first */
+    for (i = 0; i < alen; i++) {
+        if (a[i] != b[i])
+            return a[i] < b[i] ? -1 : 1;
+    }
+    return 0;
