+/* a ClassSetCharacter: its code point with *pp past it, or -1 */
+static int re_class_set_char(REParseState *s, const uint8_t **pp)
+{
+    const uint8_t *p = *pp, *p_next;
+    uint32_t c;
+    int ret;
