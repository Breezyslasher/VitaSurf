+/* each character simple-case-folded */
+static int cs_fold(REClassSet *cs)
+{
+    int i;
+
+    if (cr_regexp_canonicalize(&cs->cr, true))
+        return -1;
+    for (i = 0; i < cs->pool_len; i++)
+        cs->pool[i] = lre_canonicalize(cs->pool[i], true);
+    cs_sort(cs);
+    return 0;
