+        may = false;
+        p++;
+        goto end;
+    }
+    if (re_class_set_item(s, &p, cs, &may, &is_range))
+        return -1;
+    for (;;) {
+        if (p >= s->buf_end) {
+            re_parse_error(s, "unexpected end");
+            goto fail;
+        }
+        if (*p == ']') {
+            p++;
+            break;
+        }
+        if (p[0] == '&' && p[1] == '&') {
+            if (op == OP_NONE && !is_range)
+                op = OP_INTER;
+            if (op != OP_INTER)
+                goto bad_op;
+            p += 2;
+            if (*p == '&')
+                goto bad_op;
+        } else if (p[0] == '-' && p[1] == '-') {
+            if (op == OP_NONE && !is_range)
+                op = OP_SUB;
+            if (op != OP_SUB)
+                goto bad_op;
+            p += 2;
+        } else {
+            if (op == OP_NONE)
+                op = OP_UNION;
+            if (op != OP_UNION)
+                goto bad_op;
+        }
+        if (op == OP_UNION) {
+            if (re_class_set_item(s, &p, &item, &may_item, &is_range))
+                goto fail;
+        } else {
+            int c;
+            if (re_class_set_operand(s, &p, &item, &may_item, &c))
+                goto fail;
+        }
+        if (op == OP_UNION) {
+            if (cs_union(cs, &item))
+                goto oom_item;
+            may = may || may_item;
+        } else {
+            if (cs_inter_sub(cs, &item, op == OP_SUB))
+                goto oom_item;
+            if (op == OP_INTER)
+                may = may && may_item;
+        }
+        cs_free(&item);
+    }
+ end:
+    if (invert) {
+        if (may) {
+            cs_free(cs);
+            return re_parse_error(s, "negated character class may contain strings");
+        }
+        if (cr_invert(&cs->cr)) {
+            cs_free(cs);
+            return re_parse_out_of_memory(s);
+        }
+    }
+    *pmay = may;
+    *pp = p;
+    return 0;
+ bad_op:
+    re_parse_error(s, "invalid set operation in character class");
+    goto fail;
+ oom_item:
+    cs_free(&item);
+    re_parse_out_of_memory(s);
+ fail:
+    cs_free(cs);
+    return -1;
+}
+
+/* the matching of one character, either way */
+static void re_emit_class_char(REParseState *s, uint32_t c, bool back)
+{
+    if (back)
+        re_emit_op(s, REOP_prev);
+    if (c <= 0x7f)
+        re_emit_op_u8(s, REOP_char8, c);
+    else if (c <= 0xffff)
+        re_emit_op_u16(s, REOP_char16, c);
+    else
+        re_emit_op_u32(s, REOP_char32, c);
+    if (back)
+        re_emit_op(s, REOP_prev);
+}
+
+static int re_emit_class_range(REParseState *s, const CharRange *cr, bool back)
+{
+    int ret;
+
+    if (back)
+        re_emit_op(s, REOP_prev);
+    ret = re_emit_range(s, cr);
+    if (back)
+        re_emit_op(s, REOP_prev);
+    return ret;
+}
+
+/* the next character is in cr, without taking it */
+static int re_emit_peek(REParseState *s, const CharRange *cr, bool back)
+{
+    int ret;
+
+    if (back)
+        re_emit_op(s, REOP_prev);
+    ret = re_emit_range(s, cr);
+    if (!back)
+        re_emit_op(s, REOP_prev);
+    return ret;
+}
+
+typedef struct {
+    REParseState *s;
+    REClassSet *cs;
+    int *idx;       /* the strings, in key order */
+    bool back;
+} RETrie;
+
+static inline uint32_t re_trie_key(const RETrie *t, int i, int depth)
+{
+    const REClassString *x = &t->cs->strs[t->idx[i]];
+    return t->cs->pool[x->off + (t->back ? x->len - 1 - depth : depth)];
+}
+
+static int re_trie_cmp(const void *a, const void *b, void *opaque)
+{
+    const RETrie *t = opaque;
+    const REClassString *x = &t->cs->strs[*(const int *)a];
+    const REClassString *y = &t->cs->strs[*(const int *)b];
+    uint32_t i, n = min_uint32(x->len, y->len);
+
+    for (i = 0; i < n; i++) {
+        uint32_t cx = t->cs->pool[x->off + (t->back ? x->len - 1 - i : i)];
+        uint32_t cy = t->cs->pool[y->off + (t->back ? y->len - 1 - i : i)];
+        if (cx != cy)
+            return cx < cy ? -1 : 1;
+    }
+    return x->len < y->len ? -1 : x->len > y->len;
+}
+
+/* split_next_first before each alternative but the last, and a goto
+   after it to the end: the alternatives are begun and ended with these */
+typedef struct {
+    int split;
+    int gotos[16];
+    int n;
+} REAlt;
+
+static void re_alt_begin(REParseState *s, REAlt *a, bool last)
+{
+    a->split = last ? -1 : re_emit_op_u32(s, REOP_split_next_first, 0);
+}
+
+static void re_alt_end(REParseState *s, REAlt *a, bool last)
+{
+    if (!last) {
+        a->gotos[a->n++] = re_emit_op_u32(s, REOP_goto, 0);
+        put_u32(s->byte_code.buf + a->split,
+                s->byte_code.size - (a->split + 4));
+    }
+}
+
+static void re_alt_close(REParseState *s, REAlt *a)
+{
+    int i;
+
+    for (i = 0; i < a->n; i++)
+        put_u32(s->byte_code.buf + a->gotos[i],
+                s->byte_code.size - (a->gotos[i] + 4));
+    a->n = 0;
+}
+
+static int re_emit_trie(RETrie *t, int lo, int hi, int depth);
+
+/* groups[g0..g1) of the strings past depth, each beginning with one key */
+static int re_emit_trie_groups(RETrie *t, const int *groups, int g0, int g1,
+                               int depth)
+{
+    REParseState *s = t->s;
+    REAlt alt = { 0 };
+    int g, n = g1 - g0;
+
+    if (n > 8) {
+        /* two halves, each fronted by a look at the next character */
+        int h, mid = g0 + n / 2;
+
+        for (h = 0; h < 2; h++) {
+            int a0 = h ? mid : g0, a1 = h ? g1 : mid;
+            CharRange cr;
+
+            cr_init(&cr, s->opaque, lre_realloc);
+            for (g = a0; g < a1; g++) {
+                uint32_t k = re_trie_key(t, groups[g], depth);
+                if (cr_union_interval(&cr, k, k)) {
+                    cr_free(&cr);
+                    return re_parse_out_of_memory(s);
+                }
+            }
+            re_alt_begin(s, &alt, h == 1);
+            if (re_emit_peek(s, &cr, t->back)) {
+                cr_free(&cr);
+                return -1;
+            }
+            cr_free(&cr);
+            if (re_emit_trie_groups(t, groups, a0, a1, depth))
+                return -1;
+            re_alt_end(s, &alt, h == 1);
+        }
+        re_alt_close(s, &alt);
+        return 0;
+    }
+    for (g = g0; g < g1; g++) {
+        int end = groups[g + 1];
+
+        re_alt_begin(s, &alt, g == g1 - 1);
+        re_emit_class_char(s, re_trie_key(t, groups[g], depth), t->back);
+        if (re_emit_trie(t, groups[g], end, depth + 1))
+            return -1;
+        re_alt_end(s, &alt, g == g1 - 1);
+    }
+    re_alt_close(s, &alt);
+    return 0;
+}
+
+/*
+ * The strings idx[lo..hi), which share their first depth characters:
+ * what matches the rest of each, the longest first. One string alone is
+ * its characters in a line, whatever its length.
+ */
+static int re_emit_trie(RETrie *t, int lo, int hi, int depth)
+{
+    REParseState *s = t->s;
+    REAlt alt = { 0 };
+    int i, ng, *groups, ret;
+    bool end_here = false;
+
+    if (lre_check_stack_overflow(s->opaque, 0))
+        return re_parse_error(s, "stack overflow");
+    /* those that end here sort first */
+    while (lo < hi && t->cs->strs[t->idx[lo]].len == (uint32_t)depth) {
+        end_here = true;
+        lo++;
+    }
+    if (lo == hi)
+        return 0;
+    if (hi - lo == 1 && !end_here) {
+        const REClassString *x = &t->cs->strs[t->idx[lo]];
+        for (i = depth; i < (int)x->len; i++)
+            re_emit_class_char(s, re_trie_key(t, lo, i), t->back);
+        return 0;
+    }
+    groups = lre_realloc(s->opaque, NULL, (hi - lo + 1) * sizeof(int));
+    if (!groups)
+        return re_parse_out_of_memory(s);
+    ng = 0;
+    for (i = lo; i < hi; i++) {
+        if (i == lo || re_trie_key(t, i, depth) != re_trie_key(t, i - 1, depth))
+            groups[ng++] = i;
+    }
+    groups[ng] = hi;
+    re_alt_begin(s, &alt, !end_here);
+    ret = re_emit_trie_groups(t, groups, 0, ng, depth);
+    lre_realloc(s->opaque, groups, 0);
+    if (ret)
+        return -1;
+    re_alt_end(s, &alt, !end_here);
+    /* and having matched no more of it, the shorter one that ends here */
+    re_alt_close(s, &alt);
+    return 0;
+}
+
+/* a class's set, matched where the term stands */
+static int re_emit_class_set(REParseState *s, REClassSet *cs, bool back)
+{
+    RETrie t;
+    REAlt alt = { 0 };
+    CharRange first;
+    int i, n, ret = -1;
+    bool has_empty = false;
+
+    if (cs->count == 0)
+        return re_emit_class_range(s, &cs->cr, back);
+    t.s = s;
+    t.cs = cs;
+    t.back = back;
+    t.idx = lre_realloc(s->opaque, NULL, cs->count * sizeof(int));
+    if (!t.idx)
+        return re_parse_out_of_memory(s);
+    for (i = 0, n = 0; i < cs->count; i++) {
+        if (cs->strs[i].len == 0)
+            has_empty = true;
+        else
+            t.idx[n++] = i;
+    }
+    rqsort(t.idx, n, sizeof(int), re_trie_cmp, &t);
+    /* nothing to try where the next character begins none of them */
+    cr_init(&first, s->opaque, lre_realloc);
+    if (!has_empty) {
+        if (cr_copy(&first, &cs->cr))
+            goto oom;
+        for (i = 0; i < n; i++) {
+            uint32_t k = re_trie_key(&t, i, 0);
+            if (cr_union_interval(&first, k, k))
+                goto oom;
+        }
+        if (re_emit_peek(s, &first, back))
+            goto done;
+    }
+    /* the strings, longest first, then one character, then nothing */
+    if (n) {
+        bool last = cs->cr.len == 0 && !has_empty;
+        re_alt_begin(s, &alt, last);
+        if (re_emit_trie(&t, 0, n, 0))
+            goto done;
+        re_alt_end(s, &alt, last);
+    }
+    if (cs->cr.len) {
+        re_alt_begin(s, &alt, !has_empty);
+        if (re_emit_class_range(s, &cs->cr, back))
+            goto done;
+        re_alt_end(s, &alt, !has_empty);
+    }
+    re_alt_close(s, &alt);
+    ret = 0;
+    goto done;
+ oom:
+    re_parse_out_of_memory(s);
+ done:
+    cr_free(&first);
+    lre_realloc(s->opaque, t.idx, 0);
+    return ret;
+}
