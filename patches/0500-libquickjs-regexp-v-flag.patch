+
+/* in order, longest first, each once */
+static void cs_sort(REClassSet *cs)
+{
+    int i, j;
+
+    if (cs->count < 2)
+        return;
+    rqsort(cs->strs, cs->count, sizeof(cs->strs[0]), cs_cmp, cs);
+    for (i = 1, j = 1; i < cs->count; i++) {
+        if (cs_cmp(&cs->strs[i], &cs->strs[j - 1], cs))
+            cs->strs[j++] = cs->strs[i];
+    }
+    cs->count = j;
