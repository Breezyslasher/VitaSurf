+
+/* cps must not point into cs's own pool */
+static int cs_add_string(REClassSet *cs, const uint32_t *cps, int len)
+{
+    if (len == 1)
+        return cr_union_interval(&cs->cr, cps[0], cps[0]);
+    if (cs->pool_len + len > cs->pool_size) {
+        int n = max_int(cs->pool_size * 2, cs->pool_len + len + 16);
+        uint32_t *p = lre_realloc(cs->opaque, cs->pool, n * sizeof(uint32_t));
+        if (!p)
+            return -1;
+        cs->pool = p;
+        cs->pool_size = n;
+    }
+    if (cs->count >= cs->size) {
+        int n = max_int(cs->size * 2, 16);
+        REClassString *t = lre_realloc(cs->opaque, cs->strs, n * sizeof(*t));
+        if (!t)
