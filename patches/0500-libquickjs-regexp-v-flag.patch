+    if (p >= s->buf_end)
+        return re_parse_error(s, "unexpected end");
+    c = *p;
+    if (c == '\\') {
+        p++;
+        if (p >= s->buf_end)
+            return re_parse_error(s, "unexpected end");
+        c = *p;
+        if (c == 'b') {
+            *pp = p + 1;
+            return '\b';
+        }
+        if (c == 'c') {
+            c = p[1];
+            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
+                *pp = p + 2;
+                return c & 0x1f;
+            }
+            goto invalid_escape;
+        }
+        /* a reserved punctuator, or a syntax character, escaped */
+        if (c != '\0' && (strchr("&-!#%,:;<=>@`~", c) ||
+                          strchr("^$\\.*+?()[]{}|/", c))) {
+            *pp = p + 1;
+            return c;
+        }
+        ret = lre_parse_escape(&p, 2);
+        if (ret < 0) {
+        invalid_escape:
+            return re_parse_error(s, "invalid escape sequence in regular expression");
+        }
+        *pp = p;
+        return ret;
+    }
+    if (c != '\0' && strchr("&!#$%*+,.:;<=>?@^`~", c) &&
+        p + 1 < s->buf_end && p[1] == c)
+        return re_parse_error(s, "invalid set operation in character class");
