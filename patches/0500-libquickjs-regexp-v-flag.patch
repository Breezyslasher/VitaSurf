+
+static int cs_cmp(const void *a, const void *b, void *opaque)
+{
+    const REClassSet *cs = opaque;
+    const REClassString *x = a, *y = b;
+
+    return cs_str_cmp(cs->pool + x->off, x->len, cs->pool + y->off, y->len);
