+    cr_init(&t, a->opaque, lre_realloc);
+    if (sub) {
+        cr_init(&inv, a->opaque, lre_realloc);
+        ret = cr_copy(&inv, &b->cr) || cr_invert(&inv) ||
+            cr_op(&t, a->cr.points, a->cr.len, inv.points, inv.len,
+                  CR_OP_INTER);
+        cr_free(&inv);
+    } else {
+        ret = cr_op(&t, a->cr.points, a->cr.len, b->cr.points, b->cr.len,
+                    CR_OP_INTER);
+    }
+    if (ret) {
+        cr_free(&t);
+        return -1;
+    }
+    cr_free(&a->cr);
+    a->cr = t;
+    for (i = 0, j = 0; i < a->count; i++) {
+        bool in = cs_has(b, a->pool + a->strs[i].off, a->strs[i].len);
+        if (in != sub)
+            a->strs[j++] = a->strs[i];
+    }
+    a->count = j;
+    return 0;
