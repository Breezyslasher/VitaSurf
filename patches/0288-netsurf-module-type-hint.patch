+	vitasurf_js_module_first = 0;
 	vitasurf_js_reparse_kb = 0;
 	vitasurf_ms_js_import_cached = 0;
 	vitasurf_js_import_cache_hits = 0;
diff --git a/utils/utils.h b/utils/utils.h
index afe1c52b4..902f7b77c 100644
--- a/utils/utils.h
+++ b/utils/utils.h
@@ -161,6 +161,10 @@ extern unsigned int vitasurf_js_import_compiles;
 extern unsigned int vitasurf_js_import_kb;
 extern unsigned int vitasurf_ms_js_reparse;
 extern unsigned int vitasurf_js_reparses;
+/** The script about to run came from a type="module" element. */
+extern bool vitasurf_js_module_hint;
+/** Scripts compiled as modules straight away for that. */
+extern unsigned int vitasurf_js_module_first;
 extern unsigned int vitasurf_js_reparse_kb;
 /* imports read back from the compiled script cache instead */
 extern unsigned int vitasurf_ms_js_import_cached;
