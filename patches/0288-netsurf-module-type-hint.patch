 unsigned int vitasurf_js_import_kb;
 unsigned int vitasurf_ms_js_reparse;
 unsigned int vitasurf_js_reparses;
+bool vitasurf_js_module_hint;
+unsigned int vitasurf_js_module_first;
 unsigned int vitasurf_js_reparse_kb;
 unsigned int vitasurf_ms_js_import_cached;
 unsigned int vitasurf_js_import_cache_hits;
@@ -832,6 +834,7 @@ void vitasurf_profile_reset(void)
 	vitasurf_js_import_kb = 0;
 	vitasurf_ms_js_reparse = 0;
