+void fetch_host_multiplexes(lwc_string *host)
+{
+	if (host == NULL || fetch_host_is_mux(host))
+		return;
+	/* the oldest goes when the table is full */
+	if (fetch_mux_hosts[fetch_mux_next] != NULL)
+		lwc_string_unref(fetch_mux_hosts[fetch_mux_next]);
+	fetch_mux_hosts[fetch_mux_next] = lwc_string_ref(host);
+	fetch_mux_next = (fetch_mux_next + 1) % FETCH_MUX_HOSTS;
