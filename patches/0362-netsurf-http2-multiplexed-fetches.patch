+static bool fetch_host_is_mux(lwc_string *host)
+{
+	unsigned int i;
+	bool match;
+
+	for (i = 0; i < FETCH_MUX_HOSTS; i++) {
+		if (fetch_mux_hosts[i] != NULL &&
+		    lwc_string_isequal(fetch_mux_hosts[i], host, &match) ==
+		    lwc_error_ok && match)
