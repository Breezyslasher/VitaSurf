+/*
+ * A script element's load and error events (VitaSurf). NetSurf sent
+ * neither, so a loader that waits for a script's load (next/script's
+ * onLoad, a loadScript() promise, a polyfill loader) waited for good,
+ * and one that reports a failed script never heard of it. load is sent
+ * once the script has run, as the HTML standard's "execute the script
+ * element" does; error when its fetch fails, from a task of its own, as
+ * the failure can come back inside the fetch call, with the element
+ * still being put in. A script whose src is a Blob the page made, which
+ * nothing fetches, runs from a task the same way, from the text the
+ * page holds (js_exec_local), and had been dropped without either.
+ */
+struct script_error_task {
+	struct script_error_task *next;
+	html_content *c;
+	dom_node *node;
+	char *blob;		/* the Blob's address to run, or NULL */
+	bool module;
+};
+static struct script_error_task *script_errors;
+static struct script_error_task **script_errors_tail = &script_errors;
+
+static void script_errors_run(void *p)
+{
+	struct script_error_task *t;
+
+	(void) p;
+	while ((t = script_errors) != NULL) {
+		script_errors = t->next;
+		if (script_errors == NULL)
+			script_errors_tail = &script_errors;
+		if (t->c->jsthread != NULL && !t->c->aborted) {
+			bool ran = false;
+
+			if (t->blob != NULL) {
+				vitasurf_js_module_hint = t->module;
+				ran = js_exec_local(t->c->jsthread, t->blob);
+				vitasurf_js_module_hint = false;
+				if (!ran)
+					vita_log("script: %s is no Blob this "
+						 "page holds", t->blob);
+			}
+			fire_generic_dom_event(ran ? corestring_dom_load :
+					corestring_dom_error, t->node,
+					false, false);
+		}
+		dom_node_unref(t->node);
+		free(t->blob);
+		free(t);
+	}
+}
+
+/** Send error to a script element whose fetch failed, from a task; or
+ * with blob, run the Blob of that address and send load. */
+static void script_task_soon(html_content *c, dom_node *node,
+		const char *blob, bool module)
+{
+	struct script_error_task *t;
+
+	if (node == NULL || (t = malloc(sizeof(*t))) == NULL)
+		return;
+	t->next = NULL;
+	t->c = c;
+	t->node = dom_node_ref(node);
+	t->blob = blob != NULL ? strdup(blob) : NULL;
+	t->module = module;
+	*script_errors_tail = t;
+	script_errors_tail = &t->next;
+	guit->misc->schedule(0, script_errors_run, NULL);
+}
+
+/** Forget the error events of a document going away. */
+static void script_errors_drop(html_content *c)
+{
+	struct script_error_task **pt = &script_errors, *t;
+
+	while ((t = *pt) != NULL) {
+		if (t->c == c) {
+			*pt = t->next;
+			dom_node_unref(t->node);
+			free(t->blob);
+			free(t);
+			continue;
+		}
+		pt = &t->next;
+	}
+	script_errors_tail = pt;
+}
+
+static void script_error_soon(html_content *c, dom_node *node)
+{
+	script_task_soon(c, node, NULL, false);
+}
+
+/** Send load to the external script c->scripts[i], which has just run:
+ * what it sets off may add scripts, which moves the array. */
+static void script_loaded(html_content *c, unsigned int i)
+{
+	dom_node *node = c->scripts[i].node;
+
+	if (node == NULL || c->jsthread == NULL)
+		return;
+	dom_node_ref(node);
+	fire_generic_dom_event(corestring_dom_load, node, false, false);
+	dom_node_unref(node);
+}
+
