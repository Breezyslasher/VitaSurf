+			if (dom_string_concat(prev->value, c->value,
+					&joined) == DOM_NO_ERR) {
+				dom_characterdata_set_data(
+					(struct dom_characterdata *) prev,
+					joined);
+				dom_string_unref(joined);
+				dom_node_ref((struct dom_node *) prev);
+				*result = prev;
+				return HUBBUB_OK;
+			}
+		}
+	}
 
 	err = dom_node_insert_before((struct dom_node *) parent,
 			(struct dom_node *) child,
@@ -437,6 +606,8 @@ static hubbub_error remove_child(void *parser, void *parent, void *child,
 	dom_hubbub_parser *dom_parser = (dom_hubbub_parser *) parser;
 	dom_exception err;
 
+	pend_flush((dom_hubbub_parser *) parser);
+
 	err = dom_node_remove_child((struct dom_node *) parent,
