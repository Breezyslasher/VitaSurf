--- a/bindings/hubbub/parser.c
+++ b/bindings/hubbub/parser.c
@@ -57,8 +57,98 @@ struct dom_hubbub_parser {
 	bool fragment;		/**< parsing for innerHTML and the like,
 				     which leaves shadow root templates as
 				     templates (VitaSurf) */
+
+	/*
+	 * Text the parser has appended and not yet put in the tree
+	 * (VitaSurf). The HTML standard's parser appends characters to
+	 * the Text node already last in their parent; hubbub gives each
+	 * run of characters a node of its own, cut at every '<' and '&',
+	 * so a paragraph with an entity was three nodes and its
+	 * firstChild.data a piece of its text, and a 836 KB inline JSON
+	 * script was 24,000 nodes whose textContent took six billion
+	 * instructions to put back together. Runs for the same parent are
+	 * gathered here and go in as one node, or onto the Text node that
+	 * was last there, before anything else touches the tree.
+	 */
+	bool pending;
+	struct dom_node *pend_parent;	/**< where it goes, a ref */
+	struct dom_node *pend_node;	/**< the first run's node, a ref */
+	struct dom_node *pend_into;	/**< a Text node it extends, a ref */
+	bool pend_grown;		/**< more than the first run */
+	uint8_t *pend_buf;
+	size_t pend_len, pend_cap;
 };
 
+static bool pend_add(dom_hubbub_parser *p, const uint8_t *data, size_t len)
+{
+	if (p->pend_len + len > p->pend_cap) {
+		size_t cap = p->pend_cap == 0 ? 256 : p->pend_cap;
+		uint8_t *b;
+
+		while (cap < p->pend_len + len)
+			cap *= 2;
+		b = realloc(p->pend_buf, cap);
+		if (b == NULL)
+			return false;
+		p->pend_buf = b;
+		p->pend_cap = cap;
+	}
+	memcpy(p->pend_buf + p->pend_len, data, len);
+	p->pend_len += len;
+	return true;
+}
+
+static void pend_drop(dom_hubbub_parser *p)
+{
+	if (p->pend_parent != NULL)
+		dom_node_unref(p->pend_parent);
+	if (p->pend_node != NULL)
+		dom_node_unref(p->pend_node);
+	if (p->pend_into != NULL)
+		dom_node_unref(p->pend_into);
+	p->pend_parent = p->pend_node = p->pend_into = NULL;
+	p->pending = false;
+	p->pend_grown = false;
+	p->pend_len = 0;
+}
+
+/** Put the text gathered so far in the tree. */
+static void pend_flush(dom_hubbub_parser *p)
+{
+	dom_string *str = NULL;
+	struct dom_node *node = NULL, *appended = NULL;
+
+	if (!p->pending)
+		return;
+	p->pending = false;
+
+	if (p->pend_into == NULL && !p->pend_grown) {
+		/* one run alone: its own node goes in */
+		node = p->pend_node;
+		dom_node_ref(node);
+	} else if (dom_string_create(p->pend_buf, p->pend_len, &str) !=
+			DOM_NO_ERR) {
+		p->msg(DOM_MSG_CRITICAL, p->mctx, "Can't create text");
+	} else if (p->pend_into != NULL) {
+		dom_characterdata_set_data(
+				(struct dom_characterdata *) p->pend_into, str);
+	} else if (dom_document_create_text_node(p->doc, str,
+			(struct dom_text **) (void *) &node) != DOM_NO_ERR) {
+		p->msg(DOM_MSG_CRITICAL, p->mctx,
+				"Can't create the DOM text node");
+		node = NULL;
+	}
+	if (node != NULL) {
+		if (dom_node_append_child(p->pend_parent, node, &appended) ==
+				DOM_NO_ERR && appended != NULL)
+			dom_node_unref(appended);
+		dom_node_unref(node);
+	}
+	if (str != NULL)
+		dom_string_unref(str);
+	pend_drop(p);
+}
+
 /* <template shadowrootmode> elements a document's parser has made
  * (VitaSurf): the client turns each into its parent's shadow root, as
  * the HTML standard's parser does, before the next script runs. */
@@ -397,6 +487,56 @@ static hubbub_error append_child(void *parser, void *parent, void *child,
 {
 	dom_hubbub_parser *dom_parser = (dom_hubbub_parser *) parser;
 	dom_exception err;
+	dom_node_type type;
+
+	if (dom_node_get_node_type((struct dom_node *) child, &type) ==
+			DOM_NO_ERR && type == DOM_TEXT_NODE) {
+		dom_node_internal *c = (dom_node_internal *) child;
+		dom_node_internal *last;
+
+		if (dom_parser->pending && dom_parser->pend_parent == parent) {
+			/* more of the same text */
+			if (c->value != NULL && !pend_add(dom_parser,
+					(const uint8_t *) dom_string_data(
+						c->value),
+					dom_string_byte_length(c->value)))
+				return HUBBUB_NOMEM;
+			dom_parser->pend_grown = true;
+			dom_node_ref((struct dom_node *) child);
+			*result = child;
+			return HUBBUB_OK;
+		}
+		pend_flush(dom_parser);
+
+		/* the text starts here, onto the Text node last in the
+		 * parent if there is one */
+		last = ((dom_node_internal *) parent)->last_child;
+		dom_parser->pend_len = 0;
+		if (last != NULL && last->type == DOM_TEXT_NODE) {
+			if (last->value != NULL && !pend_add(dom_parser,
+					(const uint8_t *) dom_string_data(
+						last->value),
+					dom_string_byte_length(last->value)))
+				return HUBBUB_NOMEM;
+			dom_parser->pend_into = (struct dom_node *) last;
+			dom_node_ref(dom_parser->pend_into);
+		}
+		if (c->value != NULL && !pend_add(dom_parser,
+				(const uint8_t *) dom_string_data(c->value),
+				dom_string_byte_length(c->value))) {
+			pend_drop(dom_parser);
+			return HUBBUB_NOMEM;
+		}
+		dom_parser->pend_parent = (struct dom_node *) parent;
+		dom_node_ref(dom_parser->pend_parent);
+		dom_parser->pend_node = (struct dom_node *) child;
+		dom_node_ref(dom_parser->pend_node);
+		dom_parser->pending = true;
+		dom_node_ref((struct dom_node *) child);
+		*result = child;
+		return HUBBUB_OK;
+	}
+	pend_flush(dom_parser);
 
 	err = dom_node_append_child((struct dom_node *) parent,
 				    (struct dom_node *) child,
@@ -416,6 +556,35 @@ static hubbub_error insert_before(void *parser, void *parent, void *child,
 {
 	dom_hubbub_parser *dom_parser = (dom_hubbub_parser *) parser;
 	dom_exception err;
+	dom_node_type type;
+
+	pend_flush((dom_hubbub_parser *) parser);
+
