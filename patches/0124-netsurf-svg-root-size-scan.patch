+/**
+ * Read the size of a graphic from its root element (VitaSurf).
+ *
+ * A text scan, so that a page of icons does not pay a parse of every
+ * one of them just to learn how big they are. It reads the width and
+ * height, and the viewBox for a graphic that gives neither, which is
+ * the size a browser takes as intrinsic.
+ *
+ * \param c          The SVG content
+ * \param width      Updated with the width in px
+ * \param height     Updated with the height in px
+ * \param ratio_only Updated: true if the size is only an aspect ratio
+ * \return true if the root element was read
+ */
+static bool svg_scan_root_size(struct content *c, int *width, int *height,
+			       bool *ratio_only)
+{
+	const uint8_t *data;
+	size_t size, i;
+	const char *text;
+	float w = 0, h = 0, vb[4] = { 0, 0, 0, 0 };
+	bool have_w = false, have_h = false, have_vb = false;
+
+	data = content__get_source_data(c, &size);
+	if (data == NULL || size == 0) {
+		return false;
+	}
+	text = (const char *) data;
+
+	/* the root element, past the declaration, comments and doctype */
+	for (i = 0; i + 4 < size; i++) {
+		if (text[i] != '<') {
+			continue;
+		}
+		if (text[i + 1] == '?' || text[i + 1] == '!') {
+			continue;
+		}
+		if (strncasecmp(text + i + 1, "svg", 3) != 0) {
+			/* some other element first: not a plain graphic */
+			return false;
+		}
+		if (text[i + 4] != '\0' && !isspace((unsigned char) text[i + 4]) &&
+		    text[i + 4] != '>' && text[i + 4] != '/') {
+			return false;
+		}
+		i += 4;
+		break;
+	}
+	if (i + 1 >= size) {
+		return false;
+	}
+
+	/* its attributes, up to the end of the tag */
+	while (i < size && text[i] != '>') {
+		const char *name, *value;
+		size_t name_len, value_len;
+		char quote;
+
+		while (i < size && isspace((unsigned char) text[i])) {
+			i++;
+		}
+		if (i >= size || text[i] == '>' || text[i] == '/') {
+			break;
+		}
+		name = text + i;
+		while (i < size && text[i] != '=' && text[i] != '>' &&
+		       !isspace((unsigned char) text[i])) {
+			i++;
+		}
+		name_len = (size_t) (text + i - name);
+		while (i < size && isspace((unsigned char) text[i])) {
+			i++;
+		}
+		if (i >= size || text[i] != '=') {
+			continue;
+		}
+		i++;
+		while (i < size && isspace((unsigned char) text[i])) {
+			i++;
+		}
+		if (i >= size) {
+			break;
+		}
+		quote = text[i];
+		if (quote != '"' && quote != '\'') {
+			return false;
+		}
+		i++;
+		value = text + i;
+		while (i < size && text[i] != quote) {
+			i++;
+		}
+		if (i >= size) {
+			return false;
+		}
+		value_len = (size_t) (text + i - value);
+		i++;
+
+		if (name_len == 5 &&
+		    strncasecmp(name, "width", 5) == 0) {
+			have_w = svg_scan_length(value, value_len, &w);
+		} else if (name_len == 6 &&
+			   strncasecmp(name, "height", 6) == 0) {
+			have_h = svg_scan_length(value, value_len, &h);
+		} else if (name_len == 7 &&
+			   strncasecmp(name, "viewBox", 7) == 0) {
+			char box[128];
+			char *p;
+			int n;
+
+			if (value_len >= sizeof(box)) {
+				continue;
+			}
+			memcpy(box, value, value_len);
+			box[value_len] = '\0';
+			for (p = box; *p != '\0'; p++) {
+				if (*p == ',') {
+					*p = ' ';
+				}
+			}
+			p = box;
+			for (n = 0; n < 4; n++) {
+				char *end = NULL;
+				double v = strtod(p, &end);
+
+				if (end == p) {
+					break;
+				}
+				vb[n] = (float) v;
+				p = end;
+			}
+			have_vb = (n == 4) && vb[2] > 0 && vb[3] > 0;
+		}
+	}
+
+	*ratio_only = false;
+	if (have_w && have_h) {
+		*width = (int) w;
+		*height = (int) h;
+	} else if (have_vb) {
+		/* the viewBox gives the shape, and the size where the
+		 * graphic names neither side */
+		if (have_w) {
+			*width = (int) w;
+			*height = (int) (w * vb[3] / vb[2]);
+		} else if (have_h) {
+			*height = (int) h;
+			*width = (int) (h * vb[2] / vb[3]);
+		} else {
+			*width = (int) vb[2];
+			*height = (int) vb[3];
+			*ratio_only = true;
+		}
+	} else {
+		return false;
+	}
+
+	return *width > 0 && *height > 0;
+}
