+/**
+ * The length an attribute of the root element gives, in CSS pixels.
+ *
+ * Only the absolute units, as libsvgtiny reads them: a percentage is
+ * of a viewport the graphic may not have, so it counts as no length.
+ *
+ * \param value  Attribute value
+ * \param len    Its length in bytes
+ * \param out    Updated with the length on success
+ * \return true if the value names an absolute length
+ */
+static bool svg_scan_length(const char *value, size_t len, float *out)
+{
+	static const struct { const char *unit; float px; } units[] = {
+		{ "px", 1.0f },  { "pt", 1.25f },    { "pc", 15.0f },
+		{ "mm", 3.543307f }, { "cm", 35.43307f }, { "in", 90.0f },
+		{ "em", 20.0f }, { "ex", 10.0f }
+	};
+	char text[64];
+	char *end = NULL;
+	double number;
+	size_t i, unit;
+
+	while (len > 0 && isspace((unsigned char) *value)) {
+		value++;
+		len--;
+	}
+	while (len > 0 && isspace((unsigned char) value[len - 1])) {
+		len--;
+	}
+	if (len == 0 || len >= sizeof(text)) {
+		return false;
+	}
+	memcpy(text, value, len);
+	text[len] = '\0';
+
+	number = strtod(text, &end);
+	if (end == text) {
+		return false;
+	}
+	while (*end != '\0' && isspace((unsigned char) *end)) {
+		end++;
+	}
+	if (*end == '\0') {
+		*out = (float) number;
+		return true;
+	}
+	unit = strlen(end);
+	for (i = 0; i < sizeof(units) / sizeof(units[0]); i++) {
+		if (unit == 2 && strncasecmp(end, units[i].unit, 2) == 0) {
+			*out = (float) number * units[i].px;
+			return true;
+		}
+	}
+	/* a percentage, or a unit nothing here knows */
+	return false;
+}
+
