+	/*
+	 * The graphic's own size, which layout takes as the intrinsic
+	 * size of an <img> of it, is read from the root element without
+	 * parsing the graphic (VitaSurf). It used to be whatever the
+	 * last reformat parsed at, so an <img> with only a height took
+	 * its width from the box it had before the graphic arrived;
+	 * parsing here instead cost a second pass over every graphic on
+	 * the page, which on the Vita is half a second each. Anything
+	 * the scan cannot read falls back to that parse.
+	 */
+	if (svg_scan_root_size(c, &c->width, &c->height, &c->ratio_only) ==
+			false) {
+		svg_parse_at(svg, 0, 0);
+		c->width = svg->diagram->width;
+		c->height = svg->diagram->height;
+		c->ratio_only = svg->diagram->ratio_only;
+	}
 
 	content_set_ready(c);
 	content_set_done(c);
