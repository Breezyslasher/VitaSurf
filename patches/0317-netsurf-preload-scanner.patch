+/**
+ * Find an object a preload started or can stand in for (VitaSurf).
+ *
+ * A document fetches ahead of its parser while the parser waits on a
+ * script. The retrieval the parser makes when it reaches the element
+ * then joins that fetch, which it would not do with the cache off,
+ * where every fetch is forced, nor for an object not yet fresh.
+ *
+ * \param url      URL asked for, without its fragment
+ * \param preload  Whether this is a preload asking whether anything
+ *                 already has the URL in hand
+ * \return the object, or NULL
+ */
+static llcache_object *llcache_preload_find(nsurl *url, bool preload)
+{
+	llcache_object *lists[2] = {
+		llcache->uncached_objects, llcache->cached_objects
+	};
+	llcache_object *obj;
+	unsigned int i;
+
+	for (i = 0; i != 2; i++) {
+		for (obj = lists[i]; obj != NULL; obj = obj->next) {
+			if (obj->users == NULL || obj->failed ||
+			    obj->fetch.post != NULL) {
+				continue;
+			}
+			if (obj->preload_url != NULL &&
+			    nsurl_compare(obj->preload_url, url,
+					  NSURL_COMPLETE)) {
+				return obj;
+			}
+			if (preload && nsurl_compare(obj->url, url,
+						     NSURL_COMPLETE)) {
+				return obj;
+			}
+		}
+	}
+	return NULL;
+}
