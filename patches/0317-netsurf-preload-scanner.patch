+			started = dom_string_byte_length(text) > 0;
+			dom_string_unref(text);
+		}
+		if (started) {
+			(void) dom_html_script_element_set_flags(script,
+				flags | DOM_HTML_SCRIPT_ELEMENT_FLAG_ALREADY_STARTED);
+		}
+	}
+
