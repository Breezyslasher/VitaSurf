+
+/**
+ * \file
+ * Fetching ahead of a paused parser (VitaSurf).
+ *
+ * The parser stops at a script it has to fetch, or at one waiting for
+ * the stylesheets before it, and reads no further until the script has
+ * run. Whatever the document names after that point is not asked for
+ * until then, so a page with its scripts one after another fetched them
+ * one after another. A browser runs a second, cheap tokenizer over the
+ * rest of the document while its parser waits, and starts the fetches
+ * that will be wanted; this is that.
+ *
+ * The scanner follows the document as it arrives, whether the parser
+ * is paused or not, so that it knows at every point whether it is in
+ * markup, a comment or the text of an element such as an inline
+ * script, whose "<script src" is a string and not a tag. It starts
+ * fetches only while the parser is paused. Each is an llcache handle
+ * held until the parse ends; the parser's own retrieval of the same URL
+ * joins it (LLCACHE_RETRIEVE_PRELOAD), cache or no cache, and receives
+ * what has arrived so far as though it had asked first.
+ *
+ * It fetches what the parser would: linked stylesheets (and those
+ * preloaded as a style), external scripts and module preloads. Not
+ * images, which are fetched when the boxes are built, and not what it
+ * cannot read with certainty -- an attribute with a character
+ * reference it does not know -- which is left to the parser.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "utils/log.h"
+#include "utils/nsurl.h"
+#include "utils/nsoption.h"
+#include "utils/utils.h"
+#include "content/content_protected.h"
+#include "content/llcache.h"
+
+#include "html/private.h"
+#include "html/preload.h"
+
+/** Most fetches one document starts ahead of its parser */
+#define PRELOAD_MAX 32
+/** Longest attribute value read */
+#define PRELOAD_VALUE_MAX 2048
+
+struct html_preload {
+	size_t offset;		/**< scanned up to here */
+	/** inside the text of this element, awaiting its end tag, or "" */
+	char raw_end[12];
+	bool stopped;		/**< a plaintext element: nothing follows */
+	bool base_seen;		/**< the scanner met a base with an href */
+	nsurl *base;		/**< URL that base gives, or NULL */
+	unsigned int count;	/**< fetches started */
+	llcache_handle *handles[PRELOAD_MAX];
+};
+
+/** An attribute value, as it stands in the source */
+struct preload_attr {
+	const char *v;
+	size_t len;
+	bool present;
+};
+
+/** The attributes of a start tag the scanner reads */
+struct preload_tag {
+	struct preload_attr rel, href, src, as, type, media, disabled;
+};
+
+
+static nserror preload_cb(llcache_handle *handle, const llcache_event *event,
+			  void *pw)
+{
+	/* nothing to do: the parser's retrieval takes the data up */
+	(void) handle;
+	(void) event;
+	(void) pw;
+	return NSERROR_OK;
+}
+
+static bool is_space(char c)
+{
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f';
+}
+
+static bool is_alpha(char c)
+{
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+static bool is_alnum(char c)
+{
+	return is_alpha(c) || (c >= '0' && c <= '9');
+}
+
+/** Find needle, ASCII case-insensitively, in [p, end) */
+static const char *find_ci(const char *p, const char *end, const char *needle)
+{
+	size_t n = strlen(needle);
+
+	for (; p + n <= end; p++) {
+		if (strncasecmp(p, needle, n) == 0)
+			return p;
+	}
+	return NULL;
+}
+
+/**
+ * Decode an attribute value's character references into out.
+ *
+ * \return the length, or -1 for a value to leave to the parser
+ */
+static int decode_value(const struct preload_attr *a, char *out)
+{
+	const char *p = a->v, *end = a->v + a->len;
+	int n = 0;
+
+	while (p < end) {
+		char c = *p;
+
+		if (n >= PRELOAD_VALUE_MAX - 1)
+			return -1;
+		if (c != '&') {
+			out[n++] = c;
+			p++;
+			continue;
+		}
+		if (p + 1 < end && p[1] == '#') {
+			const char *q = p + 2;
+			unsigned long cp = 0;
+			bool hex = false, any = false;
+
+			if (q < end && (*q == 'x' || *q == 'X')) {
+				hex = true;
+				q++;
+			}
+			for (; q < end && cp < 0x110000; q++) {
+				char d = *q;
+
+				if (d >= '0' && d <= '9')
+					cp = cp * (hex ? 16 : 10) + (d - '0');
+				else if (hex && d >= 'a' && d <= 'f')
+					cp = cp * 16 + (d - 'a' + 10);
+				else if (hex && d >= 'A' && d <= 'F')
+					cp = cp * 16 + (d - 'A' + 10);
+				else
+					break;
+				any = true;
+			}
+			if (!any || cp < 0x20 || cp > 0x7e)
+				return -1;
+			if (q < end && *q == ';')
+				q++;
+			out[n++] = (char) cp;
+			p = q;
+			continue;
+		}
+		{
+			/* a named reference */
+			const char *q = p + 1;
+			size_t len;
+			char d = 0;
+
+			while (q < end && is_alnum(*q))
+				q++;
+			len = q - (p + 1);
+			if (len == 0) {
+				/* no name: a plain ampersand */
+				out[n++] = '&';
+				p++;
+				continue;
+			}
+			if (len == 3 && strncmp(p + 1, "amp", 3) == 0)
+				d = '&';
+			else if (len == 2 && strncmp(p + 1, "lt", 2) == 0)
+				d = '<';
+			else if (len == 2 && strncmp(p + 1, "gt", 2) == 0)
+				d = '>';
+			else if (len == 4 && strncmp(p + 1, "quot", 4) == 0)
+				d = '"';
+			else if (len == 4 && strncmp(p + 1, "apos", 4) == 0 &&
+				 q < end && *q == ';')
+				d = '\'';
+
+			if (q < end && *q == ';') {
+				if (d == 0)
+					return -1;
+				out[n++] = d;
+				p = q + 1;
+			} else if (q < end && *q == '=') {
+				/* "&name=" in an attribute is never a
+				 * reference: a query string */
+				out[n++] = '&';
+				p++;
+			} else if (d != 0) {
+				out[n++] = d;
+				p = q;
+			} else {
+				/*
+				 * "&name" and no semicolon: a reference only
+				 * when name is one of the legacy entities.
+				 * Which it is not usually is, "&v2" say, but
+				 * the list is long; leave it to the parser.
+				 */
+				return -1;
+			}
+		}
+	}
+	out[n] = '\0';
+	return n;
+}
+
+/** Whether a whitespace separated list holds a token */
+static bool has_token(const struct preload_attr *a, const char *token)
+{
+	size_t tl = strlen(token);
+	const char *p = a->v, *end = a->v + a->len;
+
+	while (p < end) {
+		const char *s;
+
+		while (p < end && is_space(*p))
+			p++;
+		s = p;
+		while (p < end && !is_space(*p))
+			p++;
+		if ((size_t)(p - s) == tl && strncasecmp(s, token, tl) == 0)
+			return true;
+	}
+	return false;
+}
+
+static bool value_is(const struct preload_attr *a, const char *s)
+{
+	return a->len == strlen(s) && strncasecmp(a->v, s, a->len) == 0;
+}
+
+/**
+ * Start fetching an attribute's URL.
+ */
+static void preload_fetch(html_content *c, struct html_preload *pl,
+			  const struct preload_attr *a, const char *kind)
+{
+	char value[PRELOAD_VALUE_MAX];
+	nsurl *url;
+	lwc_string *scheme;
+	llcache_handle *h = NULL;
+	nserror err;
+	bool web;
+	int len;
+	int i;
+
+	if (pl->count == PRELOAD_MAX)
+		return;
+	len = decode_value(a, value);
+	if (len <= 0)
+		return;
+	/* bytes of another encoding would be read as UTF-8 here, and
+	 * not as the parser reads them */
+	for (i = 0; i != len; i++) {
+		if ((unsigned char) value[i] >= 0x80 &&
+		    (c->encoding == NULL ||
+		     strcasecmp(c->encoding, "UTF-8") != 0))
+			return;
+	}
+
+	if (nsurl_join(pl->base != NULL ? pl->base : c->base_url, value,
+		       &url) != NSERROR_OK)
+		return;
+
+	/* only what goes over the network is worth starting early */
+	scheme = nsurl_get_component(url, NSURL_SCHEME);
+	web = scheme != NULL &&
+		(lwc_string_data(scheme)[0] == 'h' ||
+		 lwc_string_data(scheme)[0] == 'H') &&
+		(lwc_string_length(scheme) == 4 ||
+		 lwc_string_length(scheme) == 5);
+	if (scheme != NULL)
+		lwc_string_unref(scheme);
+	if (!web) {
+		nsurl_unref(url);
+		return;
+	}
+
+	err = llcache_handle_retrieve(url, LLCACHE_RETRIEVE_PRELOAD,
+				      content_get_url(&c->base), NULL,
+				      preload_cb, NULL, &h);
+	if (err == NSERROR_OK && h != NULL) {
+		pl->handles[pl->count++] = h;
+		vita_log("preload: %s %s", kind, nsurl_access(url));
+	}
+	nsurl_unref(url);
+}
+
+/**
+ * Act on a start tag the scanner has read.
+ */
+static void preload_tag(html_content *c, struct html_preload *pl,
+			const char *name, size_t nlen,
+			const struct preload_tag *t, bool fetch)
+{
+	if (nlen == 4 && strncasecmp(name, "base", 4) == 0) {
+		char value[PRELOAD_VALUE_MAX];
+
+		if (!t->href.present || pl->base_seen)
+			return;
+		pl->base_seen = true;
+		/* one the parser has met already is in base_url */
+		if (!nsurl_compare(c->base_url, content_get_url(&c->base),
+				   NSURL_COMPLETE))
+			return;
+		if (decode_value(&t->href, value) > 0) {
+			(void) nsurl_join(c->base_url, value, &pl->base);
+		}
+		return;
+	}
+	if (!fetch)
+		return;
+
+	if (nlen == 6 && strncasecmp(name, "script", 6) == 0) {
+		if (t->src.present)
+			preload_fetch(c, pl, &t->src, "script");
+		return;
+	}
+	if (nlen == 4 && strncasecmp(name, "link", 4) == 0) {
+		if (!t->rel.present || !t->href.present || t->disabled.present)
+			return;
+		/* as html_process_inserted_link has it */
+		if (has_token(&t->rel, "modulepreload") ||
+		    (has_token(&t->rel, "preload") && t->as.present &&
+		     value_is(&t->as, "script"))) {
+			preload_fetch(c, pl, &t->href, "module");
+			return;
+		}
+		/* as html_css_process_link has it */
+		if (has_token(&t->rel, "alternate"))
+			return;
+		if (!has_token(&t->rel, "stylesheet") &&
+		    !(has_token(&t->rel, "preload") && t->as.present &&
+		      value_is(&t->as, "style")))
+			return;
+		if (nsoption_bool(author_level_css) == false)
+			return;
+		if (t->type.present && !value_is(&t->type, "text/css"))
+			return;
+		/* a sheet for print is fetched all the same, but it
+		 * holds nothing up and need not go first */
+		if (t->media.present && value_is(&t->media, "print"))
+			return;
+		preload_fetch(c, pl, &t->href, "stylesheet");
+	}
+}
+
+/**
+ * The element whose text is skipped to its end tag, if name is one.
+ */
+static const char *raw_text_element(const char *name, size_t nlen)
+{
+	static const char *const raw[] = {
+		"script", "style", "textarea", "title", "xmp", "iframe",
+		"noembed", "noframes", "template", "svg", "math"
+	};
+	unsigned int i;
+
+	for (i = 0; i != sizeof(raw) / sizeof(raw[0]); i++) {
+		if (nlen == strlen(raw[i]) &&
+		    strncasecmp(name, raw[i], nlen) == 0)
+			return raw[i];
+	}
+	/* scripting is on whenever there is a scanner */
+	if (nlen == 8 && strncasecmp(name, "noscript", 8) == 0)
+		return "noscript";
+	return NULL;
+}
+
+/**
+ * Read a start tag from p, which is just past the "<" and at its name.
+ *
+ * \return where the tag ends, just past its ">", or NULL when the
+ *         data ends first
+ */
+static const char *read_tag(const char *p, const char *end,
+			    const char **name, size_t *nlen,
+			    struct preload_tag *t, bool *self_closing)
+{
+	*name = p;
+	while (p < end && !is_space(*p) && *p != '/' && *p != '>')
+		p++;
+	*nlen = p - *name;
+	memset(t, 0, sizeof(*t));
+	*self_closing = false;
+
+	while (p < end) {
+		const char *an;
+		size_t alen;
+		struct preload_attr *a = NULL;
+		struct preload_attr val = { NULL, 0, true };
+
+		while (p < end && (is_space(*p) || *p == '/')) {
+			*self_closing = (*p == '/');
+			p++;
+		}
+		if (p >= end)
+			return NULL;
+		if (*p == '>')
+			return p + 1;
+		*self_closing = false;
+
+		an = p;
+		/* an attribute name may start with "=" */
+		p++;
+		while (p < end && !is_space(*p) && *p != '/' && *p != '>' &&
+		       *p != '=')
+			p++;
+		alen = p - an;
+		while (p < end && is_space(*p))
+			p++;
+		if (p < end && *p == '=') {
+			p++;
+			while (p < end && is_space(*p))
+				p++;
+			if (p >= end)
+				return NULL;
+			if (*p == '"' || *p == '\'') {
+				const char *q = memchr(p + 1, *p, end - p - 1);
+
+				if (q == NULL)
+					return NULL;
+				val.v = p + 1;
+				val.len = q - p - 1;
+				p = q + 1;
+			} else {
+				val.v = p;
+				while (p < end && !is_space(*p) && *p != '>')
+					p++;
+				val.len = p - val.v;
+			}
+		} else {
+			val.v = an + alen;
+			val.len = 0;
+		}
+
+#define ATTR(field) \
+		if (alen == sizeof(#field) - 1 && \
+		    strncasecmp(an, #field, alen) == 0) \
+			a = &t->field;
+		ATTR(rel) ATTR(href) ATTR(src) ATTR(as) ATTR(type)
+		ATTR(media) ATTR(disabled)
+#undef ATTR
+		/* the first of a name counts */
+		if (a != NULL && !a->present)
+			*a = val;
+	}
+	return NULL;
+}
+
+/* exported interface documented in html/preload.h */
+void html_preload_scan(html_content *c, bool fetch)
+{
+	struct html_preload *pl = c->preload;
+	const char *data, *p, *end;
+	size_t size;
+
+	if (!c->enable_scripting || c->parse_completed || c->aborted)
+		return;
+	if (pl == NULL) {
+		pl = calloc(1, sizeof(*pl));
+		if (pl == NULL)
+			return;
+		c->preload = pl;
+	}
+	if (pl->stopped)
+		return;
+	data = (const char *) content__get_source_data(&c->base, &size);
+	if (data == NULL || size <= pl->offset)
+		return;
+	/* a two-byte encoding has none of the markup in single bytes */
+	if (c->encoding != NULL && (strstr(c->encoding, "16") != NULL ||
+				    strstr(c->encoding, "32") != NULL))
+		return;
+
+	p = data + pl->offset;
+	end = data + size;
+	while (p < end) {
+		const char *lt, *after;
+		const char *name;
+		size_t nlen;
+		struct preload_tag t;
+		bool self_closing;
+
+		if (pl->raw_end[0] != '\0') {
+			char close[16];
+			const char *q;
+			size_t clen;
+
+			clen = (size_t) snprintf(close, sizeof(close), "</%s",
+						 pl->raw_end);
+			q = find_ci(p, end, close);
+			/* "</scripts" does not end a script */
+			while (q != NULL && q + clen < end &&
+			       is_alnum(q[clen]))
+				q = find_ci(q + 1, end, close);
+			if (q != NULL && q + clen == end) {
+				/* what follows the name is still to come */
+				p = q;
+				break;
+			}
+			if (q == NULL) {
+				/* the end tag may be cut in two */
+				p = (size_t)(end - p) > clen ?
+					end - clen : p;
+				break;
+			}
+			pl->raw_end[0] = '\0';
+			p = q + clen;
+			continue;
+		}
+
+		lt = memchr(p, '<', end - p);
+		if (lt == NULL) {
+			p = end;
+			break;
+		}
+		p = lt;
+		if (end - p < 4) {
+			break;
+		}
+		if (strncmp(p, "<!--", 4) == 0) {
+			const char *q = find_ci(p + 4, end, "-->");
+
+			if (q == NULL)
+				break;
+			p = q + 3;
+			continue;
+		}
+		if (p[1] == '!' || p[1] == '?' || p[1] == '/') {
+			const char *q = memchr(p, '>', end - p);
+
+			if (q == NULL)
+				break;
+			p = q + 1;
+			continue;
+		}
+		if (!is_alpha(p[1])) {
+			p++;
+			continue;
+		}
+
+		after = read_tag(p + 1, end, &name, &nlen, &t, &self_closing);
+		if (after == NULL)
+			break;
+		preload_tag(c, pl, name, nlen, &t, fetch);
+		p = after;
+
+		if (nlen == 9 && strncasecmp(name, "plaintext", 9) == 0) {
+			pl->stopped = true;
+			break;
+		}
+		{
+			const char *raw = raw_text_element(name, nlen);
+
+			/* the slash means something only in svg and math */
+			if (raw != NULL && !(self_closing &&
+					     (strcmp(raw, "svg") == 0 ||
+					      strcmp(raw, "math") == 0)))
+				strcpy(pl->raw_end, raw);
+		}
+	}
+	pl->offset = p - data;
+}
+
+/* exported interface documented in html/preload.h */
+void html_preload_restart(html_content *c)
+{
+	struct html_preload *pl = c->preload;
+
+	if (pl == NULL)
+		return;
+	pl->offset = 0;
+	pl->raw_end[0] = '\0';
+	pl->stopped = false;
+	pl->base_seen = false;
+	if (pl->base != NULL) {
+		nsurl_unref(pl->base);
+		pl->base = NULL;
+	}
+}
+
+/* exported interface documented in html/preload.h */
+void html_preload_free(html_content *c)
+{
+	struct html_preload *pl = c->preload;
+	unsigned int i;
+
+	if (pl == NULL)
+		return;
+	c->preload = NULL;
+	for (i = 0; i != pl->count; i++) {
+		llcache_handle_release(pl->handles[i]);
+	}
+	if (pl->base != NULL) {
+		nsurl_unref(pl->base);
+	}
+	free(pl);
+}
