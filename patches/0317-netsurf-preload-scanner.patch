+/**
+ * Mark a script element the parser hands over as started, so that a
+ * copy of it put in the document does not run it again (VitaSurf).
+ */
+static void script_mark_started(dom_node *node)
+{
+	dom_html_element_type tag;
+	dom_html_script_element_flags flags;
+
+	if (dom_html_element_get_tag_type(node, &tag) == DOM_NO_ERR &&
+	    tag == DOM_HTML_ELEMENT_TYPE_SCRIPT &&
+	    dom_html_script_element_get_flags(
+		    (dom_html_script_element *) node, &flags) == DOM_NO_ERR) {
+		(void) dom_html_script_element_set_flags(
+			(dom_html_script_element *) node,
+			flags | DOM_HTML_SCRIPT_ELEMENT_FLAG_ALREADY_STARTED);
+	}
+}
+
+/**
+ * Whether a script element is inside a template (VitaSurf).
+ *
+ * What a template holds is inert until a script puts a copy of it in
+ * the document: its scripts are neither fetched nor run. The parser
+ * here puts a template's children in the document itself, where the
+ * prelude takes them out into the content fragment only once a script
+ * asks, so the parser ran every script in every template as it read it.
+ */
+static bool script_in_template(dom_node *node)
+{
+	dom_node *n = NULL, *next = NULL;
+	bool inside = false;
+
+	if (dom_node_get_parent_node(node, &n) != DOM_NO_ERR)
+		return false;
+	while (n != NULL && !inside) {
+		dom_node_type type;
+		dom_string *name = NULL;
+
+		if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE &&
+		    dom_node_get_node_name(n, &name) == DOM_NO_ERR &&
+		    name != NULL) {
+			inside = dom_string_byte_length(name) == 8 &&
+				strncasecmp(dom_string_data(name),
+					    "template", 8) == 0;
+			dom_string_unref(name);
+		}
+		if (dom_node_get_parent_node(n, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(n);
+		n = next;
+	}
+	if (n != NULL)
+		dom_node_unref(n);
+	return inside;
+}
