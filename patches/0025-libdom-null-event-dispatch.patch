@@ -31,6 +31,26 @@ dom_exception __dom_dispatch_node_change_event(dom_document *doc,
 	dom_string *type = NULL;
 	dom_exception err;
 
+	/*
+	 * VitaSurf: there is nothing to dispatch without both of these, and
+	 * callers here supply either from a node field that can be empty.
+	 *
+	 * The document is read for the memoised event name, and a node made
+	 * outside any document -- a doctype is one -- has no owner.
+	 *
+	 * The target is worse: dispatching reads its vtable through
+	 * dom_event_target_dispatch_event, which is inlined here, so a null
+	 * one faults inside this function rather than in the call. That is
+	 * the crash a dump pinned to "ldr r3, [r4, #0]" with r4 zero, r4
+	 * being this argument. Callers pass an attribute's element or a
+	 * node's parent, and both are absent for a detached node.
+	 */
+	if (doc == NULL || et == NULL) {
+		if (success != NULL)
+			*success = true;
+		return DOM_NO_ERR;
+	}
+
 	err = _dom_mutation_event_create(&evt);
 	if (err != DOM_NO_ERR)
 		return err;
