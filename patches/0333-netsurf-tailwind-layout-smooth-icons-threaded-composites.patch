+/** Flatten a path into subpaths of points, in device coordinates. */
+static bool fb_aa_flatten(const float *p, unsigned int n,
+		const float t[6], int *npts, int *nsub)
+{
+	unsigned int i = 0;
+	int pc = 0, sc = 0;
+	float cx = 0, cy = 0;
+
+#define AX(x, y) (t[0] * (x) + t[2] * (y) + t[4])
+#define AY(x, y) (t[1] * (x) + t[3] * (y) + t[5])
+	while (i < n) {
+		switch ((int)p[i]) {
+		case PLOTTER_PATH_MOVE:
+			if (i + 2 >= n || sc >= FB_AA_MAX_POINTS ||
+			    pc >= FB_AA_MAX_POINTS)
+				return false;
+			fb_aa_sub_start[sc] = pc;
+			fb_aa_sub_closed[sc] = false;
+			sc++;
+			cx = AX(p[i + 1], p[i + 2]);
+			cy = AY(p[i + 1], p[i + 2]);
+			fb_aa_pts[pc].x = cx;
+			fb_aa_pts[pc].y = cy;
+			pc++;
+			i += 3;
+			break;
+		case PLOTTER_PATH_LINE:
+			if (i + 2 >= n || sc == 0 || pc >= FB_AA_MAX_POINTS)
+				return false;
+			cx = AX(p[i + 1], p[i + 2]);
+			cy = AY(p[i + 1], p[i + 2]);
+			fb_aa_pts[pc].x = cx;
+			fb_aa_pts[pc].y = cy;
+			pc++;
+			i += 3;
+			break;
+		case PLOTTER_PATH_BEZIER: {
+			float x1, y1, x2, y2, x3, y3, len;
+			int k, steps;
+
+			if (i + 6 >= n || sc == 0)
+				return false;
+			x1 = AX(p[i + 1], p[i + 2]);
+			y1 = AY(p[i + 1], p[i + 2]);
+			x2 = AX(p[i + 3], p[i + 4]);
+			y2 = AY(p[i + 3], p[i + 4]);
+			x3 = AX(p[i + 5], p[i + 6]);
+			y3 = AY(p[i + 5], p[i + 6]);
