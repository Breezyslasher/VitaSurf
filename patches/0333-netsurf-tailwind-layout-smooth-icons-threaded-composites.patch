+/** Add an exact span [xa, xb) of one sub-row's weight to a row. */
+static void fb_aa_span(float *row, int w, float xa, float xb, float wt)
+{
+	int i0, i1, i;
+
+	if (xa < 0) xa = 0;
+	if (xb > w) xb = w;
+	if (xb <= xa)
+		return;
+	i0 = (int)xa;
+	i1 = (int)xb;
+	if (i0 == i1) {
+		row[i0] += (xb - xa) * wt;
+		return;
+	}
+	row[i0] += (i0 + 1 - xa) * wt;
+	for (i = i0 + 1; i < i1 && i < w; i++)
+		row[i] += wt;
+	if (i1 < w)
+		row[i1] += (xb - i1) * wt;
+}
+
+/** Cover what the path fills, by the nonzero rule. */
+static bool fb_aa_fill(float *cov, int w, int h, float ox, float oy,
+		int npts, int nsub)
+{
+	int y, k, s;
+
+	if (fb_aa_cross_cap < npts + nsub) {
+		float *c = realloc(fb_aa_cross,
+				(npts + nsub) * sizeof(*c));
+		int *d;
+
+		if (c == NULL)
+			return false;
+		fb_aa_cross = c;
+		d = realloc(fb_aa_dir, (npts + nsub) * sizeof(*d));
+		if (d == NULL)
+			return false;
+		fb_aa_dir = d;
+		fb_aa_cross_cap = npts + nsub;
+	}
+	for (y = 0; y < h; y++) {
+		for (k = 0; k < 4; k++) {
+			float sy = oy + y + (k + 0.5f) / 4;
+			int nc = 0, i, j, wind;
+
+			for (s = 0; s < nsub; s++) {
+				int a, b;
+
+				fb_aa_sub(s, nsub, npts, &a, &b);
+				/* every subpath is filled as closed */
+				for (i = a; i < b; i++) {
+					struct fb_aa_pt p0 = fb_aa_pts[i];
+					struct fb_aa_pt p1 = fb_aa_pts[
+						(i + 1 < b) ? i + 1 : a];
+
+					if ((p0.y <= sy) == (p1.y <= sy))
+						continue;
+					fb_aa_cross[nc] = p0.x + (sy - p0.y) *
+						(p1.x - p0.x) / (p1.y - p0.y);
+					fb_aa_dir[nc] = (p1.y > p0.y) ? 1 : -1;
+					nc++;
+				}
+			}
+			/* a few crossings a row: insertion sort */
+			for (i = 1; i < nc; i++) {
+				float cx = fb_aa_cross[i];
+				int cd = fb_aa_dir[i];
+
+				for (j = i; j > 0 && fb_aa_cross[j - 1] > cx;
+						j--) {
+					fb_aa_cross[j] = fb_aa_cross[j - 1];
+					fb_aa_dir[j] = fb_aa_dir[j - 1];
+				}
+				fb_aa_cross[j] = cx;
+				fb_aa_dir[j] = cd;
+			}
+			wind = 0;
+			for (i = 0; i < nc; i++) {
+				int was = wind;
+
+				wind += fb_aa_dir[i];
+				if (was != 0 && i > 0)
+					fb_aa_span(cov + y * w, w,
+						fb_aa_cross[i - 1] - ox,
+						fb_aa_cross[i] - ox, 0.25f);
+			}
+		}
+	}
+	return true;
+}
+
+/** Plot a coverage buffer in one colour, as alpha. */
+static bool fb_aa_plot(const float *cov, int w, int h, int ox, int oy,
+		nsfb_colour_t colour)
+{
+	unsigned int alpha = (colour >> 24) & 0xff;
+	nsfb_bbox_t loc;
+	int i;
+
+	for (i = 0; i < w * h; i++) {
+		float c = cov[i];
+		unsigned int a;
+
+		if (c <= 0) {
+			fb_aa_px[i] = 0;
+			continue;
+		}
+		if (c > 1)
+			c = 1;
+		a = (unsigned int)(c * alpha + 0.5f);
+		fb_aa_px[i] = (colour & 0x00ffffff) | (a << 24);
+	}
+	loc.x0 = ox;
+	loc.y0 = oy;
+	loc.x1 = ox + w;
+	loc.y1 = oy + h;
+	return nsfb_plot_bitmap(nsfb, &loc, fb_aa_px, w, h, w, true);
+}
+
+/**
+ * Draw a small path smooth.
+ *
+ * \return true if it was drawn, false to leave it to libnsfb
+ */
+static bool fb_aa_path(const plot_style_t *pstyle, const float *p,
+		unsigned int n, const float transform[6])
+{
+	float hw = 0, minx, miny, maxx, maxy;
+	int npts = 0, nsub = 0, i, s, w, h, ox, oy;
+
+	if (!fb_aa_flatten(p, n, transform, &npts, &nsub))
+		return false;
+	if (pstyle->stroke_type != PLOT_OP_TYPE_NONE) {
+		hw = plot_style_fixed_to_float(pstyle->stroke_width) / 2;
+		if (hw < 0.5f)
+			hw = 0.5f;
+	}
+	minx = maxx = fb_aa_pts[0].x;
+	miny = maxy = fb_aa_pts[0].y;
+	for (i = 1; i < npts; i++) {
+		if (fb_aa_pts[i].x < minx) minx = fb_aa_pts[i].x;
+		if (fb_aa_pts[i].x > maxx) maxx = fb_aa_pts[i].x;
+		if (fb_aa_pts[i].y < miny) miny = fb_aa_pts[i].y;
+		if (fb_aa_pts[i].y > maxy) maxy = fb_aa_pts[i].y;
+	}
+	ox = (int)floorf(minx - hw - 1);
+	oy = (int)floorf(miny - hw - 1);
+	w = (int)ceilf(maxx + hw + 1) - ox;
+	h = (int)ceilf(maxy + hw + 1) - oy;
+	if (w <= 0 || h <= 0 || w * h > FB_AA_MAX_AREA)
+		return false;
+
+	if (fb_aa_cap < w * h) {
+		float *c = realloc(fb_aa_cov, w * h * sizeof(*c));
+		nsfb_colour_t *px;
+
+		if (c == NULL)
+			return false;
+		fb_aa_cov = c;
+		px = realloc(fb_aa_px, w * h * sizeof(*px));
+		if (px == NULL)
+			return false;
+		fb_aa_px = px;
+		fb_aa_cap = w * h;
+	}
+
+	if (pstyle->fill_type != PLOT_OP_TYPE_NONE) {
+		memset(fb_aa_cov, 0, w * h * sizeof(*fb_aa_cov));
+		if (!fb_aa_fill(fb_aa_cov, w, h, ox, oy, npts, nsub))
+			return false;
+		fb_aa_plot(fb_aa_cov, w, h, ox, oy,
+				fb_colour(pstyle->fill_colour));
+	}
+	if (pstyle->stroke_type != PLOT_OP_TYPE_NONE) {
+		memset(fb_aa_cov, 0, w * h * sizeof(*fb_aa_cov));
+		for (s = 0; s < nsub; s++) {
+			int a, b;
+
+			fb_aa_sub(s, nsub, npts, &a, &b);
+			if (b - a == 1)
+				/* a dot: a zero-length segment */
+				fb_aa_segment(fb_aa_cov, w, h, ox, oy,
+					fb_aa_pts[a], fb_aa_pts[a], hw);
+			for (i = a; i + 1 < b; i++)
+				fb_aa_segment(fb_aa_cov, w, h, ox, oy,
+					fb_aa_pts[i], fb_aa_pts[i + 1], hw);
+			if (fb_aa_sub_closed[s] && b - a > 2)
+				fb_aa_segment(fb_aa_cov, w, h, ox, oy,
+					fb_aa_pts[b - 1], fb_aa_pts[a], hw);
+		}
+		fb_aa_plot(fb_aa_cov, w, h, ox, oy,
+				fb_colour(pstyle->stroke_colour));
+	}
+	return true;
+}
