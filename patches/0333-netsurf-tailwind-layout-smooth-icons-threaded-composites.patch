+				if (u < 0) u = 0;
+				if (u > 1) u = 1;
+			}
+			ex = px - (a.x + u * dx);
+			ey = py - (a.y + u * dy);
+			d = sqrtf(ex * ex + ey * ey);
+			c = hw + 0.5f - d;
+			if (c > 1) c = 1;
+			if (c > cov[y * w + x])
+				cov[y * w + x] = c;
+		}
+	}
+}
