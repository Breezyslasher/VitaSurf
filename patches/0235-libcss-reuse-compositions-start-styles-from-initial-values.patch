+/*
+ * Composed results kept for reuse (VitaSurf).
+ *
+ * Composing runs every property's compose function, works out the
+ * absolute values and interns the result: some 10,000 instructions an
+ * element natively, and on the Vita a GitHub page spent 874 ms of its
+ * 3.3 s of style selection there. But both inputs are interned, so the
+ * same parent style and the same selected style are the same pointers,
+ * and cousins -- the cells of a table, the rows of a list, the parts of
+ * each card -- ask for the same composition over and over. Composing
+ * reads nothing but the two styles and the unit context, so an answer
+ * found here is the answer composing would give.
+ *
+ * Each entry holds a reference to both inputs and to the result, so no
+ * address in it can be freed and reused for a different style while it
+ * is here. That keeps at most three styles an entry alive past their
+ * time; css_computed_style_compose_flush() lets them go.
+ */
+#define COMPOSE_CACHE_SIZE 128
+
+struct compose_cache_entry {
+	const css_computed_style *parent;
+	const css_computed_style *child;
+	css_computed_style *result;
+	/* the unit context, but for the callback's own state */
+	css_fixed viewport_width;
+	css_fixed viewport_height;
+	css_fixed font_size_default;
+	css_fixed font_size_minimum;
+	css_fixed device_dpi;
+	const css_computed_style *root_style;
+	void *pw;
+	css_unit_len_measure measure;
+};
+
+static struct compose_cache_entry compose_cache[COMPOSE_CACHE_SIZE];
+
+/* how often the cache answered, and how often it could not (VitaSurf) */
+unsigned int css_compose_cache_hits;
+unsigned int css_compose_cache_misses;
+
+static inline uint32_t compose_cache_slot(const css_computed_style *parent,
+		const css_computed_style *child)
+{
+	uint32_t p = (uint32_t) ((uintptr_t) parent >> 4);
+	uint32_t c = (uint32_t) ((uintptr_t) child >> 4);
+
+	return ((p * 0x9e3779b1u) ^ (c * 0x85ebca6bu)) >> 25;
+}
+
+static inline bool compose_cache_same_units(
+		const struct compose_cache_entry *e,
+		const css_unit_ctx *unit_ctx)
+{
+	return e->viewport_width == unit_ctx->viewport_width &&
+		e->viewport_height == unit_ctx->viewport_height &&
+		e->font_size_default == unit_ctx->font_size_default &&
+		e->font_size_minimum == unit_ctx->font_size_minimum &&
+		e->device_dpi == unit_ctx->device_dpi &&
+		e->root_style == unit_ctx->root_style &&
+		e->pw == unit_ctx->pw &&
+		e->measure == unit_ctx->measure;
+}
+
+/* Take a reference to an interned style (VitaSurf) */
+static inline void compose_cache_ref(const css_computed_style *style)
+{
+	if (style != NULL)
+		((css_computed_style *) style)->count++;
+}
+
+static void compose_cache_drop(struct compose_cache_entry *e)
+{
+	if (e->result == NULL)
+		return;
+	if (e->parent != NULL)
+		css_computed_style_destroy((css_computed_style *) e->parent);
+	css_computed_style_destroy((css_computed_style *) e->child);
+	css_computed_style_destroy(e->result);
+	if (e->root_style != NULL)
+		css_computed_style_destroy(
+				(css_computed_style *) e->root_style);
+	memset(e, 0, sizeof(*e));
+}
+
+/* exported: see include/libcss/computed.h (VitaSurf) */
+void css_computed_style_compose_flush(void)
+{
+	size_t i;
+
+	for (i = 0; i < COMPOSE_CACHE_SIZE; i++)
+		compose_cache_drop(&compose_cache[i]);
+}
+
 /**
  * Compose two computed styles
  *
@@ -306,9 +400,30 @@ css_error css_computed_style_compose(
 		css_computed_style **restrict result)
 {
 	css_computed_style *composed;
+	struct compose_cache_entry *e = NULL;
 	css_error error;
 	size_t i;
 
+	/*
+	 * Only interned styles are known by their address: one that is
+	 * not could be freed and its memory handed to another at any
+	 * time (VitaSurf).
+	 */
+	if (child->count != 0 && (parent == NULL || parent->count != 0) &&
+			(unit_ctx->root_style == NULL ||
+			 unit_ctx->root_style->count != 0)) {
+		e = &compose_cache[compose_cache_slot(parent, child)];
+		if (e->result != NULL && e->parent == parent &&
+				e->child == child &&
+				compose_cache_same_units(e, unit_ctx)) {
+			css_compose_cache_hits++;
+			e->result->count++;
+			*result = e->result;
+			return CSS_OK;
+		}
+		css_compose_cache_misses++;
+	}
+
 	/* TODO:
 	 *   Make this function take a composition context, to allow us
 	 *   to avoid the churn of unnecesaraly allocating and freeing
@@ -344,7 +459,29 @@ css_error css_computed_style_compose(
 	}
 
 	*result = composed;
-	return css__arena_intern_style(result);
+	error = css__arena_intern_style(result);
+	if (error != CSS_OK || e == NULL)
+		return error;
+
+	/* Keep it, letting go of whatever held the slot (VitaSurf) */
+	compose_cache_drop(e);
+	compose_cache_ref(parent);
+	compose_cache_ref(child);
+	compose_cache_ref(*result);
+	compose_cache_ref(unit_ctx->root_style);
+	e->parent = parent;
+	e->child = child;
+	e->result = *result;
+	e->viewport_width = unit_ctx->viewport_width;
+	e->viewport_height = unit_ctx->viewport_height;
+	e->font_size_default = unit_ctx->font_size_default;
+	e->font_size_minimum = unit_ctx->font_size_minimum;
+	e->device_dpi = unit_ctx->device_dpi;
+	e->root_style = unit_ctx->root_style;
+	e->pw = unit_ctx->pw;
+	e->measure = unit_ctx->measure;
+
+	return CSS_OK;
 }
 
