+/*
+ * A block with every property that is not inherited already at its
+ * initial value (VitaSurf).
+ *
+ * Finishing a style called set_initial() for each property no rule
+ * had set -- some 157 an element -- and for one that is not
+ * inherited that writes the same constant every time: on the Vita
+ * finishing took 761 ms of a GitHub page's 3.3 s of selection. A new
+ * element's style now starts as a copy of this block, and finishing
+ * skips any property nothing touched, which the copy already holds.
+ * Inherited properties stay zero, which is "inherit", as in a style
+ * fresh from calloc().
+ *
+ * Built once, from the same initial() functions. Should one of them
+ * ever leave a pointer in the style, the block is not used, as the
+ * copies would share it.
+ */
+static struct css_computed_style_i initial_block;
+static int initial_block_state; /* 0 not built, 1 usable, -1 not */
+
+static bool initial_block_ready(css_calculator *calc)
+{
+	css_computed_style *t;
+	css_select_state tmp;
+	uint32_t i;
+	bool ok = true;
+
+	if (initial_block_state != 0)
+		return initial_block_state > 0;
+
+	initial_block_state = -1;
+	if (css__computed_style_create(&t, calc) != CSS_OK)
+		return false;
+
+	memset(&tmp, 0, sizeof(tmp));
+	tmp.computed = t;
+	for (i = 0; i < CSS_N_PROPERTIES; i++) {
+		if (prop_dispatch[i].inherited == false &&
+				prop_dispatch[i].initial(&tmp) != CSS_OK)
+			ok = false;
+	}
+
+	if (t->i.animation_name != NULL || t->i.background_image != NULL ||
+			t->i.filter != NULL ||
+			t->i.list_style_image != NULL ||
+			t->i.mask_image != NULL ||
+			t->content != NULL || t->counter_increment != NULL ||
+			t->counter_reset != NULL || t->cursor != NULL ||
+			t->font_family != NULL || t->quotes != NULL ||
+			t->grid_auto_columns != NULL ||
+			t->grid_auto_rows != NULL ||
+			t->grid_template_columns != NULL ||
+			t->grid_template_rows != NULL || t->custom != NULL)
+		ok = false;
+
+	if (ok) {
+		initial_block = t->i;
+		initial_block_state = 1;
+	}
+	css_computed_style_destroy(t);
+
+	return ok;
+}
