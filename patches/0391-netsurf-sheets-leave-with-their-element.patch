+/**
+ * Take a sheet out of the cascade, or put it back, when its element has
+ * left the document or come back since last looked (VitaSurf). The page
+ * is styled again when one has.
+ */
+static void html_css_check_connected(html_content *c)
+{
+	unsigned int i;
+	bool changed = false;
+
+	if (!c->css_connect_check)
+		return;
+	c->css_connect_check = false;
+	for (i = STYLESHEET_START; i < c->stylesheet_count; i++) {
+		struct html_stylesheet *s = &c->stylesheets[i];
+		bool gone;
+
+		if (s->node == NULL)
+			continue;
+		gone = !css_node_connected(s->node) &&
+		       !css_adopted_by_document(s->node);
+		if (gone != s->disconnected) {
+			s->disconnected = gone;
+			changed = true;
+		}
+	}
+	if (changed) {
+		c->css_generation++;
+		if (c->select_ctx != NULL) {
+			c->late_css_retries = 0;
+			guit->misc->schedule(0, html_css_late_rebuild, c);
+		}
+	}
+}
+
+static void html_css_check_connected_cb(void *pw)
+{
+	html_css_check_connected(pw);
+}
+
+/* exported function documented in html/css.h */
+void html_css_note_tree_change(html_content *c)
+{
+	if (c->css_connect_check || c->stylesheet_count <= STYLESHEET_START)
+		return;
+	c->css_connect_check = true;
+	guit->misc->schedule(0, html_css_check_connected_cb, c);
+}
+
+/* exported function documented in html/css.h */
+bool html_select_ctx_current(html_content *c)
+{
+	unsigned int i;
+
+	html_css_check_connected(c);
+	if (c->select_ctx == NULL || c->select_ctx_gen != c->css_generation)
+		return false;
+	for (i = STYLESHEET_START; i < c->stylesheet_count; i++) {
+		const struct html_stylesheet *s = &c->stylesheets[i];
+
+		if (s->disconnected || s->node == NULL || s->is_link)
+			continue;
+		if (s->modified || html_css_in_flight(s))
+			return false;
+	}
+	return true;
+}
