+/**
+ * Whether a node is in the document (VitaSurf): its tree's root is the
+ * document, or a shadow root whose host is in it.
+ */
+static bool css_node_connected(dom_node *node)
+{
+	dom_node *n = dom_node_ref(node), *up = NULL;
+	dom_node_type type;
+	bool connected = false;
+
+	for (;;) {
+		dom_element *host = NULL;
+
+		while (dom_node_get_parent_node(n, &up) == DOM_NO_ERR &&
+				up != NULL) {
+			dom_node_unref(n);
+			n = up;
+		}
+		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR)
+			break;
+		if (type == DOM_DOCUMENT_NODE) {
+			connected = true;
+			break;
+		}
+		if (type != DOM_DOCUMENT_FRAGMENT_NODE ||
+		    dom_document_fragment_get_host(
+				(dom_document_fragment *) n, &host) !=
+				DOM_NO_ERR || host == NULL)
+			break;
+		dom_node_unref(n);
+		n = (dom_node *) host;
+	}
+	dom_node_unref(n);
+	return connected;
+}
+
+/**
+ * Whether a STYLE carries the document's adoptedStyleSheets (VitaSurf):
+ * the prelude keeps them in one it never puts in the document, marked
+ * data-adopted="document".
+ */
+static bool css_adopted_by_document(dom_node *node)
+{
+	dom_string *name = NULL, *value = NULL;
+	bool adopted = false;
+
+	if (dom_string_create((const uint8_t *) "data-adopted", 12,
+			&name) != DOM_NO_ERR)
+		return false;
+	if (dom_element_get_attribute(node, name, &value) == DOM_NO_ERR &&
+	    value != NULL) {
+		adopted = dom_string_byte_length(value) == 8 &&
+			memcmp(dom_string_data(value), "document", 8) == 0;
+		dom_string_unref(value);
+	}
+	dom_string_unref(name);
+	return adopted;
+}
