+static css_error bi_parse_extent(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop, bool width)
+{
+	int32_t orig = *ctx;
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+	char buf[96];
+	css_error error;
+
+	if (token == NULL)
+		return CSS_INVALID;
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+	}
+	error = bi_extent(c, vector, ctx, width, buf, sizeof(buf));
+	if (error == CSS_OK)
+		error = bi_emit_extent(c, result, prop, buf);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+}
+
