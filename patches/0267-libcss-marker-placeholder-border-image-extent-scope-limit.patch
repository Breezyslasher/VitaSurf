+css_error css__parse_border_image_width(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return bi_parse_extent(c, vector, ctx, result,
+			CSS_PROP_BORDER_IMAGE_WIDTH, true);
+}
+
+/* exported interface documented in properties.h */
+css_error css__parse_border_image_outset(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return bi_parse_extent(c, vector, ctx, result,
+			CSS_PROP_BORDER_IMAGE_OUTSET, false);
+}
