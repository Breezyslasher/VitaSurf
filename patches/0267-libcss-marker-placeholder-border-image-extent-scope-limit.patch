+/** Whether a trimmed selector is one compound, with no list. */
+static bool scope_compound(const char *s, size_t n)
+{
+	size_t i;
+
+	if (n == 0 || sel_has_combinator(s, n))
+		return false;
+	for (i = 0; i < n; i++)
+		if (s[i] == ',')
+			return false;
+	return true;
+}
+
+/**
+ * Where a pseudo-class goes on one selector of a list: before its
+ * pseudo-element, if it has one, else at its end.
+ */
+static size_t scope_insert_at(const char *s, size_t n)
+{
+	static const char *const legacy[] = {
+		":before", ":after", ":first-line", ":first-letter", NULL
+	};
+	size_t i;
+	int depth = 0, k;
+
+	for (i = 0; i < n; i++) {
+		char c = s[i];
+
+		if (c == '\\') {
+			i++;
+			continue;
+		}
+		if (c == '(' || c == '[')
+			depth++;
+		else if (c == ')' || c == ']')
+			depth--;
+		else if (c == ':' && depth == 0) {
+			if (i + 1 < n && s[i + 1] == ':')
+				return i;
+			for (k = 0; legacy[k] != NULL; k++) {
+				size_t l = strlen(legacy[k]);
+
+				if (sel_prefix(s + i, n - i, legacy[k]) &&
+						(i + l == n ||
+						 !(isalnum((unsigned char)
+							s[i + l]) ||
+						   s[i + l] == '-')))
+					return i;
+			}
+		}
+	}
+	return n;
+}
+
+/**
+ * Put :-vita-scope(root, limit) on each selector of a rule's prelude,
+ * for "@scope (root) to (limit)"; an at-rule's prelude is copied.
+ */
+static void scope_limit_prelude(struct sbuf *b, const char *pre, size_t n,
+		const char *root, size_t rl, const char *limit, size_t ll)
+{
+	const char *it[SEL_MAX_ITEMS];
+	size_t il[SEL_MAX_ITEMS], a = 0;
+	int k, m;
+
+	while (a < n && sel_ws(pre[a]))
+		a++;
+	k = a < n && pre[a] != '@' ?
+			sel_split(pre, n, it, il, SEL_MAX_ITEMS) : -1;
+	if (k <= 0) {
+		sb_put(b, pre, n);
+		return;
+	}
+	for (m = 0; m < k; m++) {
+		size_t at = scope_insert_at(it[m], il[m]);
+
+		if (m > 0)
+			sb_put(b, ", ", 2);
+		sb_put(b, it[m], at);
+		sb_put(b, ":-vita-scope(", 13);
+		sb_put(b, root, rl);
+		sb_put(b, ", ", 2);
+		sb_put(b, limit, ll);
+		sb_put(b, ")", 1);
+		sb_put(b, it[m] + at, il[m] - at);
+	}
+	sb_put(b, " ", 1);
+}
