+/*
+ * Double a table that has grown past its load and refile everything
+ * (VitaSurf).
+ *
+ * Re-inserting keeps each chain in its sorted order, because that is
+ * what _insert_into_chain does. Running out of memory here is not an
+ * error the caller need care about: the table simply stays as it was
+ * and the chains stay longer than they should.
+ */
+static void _grow(css_selector_hash *ctx, hash_t *h)
+{
+	const css_selector **all;
+	hash_entry *old_slots = h->slots;
+	size_t old_n = h->n_slots, count = 0, i;
+	hash_entry *fresh;
+
+	all = malloc(h->n_entries * sizeof(*all));
+	if (all == NULL)
+		return;
+
+	fresh = calloc(old_n * 2, sizeof(hash_entry));
+	if (fresh == NULL) {
+		free(all);
+		return;
+	}
+
+	for (i = 0; i < old_n; i++) {
+		hash_entry *e = &old_slots[i];
+
+		if (e->sel == NULL)
+			continue;
+		for (; e != NULL; e = e->next) {
+			if (count < h->n_entries)
+				all[count++] = e->sel;
+		}
+	}
+
+	h->slots = fresh;
+	h->n_slots = old_n * 2;
+	ctx->hash_size += old_n * sizeof(hash_entry);
+
+	for (i = 0; i < count; i++) {
+		uint32_t slot = _entry_key(h->kind, all[i]) &
+				(h->n_slots - 1);
+
+		if (_insert_into_chain(ctx, &h->slots[slot], all[i]) ==
+				CSS_OK) {
+			continue;
+		}
+
+		/*
+		 * Out of memory part way through. Put the table back
+		 * exactly as it was rather than lose the rules that
+		 * have not been refiled yet: a dropped rule is a page
+		 * that renders wrongly, and a table that did not grow
+		 * is only slower.
+		 */
+		for (i = 0; i < h->n_slots; i++) {
+			hash_entry *e = h->slots[i].next, *n;
+
+			for (; e != NULL; e = n) {
+				n = e->next;
+				free(e);
+				ctx->hash_size -= sizeof(hash_entry);
+			}
+		}
+		free(h->slots);
+		h->slots = old_slots;
+		h->n_slots = old_n;
+		ctx->hash_size -= old_n * sizeof(hash_entry);
+		free(all);
+		return;
+	}
+
+	for (i = 0; i < old_n; i++) {
+		hash_entry *e = old_slots[i].next, *n;
+
+		for (; e != NULL; e = n) {
+			n = e->next;
+			free(e);
+			ctx->hash_size -= sizeof(hash_entry);
+		}
+	}
+	free(old_slots);
+	free(all);
+}
+
+/** File a selector, growing the table if its chains have got long. */
+static css_error _file(css_selector_hash *ctx, hash_t *h,
+		const css_selector *selector, uint32_t key)
+{
+	css_error error = _insert_into_chain(ctx,
+			&h->slots[key & (h->n_slots - 1)], selector);
+
+	if (error != CSS_OK)
+		return error;
+
+	h->n_entries++;
+	if (h->n_entries > h->n_slots * HASH_MAX_PER_SLOT)
+		_grow(ctx, h);
+
+	return CSS_OK;
+}
