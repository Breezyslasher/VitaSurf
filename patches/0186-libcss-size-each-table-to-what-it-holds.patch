+/** What a table files a selector by (VitaSurf). */
+static uint32_t _entry_key(hash_kind kind, const css_selector *selector)
+{
+	lwc_string *name = NULL;
+
+	switch (kind) {
+	case HASH_BY_ID:
+		name = _id_name(selector);
+		break;
+	case HASH_BY_CLASS:
+		name = _class_name(selector);
+		break;
+	case HASH_BY_ELEMENT:
+	default:
+		name = selector->data.qname.name;
+		break;
+	}
+
+	/* every rule in a table has the name that table files by */
+	assert(name != NULL);
+
+	return _hash_name(name);
+}
