+/**
+ * The size a background image should be drawn at (VitaSurf).
+ *
+ * background-size did not exist, so a background was always drawn at
+ * the picture's own size however large the box: a gradient meant to
+ * cover a header was repeated across it instead.
+ */
+static void html_background_size(const struct box *box,
+		const css_unit_ctx *unit_len_ctx,
+		int box_w, int box_h, int *width, int *height)
+{
+	css_fixed hl = 0, vl = 0;
+	css_unit hu = CSS_UNIT_PX, vu = CSS_UNIT_PX;
+	int iw = *width, ih = *height;
+	uint8_t type;
+
+	if (box->style == NULL || iw <= 0 || ih <= 0 ||
+			box_w <= 0 || box_h <= 0) {
+		return;
+	}
+
+	type = css_computed_background_size(box->style, &hl, &hu, &vl, &vu);
+
+	switch (type) {
+	case CSS_BACKGROUND_SIZE_COVER:
+	case CSS_BACKGROUND_SIZE_CONTAIN:
+	{
+		float sx = (float) box_w / iw;
+		float sy = (float) box_h / ih;
+		float f = (type == CSS_BACKGROUND_SIZE_COVER) ?
+				((sx > sy) ? sx : sy) :
+				((sx < sy) ? sx : sy);
+
+		*width = (int) (iw * f);
+		*height = (int) (ih * f);
+		break;
+	}
+	case CSS_BACKGROUND_SIZE_SET:
+	{
+		int w = 0, h = 0;
+
+		if (hu == CSS_UNIT_PCT) {
+			w = (int) (box_w * FIXTOFLT(hl) / 100);
+		} else if (hl != 0) {
+			w = FIXTOINT(css_unit_len2device_px(box->style,
+					unit_len_ctx, hl, hu));
+		}
+		if (vu == CSS_UNIT_PCT) {
+			h = (int) (box_h * FIXTOFLT(vl) / 100);
+		} else if (vl != 0) {
+			h = FIXTOINT(css_unit_len2device_px(box->style,
+					unit_len_ctx, vl, vu));
+		}
+
+		/* a side left as auto follows the other, keeping shape */
+		if (w > 0 && h <= 0) {
+			h = (int) ((float) w * ih / iw);
+		} else if (h > 0 && w <= 0) {
+			w = (int) ((float) h * iw / ih);
+		}
+		if (w > 0 && h > 0) {
+			*width = w;
+			*height = h;
+		}
+		break;
+	}
+	default:
+		break;	/* auto: the picture's own size */
+	}
+}
