+				blob.len = len;
+				blob.flags = CURL_BLOB_COPY;
+				code = curl_easy_setopt(fetch_blank_curl,
+							CURLOPT_CAINFO_BLOB,
+							&blob);
+				free(blob.data);
+				if (code != CURLE_OK) {
+					NSLOG(netsurf, ERROR,
+					      "attempting curl_easy_setopt(CURLOPT_CAINFO_BLOB, ...)");
+					goto curl_easy_setopt_failed;
+				}
+				NSLOG(netsurf, INFO, "ca_bundle: %u bytes loaded",
+				      (unsigned int)len);
+			} else {
+				NSLOG(netsurf, ERROR, "ca_bundle: cannot read '%s'",
+				      nsoption_charp(ca_bundle));
+			}
+		}
+#else
 		SETOPT(CURLOPT_CAINFO, nsoption_charp(ca_bundle));
+#endif
 	}
