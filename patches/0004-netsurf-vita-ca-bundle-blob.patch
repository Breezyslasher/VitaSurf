+#ifdef __vita__
+		/* VitaSurf: hand the bundle to curl from memory so OpenSSL
+		 * never has to open the file itself. */
+		{
+			struct curl_blob blob;
+			size_t len;
+
+			if (vita_read_file(nsoption_charp(ca_bundle),
