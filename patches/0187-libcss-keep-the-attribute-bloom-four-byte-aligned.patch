 #define CSS_SELECTOR_HASH_SLOTS (1 << 6)
 
+/**
+ * A bloom of attribute names (VitaSurf).
+ *
+ * Two words rather than one uint64_t: the hash iterators reach an
+ * entry by casting a css_selector ** to it, and a member wanting
+ * eight-byte alignment makes that cast an error on ARM under
+ * -Wcast-align. Two words are also two instructions there rather than
+ * the several a 64-bit and takes.
+ */
+typedef struct css_attr_bloom {
+	uint32_t w[2];
+} css_attr_bloom;
+
+/** Fold an attribute-name hash into a bloom. */
+void css_attribute_bloom_add(css_attr_bloom *bloom, uint32_t hash);
+
+/** Whether every name \a want asks for is one \a have carries. */
+#define CSS_ATTR_BLOOM_HAS(have, want) \
+	((((have)->w[0] & (want)->w[0]) == (want)->w[0]) && \
+	 (((have)->w[1] & (want)->w[1]) == (want)->w[1]))
+
+/** Whether a bloom asks for nothing at all. */
+#define CSS_ATTR_BLOOM_EMPTY(b)	(((b)->w[0] | (b)->w[1]) == 0)
+
