+/**
+ * background-repeat: space (VitaSurf): as many whole tiles as fit along
+ * a spaced axis, the first and the last at its edges and the rest of
+ * the room shared between them; along an axis that is not, the one
+ * tile where background-position put it.
+ */
+static bool html_redraw_background_spaced(struct box *background,
+		const struct rect *r, int x, int y, int ax, int ay, int aw,
+		int ah, int iw, int ih, bool sx, bool sy, float scale,
+		colour bg, const struct redraw_context *ctx)
+{
+	int nx = 1, ny = 1, i, j;
+	float gx = 0, gy = 0;
+
+	if (iw <= 0 || ih <= 0)
+		return true;
+	if (sx) {
+		nx = aw / iw;
+		gx = nx > 1 ? (float) (aw - nx * iw) / (nx - 1) : 0;
+	}
+	if (sy) {
+		ny = ah / ih;
+		gy = ny > 1 ? (float) (ah - ny * ih) / (ny - 1) : 0;
+	}
+	if (nx < 1 || ny < 1 || nx * ny > 4096)
+		return true;
+	if (ctx->plot->clip(ctx, r) != NSERROR_OK)
+		return false;
+	for (j = 0; j < ny; j++) {
+		int ty = sy ? ay + (int) ((j * (ih + gy)) * scale) : y;
+
+		if (ty >= r->y1 || ty + ih * scale <= r->y0)
+			continue;
+		for (i = 0; i < nx; i++) {
+			struct content_redraw_data d = { 0 };
+			struct rect tr;
+			int tx = sx ? ax + (int) ((i * (iw + gx)) * scale) : x;
+
+			if (tx >= r->x1 || tx + iw * scale <= r->x0)
+				continue;
+			d.x = tx;
+			d.y = ty;
+			d.width = ceilf(iw * scale);
+			d.height = ceilf(ih * scale);
+			d.background_colour = bg;
+			d.scale = scale;
+			tr.x0 = tx < r->x0 ? r->x0 : tx;
+			tr.y0 = ty < r->y0 ? r->y0 : ty;
+			tr.x1 = tx + d.width > r->x1 ? r->x1 : tx + d.width;
+			tr.y1 = ty + d.height > r->y1 ? r->y1 : ty + d.height;
+			if (tr.x0 >= tr.x1 || tr.y0 >= tr.y1)
+				continue;
+			if (ctx->plot->clip(ctx, &tr) != NSERROR_OK ||
+					!html_redraw_bg_image(background, &d,
+						&tr, ctx))
+				return false;
+		}
+	}
+	return true;
+}
 
