+/** A background image drawn aside, for background-blend-mode. */
+struct html_bg_job {
+	struct hlcache_handle *image;
+	struct content_redraw_data data;
+	struct rect clip;
+};
+
+static bool html_bg_job_draw(const struct redraw_context *ctx, void *pw)
+{
+	struct html_bg_job *j = pw;
+
+	return content_redraw(j->image, &j->data, &j->clip, ctx);
+}
+
+/**
+ * Draw a box's background image over its colour (VitaSurf), mixed with
+ * the colour as its background-blend-mode says: the image is drawn
+ * aside, the colour already on the screen is read back, and the two
+ * are blended. Only over a colour: the layers mix with each other, not
+ * with what is behind the element, and with no colour the image is
+ * drawn as it is. tailwind's bg-blend-* and the tinted photographs of
+ * themes write it.
+ */
+static bool html_redraw_bg_image(struct box *background,
+		struct content_redraw_data *data, const struct rect *r,
+		const struct redraw_context *ctx)
+{
+	struct html_bg_job job;
+	struct bitmap *src = NULL, *back = NULL;
+	css_color bgcol = 0;
+	uint8_t mode = css_computed_background_blend_mode(background->style);
+	int w = r->x1 - r->x0, h = r->y1 - r->y0;
+
+	css_computed_background_color(background->style, &bgcol);
+	if (mode == CSS_MIX_BLEND_MODE_INHERIT ||
+			mode == CSS_MIX_BLEND_MODE_NORMAL ||
+			nscss_color_is_transparent(bgcol) ||
+			vitasurf_raster == NULL || vitasurf_backdrop == NULL ||
+			w <= 0 || h <= 0 || w * h > HTML_COMPOSITE_MAX) {
+		/* We just continue if redraw fails */
+		content_redraw(background->background, data, r, ctx);
+		return true;
+	}
+
+	job.image = background->background;
+	job.data = *data;
+	job.data.x -= r->x0;
+	job.data.y -= r->y0;
+	job.clip.x0 = 0;
+	job.clip.y0 = 0;
+	job.clip.x1 = w;
+	job.clip.y1 = h;
+	if (vitasurf_raster(w, h, html_bg_job_draw, &job, &src) !=
+			NSERROR_OK || src == NULL) {
+		content_redraw(background->background, data, r, ctx);
+		return true;
+	}
+	if (ctx->plot->flush != NULL)
+		ctx->plot->flush(ctx);
+	if (vitasurf_backdrop(r, &back) != NSERROR_OK || back == NULL ||
+			guit->bitmap->get_width(back) != w ||
+			guit->bitmap->get_height(back) != h) {
+		if (back != NULL)
+			guit->bitmap->destroy(back);
+		return html_plot_made(ctx, src, r->x0, r->y0);
