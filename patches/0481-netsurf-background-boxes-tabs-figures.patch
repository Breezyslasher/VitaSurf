+/**
+ * Mix a layer painted aside into what is behind it (VitaSurf), pixel by
+ * pixel as a blend mode says, the layer's alpha deciding how much of
+ * the mix shows: mix-blend-mode's and background-blend-mode's.
+ */
+static void html_blend_pixels(struct bitmap *src, struct bitmap *back,
+		uint8_t mode, int w, int h)
+{
+	uint8_t *sb, *bb_buf;
+	size_t ss, bs;
+	int x, y;
+
+	sb = guit->bitmap->get_buffer(src);
+	bb_buf = guit->bitmap->get_buffer(back);
+	ss = guit->bitmap->get_rowstride(src);
+	bs = guit->bitmap->get_rowstride(back);
+	for (y = 0; y < h && sb != NULL && bb_buf != NULL; y++) {
+		uint8_t *sp = sb + y * ss;
+		uint8_t *bp = bb_buf + y * bs;
+
+		for (x = 0; x < w; x++, sp += 4, bp += 4) {
+			int a = sp[bitmap_layout.a];
+			int s3[3], b3[3], m3[3], i;
+
+			if (a == 0)
+				continue;
+			s3[0] = sp[bitmap_layout.r];
+			s3[1] = sp[bitmap_layout.g];
+			s3[2] = sp[bitmap_layout.b];
+			b3[0] = bp[bitmap_layout.r];
+			b3[1] = bp[bitmap_layout.g];
+			b3[2] = bp[bitmap_layout.b];
+			if (mode == CSS_MIX_BLEND_MODE_LUMINOSITY) {
+				memcpy(m3, b3, sizeof(m3));
+				html_blend_set_lum(m3, (30 * s3[0] +
+						59 * s3[1] + 11 * s3[2]) / 100);
+			} else if (mode == CSS_MIX_BLEND_MODE_COLOR ||
+					mode == CSS_MIX_BLEND_MODE_HUE ||
+					mode == CSS_MIX_BLEND_MODE_SATURATION) {
+				memcpy(m3, s3, sizeof(m3));
+				html_blend_set_lum(m3, (30 * b3[0] +
+						59 * b3[1] + 11 * b3[2]) / 100);
+			} else {
+				for (i = 0; i < 3; i++)
+					m3[i] = html_blend_channel(mode, s3[i],
+							b3[i]);
+			}
+			bp[bitmap_layout.r] = (uint8_t) ((b3[0] * (255 - a) +
+					m3[0] * a) / 255);
+			bp[bitmap_layout.g] = (uint8_t) ((b3[1] * (255 - a) +
+					m3[1] * a) / 255);
+			bp[bitmap_layout.b] = (uint8_t) ((b3[2] * (255 - a) +
+					m3[2] * a) / 255);
+		}
+	}
+}
