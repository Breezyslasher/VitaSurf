+/**
+ * How a grid item sits along the row: its justify-self, or the grid's
+ * justify-items when that is auto (VitaSurf).
+ */
+static inline enum css_justify_self_e lh__box_justify_self(
+		const struct box *grid,
+		const struct box *item)
+{
+	enum css_justify_self_e j = css_computed_justify_self(item->style);
+
+	if (j == CSS_JUSTIFY_SELF_AUTO) {
+		j = (enum css_justify_self_e)
+				css_computed_justify_items(grid->style);
+	}
+
+	return j;
+}
