+/* exported interface documented in content/fetch.h */
+char *fetch_referer_header(nsurl *url, nsurl *referer)
+{
+	enum nsurl_scheme_type rs, us;
+	nsurl_component parts;
+	char *ref = NULL, *header;
+	size_t len = 0;
+
+	if (url == NULL || referer == NULL)
+		return NULL;
+	rs = nsurl_get_scheme_type(referer);
+	us = nsurl_get_scheme_type(url);
+	if (rs != NSURL_SCHEME_HTTP && rs != NSURL_SCHEME_HTTPS)
+		return NULL;
+	if (rs == NSURL_SCHEME_HTTPS && us != NSURL_SCHEME_HTTPS)
+		/* no referrer from a secure page to an insecure one */
+		return NULL;
+
+	parts = NSURL_SCHEME | NSURL_HOST | NSURL_PORT;
+	if (nsurl_compare(referer, url, parts))
+		parts |= NSURL_PATH | NSURL_QUERY;
+	if (nsurl_get(referer, parts, &ref, &len) != NSERROR_OK)
+		return NULL;
+	if (len > 4096 && (parts & NSURL_PATH)) {
+		/* a referrer over 4 kB is cut to its origin */
+		free(ref);
+		parts = NSURL_SCHEME | NSURL_HOST | NSURL_PORT;
+		if (nsurl_get(referer, parts, &ref, &len) != NSERROR_OK)
+			return NULL;
+	}
+
+	header = malloc(len + 16);
+	if (header != NULL)
+		snprintf(header, len + 16, "Referer: %s%s", ref,
+			 (parts & NSURL_PATH) ? "" : "/");
+	free(ref);
+	return header;
+}
+
+/** Whether url is one of the browser's own pages */
+static bool fetch_browser_page(nsurl *url)
+{
+	if (nsurl_get_scheme_type(url) == NSURL_SCHEME_OTHER) {
+		lwc_string *scheme = nsurl_get_component(url, NSURL_SCHEME);
+		bool match = false;
+
+		if (scheme != NULL) {
+			(void)lwc_string_caseless_isequal(scheme,
+					corestring_lwc_resource, &match);
+			lwc_string_unref(scheme);
+		}
+		if (match)
+			return true;
+	}
+	return vitasurf_browser_page != NULL &&
+		vitasurf_browser_page(nsurl_access(url));
+}
