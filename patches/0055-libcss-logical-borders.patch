@@ -219,3 +237,156 @@ css_error css__parse_word_wrap(css_language *c,
 {
 	return css__parse_overflow_wrap(c, vector, ctx, result);
 }
+
+/*
+ * Logical borders, logical sizes, and the old names for the gaps
+ * (VitaSurf).
+ *
+ * The same idea as the spacing above, for the rest of the family. A
+ * border written as border-inline-start was thrown away entirely, so a
+ * divider or an underline simply did not appear, and about 900
+ * declarations across the stylesheets measured here say a side by
+ * direction rather than by edge. inline-size and block-size are width
+ * and height under the same scheme. grid-gap and its two longhands are
+ * the names the gap properties had when grid shipped, and sites that
+ * have not been touched since still write them.
+ */
+
+/**
+ * Parse a border shorthand and apply it to both of two sides.
+ *
+ * border-block is one border, not one per side: the whole value is read
+ * again from the start for the second side.
+ */
+static css_error parse_border_both(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result,
+		enum border_side_e first, enum border_side_e second)
+{
+	int32_t orig_ctx = *ctx;
+	int32_t after_first;
+	css_error error;
+
+	error = css__parse_border_side(c, vector, ctx, result, first);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	after_first = *ctx;
+
+	*ctx = orig_ctx;
+	error = css__parse_border_side(c, vector, ctx, result, second);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	*ctx = after_first;
+
+	return CSS_OK;
+}
+
+#define ALIAS(name, phys)						\
+	css_error css__parse_##name(css_language *c,			\
+			const parserutils_vector *vector, int32_t *ctx,	\
+			css_style *result)				\
+	{								\
+		return parse_as(c, vector, ctx, result, phys);		\
+	}
+
+#define PAIR(name, a, b)						\
+	css_error css__parse_##name(css_language *c,			\
+			const parserutils_vector *vector, int32_t *ctx,	\
+			css_style *result)				\
+	{								\
+		return parse_pair(c, vector, ctx, result, a, b);	\
+	}
+
+/** One side, as a whole border shorthand. */
+#define BORDER(name, side)						\
+	css_error css__parse_##name(css_language *c,			\
+			const parserutils_vector *vector, int32_t *ctx,	\
+			css_style *result)				\
+	{								\
+		return css__parse_border_side(c, vector, ctx, result,	\
+					      side);			\
+	}
+
+/** Two sides, both taking the whole border shorthand. */
+#define BORDER_BOTH(name, a, b)						\
+	css_error css__parse_##name(css_language *c,			\
+			const parserutils_vector *vector, int32_t *ctx,	\
+			css_style *result)				\
+	{								\
+		return parse_border_both(c, vector, ctx, result, a, b);	\
+	}
+
+/** Another spelling of a property that is parsed exactly the same way. */
+#define SAME_AS(name, target)						\
+	css_error css__parse_##name(css_language *c,			\
+			const parserutils_vector *vector, int32_t *ctx,	\
+			css_style *result)				\
+	{								\
+		return css__parse_##target(c, vector, ctx, result);	\
+	}
+
+BORDER(border_block_start, BORDER_SIDE_TOP)
+BORDER(border_block_end, BORDER_SIDE_BOTTOM)
+BORDER(border_inline_start, BORDER_SIDE_LEFT)
+BORDER(border_inline_end, BORDER_SIDE_RIGHT)
+BORDER_BOTH(border_block, BORDER_SIDE_TOP, BORDER_SIDE_BOTTOM)
+BORDER_BOTH(border_inline, BORDER_SIDE_LEFT, BORDER_SIDE_RIGHT)
+
+ALIAS(border_block_start_width, CSS_PROP_BORDER_TOP_WIDTH)
+ALIAS(border_block_end_width, CSS_PROP_BORDER_BOTTOM_WIDTH)
+ALIAS(border_inline_start_width, CSS_PROP_BORDER_LEFT_WIDTH)
+ALIAS(border_inline_end_width, CSS_PROP_BORDER_RIGHT_WIDTH)
+PAIR(border_block_width, CSS_PROP_BORDER_TOP_WIDTH,
+		CSS_PROP_BORDER_BOTTOM_WIDTH)
+PAIR(border_inline_width, CSS_PROP_BORDER_LEFT_WIDTH,
+		CSS_PROP_BORDER_RIGHT_WIDTH)
+
+ALIAS(border_block_start_style, CSS_PROP_BORDER_TOP_STYLE)
+ALIAS(border_block_end_style, CSS_PROP_BORDER_BOTTOM_STYLE)
+ALIAS(border_inline_start_style, CSS_PROP_BORDER_LEFT_STYLE)
+ALIAS(border_inline_end_style, CSS_PROP_BORDER_RIGHT_STYLE)
+PAIR(border_block_style, CSS_PROP_BORDER_TOP_STYLE,
+		CSS_PROP_BORDER_BOTTOM_STYLE)
+PAIR(border_inline_style, CSS_PROP_BORDER_LEFT_STYLE,
+		CSS_PROP_BORDER_RIGHT_STYLE)
+
+ALIAS(border_block_start_color, CSS_PROP_BORDER_TOP_COLOR)
+ALIAS(border_block_end_color, CSS_PROP_BORDER_BOTTOM_COLOR)
+ALIAS(border_inline_start_color, CSS_PROP_BORDER_LEFT_COLOR)
+ALIAS(border_inline_end_color, CSS_PROP_BORDER_RIGHT_COLOR)
+PAIR(border_block_color, CSS_PROP_BORDER_TOP_COLOR,
+		CSS_PROP_BORDER_BOTTOM_COLOR)
+PAIR(border_inline_color, CSS_PROP_BORDER_LEFT_COLOR,
+		CSS_PROP_BORDER_RIGHT_COLOR)
+
+/*
+ * The corners are named by the two edges that meet at them, in block
+ * order then inline order, so start-start is where the top and the left
+ * meet.
+ */
+SAME_AS(border_start_start_radius, border_top_left_radius)
+SAME_AS(border_start_end_radius, border_top_right_radius)
+SAME_AS(border_end_start_radius, border_bottom_left_radius)
+SAME_AS(border_end_end_radius, border_bottom_right_radius)
+
+SAME_AS(inline_size, width)
+SAME_AS(block_size, height)
+SAME_AS(min_inline_size, min_width)
+SAME_AS(min_block_size, min_height)
+SAME_AS(max_inline_size, max_width)
+SAME_AS(max_block_size, max_height)
+
+SAME_AS(grid_gap, gap)
+SAME_AS(grid_column_gap, column_gap)
+SAME_AS(grid_row_gap, row_gap)
+
+#undef ALIAS
+#undef PAIR
+#undef BORDER
+#undef BORDER_BOTH
+#undef SAME_AS
