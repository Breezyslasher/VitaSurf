+# The colour functions a modern stylesheet uses -- oklch(), lab() and
+# color-mix() -- are converted to sRGB with a cube root and a couple of
+# powers, so this now wants the maths library. The browser's own link
+# already had it; libcss's test binaries did not (VitaSurf).
+LDFLAGS := $(LDFLAGS) -lm
+
 include $(NSBUILD)/Makefile.top
 
 # Extra installation rules
diff --git a/src/parse/properties/utils.c b/src/parse/properties/utils.c
index 07eb00a..ff3bea2 100644
--- a/src/parse/properties/utils.c
+++ b/src/parse/properties/utils.c
@@ -6,7 +6,9 @@
  */
 
 #include <assert.h>
+#include <math.h>
 #include <stdint.h>
+#include <stdlib.h>
 #include <string.h>
 #include <strings.h>
 
@@ -966,6 +968,462 @@ static bool parse_hwb(
 	return true;
 }
 
+/*
+ * The colour functions a stylesheet written this decade uses (VitaSurf).
+ *
+ * Tailwind 4 ships its whole palette as oklch() and writes every opacity
+ * modifier as color-mix(), and it is far from alone: a perceptual colour
+ * space is what a design system reaches for now. libcss knew hex, the
+ * named colours, rgb, hsl and hwb, so on such a site every single colour
+ * declaration was thrown away -- one Tailwind 4 stylesheet measured here
+ * has 90 oklch() and 152 color-mix() in it, which is the entire design.
+ *
+ * These are converted to sRGB here, at parse time, once per declaration,
+ * so nothing downstream learns a new colour space. The conversions are
+ * done in double rather than the fixed point used elsewhere in this
+ * file: a cube root and a 3x3 matrix in 22.10 loses more than the eight
+ * bits per channel that come out the other end are worth, and this runs
+ * while parsing a stylesheet, not while drawing.
+ */
+
+/*
+ * Not COLOUR_PI: newlib hides the BSD maths constants behind __STRICT_ANSI__,
+ * which -std=c99 defines, so it is not there to be used on the Vita.
+ */
+#define COLOUR_PI 3.14159265358979323846
+
+/** Is this function called \a name? */
+static bool colour_fn_is(lwc_string *s, const char *name, size_t len)
+{
+	return lwc_string_length(s) == len &&
+		strncasecmp(lwc_string_data(s), name, len) == 0;
+}
+
+/** Linear-light channel to sRGB, with the usual near-black straight line. */
+static double srgb_from_linear(double x)
+{
+	if (x <= 0.0031308) {
+		return 12.92 * x;
+	}
+	return 1.055 * pow(x, 1.0 / 2.4) - 0.055;
+}
+
+/** sRGB channel back to linear light. */
+static double linear_from_srgb(double x)
+{
+	if (x <= 0.04045) {
+		return x / 12.92;
+	}
+	return pow((x + 0.055) / 1.055, 2.4);
+}
+
+/** Oklab to sRGB, each channel 0..1 and not yet clamped. */
+static void oklab_to_srgb(double L, double a, double b,
+		double *r, double *g, double *bl)
+{
+	double l_ = L + 0.3963377774 * a + 0.2158037573 * b;
+	double m_ = L - 0.1055613458 * a - 0.0638541728 * b;
+	double s_ = L - 0.0894841775 * a - 1.2914855480 * b;
+	double l = l_ * l_ * l_;
+	double m = m_ * m_ * m_;
+	double s = s_ * s_ * s_;
+
+	*r = srgb_from_linear( 4.0767416621 * l - 3.3077115913 * m +
+			       0.2309699292 * s);
+	*g = srgb_from_linear(-1.2684380046 * l + 2.6097574011 * m -
+			       0.3413193965 * s);
+	*bl = srgb_from_linear(-0.0041960863 * l - 0.7034186147 * m +
+			       1.7076147010 * s);
+}
+
+/** sRGB to Oklab, the way back, for mixing in a perceptual space. */
+static void srgb_to_oklab(double r, double g, double b,
+		double *L, double *A, double *B)
+{
+	double rl = linear_from_srgb(r);
+	double gl = linear_from_srgb(g);
+	double bl = linear_from_srgb(b);
+	double l = cbrt(0.4122214708 * rl + 0.5363325363 * gl +
+			0.0514459929 * bl);
+	double m = cbrt(0.2119034982 * rl + 0.6806995451 * gl +
+			0.1073969566 * bl);
+	double s = cbrt(0.0883024619 * rl + 0.2817188376 * gl +
+			0.6299787005 * bl);
+
+	*L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
+	*A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
+	*B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
+}
+
+/** CIE Lab (D50, as CSS specifies it) to sRGB. */
+static void cielab_to_srgb(double L, double a, double b,
+		double *r, double *g, double *bl)
+{
+	/* Lab to XYZ, relative to D50 */
+	static const double wx = 0.3457 / 0.3585, wy = 1.0;
+	static const double wz = (1.0 - 0.3457 - 0.3585) / 0.3585;
+	double fy = (L + 16.0) / 116.0;
+	double fx = fy + a / 500.0;
+	double fz = fy - b / 200.0;
+	double e = 216.0 / 24389.0, k = 24389.0 / 27.0;
+	double x3 = fx * fx * fx, z3 = fz * fz * fz;
+	double x = (x3 > e ? x3 : (116.0 * fx - 16.0) / k) * wx;
+	double y = (L > k * e ? fy * fy * fy : L / k) * wy;
+	double z = (z3 > e ? z3 : (116.0 * fz - 16.0) / k) * wz;
+	/* XYZ D50 to linear sRGB (Bradford-adapted) */
+	double rl =  3.1341359569 * x - 1.6173168865 * y - 0.4906619460 * z;
+	double gl = -0.9787684456 * x + 1.9161415203 * y + 0.0334540777 * z;
+	*r = srgb_from_linear(rl);
+	*g = srgb_from_linear(gl);
+	*bl = srgb_from_linear(0.0719451510 * x - 0.2289883736 * y +
+			       1.4052422442 * z);
+}
+
+/**
+ * Read a number out of a token at full precision.
+ *
+ * The fixed point used everywhere else in this file keeps ten bits
+ * after the point, and a chroma is a small number: 0.2577 lands on the
+ * nearest 1/1024 and comes back 0.4% out, which is enough to move a
+ * saturated channel off 255. These colours are worked out in double, so
+ * they are read in double too.
+ */
+static bool colour_strtod(lwc_string *str, double *out)
+{
+	char buf[64];
+	size_t len = lwc_string_length(str);
+	char *end = NULL;
+
+	if (len == 0 || len >= sizeof(buf)) {
+		return false;
+	}
+	memcpy(buf, lwc_string_data(str), len);
+	buf[len] = '\0';
+
+	*out = strtod(buf, &end);
+
+	return end == buf + len;
+}
+
+/** Read one number or percentage; \a pct_scale is what 100% means. */
+static bool colour_number(const parserutils_vector *vector, int32_t *ctx,
+		double pct_scale, bool allow_pct, double *out)
+{
+	const css_token *token;
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL) {
+		return false;
+	}
+	if (token->type != CSS_TOKEN_NUMBER &&
+	    (token->type != CSS_TOKEN_PERCENTAGE || allow_pct == false)) {
+		return false;
+	}
+
+	if (!colour_strtod(token->idata, out)) {
+		return false;
+	}
+
+	if (token->type == CSS_TOKEN_PERCENTAGE) {
+		*out = *out * pct_scale / 100.0;
+	}
+
+	return true;
+}
+
+/** Read the optional "/ <alpha>" and the closing bracket. */
+static bool colour_alpha_and_close(const parserutils_vector *vector,
+		int32_t *ctx, double *alpha)
+{
+	const css_token *token;
+
+	*alpha = 1.0;
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_iterate(vector, ctx);
+
+	if (tokenIsChar(token, '/')) {
+		if (!colour_number(vector, ctx, 1.0, true, alpha)) {
+			return false;
+		}
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+	}
+
+	return tokenIsChar(token, ')');
+}
+
+/** Pack four 0..1 channels into the AARRGGBB this file deals in. */
+static uint32_t colour_pack(double r, double g, double b, double a)
+{
+	double ch[4];
+	uint32_t out = 0;
+	int i;
+
+	ch[0] = a; ch[1] = r; ch[2] = g; ch[3] = b;
+	for (i = 0; i < 4; i++) {
+		double v = ch[i];
+		long n;
+
+		if (!(v > 0.0)) {	/* also catches NaN */
+			v = 0.0;
+		} else if (v > 1.0) {
+			v = 1.0;
+		}
+		n = lround(v * 255.0);
+		out = (out << 8) | (uint32_t)n;
+	}
+
+	return out;
+}
+
+/**
+ * Parse oklab(), oklch(), lab() and lch().
+ *
+ * \a polar says the second and third components are a chroma and a hue
+ * rather than two axes, and \a cie picks CIE Lab over Oklab. The two
+ * differ in scale as well as in space: Oklab's lightness runs 0 to 1 and
+ * CIE Lab's 0 to 100, and 100% chroma means 0.4 in one and 150 in the
+ * other.
+ */
+static bool parse_lab_like(const parserutils_vector *vector, int32_t *ctx,
+		uint32_t *result, bool polar, bool cie)
+{
+	double L, c1, c2, a, r, g, b;
+	double l_scale = cie ? 100.0 : 1.0;
+	double c_scale = cie ? 150.0 : 0.4;
+	double ab_scale = cie ? 125.0 : 0.4;
+
+	if (!colour_number(vector, ctx, l_scale, true, &L)) {
+		return false;
+	}
+	if (!colour_number(vector, ctx, polar ? c_scale : ab_scale,
+			   true, &c1)) {
+		return false;
+	}
+
+	if (polar) {
+		/* the hue is an angle, and a bare number is degrees */
+		const css_token *token;
+		size_t consumed = 0;
+		css_fixed num;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+		if (token == NULL || (token->type != CSS_TOKEN_NUMBER &&
+				      token->type != CSS_TOKEN_DIMENSION)) {
+			return false;
+		}
+		num = css__number_from_lwc_string(token->idata, false,
+						  &consumed);
+		(void)num;
+		if (token->type == CSS_TOKEN_DIMENSION) {
+			size_t len = lwc_string_length(token->idata);
+			const char *data = lwc_string_data(token->idata);
+			uint32_t unit = UNIT_DEG;
+			char buf[64];
+
+			if (consumed == 0 || consumed >= sizeof(buf)) {
+				return false;
+			}
+			memcpy(buf, data, consumed);
+			buf[consumed] = '\0';
+			c2 = strtod(buf, NULL);
+
+			if (css__parse_unit_keyword(data + consumed,
+					len - consumed, &unit) != CSS_OK) {
+				return false;
+			}
+			switch (unit) {
+			case UNIT_DEG:				break;
+			case UNIT_RAD:  c2 = c2 * 180.0 / COLOUR_PI;	break;
+			case UNIT_GRAD: c2 = c2 * 0.9;		break;
+			case UNIT_TURN: c2 = c2 * 360.0;	break;
+			default:
+				return false;
+			}
+		} else if (!colour_strtod(token->idata, &c2)) {
+			return false;
+		}
+	} else if (!colour_number(vector, ctx, ab_scale, true, &c2)) {
+		return false;
+	}
+
+	if (!colour_alpha_and_close(vector, ctx, &a)) {
+		return false;
+	}
+
+	if (polar) {
+		double h = c2 * COLOUR_PI / 180.0;
+		double chroma = c1;
+
+		c1 = chroma * cos(h);
+		c2 = chroma * sin(h);
+	}
+
+	if (cie) {
+		cielab_to_srgb(L, c1, c2, &r, &g, &b);
+	} else {
+		oklab_to_srgb(L, c1, c2, &r, &g, &b);
+	}
+
+	*result = colour_pack(r, g, b, a);
+
+	return true;
+}
+
+/**
+ * Parse color-mix(in <space>, <colour> <p>?, <colour> <p>?).
+ *
+ * Mixing happens in Oklab unless the space named is one of the sRGB
+ * ones, which is both what the spec says for the perceptual spaces and
+ * what almost every use of this in the wild asks for. Alpha is
+ * premultiplied before mixing, as the spec requires, so mixing something
+ * with transparent fades it rather than dragging it towards black.
+ *
+ * currentColor cannot be resolved while parsing a stylesheet, so a mix
+ * involving it is refused and the declaration falls away as before.
+ */
+static bool parse_color_mix(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		uint32_t *result)
+{
+	const css_token *token;
+	bool perceptual = true;
+	uint16_t kind;
+	uint32_t col[2];
+	double pct[2] = { -1.0, -1.0 };
+	double r[2], g[2], b[2], a[2];
+	double w0, w1, alpha;
+	int i;
+
+	consumeWhitespace(vector, ctx);
+
+	/* "in <colorspace>" */
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL || token->type != CSS_TOKEN_IDENT ||
+			!colour_fn_is(token->idata, "in", 2)) {
+		return false;
+	}
+
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL || token->type != CSS_TOKEN_IDENT) {
+		return false;
+	}
+	if (colour_fn_is(token->idata, "srgb", 4) ||
+	    colour_fn_is(token->idata, "srgb-linear", 11)) {
+		perceptual = false;
+	}
+
+	/* a polar space may be followed by a hue interpolation method,
+	 * which changes nothing here: the mix is done in Oklab either way */
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || token->type != CSS_TOKEN_IDENT) {
+			break;
+		}
+		parserutils_vector_iterate(vector, ctx);
+	}
+
+	/* the comma between the space and the first colour */
+	consumeWhitespace(vector, ctx);
+	if (!tokenIsChar(parserutils_vector_iterate(vector, ctx), ',')) {
+		return false;
+	}
+
+	for (i = 0; i < 2; i++) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+
+		/* a percentage may come before the colour or after it */
+		if (token != NULL && token->type == CSS_TOKEN_PERCENTAGE) {
+			if (!colour_number(vector, ctx, 100.0, true,
+					   &pct[i])) {
+				return false;
+			}
+		}
+
+		if (css__parse_colour_specifier(c, vector, ctx, &kind,
+				&col[i]) != CSS_OK) {
+			return false;
+		}
+		if (kind == COLOR_CURRENT_COLOR) {
+			return false;
+		}
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token != NULL && token->type == CSS_TOKEN_PERCENTAGE &&
+				pct[i] < 0.0) {
+			if (!colour_number(vector, ctx, 100.0, true,
+					   &pct[i])) {
+				return false;
+			}
+		}
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+		if (i == 0) {
+			if (!tokenIsChar(token, ',')) {
+				return false;
+			}
+		} else if (!tokenIsChar(token, ')')) {
+			return false;
+		}
+	}
+
+	/* what one percentage leaves over belongs to the other */
+	if (pct[0] < 0.0 && pct[1] < 0.0) {
+		pct[0] = pct[1] = 50.0;
+	} else if (pct[0] < 0.0) {
+		pct[0] = 100.0 - pct[1];
+	} else if (pct[1] < 0.0) {
+		pct[1] = 100.0 - pct[0];
+	}
+	if (pct[0] + pct[1] <= 0.0) {
+		return false;
+	}
+	w0 = pct[0] / (pct[0] + pct[1]);
+	w1 = 1.0 - w0;
+
+	for (i = 0; i < 2; i++) {
+		a[i] = ((col[i] >> 24) & 0xff) / 255.0;
+		r[i] = ((col[i] >> 16) & 0xff) / 255.0;
+		g[i] = ((col[i] >> 8) & 0xff) / 255.0;
+		b[i] = (col[i] & 0xff) / 255.0;
+	}
+
+	alpha = w0 * a[0] + w1 * a[1];
+	if (alpha <= 0.0) {
+		*result = 0;
+		return true;
+	}
+
+	if (perceptual) {
+		double L0, A0, B0, L1, A1, B1, rr, gg, bb;
+
+		srgb_to_oklab(r[0], g[0], b[0], &L0, &A0, &B0);
+		srgb_to_oklab(r[1], g[1], b[1], &L1, &A1, &B1);
+		oklab_to_srgb((w0 * a[0] * L0 + w1 * a[1] * L1) / alpha,
+			      (w0 * a[0] * A0 + w1 * a[1] * A1) / alpha,
+			      (w0 * a[0] * B0 + w1 * a[1] * B1) / alpha,
+			      &rr, &gg, &bb);
+		*result = colour_pack(rr, gg, bb, alpha);
+	} else {
+		*result = colour_pack(
+			(w0 * a[0] * r[0] + w1 * a[1] * r[1]) / alpha,
+			(w0 * a[0] * g[0] + w1 * a[1] * g[1]) / alpha,
+			(w0 * a[0] * b[0] + w1 * a[1] * b[1]) / alpha,
+			alpha);
+	}
+
+	return true;
+}
+
 /**
  * Parse a colour specifier
  *
@@ -1085,6 +1543,27 @@ css_error css__parse_colour_specifier(css_language *c,
 			if (!parse_hwb(vector, ctx, result)) {
 				goto invalid;
 			}
+		/* The colour spaces a stylesheet uses now (VitaSurf) */
+		} else if (colour_fn_is(token->idata, "oklch", 5)) {
+			if (!parse_lab_like(vector, ctx, result, true, false)) {
+				goto invalid;
+			}
+		} else if (colour_fn_is(token->idata, "oklab", 5)) {
+			if (!parse_lab_like(vector, ctx, result, false, false)) {
+				goto invalid;
+			}
+		} else if (colour_fn_is(token->idata, "lch", 3)) {
+			if (!parse_lab_like(vector, ctx, result, true, true)) {
+				goto invalid;
+			}
+		} else if (colour_fn_is(token->idata, "lab", 3)) {
+			if (!parse_lab_like(vector, ctx, result, false, true)) {
+				goto invalid;
+			}
+		} else if (colour_fn_is(token->idata, "color-mix", 9)) {
+			if (!parse_color_mix(c, vector, ctx, result)) {
+				goto invalid;
+			}
 		} else {
 			goto invalid;
 		}
