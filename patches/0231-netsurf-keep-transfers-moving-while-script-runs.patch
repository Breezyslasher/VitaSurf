 }
 
+/** Keep a header or a chunk of data to hand on later (VitaSurf). */
+static bool fetch_curl_hold(struct curl_fetch_info *f, const char *data,
+		size_t len, bool header)
+{
+	struct curl_held *h = malloc(sizeof(*h) + len + 1);
+
+	if (h == NULL) {
+		return false;
+	}
+	h->next = NULL;
+	h->len = len;
+	h->header = header;
+	memcpy(h->data, data, len);
+	/* curl's own buffer has a nul after the data, and header parsers
+	 * lean on it */
+	h->data[len] = '\0';
+	if (f->held_tail != NULL) {
+		f->held_tail->next = h;
+	} else {
+		f->held = h;
+	}
+	f->held_tail = h;
+	if (!f->held_listed) {
+		f->held_next = held_fetches;
+		held_fetches = f;
+		f->held_listed = true;
+	}
+	curl_held_bytes += len;
+	vitasurf_curl_held_kb += (unsigned int)((len + 512) / 1024);
+	if (curl_held_bytes / 1024 > vitasurf_curl_held_max_kb) {
+		vitasurf_curl_held_max_kb =
+				(unsigned int)(curl_held_bytes / 1024);
+	}
+	return true;
+}
+
+/** Free what a fetch holds and take it off the list (VitaSurf). */
+static void fetch_curl_drop_held(struct curl_fetch_info *f)
+{
+	struct curl_fetch_info **pp;
+
+	while (f->held != NULL) {
+		struct curl_held *h = f->held;
+
+		f->held = h->next;
+		curl_held_bytes -= h->len;
+		free(h);
+	}
+	f->held_tail = NULL;
+	if (f->held_listed) {
+		for (pp = &held_fetches; *pp != NULL; pp = &(*pp)->held_next) {
+			if (*pp == f) {
+				*pp = f->held_next;
+				break;
+			}
+		}
+		f->held_listed = false;
+	}
+}
+
+/**
+ * Callback function for cURL: data (VitaSurf: held while a script
+ * runs; see fetch_curl_pump).
+ */
+static size_t fetch_curl_data(char *data, size_t size, size_t nmemb, void *_f)
+{
+	struct curl_fetch_info *f = _f;
+
+	if (!curl_holding) {
+		return fetch_curl_data_deliver(data, size, nmemb, _f);
+	}
+	if (f->abort || f->stopped) {
+		return 0;
+	}
+	if (curl_held_bytes + size * nmemb > CURL_HELD_MAX ||
+	    !fetch_curl_hold(f, data, size * nmemb, false)) {
+		/* curl keeps this chunk and gives it again on resume */
+		f->held_paused = true;
+		vitasurf_curl_held_pauses++;
+		if (!f->held_listed) {
+			f->held_next = held_fetches;
+			held_fetches = f;
+			f->held_listed = true;
+		}
+		return CURL_WRITEFUNC_PAUSE;
+	}
+	return size * nmemb;
+}
+
+/**
+ * Callback function for headers (VitaSurf: held while a script runs).
+ */
+static size_t
+fetch_curl_header(char *data, size_t size, size_t nmemb, void *_f)
+{
+	struct curl_fetch_info *f = _f;
+
+	if (!curl_holding) {
+		return fetch_curl_header_deliver(data, size, nmemb, _f);
+	}
+	if (f->abort || f->stopped ||
+	    !fetch_curl_hold(f, data, size * nmemb, true)) {
+		return 0;
+	}
+	return size * nmemb;
+}
+
+/**
+ * Hand on everything held, in order, then let paused fetches go
+ * (VitaSurf). Called at the start of an ordinary poll, with
+ * inside_curl set as it is for a live callback, so a fetch the content
+ * aborts is only marked, and cleaned up by its completion.
+ */
+static void fetch_curl_flush_held(void)
+{
+	while (held_fetches != NULL) {
+		struct curl_fetch_info *f = held_fetches;
+		bool paused = f->held_paused;
+
+		held_fetches = f->held_next;
+		f->held_listed = false;
+		f->held_paused = false;
+		while (f->held != NULL) {
+			struct curl_held *h = f->held;
+			size_t got;
+
+			f->held = h->next;
+			if (f->held == NULL) {
+				f->held_tail = NULL;
+			}
+			curl_held_bytes -= h->len;
+			if (f->abort || f->stopped) {
+				got = 0;
+			} else if (h->header) {
+				got = fetch_curl_header_deliver(h->data, 1,
+						h->len, f);
+			} else {
+				got = fetch_curl_data_deliver(h->data, 1,
+						h->len, f);
+			}
+			free(h);
+			if (got == 0 && !f->abort) {
+				/* what a live callback returning 0 does:
+				 * the transfer ends as stopped */
+				f->stopped = true;
+			}
+		}
+		if (paused && f->curl_handle != NULL && !f->abort &&
+		    !f->stopped) {
+			curl_easy_pause(f->curl_handle, CURLPAUSE_CONT);
+		}
+	}
+}
+
+/* exported interface documented in content/fetchers/curl.h */
+void fetch_curl_pump(void)
+{
+	uint64_t t0, t1;
+	int running;
+	CURLMcode codem;
+
+	if (inside_curl || fetch_curl_multi == NULL ||
+	    curl_held_bytes >= CURL_HELD_MAX) {
+		return;
+	}
+	nsu_getmonotonic_ms(&t0);
+	inside_curl = true;
+	curl_holding = true;
+	do {
+		codem = curl_multi_perform(fetch_curl_multi, &running);
+	} while (codem == CURLM_CALL_MULTI_PERFORM);
+	curl_holding = false;
+	inside_curl = false;
+	nsu_getmonotonic_ms(&t1);
+	vitasurf_curl_pumps++;
+	vitasurf_curl_pump_ms += (unsigned int)(t1 - t0);
+}
+
 static int fetch_curl_fdset(lwc_string *scheme, fd_set *read_set,
