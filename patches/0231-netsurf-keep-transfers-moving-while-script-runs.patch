+	}
+
 	/* ensure we only have to get this information once */
 	if (!f->http_code) {
 		code = curl_easy_getinfo(f->curl_handle, CURLINFO_HTTP_CODE,
@@ -1865,14 +1926,14 @@ static size_t fetch_curl_data(char *data, size_t size, size_t nmemb, void *_f)
  * See RFC 2616 4.2.
  */
 static size_t
-fetch_curl_header(char *data, size_t size, size_t nmemb, void *_f)
+fetch_curl_header_deliver(char *data, size_t size, size_t nmemb, void *_f)
 {
 	struct curl_fetch_info *f = _f;
 	int i;
 	fetch_msg msg;
 	size *= nmemb;
 
-	if (f->abort) {
+	if (f->abort || f->stopped) {
