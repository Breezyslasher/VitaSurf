+
+	/* what arrived while a script ran, not yet handed on (VitaSurf);
+	 * see fetch_curl_pump */
+	struct curl_held *held, *held_tail;
+	struct curl_fetch_info *held_next; /**< in held_fetches */
+	bool held_listed;	/**< on the held_fetches list */
+	bool held_paused;	/**< paused for want of room to hold */
+};
+
+/*
+ * Keeping transfers moving while a script runs (VitaSurf).
+ *
+ * The fetcher did no work while the main loop was busy, so every
+ * transfer stood still for as long as a script ran: on GitHub two
+ * 30-pixel avatars took eleven seconds, most of it inside one 7.7 s
+ * run of promise jobs, and TLS handshakes waited the same way.
+ * fetch_curl_pump lets curl read its sockets from the script
+ * interrupt, but nothing may reach the rest of NetSurf from there, so
+ * headers and data are held on the fetch, in order, and handed on by
+ * the next ordinary poll before it does anything else. Completion is
+ * only ever read by that poll, so a fetch cannot finish before what it
+ * held has gone.
+ */
+struct curl_held {
+	struct curl_held *next;
+	size_t len;
+	bool header;
+	char data[];
 };
 
+/** held at most, over every fetch, before a fetch is paused */
+#define CURL_HELD_MAX (2 * 1024 * 1024)
+
+static bool curl_holding;
+static struct curl_fetch_info *held_fetches;
+static size_t curl_held_bytes;
+
+/* for the page profile */
+unsigned int vitasurf_curl_pumps;
+unsigned int vitasurf_curl_pump_ms;
+unsigned int vitasurf_curl_held_kb;
+unsigned int vitasurf_curl_held_max_kb;
+unsigned int vitasurf_curl_held_pauses;
+
+static void fetch_curl_drop_held(struct curl_fetch_info *f);
+static void fetch_curl_flush_held(void);
+
 /** curl handle cache entry */
 struct cache_handle {
