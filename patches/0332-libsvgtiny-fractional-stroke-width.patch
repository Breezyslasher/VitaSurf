diff --git a/include/svgtiny.h b/include/svgtiny.h
index ad4e60a..6d4e527 100644
--- a/include/svgtiny.h
+++ b/include/svgtiny.h
@@ -32,6 +32,10 @@ struct svgtiny_shape {
 	svgtiny_colour fill;
 	svgtiny_colour stroke;
 	int stroke_width;
+	/** the stroke width before it was rounded to a whole pixel
+	 * (VitaSurf): a 2-unit line of a 24-unit icon drawn at 16 pixels
+	 * is 1.33 pixels, which a smooth stroke can draw */
+	float stroke_width_px;
 };
 
 struct svgtiny_diagram {
diff --git a/src/svgtiny.c b/src/svgtiny.c
