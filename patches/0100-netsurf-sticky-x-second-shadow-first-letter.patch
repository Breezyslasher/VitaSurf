+/**
+ * How many bytes of a text run its ::first-letter takes (VitaSurf):
+ * the leading punctuation and the first character after it.
+ *
+ * \param text  the run, without a leading space
+ * \return the byte count, or 0 if there is no letter to take
+ */
+static size_t box_first_letter_len(const char *text)
+{
+	size_t i = 0;
+	unsigned char c;
+
+	/* punctuation that opens a quotation or a bracket belongs with
+	 * the letter */
+	while ((c = (unsigned char) text[i]) != 0 &&
+			(c == '"' || c == '\'' || c == '(' || c == '[' ||
+			 c == '{' || (c == 0xe2 && text[i + 1] != 0 &&
+				 (unsigned char) text[i + 1] == 0x80)))
+		i += (c == 0xe2) ? 3 : 1;
+
+	c = (unsigned char) text[i];
+	if (c == 0 || c == ' ')
+		return 0;
+	if (c < 0x80)
+		return i + 1;
+	if ((c & 0xe0) == 0xc0)
+		return i + 2;
+	if ((c & 0xf0) == 0xe0)
+		return i + 3;
+	return i + 4;
+}
+
+/**
+ * Build the boxes for a block's ::first-letter (VitaSurf): the letter
+ * in a box of its own with the pseudo element's style, floated when
+ * the style floats it, as an inline otherwise.
