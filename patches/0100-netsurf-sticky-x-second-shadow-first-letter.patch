+ * \return true on success, false on memory exhaustion
+ */
+static bool box_construct_first_letter(struct box_construct_ctx *ctx,
+		struct box_construct_props *props, css_computed_style *fl_style,
+		const char *letter, size_t len, bool space_after)
+{
+	struct box *txt, *holder, *inline_end;
+	bool floated = css_computed_float(fl_style) == CSS_FLOAT_LEFT ||
+			css_computed_float(fl_style) == CSS_FLOAT_RIGHT;
+
+	txt = box_create(NULL, fl_style, false, NULL, NULL, NULL, NULL,
+			ctx->bctx);
+	if (txt == NULL)
+		return false;
+	txt->type = BOX_TEXT;
+	txt->text = talloc_strndup(ctx->bctx, letter, len);
+	if (txt->text == NULL)
+		return false;
+	txt->length = len;
+	if (css_computed_text_transform(fl_style) != CSS_TEXT_TRANSFORM_NONE)
+		box_text_transform(txt->text, txt->length,
+				css_computed_text_transform(fl_style));
+
+	if (floated) {
+		struct box *flt, *blk, *ic;
+
+		flt = box_create(NULL, NULL, false, NULL, NULL, NULL, NULL,
+				ctx->bctx);
+		blk = box_create(NULL, fl_style, false, NULL, NULL, NULL, NULL,
+				ctx->bctx);
+		ic = box_create(NULL, NULL, false, NULL, NULL, NULL, NULL,
+				ctx->bctx);
+		if (flt == NULL || blk == NULL || ic == NULL)
+			return false;
+		flt->type = css_computed_float(fl_style) == CSS_FLOAT_LEFT ?
+				BOX_FLOAT_LEFT : BOX_FLOAT_RIGHT;
+		blk->type = BOX_BLOCK;
+		ic->type = BOX_INLINE_CONTAINER;
+		box_add_child(props->inline_container, flt);
+		box_add_child(flt, blk);
+		box_add_child(blk, ic);
+		box_add_child(ic, txt);
+		return true;
+	}
+
+	holder = box_create(NULL, fl_style, false, NULL, NULL, NULL, NULL,
+			ctx->bctx);
+	inline_end = box_create(NULL, fl_style, false, NULL, NULL, NULL, NULL,
+			ctx->bctx);
+	if (holder == NULL || inline_end == NULL)
+		return false;
+	holder->type = BOX_INLINE;
+	inline_end->type = BOX_INLINE_END;
+	holder->inline_end = inline_end;
+	inline_end->inline_end = holder;
+	if (space_after)
+		txt->space = UNKNOWN_WIDTH;
+	box_add_child(props->inline_container, holder);
+	box_add_child(props->inline_container, txt);
+	box_add_child(props->inline_container, inline_end);
+	return true;
+}
