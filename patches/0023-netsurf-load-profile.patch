+static bool html_begin_conversion_inner(html_content *htmlc);
+
+/* exported interface documented in html/private.h */
 bool
 html_begin_conversion(html_content *htmlc)
+{
+	uint64_t t0 = 0, t1 = 0;
+	bool ret;
+
+	/*
+	 * Everything the page has left to do happens in here: the deferred
+	 * scripts run, the boxes are built and the page is laid out. It is
+	 * reached from inside the content conversion of whatever the page
+	 * was last waiting for, usually the last stylesheet to arrive, so
+	 * hand the time up for that conversion to subtract. Without this a
+	 * 6 KB stylesheet reports sixteen seconds that were never its own,
+	 * which is what the load profile has been saying. (VitaSurf)
+	 */
+	nsu_getmonotonic_ms(&t0);
+	ret = html_begin_conversion_inner(htmlc);
+	nsu_getmonotonic_ms(&t1);
+	vitasurf_ms_nested += t1 - t0;
+	return ret;
+}
