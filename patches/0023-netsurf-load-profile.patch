 #include "utils/messages.h"
 #include "utils/corestrings.h"
 #include "netsurf/browser_window.h"
@@ -80,10 +81,78 @@ static void content_convert(struct content *c)
 	      nsurl_access_log(llcache_handle_get_url(c->llcache)), c);
 
 	if (c->handler->data_complete != NULL) {
+		uint64_t t0 = 0, t1 = 0, total, self, outer;
+		content_type type = c->handler->type();
+
+		/*
+		 * Self time, not elapsed time. A conversion runs other
+		 * conversions inside itself: the last stylesheet of a page
+		 * to arrive finishes the page from inside its own convert,
+		 * so it ran the scripts, built the boxes and laid the page
+		 * out. Measured as elapsed, a 16 KB stylesheet came out at
+		 * seventeen seconds, which said nothing about the
+		 * stylesheet. Each conversion hands its total up to the one
+		 * that contains it, which subtracts it.
+		 */
+		outer = vitasurf_ms_nested;
+		vitasurf_ms_nested = 0;
+
 		c->locked = true;
+		nsu_getmonotonic_ms(&t0);
 		if (c->handler->data_complete(c) == false) {
 			content_set_error(c);
 		}
+		nsu_getmonotonic_ms(&t1);
+
+		total = t1 - t0;
+		self = total > vitasurf_ms_nested ?
+			total - vitasurf_ms_nested : 0;
+		vitasurf_ms_nested = outer + total;
+
+		/* where the time went, for the load profile (VitaSurf) */
+		if (type == CONTENT_CSS) {
+			vitasurf_ms_css += (unsigned int)self;
+		} else if (type & CONTENT_IMAGE) {
+			vitasurf_ms_image += (unsigned int)self;
+		}
+		/*
+		 * Name anything that took a noticeable slice of a load.
+		 * A total is enough to say a phase is slow and useless for
+		 * saying which document made it slow.
+		 */
+		if (self >= 500) {
+			const char *url;
+			char tail[112];
+			size_t size = 0, len;
+
+			content__get_source_data(c, &size);
+			url = nsurl_access(llcache_handle_get_url(c->llcache));
+			/*
+			 * A bundler's URL carries its whole module list, so
+			 * keep the end of a long one: the file name is what
+			 * identifies it and it is at the front, but the
+			 * query is what makes it long.
+			 */
+			len = strlen(url);
+			if (len > sizeof(tail) - 1) {
+				snprintf(tail, sizeof(tail), "%.*s...",
+					 (int)(sizeof(tail) - 4), url);
+				url = tail;
+			}
+			/*
+			 * A script's conversion does nothing but set the
+			 * content done, which is what runs the script -- so
+			 * for CONTENT_JS this time is the compile and the
+			 * run, already reported line by line by the engine.
+			 * Saying "convert" for it sent me looking for a
+			 * charset loop that does not exist.
+			 */
+			vita_log("slow %s: %u ms for %u KB of %s",
+				 type == CONTENT_JS ? "script (compile+run)"
+						    : "convert",
+				 (unsigned int)self,
+				 (unsigned int)(size / 1024), url);
+		}
 		/* Conversion to the READY state will unlock the content */
 	} else {
 		content_set_ready(c);
