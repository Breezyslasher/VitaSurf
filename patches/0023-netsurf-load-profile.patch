 #include "netsurf/inttypes.h"
 #include "utils/log.h"
+#include "utils/utils.h"
 #include "utils/messages.h"
 #include "utils/corestrings.h"
 #include "netsurf/browser_window.h"
@@ -80,10 +81,50 @@ static void content_convert(struct content *c)
 	      nsurl_access_log(llcache_handle_get_url(c->llcache)), c);
 
 	if (c->handler->data_complete != NULL) {
+		uint64_t t0 = 0, t1 = 0;
+		content_type type = c->handler->type();
+
 		c->locked = true;
+		nsu_getmonotonic_ms(&t0);
 		if (c->handler->data_complete(c) == false) {
 			content_set_error(c);
 		}
+		nsu_getmonotonic_ms(&t1);
+		/* where the time went, for the load profile (VitaSurf) */
+		if (type == CONTENT_CSS) {
+			vitasurf_ms_css += (unsigned int)(t1 - t0);
+		} else if (type & CONTENT_IMAGE) {
+			vitasurf_ms_image += (unsigned int)(t1 - t0);
+		}
+		/*
+		 * Name anything that took a noticeable slice of a load.
+		 * A total is enough to say a phase is slow and useless for
+		 * saying which document made it slow, and one stylesheet
+		 * has been taking seventeen seconds without saying so.
+		 */
+		if (t1 - t0 >= 500) {
+			const char *url;
+			char tail[112];
+			size_t size = 0, len;
+
+			content__get_source_data(c, &size);
+			url = nsurl_access(llcache_handle_get_url(c->llcache));
+			/*
+			 * A bundler's URL carries its whole module list, so
+			 * keep the end of a long one: the file name is what
+			 * identifies it and it is at the front, but the
+			 * query is what makes it long.
+			 */
+			len = strlen(url);
+			if (len > sizeof(tail) - 1) {
+				snprintf(tail, sizeof(tail), "%.*s...",
+					 (int)(sizeof(tail) - 4), url);
+				url = tail;
+			}
+			vita_log("slow convert: %u ms for %u KB of %s",
+				 (unsigned int)(t1 - t0),
+				 (unsigned int)(size / 1024), url);
+		}
 		/* Conversion to the READY state will unlock the content */
 	} else {
 		content_set_ready(c);
