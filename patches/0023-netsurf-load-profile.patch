diff --git a/utils/utils.h b/utils/utils.h
index 8a051633c..0855cbe1e 100644
--- a/utils/utils.h
+++ b/utils/utils.h
@@ -120,4 +120,31 @@ bool is_dir(const char *path);
 #endif
 
 
+
+/**
+ * Where a page load spent its time, in milliseconds (VitaSurf).
+ *
+ * Accumulated across one navigation and reported when the page
+ * finishes, so a log from the device says which stage a slow load is
+ * actually in rather than leaving it to guesswork.
+ */
+extern unsigned int vitasurf_ms_html_parse;
+extern unsigned int vitasurf_ms_css;
+extern unsigned int vitasurf_ms_image;
+extern unsigned int vitasurf_ms_boxes;
+extern unsigned int vitasurf_ms_layout;
+
+/** Zero the load profile counters, at the start of a navigation. */
+void vitasurf_profile_reset(void);
+
+/**
+ * Write a line to the VitaSurf log (vita/platform/vita_platform.c).
+ *
+ * NSLOG goes through a filter that a release build sets to warnings
+ * only, and the frontend's own log is the one a hardware report
+ * actually contains, so anything meant to be read from a device has to
+ * go here.
+ */
+void vita_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
 #endif
