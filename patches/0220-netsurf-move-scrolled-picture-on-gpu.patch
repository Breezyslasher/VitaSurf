-		nsfb_plot_copy(nsfb, &srcbox, nsfb, &dstbox);
+		fb_pan_copy(nsfb, &srcbox, &dstbox, &view);
 
 		/* redraw newly exposed area */
 		bwidget->scrolly += bwidget->pany;
@@ -349,7 +378,7 @@ fb_pan(fbtk_widget_t *widget,
