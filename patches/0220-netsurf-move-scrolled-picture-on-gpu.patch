@@ -245,6 +245,30 @@ static void fb_redraw(fbtk_widget_t *widget,
 		      struct browser_widget_s *bwidget,
 		      struct browser_window *bw);
 
+/**
+ * Move part of the browser's picture for a pan. On the Vita the screen
+ * texture is moved by the GPU and only the shadow buffer is copied
+ * (VitaSurf): the copy used to be written into the texture as well,
+ * most of a screen at about 12 ms each step of scrolling.
+ */
+static void
+fb_pan_copy(nsfb_t *nsfb, nsfb_bbox_t *srcbox, nsfb_bbox_t *dstbox,
+	    const nsfb_bbox_t *view)
+{
+#ifdef __vita__
+	bool gpu = vita_surface_scroll(view, dstbox->x0 - srcbox->x0,
+				       dstbox->y0 - srcbox->y0);
+#else
+	(void)view;
+#endif
+	nsfb_plot_copy(nsfb, srcbox, nsfb, dstbox);
+#ifdef __vita__
+	if (gpu) {
+		vita_surface_scroll_done();
+	}
+#endif
+}
+
 static void
 fb_pan(fbtk_widget_t *widget,
        struct browser_widget_s *bwidget,
@@ -256,6 +280,7 @@ fb_pan(fbtk_widget_t *widget,
