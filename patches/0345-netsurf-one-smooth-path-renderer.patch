+/**
+ * How much of a pixel lies within t of its centre across a line whose
+ * unit normal has components a >= b >= 0: the distribution of a pixel's
+ * points along the normal is a trapezoid, and this is its integral.
+ */
+static float fb_aa_cdf(float t, float a, float b)
+{
+	float half = (a + b) / 2, flat = (a - b) / 2, q;
+
+	if (t <= -half)
+		return 0;
+	if (t >= half)
+		return 1;
+	if (b < 1e-4f)
+		return 0.5f + t / a;	/* square on to the line */
+	if (t < -flat) {
+		q = t + half;
+		return q * q / (2 * a * b);
+	}
+	if (t > flat) {
+		q = half - t;
+		return 1 - q * q / (2 * a * b);
+	}
+	return 0.5f + t / a;
+}
