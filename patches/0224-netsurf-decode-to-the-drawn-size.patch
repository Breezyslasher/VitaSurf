+bool image_cache_decode_size_for(const struct content *c, int width,
+				 int height, int *dest_width,
+				 int *dest_height)
+{
+	int w = width, h = height;
+
+	if (!image_cache_decode_size(width, height, &w, &h)) {
+		w = width;
+		h = height;
+	}
+	if (c != NULL && c->decode_hint_width > 0 &&
+	    c->decode_hint_height > 0 &&
+	    c->decode_hint_width < w && c->decode_hint_height < h) {
+		w = c->decode_hint_width;
+		h = c->decode_hint_height;
+	}
+	*dest_width = w;
+	*dest_height = h;
+	return w != width || h != height;
