+/**
+ * Whether a bitmap decoded for a drawn size is now drawn a quarter or
+ * more bigger than it, while the picture itself has more to give.
+ */
+static bool image_cache_wants_bigger(struct image_cache_entry_s *centry,
+		const struct content_redraw_data *data)
+{
+	int bw = guit->bitmap->get_width(centry->bitmap);
+	int bh = guit->bitmap->get_height(centry->bitmap);
+	int fw, fh;
+
+	if (data->width <= bw + bw / 4 && data->height <= bh + bh / 4) {
+		return false;
+	}
+	if (!image_cache_decode_size(centry->content->width,
+				     centry->content->height, &fw, &fh)) {
+		fw = centry->content->width;
+		fh = centry->content->height;
+	}
+	return bw < fw || bh < fh;
