+/*
+ * Everything the page report still cannot name (VitaSurf).
+ *
+ * A GitHub load spends 69298 ms in boxes and styles, of which 34351 ms
+ * is selecting styles and 326 ms is the style attribute. The other
+ * 34.6 s has never been looked inside, and it is 5.5 ms an element
+ * against Wikipedia's 0.70 ms for the same code. Layout is 22853 ms
+ * over 143 passes and nothing says what asked for them or how they
+ * were spread. Images are 22513 ms over 313 of them with no split
+ * between decoding one and scaling it.
+ */
+extern unsigned int vitasurf_ms_box_element;	/**< building one box */
+extern unsigned int vitasurf_ms_box_text;	/**< a text node */
+extern unsigned int vitasurf_box_texts;
+extern unsigned int vitasurf_ms_box_special;	/**< form controls, images */
+extern unsigned int vitasurf_box_specials;
+
+extern unsigned int vitasurf_ms_layout_max;	/**< the longest one pass */
+extern unsigned int vitasurf_layout_slow;	/**< passes of 100 ms or more */
+extern unsigned int vitasurf_ms_layout_slow;
+
+extern unsigned int vitasurf_images_converted;
+extern unsigned int vitasurf_image_kpixels;	/**< what they decoded to */
+extern unsigned int vitasurf_ms_image_max;	/**< the dearest single one */
+
 extern unsigned int vitasurf_inline_styles;
 extern unsigned int vitasurf_ms_inline_style;
 
