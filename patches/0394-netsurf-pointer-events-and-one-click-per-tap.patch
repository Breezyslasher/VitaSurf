+/*
+ * The pointer's own events (VitaSurf). A tap sent the page nothing but a
+ * click, and that a bare Event with no position; a browser sends
+ * pointerdown and mousedown when the button goes down, pointerup and
+ * mouseup when it comes up, and then the click, all from where the
+ * pointer is. A page cancelling pointerdown keeps the mouse events
+ * from being sent, as in a browser; the click still is.
+ */
+static html_content *pointer_pressed;	/**< the document pressed in */
+static bool pointer_down_cancelled;	/**< its pointerdown was cancelled */
+
+static void
+pointer_press(html_content *html, dom_node *node, int x, int y)
+{
+	pointer_pressed = html;
+	pointer_down_cancelled = !fire_dom_pointer_event("pointerdown", node,
+							 x, y, 0, 1, 0);
+	if (!pointer_down_cancelled) {
+		fire_dom_pointer_event("mousedown", node, x, y, 0, 1, 1);
+	}
+}
