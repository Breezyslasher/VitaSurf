index 1b0df39d7..ec64cbafc 100644
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -135,6 +135,43 @@ bool fire_generic_dom_event(dom_string *type, dom_node *target,
 	return result;
 }
 
+/* exported interface, see private.h (VitaSurf) */
+struct html_pointer_event html_pointer_current;
+
+/* Exported interface, see private.h (VitaSurf) */
+bool fire_dom_pointer_event(const char *type, dom_node *target,
+		int x, int y, int button, int buttons, int detail)
+{
+	struct html_pointer_event saved = html_pointer_current;
+	dom_string *t = NULL;
+	dom_event *evt = NULL;
+	bool result = true;
+
+	if (target == NULL ||
+	    dom_string_create((const uint8_t *) type, strlen(type), &t) !=
+			DOM_NO_ERR) {
+		return true;
+	}
+	if (dom_event_create(&evt) != DOM_NO_ERR) {
+		dom_string_unref(t);
+		return true;
+	}
+	if (dom_event_init(evt, t, true, true) == DOM_NO_ERR) {
+		html_pointer_current.evt = evt;
+		html_pointer_current.x = x;
+		html_pointer_current.y = y;
+		html_pointer_current.button = button;
+		html_pointer_current.buttons = buttons;
+		html_pointer_current.detail = detail;
+		result = fire_dom_event(evt, target);
+		/* a listener may have made one of its own meanwhile */
+		html_pointer_current = saved;
+	}
+	dom_event_unref(evt);
+	dom_string_unref(t);
+	return result;
+}
