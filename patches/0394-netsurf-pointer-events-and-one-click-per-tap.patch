+/**
+ * The pointer behind the event being dispatched (VitaSurf). libdom's
+ * events cannot say what kind they are, so the script side reads the
+ * pointer's state from here, for this one event only, to make the
+ * MouseEvent or PointerEvent a browser hands its listeners.
+ */
+struct html_pointer_event {
+	struct dom_event *evt; /**< the event this describes, or NULL */
+	int x, y;	/**< where, in document coordinates */
+	int button;	/**< which button changed: 0 the main one */
+	int buttons;	/**< which are down: 1 the main one */
+	int detail;	/**< the click count; 0 for pointer events */
+};
+extern struct html_pointer_event html_pointer_current;
+
+/**
+ * Construct a pointer or mouse event at a place and fire it at the DOM.
+ * It bubbles, can be cancelled and leaves shadow trees, as every one a
+ * browser sends from its pointer does.
+ *
+ * eturn false if a listener cancelled it
+ */
+bool fire_dom_pointer_event(const char *type, dom_node *target,
+		int x, int y, int button, int buttons, int detail);
+
 /* Useful dom_string pointers */
