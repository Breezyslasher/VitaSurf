+/*
+ * (VitaSurf) The interpreter drops a reference at nearly every opcode,
+ * and JS_FreeValue is an exported function that gcc does not inline into
+ * this one: 53 million calls of some twenty instructions each in a run of
+ * styled-components' flatten, a tenth of it. Here it is the count, and a
+ * call only when that reaches zero.
+ */
+static inline __attribute__((always_inline))
+void js_free_value_inl(JSContext *ctx, JSValue v)
+{
+    if (JS_VALUE_HAS_REF_COUNT(v)) {
+        JSRefCountHeader *p = (JSRefCountHeader *)JS_VALUE_GET_PTR(v);
+        if (--p->ref_count <= 0)
+            js_free_value_rt(ctx->rt, v);
+    }
+}
+#define JS_FreeValue(ctx, v) js_free_value_inl(ctx, v)
