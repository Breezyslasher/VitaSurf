 static bool js_string_eq(JSString *p1, JSString *p2) {
+    if (p1 == p2)
+        return true;
     if (p1->len != p2->len)
         return false;
+    /* two atoms of the string kind are two texts (VitaSurf): typeof's
+       answers and the literals they are compared with are atoms */
+    if (p1->atom_type == JS_ATOM_TYPE_STRING &&
+        p2->atom_type == JS_ATOM_TYPE_STRING)
+        return false;
     return js_string_memcmp(p1, p2, p1->len) == 0;
 }
 
