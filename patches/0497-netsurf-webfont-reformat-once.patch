+/**
+ * Lay the page out again for something that changes the size of what is
+ * already laid out, a web font arriving, with the objects arriving
+ * meanwhile (VitaSurf): one pass for a burst of them, as soon as the
+ * last pass's cost allows.
+ */
+void html_object_schedule_reformat(struct html_content *c);
