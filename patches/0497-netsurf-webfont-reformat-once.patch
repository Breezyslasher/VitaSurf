diff --git a/content/handlers/html/object.c b/content/handlers/html/object.c
index db5b17d67..9747434f5 100644
--- a/content/handlers/html/object.c
+++ b/content/handlers/html/object.c
@@ -207,6 +207,17 @@ static int html_object_reformat_wait(void)
 }
 
 
+/* exported interface, documented in html/object.h */
+void html_object_schedule_reformat(html_content *c)
+{
+	if (c->object_reformat_pending) {
+		return;
+	}
+	c->object_reformat_pending = true;
+	guit->misc->schedule(html_object_reformat_wait(),
+			html_object_reformat, c);
+}
