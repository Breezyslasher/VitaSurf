+/**
+ * Set the code point ranges a font-face is for (VitaSurf)
+ *
+ * The font-face takes ownership of the array.
+ *
+ * \param font_face  The font-face
+ * \param ranges     The ranges, or NULL for none
+ * \param n_ranges   How many ranges there are
+ * \return CSS_OK on success,
+ *         CSS_BADPARM on bad parameters.
+ */
+css_error css__font_face_set_ranges(css_font_face *font_face,
+		css_font_face_range *ranges, uint32_t n_ranges)
+{
+	if (font_face == NULL)
+		return CSS_BADPARM;
+
+	free(font_face->ranges);
+	font_face->ranges = ranges;
+	font_face->n_ranges = n_ranges;
+
+	return CSS_OK;
+}
+
+/* exported function documented in libcss/font_face.h */
+uint32_t css_font_face_count_unicode_ranges(const css_font_face *font_face)
+{
+	if (font_face == NULL)
+		return 0;
+
+	return font_face->n_ranges;
+}
+
+/* exported function documented in libcss/font_face.h */
+css_error css_font_face_get_unicode_range(const css_font_face *font_face,
+		uint32_t index, uint32_t *start, uint32_t *end)
+{
+	if (font_face == NULL || start == NULL || end == NULL ||
+			index >= font_face->n_ranges)
+		return CSS_BADPARM;
+
+	*start = font_face->ranges[index].start;
+	*end = font_face->ranges[index].end;
+
+	return CSS_OK;
+}
