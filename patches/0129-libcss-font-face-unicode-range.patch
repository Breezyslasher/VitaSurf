+/**
+ * Parse one unicode-range token, "0460-052F" or "4??" (VitaSurf).
+ *
+ * The lexer has already taken the "U+" off the front.
+ */
+static bool font_face_parse_one_range(const char *text, size_t len,
+		uint32_t *start, uint32_t *end)
+{
+	uint32_t lo = 0, hi = 0;
+	size_t i = 0, digits = 0;
+	bool wild = false;
+
+	for (; i < len && text[i] != '-' && digits < 6; i++, digits++) {
+		uint32_t d;
+
+		if (text[i] == '?') {
+			wild = true;
+			lo = lo * 16;
+			hi = hi * 16 + 0xf;
+			continue;
+		}
+		if (wild) {
+			/* a digit after a '?' is not a range */
+			return false;
+		}
+		if (text[i] >= '0' && text[i] <= '9')
+			d = (uint32_t) (text[i] - '0');
+		else if (text[i] >= 'a' && text[i] <= 'f')
+			d = (uint32_t) (text[i] - 'a') + 10;
+		else if (text[i] >= 'A' && text[i] <= 'F')
+			d = (uint32_t) (text[i] - 'A') + 10;
+		else
+			return false;
+
+		lo = lo * 16 + d;
+		hi = hi * 16 + d;
+	}
+
+	if (digits == 0)
+		return false;
+
+	if (i < len && text[i] == '-') {
+		if (wild)
+			return false;
+		hi = 0;
+		digits = 0;
+		for (i++; i < len && digits < 6; i++, digits++) {
+			uint32_t d;
+
+			if (text[i] >= '0' && text[i] <= '9')
+				d = (uint32_t) (text[i] - '0');
+			else if (text[i] >= 'a' && text[i] <= 'f')
+				d = (uint32_t) (text[i] - 'a') + 10;
+			else if (text[i] >= 'A' && text[i] <= 'F')
+				d = (uint32_t) (text[i] - 'A') + 10;
+			else
+				return false;
+
+			hi = hi * 16 + d;
+		}
+		if (digits == 0)
+			return false;
+	}
+
+	if (i != len || hi < lo)
+		return false;
+
+	*start = lo;
+	*end = hi;
+
+	return true;
+}
+
+/**
+ * Parse the unicode-range descriptor of an @font-face rule (VitaSurf).
+ *
+ * unicode-range ::= URANGE [ ',' URANGE ]*
+ *
+ * A descriptor that is not valid leaves the face covering everything,
+ * which is what the initial value says anyway.
+ */
+static css_error font_face_parse_unicode_range(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_font_face *font_face)
+{
+	int32_t orig_ctx = *ctx;
+	css_font_face_range *ranges = NULL;
+	uint32_t n_ranges = 0, cap = 0;
+	const css_token *token;
+	css_error error = CSS_OK;
+
+	(void) c;
+
+	while ((token = parserutils_vector_iterate(vector, ctx)) != NULL) {
+		uint32_t start, end;
+
+		if (token->type != CSS_TOKEN_UNICODE_RANGE ||
+		    token->idata == NULL ||
+		    font_face_parse_one_range(
+				lwc_string_data(token->idata),
+				lwc_string_length(token->idata),
+				&start, &end) == false) {
+			error = CSS_INVALID;
+			break;
+		}
+
+		if (n_ranges == cap) {
+			css_font_face_range *grown;
+
+			cap = cap == 0 ? 4 : cap * 2;
+			grown = realloc(ranges,
+					cap * sizeof(css_font_face_range));
+			if (grown == NULL) {
+				error = CSS_NOMEM;
+				break;
+			}
+			ranges = grown;
+		}
+		ranges[n_ranges].start = start;
+		ranges[n_ranges].end = end;
+		n_ranges++;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL)
+			break;
+		if (tokenIsChar(token, ',') == false) {
+			error = CSS_INVALID;
+			break;
+		}
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+	}
+
+	if (error != CSS_OK || n_ranges == 0) {
+		free(ranges);
+		*ctx = orig_ctx;
+		return error == CSS_OK ? CSS_INVALID : error;
+	}
+
+	return css__font_face_set_ranges(font_face, ranges, n_ranges);
+}
