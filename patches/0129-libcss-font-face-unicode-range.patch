  *
@@ -404,6 +548,16 @@ css_error css__parse_font_descriptor(css_language *c,
 			c->strings[FONT_WEIGHT], &match) == lwc_error_ok &&
 			match) {
 		return font_face_parse_font_weight(c, vector, ctx, font_face);
+	} else if (lwc_string_length(descriptor->idata) ==
+				SLEN("unicode-range") &&
+			strncasecmp(lwc_string_data(descriptor->idata),
+				"unicode-range",
+				SLEN("unicode-range")) == 0) {
+		/* named here rather than through the property string table,
+		 * which holds the properties a declaration can carry and
+		 * not the descriptors of an at-rule (VitaSurf) */
+		return font_face_parse_unicode_range(c, vector, ctx,
+				font_face);
 	}
 
 	return CSS_INVALID;
