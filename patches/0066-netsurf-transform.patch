+/**
+ * Find how far a transform moves a box (VitaSurf).
+ *
+ * Only the translation is honoured; see enum css_transform_e. A
+ * percentage is a fraction of the box's own border box, which is why
+ * this waits until layout has settled the box's size.
+ *
+ * \param  unit_len_ctx  Length conversion context
+ * \param  box  box to inspect
+ * \param  x    updated to the horizontal offset
+ * \param  y    updated to the vertical offset
+ */
+static void layout_compute_transform_offset(
+		const css_unit_ctx *unit_len_ctx,
+		struct box *box,
+		int *x,
+		int *y)
+{
+	css_fixed hlength = 0, vlength = 0;
+	css_unit hunit = CSS_UNIT_PX, vunit = CSS_UNIT_PX;
+	int border_width, border_height;
+
+	*x = *y = 0;
+
+	if (box->style == NULL ||
+			css_computed_transform(box->style, &hlength, &hunit,
+					&vlength, &vunit) !=
+					CSS_TRANSFORM_SET) {
+		return;
+	}
+
+	/* FPCT_OF_INT_TOINT does not bracket its arguments, so the size
+	 * has to be worked out before it is handed over. */
+	border_width = box->border[LEFT].width + box->padding[LEFT] +
+			box->width + box->padding[RIGHT] +
+			box->border[RIGHT].width;
+	border_height = box->border[TOP].width + box->padding[TOP] +
+			box->height + box->padding[BOTTOM] +
+			box->border[BOTTOM].width;
+
+	if (hunit == CSS_UNIT_PCT) {
+		*x = FPCT_OF_INT_TOINT(hlength, border_width);
+	} else {
+		*x = FIXTOINT(css_unit_len2device_px(box->style, unit_len_ctx,
+				hlength, hunit));
+	}
+
+	if (vunit == CSS_UNIT_PCT) {
+		*y = FPCT_OF_INT_TOINT(vlength, border_height);
+	} else {
+		*y = FIXTOINT(css_unit_len2device_px(box->style, unit_len_ctx,
+				vlength, vunit));
+	}
+}
+
+
 /**
