diff --git a/src/parse/language.c b/src/parse/language.c
index b1e37e4..bf8dc9a 100644
--- a/src/parse/language.c
+++ b/src/parse/language.c
@@ -2237,6 +2237,19 @@ css_error parsePseudo(css_language *c, const parserutils_vector *vector,
 		{ CHECKED, CSS_SELECTOR_PSEUDO_CLASS },
 		{ NOT, CSS_SELECTOR_PSEUDO_CLASS },
 
+		/*
+		 * Shadow tree selectors (VitaSurf). Nothing here has a
+		 * shadow tree, so none of them ever matches -- but an
+		 * unknown pseudo class makes the whole selector list
+		 * invalid, and Tailwind 4 writes ":root, :host { ... }"
+		 * around every custom property it defines. Not knowing
+		 * :host threw away ninety-eight of them in one stylesheet
+		 * measured here, which is its entire palette.
+		 */
+		{ HOST, CSS_SELECTOR_PSEUDO_CLASS },
+		{ HOST_CONTEXT, CSS_SELECTOR_PSEUDO_CLASS },
+
+		{ SLOTTED, CSS_SELECTOR_PSEUDO_ELEMENT },
 		{ FIRST_LINE, CSS_SELECTOR_PSEUDO_ELEMENT },
 		{ FIRST_LETTER, CSS_SELECTOR_PSEUDO_ELEMENT },
 		{ BEFORE, CSS_SELECTOR_PSEUDO_ELEMENT },
@@ -2372,9 +2385,36 @@ css_error parsePseudo(css_language *c, const parserutils_vector *vector,
 			consumeWhitespace(vector, ctx);
 		}
 
-		token = parserutils_vector_iterate(vector, ctx);
-		if (token == NULL || tokenIsChar(token, ')') == false)
-			return CSS_INVALID;
+		if (fun_type == HOST || fun_type == HOST_CONTEXT ||
+				fun_type == SLOTTED) {
+			/*
+			 * Whatever is in the brackets selects inside a
+			 * shadow tree, so it cannot match here. Step over
+			 * it, counting brackets, and let the selector
+			 * stand rather than losing the rule it is in.
+			 */
+			int nesting = 0;
+
+			for (;;) {
+				token = parserutils_vector_iterate(vector,
+								   ctx);
+				if (token == NULL) {
+					return CSS_INVALID;
+				}
+				if (tokenIsChar(token, '(')) {
+					nesting++;
+				} else if (tokenIsChar(token, ')')) {
+					if (nesting == 0) {
+						break;
+					}
+					nesting--;
+				}
+			}
+		} else {
+			token = parserutils_vector_iterate(vector, ctx);
+			if (token == NULL || tokenIsChar(token, ')') == false)
+				return CSS_INVALID;
+		}
 	}
 
 	return css__stylesheet_selector_detail_init(c->sheet,
