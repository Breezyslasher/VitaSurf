+/**
+ * Whether a vertical length is a share of a height nothing has given
+ * (VitaSurf).
+ *
+ * A percentage height whose containing block has no height of its own
+ * is simply auto (CSS 2.1 10.5), and a max-height written that way is
+ * none. libcss resolves what it is asked to resolve, so with no basis
+ * it answered zero, and a scroll pane of height 100% inside a box that
+ * grows to fit collapsed to its padding, with its content hanging out
+ * below. The accessor is asked twice, against two different bases, so
+ * that a calc() holding a percentage is caught as well as a plain one.
+ *
+ * \param get    The property's px accessor
+ * \param style  The computed style
+ * \param ctx    Length conversion context
+ * \return true if the value changes with the basis
+ */
+static inline bool lh__length_needs_basis(
+		uint8_t (*get)(const css_computed_style *,
+			       const css_unit_ctx *, int, int *),
+		const css_computed_style *style,
+		const css_unit_ctx *ctx)
+{
+	/* "small" is a macro in the Vita build, so neither name is free */
+	int at_zero = 0;
+	int at_thousand = 0;
+
+	get(style, ctx, 0, &at_zero);
+	get(style, ctx, 1000, &at_thousand);
+
+	return at_zero != at_thousand;
+}
+
