+int crypto_ed25519_check_cofactorless(const u8 signature[64],
+                                      const u8 public_key[32],
+                                      const u8 *msg, size_t msg_size)
+{
+	u8 h_ram[32];
+	hash_reduce(h_ram, signature, 32, public_key, 32, msg, msg_size, 0, 0);
+	return crypto_eddsa_check_equation_cofactorless(signature, public_key,
+	                                                h_ram);
+}
