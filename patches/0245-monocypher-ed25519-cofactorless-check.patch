 #define P_W_SIZE  (1<<(P_W_WIDTH-2))
 
-int crypto_eddsa_check_equation(const u8 signature[64], const u8 public_key[32],
-                                const u8 h[32])
+static int check_equation(const u8 signature[64], const u8 public_key[32],
+                          const u8 h[32], int cofactored)
 {
 	ge minus_A; // -public_key
 	ge minus_R; // -first_half_of_signature
@@ -2052,18 +2052,35 @@ int crypto_eddsa_check_equation(const u8 signature[64], const u8 public_key[32],
 	// Compare [8](sum-R) and the zero point
 	// The multiplication by 8 eliminates any low-order component
 	// and ensures consistency with batched verification.
+	// Without it (cofactored == 0), a low-order component makes the check
+	// fail, as in the cofactorless verification WebCrypto asks for.
 	ge_cached cached;
 	u8 check[32];
 	static const u8 zero_point[32] = {1}; // Point of order 1
 	ge_cache(&cached, &minus_R);
 	ge_add(sum, sum, &cached);
-	ge_double(sum, sum, &minus_R); // reuse minus_R as temporary
-	ge_double(sum, sum, &minus_R); // reuse minus_R as temporary
-	ge_double(sum, sum, &minus_R); // reuse minus_R as temporary
+	if (cofactored) {
+		ge_double(sum, sum, &minus_R); // reuse minus_R as temporary
+		ge_double(sum, sum, &minus_R); // reuse minus_R as temporary
+		ge_double(sum, sum, &minus_R); // reuse minus_R as temporary
+	}
 	ge_tobytes(check, sum);
 	return crypto_verify32(check, zero_point);
 }
 
+int crypto_eddsa_check_equation(const u8 signature[64], const u8 public_key[32],
+                                const u8 h[32])
+{
+	return check_equation(signature, public_key, h, 1);
+}
+
+int crypto_eddsa_check_equation_cofactorless(const u8 signature[64],
+                                             const u8 public_key[32],
+                                             const u8 h[32])
+{
+	return check_equation(signature, public_key, h, 0);
+}
