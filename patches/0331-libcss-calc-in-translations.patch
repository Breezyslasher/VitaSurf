+static css_error tf_calc_product(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct tf_calc *out, int depth)
+{
+	const css_token *token;
+	struct tf_calc rhs;
+	css_error error;
+
+	error = tf_calc_value(c, vector, ctx, out, depth);
+	while (error == CSS_OK) {
+		bool times;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || !(tokenIsChar(token, '*') ||
+				tokenIsChar(token, '/')))
+			break;
+		times = tokenIsChar(token, '*');
+		parserutils_vector_iterate(vector, ctx);
+		error = tf_calc_value(c, vector, ctx, &rhs, depth);
+		if (error != CSS_OK)
+			break;
+		if (times) {
+			/* one side of a product is a plain number */
+			if (rhs.number) {
+				out->v *= rhs.v;
+			} else if (out->number) {
+				out->v *= rhs.v;
+				out->unit = rhs.unit;
+				out->number = false;
+			} else {
+				error = CSS_INVALID;
+			}
+		} else if (!rhs.number || rhs.v == 0) {
+			error = CSS_INVALID;
+		} else {
+			out->v /= rhs.v;
+		}
+	}
+	return error;
+}
+
+static css_error tf_calc_sum(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		struct tf_calc *out, int depth)
+{
+	const css_token *token;
+	struct tf_calc rhs;
+	css_error error;
+
+	error = tf_calc_product(c, vector, ctx, out, depth);
+	while (error == CSS_OK) {
+		bool plus;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || !(tokenIsChar(token, '+') ||
+				tokenIsChar(token, '-')))
+			break;
+		plus = tokenIsChar(token, '+');
+		parserutils_vector_iterate(vector, ctx);
+		error = tf_calc_product(c, vector, ctx, &rhs, depth);
+		if (error != CSS_OK)
+			break;
+		if (!plus)
+			rhs.v = -rhs.v;
+		/* a zero of any unit adds nothing; otherwise the units
+		 * must agree */
+		if (rhs.v == 0) {
+			continue;
+		} else if (out->v == 0 || (out->number == rhs.number &&
+				out->unit == rhs.unit)) {
+			out->v += rhs.v;
+			out->unit = rhs.unit;
+			out->number = rhs.number;
+		} else {
+			error = CSS_INVALID;
+		}
+	}
+	return error;
+}
