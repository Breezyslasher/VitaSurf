diff --git a/src/select/properties/paint.c b/src/select/properties/paint.c
new file mode 100644
index 0000000..ba27579
--- /dev/null
+++ b/src/select/properties/paint.c
@@ -0,0 +1,139 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/*
+ * fill and stroke (VitaSurf). Both inherit, as they do in SVG, so an icon
+ * set can say it once on the graphic and have every shape inside follow.
+ */
+
+static css_error cascade_paint(uint32_t opv, css_style *style,
+		css_select_state *state, uint16_t none_value,
+		uint8_t none_type, uint8_t color_type, uint8_t current_type,
+		css_error (*fun)(css_computed_style *, uint8_t, css_color))
+{
+	uint16_t value = 0;	/* CSS_FILL_INHERIT, CSS_STROKE_INHERIT */
+	css_color color = 0;
+
+	if (hasFlagValue(opv) == false) {
+		uint16_t v = getValue(opv);
+
+		if (v == none_value) {
+			value = none_type;
+		} else if (v == COLOR_CURRENT_COLOR) {
+			value = current_type;
+		} else if (v == COLOR_SET) {
+			value = color_type;
+			color = *((css_color *) style->bytecode);
+			advance_bytecode(style, sizeof(color));
+		} else {
+			/* transparent: a colour with nothing in it */
+			value = color_type;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return fun(state->computed, (uint8_t) value, color);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__cascade_fill(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	return cascade_paint(opv, style, state, FILL_NONE, CSS_FILL_NONE,
+			CSS_FILL_COLOR, CSS_FILL_CURRENT_COLOR, set_fill);
+}
+
+css_error css__set_fill_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_fill(style, hint->status, hint->data.color);
+}
+
+css_error css__initial_fill(css_select_state *state)
+{
+	/* SVG paints with black when nothing says otherwise */
+	return set_fill(state->computed, CSS_FILL_COLOR, 0xff000000);
+}
+
+css_error css__copy_fill(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_color color;
+	uint8_t type = get_fill(from, &color);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_fill(to, type, color);
+}
+
+css_error css__compose_fill(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_color color;
+	uint8_t type = get_fill(child, &color);
+
+	return css__copy_fill(
+			type == CSS_FILL_INHERIT ? parent : child, result);
+}
+
+css_error css__cascade_stroke(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	return cascade_paint(opv, style, state, STROKE_NONE, CSS_STROKE_NONE,
+			CSS_STROKE_COLOR, CSS_STROKE_CURRENT_COLOR, set_stroke);
+}
+
+css_error css__set_stroke_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_stroke(style, hint->status, hint->data.color);
+}
+
+css_error css__initial_stroke(css_select_state *state)
+{
+	/* nothing is stroked unless the graphic asks for it */
+	return set_stroke(state->computed, CSS_STROKE_NONE, 0);
+}
+
+css_error css__copy_stroke(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_color color;
+	uint8_t type = get_stroke(from, &color);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_stroke(to, type, color);
+}
+
+css_error css__compose_stroke(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_color color;
+	uint8_t type = get_stroke(child, &color);
+
+	return css__copy_stroke(
+			type == CSS_STROKE_INHERIT ? parent : child, result);
+}
