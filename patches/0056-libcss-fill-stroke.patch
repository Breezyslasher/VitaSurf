diff --git a/src/parse/properties/paint.c b/src/parse/properties/paint.c
new file mode 100644
index 0000000..de70da0
--- /dev/null
+++ b/src/parse/properties/paint.c
@@ -0,0 +1,116 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * fill and stroke (VitaSurf).
+ *
+ * A graphic drawn inline in a page is handed to libsvgtiny, which reads
+ * the paint from attributes. Sites do not write attributes: they write
+ * a stylesheet, almost always "fill: currentColor" so that an icon takes
+ * the colour of the text around it. libcss knew neither property, so
+ * every one of those was thrown away and the graphic fell back to the
+ * SVG default of black -- which on a dark header is an icon that is
+ * there and cannot be seen. 243 declarations of fill and 49 of stroke
+ * across the stylesheets measured here.
+ *
+ * Only the forms that name a colour are taken: a colour, currentColor,
+ * or none. A paint server -- url(#gradient) -- is left alone, so the
+ * graphic's own attributes still decide, which is what happened before.
+ */
+
+/** Parse fill or stroke, which take the same values. */
+static css_error parse_paint(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, enum css_properties_e property,
+		uint16_t none_value)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_error error;
+	bool match;
+
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[INHERIT], &match) == lwc_error_ok &&
+			match) {
+		error = css_stylesheet_style_inherit(result, property);
+	} else if (token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[INITIAL], &match) == lwc_error_ok &&
+			match) {
+		error = css_stylesheet_style_initial(result, property);
+	} else if (token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[REVERT], &match) == lwc_error_ok &&
+			match) {
+		error = css_stylesheet_style_revert(result, property);
+	} else if (token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[UNSET], &match) == lwc_error_ok &&
+			match) {
+		error = css_stylesheet_style_unset(result, property);
+	} else if (token->type == CSS_TOKEN_IDENT &&
+			lwc_string_caseless_isequal(token->idata,
+				c->strings[NONE], &match) == lwc_error_ok &&
+			match) {
+		error = css__stylesheet_style_appendOPV(result, property, 0,
+							none_value);
+	} else {
+		uint16_t value = 0;
+		uint32_t color = 0;
+
+		*ctx = orig_ctx;
+
+		error = css__parse_colour_specifier(c, vector, ctx,
+						    &value, &color);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+
+		error = css__stylesheet_style_appendOPV(result, property, 0,
+							value);
+		if (error == CSS_OK && value == COLOR_SET) {
+			error = css__stylesheet_style_append(result, color);
+		}
+	}
+
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
+
+css_error css__parse_fill(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_paint(c, vector, ctx, result, CSS_PROP_FILL, FILL_NONE);
+}
+
+css_error css__parse_stroke(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_paint(c, vector, ctx, result, CSS_PROP_STROKE,
+			   STROKE_NONE);
+}
