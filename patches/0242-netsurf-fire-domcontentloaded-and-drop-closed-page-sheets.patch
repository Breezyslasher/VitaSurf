+/* exported function documented in html/css.h */
+void html_css_abort_pending(html_content *html)
+{
+	unsigned int i;
+	unsigned int aborted = 0;
+
+	/*
+	 * A page closed before its stylesheets arrived has no use for
+	 * them (VitaSurf). An HTML content is never shared, so once it
+	 * is closed it is never shown again. claude.ai's script navigates
+	 * away while a 1.4 MB stylesheet it linked late is still
+	 * downloading; the old page went on to parse it, 2.1 seconds on
+	 * the Vita, and the new page then fetched and parsed the same
+	 * sheet again. hlcache keeps an unused content that is still
+	 * loading, so letting go of the handle alone does not stop it.
+	 *
+	 * Only with the cache off: then every fetch is forced to the
+	 * network and the next page cannot pick up this one's. With it
+	 * on, llcache hands an object still being fetched to whoever asks
+	 * for the same URL, so a same-site navigation gets the sheet
+	 * without fetching it again.
+	 */
+	if (vitasurf_cache_disabled == NULL || !vitasurf_cache_disabled()) {
+		return;
+	}
+
+	for (i = 0; i != html->stylesheet_count; i++) {
+		struct html_stylesheet *s = &html->stylesheets[i];
+		struct content *c;
+
+		if (s->sheet == NULL) {
+			continue;
+		}
+		/* no content yet means no response yet: still pending */
+		c = hlcache_handle_get_content(s->sheet);
+		if (c != NULL &&
+		    content__get_status(c) != CONTENT_STATUS_LOADING) {
+			continue;
+		}
+
+		/*
+		 * Abort the fetch only when no other page wants this
+		 * content; otherwise letting go of it is enough. A handle
+		 * with no content yet has its fetch stopped by the release.
+		 */
+		if (c != NULL && content_count_users(c) == 1) {
+			hlcache_handle_abort(s->sheet);
+		}
+		hlcache_handle_release(s->sheet);
+		s->sheet = NULL;
+		if (html->base.active > 0) {
+			html->base.active--;
+		}
+		aborted++;
+	}
+
+	if (aborted != 0) {
+		NSLOG(netsurf, INFO, "closed page dropped %u pending stylesheets",
+		      aborted);
+	}
+}
+
+
