+/*
+ * Sheets parsed from a STYLE's text for an early style read, offered to
+ * the CSS content made for the same text (VitaSurf). The content parsed
+ * the text again: cnn.com's STYLEs took 3 s for its first style read and
+ * as long again when they were converted.
+ */
+#define NSCSS_OFFERS 64
+
+static struct nscss_offer {
+	nsurl *url;
+	nscss_parsed_fn take;
+	void *owner;
+	void *key;
+} nscss_offers[NSCSS_OFFERS];
+static unsigned int nscss_n_offers;
+
+/* exported interface documented in css/css.h */
+bool nscss_offer_parsed(nsurl *url, nscss_parsed_fn take, void *owner,
+		void *key)
+{
+	struct nscss_offer *o;
+
+	if (nscss_n_offers == NSCSS_OFFERS || url == NULL || take == NULL)
+		return false;
+	o = &nscss_offers[nscss_n_offers++];
+	o->url = nsurl_ref(url);
+	o->take = take;
+	o->owner = owner;
+	o->key = dom_node_ref((dom_node *) key);
+	return true;
+}
+
+static void nscss_offer_drop(unsigned int k)
+{
+	nsurl_unref(nscss_offers[k].url);
+	dom_node_unref((dom_node *) nscss_offers[k].key);
+	nscss_offers[k] = nscss_offers[--nscss_n_offers];
+}
+
+/* exported interface documented in css/css.h */
+void nscss_withdraw_offers(const void *owner)
+{
+	unsigned int k = 0;
+
+	while (k < nscss_n_offers) {
+		if (nscss_offers[k].owner == owner)
+			nscss_offer_drop(k);
+		else
+			k++;
+	}
+}
+
+/** The sheet parsed already for this content's text, or NULL. */
+static css_stylesheet *nscss_take_offer(struct content *c)
+{
+	nsurl *url = content_get_url(c);
+	unsigned int k;
+
+	for (k = 0; k < nscss_n_offers; k++) {
+		struct nscss_offer *o = &nscss_offers[k];
+		css_stylesheet *sheet = NULL;
+		const uint8_t *data;
+		const char *base = NULL;
+		size_t size = 0;
+
+		if (!nsurl_compare(o->url, url, NSURL_COMPLETE))
+			continue;
+		data = content__get_source_data(c, &size);
+		if (data != NULL && css_stylesheet_get_url(
+				((nscss_content *) c)->data.sheet, &base) ==
+				CSS_OK && base != NULL)
+			sheet = o->take(o->owner, o->key, data, size, base);
+		nscss_offer_drop(k);
+		return sheet;
+	}
+	return NULL;
+}
