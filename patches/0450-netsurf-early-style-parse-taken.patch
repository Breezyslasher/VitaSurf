+/**
+ * A STYLE's early parse, for the CSS content made from its text, which
+ * would parse it again (VitaSurf; see nscss_offer_parsed). Only a sheet
+ * parsed from the same text, without imports, which an early parse does
+ * not fetch, and against the root's attributes as they are now.
+ */
+static css_stylesheet *early_sheet_take(void *owner, void *key,
+		const uint8_t *data, size_t len, const char *base)
+{
+	html_content *c = owner;
+	unsigned int k;
+
+	for (k = 0; k < c->early_cache_n; k++) {
+		struct html_early_sheet *e = &c->early_cache[k];
+		css_stylesheet *sheet = e->sheet;
+		lwc_string *import = NULL;
+		uint32_t hints = 0;
+
+		if (e->node != (dom_node *) key)
+			continue;
+		if (e->len != len || memcmp(e->text, data, len) != 0 ||
+				strcmp(nsurl_access(e->base), base) != 0)
+			return NULL;
+		if (css_stylesheet_next_pending_import(sheet, &import) ==
+				CSS_OK) {
+			lwc_string_unref(import);
+			return NULL;
+		}
+		if (css_stylesheet_used_root_hints(sheet, &hints) != CSS_OK ||
+				(hints != 0 &&
+				 hints != css_root_hints_signature()))
+			return NULL;
+		/* the content's now; an early context holding it holds
+		   the content's sheet, as it would once the content is
+		   done */
+		free(e->text);
+		dom_node_unref(e->node);
+		nsurl_unref(e->base);
+		c->early_cache[k] = c->early_cache[--c->early_cache_n];
+		return sheet;
+	}
+	return NULL;
+}
