diff --git a/src/parse/properties/clip_path.c b/src/parse/properties/clip_path.c
new file mode 100644
index 0000000..5853fca
--- /dev/null
+++ b/src/parse/properties/clip_path.c
@@ -0,0 +1,194 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/**
+ * Step over the rest of a function's arguments, brackets and all.
+ */
+static css_error skip_function(const parserutils_vector *vector,
+		int32_t *ctx)
+{
+	const css_token *token;
+	int depth = 0;
+
+	while ((token = parserutils_vector_iterate(vector, ctx)) != NULL) {
+		if (token->type == CSS_TOKEN_FUNCTION ||
+				tokenIsChar(token, '(')) {
+			depth++;
+		} else if (tokenIsChar(token, ')')) {
+			if (depth == 0)
+				return CSS_OK;
+			depth--;
+		}
+	}
+
+	return CSS_INVALID;
+}
+
+/**
+ * Parse clip-path (VitaSurf)
+ *
+ * \param c	  Parsing context
+ * \param vector  Vector of tokens to process
+ * \param ctx	  Pointer to vector iteration context
+ * \param result  Pointer to the location to receive the resulting style
+ * \return CSS_OK on success,
+ *	   CSS_NOMEM on memory exhaustion,
+ *	   CSS_INVALID if the input is not valid
+ *
+ * Post condition: \a *ctx is updated with the next token to process
+ *		   If the input is invalid, then \a *ctx remains unchanged.
+ *
+ * none | inset( <length-percentage>{1,4} [ round <radius> ]? ) is
+ * understood. inset() is what the visually-hidden pattern uses --
+ * "clip-path: inset(50%)" leaves nothing of the box -- and the only
+ * shape a rectangular clip can honour. Any other basic shape or a
+ * url() is accepted as SHAPE, which the renderer treats as none, so
+ * the rule it sits in keeps its other declarations.
+ */
+css_error css__parse_clip_path(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_fixed length[4] = { 0, 0, 0, 0 };
+	uint32_t unit[4] = { UNIT_PX, UNIT_PX, UNIT_PX, UNIT_PX };
+	int lengths = 0;
+	css_error error;
+	bool match;
+	int i;
+
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_CLIP_PATH);
+	}
+
+	if (token->type == CSS_TOKEN_IDENT &&
+	    lwc_string_caseless_isequal(token->idata, c->strings[NONE],
+			&match) == lwc_error_ok && match) {
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_CLIP_PATH, 0, CLIP_PATH_NONE);
+	}
+
+	if (token->type == CSS_TOKEN_URI) {
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_CLIP_PATH, 0, CLIP_PATH_SHAPE);
+	}
+
+	if (token->type != CSS_TOKEN_FUNCTION) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	if (lwc_string_caseless_isequal(token->idata, c->strings[INSET],
+			&match) != lwc_error_ok || match == false) {
+		/* circle(), ellipse(), polygon(), path(), a geometry box */
+		error = skip_function(vector, ctx);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_CLIP_PATH, 0, CLIP_PATH_SHAPE);
+	}
+
+	/* inset( <length-percentage>{1,4} [ round <border-radius> ]? ) */
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		if (tokenIsChar(token, ')')) {
+			parserutils_vector_iterate(vector, ctx);
+			break;
+		}
+		if (token->type == CSS_TOKEN_IDENT) {
+			/* "round <radius>": the corners are not cut, so the
+			 * radii are stepped over */
+			if (lwc_string_caseless_isequal(token->idata,
+					c->strings[ROUND], &match) !=
+					lwc_error_ok || match == false) {
+				*ctx = orig_ctx;
+				return CSS_INVALID;
+			}
+			error = skip_function(vector, ctx);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			break;
+		}
+		if (lengths == 4) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				&length[lengths], &unit[lengths]);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+		if ((unit[lengths] & (UNIT_LENGTH | UNIT_PCT)) == 0 &&
+				length[lengths] != 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		lengths++;
+	}
+
+	if (lengths == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	/* one value is every side, two are top/bottom and left/right,
+	 * three leave the left to copy the right */
+	if (lengths == 1) {
+		length[1] = length[2] = length[3] = length[0];
+		unit[1] = unit[2] = unit[3] = unit[0];
+	} else if (lengths == 2) {
+		length[2] = length[0]; unit[2] = unit[0];
+		length[3] = length[1]; unit[3] = unit[1];
+	} else if (lengths == 3) {
+		length[3] = length[1]; unit[3] = unit[1];
+	}
+
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_CLIP_PATH,
+			0, CLIP_PATH_INSET);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	for (i = 0; i < 4; i++) {
+		error = css__stylesheet_style_vappend(result, 2,
+				length[i], unit[i]);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	}
+
+	return CSS_OK;
+}
diff --git a/src/parse/properties/ignored.c b/src/parse/properties/ignored.c
new file mode 100644
index 0000000..f1abc43
--- /dev/null
+++ b/src/parse/properties/ignored.c
@@ -0,0 +1,46 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/**
+ * Accept a declaration and produce nothing from it (VitaSurf).
+ *
+ * The properties routed here are listed in propstrings.h: they have no
+ * effect on a static page, so the value is stepped over unread and the
+ * declaration ends up as an empty style. An !important is left for
+ * parseProperty to find, the same as for any other property.
+ *
+ * \param c	  Parsing context
+ * \param vector  Vector of tokens to process
+ * \param ctx	  Pointer to vector iteration context
+ * \param result  Pointer to the location to receive the resulting style
+ * \return CSS_OK.
+ */
+css_error css__parse_ignored(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	const css_token *token;
+
+	UNUSED(c);
+	UNUSED(result);
+
+	while ((token = parserutils_vector_peek(vector, *ctx)) != NULL) {
+		if (tokenIsChar(token, '!'))
+			break;
+		parserutils_vector_iterate(vector, ctx);
+	}
+
+	return CSS_OK;
+}
