@@ -1564,6 +1564,31 @@ css_error css__parse_colour_specifier(css_language *c,
 			if (!parse_color_mix(c, vector, ctx, result)) {
 				goto invalid;
 			}
+		} else if (fn_name_is(token->idata, "light-dark", 10)) {
+			/* light-dark(<light>, <dark>): this browser renders
+			 * the light scheme (VitaSurf), so the first colour
+			 * is the value and the second is parsed and dropped */
+			uint16_t kind;
+			uint32_t dark;
+
+			if (css__parse_colour_specifier(c, vector, ctx,
+					&kind, result) != CSS_OK) {
+				goto invalid;
