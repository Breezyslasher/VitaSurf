+static inline uint8_t get_clip_path(const css_computed_style *style, css_fixed
+		*length_a, css_unit *unit_a, css_fixed *length_b, css_unit
+		*unit_b, css_fixed *length_c, css_unit *unit_c, css_fixed
+		*length_d, css_unit *unit_d)
+{
+	uint8_t type;
+	uint32_t bits = style->i.bits[CLIP_PATH_INDEX];
+	bits &= CLIP_PATH_MASK;
+	bits >>= CLIP_PATH_SHIFT;
+
+	/* 22bits: aaaaabbbbbcccccdddddtt : unit_a | unit_b | unit_c | unit_d |
+			type */
+	type = bits & 0x3;
+	if (type == CSS_CLIP_PATH_INSET) {
+		*length_a = style->i.clip_path_a;
+		*length_b = style->i.clip_path_b;
+		*length_c = style->i.clip_path_c;
+		*length_d = style->i.clip_path_d;
+		*unit_a = bits >> 17;
+		*unit_b = (bits & 0x1f000) >> 12;
+		*unit_c = (bits & 0xf80) >> 7;
+		*unit_d = (bits & 0x7c) >> 2;
+	}
+
+	return type;
+}
