+	css_fixed length[4] = { 0, 0, 0, 0 };
+	uint32_t unit[4] = { UNIT_PX, UNIT_PX, UNIT_PX, UNIT_PX };
+	int i;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case CLIP_PATH_NONE:
+			value = CSS_CLIP_PATH_NONE;
+			break;
+		case CLIP_PATH_INSET:
+			value = CSS_CLIP_PATH_INSET;
+			break;
+		case CLIP_PATH_SHAPE:
+			value = CSS_CLIP_PATH_SHAPE;
+			break;
+		}
+	}
+
+	if (value == CSS_CLIP_PATH_INSET) {
+		for (i = 0; i < 4; i++) {
+			length[i] = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(length[i]));
+			unit[i] = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(unit[i]));
+		}
+	}
+
+	for (i = 0; i < 4; i++) {
+		unit[i] = css__to_css_unit(unit[i]);
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_clip_path(state->computed, value,
+				length[0], unit[0], length[1], unit[1],
+				length[2], unit[2], length[3], unit[3]);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_clip_path_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
+	UNUSED(style);
+
+	return CSS_OK;
+}
+
+css_error css__initial_clip_path(css_select_state *state)
+{
+	return set_clip_path(state->computed, CSS_CLIP_PATH_NONE,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX);
+}
+
+css_error css__copy_clip_path(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed a = 0, b = 0, c = 0, d = 0;
+	css_unit ua = CSS_UNIT_PX, ub = CSS_UNIT_PX;
+	css_unit uc = CSS_UNIT_PX, ud = CSS_UNIT_PX;
+	uint8_t type = get_clip_path(from, &a, &ua, &b, &ub, &c, &uc,
+			&d, &ud);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_clip_path(to, type, a, ua, b, ub, c, uc, d, ud);
+}
+
+css_error css__compose_clip_path(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed a = 0, b = 0, c = 0, d = 0;
+	css_unit ua = CSS_UNIT_PX, ub = CSS_UNIT_PX;
+	css_unit uc = CSS_UNIT_PX, ud = CSS_UNIT_PX;
+	uint8_t type = get_clip_path(child, &a, &ua, &b, &ub, &c, &uc,
+			&d, &ud);
+
+	return css__copy_clip_path(
+			type == CSS_CLIP_PATH_INHERIT ? parent : child,
+			result);
+}
