@@ -72,6 +72,25 @@ css_error node_is_visited(void *pw, void *node, bool *match);
  */
 void nscss_clear_node_data(dom_node *n);
 
+/**
+ * Take the selection data libcss cached on a node off it, without
+ * destroying it, so the node can be selected for again and the data put
+ * back afterwards (VitaSurf).
+ *
+ * \param n the node
+ * \return the data, or NULL if there was none
+ */
+void *nscss_take_node_data(dom_node *n);
+
+/**
+ * Drop whatever selection data a node now has and put back what
+ * nscss_take_node_data took (VitaSurf).
+ *
+ * \param n     the node
+ * \param data  what nscss_take_node_data returned
+ */
+void nscss_put_node_data(dom_node *n, void *data);
+
