+/* exported interface documented in css/select.h */
+void *nscss_take_node_data(dom_node *n)
+{
+	void *old = NULL;
+
+	if (dom_node_set_user_data(n, corestring_dom___ns_key_libcss_node_data,
+			NULL, NULL, &old) != DOM_NO_ERR)
+		return NULL;
+	return old;
+}
+
+/* exported interface documented in css/select.h */
+void nscss_put_node_data(dom_node *n, void *data)
+{
+	void *cur = NULL;
+
+	nscss_clear_node_data(n);
+	if (data != NULL)
+		dom_node_set_user_data(n,
+				corestring_dom___ns_key_libcss_node_data,
+				data, nscss_dom_user_data_handler, &cur);
+}
