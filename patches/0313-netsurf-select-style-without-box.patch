diff --git a/content/handlers/html/box_construct.c b/content/handlers/html/box_construct.c
index dbd873773..759354b33 100644
--- a/content/handlers/html/box_construct.c
+++ b/content/handlers/html/box_construct.c
@@ -377,6 +377,34 @@ box_get_style(html_content *c,
 }
 
 
+/* exported function documented in html/box_construct.h */
+css_select_results *html_select_style(html_content *c,
+		const css_computed_style *parent_style,
+		const css_computed_style *root_style,
+		dom_node *n)
+{
+	css_select_results *res;
+	dom_node *parent = NULL;
+	void *kept, *kept_parent = NULL;
+
+	if (c == NULL || c->select_ctx == NULL || n == NULL)
+		return NULL;
+	/* libcss keeps what it selected on the node, and on its parent
+	 * when that had nothing, and box construction insists on finding
+	 * nothing there: put back what was there on both */
+	dom_node_get_parent_node(n, &parent);
+	if (parent != NULL)
+		kept_parent = nscss_take_node_data(parent);
+	kept = nscss_take_node_data(n);
+	res = box_get_style(c, parent_style, root_style, n);
+	nscss_put_node_data(n, kept);
+	if (parent != NULL) {
+		nscss_put_node_data(parent, kept_parent);
+		dom_node_unref(parent);
+	}
+	return res;
+}
