+/*
+ * Advance cache (VitaSurf).
+ *
+ * Laying a page out measures text constantly: every string, every word,
+ * and every trial line break asks for widths, and each of those walked
+ * the string a character at a time through the FreeType cache manager.
+ * The rendering is not what costs -- FreeType keeps rendered glyphs, so
+ * a repeat is a hit -- it is the lookup itself, once per character, and
+ * on this device that was most of the 1.5 seconds a trivial page spent
+ * in layout.
+ *
+ * An advance never changes for a given face and size, so keep the ones
+ * already looked up. Measured against DejaVu Sans at three sizes, this
+ * is 13.8 times quicker than asking the cache manager each time, and the
+ * width it returns is identical to the byte: the table is filled through
+ * the same lookup with the same load flags, so hinting rounds advances
+ * exactly as it did before and nothing in layout moves.
+ */
+#define ADV_STYLES 8		/* faces x sizes kept at once */
+#define ADV_CHARS  128		/* ASCII, where nearly every advance is */
+#define ADV_UNKNOWN INT16_MIN	/* not looked up yet */
+
+struct adv_style {
+	FTC_FaceID face_id;
+	FT_UInt size;
+	FT_UInt res;
+	bool used;
+	unsigned stamp;
+	int16_t adv[ADV_CHARS];
+};
+static struct adv_style adv_styles[ADV_STYLES];
+static unsigned adv_stamp;
+
+/** The cache row for a style, reusing the least recently used row. */
+static struct adv_style *fb_adv_slot(FTC_ScalerRec *srec)
+{
+	struct adv_style *oldest = &adv_styles[0];
+	int i;
+
+	for (i = 0; i < ADV_STYLES; i++) {
+		struct adv_style *s = &adv_styles[i];
+
+		if (s->used && s->face_id == srec->face_id &&
+		    s->size == srec->width && s->res == srec->x_res) {
+			s->stamp = ++adv_stamp;
+			return s;
+		}
+		if (!s->used) {
+			oldest = s;
+			break;
+		}
+		if (s->stamp < oldest->stamp) {
+			oldest = s;
+		}
+	}
+	oldest->face_id = srec->face_id;
+	oldest->size = srec->width;
+	oldest->res = srec->x_res;
+	oldest->used = true;
+	oldest->stamp = ++adv_stamp;
+	for (i = 0; i < ADV_CHARS; i++) {
+		oldest->adv[i] = ADV_UNKNOWN;
+	}
+	return oldest;
+}
+
+/**
+ * How far one character advances, or -1 when it has no glyph.
+ *
+ * Filled as characters are met rather than all at once: a page using ten
+ * characters of a face should not pay for ninety-five.
+ */
+static int fb_advance(struct adv_style *slot, FTC_ScalerRec *srec,
+		      fb_faceid_t *fb_face, uint32_t ucs4)
+{
+	bool cacheable = ucs4 < ADV_CHARS;
+	FT_UInt glyph_index;
+	FT_Glyph glyph;
+	int advance;
+
+	if (cacheable && slot->adv[ucs4] != ADV_UNKNOWN) {
+		return slot->adv[ucs4];
+	}
+	glyph_index = FTC_CMapCache_Lookup(ft_cmap_cache, srec->face_id,
+					   fb_face->cidx, ucs4);
+	if (FTC_ImageCache_LookupScaler(ft_image_cache, srec,
+					FT_LOAD_RENDER |
+					FT_LOAD_FORCE_AUTOHINT |
+					ft_load_type,
+					glyph_index, &glyph, NULL) != 0) {
+		advance = -1;
+	} else {
+		advance = glyph->advance.x >> 16;
+	}
+	if (cacheable) {
+		slot->adv[ucs4] = (int16_t)advance;
+	}
+	return advance;
+}
+
+/*
+ * Decoding one character, cheaply for the common one.
+ *
+ * utf8_to_ucs4 and utf8_next are two calls into libparserutils for every
+ * character measured, and with the advance cache in place they became
+ * the larger half of the cost. A byte below 0x80 is its own code point
+ * and is one byte long, which is nearly all of the text on nearly every
+ * page; anything else still goes the long way round.
+ */
+static inline uint32_t fb_next_char(const char *s, size_t len, size_t *off)
+{
+	unsigned char c = (unsigned char)s[*off];
+
+	if (c < 0x80) {
+		(*off)++;
+		return c;
+	}
+	{
+		uint32_t ucs4 = utf8_to_ucs4(s + *off, len - *off);
+		*off = utf8_next(s, len, *off);
+		return ucs4;
+	}
+}
