+/*
+ * Merging several hashes into one (VitaSurf). See hash.h.
+ */
+
+/** Cascade order: specificity, then sheet, then rule. */
+static int _entry_order(const void *a, const void *b)
+{
+	const hash_entry *x = a, *y = b;
+
+	if (x->sel->specificity != y->sel->specificity)
+		return x->sel->specificity < y->sel->specificity ? -1 : 1;
+	if (x->seq != y->seq)
+		return x->seq < y->seq ? -1 : 1;
+	if (x->sel->rule->index != y->sel->rule->index)
+		return x->sel->rule->index < y->sel->rule->index ? -1 : 1;
+	return 0;
+}
+
+/**
+ * Put a chain in cascade order.
+ *
+ * The entries were pushed on unordered because inserting each in its
+ * place is a walk of the chain, and the chain of :host rules on a
+ * GitHub page is 5611 long. The nodes stay where they are and only
+ * their contents move, so the slot at the head stays the head.
+ */
+static css_error _sort_chain(hash_entry *head)
+{
+	hash_entry **nodes, *vals, *e;
+	size_t n = 0, k;
+
+	if (head->sel == NULL || head->next == NULL)
+		return CSS_OK;
+
+	for (e = head; e != NULL; e = e->next)
+		n++;
+
+	nodes = malloc(n * sizeof(*nodes));
+	vals = malloc(n * sizeof(*vals));
+	if (nodes == NULL || vals == NULL) {
+		free(nodes);
+		free(vals);
+		return CSS_NOMEM;
+	}
+
+	for (k = 0, e = head; e != NULL; e = e->next, k++) {
+		nodes[k] = e;
+		vals[k] = *e;
+	}
+
+	qsort(vals, n, sizeof(*vals), _entry_order);
+
+	for (k = 0; k < n; k++) {
+		*nodes[k] = vals[k];
+		nodes[k]->next = (k + 1 < n) ? nodes[k + 1] : NULL;
+	}
+
+	free(nodes);
+	free(vals);
+
+	return CSS_OK;
+}
+
+/** Size an empty table for the entries about to be filed in it. */
+static css_error _size_table(css_selector_hash *ctx, hash_t *h, size_t total)
+{
+	size_t want = DEFAULT_SLOTS;
+	hash_entry *fresh;
+
+	while (want * HASH_MAX_PER_SLOT < total)
+		want *= 2;
+	if (want == h->n_slots)
+		return CSS_OK;
+
+	fresh = calloc(want, sizeof(hash_entry));
+	if (fresh == NULL)
+		return CSS_NOMEM;
+
+	free(h->slots);
+	ctx->hash_size += (want - h->n_slots) * sizeof(hash_entry);
+	h->slots = fresh;
+	h->n_slots = want;
+
+	return CSS_OK;
+}
+
+/** Put a copy of an entry on a chain, in no particular order yet. */
+static css_error _push_copy(css_selector_hash *ctx, hash_entry *head,
+		const hash_entry *from, uint32_t seq)
+{
+	hash_entry *e;
+
+	if (head->sel == NULL) {
+		*head = *from;
+		head->seq = seq;
+		head->next = NULL;
+		return CSS_OK;
+	}
+
+	e = malloc(sizeof(*e));
+	if (e == NULL)
+		return CSS_NOMEM;
+
+	*e = *from;
+	e->seq = seq;
+	e->next = head->next;
+	head->next = e;
+	ctx->hash_size += sizeof(hash_entry);
+
+	return CSS_OK;
+}
+
+/**
+ * Copy one table's entries into another.
+ *
+ * The attribute table is fixed at CSS_SELECTOR_HASH_SLOTS in every
+ * hash and select.c works out the slot itself, so its entries keep
+ * their slot; the others are refiled by key, since the tables grow.
+ */
+static css_error _merge_table(css_selector_hash *ctx, hash_t *to,
+		const hash_t *from, uint32_t seq, bool same_slot)
+{
+	size_t i;
+
+	for (i = 0; i < from->n_slots; i++) {
+		const hash_entry *e = &from->slots[i];
+
+		if (e->sel == NULL)
+			continue;
+
+		for (; e != NULL; e = e->next) {
+			uint32_t slot = same_slot ? (uint32_t) i :
+					(_entry_key(to->kind, e->sel) &
+					 (uint32_t) (to->n_slots - 1));
+			css_error error = _push_copy(ctx, &to->slots[slot],
+					e, seq);
+
+			if (error != CSS_OK)
+				return error;
+			to->n_entries++;
+		}
+	}
+
+	return CSS_OK;
+}
+
+/** Copy one chain onto another. */
+static css_error _merge_chain(css_selector_hash *ctx, hash_entry *to,
+		const hash_entry *from, uint32_t seq)
+{
+	const hash_entry *e;
+
+	if (from->sel == NULL)
+		return CSS_OK;
+
+	for (e = from; e != NULL; e = e->next) {
+		css_error error = _push_copy(ctx, to, e, seq);
+
+		if (error != CSS_OK)
+			return error;
+	}
+
+	return CSS_OK;
+}
+
+/** Put every chain of a table in order. */
+static css_error _sort_table(hash_t *h)
+{
+	size_t i;
+
+	for (i = 0; i < h->n_slots; i++) {
+		css_error error = _sort_chain(&h->slots[i]);
+
+		if (error != CSS_OK)
+			return error;
+	}
+
+	return CSS_OK;
+}
+
+/* exported: see select/hash.h (VitaSurf) */
+css_error css__selector_hash_merge(css_selector_hash **out,
+		const css_selector_hash *const *parts, const uint32_t *seqs,
+		uint32_t n)
+{
+	css_selector_hash *h;
+	size_t te = 0, tc = 0, ti = 0;
+	uint32_t i;
+	css_error error;
+
+	if (out == NULL || (n > 0 && (parts == NULL || seqs == NULL)))
+		return CSS_BADPARM;
+
+	error = css__selector_hash_create(&h);
+	if (error != CSS_OK)
+		return error;
+	h->merged = true;
+
+	for (i = 0; i < n; i++) {
+		te += parts[i]->elements.n_entries;
+		tc += parts[i]->classes.n_entries;
+		ti += parts[i]->ids.n_entries;
+	}
+
+	error = _size_table(h, &h->elements, te);
+	if (error == CSS_OK)
+		error = _size_table(h, &h->classes, tc);
+	if (error == CSS_OK)
+		error = _size_table(h, &h->ids, ti);
+	if (error != CSS_OK)
+		goto fail;
+
+	for (i = 0; i < n; i++) {
+		const css_selector_hash *p = parts[i];
+
+		error = _merge_table(h, &h->elements, &p->elements,
+				seqs[i], false);
+		if (error == CSS_OK)
+			error = _merge_table(h, &h->classes, &p->classes,
+					seqs[i], false);
+		if (error == CSS_OK)
+			error = _merge_table(h, &h->ids, &p->ids,
+					seqs[i], false);
+		if (error == CSS_OK)
+			error = _merge_table(h, &h->attrs, &p->attrs,
+					seqs[i], true);
+		if (error == CSS_OK)
+			error = _merge_chain(h, &h->universal,
+					&p->universal, seqs[i]);
+		if (error == CSS_OK)
+			error = _merge_chain(h, &h->universal_state,
+					&p->universal_state, seqs[i]);
+		if (error != CSS_OK)
+			goto fail;
+	}
+
+	error = _sort_table(&h->elements);
+	if (error == CSS_OK)
+		error = _sort_table(&h->classes);
+	if (error == CSS_OK)
+		error = _sort_table(&h->ids);
+	if (error == CSS_OK)
+		error = _sort_table(&h->attrs);
+	if (error == CSS_OK)
+		error = _sort_chain(&h->universal);
+	if (error == CSS_OK)
+		error = _sort_chain(&h->universal_state);
+	if (error != CSS_OK)
+		goto fail;
+
+	*out = h;
+	return CSS_OK;
+
+fail:
+	css__selector_hash_destroy(h);
+	return error;
+}
+
+/* exported: see select/hash.h (VitaSurf) */
+void css__selector_hash_stats(const css_selector_hash *hash,
+		uint32_t *entries, uint32_t *bytes)
+{
+	uint32_t n = 0;
+	const hash_entry *e;
+
+	if (hash == NULL) {
+		*entries = 0;
+		*bytes = 0;
+		return;
+	}
+
+	n = (uint32_t) (hash->elements.n_entries + hash->classes.n_entries +
+			hash->ids.n_entries + hash->attrs.n_entries);
+	for (e = &hash->universal; e != NULL && e->sel != NULL; e = e->next)
+		n++;
+	for (e = &hash->universal_state; e != NULL && e->sel != NULL;
+			e = e->next)
+		n++;
+
+	*entries = n;
+	*bytes = (uint32_t) hash->hash_size;
+}
