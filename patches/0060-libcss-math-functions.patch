+		case CALC_MIN: /* fallthrough */
+		case CALC_MAX: {
+			/*
+			 * min() and max() (VitaSurf). Both sides are
+			 * normalised to absolute units by the time they
+			 * reach the stack, so they compare directly; a
+			 * plain number cannot be compared with a length,
+			 * which is what the spec says too.
+			 */
+			unit u_left, u_right;
+			css_fixed v_left, v_right;
+			bool take_right;
+
+			CALC_POP(u_right, v_right);
+			CALC_POP(u_left, v_left);
+
+			if ((u_left == UNIT_CALC_NUMBER) !=
+					(u_right == UNIT_CALC_NUMBER)) {
+				return CSS_INVALID;
+			}
+
+			take_right = (op == CALC_MIN) ?
+					(v_right < v_left) :
+					(v_right > v_left);
+
+			if (take_right) {
+				CALC_PUSH(u_right, v_right);
+			} else {
+				CALC_PUSH(u_left, v_left);
+			}
+			break;
+		}
