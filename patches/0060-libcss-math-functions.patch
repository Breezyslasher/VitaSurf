+static css_error css__parse_math_args(css_language *c,
+		enum css_properties_e property,
+		const parserutils_vector *vector, int *ctx,
+		parserutils_buffer *result, enum math_fn fn)
+{
+	css_code_t op = (fn == MATH_FN_MAX) ? CALC_MAX : CALC_MIN;
+	const css_token *token;
