+/*
+ * min(), max() and clamp() (VitaSurf).
+ *
+ * These are math functions like calc(), usable anywhere calc() is, and
+ * sites reach for them constantly now: min() and max() alone account for
+ * 390 uses across the stylesheets measured here, in width, padding,
+ * font-size and gap -- the properties that decide how big a box is. An
+ * unparsed one takes its whole declaration with it, so a page written
+ * with them lays out at the wrong size rather than merely looking wrong.
+ *
+ * They compile to the same stack machine calc() does, with two new
+ * operations that pop two values and push the smaller or the larger.
+ * clamp(lo, val, hi) is min() and max() in sequence: the three values go
+ * on the stack, MIN leaves min(val, hi), and MAX leaves the answer.
+ */
+enum math_fn {
+	MATH_FN_NONE,
+	MATH_FN_CALC,
+	MATH_FN_MIN,
+	MATH_FN_MAX,
+	MATH_FN_CLAMP
+};
+
+/** Which math function is this, if any? */
+static enum math_fn math_fn_of(lwc_string *name)
+{
+	if (name == NULL) {
+		return MATH_FN_NONE;
+	}
+	if (fn_name_is(name, "calc", 4)) {
+		return MATH_FN_CALC;
+	}
+	if (fn_name_is(name, "min", 3)) {
+		return MATH_FN_MIN;
+	}
+	if (fn_name_is(name, "max", 3)) {
+		return MATH_FN_MAX;
+	}
+	if (fn_name_is(name, "clamp", 5)) {
+		return MATH_FN_CLAMP;
+	}
+	return MATH_FN_NONE;
+}
+
+/* exported interface documented in parse/properties/utils.h */
+bool css__is_math_function(lwc_string *name)
+{
+	return math_fn_of(name) != MATH_FN_NONE;
+}
