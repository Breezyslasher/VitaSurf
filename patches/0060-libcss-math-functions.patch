+			parserutils_buffer_append(result,
+				(const uint8_t *)&mn, sizeof(mn)));
+		if (error != CSS_OK) {
+			return error;
+		}
+		error = css_error_from_parserutils_error(
+			parserutils_buffer_append(result,
+				(const uint8_t *)&mx, sizeof(mx)));
+		if (error != CSS_OK) {
+			return error;
+		}
+	} else if (args < 1) {
+		return CSS_INVALID;
+	}
+
+	return CSS_OK;
+}
