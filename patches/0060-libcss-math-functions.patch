+		 * afterwards; min() and max() fold as they go, so any
+		 * number of values works and the stack never grows.
+		 */
+		if (fn != MATH_FN_CLAMP && args > 1) {
+			error = css_error_from_parserutils_error(
+				parserutils_buffer_append(result,
+					(const uint8_t *)&op, sizeof(op)));
+			if (error != CSS_OK) {
