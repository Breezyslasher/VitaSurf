+	u = browser_window_doc_url(bw, false);
+	if (u != NULL && nsurl_compare(u, url, NSURL_COMPLETE))
+		return bw;
+	u = browser_window_doc_url(bw, true);
+	if (u != NULL && nsurl_compare(u, url, NSURL_COMPLETE))
+		return bw;
