+
+/**
+ * A fetch's SameSite context (RFC 6265bis 5.2): a top-level navigation is
+ * same-site, and may carry Strict cookies when the user or a same-site
+ * page started it; any other request is same-site when its site is the
+ * site for cookies of the document that made it.
+ */
+static void fetch_cookie_context(struct fetch *fetch,
+				 struct urldb_cookie_context *ctx)
+{
+	char site[256], other[256];
+
+	ctx->same_site = true;
+	ctx->top_level = fetch->top_level;
+	ctx->safe_method = !fetch->unsafe_method;
+	ctx->strict_ok = true;
+
+	if (!urldb_site(fetch->url, site, sizeof(site)))
+		return;
+
+	if (fetch->top_level) {
+		if (fetch->referer != NULL &&
+		    urldb_site(fetch->referer, other, sizeof(other)) &&
+		    strcmp(other, site) != 0)
+			ctx->strict_ok = false;
+		return;
+	}
+
+	if (fetch->referer == NULL)
+		/* the browser's own request */
+		return;
+
+	if (fetch_cookie_site_cb != NULL) {
+		if (!fetch_cookie_site_cb(fetch->referer, other,
+					  sizeof(other))) {
+			/* a frame of another site than its top window's */
+			ctx->same_site = false;
+			return;
+		}
+	} else if (!urldb_site(fetch->referer, other, sizeof(other))) {
+		return;
+	}
+	ctx->same_site = (strcmp(other, site) == 0);
+}
+
+/* exported interface documented in content/fetch.h */
+bool fetch_cookie_site(nsurl *doc, char *site, size_t len)
+{
+	if (fetch_cookie_site_cb != NULL)
+		return fetch_cookie_site_cb(doc, site, len);
+	return urldb_site(doc, site, len);
+}
+
+/* exported interface documented in content/fetch.h */
+char *fetch_get_cookie_string(struct fetch *fetch)
+{
+	struct urldb_cookie_context ctx;
+
+	fetch_cookie_context(fetch, &ctx);
+	return urldb_get_cookie_for(fetch->url, true, &ctx);
+}
