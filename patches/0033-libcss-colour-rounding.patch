+/**
+ * Round a fixed point value to the nearest integer (VitaSurf).
+ *
+ * FIXTOINT truncates, and for a colour channel that is wrong: an alpha
+ * of 0.5 is 127.5 of 255 and truncates to 127, which reads back out of
+ * getComputedStyle as 0.498. A page that writes an alpha and compares
+ * what it is given back never matches.
+ *
+ * The rounding is done here rather than with FADD(v, F_0_5) because
+ * css_add_fixed's overflow check mis-fires when the two operands have
+ * different signs: it saturates -25.5 + 0.5 to INT_MAX, and a negative
+ * percentage that should clamp to 0 clamps to 255 instead.
+ */
+static int32_t fixed_round(css_fixed v)
+{
+	const int32_t half = 1 << (CSS_RADIX_POINT - 1);
+
+	if (v > INT32_MAX - half)
+		return INT32_MAX >> CSS_RADIX_POINT;
+
+	return (int32_t) ((v + half) >> CSS_RADIX_POINT);
+}
+
 static bool parse_rgb(
 		css_language *c,
 		const parserutils_vector *vector,
