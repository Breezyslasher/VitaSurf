+/**
+ * The hole a box's ring mask leaves (VitaSurf): libcss names the
+ * "gradient border" idiom, a solid mask layer in the content (or
+ * padding) box excluded from one over the whole box, as "ring:content"
+ * (or "ring:padding"), and the background is painted only between the
+ * border box and that box. Its corners are the border box's, less the
+ * distance in, as a background clipped to that box would have.
+ *
+ * \param box         the box
+ * \param border_box  its border box, in device pixels
+ * \param radii       its corners, or NULL for square ones
+ * \param scale       device pixels to a CSS pixel
+ * \param hole        set to the hole
+ * \param hole_radii  set to its corners
+ * \return true if the box has a ring mask
+ */
+static bool html_mask_ring(struct box *box, const struct rect *border_box,
+		const struct html_corner_radii *radii, float scale,
+		struct rect *hole, struct html_corner_radii *hole_radii)
+{
+	lwc_string *uri = NULL;
+	bool content;
+	int l, t, r, b;
+
+	if (box->type == BOX_TEXT || box->style == NULL ||
+			border_box == NULL ||
+			css_computed_mask_image(box->style, &uri) !=
+			CSS_MASK_IMAGE_IMAGE || uri == NULL ||
+			strncmp(lwc_string_data(uri), "ring:", 5) != 0)
+		return false;
+	content = strcmp(lwc_string_data(uri) + 5, "content") == 0;
+	l = box->border[LEFT].width + (content ? box->padding[LEFT] : 0);
+	t = box->border[TOP].width + (content ? box->padding[TOP] : 0);
+	r = box->border[RIGHT].width + (content ? box->padding[RIGHT] : 0);
+	b = box->border[BOTTOM].width + (content ? box->padding[BOTTOM] : 0);
+	l = (int) (l * scale);
+	t = (int) (t * scale);
+	r = (int) (r * scale);
+	b = (int) (b * scale);
+	hole->x0 = border_box->x0 + l;
+	hole->y0 = border_box->y0 + t;
+	hole->x1 = border_box->x1 - r;
+	hole->y1 = border_box->y1 - b;
+	memset(hole_radii, 0, sizeof(*hole_radii));
+	if (radii != NULL) {
+#define INNER(v, d) ((v) > (d) ? (v) - (d) : 0)
+		hole_radii->tl_h = INNER(radii->tl_h, l);
+		hole_radii->tl_v = INNER(radii->tl_v, t);
+		hole_radii->tr_h = INNER(radii->tr_h, r);
+		hole_radii->tr_v = INNER(radii->tr_v, t);
+		hole_radii->br_h = INNER(radii->br_h, r);
+		hole_radii->br_v = INNER(radii->br_v, b);
+		hole_radii->bl_h = INNER(radii->bl_h, l);
+		hole_radii->bl_v = INNER(radii->bl_v, b);
+#undef INNER
+	}
+	return true;
+}
