+/* exported function documented in html/private.h */
+void html_rounded_col_span(const struct rect *r,
+		const struct html_corner_radii *radii, int x,
+		int *y0, int *y1)
+{
+	/* a column of the box is a row of it turned about its diagonal,
+	 * which swaps each corner's radii and the top right corner with
+	 * the bottom left */
+	struct rect t = { r->y0, r->x0, r->y1, r->x1 };
+	struct html_corner_radii s = {
+		radii->tl_v, radii->tl_h,
+		radii->bl_v, radii->bl_h,
+		radii->br_v, radii->br_h,
+		radii->tr_v, radii->tr_h,
+	};
+
+	html_rounded_row_span(&t, &s, x, y0, y1);
+}
