+/** The tag of the weight axis of a variable font. */
+#define FB_WGHT_TAG FT_MAKE_TAG('w', 'g', 'h', 't')
+
+/**
+ * Whether a face is a variable font with a weight axis (VitaSurf).
+ */
+static bool fb_face_has_weight_axis(FT_Library library, FT_Face face)
+{
+	FT_MM_Var *mm;
+	bool found = false;
+	FT_UInt i;
+
+	if (!FT_HAS_MULTIPLE_MASTERS(face) || FT_Get_MM_Var(face, &mm) != 0)
+		return false;
+	for (i = 0; i < mm->num_axis; i++) {
+		if (mm->axis[i].tag == FB_WGHT_TAG)
+			found = true;
+	}
+	FT_Done_MM_Var(library, mm);
+	return found;
+}
+
+/**
+ * Set a variable font's weight axis (VitaSurf), clamped to its range,
+ * every other axis left at its default.
+ */
+static void fb_face_set_weight(FT_Library library, FT_Face face, int weight)
+{
+	FT_MM_Var *mm;
+	FT_Fixed coords[16];
+	FT_UInt i, n;
+
+	if (!FT_HAS_MULTIPLE_MASTERS(face) || FT_Get_MM_Var(face, &mm) != 0)
+		return;
+	n = mm->num_axis < 16 ? mm->num_axis : 16;
+	for (i = 0; i < n; i++) {
+		coords[i] = mm->axis[i].def;
+		if (mm->axis[i].tag == FB_WGHT_TAG) {
+			FT_Fixed w = (FT_Fixed) weight * 65536;
+
+			if (w < mm->axis[i].minimum)
+				w = mm->axis[i].minimum;
+			if (w > mm->axis[i].maximum)
+				w = mm->axis[i].maximum;
+			coords[i] = w;
+		}
+	}
+	if (FT_Set_Var_Design_Coordinates(face, n, coords) != 0) {
+		NSLOG(netsurf, INFO, "could not set weight %d", weight);
+	}
+	FT_Done_MM_Var(library, mm);
+}
