+/**
+ * A web face at a weight (VitaSurf): the face itself, unless it is a
+ * variable font, when it is an instance of it set to the nearest
+ * hundred, sharing its bytes. Each has its own entry in FreeType's
+ * cache, so its glyphs are kept apart from the other weights'.
+ */
+static fb_faceid_t *fb_web_face_weighted(struct fb_webface *wf, int weight)
+{
+	fb_faceid_t *f;
+	int slot;
+
+	if (!wf->face->variable)
+		return wf->face;
+	slot = (weight + 50) / 100;
+	if (slot < 1)
+		slot = 1;
+	if (slot > 9)
+		slot = 9;
+	if (wf->at_weight[slot - 1] != NULL)
+		return wf->at_weight[slot - 1];
+	f = calloc(1, sizeof(*f));
+	if (f == NULL)
+		return wf->face;
+	f->data = wf->face->data;
+	f->len = wf->face->len;
+	f->index = wf->face->index;
+	f->variable = true;
+	f->var_weight = slot * 100;
+	wf->at_weight[slot - 1] = f;
+	return f;
+}
