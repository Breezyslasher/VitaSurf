+/**
+ * Fill the part of a gradient strip inside a rounded shape (VitaSurf),
+ * a row at a time across a strip that runs along x, a column at a time
+ * across one that runs along y, each run of rows or columns with the
+ * same ends being one rectangle: between the corners that is the whole
+ * strip at once.
+ */
+static bool html_gradient_rounded_strip(const struct redraw_context *ctx,
+		const plot_style_t *style, const struct rect *strip,
+		const struct rect *area, const struct html_paint_shape *shape,
+		bool rows)
+{
+	static const struct html_corner_radii square;
+	const struct html_corner_radii *radii =
+			shape->radii != NULL ? shape->radii : &square;
+	int from = rows ? strip->y0 : strip->x0;
+	int to = rows ? strip->y1 : strip->x1;
+	int lo = rows ? strip->x0 : strip->y0;
+	int hi = rows ? strip->x1 : strip->y1;
+	int i, k, run_start = from;
+	int run[4] = { 0, 0, 0, 0 };
+	bool open = false;
+
+	for (i = from; i <= to; i++) {
+		int seg[4] = { 0, 0, 0, 0 };	/* up to two spans */
+
+		if (i < to) {
+			int a, b;
+
+			if (rows)
+				html_rounded_row_span(area, radii, i, &a, &b);
+			else
+				html_rounded_col_span(area, radii, i, &a, &b);
+			if (a < lo) a = lo;
+			if (b > hi) b = hi;
+			if (b < a) b = a;
+			seg[0] = a; seg[1] = b;
+			/* less the hole, where this line crosses it */
+			if (shape->hole != NULL && (rows ?
+					(i >= shape->hole->y0 &&
+					 i < shape->hole->y1) :
+					(i >= shape->hole->x0 &&
+					 i < shape->hole->x1))) {
+				int ha, hb;
+
+				if (rows)
+					html_rounded_row_span(shape->hole,
+						shape->hole_radii, i, &ha, &hb);
+				else
+					html_rounded_col_span(shape->hole,
+						shape->hole_radii, i, &ha, &hb);
+				if (hb > ha && hb > a && ha < b) {
+					seg[1] = ha > a ? ha : a;
+					seg[2] = hb < b ? hb : b;
+					seg[3] = b;
+				}
+			}
+			if (open && memcmp(seg, run, sizeof(seg)) == 0)
+				continue;
+		}
+		if (open) {
+			for (k = 0; k < 4; k += 2) {
+				struct rect q;
+
+				if (run[k + 1] <= run[k])
+					continue;
+				if (rows) {
+					q.x0 = run[k]; q.x1 = run[k + 1];
+					q.y0 = run_start; q.y1 = i;
+				} else {
+					q.y0 = run[k]; q.y1 = run[k + 1];
+					q.x0 = run_start; q.x1 = i;
+				}
+				if (ctx->plot->rectangle(ctx, style, &q) !=
+						NSERROR_OK)
+					return false;
+			}
+		}
+		open = true;
+		run_start = i;
+		memcpy(run, seg, sizeof(run));
+	}
+	return true;
+}
