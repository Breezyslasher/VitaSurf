+/* exported function documented in html/private.h */
+void html_rounded_row_span(const struct rect *r,
+		const struct html_corner_radii *radii, int y,
+		int *x0, int *x1)
+{
+	float yc = (float)y + 0.5f, left = (float)r->x0;
+	float right = (float)r->x1, d, e;
+
+	if (radii->tl_h > 0 && radii->tl_v > 0 &&
+	    yc < (float)(r->y0 + radii->tl_v)) {
+		d = ((float)(r->y0 + radii->tl_v) - yc) / (float)radii->tl_v;
+		e = (float)r->x0 + (float)radii->tl_h *
+			(1.0f - sqrtf(1.0f - d * d));
+		if (e > left) left = e;
+	}
+	if (radii->bl_h > 0 && radii->bl_v > 0 &&
+	    yc > (float)(r->y1 - radii->bl_v)) {
+		d = (yc - (float)(r->y1 - radii->bl_v)) / (float)radii->bl_v;
+		e = (float)r->x0 + (float)radii->bl_h *
+			(1.0f - sqrtf(1.0f - d * d));
+		if (e > left) left = e;
+	}
+	if (radii->tr_h > 0 && radii->tr_v > 0 &&
+	    yc < (float)(r->y0 + radii->tr_v)) {
+		d = ((float)(r->y0 + radii->tr_v) - yc) / (float)radii->tr_v;
+		e = (float)r->x1 - (float)radii->tr_h *
+			(1.0f - sqrtf(1.0f - d * d));
+		if (e < right) right = e;
+	}
+	if (radii->br_h > 0 && radii->br_v > 0 &&
+	    yc > (float)(r->y1 - radii->br_v)) {
+		d = (yc - (float)(r->y1 - radii->br_v)) / (float)radii->br_v;
+		e = (float)r->x1 - (float)radii->br_h *
+			(1.0f - sqrtf(1.0f - d * d));
+		if (e < right) right = e;
+	}
+	*x0 = (int)(left + 0.5f);
+	*x1 = (int)(right + 0.5f);
+}
