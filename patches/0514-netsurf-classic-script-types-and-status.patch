+/**
+ * Whether a classic script sent as type may run (VitaSurf): the Fetch
+ * standard blocks one sent as an image, audio, video or CSV type, and
+ * with "X-Content-Type-Options: nosniff" any type but JavaScript's;
+ * whatever else it is sent as, or nothing, it runs. NetSurf had run
+ * text/javascript and application/javascript alone, so a server that
+ * sent a script as text/plain or application/octet-stream left the
+ * page without it.
+ */
+static bool hlcache_classic_script_runs(hlcache_retrieval_ctx *ctx,
+		lwc_string *type)
+{
+	const char *t = type != NULL ? lwc_string_data(type) : "";
+	const char *nosniff = llcache_handle_get_header(ctx->llcache,
+			"X-Content-Type-Options");
+
+	if (strncasecmp(t, "image/", 6) == 0 ||
+			strncasecmp(t, "audio/", 6) == 0 ||
+			strncasecmp(t, "video/", 6) == 0 ||
+			strcasecmp(t, "text/csv") == 0)
+		return false;
+	if (nosniff != NULL) {
+		while (*nosniff == ' ' || *nosniff == '\t')
+			nosniff++;
+		if (strncasecmp(nosniff, "nosniff", 7) == 0 &&
+				(nosniff[7] == '\0' || nosniff[7] == ',' ||
+				 nosniff[7] == ' ' || nosniff[7] == ';'))
+			return false;
+	}
+	return true;
+}
