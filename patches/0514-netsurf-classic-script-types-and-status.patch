 static nserror hlcache_migrate_ctx(hlcache_retrieval_ctx *ctx,
 		lwc_string *effective_type)
 {
 	content_type type = CONTENT_NONE;
 	nserror error = NSERROR_OK;
+	lwc_string *as_script = NULL;
 
 	ctx->migrate_target = true;
 
+	/* a script whose answer is not a success has nothing to run, and
+	 * its element is told error: a 404 page had been run as script,
+	 * or refused only for being HTML (VitaSurf) */
+	if (ctx->accepted_types == CONTENT_SCRIPT) {
+		long code = llcache_handle_get_http_code(ctx->llcache);
+
+		if (code != 0 && (code < 200 || code > 299)) {
+			if (ctx->handle->cb != NULL) {
+				hlcache_event hlevent;
+				static char why[48];
+
+				snprintf(why, sizeof(why),
+					 "the server answered %ld", code);
+				hlevent.type = CONTENT_MSG_ERROR;
+				hlevent.data.errordata.errorcode =
+						NSERROR_NOT_FOUND;
+				hlevent.data.errordata.errormsg = why;
+				ctx->handle->cb(ctx->handle, &hlevent,
+						ctx->handle->pw);
+			}
+			llcache_handle_abort(ctx->llcache);
+			llcache_handle_release(ctx->llcache);
+			goto done;
+		}
+	}
+
+	/* a classic script sent as something else is still one */
+	if ((ctx->flags & HLCACHE_RETRIEVE_CLASSIC_SCRIPT) &&
+			(effective_type == NULL ||
+			 !hlcache_type_is_acceptable(effective_type,
+					ctx->accepted_types, &type)) &&
+			hlcache_classic_script_runs(ctx, effective_type) &&
+			lwc_intern_string("text/javascript", 15,
+					&as_script) == lwc_error_ok) {
+		effective_type = as_script;
+		type = CONTENT_NONE;
+	}
+
 	if ((effective_type != NULL) &&
 	    hlcache_type_is_acceptable(effective_type,
 				       ctx->accepted_types,
@@ -471,7 +544,10 @@ static nserror hlcache_migrate_ctx(hlcache_retrieval_ctx *ctx,
 		llcache_handle_release(ctx->llcache);
 	}
 
+done:
 	ctx->migrate_target = false;
+	if (as_script != NULL)
+		lwc_string_unref(as_script);
 
 	/* No longer require retrieval context */
 	RING_REMOVE(hlcache->retrieval_ctx_ring, ctx);
