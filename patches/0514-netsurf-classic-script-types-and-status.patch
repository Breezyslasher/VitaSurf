 /* See llcache.h for documentation */
+/* exported interface documented in content/llcache.h (VitaSurf) */
+long llcache_handle_get_http_code(const llcache_handle *handle)
+{
+	const llcache_object *object = handle->object;
+
+	if (object == NULL)
+		return 0;
+	/* the fetch has it once its headers are in, before any data */
+	if (object->fetch.fetch != NULL &&
+			fetch_http_code(object->fetch.fetch) != 0)
+		return fetch_http_code(object->fetch.fetch);
+	return object->http_code;
+}
