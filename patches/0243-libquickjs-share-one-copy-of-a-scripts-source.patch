+/*
+ * The text of one script, shared by every function compiled from it
+ * (VitaSurf). Each function used to keep its own copy of its source for
+ * Function.prototype.toString, and a nested function's text is inside
+ * its parent's, so a bundle was held once per level of nesting: 35-47%
+ * of all the memory compiling a large bundle took. Now the script is
+ * copied once, the first time a function needs it, and each function
+ * points into that copy.
+ */
+typedef struct JSSourceBlob {
+    int ref_count;
+    int len;
+    char data[];
+} JSSourceBlob;
+
+static void js_source_release(JSRuntime *rt, JSSourceBlob *blob, char *source)
+{
+    if (blob) {
+        if (--blob->ref_count == 0)
+            js_free_rt(rt, blob);
+    } else {
+        js_free_rt(rt, source);
+    }
+}
