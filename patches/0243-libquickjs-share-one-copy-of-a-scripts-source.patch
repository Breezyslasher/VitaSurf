+/*
+ * Record where a function's source is (VitaSurf): a place in the one copy
+ * of the input this parse shares out, made the first time it is asked
+ * for, rather than a copy of the function's own text.
+ */
+static int js_parse_save_source(JSParseState *s, JSFunctionDef *fd,
+                                const uint8_t *start, size_t len)
+{
+    JSContext *ctx = s->ctx;
+    JSSourceBlob *blob = s->source_blob;
+
+    if (start < s->buf_start || len > (size_t)(s->buf_end - start)) {
+        /* not in this parse's input: keep a copy of its own */
+        char *copy = js_strndup(ctx, (const char *)start, len);
+        if (!copy)
+            return -1;
+        js_source_release(ctx->rt, fd->source_blob, fd->source);
+        fd->source_blob = NULL;
+        fd->source = copy;
+        fd->source_len = len;
+        return 0;
+    }
+    if (!blob) {
+        size_t n = s->buf_end - s->buf_start;
+        if (n > INT32_MAX)
+            return -1;
+        blob = js_malloc(ctx, sizeof(*blob) + n + 1);
+        if (!blob)
+            return -1;
+        blob->ref_count = 1; /* the parser's own hold */
+        blob->len = n;
+        memcpy(blob->data, s->buf_start, n);
+        blob->data[n] = '\0';
+        s->source_blob = blob;
+    }
+    blob->ref_count++;
+    js_source_release(ctx->rt, fd->source_blob, fd->source);
+    fd->source_blob = blob;
+    fd->source = blob->data + (start - s->buf_start);
+    fd->source_len = len;
+    return 0;
+}
