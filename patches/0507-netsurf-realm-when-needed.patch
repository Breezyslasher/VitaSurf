+/** Whether an element has an inline event handler, an on* attribute. */
+static bool element_has_handler(dom_node *node)
+{
+	dom_namednodemap *attrs = NULL;
+	uint32_t n = 0, i;
+	bool has = false, found = false;
+
+	if (dom_node_has_attributes(node, &has) != DOM_NO_ERR || !has ||
+	    dom_node_get_attributes(node, &attrs) != DOM_NO_ERR ||
+	    attrs == NULL) {
+		return false;
+	}
+	(void) dom_namednodemap_get_length(attrs, &n);
+	for (i = 0; i < n && !found; i++) {
+		dom_node *attr = NULL;
+		dom_string *name = NULL;
+
+		if (dom_namednodemap_item(attrs, i, &attr) != DOM_NO_ERR ||
+		    attr == NULL) {
+			continue;
+		}
+		if (dom_attr_get_name((dom_attr *) attr, &name) == DOM_NO_ERR &&
+		    name != NULL) {
+			const char *s = dom_string_data(name);
+
+			found = dom_string_byte_length(name) > 2 &&
+				(s[0] == 'o' || s[0] == 'O') &&
+				(s[1] == 'n' || s[1] == 'N');
+			dom_string_unref(name);
+		}
+		dom_node_unref(attr);
+	}
+	dom_namednodemap_unref(attrs);
+	return found;
+}
