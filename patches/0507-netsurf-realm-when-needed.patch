 /* exported function documented in html/private.h */
+/*
+ * A page's script realm is made when something first needs it
+ * (VitaSurf): a script to run, an inline handler, an activation or a
+ * form the prelude does for the page, or another realm reaching this
+ * window. Every document had been given one as its first element was
+ * parsed, and 43 of the 77 realms that reached their load event in
+ * build 793's site test ran no script of their own, ad and tracking
+ * frames mostly, each 280 ms of prelude and some 2.6 MB of heap.
+ *
+ * The window still learns at the first element that the page commits,
+ * which is when the page it replaces is frozen.
+ */
+void html_script_commit(html_content *c)
+{
+	union content_msg_data msg_data;
+
+	if (c->realm_committed || !c->enable_scripting) {
+		return;
+	}
+	c->realm_committed = true;
+	/* no thread asked for: only the commit */
+	msg_data.jsthread = NULL;
+	content_broadcast(&c->base, CONTENT_MSG_GETTHREAD, &msg_data);
+}
+
+bool html_script_realm(html_content *c)
+{
+	union content_msg_data msg_data;
+
+	if (c->jsthread != NULL) {
+		return true;
+	}
+	/* and not again while the window is making it */
+	if (!c->enable_scripting || c->aborted || c->realm_making) {
+		return false;
+	}
+	html_script_commit(c);
+	msg_data.jsthread = &c->jsthread;
+	c->realm_making = true;
+	content_broadcast(&c->base, CONTENT_MSG_GETTHREAD, &msg_data);
+	c->realm_making = false;
+	NSLOG(netsurf, INFO, "javascript context: %p (htmlc: %p)",
+	      c->jsthread, c);
+	return c->jsthread != NULL;
+}
