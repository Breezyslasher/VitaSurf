+/**
+ * Whether a click on node has an activation the prelude runs (VitaSurf):
+ * it is in a label or a details element's summary, or in an element
+ * with a popovertarget. A page with no realm gets one for these only.
+ */
+static bool activation_wants_script(struct dom_node *node)
+{
+	dom_node *n = node, *next;
+	int depth = 0;
+
+	dom_node_ref(n);
+	while (n != NULL && depth++ < 64) {
+		dom_node_type type = DOM_ELEMENT_NODE;
+		dom_string *name = NULL;
+		bool want = false, has = false;
+
+		if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE) {
+			if (dom_node_get_node_name(n, &name) == DOM_NO_ERR &&
+			    name != NULL) {
+				size_t len = dom_string_byte_length(name);
+				const char *s = dom_string_data(name);
+
+				want = (len == 5 &&
+					strncasecmp(s, "label", 5) == 0) ||
+					(len == 7 &&
+					 strncasecmp(s, "summary", 7) == 0);
+				dom_string_unref(name);
+			}
+			if (!want && dom_element_has_attribute(n,
+					corestring_dom_popovertarget,
+					&has) == DOM_NO_ERR) {
+				want = has;
+			}
+		}
+		if (want) {
+			dom_node_unref(n);
+			return true;
+		}
+		if (dom_node_get_parent_node(n, &next) != DOM_NO_ERR) {
+			next = NULL;
+		}
+		dom_node_unref(n);
+		n = next;
+	}
+	if (n != NULL) {
+		dom_node_unref(n);
+	}
+	return false;
+}
