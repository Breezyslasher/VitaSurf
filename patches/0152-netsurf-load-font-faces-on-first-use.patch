 /**
- * create new framebuffer face and cause it to be loaded to check its ok
+ * Load a face the first time it is wanted (VitaSurf), and say whether
+ * it can be used. A face that FreeType will not parse says so once, and
+ * the caller falls back to the sans face as fb_font_init used to.
+ */
+static bool fb_face_ready(fb_faceid_t *fb_face)
+{
+	FT_Face aface;
+
+	if (fb_face == NULL) {
+		return false;
+	}
+	if (fb_face->checked == false) {
+		fb_face->checked = true;
+		fb_face->ok = FTC_Manager_LookupFace(ft_cmanager,
+				(FTC_FaceID) fb_face, &aface) == 0;
+		if (fb_face->ok == false) {
+			NSLOG(netsurf, INFO, "Could not load font face %s",
+			      fb_face->fontfile != NULL ?
+			      fb_face->fontfile : "memory");
+		}
+	}
+	return fb_face->ok;
+}
+
