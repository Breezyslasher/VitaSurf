diff --git a/desktop/browser_window.c b/desktop/browser_window.c
index 461e0b307..acc9643c1 100644
--- a/desktop/browser_window.c
+++ b/desktop/browser_window.c
@@ -5292,6 +5292,25 @@ bool browser_window_scripts_frozen(struct browser_window *bw,
 		    hlcache_handle_get_content(w->loading_content) != c) {
 			return true;
 		}
+		/*
+		 * From the start of a load the browser began itself --
+		 * typed, a menu, a bookmark, history: no referrer, and no
+		 * page's script -- not only from its commit (VitaSurf). The
+		 * page being left goes whatever it does, and here it runs
+		 * on the one thread the load needs: nytimes.com, left for
+		 * github.com, ran a timer of 59 s before the new page's
+		 * answer could be read, and five sites in a row timed out
+		 * behind it. A navigation a page's script asked for leaves
+		 * it running until the commit, as before.
+		 */
+		if (w->loading_content != NULL &&
+		    w->loading_parameters.url != NULL &&
+		    w->loading_parameters.referrer == NULL &&
+		    (w->loading_parameters.flags & BW_NAVIGATE_SCRIPT) == 0 &&
+		    w->current_content != NULL &&
+		    hlcache_handle_get_content(w->loading_content) != c) {
+			return true;
+		}
 	}
 	return false;
 }
