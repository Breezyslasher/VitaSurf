+	/*
+	 * The key events go to whatever has the focus, as they do in
+	 * any browser, and only to the root element when nothing does
+	 * (VitaSurf). They used to go to the root always, so a listener
+	 * on a text field, which is where a page puts one, never heard
+	 * a key at all: a search box that filters as you type, a form
+	 * that submits on Enter and a dialog that closes on Escape all
+	 * did nothing. keyup follows the default action, as the spec
+	 * orders them; keypress goes with keydown for the printable
+	 * keys that still have one.
+	 */
+	target = html_focused_node(html);
+	if (target == NULL && html->layout != NULL) {
+		target = html->layout->node;
 	}
+	if (html_key_is_command(key)) {
+		/* a clipboard or editing command a front end sends as a
+		 * key value of its own; no key on a keyboard says this,
+		 * so the page hears nothing (VitaSurf) */
+		target = NULL;
+	}
+
+	if (target != NULL) {
+		if (fire_dom_keyboard_event(corestring_dom_keydown,
+				target, true, true, key) == false &&
+		    html_key_is_navigation(key) == false) {
+			/*
+			 * The page handled it itself. The keys that move
+			 * about the page are the exception: the Vita has
+			 * only a D-pad to move the focus with, and a page
+			 * that takes the arrow keys for itself would
+			 * leave nothing to browse with (VitaSurf).
+			 */
+			return true;
+		}
+		if (key >= 0x0020 && key != 0x007F) {
+			fire_dom_keyboard_event(corestring_dom_keypress,
