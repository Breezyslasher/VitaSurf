+static bool html_keypress_default(html_content *html, uint32_t key);
+
+
+/**
+ * Whether a key value stands for an editing command rather than a key
+ * (VitaSurf).
+ */
+static bool html_key_is_command(uint32_t key)
+{
+	switch (key) {
+	case NS_KEY_SELECT_ALL:
+	case NS_KEY_COPY_SELECTION:
+	case NS_KEY_DELETE_LINE:
+	case NS_KEY_PASTE:
+	case NS_KEY_CUT_SELECTION:
+	case NS_KEY_CLEAR_SELECTION:
+	case NS_KEY_WORD_LEFT:
+	case NS_KEY_DELETE_WORD_LEFT:
+	case NS_KEY_WORD_RIGHT:
+	case NS_KEY_DELETE_WORD_RIGHT:
+	case NS_KEY_DELETE_LINE_END:
+	case NS_KEY_DELETE_LINE_START:
+	case NS_KEY_UNDO:
+	case NS_KEY_REDO:
+		return true;
+	default:
+		return false;
+	}
+}
+
+
+/**
+ * Whether a key is one the browser itself moves about with (VitaSurf).
+ */
+static bool html_key_is_navigation(uint32_t key)
+{
+	switch (key) {
+	case NS_KEY_LEFT:
+	case NS_KEY_RIGHT:
+	case NS_KEY_UP:
+	case NS_KEY_DOWN:
+	case NS_KEY_PAGE_UP:
+	case NS_KEY_PAGE_DOWN:
+	case NS_KEY_TEXT_START:
+	case NS_KEY_TEXT_END:
+	case NS_KEY_LINE_START:
+	case NS_KEY_LINE_END:
+		return true;
+	default:
+		return false;
+	}
+}
+
+
+/* Exported interface, documented in html/private.h */
+dom_node *html_focused_node(html_content *html)
+{
+	switch (html->focus_type) {
+	case HTML_FOCUS_TEXTAREA:
+		if (html->focus_owner.textarea != NULL &&
+		    html->focus_owner.textarea->gadget != NULL) {
+			return (dom_node *)
+				html->focus_owner.textarea->gadget->node;
+		}
+		return NULL;
+
+	case HTML_FOCUS_CONTENT:
+		if (html->focus_owner.content != NULL) {
+			return html->focus_owner.content->node;
+		}
+		return NULL;
+
+	default:
+		return NULL;
+	}
+}
+
