diff --git a/src/parse/properties/border_radius.c b/src/parse/properties/border_radius.c
new file mode 100644
index 0000000..782c45a
--- /dev/null
+++ b/src/parse/properties/border_radius.c
@@ -0,0 +1,314 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/*
+ * Rounded corners (VitaSurf).
+ *
+ * Every corner carries two radii, horizontal and vertical, so that an
+ * ellipse can be described as well as a circle. A percentage is left as
+ * a percentage here: the horizontal one resolves against the box's width
+ * and the vertical one against its height, and neither is known until
+ * layout.
+ */
+
+/**
+ * Parse one corner's radii: <length-percentage>{1,2}
+ *
+ * A single value is used for both axes, which is the round corner
+ * everyone actually writes.
+ */
+static css_error parse_corner_radii(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_fixed *length, uint32_t *unit)
+{
+	const css_token *token;
+	css_error error;
+
+	error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+			&length[0], &unit[0]);
+	if (error != CSS_OK) {
+		return error;
+	}
+
+	if ((unit[0] & UNIT_ANGLE) || (unit[0] & UNIT_TIME) ||
+			(unit[0] & UNIT_FREQ) || length[0] < 0) {
+		return CSS_INVALID;
+	}
+
+	length[1] = length[0];
+	unit[1] = unit[0];
+
+	consumeWhitespace(vector, ctx);
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && tokenIsChar(token, '/') == false &&
+			tokenIsChar(token, '!') == false) {
+		int32_t before = *ctx;
+
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				&length[1], &unit[1]);
+		if (error != CSS_OK) {
+			/* not a second radius, which is allowed */
+			*ctx = before;
+			length[1] = length[0];
+			unit[1] = unit[0];
+			return CSS_OK;
+		}
+
+		if ((unit[1] & UNIT_ANGLE) || (unit[1] & UNIT_TIME) ||
+				(unit[1] & UNIT_FREQ) || length[1] < 0) {
+			return CSS_INVALID;
+		}
+
+		consumeWhitespace(vector, ctx);
+	}
+
+	return CSS_OK;
+}
+
+/** Write one corner property, either a flag value or a pair of radii. */
+static css_error append_corner(css_style *result, enum css_properties_e prop,
+		css_fixed hlength, uint32_t hunit,
+		css_fixed vlength, uint32_t vunit)
+{
+	css_error error;
+
+	error = css__stylesheet_style_appendOPV(result, prop, 0,
+			BORDER_RADIUS_SET);
+	if (error != CSS_OK) {
+		return error;
+	}
+
+	return css__stylesheet_style_vappend(result, 4,
+			hlength, hunit, vlength, vunit);
+}
+
+/**
+ * Parse one border-*-radius longhand.
+ */
+static css_error parse_one_radius(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, enum css_properties_e prop)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_fixed length[2] = { 0, 0 };
+	uint32_t unit[2] = { 0, 0 };
+	enum flag_value flag_value;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+	}
+
+	error = parse_corner_radii(c, vector, ctx, length, unit);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	error = append_corner(result, prop, length[0], unit[0],
+			length[1], unit[1]);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+	}
+
+	return error;
+}
+
+css_error css__parse_border_top_left_radius(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_one_radius(c, vector, ctx, result,
+			CSS_PROP_BORDER_TOP_LEFT_RADIUS);
+}
+
+css_error css__parse_border_top_right_radius(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_one_radius(c, vector, ctx, result,
+			CSS_PROP_BORDER_TOP_RIGHT_RADIUS);
+}
+
+css_error css__parse_border_bottom_right_radius(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_one_radius(c, vector, ctx, result,
+			CSS_PROP_BORDER_BOTTOM_RIGHT_RADIUS);
+}
+
+css_error css__parse_border_bottom_left_radius(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_one_radius(c, vector, ctx, result,
+			CSS_PROP_BORDER_BOTTOM_LEFT_RADIUS);
+}
+
+/** The corners in the order the shorthand names them. */
+static const enum css_properties_e corner_props[4] = {
+	CSS_PROP_BORDER_TOP_LEFT_RADIUS,
+	CSS_PROP_BORDER_TOP_RIGHT_RADIUS,
+	CSS_PROP_BORDER_BOTTOM_RIGHT_RADIUS,
+	CSS_PROP_BORDER_BOTTOM_LEFT_RADIUS
+};
+
+/**
+ * Read up to four radii and spread them over the corners.
+ *
+ * One value goes to every corner, two are top-left/bottom-right then
+ * top-right/bottom-left, three name the fourth from the second, and
+ * four are given in order.
+ */
+static css_error parse_radius_list(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_fixed *length, uint32_t *unit)
+{
+	const css_token *token;
+	int n = 0;
+	css_error error;
+
+	while (n < 4) {
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '/') ||
+				tokenIsChar(token, '!')) {
+			break;
+		}
+
+		error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+				&length[n], &unit[n]);
+		if (error != CSS_OK) {
+			if (n == 0) {
+				return error;
+			}
+			break;
+		}
+
+		if ((unit[n] & UNIT_ANGLE) || (unit[n] & UNIT_TIME) ||
+				(unit[n] & UNIT_FREQ) || length[n] < 0) {
+			return CSS_INVALID;
+		}
+
+		n++;
+		consumeWhitespace(vector, ctx);
+	}
+
+	if (n == 0) {
+		return CSS_INVALID;
+	}
+
+	/* fill the corners the author left out */
+	if (n == 1) {
+		length[1] = length[2] = length[3] = length[0];
+		unit[1] = unit[2] = unit[3] = unit[0];
+	} else if (n == 2) {
+		length[2] = length[0];
+		unit[2] = unit[0];
+		length[3] = length[1];
+		unit[3] = unit[1];
+	} else if (n == 3) {
+		length[3] = length[1];
+		unit[3] = unit[1];
+	}
+
+	return CSS_OK;
+}
+
+/**
+ * Parse the border-radius shorthand.
+ *
+ * border-radius: <length-percentage>{1,4} [ / <length-percentage>{1,4} ]?
+ */
+css_error css__parse_border_radius(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_fixed hlength[4] = { 0, 0, 0, 0 };
+	uint32_t hunit[4] = { 0, 0, 0, 0 };
+	css_fixed vlength[4] = { 0, 0, 0, 0 };
+	uint32_t vunit[4] = { 0, 0, 0, 0 };
+	enum flag_value flag_value;
+	css_error error;
+	int i;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		for (i = 0; i < 4; i++) {
+			error = css_stylesheet_style_flag_value(result,
+					flag_value, corner_props[i]);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+		}
+		return CSS_OK;
+	}
+
+	error = parse_radius_list(c, vector, ctx, hlength, hunit);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+
+	/* The vertical radii, if the author gave any, follow a slash. */
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && tokenIsChar(token, '/')) {
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+
+		error = parse_radius_list(c, vector, ctx, vlength, vunit);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	} else {
+		for (i = 0; i < 4; i++) {
+			vlength[i] = hlength[i];
+			vunit[i] = hunit[i];
+		}
+	}
+
+	for (i = 0; i < 4; i++) {
+		error = append_corner(result, corner_props[i],
+				hlength[i], hunit[i], vlength[i], vunit[i]);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	}
+
+	return CSS_OK;
+}
