diff --git a/src/select/properties/border_bottom_left_radius.c b/src/select/properties/border_bottom_left_radius.c
new file mode 100644
index 0000000..c62966c
--- /dev/null
+++ b/src/select/properties/border_bottom_left_radius.c
@@ -0,0 +1,97 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* Rounded corners (VitaSurf): a horizontal and a vertical radius. */
+
+css_error css__cascade_border_bottom_left_radius(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_BORDER_BOTTOM_LEFT_RADIUS_INHERIT;
+	css_fixed hlength = 0;
+	css_fixed vlength = 0;
+	uint32_t hunit = UNIT_PX;
+	uint32_t vunit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false) {
+		value = CSS_BORDER_BOTTOM_LEFT_RADIUS_SET;
+
+		hlength = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(hlength));
+		hunit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(hunit));
+
+		vlength = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(vlength));
+		vunit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(vunit));
+	}
+
+	hunit = css__to_css_unit(hunit);
+	vunit = css__to_css_unit(vunit);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_border_bottom_left_radius(state->computed, value,
+				hlength, hunit, vlength, vunit);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_border_bottom_left_radius_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_border_bottom_left_radius(style, hint->status,
+		hint->data.position.h.value, hint->data.position.h.unit,
+		hint->data.position.v.value, hint->data.position.v.unit);
+}
+
+css_error css__initial_border_bottom_left_radius(css_select_state *state)
+{
+	/* Square corners until a stylesheet asks otherwise. */
+	return set_border_bottom_left_radius(state->computed, CSS_BORDER_BOTTOM_LEFT_RADIUS_SET,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX);
+}
+
+css_error css__copy_border_bottom_left_radius(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed hlength = 0, vlength = 0;
+	css_unit hunit = CSS_UNIT_PX, vunit = CSS_UNIT_PX;
+	uint8_t type = get_border_bottom_left_radius(from, &hlength, &hunit,
+			&vlength, &vunit);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_border_bottom_left_radius(to, type, hlength, hunit, vlength, vunit);
+}
+
+css_error css__compose_border_bottom_left_radius(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed hlength = 0, vlength = 0;
+	css_unit hunit = CSS_UNIT_PX, vunit = CSS_UNIT_PX;
+	uint8_t type = get_border_bottom_left_radius(child, &hlength, &hunit,
+			&vlength, &vunit);
+
