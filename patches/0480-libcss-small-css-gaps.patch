+/** Whether a token is the auto-flow keyword of the grid shorthand. */
+static bool token_is_auto_flow(const css_token *token)
+{
+	return token != NULL && token->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(token->idata) == 9 &&
+			strncasecmp(lwc_string_data(token->idata),
+				"auto-flow", 9) == 0;
+}
+
+/**
+ * "auto-flow && dense?" at *ctx (VitaSurf): false, with *ctx unchanged,
+ * when auto-flow is not there.
+ */
+static bool grid_read_auto_flow(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx, bool *dense)
+{
+	int32_t at = *ctx;
+	bool flow = false;
+	int i;
+
+	*dense = false;
+	for (i = 0; i < 2; i++) {
+		const css_token *t;
+
+		consumeWhitespace(vector, &at);
+		t = parserutils_vector_peek(vector, at);
+		if (!flow && token_is_auto_flow(t)) {
+			flow = true;
+		} else if (!*dense && token_is_ident(c, t, DENSE)) {
+			*dense = true;
+		} else {
+			break;
+		}
+		parserutils_vector_iterate(vector, &at);
+	}
+	if (flow)
+		*ctx = at;
+	return flow;
+}
+
+/** The track sizes of grid-auto-rows or -columns, auto if none. */
+static css_error grid_auto_tracks(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, opcode_t prop)
+{
+	struct grid_track_parse track, extra;
+	bool any = false;
+	css_error error;
+
+	memset(&track, 0, sizeof(track));
+	for (;;) {
+		int32_t prev = *ctx;
+		const css_token *t;
+
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_peek(vector, *ctx);
+		if (t == NULL || tokenIsChar(t, '/') || tokenIsChar(t, '!') ||
+				parse_track_size(c, vector, ctx,
+					any ? &extra : &track) != CSS_OK) {
+			*ctx = prev;
+			break;
+		}
+		any = true;
+	}
+	if (!any || (track.minmax == false &&
+			track.min_type == GRID_TRACK_AUTO))
+		return css__stylesheet_style_appendOPV(result, prop, 0,
+				GRID_AUTO_TRACK_AUTO);
+	error = css__stylesheet_style_appendOPV(result, prop, 0,
+			GRID_AUTO_TRACK_SET);
+	if (error == CSS_OK)
+		error = append_track_list(result, &track, 1);
+	return error;
+}
