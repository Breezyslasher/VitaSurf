+			cmath_is_fn(t, "max", 3) || cmath_is_fn(t, "clamp", 5);
+}
+
+/** A comma separated list of sums, up to the closing bracket. */
+static bool cmath_list(const parserutils_vector *vector, int32_t *ctx,
+		struct cmath_val *vals, int max, int *n)
+{
+	const css_token *t;
+
+	*n = 0;
+	for (;;) {
+		if (*n == max || !cmath_sum(vector, ctx, &vals[*n]))
+			return false;
+		if (*n > 0 && vals[*n].kind != vals[0].kind)
+			return false;
+		(*n)++;
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		if (tokenIsChar(t, ')'))
+			return true;
+		if (!tokenIsChar(t, ','))
+			return false;
+	}
