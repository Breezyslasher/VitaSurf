+		else if (unit != UNIT_DEG)
+			return false;
+		out->kind = CMATH_ANGLE;
+		return true;
+	}
+	if (t->type == CSS_TOKEN_IDENT) {
+		out->kind = CMATH_NUMBER;
+		if (fn_name_is(t->idata, "pi", 2)) {
+			out->v = M_PI;
+			return true;
+		}
+		if (fn_name_is(t->idata, "e", 1)) {
+			out->v = M_E;
+			return true;
+		}
+		return false;
+	}
+	if (tokenIsChar(t, '(') || cmath_is_fn(t, "calc", 4)) {
+		if (!cmath_sum(vector, ctx, out))
+			return false;
+		consumeWhitespace(vector, ctx);
+		return tokenIsChar(parserutils_vector_iterate(vector, ctx),
+				')');
+	}
+	if (cmath_is_fn(t, "min", 3) || cmath_is_fn(t, "max", 3)) {
+		struct cmath_val vals[16];
+		bool min = cmath_is_fn(t, "min", 3);
+		int n, i;
+
+		if (!cmath_list(vector, ctx, vals, 16, &n))
+			return false;
+		*out = vals[0];
+		for (i = 1; i < n; i++) {
+			if (min ? vals[i].v < out->v : vals[i].v > out->v)
+				out->v = vals[i].v;
+		}
+		return true;
+	}
+	if (cmath_is_fn(t, "clamp", 5)) {
+		struct cmath_val vals[3];
+		int n;
+
+		if (!cmath_list(vector, ctx, vals, 3, &n) || n != 3)
+			return false;
+		*out = vals[1];
+		if (out->v > vals[2].v)
+			out->v = vals[2].v;
+		if (out->v < vals[0].v)
+			out->v = vals[0].v;
+		return true;
+	}
+	return false;
+}
+
+static bool cmath_product(const parserutils_vector *vector, int32_t *ctx,
+		struct cmath_val *out)
+{
+	struct cmath_val r;
+
+	if (!cmath_term(vector, ctx, out))
+		return false;
+	for (;;) {
+		int32_t save;
+		const css_token *t;
+
+		consumeWhitespace(vector, ctx);
+		save = *ctx;
+		t = parserutils_vector_iterate(vector, ctx);
+		if (!tokenIsChar(t, '*') && !tokenIsChar(t, '/')) {
+			*ctx = save;
+			return true;
+		}
+		if (!cmath_term(vector, ctx, &r))
+			return false;
+		if (tokenIsChar(t, '*')) {
+			/* one side a plain number */
+			if (r.kind == CMATH_NUMBER) {
+				out->v *= r.v;
+			} else if (out->kind == CMATH_NUMBER) {
+				out->v *= r.v;
+				out->kind = r.kind;
+			} else {
+				return false;
+			}
+		} else {
+			if (r.kind != CMATH_NUMBER || r.v == 0)
+				return false;
+			out->v /= r.v;
+		}
+	}
+}
+
+static bool cmath_sum(const parserutils_vector *vector, int32_t *ctx,
+		struct cmath_val *out)
+{
+	struct cmath_val r;
+
+	if (!cmath_product(vector, ctx, out))
+		return false;
+	for (;;) {
+		int32_t save;
+		const css_token *t;
+
+		consumeWhitespace(vector, ctx);
+		save = *ctx;
+		t = parserutils_vector_iterate(vector, ctx);
+		if (!tokenIsChar(t, '+') && !tokenIsChar(t, '-')) {
+			*ctx = save;
+			return true;
+		}
+		if (!cmath_product(vector, ctx, &r) || r.kind != out->kind)
+			return false;
+		out->v = tokenIsChar(t, '+') ? out->v + r.v : out->v - r.v;
+	}
+}
