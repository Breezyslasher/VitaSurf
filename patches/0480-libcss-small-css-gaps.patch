+					CSS_PROP_GRID_TEMPLATE_ROWS, 0,
+					GRID_TEMPLATE_NONE);
+		if (error == CSS_OK)
+			error = css__stylesheet_style_appendOPV(tmp,
+					CSS_PROP_GRID_AUTO_COLUMNS, 0,
+					GRID_AUTO_TRACK_AUTO);
+	} else {
+		if (error == CSS_OK)
+			error = parse_grid_template_value(c, vector, &at, tmp,
+					CSS_PROP_GRID_TEMPLATE_ROWS);
+		if (error == CSS_OK)
+			error = expect_char(vector, &at, '/');
+		if (error == CSS_OK && !grid_read_auto_flow(c, vector, &at,
+				&dense))
+			error = CSS_INVALID;
+		if (error == CSS_OK)
+			error = grid_auto_tracks(c, vector, &at, tmp,
+					CSS_PROP_GRID_AUTO_COLUMNS);
+		if (error == CSS_OK)
+			error = css__stylesheet_style_appendOPV(tmp,
+					CSS_PROP_GRID_TEMPLATE_COLUMNS, 0,
+					GRID_TEMPLATE_NONE);
+		if (error == CSS_OK)
+			error = css__stylesheet_style_appendOPV(tmp,
+					CSS_PROP_GRID_AUTO_ROWS, 0,
+					GRID_AUTO_TRACK_AUTO);
+	}
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(tmp,
+				CSS_PROP_GRID_AUTO_FLOW, 0, rows_flow ?
+				(dense ? GRID_AUTO_FLOW_ROW_DENSE :
+					GRID_AUTO_FLOW_ROW) :
+				(dense ? GRID_AUTO_FLOW_COLUMN_DENSE :
+					GRID_AUTO_FLOW_COLUMN));
+	if (error == CSS_OK)
+		error = css__stylesheet_merge_style(result, tmp);
+	css__stylesheet_style_destroy(tmp);
+	if (error == CSS_OK)
