diff --git a/src/parse/properties/small_gaps.c b/src/parse/properties/small_gaps.c
new file mode 100644
index 0000000..ba7e92b
--- /dev/null
+++ b/src/parse/properties/small_gaps.c
@@ -0,0 +1,701 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * The small gaps of the census (VitaSurf): what real sheets wrote that
+ * Chrome takes and libcss dropped, once the larger gaps were filled.
+ *
+ * background-repeat's two value form and space and round;
+ * background-origin; background-blend-mode; background-position-x and
+ * -y, which background-position now sets as its two longhands, so that
+ * each half cascades on its own; font-variant-caps and
+ * font-variant-numeric, and font-variant as their shorthand; tab-size;
+ * and perspective, perspective-origin and text-orientation, which are
+ * checked and kept nowhere: a transform here is drawn flat, its depth
+ * dropped as it is parsed, and no text is set vertically.
+ */
+
+#include <assert.h>
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+#include "utils/utils.h"
+
+/** Whether a token is an identifier that is the word, in any case. */
+static bool is_word(const css_token *t, const char *word)
+{
+	size_t len = strlen(word);
+
+	return t != NULL && t->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(t->idata) == len &&
+			strncasecmp(lwc_string_data(t->idata), word, len) == 0;
+}
+
+/** Which of the words a token is, or -1. */
+static int word_index(const css_token *t, const char *const *words,
+		size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		if (is_word(t, words[i]))
+			return (int) i;
+	}
+	return -1;
+}
+
+/** inherit, initial and the rest, for one property. */
+static bool take_flag(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, css_style *result, opcode_t prop,
+		css_error *error)
+{
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag = get_css_flag_value(c, t);
+
+	if (flag == FLAG_VALUE__NONE)
+		return false;
+	parserutils_vector_iterate(vector, ctx);
+	*error = css_stylesheet_style_flag_value(result, flag, prop);
+	return true;
+}
+
+/**
+ * Step over the rest of a comma separated list after its first item:
+ * the first layer is the one this renderer paints, and the later ones
+ * are checked by accept.
+ */
+static bool skip_list(const parserutils_vector *vector, int32_t *ctx,
+		bool (*accept)(const css_token *t))
+{
+	for (;;) {
+		int32_t at = *ctx;
+		const css_token *t;
+
+		consumeWhitespace(vector, &at);
+		t = parserutils_vector_peek(vector, at);
+		if (!tokenIsChar(t, ','))
+			return true;
+		parserutils_vector_iterate(vector, &at);
+		consumeWhitespace(vector, &at);
+		t = parserutils_vector_iterate(vector, &at);
+		if (t == NULL || !accept(t))
+			return false;
+		*ctx = at;
+	}
+}
+
+/* background-repeat ------------------------------------------------- */
+
+static const char *const repeat_words[] = {
+	"repeat", "no-repeat", "space", "round"
+};
+
+css_error css__parse_background_repeat(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const uint16_t same[] = {
+		BACKGROUND_REPEAT_REPEAT, BACKGROUND_REPEAT_NO_REPEAT,
+		BACKGROUND_REPEAT_SPACE, BACKGROUND_REPEAT_ROUND
+	};
+	int32_t orig_ctx = *ctx, at;
+	const css_token *t;
+	css_error error;
+	int x, y;
+	uint16_t value;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_BACKGROUND_REPEAT,
+			&error))
+		return error;
+
+	t = parserutils_vector_iterate(vector, ctx);
+	if (is_word(t, "repeat-x") || is_word(t, "repeat-y"))
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_BACKGROUND_REPEAT, 0,
+				is_word(t, "repeat-x") ?
+				BACKGROUND_REPEAT_REPEAT_X :
+				BACKGROUND_REPEAT_REPEAT_Y);
+	x = word_index(t, repeat_words, 4);
+	if (x < 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+
+	/* a second word for the vertical, which repeats the first when
+	 * it is not there */
+	at = *ctx;
+	consumeWhitespace(vector, &at);
+	y = word_index(parserutils_vector_peek(vector, at), repeat_words, 4);
+	if (y >= 0)
+		*ctx = at + 1;
+	else
+		y = x;
+
+	if (x == y)
+		value = same[x];
+	else if (y == 1)
+		value = BACKGROUND_REPEAT_REPEAT_X;	/* along x alone */
+	else if (x == 1)
+		value = BACKGROUND_REPEAT_REPEAT_Y;	/* along y alone */
+	else
+		value = BACKGROUND_REPEAT_REPEAT;	/* tiled both ways */
+
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_BACKGROUND_REPEAT, 0, value);
+}
+
+/* background-origin -------------------------------------------------- */
+
+static const char *const box_words[] = {
+	"border-box", "padding-box", "content-box"
+};
+
+static bool box_word(const css_token *t)
+{
+	return word_index(t, box_words, 3) >= 0;
+}
+
+css_error css__parse_background_origin(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const uint16_t values[] = {
+		BACKGROUND_ORIGIN_BORDER_BOX, BACKGROUND_ORIGIN_PADDING_BOX,
+		BACKGROUND_ORIGIN_CONTENT_BOX
+	};
+	int32_t orig_ctx = *ctx;
+	css_error error;
+	int i;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_BACKGROUND_ORIGIN,
+			&error))
+		return error;
+
+	i = word_index(parserutils_vector_iterate(vector, ctx), box_words, 3);
+	if (i < 0 || !skip_list(vector, ctx, box_word)) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_BACKGROUND_ORIGIN, 0, values[i]);
+}
+
+/* background-blend-mode ---------------------------------------------- */
+
+static const char *const blend_words[] = {
+	"normal", "multiply", "screen", "overlay", "darken", "lighten",
+	"color-dodge", "color-burn", "hard-light", "soft-light",
+	"difference", "exclusion", "hue", "saturation", "color",
+	"luminosity", "plus-lighter"
+};
+
+static bool blend_word(const css_token *t)
+{
+	return word_index(t, blend_words, sizeof(blend_words) /
+			sizeof(blend_words[0])) >= 0;
+}
+
+css_error css__parse_background_blend_mode(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	css_error error;
+	int i;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_BACKGROUND_BLEND_MODE,
+			&error))
+		return error;
+
+	/* the values and their order are mix-blend-mode's */
+	i = word_index(parserutils_vector_iterate(vector, ctx), blend_words,
+			sizeof(blend_words) / sizeof(blend_words[0]));
+	if (i < 0 || !skip_list(vector, ctx, blend_word)) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_BACKGROUND_BLEND_MODE, 0, (uint16_t) i);
+}
+
+/* font-variant and its longhands ------------------------------------- */
+
+/* The words of each longhand, by group: a word may come once, and one
+ * word of a group at most (the groups of font-variant-numeric are its
+ * figure, spacing and fraction values). */
+struct variant_word {
+	const char *word;
+	uint8_t group;
+};
+
+static const struct variant_word caps_words[] = {
+	{ "small-caps", 1 }, { "all-small-caps", 1 }, { "petite-caps", 1 },
+	{ "all-petite-caps", 1 }, { "unicase", 1 }, { "titling-caps", 1 },
+};
+
+static const struct variant_word numeric_words[] = {
+	{ "lining-nums", 2 }, { "oldstyle-nums", 2 },
+	{ "proportional-nums", 3 }, { "tabular-nums", 3 },
+	{ "diagonal-fractions", 4 }, { "stacked-fractions", 4 },
+	{ "ordinal", 5 }, { "slashed-zero", 6 },
+};
+
+static const struct variant_word other_words[] = {
+	{ "common-ligatures", 7 }, { "no-common-ligatures", 7 },
+	{ "discretionary-ligatures", 8 }, { "no-discretionary-ligatures", 8 },
+	{ "historical-ligatures", 9 }, { "no-historical-ligatures", 9 },
+	{ "contextual", 10 }, { "no-contextual", 10 },
+	{ "jis78", 11 }, { "jis83", 11 }, { "jis90", 11 }, { "jis04", 11 },
+	{ "simplified", 11 }, { "traditional", 11 },
+	{ "full-width", 12 }, { "proportional-width", 12 }, { "ruby", 13 },
+	{ "sub", 14 }, { "super", 14 },
+};
+
+/** The group of a word of a table, or 0. */
+static uint8_t variant_group(const css_token *t,
+		const struct variant_word *table, size_t n, bool *small_caps,
+		bool *tabular)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		if (is_word(t, table[i].word)) {
+			/* every kind of small capital is drawn as
+			 * small-caps; unicase and titling-caps as the
+			 * letters are */
+			if (table[i].group == 1)
+				*small_caps = i < 4;
+			if (strcmp(table[i].word, "tabular-nums") == 0)
+				*tabular = true;
+			return table[i].group;
+		}
+	}
+	return 0;
+}
+
+/**
+ * Read words of the given tables up to the end of the value, each
+ * group once. False if anything else is there, or nothing is.
+ */
+static bool read_variant(const parserutils_vector *vector, int32_t *ctx,
+		bool caps, bool numeric, bool other, bool *small_caps,
+		bool *tabular)
+{
+	uint32_t seen = 0;
+	bool any = false;
+
+	*small_caps = false;
+	*tabular = false;
+	for (;;) {
+		const css_token *t;
+		uint8_t g = 0;
+
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_peek(vector, *ctx);
+		if (t == NULL || tokenIsChar(t, '!'))
+			break;
+		if (caps)
+			g = variant_group(t, caps_words, sizeof(caps_words) /
+					sizeof(caps_words[0]), small_caps,
+					tabular);
+		if (g == 0 && numeric)
+			g = variant_group(t, numeric_words,
+					sizeof(numeric_words) /
+					sizeof(numeric_words[0]), small_caps,
+					tabular);
+		if (g == 0 && other)
+			g = variant_group(t, other_words,
+					sizeof(other_words) /
+					sizeof(other_words[0]), small_caps,
+					tabular);
+		if (g == 0 || (seen & (1u << g)) != 0)
+			return false;
+		seen |= 1u << g;
+		any = true;
+		parserutils_vector_iterate(vector, ctx);
+	}
+	return any;
+}
+
+css_error css__parse_font_variant_caps(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	bool small_caps = false, tabular = false;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_FONT_VARIANT, &error))
+		return error;
+	if (is_word(parserutils_vector_peek(vector, *ctx), "normal")) {
+		parserutils_vector_iterate(vector, ctx);
+	} else if (!read_variant(vector, ctx, true, false, false,
+			&small_caps, &tabular)) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return css__stylesheet_style_appendOPV(result, CSS_PROP_FONT_VARIANT,
+			0, small_caps ? FONT_VARIANT_SMALL_CAPS :
+			FONT_VARIANT_NORMAL);
+}
+
+css_error css__parse_font_variant_numeric(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	bool small_caps = false, tabular = false;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_FONT_VARIANT_NUMERIC,
+			&error))
+		return error;
+	if (is_word(parserutils_vector_peek(vector, *ctx), "normal")) {
+		parserutils_vector_iterate(vector, ctx);
+	} else if (!read_variant(vector, ctx, false, true, false,
+			&small_caps, &tabular)) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_FONT_VARIANT_NUMERIC, 0, tabular ?
+			FONT_VARIANT_NUMERIC_TABULAR :
+			FONT_VARIANT_NUMERIC_NORMAL);
+}
+
+/**
+ * font-variant: normal | none | the words of its longhands. It had
+ * taken normal and small-caps alone, and font-variant: tabular-nums,
+ * or small-caps with anything else, was dropped.
+ */
+css_error css__parse_font_variant(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	bool small_caps = false, tabular = false;
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag = get_css_flag_value(c, t);
+	css_error error;
+
+	if (flag != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		error = css_stylesheet_style_flag_value(result, flag,
+				CSS_PROP_FONT_VARIANT);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result, flag,
+					CSS_PROP_FONT_VARIANT_NUMERIC);
+		return error;
+	}
+	if (is_word(t, "normal") || is_word(t, "none")) {
+		parserutils_vector_iterate(vector, ctx);
+	} else if (!read_variant(vector, ctx, true, true, true, &small_caps,
+			&tabular)) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_FONT_VARIANT,
+			0, small_caps ? FONT_VARIANT_SMALL_CAPS :
+			FONT_VARIANT_NORMAL);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_FONT_VARIANT_NUMERIC, 0, tabular ?
+				FONT_VARIANT_NUMERIC_TABULAR :
+				FONT_VARIANT_NUMERIC_NORMAL);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/* tab-size ------------------------------------------------------------ */
+
+css_error css__parse_tab_size(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *t;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result, CSS_PROP_TAB_SIZE, &error))
+		return error;
+
+	t = parserutils_vector_peek(vector, *ctx);
+	if (t != NULL && t->type == CSS_TOKEN_NUMBER) {
+		size_t consumed = 0;
+
+		length = css__number_from_lwc_string(t->idata, false,
+				&consumed);
+		if (consumed != lwc_string_length(t->idata) || length < 0) {
+			*ctx = orig_ctx;
+			return CSS_INVALID;
+		}
+		parserutils_vector_iterate(vector, ctx);
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_TAB_SIZE, 0, TAB_SIZE_NUMBER);
+		if (error == CSS_OK)
+			error = css__stylesheet_style_append(result, length);
+		return error;
+	}
+
+	error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX, &length,
+			&unit);
+	if (error != CSS_OK || length < 0 || (unit & UNIT_PCT) != 0 ||
+			(unit & UNIT_LENGTH) == 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	error = css__stylesheet_style_appendOPV(result, CSS_PROP_TAB_SIZE, 0,
+			TAB_SIZE_SET);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_vappend(result, 2, length, unit);
+	return error;
+}
+
+/* background-position and its longhands ------------------------------ */
+
+/**
+ * Put one background-position, as its parser leaves it in tmp, into
+ * result as the longhands asked for.
+ */
+static css_error position_split(const css_style *tmp, css_style *result,
+		bool want_x, bool want_y)
+{
+	css_code_t opv;
+	uint32_t at = 1, value;
+	css_code_t hl = 0, hu = 0, vl = 0, vu = 0;
+	css_error error = CSS_OK;
+
+	if (tmp->used == 0)
+		return CSS_INVALID;
+	opv = tmp->bytecode[0];
+	if (hasFlagValue(opv)) {
+		if (want_x)
+			error = css_stylesheet_style_flag_value(result,
+					getFlagValue(opv),
+					CSS_PROP_BACKGROUND_POSITION_X);
+		if (error == CSS_OK && want_y)
+			error = css_stylesheet_style_flag_value(result,
+					getFlagValue(opv),
+					CSS_PROP_BACKGROUND_POSITION_Y);
+		return error;
+	}
+	value = getValue(opv);
+	if ((value & 0xf0) == BACKGROUND_POSITION_HORZ_SET) {
+		if (at + 2 > tmp->used)
+			return CSS_INVALID;
+		hl = tmp->bytecode[at++];
+		hu = tmp->bytecode[at++];
+	}
+	if ((value & 0x0f) == BACKGROUND_POSITION_VERT_SET) {
+		if (at + 2 > tmp->used)
+			return CSS_INVALID;
+		vl = tmp->bytecode[at++];
+		vu = tmp->bytecode[at++];
+	}
+	if (want_x) {
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_BACKGROUND_POSITION_X, 0,
+				value & 0xf0);
+		if (error == CSS_OK &&
+				(value & 0xf0) == BACKGROUND_POSITION_HORZ_SET)
+			error = css__stylesheet_style_vappend(result, 2, hl,
+					hu);
+	}
+	if (error == CSS_OK && want_y) {
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_BACKGROUND_POSITION_Y, 0,
+				value & 0x0f);
+		if (error == CSS_OK &&
+				(value & 0x0f) == BACKGROUND_POSITION_VERT_SET)
+			error = css__stylesheet_style_vappend(result, 2, vl,
+					vu);
+	}
+	return error;
+}
+
+css_error css__parse_background_position(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	css_style *tmp = NULL;
+	css_error error;
+
+	error = css__stylesheet_style_create(c->sheet, &tmp);
+	if (error != CSS_OK)
+		return error;
+	error = css__parse_background_position_pair(c, vector, ctx, tmp);
+	if (error == CSS_OK)
+		error = position_split(tmp, result, true, true);
+	css__stylesheet_style_destroy(tmp);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+/**
+ * background-position-x or -y: the value with center put on the other
+ * side is a background-position, half of which is this.
+ */
+static css_error parse_position_half(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, bool x)
+{
+	static const char *const other_x[] = { "top", "bottom", "y-start",
+		"y-end" };
+	static const char *const other_y[] = { "left", "right", "x-start",
+		"x-end" };
+	opcode_t prop = x ? CSS_PROP_BACKGROUND_POSITION_X :
+			CSS_PROP_BACKGROUND_POSITION_Y;
+	int32_t orig_ctx = *ctx, at = *ctx, ictx = 0, depth = 0;
+	parserutils_vector *v = NULL;
+	css_style *tmp = NULL;
+	const css_token *t;
+	css_token center, space;
+	css_error error;
+
+	if (take_flag(c, vector, ctx, result, prop, &error))
+		return error;
+
+	memset(&center, 0, sizeof(center));
+	center.type = CSS_TOKEN_IDENT;
+	center.idata = c->strings[CENTER];
+	memset(&space, 0, sizeof(space));
+	space.type = CSS_TOKEN_S;
+	space.idata = c->strings[CENTER];
+
+	if (parserutils_vector_create(sizeof(css_token), 16, &v) !=
+			PARSERUTILS_OK)
+		return CSS_NOMEM;
+	error = CSS_INVALID;
+	if (!x && (parserutils_vector_append(v, &center) != PARSERUTILS_OK ||
+			parserutils_vector_append(v, &space) !=
+			PARSERUTILS_OK))
+		goto out;
+	while ((t = parserutils_vector_peek(vector, at)) != NULL) {
+		if (depth == 0 && tokenIsChar(t, '!'))
+			break;
+		if (t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '('))
+			depth++;
+		else if (tokenIsChar(t, ')'))
+			depth--;
+		else if (depth == 0 && word_index(t, x ? other_x : other_y,
+				4) >= 0)
+			goto out;	/* the other axis */
+		if (parserutils_vector_append(v, (void *) t) != PARSERUTILS_OK)
+			goto out;
+		at++;
+	}
+	if (x && (parserutils_vector_append(v, &space) != PARSERUTILS_OK ||
+			parserutils_vector_append(v, &center) !=
+			PARSERUTILS_OK))
+		goto out;
+
+	error = css__stylesheet_style_create(c->sheet, &tmp);
+	if (error != CSS_OK)
+		goto out;
+	error = css__parse_background_position_pair(c, v, &ictx, tmp);
+	if (error == CSS_OK) {
+		consumeWhitespace(v, &ictx);
+		if (parserutils_vector_peek(v, ictx) != NULL)
+			error = CSS_INVALID;
+	}
+	if (error == CSS_OK)
+		error = position_split(tmp, result, x, !x);
+	css__stylesheet_style_destroy(tmp);
+out:
+	parserutils_vector_destroy(v);
+	if (error == CSS_OK)
+		*ctx = at;
+	else
+		*ctx = orig_ctx;
+	return error;
+}
+
+css_error css__parse_background_position_x(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_position_half(c, vector, ctx, result, true);
+}
+
+css_error css__parse_background_position_y(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	return parse_position_half(c, vector, ctx, result, false);
+}
+
+/* checked and kept nowhere ------------------------------------------- */
+
+css_error css__parse_perspective(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+
+	UNUSED(result);
+	if (get_css_flag_value(c, t) != FLAG_VALUE__NONE ||
+			is_word(t, "none")) {
+		parserutils_vector_iterate(vector, ctx);
+		return CSS_OK;
+	}
+	if (css__parse_unit_specifier(c, vector, ctx, UNIT_PX, &length,
+			&unit) != CSS_OK || length < 0 ||
+			(unit & UNIT_LENGTH) == 0 || (unit & UNIT_PCT) != 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return CSS_OK;
+}
+
+css_error css__parse_perspective_origin(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	css_style *tmp = NULL;
+	css_error error;
+
+	UNUSED(result);
+	error = css__stylesheet_style_create(c->sheet, &tmp);
+	if (error != CSS_OK)
+		return error;
+	/* the value of a background-position with one or two items */
+	error = css__parse_background_position_pair(c, vector, ctx, tmp);
+	css__stylesheet_style_destroy(tmp);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
+
+css_error css__parse_text_orientation(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const char *const words[] = {
+		"mixed", "upright", "sideways", "sideways-right"
+	};
+	const css_token *t = parserutils_vector_peek(vector, *ctx);
+
+	UNUSED(result);
+	if (get_css_flag_value(c, t) == FLAG_VALUE__NONE &&
+			word_index(t, words, 4) < 0)
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+	return CSS_OK;
+}
