+						r.v, r.kind == CMATH_ANGLE ?
+						"deg" : "");
+			if (len <= 0 || (size_t) len >= sizeof(buf) ||
+					lwc_intern_string(buf, len,
+					&strings[*n_strings]) != lwc_error_ok)
+				goto fail;
+			memset(&nt, 0, sizeof(nt));
+			nt.type = r.kind == CMATH_NUMBER ? CSS_TOKEN_NUMBER :
+					r.kind == CMATH_PERCENT ?
+					CSS_TOKEN_PERCENTAGE :
+					CSS_TOKEN_DIMENSION;
+			nt.idata = strings[(*n_strings)++];
+			if (parserutils_vector_append(v, &nt) !=
+					PARSERUTILS_OK)
+				goto fail;
+			continue;
+		}
+		if (parserutils_vector_append(v, (void *) t) != PARSERUTILS_OK)
+			goto fail;
+		if (tokenIsChar(t, ')'))
+			break;
+	}
+	*end = at;
+	return v;
+fail:
+	parserutils_vector_destroy(v);
+	while (*n_strings > 0)
+		lwc_string_unref(strings[--(*n_strings)]);
+	return NULL;
+}
