+static inline uint8_t get_tab_size(const css_computed_style *style, css_fixed
+		*length, css_unit *unit)
+{
+	uint8_t type;
+	uint32_t bits = style->i.bits[TAB_SIZE_INDEX];
+	bits &= TAB_SIZE_MASK;
+	bits >>= TAB_SIZE_SHIFT;
+
+	/* 7bits: uuuuutt : unit | type */
+	type = bits & 0x3;
+	*length = style->i.tab_size;
+	*unit = bits >> 2;
+
+	return type;
+}
