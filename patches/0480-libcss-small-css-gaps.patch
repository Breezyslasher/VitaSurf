diff --git a/src/select/properties/small_gaps.c b/src/select/properties/small_gaps.c
new file mode 100644
index 0000000..4b380e7
--- /dev/null
+++ b/src/select/properties/small_gaps.c
@@ -0,0 +1,537 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 VitaSurf contributors
+ */
+
+/*
+ * The small gaps of the census (VitaSurf): background-origin,
+ * background-blend-mode, font-variant-numeric, caret-color, tab-size,
+ * and background-position-x and -y, each half of background-position's
+ * stored value, so that a page's background-position-x outranks a
+ * background-position that comes before it with less weight, and the
+ * other half is still that one's.
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* background-origin ---------------------------------------------------- */
+
+css_error css__cascade_background_origin(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_BACKGROUND_ORIGIN_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case BACKGROUND_ORIGIN_BORDER_BOX:
+			value = CSS_BACKGROUND_ORIGIN_BORDER_BOX;
+			break;
+		case BACKGROUND_ORIGIN_CONTENT_BOX:
+			value = CSS_BACKGROUND_ORIGIN_CONTENT_BOX;
+			break;
+		default:
+			value = CSS_BACKGROUND_ORIGIN_PADDING_BOX;
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_background_origin(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_background_origin_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_background_origin(style, hint->status);
+}
+
+css_error css__initial_background_origin(css_select_state *state)
+{
+	return set_background_origin(state->computed,
+			CSS_BACKGROUND_ORIGIN_PADDING_BOX);
+}
+
+css_error css__copy_background_origin(const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_background_origin(to, get_background_origin(from));
+}
+
+css_error css__compose_background_origin(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_background_origin(child);
+
+	return css__copy_background_origin(
+			type == CSS_BACKGROUND_ORIGIN_INHERIT ? parent : child,
+			result);
+}
+
+/* background-blend-mode ------------------------------------------------ */
+
+css_error css__cascade_background_blend_mode(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_MIX_BLEND_MODE_INHERIT;
+
+	UNUSED(style);
+
+	/* the op values are mix-blend-mode's, one below the computed */
+	if (hasFlagValue(opv) == false) {
+		value = getValue(opv) + CSS_MIX_BLEND_MODE_NORMAL;
+		if (value > CSS_MIX_BLEND_MODE_PLUS_LIGHTER)
+			value = CSS_MIX_BLEND_MODE_NORMAL;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_background_blend_mode(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_background_blend_mode_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_background_blend_mode(style, hint->status);
+}
+
+css_error css__initial_background_blend_mode(css_select_state *state)
+{
+	return set_background_blend_mode(state->computed,
+			CSS_MIX_BLEND_MODE_NORMAL);
+}
+
+css_error css__copy_background_blend_mode(const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_background_blend_mode(to, get_background_blend_mode(from));
+}
+
+css_error css__compose_background_blend_mode(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_background_blend_mode(child);
+
+	return css__copy_background_blend_mode(
+			type == CSS_MIX_BLEND_MODE_INHERIT ? parent : child,
+			result);
+}
+
+/* font-variant-numeric ------------------------------------------------- */
+
+css_error css__cascade_font_variant_numeric(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_FONT_VARIANT_NUMERIC_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		value = getValue(opv) == FONT_VARIANT_NUMERIC_TABULAR ?
+				CSS_FONT_VARIANT_NUMERIC_TABULAR :
+				CSS_FONT_VARIANT_NUMERIC_NORMAL;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_font_variant_numeric(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_font_variant_numeric_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_font_variant_numeric(style, hint->status);
+}
+
+css_error css__initial_font_variant_numeric(css_select_state *state)
+{
+	return set_font_variant_numeric(state->computed,
+			CSS_FONT_VARIANT_NUMERIC_NORMAL);
+}
+
+css_error css__copy_font_variant_numeric(const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_font_variant_numeric(to, get_font_variant_numeric(from));
+}
+
+css_error css__compose_font_variant_numeric(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_font_variant_numeric(child);
+
+	return css__copy_font_variant_numeric(
+			type == CSS_FONT_VARIANT_NUMERIC_INHERIT ?
+			parent : child, result);
+}
+
+/* caret-color ---------------------------------------------------------- */
+
+css_error css__cascade_caret_color(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	enum flag_value flag_value = getFlagValue(opv);
+	uint16_t value = CSS_CARET_COLOR_INHERIT;
+	css_color color = 0;
+
+	if (flag_value == FLAG_VALUE__NONE) {
+		switch (getValue(opv)) {
+		case CARET_COLOR_TRANSPARENT:
+			value = CSS_CARET_COLOR_COLOR;
+			break;
+		case CARET_COLOR_CURRENT_COLOR:
+			value = CSS_CARET_COLOR_CURRENT_COLOR;
+			break;
+		case CARET_COLOR_AUTO:
+			value = CSS_CARET_COLOR_AUTO;
+			break;
+		case CARET_COLOR_SET:
+			value = CSS_CARET_COLOR_COLOR;
+			color = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(color));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			flag_value)) {
+		return set_caret_color(state->computed, value, color);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_caret_color_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_caret_color(style, hint->status, hint->data.color);
+}
+
+css_error css__initial_caret_color(css_select_state *state)
+{
+	return set_caret_color(state->computed, CSS_CARET_COLOR_AUTO, 0);
+}
+
+css_error css__copy_caret_color(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_color color;
+	uint8_t type = get_caret_color(from, &color);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_caret_color(to, type, color);
+}
+
+css_error css__compose_caret_color(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_color color;
+	uint8_t type = get_caret_color(child, &color);
+
+	return css__copy_caret_color(
+			type == CSS_CARET_COLOR_INHERIT ? parent : child,
+			result);
+}
+
+/* tab-size ------------------------------------------------------------- */
+
+css_error css__cascade_tab_size(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_TAB_SIZE_INHERIT;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false) {
+		length = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(length));
+		if (getValue(opv) == TAB_SIZE_SET) {
+			value = CSS_TAB_SIZE_SET;
+			unit = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(unit));
+		} else {
+			value = CSS_TAB_SIZE_NUMBER;
+		}
+	}
+
+	unit = css__to_css_unit(unit);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_tab_size(state->computed, value, length, unit);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_tab_size_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_tab_size(style, hint->status, hint->data.length.value,
+			hint->data.length.unit);
+}
+
+css_error css__initial_tab_size(css_select_state *state)
+{
+	return set_tab_size(state->computed, CSS_TAB_SIZE_NUMBER,
+			INTTOFIX(8), CSS_UNIT_PX);
+}
+
+css_error css__copy_tab_size(const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t type = get_tab_size(from, &length, &unit);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_tab_size(to, type, length, unit);
+}
+
+css_error css__compose_tab_size(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t type = get_tab_size(child, &length, &unit);
+
+	return css__copy_tab_size(type == CSS_TAB_SIZE_INHERIT ?
+			parent : child, result);
+}
+
+/* background-position-x and -y ----------------------------------------- */
+
+/** Read the half of a background-position opcode that one longhand has. */
+static void position_half(uint32_t opv, css_style *style, bool x,
+		css_fixed *length, uint32_t *unit)
+{
+	uint32_t v = getValue(opv);
+
+	*length = 0;
+	*unit = UNIT_PCT;
+	if (x) {
+		switch (v & 0xf0) {
+		case BACKGROUND_POSITION_HORZ_SET:
+			*length = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(*length));
+			*unit = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(*unit));
+			break;
+		case BACKGROUND_POSITION_HORZ_CENTER:
+			*length = INTTOFIX(50);
+			break;
+		case BACKGROUND_POSITION_HORZ_RIGHT:
+			*length = INTTOFIX(100);
+			break;
+		default:
+			break;
+		}
+	} else {
+		switch (v & 0x0f) {
+		case BACKGROUND_POSITION_VERT_SET:
+			*length = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(*length));
+			*unit = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(*unit));
+			break;
+		case BACKGROUND_POSITION_VERT_CENTER:
+			*length = INTTOFIX(50);
+			break;
+		case BACKGROUND_POSITION_VERT_BOTTOM:
+			*length = INTTOFIX(100);
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+/**
+ * One half of the stored background-position. inherit takes both
+ * halves from the parent, as only background-position itself could
+ * say before: a page that inherits one half alone gets the other too.
+ */
+static css_error cascade_position_half(uint32_t opv, css_style *style,
+		css_select_state *state, bool x)
+{
+	css_fixed length = 0, hl = 0, vl = 0;
+	uint32_t unit = UNIT_PCT;
+	css_unit hu = CSS_UNIT_PCT, vu = CSS_UNIT_PCT;
+	enum flag_value flag = getFlagValue(opv);
+	uint8_t type;
+
+	if (hasFlagValue(opv) == false)
+		position_half(opv, style, x, &length, &unit);
+
+	if (!css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			flag))
+		return CSS_OK;
+
+	type = get_background_position(state->computed, &hl, &hu, &vl, &vu);
+	if (flag == FLAG_VALUE_INHERIT) {
+		return set_background_position(state->computed,
+				CSS_BACKGROUND_POSITION_INHERIT, hl, hu, vl, vu);
+	}
+	if (type != CSS_BACKGROUND_POSITION_SET) {
+		hl = vl = 0;
+		hu = vu = CSS_UNIT_PCT;
+	}
+	if (hasFlagValue(opv)) {
+		/* initial, and unset or revert of a property not
+		 * inherited: the start of its axis */
+		length = 0;
+		unit = UNIT_PCT;
+	}
+	if (x) {
+		hl = length;
+		hu = css__to_css_unit(unit);
+	} else {
+		vl = length;
+		vu = css__to_css_unit(unit);
+	}
+	return set_background_position(state->computed,
+			CSS_BACKGROUND_POSITION_SET, hl, hu, vl, vu);
+}
+
+/** The start of one axis, keeping the other half. */
+static css_error initial_position_half(css_select_state *state, bool x)
+{
+	css_fixed hl = 0, vl = 0;
+	css_unit hu = CSS_UNIT_PCT, vu = CSS_UNIT_PCT;
+
+	if (get_background_position(state->computed, &hl, &hu, &vl, &vu) !=
+			CSS_BACKGROUND_POSITION_SET) {
+		hl = vl = 0;
+		hu = vu = CSS_UNIT_PCT;
+	}
+	if (x) {
+		hl = 0;
+		hu = CSS_UNIT_PCT;
+	} else {
+		vl = 0;
+		vu = CSS_UNIT_PCT;
+	}
+	return set_background_position(state->computed,
+			CSS_BACKGROUND_POSITION_SET, hl, hu, vl, vu);
+}
+
+css_error css__cascade_background_position_x(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	return cascade_position_half(opv, style, state, true);
+}
+
+css_error css__set_background_position_x_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
+	UNUSED(style);
+	return CSS_OK;
+}
+
+css_error css__initial_background_position_x(css_select_state *state)
+{
+	return initial_position_half(state, true);
+}
+
+/* the stored value is background-position's, which copies and composes
+ * both halves */
+css_error css__copy_background_position_x(const css_computed_style *from,
+		css_computed_style *to)
+{
+	UNUSED(from);
+	UNUSED(to);
+	return CSS_OK;
+}
+
+css_error css__compose_background_position_x(
+		const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	UNUSED(parent);
+	UNUSED(child);
+	UNUSED(result);
+	return CSS_OK;
+}
+
+css_error css__cascade_background_position_y(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	return cascade_position_half(opv, style, state, false);
+}
+
+css_error css__set_background_position_y_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	UNUSED(hint);
+	UNUSED(style);
+	return CSS_OK;
+}
+
+css_error css__initial_background_position_y(css_select_state *state)
+{
+	return initial_position_half(state, false);
+}
+
+css_error css__copy_background_position_y(const css_computed_style *from,
+		css_computed_style *to)
+{
+	UNUSED(from);
+	UNUSED(to);
+	return CSS_OK;
+}
+
+css_error css__compose_background_position_y(
+		const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	UNUSED(parent);
+	UNUSED(child);
+	UNUSED(result);
+	return CSS_OK;
+}
