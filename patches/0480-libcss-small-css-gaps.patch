+static bool cmath_term(const parserutils_vector *vector, int32_t *ctx,
+		struct cmath_val *out)
+{
+	const css_token *t;
+
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_iterate(vector, ctx);
+	if (t == NULL)
+		return false;
+	if (t->type == CSS_TOKEN_NUMBER || t->type == CSS_TOKEN_PERCENTAGE) {
+		if (!colour_strtod(t->idata, &out->v))
+			return false;
+		out->kind = t->type == CSS_TOKEN_NUMBER ? CMATH_NUMBER :
+				CMATH_PERCENT;
+		return true;
+	}
+	if (t->type == CSS_TOKEN_DIMENSION) {
