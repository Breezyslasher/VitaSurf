+				goto fail;
+			if (fabs(r.v - floor(r.v + 0.5)) < 1e-6)
+				len = snprintf(buf, sizeof(buf), "%.0f%s",
+						floor(r.v + 0.5),
+						r.kind == CMATH_ANGLE ? "deg" :
+						"");
+			else
