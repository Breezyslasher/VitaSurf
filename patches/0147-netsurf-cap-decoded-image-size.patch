@@ -264,6 +264,8 @@ jpeg_cache_convert(struct content *c)
 	struct bitmap * volatile bitmap = NULL;
 	uint8_t * volatile pixels = NULL;
 	size_t rowstride;
+	int want_width = 0;
+	int want_height = 0;
 	struct jpeg_source_mgr source_mgr = {
 		0,
 		0,
@@ -334,6 +336,30 @@ jpeg_cache_convert(struct content *c)
 	}
 	cinfo.dct_method = JDCT_ISLOW;
 
+	/*
+	 * Decode no larger than the image will ever be shown. libjpeg
+	 * does this inside the transform, so it is faster as well as
+	 * smaller, but it only offers eighths of the original: take the
+	 * smallest one that is still at least the size wanted, and trim
+	 * the remainder afterwards. Sticking to 1/2, 1/4 and 1/8 keeps
+	 * to what every libjpeg can do, not just turbo. (VitaSurf)
+	 */
+	if (image_cache_decode_size(cinfo.image_width, cinfo.image_height,
+				    &want_width, &want_height)) {
+		unsigned int num;
+
+		for (num = 1; num < 8; num <<= 1) {
+			if ((cinfo.image_width * num + 7) / 8 >=
+					(unsigned int) want_width &&
+			    (cinfo.image_height * num + 7) / 8 >=
+					(unsigned int) want_height) {
+				break;
+			}
+		}
+		cinfo.scale_num = num;
+		cinfo.scale_denom = 8;
+	}
+
 	/* commence the decompression, output parameters now valid */
 	jpeg_start_decompress(&cinfo);
 
@@ -377,6 +403,16 @@ jpeg_cache_convert(struct content *c)
 	jpeg_finish_decompress(&cinfo);
 	jpeg_destroy_decompress(&cinfo);
 
+	if (want_width > 0 && (int) cinfo.output_width > want_width) {
+		struct bitmap *smaller = image_cache_shrink(bitmap,
+				want_width, want_height);
+
+		if (smaller != NULL) {
+			guit->bitmap->destroy(bitmap);
+			bitmap = smaller;
+		}
+	}
+
 	return bitmap;
 }
 
