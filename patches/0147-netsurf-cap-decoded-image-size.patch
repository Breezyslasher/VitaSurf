+/**
+ * What a decoded bitmap actually occupies.
+ *
+ * Not the image's own size: a bitmap may have been decoded smaller than
+ * the image, and then the cache holds fewer bytes than the image would
+ * suggest. Counting the image's size instead would evict entries that
+ * still fit. (VitaSurf)
+ *
+ * \param bitmap The bitmap to measure, which may be NULL.
+ * \param fallback The size to report when there is no bitmap.
+ */
+static size_t image_cache_bitmap_size(void *bitmap, size_t fallback)
+{
+	if (bitmap == NULL) {
+		return fallback;
+	}
+	return (size_t) guit->bitmap->get_height(bitmap) *
+			guit->bitmap->get_rowstride(bitmap);
+}
