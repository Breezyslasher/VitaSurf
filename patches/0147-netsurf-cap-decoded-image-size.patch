+/* exported interface documented in image_cache.h */
+bool image_cache_decode_size(int width, int height,
+			     int *dest_width, int *dest_height)
+{
+	int cap_width = nsoption_int(max_image_width);
+	int cap_height = nsoption_int(max_image_height);
+	int64_t want_width;
+	int64_t want_height;
+
+	if (width <= 0 || height <= 0) {
+		return false;
+	}
+	if ((cap_width <= 0 || width <= cap_width) &&
+	    (cap_height <= 0 || height <= cap_height)) {
+		return false;
+	}
+
+	/*
+	 * Fit the width first and then the height, because fitting the
+	 * width can leave a tall image still too tall.
+	 */
+	want_width = width;
+	want_height = height;
+	if (cap_width > 0 && want_width > cap_width) {
+		want_height = (want_height * cap_width + want_width / 2) /
+				want_width;
+		want_width = cap_width;
+	}
+	if (cap_height > 0 && want_height > cap_height) {
+		want_width = (want_width * cap_height + want_height / 2) /
+				want_height;
+		want_height = cap_height;
+	}
+	if (want_width < 1) {
+		want_width = 1;
+	}
+	if (want_height < 1) {
+		want_height = 1;
+	}
+
+	*dest_width = (int) want_width;
+	*dest_height = (int) want_height;
+
+	return (*dest_width != width || *dest_height != height);
+}
