+/* exported interface documented in image_cache.h */
+void *image_cache_shrink(void *bitmap, int dest_width, int dest_height)
+{
+	int src_width = guit->bitmap->get_width(bitmap);
+	int src_height = guit->bitmap->get_height(bitmap);
+	bool opaque = guit->bitmap->get_opaque(bitmap);
+	const uint8_t *src;
+	uint8_t *dst;
+	size_t src_stride;
+	size_t dst_stride;
+	void *out;
+	int x;
+	int y;
+
+	if (dest_width < 1 || dest_height < 1 ||
+	    src_width < 1 || src_height < 1 ||
+	    dest_width > src_width || dest_height > src_height) {
+		return NULL;
+	}
+
+	out = guit->bitmap->create(dest_width, dest_height,
+				   opaque ? BITMAP_OPAQUE : BITMAP_NONE);
+	if (out == NULL) {
+		return NULL;
+	}
+
+	src = guit->bitmap->get_buffer(bitmap);
+	dst = guit->bitmap->get_buffer(out);
+	if (src == NULL || dst == NULL) {
+		guit->bitmap->destroy(out);
+		return NULL;
+	}
+	src_stride = guit->bitmap->get_rowstride(bitmap);
+	dst_stride = guit->bitmap->get_rowstride(out);
+
+	for (y = 0; y < dest_height; y++) {
+		int y0 = (int) (((int64_t) y * src_height) / dest_height);
+		int y1 = (int) (((int64_t) (y + 1) * src_height) /
+				dest_height);
+		uint8_t *drow = dst + (size_t) y * dst_stride;
+
+		if (y1 <= y0) {
+			y1 = y0 + 1;
+		}
+
+		for (x = 0; x < dest_width; x++) {
+			int x0 = (int) (((int64_t) x * src_width) /
+					dest_width);
+			int x1 = (int) (((int64_t) (x + 1) * src_width) /
+					dest_width);
+			uint32_t r = 0, g = 0, b = 0, a = 0;
+			uint32_t n = 0;
+			int sx, sy;
+
+			if (x1 <= x0) {
+				x1 = x0 + 1;
+			}
+
+			for (sy = y0; sy < y1; sy++) {
+				const uint8_t *srow = src +
+						(size_t) sy * src_stride;
+
+				for (sx = x0; sx < x1; sx++) {
+					const uint8_t *px = srow + sx * 4;
+					uint32_t pa = px[bitmap_layout.a];
+
+					/*
+					 * Weighted by alpha, so that what a
+					 * transparent pixel happens to hold
+					 * in its colour channels does not
+					 * bleed into the average.
+					 */
+					r += px[bitmap_layout.r] * pa;
+					g += px[bitmap_layout.g] * pa;
+					b += px[bitmap_layout.b] * pa;
+					a += pa;
+					n++;
+				}
+			}
+
+			if (a == 0) {
+				drow[bitmap_layout.r] = 0;
+				drow[bitmap_layout.g] = 0;
+				drow[bitmap_layout.b] = 0;
+				drow[bitmap_layout.a] = 0;
+			} else {
+				drow[bitmap_layout.r] = (uint8_t) (r / a);
+				drow[bitmap_layout.g] = (uint8_t) (g / a);
+				drow[bitmap_layout.b] = (uint8_t) (b / a);
+				drow[bitmap_layout.a] = (uint8_t) (a / n);
+			}
+			drow += 4;
+		}
+	}
+
+	guit->bitmap->set_opaque(out, opaque);
+	guit->bitmap->modified(out);
+
+	return out;
+}
