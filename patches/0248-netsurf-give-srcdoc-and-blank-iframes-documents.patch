diff --git a/content/handlers/html/frame_doc.c b/content/handlers/html/frame_doc.c
new file mode 100644
index 000000000..8cc4348ae
--- /dev/null
+++ b/content/handlers/html/frame_doc.c
@@ -0,0 +1,334 @@
+/*
+ * Copyright 2026 VitaSurf contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Documents an iframe makes itself (VitaSurf); see frame_doc.h.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include <stdlib.h>
+#include <string.h>
+#include <dom/dom.h>
+
+#include "utils/utils.h"
+#include "utils/errors.h"
+#include "utils/corestrings.h"
+#include "utils/nsurl.h"
+#include "content/content.h"
+
+#include "html/private.h"
+#include "html/box.h"
+#include "html/box_construct.h"
+#include "html/frame_doc.h"
+
+struct frame_doc {
+	struct frame_doc *next;
+	html_content *owner;
+	dom_node *node;
+	bool srcdoc;
+	char *text;		/**< srcdoc text, NULL for a blank document */
+	size_t len;
+	nsurl *url;
+	nsurl *base;
+	bool armed;		/**< its frame is navigating to it */
+};
+
+static struct frame_doc *frame_docs;
+static unsigned int frame_doc_serial;
+static uint32_t frame_doc_seed;
+
+/**
+ * A number for a URL that another page cannot guess. The URL is never
+ * shown to script, and a load that is not the frame's own is refused
+ * anyway; this is the second lock.
+ */
+static uint32_t frame_doc_token(void)
+{
+	uint32_t x;
+
+	if (frame_doc_seed == 0) {
+		frame_doc_seed = (uint32_t)time(NULL) ^
+			(uint32_t)(uintptr_t)&frame_docs ^ 0x9e3779b9u;
+		if (frame_doc_seed == 0) {
+			frame_doc_seed = 1;
+		}
+	}
+	/* xorshift32 */
+	x = frame_doc_seed;
+	x ^= x << 13;
+	x ^= x >> 17;
+	x ^= x << 5;
+	frame_doc_seed = x;
+	return x ^ (uint32_t)clock();
+}
+
+static void frame_doc_free(struct frame_doc *d)
+{
+	dom_node_unref(d->node);
+	nsurl_unref(d->url);
+	if (d->base != NULL) {
+		nsurl_unref(d->base);
+	}
+	free(d->text);
+	free(d);
+}
+
+/**
+ * The entry for an element's document of one kind, made if need be. A
+ * srcdoc that has changed gets a new entry, and so a new URL, which is
+ * what makes the frame load it again.
+ */
+static nserror frame_doc_get(html_content *c, dom_node *node, bool srcdoc,
+		const char *text, size_t len, struct frame_doc **out)
+{
+	struct frame_doc **p, *d;
+	char buf[64];
+	nserror err;
+
+	for (p = &frame_docs; (d = *p) != NULL; p = &d->next) {
+		if (d->owner != c || d->node != node || d->srcdoc != srcdoc) {
+			continue;
+		}
+		if (!srcdoc || (d->len == len &&
+				memcmp(d->text, text, len) == 0)) {
+			*out = d;
+			return NSERROR_OK;
+		}
+		/* the srcdoc changed: the old text is not needed again */
+		*p = d->next;
+		frame_doc_free(d);
+		break;
+	}
+
+	d = calloc(1, sizeof(*d));
+	if (d == NULL) {
+		return NSERROR_NOMEM;
+	}
+	if (srcdoc) {
+		d->text = malloc(len + 1);
+		if (d->text == NULL) {
+			free(d);
+			return NSERROR_NOMEM;
+		}
+		memcpy(d->text, text, len);
+		d->text[len] = '\0';
+		d->len = len;
+	}
+	snprintf(buf, sizeof(buf), "about:%s?vitasurf-frame=%u-%08x%08x",
+		 srcdoc ? "srcdoc" : "blank", ++frame_doc_serial,
+		 (unsigned int)frame_doc_token(),
+		 (unsigned int)frame_doc_token());
+	err = nsurl_create(buf, &d->url);
+	if (err != NSERROR_OK) {
+		free(d->text);
+		free(d);
+		return err;
+	}
+	if (c->base_url != NULL) {
+		d->base = nsurl_ref(c->base_url);
+	}
+	d->owner = c;
+	d->node = dom_node_ref(node);
+	d->srcdoc = srcdoc;
+	d->next = frame_docs;
+	frame_docs = d;
+	*out = d;
+	return NSERROR_OK;
+}
+
+static struct frame_doc *frame_doc_find(nsurl *url)
+{
+	struct frame_doc *d;
+
+	for (d = frame_docs; d != NULL; d = d->next) {
+		if (nsurl_compare(d->url, url, NSURL_COMPLETE)) {
+			return d;
+		}
+	}
+	return NULL;
+}
+
+/* exported interface documented in html/frame_doc.h */
+nserror html_iframe_url(html_content *c, dom_node *node, nsurl **url)
+{
+	struct frame_doc *d;
+	dom_string *name, *s = NULL;
+	dom_exception exc;
+	nserror err;
+
+	*url = NULL;
+
+	/* srcdoc, even an empty one, wins over src */
+	exc = dom_string_create((const uint8_t *)"srcdoc", SLEN("srcdoc"),
+				&name);
+	if (exc != DOM_NO_ERR) {
+		return NSERROR_NOMEM;
+	}
+	exc = dom_element_get_attribute(node, name, &s);
+	dom_string_unref(name);
+	if (exc == DOM_NO_ERR && s != NULL) {
+		err = frame_doc_get(c, node, true, dom_string_data(s),
+				    dom_string_byte_length(s), &d);
+		dom_string_unref(s);
+		if (err == NSERROR_OK) {
+			*url = nsurl_ref(d->url);
+		}
+		return err;
+	}
+
+	exc = dom_element_get_attribute(node, corestring_dom_src, &s);
+	if (exc == DOM_NO_ERR && s != NULL) {
+		if (box_extract_link(c, s, c->base_url, url) == false) {
+			dom_string_unref(s);
+			return NSERROR_NOMEM;
+		}
+		dom_string_unref(s);
+	}
+	if (*url != NULL) {
+		lwc_string *scheme = nsurl_get_component(*url, NSURL_SCHEME);
+		lwc_string *path = nsurl_get_component(*url, NSURL_PATH);
+		bool about = (scheme == corestring_lwc_about && path != NULL);
+		bool blank = (about &&
+			      lwc_string_length(path) == SLEN("blank") &&
+			      memcmp(lwc_string_data(path), "blank",
+				     SLEN("blank")) == 0 &&
+			      !nsurl_has_component(*url, NSURL_QUERY));
+		/* about:srcdoc is only ever a srcdoc's; a src cannot name it */
+		bool srcdoc = (about &&
+			       lwc_string_length(path) == SLEN("srcdoc") &&
+			       memcmp(lwc_string_data(path), "srcdoc",
+				      SLEN("srcdoc")) == 0);
+
+		if (scheme != NULL) {
+			lwc_string_unref(scheme);
+		}
+		if (path != NULL) {
+			lwc_string_unref(path);
+		}
+		if (srcdoc) {
+			nsurl_unref(*url);
+			*url = NULL;
+			return NSERROR_OK;
+		}
+		if (!blank) {
+			/* don't include ourself */
+			if (nsurl_compare(c->base_url, *url,
+					  NSURL_COMPLETE)) {
+				nsurl_unref(*url);
+				*url = NULL;
+			}
+			return NSERROR_OK;
+		}
+		nsurl_unref(*url);
+		*url = NULL;
+	}
+
+	/* no src, an empty one or about:blank: the frame's own blank page */
+	err = frame_doc_get(c, node, false, NULL, 0, &d);
+	if (err == NSERROR_OK) {
+		*url = nsurl_ref(d->url);
+	}
+	return err;
+}
+
+/* exported interface documented in html/frame_doc.h */
+bool html_frame_doc_arm(nsurl *url, dom_node *frame_node)
+{
+	struct frame_doc *d;
+	lwc_string *scheme;
+	bool about;
+
+	scheme = nsurl_get_component(url, NSURL_SCHEME);
+	about = (scheme == corestring_lwc_about);
+	if (scheme != NULL) {
+		lwc_string_unref(scheme);
+	}
+	if (!about || (d = frame_doc_find(url)) == NULL) {
+		return true;
+	}
+	if (frame_node == NULL || d->node != frame_node) {
+		return false;
+	}
+	d->armed = true;
+	return true;
+}
+
+/* exported interface documented in html/frame_doc.h */
+bool html_frame_doc_is_blank(nsurl *url)
+{
+	struct frame_doc *d = frame_doc_find(url);
+
+	return d != NULL && !d->srcdoc;
+}
+
+/* exported interface documented in html/frame_doc.h */
+bool html_frame_doc_source(nsurl *url, const char **data, size_t *len)
+{
+	struct frame_doc *d = frame_doc_find(url);
+
+	if (d == NULL || !d->srcdoc || !d->armed) {
+		return false;
+	}
+	*data = d->text;
+	*len = d->len;
+	return true;
+}
+
+/* exported interface documented in html/frame_doc.h */
+nsurl *html_frame_doc_base(nsurl *url)
+{
+	struct frame_doc *d;
+	lwc_string *scheme;
+	bool about;
+
+	/* most contents are not frame documents: skip the list for them */
+	scheme = nsurl_get_component(url, NSURL_SCHEME);
+	about = (scheme == corestring_lwc_about);
+	if (scheme != NULL) {
+		lwc_string_unref(scheme);
+	}
+	if (!about) {
+		return NULL;
+	}
+	d = frame_doc_find(url);
+	if (d == NULL || !d->armed) {
+		return NULL;
+	}
+	/* the frame's document is being made: that is the end of the
+	 * load this entry was armed for */
+	d->armed = false;
+	return d->base;
+}
+
+/* exported interface documented in html/frame_doc.h */
+void html_frame_doc_release(html_content *c)
+{
+	struct frame_doc **p = &frame_docs, *d;
+
+	while ((d = *p) != NULL) {
+		if (d->owner == c) {
+			*p = d->next;
+			frame_doc_free(d);
+		} else {
+			p = &d->next;
+		}
+	}
+}
