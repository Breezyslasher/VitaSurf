+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Documents an iframe makes itself: srcdoc, and the blank document of an
+ * iframe with no src (VitaSurf).
+ *
+ * Each is loaded from an about: URL that names the frame
+ * (about:srcdoc?vitasurf-frame=N, about:blank?vitasurf-frame=N), so the
+ * about fetcher can hand over the srcdoc text and the html content can
+ * take its parent's base URL, which both documents inherit. An entry
+ * belongs to the page holding the iframe and goes with it; each iframe
+ * has at most one of each kind.
+ */
+
+#ifndef NETSURF_HTML_FRAME_DOC_H
+#define NETSURF_HTML_FRAME_DOC_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "utils/errors.h"
+
+struct html_content;
+struct dom_node;
+struct nsurl;
+
+/**
+ * The URL an iframe element loads: its srcdoc if it has one, else its
+ * src, else its blank document.
+ *
+ * \param c    html content the element is in
+ * \param node the iframe element
+ * \param url  updated to a new reference, or NULL when the frame loads
+ *             nothing (its src is the page itself)
+ * \return NSERROR_OK or an error
+ */
+nserror html_iframe_url(struct html_content *c, struct dom_node *node,
+		struct nsurl **url);
+
+/**
+ * Let a browser window load a URL (VitaSurf). An iframe's own documents
+ * load only in that iframe's window: true, and the URL armed for one
+ * load, when frame_node is the element the URL was made for; false when
+ * it is not. Any other URL is always allowed.
+ */
+bool html_frame_doc_arm(struct nsurl *url, struct dom_node *frame_node);
+
+/** Whether a URL is one an iframe made for its blank document. */
+bool html_frame_doc_is_blank(struct nsurl *url);
+
+/**
+ * The srcdoc text a URL names, if its frame is loading it. The text
+ * stays valid until the page that holds the iframe goes or the srcdoc
+ * changes.
+ *
+ * \return true with the text in data and len, false if it names none
+ */
+bool html_frame_doc_source(struct nsurl *url, const char **data,
+		size_t *len);
+
+/**
+ * The base URL a frame document inherits (not a new reference), or NULL.
+ * Asked as the document is made, which ends the load it was armed for.
+ */
+struct nsurl *html_frame_doc_base(struct nsurl *url);
+
+/** Forget a page's frame documents, as it goes. */
+void html_frame_doc_release(struct html_content *c);
+
+#endif
