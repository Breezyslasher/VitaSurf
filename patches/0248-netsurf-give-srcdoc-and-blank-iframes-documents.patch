+/* exported function documented in desktop/frames.h */
+nserror browser_window_iframe_now(struct browser_window *bw,
+				  struct dom_node *node,
+				  struct browser_window **out)
+{
+	struct hlcache_handle *page;
+	struct browser_window *window, **grown;
+	dom_string *name = NULL;
+	nsurl *url;
+	nserror err;
+	int i;
+
+	*out = NULL;
+	page = frame_node_page(bw, node);
+	if (page == NULL) {
+		return NSERROR_NOT_FOUND;
+	}
+	err = html_iframe_url((struct html_content *)
+			      hlcache_handle_get_content(page), node, &url);
+	if (err != NSERROR_OK) {
+		return err;
+	}
+
+	for (i = 0; i < bw->iframe_count; i++) {
+		if (bw->iframes[i] == NULL ||
+		    bw->iframes[i]->frame_node != node) {
+			continue;
+		}
+		window = bw->iframes[i];
+		*out = window;
+		/* the element has a new src or srcdoc: go there now */
+		if (url != NULL && (window->frame_src == NULL ||
+		    !nsurl_compare(window->frame_src, url,
+				   NSURL_COMPLETE))) {
+			if (window->frame_src != NULL) {
+				nsurl_unref(window->frame_src);
+			}
+			window->frame_src = url;
+			url = NULL;
+			err = browser_window_navigate(window,
+					window->frame_src,
+					hlcache_handle_get_url(page),
+					BW_NAVIGATE_UNVERIFIABLE,
+					NULL, NULL, page);
+			if (err == NSERROR_OK &&
+			    window->loading_content != NULL &&
+			    html_frame_doc_is_blank(window->frame_src)) {
+				err = hlcache_handle_run_now(
+						window->loading_content);
+			}
+		}
+		if (url != NULL) {
+			nsurl_unref(url);
+		}
+		return err;
+	}
+	if (url == NULL) {
+		return NSERROR_OK;
+	}
+
+	grown = realloc(bw->iframes,
+			(bw->iframe_count + 1) * sizeof(*grown));
+	if (grown == NULL) {
+		nsurl_unref(url);
+		return NSERROR_NOMEM;
+	}
+	bw->iframes = grown;
+
+	(void)dom_element_get_attribute(node, corestring_dom_name, &name);
+	window = iframe_window_new(bw, node,
+				   name != NULL ? dom_string_data(name) : NULL);
+	if (name != NULL) {
+		dom_string_unref(name);
+	}
+	if (window == NULL) {
+		nsurl_unref(url);
+		return NSERROR_NOMEM;
+	}
+	/* an iframe's default size, until layout gives it its box */
+	browser_window_set_dimensions(window, 300, 150);
+	window->frame_src = url;
+	bw->iframes[bw->iframe_count++] = window;
+
+	err = browser_window_navigate(window, url,
+				      hlcache_handle_get_url(page),
+				      BW_NAVIGATE_UNVERIFIABLE,
+				      NULL, NULL, page);
+	/* a blank document is there the moment the element is */
+	if (err == NSERROR_OK && window->loading_content != NULL &&
+	    html_frame_doc_is_blank(url)) {
+		err = hlcache_handle_run_now(window->loading_content);
+	}
+	*out = window;
+	return err;
+}
