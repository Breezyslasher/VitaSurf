index 09a76a7..8b7e41f 100644
--- a/libunicode.c
+++ b/libunicode.c
@@ -1380,24 +1380,95 @@ static void cr_sort_and_remove_overlap(CharRange *cr)
 
 /* canonicalize a character set using the JS regex case folding rules
    (see lre_canonicalize()) */
+/*
+ * The characters case folding changes, and the rest, for each mode
+ * (VitaSurf): made once and kept, with the C allocator, for the life of
+ * the program. They had been made from the whole case table for every
+ * class of a regular expression with the i flag, some 110,000
+ * instructions each, as a page's scripts were compiled.
+ */
+static int cr_case_masks(bool is_unicode, const CharRange **pmask,
+                         const CharRange **pinv)
+{
+    static CharRange mask[2], inv[2];
+    static bool made[2];
+    int k = is_unicode;
+
+    if (!made[k]) {
+        cr_init(&mask[k], NULL, NULL);
+        cr_init(&inv[k], NULL, NULL);
+        if (unicode_case1(&mask[k], is_unicode ? CASE_F : CASE_U) ||
+            cr_copy(&inv[k], &mask[k]) || cr_invert(&inv[k])) {
+            cr_free(&mask[k]);
+            cr_free(&inv[k]);
+            return -1;
+        }
+        made[k] = true;
+    }
+    *pmask = &mask[k];
+    *pinv = &inv[k];
+    return 0;
+}
+
+/*
+ * cr = big & small, reading only the intervals of big that can meet
+ * small (VitaSurf): a class of a few ranges against the whole case
+ * table had walked all of the table.
+ */
+static int cr_inter_span(CharRange *cr, const CharRange *big,
+                         const CharRange *small)
+{
+    int lo, hi, a, b, m;
+    uint32_t first, last;
+
+    if (small->len == 0)
+        return cr_op(cr, big->points, 0, small->points, 0, CR_OP_INTER);
+    first = small->points[0];
+    last = small->points[small->len - 1];
+    /* lo: the first point of big above first, back to its interval's
+       start; hi: the first point of big at or above last, on to its
+       interval's end */
+    a = 0;
+    b = big->len;
+    while (a < b) {
+        m = (a + b) / 2;
+        if (big->points[m] <= first)
+            a = m + 1;
+        else
+            b = m;
+    }
+    lo = a & ~1;
+    a = lo;
+    b = big->len;
+    while (a < b) {
+        m = (a + b) / 2;
+        if (big->points[m] < last)
+            a = m + 1;
+        else
+            b = m;
+    }
+    hi = (a + 1) & ~1;
+    if (hi > big->len)
+        hi = big->len;
+    return cr_op(cr, big->points + lo, hi - lo, small->points, small->len,
+                 CR_OP_INTER);
+}
