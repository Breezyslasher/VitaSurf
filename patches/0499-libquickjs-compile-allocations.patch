+    if (cr_inter_span(&cr_inter, mask, cr))
         goto fail;
-    if (cr_op(&cr_sub, cr_mask.points, cr_mask.len, cr->points, cr->len, CR_OP_INTER))
+    if (cr_inter_span(&cr_sub, inv, cr))
         goto fail;
 
     /* cr_inter = cr & cr_mask */
@@ -1452,13 +1523,11 @@ int cr_regexp_canonicalize(CharRange *cr, bool is_unicode)
         goto fail;
 
