+/*
+ * @supports (VitaSurf). The condition is evaluated here, at parse
+ * time, so a block guarded on a feature this browser lacks is dropped
+ * and a fallback written for it applies. "(property: value)" holds
+ * when the property is known and the value parses; "selector(...)"
+ * holds; any other function does not. not, and and or combine as the
+ * specification says, and a general-enclosed thing nobody understands
+ * is false.
+ */
+static css_error supportsCondition(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx, int depth,
+		bool *result);
+
+/** Step past a balanced group, the opening token already consumed. */
+static void supportsSkipGroup(const parserutils_vector *vector, int32_t *ctx)
+{
+	const css_token *t;
+	int depth = 1;
+
+	while (depth > 0 && (t = parserutils_vector_iterate(vector, ctx)) !=
+			NULL) {
+		if (t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '('))
+			depth++;
+		else if (tokenIsChar(t, ')'))
+			depth--;
+	}
+}
+
+/** Whether "property: value", read up to the closing bracket, parses. */
+static bool supportsDeclaration(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx)
+{
+	const css_token *ident, *t;
+	css_prop_handler handler = NULL;
+	css_style *style = NULL;
+	int32_t inner;
+	int i;
+	bool ok = false;
+
+	consumeWhitespace(vector, ctx);
+	ident = parserutils_vector_iterate(vector, ctx);
+	if (ident == NULL || ident->type != CSS_TOKEN_IDENT)
+		return false;
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_iterate(vector, ctx);
+	if (t == NULL || !tokenIsChar(t, ':'))
+		return false;
+	consumeWhitespace(vector, ctx);
+
+	for (i = FIRST_PROP; i <= LAST_PROP; i++) {
+		bool match = false;
+
+		if (lwc_string_caseless_isequal(ident->idata, c->strings[i],
+				&match) == lwc_error_ok && match)
+			break;
+	}
+	if (i > LAST_PROP)
+		return false;
+	handler = property_handlers[i - FIRST_PROP];
+
+	if (css__stylesheet_style_create(c->sheet, &style) != CSS_OK)
+		return false;
+	inner = *ctx;
+	if (handler(c, vector, &inner, style) == CSS_OK) {
+		consumeWhitespace(vector, &inner);
+		t = parserutils_vector_peek(vector, inner);
+		ok = t != NULL && tokenIsChar(t, ')');
+	}
+	css__stylesheet_style_destroy(style);
+	return ok;
+}
+
+/** One operand: a bracketed condition or declaration, or a function. */
+static css_error supportsInParens(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx, int depth,
+		bool *result)
+{
+	const css_token *t;
+	int32_t save;
+
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_iterate(vector, ctx);
+	if (t == NULL)
+		return CSS_INVALID;
+
+	if (t->type == CSS_TOKEN_FUNCTION) {
+		bool match;
+
+		/* selector() is taken as supported; font-tech(),
+		 * font-format() and the rest are not */
+		*result = lwc_string_caseless_isequal(t->idata,
+				c->strings[SELECTOR_FN], &match) ==
+				lwc_error_ok && match;
+		supportsSkipGroup(vector, ctx);
+		return CSS_OK;
+	}
+
+	if (!tokenIsChar(t, '('))
+		return CSS_INVALID;
+
+	/* a nested condition, or a declaration */
+	save = *ctx;
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_peek(vector, *ctx);
+	if (t != NULL && (tokenIsChar(t, '(') ||
+			t->type == CSS_TOKEN_FUNCTION ||
+			(t->type == CSS_TOKEN_IDENT &&
+			 nameIs(t->idata, "not")))) {
+		css_error error = supportsCondition(c, vector, ctx,
+				depth + 1, result);
+
+		if (error != CSS_OK)
+			return error;
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		if (t == NULL || !tokenIsChar(t, ')'))
+			return CSS_INVALID;
+		return CSS_OK;
+	}
+
+	*ctx = save;
+	*result = supportsDeclaration(c, vector, ctx);
+	/* to the bracket that closes it, whatever was in between */
+	supportsSkipGroup(vector, ctx);
+	return CSS_OK;
+}
+
+static css_error supportsCondition(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx, int depth,
+		bool *result)
+{
+	const css_token *t;
+	bool value;
+	css_error error;
+
+	if (depth > 16)
+		return CSS_INVALID;
+
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_peek(vector, *ctx);
+	if (t != NULL && t->type == CSS_TOKEN_IDENT && nameIs(t->idata, "not")) {
+		parserutils_vector_iterate(vector, ctx);
+		error = supportsInParens(c, vector, ctx, depth, &value);
+		if (error != CSS_OK)
+			return error;
+		*result = !value;
+		return CSS_OK;
+	}
+
+	error = supportsInParens(c, vector, ctx, depth, &value);
+	if (error != CSS_OK)
+		return error;
+
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_peek(vector, *ctx);
+		if (t == NULL || t->type != CSS_TOKEN_IDENT)
+			break;
+		if (nameIs(t->idata, "and")) {
+			bool next;
+
+			parserutils_vector_iterate(vector, ctx);
+			error = supportsInParens(c, vector, ctx, depth, &next);
+			if (error != CSS_OK)
+				return error;
+			value = value && next;
+		} else if (nameIs(t->idata, "or")) {
+			bool next;
+
+			parserutils_vector_iterate(vector, ctx);
+			error = supportsInParens(c, vector, ctx, depth, &next);
+			if (error != CSS_OK)
+				return error;
+			value = value || next;
+		} else {
+			break;
+		}
+	}
+
+	*result = value;
+	return CSS_OK;
+}
+
