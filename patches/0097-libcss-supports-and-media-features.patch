diff --git a/src/select/mq.h b/src/select/mq.h
index 5a8de6e..ba3d005 100644
--- a/src/select/mq.h
+++ b/src/select/mq.h
@@ -160,7 +160,196 @@ static inline bool mq_match_feature(
 		return false;
 	}
 
-	/* TODO: Look at other feature names. */
+	/*
+	 * The features a page asks about beyond its size (VitaSurf).
+	 * Each reads the media description the client filled in; a
+	 * boolean query holds when the feature is not none or zero.
+	 */
+#define MQ_NAME(field) (lwc_string_isequal(feat->name, str->field, \
+		&match) == lwc_error_ok && match)
+#define MQ_IS(field) (feat->op == CSS_MQ_FEATURE_OP_EQ && \
+		mq_match_feature_eq_ident_op1(feat->op, &feat->value, \
+				str->field))
+
+	if (MQ_NAME(orientation)) {
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return true;
+		if (MQ_IS(portrait))
+			return media->orientation ==
+					CSS_MEDIA_ORIENTATION_PORTRAIT;
+		if (MQ_IS(landscape))
+			return media->orientation ==
+					CSS_MEDIA_ORIENTATION_LANDSCAPE;
+		return false;
+	}
+
+	if (MQ_NAME(hover) || MQ_NAME(any_hover)) {
+		css_media_hover h = MQ_NAME(hover) ? media->hover :
+				media->any_hover;
+
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return h == CSS_MEDIA_HOVER_HOVER;
+		if (MQ_IS(hover))
+			return h == CSS_MEDIA_HOVER_HOVER;
+		if (MQ_IS(none))
+			return h == CSS_MEDIA_HOVER_NONE;
+		return false;
+	}
+
+	if (MQ_NAME(pointer) || MQ_NAME(any_pointer)) {
+		css_media_pointer p = MQ_NAME(pointer) ? media->pointer :
+				media->any_pointer;
+
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return p != CSS_MEDIA_POINTER_NONE;
+		if (MQ_IS(coarse))
+			return p == CSS_MEDIA_POINTER_COARSE;
+		if (MQ_IS(fine))
+			return p == CSS_MEDIA_POINTER_FINE;
+		if (MQ_IS(none))
+			return p == CSS_MEDIA_POINTER_NONE;
+		return false;
+	}
+
+	if (MQ_NAME(prefers_reduced_motion) ||
+			MQ_NAME(prefers_reduced_transparency) ||
+			MQ_NAME(prefers_contrast)) {
+		/* no preference is expressed */
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return false;
+		return MQ_IS(no_preference);
+	}
+
+	if (MQ_NAME(forced_colors) || MQ_NAME(inverted_colors)) {
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return false;
+		return MQ_IS(none);
+	}
+
+	if (MQ_NAME(display_mode)) {
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return true;
+		return MQ_IS(browser);
+	}
+
+	if (MQ_NAME(color_gamut)) {
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return true;
+		return MQ_IS(srgb);
+	}
+
+	if (MQ_NAME(dynamic_range)) {
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return true;
+		return MQ_IS(standard);
+	}
+
+	if (MQ_NAME(scripting)) {
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return media->scripting != CSS_MEDIA_SCRIPTING_NONE;
+		if (MQ_IS(enabled))
+			return media->scripting == CSS_MEDIA_SCRIPTING_ENABLED;
+		if (MQ_IS(none))
+			return media->scripting == CSS_MEDIA_SCRIPTING_NONE;
+		return false;
+	}
+
+	if (MQ_NAME(update)) {
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return media->update != CSS_MEDIA_UPDATE_FREQUENCY_NONE;
+		if (MQ_IS(fast))
+			return media->update ==
+					CSS_MEDIA_UPDATE_FREQUENCY_NORMAL;
+		if (MQ_IS(none))
+			return media->update == CSS_MEDIA_UPDATE_FREQUENCY_NONE;
+		return false;
+	}
+
+	if (MQ_NAME(grid) || MQ_NAME(monochrome)) {
+		/* a bitmap colour screen: both are zero */
+		css_fixed v = MQ_NAME(grid) ? media->grid : media->monochrome;
+
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return v != 0;
+		if (feat->value.type != CSS_MQ_VALUE_TYPE_NUM)
+			return false;
+		return feat->value.data.num_or_ratio == v;
+	}
+
+	if (MQ_NAME(color) || MQ_NAME(min_color)) {
+		css_fixed v = feat->value.data.num_or_ratio;
+
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return media->color != 0;
+		if (feat->value.type != CSS_MQ_VALUE_TYPE_NUM)
+			return false;
+		switch (feat->op) {
+		case CSS_MQ_FEATURE_OP_LT:  return v <  media->color;
+		case CSS_MQ_FEATURE_OP_LTE: return v <= media->color;
+		case CSS_MQ_FEATURE_OP_EQ:  return v == media->color;
+		case CSS_MQ_FEATURE_OP_GTE: return v >= media->color;
+		case CSS_MQ_FEATURE_OP_GT:  return v >  media->color;
+		default: return false;
+		}
+	}
+
+	if (MQ_NAME(resolution) || MQ_NAME(min_resolution) ||
+			MQ_NAME(max_resolution)) {
+		/* both sides in dots per inch: the client's value is read
+		 * as dpi whatever unit it carries, since css_unit has no
+		 * resolution units, and nothing means 96 */
+		css_fixed have = media->resolution.value;
+		css_fixed want;
+		css_mq_feature_op op = feat->op;
+
+		if (have == 0)
+			have = INTTOFIX(96);
+
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return true;
+		if (feat->value.type != CSS_MQ_VALUE_TYPE_DIM)
+			return false;
+		want = feat->value.data.dim.len;
+		switch (feat->value.data.dim.unit) {
+		case UNIT_DPPX: want = FMUL(want, INTTOFIX(96)); break;
+		case UNIT_DPCM: want = FMUL(want, FLTTOFIX(2.54f)); break;
+		case UNIT_DPI: break;
+		default: return false;
+		}
+		switch (op) {
+		case CSS_MQ_FEATURE_OP_LT:  return want <  have;
+		case CSS_MQ_FEATURE_OP_LTE: return want <= have;
+		case CSS_MQ_FEATURE_OP_EQ:  return want == have;
+		case CSS_MQ_FEATURE_OP_GTE: return want >= have;
+		case CSS_MQ_FEATURE_OP_GT:  return want >  have;
+		default: return false;
+		}
+	}
+
+	if (MQ_NAME(aspect_ratio) || MQ_NAME(min_aspect_ratio) ||
+			MQ_NAME(max_aspect_ratio)) {
+		css_fixed have, want;
+
+		if (media->height == 0)
+			return false;
+		have = FDIV(media->width, media->height);
+		if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+			return true;
+		if (feat->value.type != CSS_MQ_VALUE_TYPE_RATIO &&
+				feat->value.type != CSS_MQ_VALUE_TYPE_NUM)
+			return false;
+		want = feat->value.data.num_or_ratio;
+		switch (feat->op) {
+		case CSS_MQ_FEATURE_OP_LT:  return want <  have;
+		case CSS_MQ_FEATURE_OP_LTE: return want <= have;
+		case CSS_MQ_FEATURE_OP_EQ:  return want == have;
+		case CSS_MQ_FEATURE_OP_GTE: return want >= have;
+		case CSS_MQ_FEATURE_OP_GT:  return want >  have;
+		default: return false;
+		}
+	}
+#undef MQ_NAME
+#undef MQ_IS
 
 	return false;
 }
