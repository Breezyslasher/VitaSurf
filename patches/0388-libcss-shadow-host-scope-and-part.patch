+static void markHostCompounds(css_selector *subject)
+{
+	css_selector *s = subject;
+
+	for (; s != NULL; s = s->combinator) {
+		const css_selector_detail *d = &s->data;
+
+		for (;;) {
+			if (detailIs(d, "-vita-host")) {
+				s->data.cross = 1;
+				subject->data.host_rule = 1;
+			}
