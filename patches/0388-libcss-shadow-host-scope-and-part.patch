+/**
+ * Mark each compound of a chain that names a shadow host with :-vita-host
+ * (VitaSurf): the spelling the shadow tree rewrite gives :host. Only the
+ * step to such a compound may go on from the top of a shadow tree to
+ * its host, so a shadow tree's own rules reach the host and a page's,
+ * and the steps between other compounds, stop at a shadow root.
+ */
+static bool detailIs(const css_selector_detail *d, const char *name)
+{
+	size_t n = strlen(name);
+
+	return d->type == CSS_SELECTOR_PSEUDO_CLASS &&
+			d->qname.name != NULL &&
+			lwc_string_length(d->qname.name) == n &&
+			strncasecmp(lwc_string_data(d->qname.name),
+				name, n) == 0;
+}
+
+static void markHostCompounds(css_selector *s)
+{
+	for (; s != NULL; s = s->combinator) {
+		const css_selector_detail *d = &s->data;
+
+		for (;;) {
+			if (detailIs(d, "-vita-host"))
+				s->data.cross = 1;
+			/* X::part(a), rewritten as X :-vita-part(a): the
+			 * step to X is to the host the part belongs to */
+			if (detailIs(d, "-vita-part") &&
+					s->combinator != NULL &&
+					s->data.comb ==
+						CSS_COMBINATOR_ANCESTOR)
+				s->data.comb = CSS_COMBINATOR_PART;
+			if (!d->next)
+				break;
+			d++;
+		}
+	}
+}
