+/**
+ * The step from a part to the host in X::part(a b) (VitaSurf): \a s is
+ * the part's compound, which carries a :-vita-part() for each name,
+ * and the host the client finds for those names must match the
+ * compound before it, X. Hosts further out are tried in turn, since a
+ * part can be exported to more than one under the same name.
+ */
+static css_error match_part_combinator(css_select_ctx *ctx,
+		const css_selector *s, css_select_state *state, void *node,
+		void **next_node)
+{
+	const css_selector_detail *d = &s->data;
+	lwc_string *names[8];
+	uint32_t n = 0;
+	void *host = NULL;
+	bool match = false;
+	css_error error;
+
+	*next_node = NULL;
+	if (state->handler->part_host == NULL)
+		return CSS_OK;
+	for (;;) {
+		if (d->type == CSS_SELECTOR_PSEUDO_CLASS &&
+				d->value_type ==
+					CSS_SELECTOR_DETAIL_VALUE_STRING &&
+				d->value.string != NULL &&
+				lwc_is(d->qname.name, "-vita-part")) {
+			if (n == N_ELEMENTS(names))
+				return CSS_OK;
+			names[n++] = d->value.string;
+		}
+		if (!d->next)
+			break;
+		d++;
+	}
+	if (n == 0)
+		return CSS_OK;
+	for (;;) {
+		error = state->handler->part_host(state->pw, node, names, n,
+				host, &host);
+		if (error != CSS_OK || host == NULL)
+			return error;
+		error = match_has_compound(ctx, host, s->combinator, state,
+				&match);
+		if (error != CSS_OK)
+			return error;
+		if (match) {
+			*next_node = host;
+			return CSS_OK;
+		}
+	}
+}
