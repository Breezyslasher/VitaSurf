+/**
+ * Make the window for one iframe (VitaSurf: its own allocation).
+ */
+static struct browser_window *
+iframe_window_new(struct browser_window *bw, struct content_html_iframe *cur)
+{
+	struct browser_window *window = calloc(1, sizeof(*window));
+
+	if (window == NULL) {
+		return NULL;
+	}
+	if (browser_window_initialise_common(BW_CREATE_NONE,
+			window, NULL) != NSERROR_OK) {
+		free(window);
+		return NULL;
+	}
+	window->browser_window_type = BROWSER_WINDOW_IFRAME;
+	window->no_resize = true;
+	window->scale = bw->scale;
+	if (cur->name != NULL) {
+		window->name = strdup(cur->name);
+	}
+	window->parent = bw;
+	if (cur->box->node != NULL) {
+		window->frame_node = dom_node_ref(cur->box->node);
+	}
+	return window;
+}
+
+/**
+ * Tie an iframe window to its box and give it the box's place.
+ */
+static void
+iframe_window_place(struct browser_window *window,
+		    struct content_html_iframe *cur)
+{
+	struct rect rect;
+
+	window->scrolling = cur->scrolling;
+	window->border = cur->border;
+	window->border_colour = cur->border_colour;
+	window->margin_width = cur->margin_width;
+	window->margin_height = cur->margin_height;
+	window->box = cur->box;
+	window->box->iframe = window;
+
+	box_bounds(window->box, &rect);
+	browser_window_set_position(window, rect.x0, rect.y0);
+	browser_window_set_dimensions(window, rect.x1 - rect.x0,
+			rect.y1 - rect.y0);
+}
+
+/**
+ * Destroy one iframe window and free it.
+ */
+static void iframe_window_free(struct browser_window *window)
+{
+	if (window->box != NULL) {
+		window->box->iframe = NULL;
+		window->box = NULL;
+	}
+	browser_window_destroy_internal(window);
+	if (window->frame_node != NULL) {
+		dom_node_unref(window->frame_node);
+		window->frame_node = NULL;
+	}
+	if (window->frame_src != NULL) {
+		nsurl_unref(window->frame_src);
+		window->frame_src = NULL;
+	}
+	free(window);
+}
