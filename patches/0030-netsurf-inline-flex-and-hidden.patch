diff --git a/resources/default.css b/resources/default.css
index fa47c76ff..059fdbc5e 100644
--- a/resources/default.css
+++ b/resources/default.css
@@ -152,3 +152,19 @@ mark {
 	background: yellow;
 	color: black;
 }
+
+/* Things the HTML rendering rules hide that were not here (VitaSurf).
+ *
+ * The hidden attribute above all: it is how a page keeps markup in the
+ * document but out of the way, and without this rule every collapsed
+ * menu, every error partial and every dialog a site ships closed was
+ * drawn. GitHub's home page showed its own "Looks like something went
+ * wrong" template that way.
+ *
+ * hidden="until-found" is meant to keep the box and hide the content,
+ * through content-visibility, which is not implemented; hiding it
+ * outright is closer to what the page intends than showing it. */
+[hidden] { display: none; }
+dialog:not([open]) { display: none; }
+datalist { display: none; }
+input[type=hidden] { display: none; }
