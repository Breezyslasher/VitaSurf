 /* exported interface documented in html/private.h */
+/**
+ * Take the encoding and the forms, and check the root is html, before
+ * the boxes are built: once, whether the parse's end or a geometry read
+ * gets here first (VitaSurf).
+ *
+ * 
+eturn false on an error, already broadcast
+ */
+static bool html_conversion_prepare(html_content *htmlc)
+{
+	dom_exception exc; /* returned by libdom functions */
+	dom_string *node_name;
+	dom_node *html;
+
+	if (htmlc->conversion_prepared) {
+		return true;
+	}
+
+	/* get encoding */
+	if (htmlc->encoding == NULL) {
+		const char *encoding;
+
+		encoding = dom_hubbub_parser_get_encoding(htmlc->parser,
+					&htmlc->encoding_source);
+		if (encoding == NULL) {
+			content_broadcast_error(&htmlc->base,
+						NSERROR_NOMEM,
+						NULL);
+			return false;
+		}
+
+		htmlc->encoding = strdup(encoding);
+		if (htmlc->encoding == NULL) {
+			content_broadcast_error(&htmlc->base,
+						NSERROR_NOMEM,
+						NULL);
+			return false;
+		}
+	}
+
+	/* locate root element and ensure it is html */
+	exc = dom_document_get_document_element(htmlc->document, (void *) &html);
+	if ((exc != DOM_NO_ERR) || (html == NULL)) {
+		NSLOG(netsurf, INFO, "error retrieving html element from dom");
+		content_broadcast_error(&htmlc->base, NSERROR_DOM, NULL);
+		return false;
+	}
+
+	exc = dom_node_get_node_name(html, &node_name);
+	if ((exc != DOM_NO_ERR) ||
+	    (node_name == NULL) ||
+	    (!dom_string_caseless_lwc_isequal(node_name,
+			corestring_lwc_html))) {
+		NSLOG(netsurf, INFO, "root element not html");
+		content_broadcast_error(&htmlc->base, NSERROR_DOM, NULL);
+		if (node_name != NULL) {
+			dom_string_unref(node_name);
+		}
+		dom_node_unref(html);
+		return false;
+	}
+	dom_string_unref(node_name);
+
+	/* Retrieve forms from parser */
+	if (html_forms_from_dom(htmlc) == false) {
+		dom_node_unref(html);
+		return false;
+	}
+
+	dom_node_unref(html);
+	htmlc->conversion_prepared = true;
+
+	return true;
+}
+
+/* exported function documented in html/private.h */
+bool html_layout_early(html_content *htmlc)
+{
+	if (htmlc->layout != NULL) {
+		return true;
+	}
+	/* still parsing, gone, or already waiting to be made ready */
+	if (htmlc->aborted || !htmlc->conversion_begun ||
+	    htmlc->parser == NULL || htmlc->ready_deferred) {
+		return false;
+	}
+	if (htmlc->box_conversion_context == NULL) {
+		/* not begun: the style sheets must be in, as they must for
+		 * the boxes to be begun at all; a selection context with no
+		 * conversion is a content past this point */
+		if (htmlc->select_ctx != NULL ||
+		    html_can_begin_conversion(htmlc) == false ||
+		    html_conversion_prepare(htmlc) == false) {
+			return false;
+		}
+		html_finish_conversion(htmlc);
+		if (htmlc->box_conversion_context == NULL) {
+			return htmlc->layout != NULL;
+		}
+	}
+	htmlc->layout_early = true;
+	finish_dom_to_box(htmlc->box_conversion_context);
+	htmlc->layout_early = false;
+
+	return htmlc->layout != NULL;
+}
