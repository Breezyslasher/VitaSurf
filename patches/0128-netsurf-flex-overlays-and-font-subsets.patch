+/**
+ * Whether a face is for text in the Latin alphabet (VitaSurf).
+ *
+ * A family is often served as one face per script, each with its own
+ * unicode-range, and only one face per family can be installed here.
+ * Taking the first one meant taking the Cyrillic subset of Inter for an
+ * English page, and every word came out as empty boxes.
+ */
+static bool webfont_face_covers_latin(const css_font_face *face)
+{
+	uint32_t n = css_font_face_count_unicode_ranges(face);
+	uint32_t i;
+
+	if (n == 0) {
+		/* no unicode-range: the face is for every code point */
+		return true;
+	}
+
+	for (i = 0; i < n; i++) {
+		uint32_t start = 0, end = 0;
+
+		if (css_font_face_get_unicode_range(face, i, &start, &end) ==
+				CSS_OK && start <= 'A' && 'A' <= end) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
