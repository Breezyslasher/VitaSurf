@@ -287,21 +299,35 @@ static bool bitmap_scaled(nsfb_t *nsfb, const nsfb_bbox_t *loc,
 	dyr = bmp_height % height;
 
 	/* get start offsets to part of image being scaled, after clipping and
-	 * set remainder trackers to correct starting value */
+	 * set remainder trackers to correct starting value. The products are
+	 * taken in 64 bits: a large image scrolled far past the clip made
+	 * (clipped.y0 - y) * bmp_height overflow 32 bits, which produced a
+	 * negative source offset and a read before the image (VitaSurf). */
 	if (clipped.x0 - x != 0) {
-		xoffs = ((clipped.x0 - x) * bmp_width) / width;
-		rxs = ((clipped.x0 - x) * bmp_width) % width;
+		int64_t xo = (int64_t)(clipped.x0 - x) * bmp_width;
+
+		xoffs = (int)(xo / width);
+		rxs = (int)(xo % width);
 	} else {
 		xoffs = 0;
 		rxs = 0;
 	}
 	if (clipped.y0 - y != 0) {
-		yoff = (((clipped.y0 - y) * bmp_height) / height) * bmp_stride;
-		ry = ((clipped.y0 - y) * bmp_height) % height;
