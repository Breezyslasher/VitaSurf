+		yoff = (int)(yo / height) * bmp_stride;
+		ry = (int)(yo % height);
 	} else {
 		yoff = 0;
 		ry = 0;
 	}
+	if (xoffs < 0 || yoff < 0) {
+		/* the target lies entirely before the image */
+		if (set_dither) {
+			nsfb_palette_dither_fini(nsfb->palette);
+		}
+		return true;
+	}
 
 	/* plot the image */
 	pvideo = get_xy_loc(nsfb, clipped.x0, clipped.y0);
