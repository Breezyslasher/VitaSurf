+/* exported interface documented in image_cache.h */
+size_t image_cache_bitmap_bytes(unsigned int *count)
+{
+	if (image_cache == NULL) {
+		*count = 0;
+		return 0;
+	}
+	*count = image_cache->bitmap_count > 0 ?
+		(unsigned int) image_cache->bitmap_count : 0;
+	return image_cache->total_bitmap_size;
+}
