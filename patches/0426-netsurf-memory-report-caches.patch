diff --git a/content/llcache.c b/content/llcache.c
index 43e39f068..22fa6c3be 100644
--- a/content/llcache.c
+++ b/content/llcache.c
@@ -3931,6 +3931,29 @@ static void llcache_users_not_caught_up(void)
  * Public API								      *
  ******************************************************************************/
 
+/* exported interface documented in llcache.h */
+void llcache_memory(uint32_t *bytes, uint32_t *objects)
+{
+	llcache_object *object;
+	uint32_t b = 0, n = 0;
+	int pass;
+
+	if (llcache != NULL) {
+		for (pass = 0; pass < 2; pass++) {
+			object = pass == 0 ? llcache->cached_objects :
+				llcache->uncached_objects;
+			for (; object != NULL; object = object->next) {
+				b += sizeof(*object);
+				if (object->source_data != NULL)
+					b += object->source_alloc;
+				n++;
+			}
+		}
+	}
+	*bytes = b;
+	*objects = n;
+}
