+/**
+ * Paint a CSS gradient background (VitaSurf).
+ *
+ * libcss hands a gradient over as an image whose "URL" spells the
+ * gradient out (see libcss parse/properties/gradient.c). A linear
+ * gradient is painted as a run of strips across the box, each in the
+ * colour the gradient has at its middle, alpha and all, so a
+ * translucent overlay still shows what is under it. The strips run
+ * along whichever axis the gradient's angle is nearer, which is exact
+ * for the four straight directions and a fair likeness of a diagonal.
+ * A radial or conic gradient, which strips cannot draw, is painted as
+ * the average of its stops.
+ *
+ * \param spec  The gradient string, after "gradient:"
+ * \param area  The box the gradient spans, in device pixels
+ * \param clip  Where painting may go
+ * \param ctx   Redraw context
+ * \return true on success, false on plotter error
+ */
+static bool html_redraw_gradient(const char *spec, const struct rect *area,
+		const struct rect *clip, const struct redraw_context *ctx)
+{
+	uint32_t colour[16];
+	int pos[16];
+	int n = 0, i, angle, extent, strips;
+	char kind;
+	const char *p = spec;
+	char *end;
+	bool along_x, reversed;
+	plot_style_t style = { .fill_type = PLOT_OP_TYPE_SOLID };
+
+	kind = *p++;
+	angle = (int) strtol(p, &end, 10);
+	if (end == p || *end != ':')
+		return true;
+	p = end + 1;
+	while (n < 16) {
+		colour[n] = (uint32_t) strtoul(p, &end, 16);
+		if (end == p || *end != '@')
+			break;
+		p = end + 1;
+		pos[n] = (int) strtol(p, &end, 10);
+		if (end == p)
+			break;
+		n++;
+		p = end;
+		if (*p != ',')
+			break;
+		p++;
+	}
+	if (n < 2)
+		return true;
+
+	if (kind != 'L') {
+		/* the average, with as much alpha as the stops have */
+		unsigned a = 0, r = 0, g = 0, b = 0;
+
+		for (i = 0; i < n; i++) {
+			a += colour[i] >> 24;
+			r += (colour[i] >> 16) & 0xff;
+			g += (colour[i] >> 8) & 0xff;
+			b += colour[i] & 0xff;
+		}
+		style.fill_colour = ((0xff - a / n) << 24) |
+				((b / n) << 16) | ((g / n) << 8) | (r / n);
