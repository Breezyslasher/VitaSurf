+	reversed = along_x ? (angle > 180) : (angle < 90 || angle > 270);
+	extent = along_x ? area->x1 - area->x0 : area->y1 - area->y0;
+	if (extent <= 0)
+		return true;
+	strips = extent < 48 ? extent : 48;
+
+	for (i = 0; i < strips; i++) {
+		int s0 = extent * i / strips;
+		int s1 = extent * (i + 1) / strips;
+		int t = ((s0 + s1) * 500) / extent; /* tenths of a percent */
+		int k;
+		unsigned a, r, g, b;
+		struct rect strip = *area;
+
+		if (reversed)
+			t = 1000 - t;
+
+		/* the colour at t, between the stops around it */
+		for (k = 0; k < n - 1 && pos[k + 1] < t; k++)
+			;
+		if (t <= pos[k] || k == n - 1 || pos[k + 1] == pos[k]) {
+			uint32_t c = t <= pos[k] ? colour[k] :
+					colour[k + 1 < n ? k + 1 : k];
+
+			a = c >> 24;
+			r = (c >> 16) & 0xff;
+			g = (c >> 8) & 0xff;
+			b = c & 0xff;
+		} else {
+			int span = pos[k + 1] - pos[k];
+			int w1 = t - pos[k], w0 = span - w1;
+			uint32_t c0 = colour[k], c1 = colour[k + 1];
+
+			a = ((c0 >> 24) * w0 + (c1 >> 24) * w1) / span;
+			r = (((c0 >> 16) & 0xff) * w0 +
+					((c1 >> 16) & 0xff) * w1) / span;
+			g = (((c0 >> 8) & 0xff) * w0 +
+					((c1 >> 8) & 0xff) * w1) / span;
+			b = ((c0 & 0xff) * w0 + (c1 & 0xff) * w1) / span;
+		}
+		if (a == 0)
+			continue;
+
+		if (along_x) {
+			strip.x0 = area->x0 + s0;
+			strip.x1 = area->x0 + s1;
+		} else {
+			strip.y0 = area->y0 + s0;
+			strip.y1 = area->y0 + s1;
+		}
+		if (strip.x0 < clip->x0) strip.x0 = clip->x0;
+		if (strip.y0 < clip->y0) strip.y0 = clip->y0;
+		if (strip.x1 > clip->x1) strip.x1 = clip->x1;
+		if (strip.y1 > clip->y1) strip.y1 = clip->y1;
+		if (strip.x0 >= strip.x1 || strip.y0 >= strip.y1)
+			continue;
+
+		style.fill_colour = ((0xff - a) << 24) | (b << 16) |
+				(g << 8) | r;
+		if (ctx->plot->rectangle(ctx, &style, &strip) != NSERROR_OK)
+			return false;
+	}
+
+	return true;
+}
