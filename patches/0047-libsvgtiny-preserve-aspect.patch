diff --git a/src/svgtiny.c b/src/svgtiny.c
index ab49f8f..510ed28 100644
--- a/src/svgtiny.c
+++ b/src/svgtiny.c
@@ -965,6 +965,39 @@ svgtiny_parse_use(dom_element *use, struct svgtiny_parse_state state)
 /**
  * Parse a <svg> or <g> element node.
  */
+/**
+ * Does this element keep its shape when scaled? (VitaSurf)
+ *
+ * preserveAspectRatio="none" is the one value asking for the axes to
+ * be scaled separately; everything else, including saying nothing at
+ * all, keeps the shape.
+ */
+static bool svgtiny_wants_aspect(dom_element *svg,
+				 struct svgtiny_parse_state *state)
+{
+	dom_string *par = NULL;
+	bool preserve = true;
+
+	if (dom_element_get_attribute(svg, state->interned_preserveAspectRatio,
+			&par) == DOM_NO_ERR && par != NULL) {
+		const char *d = dom_string_data(par);
+		size_t len = dom_string_byte_length(par);
+
+		while (len > 0 && (*d == ' ' || *d == '\t' ||
+				*d == '\n' || *d == '\r')) {
+			d++;
+			len--;
+		}
+		if (len >= 4 && strncmp(d, "none", 4) == 0) {
+			preserve = false;
+		}
+		dom_string_unref(par);
+	}
+
+	return preserve;
+}
+
+
 static svgtiny_code
 svgtiny_parse_svg(dom_element *svg, struct svgtiny_parse_state state)
 {
@@ -987,10 +1020,13 @@ svgtiny_parse_svg(dom_element *svg, struct svgtiny_parse_state state)
 	}
 
 	if (view_box) {
+		bool preserve = svgtiny_wants_aspect(svg, &state);
+
 		svgtiny_parse_viewbox(dom_string_data(view_box),
 				      dom_string_byte_length(view_box),
 				      state.viewport_width,
 				      state.viewport_height,
+				      preserve,
 				      &state.ctm);
 		dom_string_unref(view_box);
 	}
@@ -1108,6 +1144,7 @@ initialise_parse_state(struct svgtiny_parse_state *state,
 	svgtiny_parse_position_attributes(svg, *state, &x, &y, &width, &height);
 	diagram->width = width;
 	diagram->height = height;
+	diagram->preserve_aspect = svgtiny_wants_aspect(svg, state);
 
 	/* set up parsing state */
 	state->viewport_width = width;
