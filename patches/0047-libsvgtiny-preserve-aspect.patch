diff --git a/src/svgtiny_parse.c b/src/svgtiny_parse.c
index af7b228..f984b25 100644
--- a/src/svgtiny_parse.c
+++ b/src/svgtiny_parse.c
@@ -1444,6 +1444,7 @@ svgtiny_parse_viewbox(const char *text,
 		      size_t textlen,
 		      float viewport_width,
 		      float viewport_height,
+		      bool preserve_aspect,
 		      struct svgtiny_transformation_matrix *tm)
 {
 	const char *cursor = text; /* text cursor */
@@ -1480,8 +1481,31 @@ svgtiny_parse_viewbox(const char *text,
 		return svgtiny_SVG_ERROR;
 	}
 
+	if (paramv[2] <= 0 || paramv[3] <= 0) {
+		/* a zero or negative extent disables rendering */
+		return svgtiny_SVG_ERROR;
+	}
+
 	tm->a = (float)viewport_width / paramv[2];
 	tm->d = (float)viewport_height / paramv[3];
+
+	if (preserve_aspect) {
+		/*
+		 * The default is to scale both axes alike and centre
+		 * what is left over, which is what preserveAspectRatio
+		 * means when nobody writes it down. Scaling the axes
+		 * separately, as this did, squashes any graphic whose
+		 * box is not the shape of its viewBox: YouTube's
+		 * wordmark came out crushed into a third of its width.
+		 */
+		float scale = (tm->a < tm->d) ? tm->a : tm->d;
+
+		tm->e += ((float)viewport_width - paramv[2] * scale) / 2;
+		tm->f += ((float)viewport_height - paramv[3] * scale) / 2;
+		tm->a = scale;
+		tm->d = scale;
+	}
+
 	tm->e += -paramv[0] * tm->a;
 	tm->f += -paramv[1] * tm->d;
 
