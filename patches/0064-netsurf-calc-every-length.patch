+/* The px variants of the two above, for callers that can resolve a
+ * percentage or a calc() expression. */
+
+static inline uint8_t ns_computed_min_height_px(
+		const css_computed_style *style,
+		const css_unit_ctx *unit_ctx,
+		int available_px,
+		int *px_out)
+{
+	uint8_t value = css_computed_min_height_px(style, unit_ctx,
+			available_px, px_out);
+
+	if (value == CSS_MIN_HEIGHT_AUTO) {
+		value = CSS_MIN_HEIGHT_SET;
+		*px_out = 0;
+	}
+
+	return value;
+}
+
+static inline uint8_t ns_computed_min_width_px(
+		const css_computed_style *style,
+		const css_unit_ctx *unit_ctx,
+		int available_px,
+		int *px_out)
+{
+	uint8_t value = css_computed_min_width_px(style, unit_ctx,
+			available_px, px_out);
+
+	if (value == CSS_MIN_WIDTH_AUTO) {
+		value = CSS_MIN_WIDTH_SET;
+		*px_out = 0;
+	}
+
+	return value;
+}
+
 #endif
