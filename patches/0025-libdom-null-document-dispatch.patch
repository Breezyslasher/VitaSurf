@@ -31,6 +31,19 @@ dom_exception __dom_dispatch_node_change_event(dom_document *doc,
 	dom_string *type = NULL;
 	dom_exception err;
 
+	/*
+	 * VitaSurf: a node created outside any document -- a doctype is one
+	 * -- carries a NULL owner, and every caller here passes that owner
+	 * straight through. There is no document to take the memoised event
+	 * name from, and such a node is not in the page for a listener to
+	 * see the event on, so there is nothing to dispatch.
+	 */
+	if (doc == NULL) {
+		if (success != NULL)
+			*success = true;
+		return DOM_NO_ERR;
+	}
+
 	err = _dom_mutation_event_create(&evt);
 	if (err != DOM_NO_ERR)
 		return err;
