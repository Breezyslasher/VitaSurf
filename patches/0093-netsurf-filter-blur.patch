+/*
+ * blur() (VitaSurf). The plotters cannot blur what they have drawn, so
+ * a blur is approximated shape by shape: a filled rectangle is drawn
+ * with a soft edge, as rings of falling alpha across the radius each
+ * side of its edge; a bitmap is box-blurred in a copy with a
+ * transparent margin, which softens its edge too; a filled path takes
+ * the soft rectangle of its bounding box; and text, lines and strokes,
+ * which have no soft form, are faded towards the colour under the box
+ * by an amount that grows with the radius, so heavily blurred text is
+ * the smudge it would be. Shapes reach beyond the box by the radius,
+ * which is why the clip is widened by it.
+ */
+
+/** How far, in 1/256ths, a shape with no soft form fades. */
+static int html_filter_fade(const struct html_filter_level *lv)
+{
+	if (lv->blur <= 0)
+		return 0;
+	return 256 * lv->blur / (lv->blur + 4);
+}
+
+/** A colour for a sink without alpha, faded towards the background. */
+static colour html_filter_faded(const struct html_filter_level *lv, colour c)
+{
+	colour t = html_filter_opaque(lv, c);
+	int f = html_filter_fade(lv);
+	int r, g, b;
+
+	if (f == 0)
+		return t;
+	r = ((t & 0xff) * (256 - f) + (lv->bg & 0xff) * f) / 256;
+	g = (((t >> 8) & 0xff) * (256 - f) + ((lv->bg >> 8) & 0xff) * f) /
+			256;
+	b = (((t >> 16) & 0xff) * (256 - f) + ((lv->bg >> 16) & 0xff) * f) /
+			256;
+	return (b << 16) | (g << 8) | r;
+}
