+/** The box around a path, after its transform. */
+static bool html_filter_path_bbox(const float *p, unsigned int n,
+		const float transform[6], struct rect *out)
+{
+	float minx = 1e9f, miny = 1e9f, maxx = -1e9f, maxy = -1e9f;
+	unsigned int i = 0;
+
+	while (i < n) {
+		unsigned int k, coords;
+
+		if (p[i] == PLOTTER_PATH_MOVE || p[i] == PLOTTER_PATH_LINE)
+			coords = 1;
+		else if (p[i] == PLOTTER_PATH_BEZIER)
+			coords = 3;
+		else {
+			i++;
+			continue;
+		}
+		i++;
+		for (k = 0; k < coords && i + 1 < n; k++, i += 2) {
+			float x = p[i], y = p[i + 1];
+			float tx = transform[0] * x + transform[2] * y +
+					transform[4];
+			float ty = transform[1] * x + transform[3] * y +
+					transform[5];
+
+			if (tx < minx) minx = tx;
+			if (tx > maxx) maxx = tx;
+			if (ty < miny) miny = ty;
+			if (ty > maxy) maxy = ty;
+		}
+	}
+
+	if (maxx < minx || maxy < miny)
+		return false;
+	out->x0 = (int) floorf(minx);
+	out->y0 = (int) floorf(miny);
+	out->x1 = (int) ceilf(maxx);
+	out->y1 = (int) ceilf(maxy);
+	return true;
+}
