+/**
+ * One box blur pass along the rows and one down the columns of a
+ * premultiplied RGBA buffer, in place, with a row or column of scratch.
+ * Outside the buffer counts as transparent, so an edge softens.
+ */
+static void html_filter_blur_pass(uint8_t *buf, int w, int h, size_t stride,
+		int r, uint8_t *tmp)
+{
+	int x, y, c;
+	int div = 2 * r + 1;
+
+	for (y = 0; y < h; y++) {
+		uint8_t *row = buf + y * stride;
+		int sum[4] = { 0, 0, 0, 0 };
+
+		for (x = 0; x <= r && x < w; x++)
+			for (c = 0; c < 4; c++)
+				sum[c] += row[x * 4 + c];
+		for (x = 0; x < w; x++) {
+			for (c = 0; c < 4; c++)
+				tmp[x * 4 + c] = (uint8_t) (sum[c] / div);
+			if (x + r + 1 < w)
+				for (c = 0; c < 4; c++)
+					sum[c] += row[(x + r + 1) * 4 + c];
+			if (x - r >= 0)
+				for (c = 0; c < 4; c++)
+					sum[c] -= row[(x - r) * 4 + c];
+		}
+		memcpy(row, tmp, (size_t) w * 4);
+	}
+
+	for (x = 0; x < w; x++) {
+		uint8_t *col = buf + x * 4;
+		int sum[4] = { 0, 0, 0, 0 };
+
+		for (y = 0; y <= r && y < h; y++)
+			for (c = 0; c < 4; c++)
+				sum[c] += col[y * stride + c];
+		for (y = 0; y < h; y++) {
+			for (c = 0; c < 4; c++)
+				tmp[y * 4 + c] = (uint8_t) (sum[c] / div);
+			if (y + r + 1 < h)
+				for (c = 0; c < 4; c++)
+					sum[c] += col[(y + r + 1) * stride + c];
+			if (y - r >= 0)
+				for (c = 0; c < 4; c++)
+					sum[c] -= col[(y - r) * stride + c];
+		}
+		for (y = 0; y < h; y++)
+			memcpy(col + y * stride, tmp + y * 4, 4);
+	}
+}
