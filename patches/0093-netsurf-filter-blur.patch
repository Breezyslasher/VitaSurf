+/**
+ * Draw a filled rectangle with a soft edge: solid inside the radius,
+ * rings of falling alpha across it, through the plotters below.
+ */
+static nserror html_filter_soft_rect(const struct html_filter_level *lv,
+		const struct redraw_context *ctx, colour fill,
+		const struct rect *r)
+{
+	struct redraw_context rctx = *ctx;
+	plot_style_t st = { .fill_type = PLOT_OP_TYPE_SOLID,
+			.stroke_type = PLOT_OP_TYPE_NONE };
+	struct rect in;
+	int a = 0xff - (fill >> 24);
+	css_color css;
+	nserror res = NSERROR_OK;
+	int blur = lv->blur;
+
+	if (a <= 0)
+		return NSERROR_OK;
+
+	/* a shape thinner than the radius cannot be solid anywhere; its
+	 * colour is spread over the band instead */
+	if (r->x1 - r->x0 < 2 * blur || r->y1 - r->y0 < 2 * blur) {
+		int w = r->x1 - r->x0, h = r->y1 - r->y0;
+		int span = w < h ? w : h;
+
+		if (span <= 0)
+			return NSERROR_OK;
+		a = a * span / (2 * blur);
+		if (a <= 0)
+			return NSERROR_OK;
+	}
+
+	rctx.plot = lv->real;
+	html_filter_depth--;
+
+	in.x0 = r->x0 + blur;
+	in.y0 = r->y0 + blur;
+	in.x1 = r->x1 - blur;
+	in.y1 = r->y1 - blur;
+	if (in.x1 > in.x0 && in.y1 > in.y0) {
+		st.fill_colour = (fill & 0x00ffffff) | ((0xff - a) << 24);
+		res = rctx.plot->rectangle(&rctx, &st, &in);
+	}
+
+	if (res == NSERROR_OK) {
+		css = ((css_color) a << 24) | ((fill & 0xff) << 16) |
+				(fill & 0xff00) | ((fill >> 16) & 0xff);
+		/* the rings run from blur inside the edge to blur outside:
+		 * the painter's band is half its blur argument each side */
+		if (!html_redraw_shadow_rings(r->x0, r->y0, r->x1, r->y1,
+				0, 0, 2 * blur, 0, css, &rctx))
+			res = NSERROR_UNKNOWN;
+	}
+
+	html_filter_depth++;
+	return res;
+}
