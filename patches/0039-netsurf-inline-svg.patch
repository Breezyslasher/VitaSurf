+	exc = dom_node_get_namespace(node, &namespace);
+	if (exc == DOM_NO_ERR && namespace != NULL) {
+		bool is_svg = dom_string_isequal(namespace,
+				corestring_dom_svg_namespace);
+		dom_string_unref(namespace);
+
+		if (is_svg) {
+			dom_string *name = NULL;
+
+			exc = dom_node_get_node_name(node, &name);
+			if (exc == DOM_NO_ERR && name != NULL) {
+				bool root = dom_string_caseless_lwc_isequal(
+						name, corestring_lwc_svg);
+				dom_string_unref(name);
+				if (root) {
+					return box_svg(node, content, box,
+						       convert_children);
+				}
+			}
+			/* a descendant of an <svg> that was not converted */
+			return true;
+		}
+	}
+
 	exc = dom_html_element_get_tag_type(node, &tag_type);
