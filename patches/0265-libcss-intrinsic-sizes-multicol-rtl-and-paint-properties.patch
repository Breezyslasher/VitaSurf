+css_error css__parse_mix_blend_mode(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	static const char *const modes[] = {
+		"normal",
+		"multiply",
+		"screen",
+		"overlay",
+		"darken",
+		"lighten",
+		"color-dodge",
+		"color-burn",
+		"hard-light",
+		"soft-light",
+		"difference",
+		"exclusion",
+		"hue",
+		"saturation",
+		"color",
+		"luminosity",
+		"plus-lighter",
+	};
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	unsigned int i;
+
+	token = parserutils_vector_iterate(vector, ctx);
+	if (token == NULL) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE)
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_MIX_BLEND_MODE);
+	if (token->type == CSS_TOKEN_IDENT) {
+		for (i = 0; i < sizeof(modes) / sizeof(modes[0]); i++) {
+			if (fn_is_ident(token, modes[i]))
+				return css__stylesheet_style_appendOPV(result,
+						CSS_PROP_MIX_BLEND_MODE, 0,
+						(uint16_t) i);
+		}
+	}
+	*ctx = orig_ctx;
+	return CSS_INVALID;
+}
