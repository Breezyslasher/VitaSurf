+
+/* exported interface documented in properties.h */
+css_error css__parse_border_image(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	lwc_string *src = NULL;
+	bool has_src = false, src_none = false, has_slice = false,
+			has_repeat = false;
+	char slice[64] = "100,100,100,100,15,0";
+	uint16_t repeat = 0;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		error = css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_BORDER_IMAGE_SOURCE);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result,
+					flag_value, CSS_PROP_BORDER_IMAGE_SLICE);
+		if (error == CSS_OK)
+			error = css_stylesheet_style_flag_value(result,
+					flag_value,
+					CSS_PROP_BORDER_IMAGE_REPEAT);
+		return error;
+	}
+
+	for (;;) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (token == NULL || tokenIsChar(token, '!'))
