+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* border-image-repeat (VitaSurf): the opcode is the computed value less one */
+
+css_error css__cascade_border_image_repeat(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_BORDER_IMAGE_REPEAT_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		value = getValue(opv) + 1;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_border_image_repeat(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_border_image_repeat_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_border_image_repeat(style, hint->status);
+}
+
+css_error css__initial_border_image_repeat(css_select_state *state)
+{
+	return set_border_image_repeat(state->computed, CSS_BORDER_IMAGE_REPEAT_STRETCH);
+}
+
+css_error css__copy_border_image_repeat(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_border_image_repeat(to, get_border_image_repeat(from));
+}
+
+css_error css__compose_border_image_repeat(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_border_image_repeat(child);
+
+	return css__copy_border_image_repeat(
+			type == CSS_BORDER_IMAGE_REPEAT_INHERIT ? parent : child,
+			result);
+}
