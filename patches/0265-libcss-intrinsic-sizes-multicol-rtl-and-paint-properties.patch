diff --git a/src/select/properties/backdrop_filter.c b/src/select/properties/backdrop_filter.c
new file mode 100644
index 0000000..21ad4fb
--- /dev/null
+++ b/src/select/properties/backdrop_filter.c
@@ -0,0 +1,89 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_backdrop_filter(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_BACKDROP_FILTER_INHERIT;
+	lwc_string *name = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case BACKDROP_FILTER_NONE:
+			value = CSS_BACKDROP_FILTER_NONE;
+			break;
+		case BACKDROP_FILTER_SET:
+			value = CSS_BACKDROP_FILTER_SET;
+			css__stylesheet_string_get(style->sheet,
+					*((css_code_t *) style->bytecode),
+					&name);
+			advance_bytecode(style, sizeof(css_code_t));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_backdrop_filter(state->computed, value, name);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_backdrop_filter_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error;
+
+	error = set_backdrop_filter(style, hint->status, hint->data.string);
+
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+
+	return error;
+}
+
+css_error css__initial_backdrop_filter(css_select_state *state)
+{
+	return set_backdrop_filter(state->computed, CSS_BACKDROP_FILTER_NONE,
+			NULL);
+}
+
+css_error css__copy_backdrop_filter(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *name;
+	uint8_t type = get_backdrop_filter(from, &name);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_backdrop_filter(to, type, name);
+}
+
+css_error css__compose_backdrop_filter(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *name;
+	uint8_t type = get_backdrop_filter(child, &name);
+
+	return css__copy_backdrop_filter(
+			type == CSS_BACKDROP_FILTER_INHERIT ? parent : child,
+			result);
+}
diff --git a/src/select/properties/border_image_repeat.c b/src/select/properties/border_image_repeat.c
