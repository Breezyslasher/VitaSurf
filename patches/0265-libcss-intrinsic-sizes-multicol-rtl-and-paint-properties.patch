+
+static css_error bi_emit_string(css_language *c, css_style *result,
+		opcode_t prop, uint16_t value, lwc_string *s)
+{
+	uint32_t snumber;
+	css_error error = css__stylesheet_string_add(c->sheet, s, &snumber);
+
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_appendOPV(result, prop, 0, value);
+	if (error != CSS_OK)
+		return error;
+	return css__stylesheet_style_append(result, snumber);
+}
+
+static css_error bi_emit_slice(css_language *c, css_style *result,
+		const char *buf)
+{
+	lwc_string *s;
+
+	if (lwc_intern_string(buf, strlen(buf), &s) != lwc_error_ok)
+		return CSS_NOMEM;
+	return bi_emit_string(c, result, CSS_PROP_BORDER_IMAGE_SLICE,
+			BORDER_IMAGE_SLICE_SET, s);
