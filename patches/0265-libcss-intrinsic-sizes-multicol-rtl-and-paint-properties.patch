diff --git a/src/parse/properties/border_image.c b/src/parse/properties/border_image.c
new file mode 100644
index 0000000..6ad1505
--- /dev/null
+++ b/src/parse/properties/border_image.c
@@ -0,0 +1,376 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ */
+
+/*
+ * border-image (VitaSurf).
+ *
+ * The source is kept as a string, a resolved URL or the "gradient:" form
+ * background-image uses; the slice as a string of its own,
+ * "t,r,b,l,m,f": four numbers, in pixels of the source or percentages of
+ * it where bit n of m says so, and f 1 for fill; the repeat as one value
+ * holding both axes. The shorthand sets all three. border-image-width
+ * and border-image-outset are accepted and ignored: the border's own
+ * widths are used.
+ */
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+static bool bi_ident_is(const css_token *t, const char *name)
+{
+	size_t n = strlen(name);
+
+	return t != NULL && t->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(t->idata) == n &&
+			strncasecmp(lwc_string_data(t->idata), name, n) == 0;
+}
+
+/** A source: none, url() or a gradient. \a *none is set for none. */
+static css_error bi_source(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, lwc_string **out, bool *none)
+{
+	int32_t orig = *ctx;
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	css_error error;
+
+	*out = NULL;
+	*none = false;
+	if (token == NULL)
+		return CSS_INVALID;
+	if (bi_ident_is(token, "none")) {
+		parserutils_vector_iterate(vector, ctx);
+		*none = true;
+		return CSS_OK;
+	}
+	if (token->type == CSS_TOKEN_URI) {
+		parserutils_vector_iterate(vector, ctx);
+		return c->sheet->resolve(c->sheet->resolve_pw, c->sheet->url,
+				token->idata, out);
+	}
+	if (token->type == CSS_TOKEN_FUNCTION) {
+		error = css__parse_gradient(c, vector, ctx, out);
+		if (error != CSS_OK)
+			*ctx = orig;
+		return error;
+	}
+	return CSS_INVALID;
+}
+
+/** A slice: one to four numbers or percentages, and fill, in either
+ * order. Written into \a buf as "t,r,b,l,m,f". */
+static css_error bi_slice(const parserutils_vector *vector,
+		int32_t *ctx, char *buf, size_t size)
+{
+	css_fixed v[4];
+	int pct[4], n = 0, fill = 0, i, mask = 0;
+
+	for (;;) {
+		const css_token *token;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (bi_ident_is(token, "fill") && fill == 0) {
+			parserutils_vector_iterate(vector, ctx);
+			fill = 1;
+			continue;
+		}
+		if (token == NULL || n == 4 ||
+				(token->type != CSS_TOKEN_NUMBER &&
+				 token->type != CSS_TOKEN_PERCENTAGE))
+			break;
+		parserutils_vector_iterate(vector, ctx);
+		{
+			size_t consumed = 0;
+
+			v[n] = css__number_from_lwc_string(token->idata,
+					false, &consumed);
+			if (consumed != lwc_string_length(token->idata) ||
+					v[n] < 0)
+				return CSS_INVALID;
+		}
+		pct[n] = token->type == CSS_TOKEN_PERCENTAGE;
+		n++;
+	}
+	if (n == 0)
+		return CSS_INVALID;
+	if (n == 1) { v[1] = v[2] = v[3] = v[0]; pct[1] = pct[2] = pct[3] = pct[0]; }
+	else if (n == 2) { v[2] = v[0]; pct[2] = pct[0]; v[3] = v[1]; pct[3] = pct[1]; }
+	else if (n == 3) { v[3] = v[1]; pct[3] = pct[1]; }
+	for (i = 0; i < 4; i++)
+		if (pct[i])
+			mask |= 1 << i;
+	snprintf(buf, size, "%d,%d,%d,%d,%d,%d",
+			FIXTOINT(v[0]), FIXTOINT(v[1]), FIXTOINT(v[2]),
+			FIXTOINT(v[3]), mask, fill);
