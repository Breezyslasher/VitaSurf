+
+/** A repeat: one or two of stretch, repeat, round, space. */
+static css_error bi_repeat(const parserutils_vector *vector, int32_t *ctx,
+		uint16_t *out)
+{
+	static const char *const kinds[] = {
+		"stretch", "repeat", "round", "space"
+	};
+	int got[2], n = 0, k;
+
+	while (n < 2) {
+		const css_token *token;
+
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		for (k = 0; k < 4; k++)
+			if (bi_ident_is(token, kinds[k]))
+				break;
+		if (k == 4)
+			break;
+		parserutils_vector_iterate(vector, ctx);
+		got[n++] = k;
+	}
+	if (n == 0)
+		return CSS_INVALID;
+	if (n == 1)
+		got[1] = got[0];
+	*out = (uint16_t) (got[0] | (got[1] << 2));
+	return CSS_OK;
