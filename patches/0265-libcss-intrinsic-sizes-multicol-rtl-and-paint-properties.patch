+				token->type == CSS_TOKEN_FUNCTION ||
+				bi_ident_is(token, "none"))) {
+			error = bi_source(c, vector, ctx, &src, &src_none);
+			if (error != CSS_OK)
+				goto invalid;
+			has_src = true;
+			continue;
+		}
+		if (!has_slice && (token->type == CSS_TOKEN_NUMBER ||
+				token->type == CSS_TOKEN_PERCENTAGE ||
+				bi_ident_is(token, "fill"))) {
