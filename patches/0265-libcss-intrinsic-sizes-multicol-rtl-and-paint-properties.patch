diff --git a/src/select/properties/mix_blend_mode.c b/src/select/properties/mix_blend_mode.c
new file mode 100644
index 0000000..b5e9b4a
--- /dev/null
+++ b/src/select/properties/mix_blend_mode.c
@@ -0,0 +1,69 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2025 The NetSurf Project
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* mix-blend-mode (VitaSurf): the opcode is the computed value less one */
+
+css_error css__cascade_mix_blend_mode(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_MIX_BLEND_MODE_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		value = getValue(opv) + 1;
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_mix_blend_mode(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_mix_blend_mode_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_mix_blend_mode(style, hint->status);
+}
+
+css_error css__initial_mix_blend_mode(css_select_state *state)
+{
+	return set_mix_blend_mode(state->computed, CSS_MIX_BLEND_MODE_NORMAL);
+}
+
+css_error css__copy_mix_blend_mode(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_mix_blend_mode(to, get_mix_blend_mode(from));
+}
+
+css_error css__compose_mix_blend_mode(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_mix_blend_mode(child);
+
+	return css__copy_mix_blend_mode(
+			type == CSS_MIX_BLEND_MODE_INHERIT ? parent : child,
+			result);
+}
diff --git a/src/select/properties/outline_offset.c b/src/select/properties/outline_offset.c
new file mode 100644
index 0000000..93328c1
--- /dev/null
+++ b/src/select/properties/outline_offset.c
@@ -0,0 +1,88 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 The NetSurf Project
+ *
+ * outline-offset (VitaSurf)
+ */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_outline_offset(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_OUTLINE_OFFSET_INHERIT;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case OUTLINE_OFFSET_SET:
+			value = CSS_OUTLINE_OFFSET_SET;
+			length = *((css_fixed *) style->bytecode);
+			advance_bytecode(style, sizeof(length));
+			unit = *((uint32_t *) style->bytecode);
+			advance_bytecode(style, sizeof(unit));
+			break;
+		default:
+			break;
+		}
+	}
+
+	unit = css__to_css_unit(unit);
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_outline_offset(state->computed, value, length, unit);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_outline_offset_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_outline_offset(style, hint->status,
+			hint->data.length.value, hint->data.length.unit);
+}
+
+css_error css__initial_outline_offset(css_select_state *state)
+{
+	return set_outline_offset(state->computed, CSS_OUTLINE_OFFSET_SET, 0, CSS_UNIT_PX);
+}
+
+css_error css__copy_outline_offset(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t type = get_outline_offset(from, &length, &unit);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_outline_offset(to, type, length, unit);
+}
+
+css_error css__compose_outline_offset(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t type = get_outline_offset(child, &length, &unit);
+
+	return css__copy_outline_offset(
+			type == CSS_OUTLINE_OFFSET_INHERIT ? parent : child,
+			result);
+}
