+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_BORDER_IMAGE_SOURCE, 0,
+				BORDER_IMAGE_SOURCE_NONE);
+	if (error == CSS_OK)
+		error = bi_emit_slice(c, result, slice);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_BORDER_IMAGE_REPEAT, 0, repeat);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+
+invalid:
+	if (src != NULL)
+		lwc_string_unref(src);
+	*ctx = orig;
+	return CSS_INVALID;
+}
+
+/* exported interface documented in properties.h */
+css_error css__parse_border_image_source(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig = *ctx;
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+	lwc_string *src = NULL;
+	bool none = false;
+	css_error error;
+
+	if (token == NULL)
+		return CSS_INVALID;
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_BORDER_IMAGE_SOURCE);
+	}
+	error = bi_source(c, vector, ctx, &src, &none);
+	if (error != CSS_OK) {
+		*ctx = orig;
+		return error;
+	}
+	if (none)
+		return css__stylesheet_style_appendOPV(result,
+				CSS_PROP_BORDER_IMAGE_SOURCE, 0,
+				BORDER_IMAGE_SOURCE_NONE);
+	error = bi_emit_string(c, result, CSS_PROP_BORDER_IMAGE_SOURCE,
+			BORDER_IMAGE_SOURCE_SET, src);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+}
+
+/* exported interface documented in properties.h */
+css_error css__parse_border_image_slice(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig = *ctx;
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+	char slice[64];
+	css_error error;
+
+	if (token == NULL)
+		return CSS_INVALID;
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_BORDER_IMAGE_SLICE);
+	}
+	error = bi_slice(vector, ctx, slice, sizeof(slice));
+	if (error == CSS_OK)
+		error = bi_emit_slice(c, result, slice);
+	if (error != CSS_OK)
+		*ctx = orig;
+	return error;
+}
+
+/* exported interface documented in properties.h */
+css_error css__parse_border_image_repeat(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig = *ctx;
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	enum flag_value flag_value;
+	uint16_t repeat = 0;
+
+	if (token == NULL)
+		return CSS_INVALID;
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				CSS_PROP_BORDER_IMAGE_REPEAT);
+	}
+	if (bi_repeat(vector, ctx, &repeat) != CSS_OK) {
+		*ctx = orig;
+		return CSS_INVALID;
+	}
+	return css__stylesheet_style_appendOPV(result,
+			CSS_PROP_BORDER_IMAGE_REPEAT, 0, repeat);
+}
