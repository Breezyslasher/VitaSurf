+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_border_image_source(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_BORDER_IMAGE_SOURCE_INHERIT;
+	lwc_string *name = NULL;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case BORDER_IMAGE_SOURCE_NONE:
+			value = CSS_BORDER_IMAGE_SOURCE_NONE;
+			break;
+		case BORDER_IMAGE_SOURCE_SET:
+			value = CSS_BORDER_IMAGE_SOURCE_SET;
+			css__stylesheet_string_get(style->sheet,
+					*((css_code_t *) style->bytecode),
+					&name);
+			advance_bytecode(style, sizeof(css_code_t));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_border_image_source(state->computed, value, name);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_border_image_source_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	css_error error;
+
+	error = set_border_image_source(style, hint->status, hint->data.string);
+
+	if (hint->data.string != NULL)
+		lwc_string_unref(hint->data.string);
+
+	return error;
+}
+
+css_error css__initial_border_image_source(css_select_state *state)
+{
+	return set_border_image_source(state->computed, CSS_BORDER_IMAGE_SOURCE_NONE,
+			NULL);
+}
+
+css_error css__copy_border_image_source(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	lwc_string *name;
+	uint8_t type = get_border_image_source(from, &name);
+
+	if (from == to) {
+		return CSS_OK;
+	}
+
+	return set_border_image_source(to, type, name);
+}
+
+css_error css__compose_border_image_source(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	lwc_string *name;
+	uint8_t type = get_border_image_source(child, &name);
+
+	return css__copy_border_image_source(
+			type == CSS_BORDER_IMAGE_SOURCE_INHERIT ? parent : child,
+			result);
+}
