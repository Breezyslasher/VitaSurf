diff --git a/content/handlers/html/scroll_anchor.c b/content/handlers/html/scroll_anchor.c
new file mode 100644
index 000000000..7b0747d15
--- /dev/null
+++ b/content/handlers/html/scroll_anchor.c
@@ -0,0 +1,236 @@
+/*
