+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Scroll anchoring (VitaSurf).
+ *
+ * An image arriving, a web font loading or a script adding to the page
+ * lays the page out again, and whatever sits above the view grows or
+ * shrinks, so what the user was reading moves under them. Before each
+ * layout an element in view is chosen as the anchor and where it was is
+ * noted; after it, the browser window scrolls by as much as the anchor
+ * moved. The anchor is the first element, in document order, wholly in
+ * view, or failing that the deepest one the top of the view cuts
+ * through. Fixed, absolute and sticky boxes, boxes placed against an
+ * anchor() and anything inside a scroll container are passed over, as
+ * CSS Scroll Anchoring says. With the view at the top of the page
+ * nothing is anchored, so content added above it is seen.
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include <dom/dom.h>
+#include <libcss/libcss.h>
+
+#include "utils/log.h"
+#include "netsurf/types.h"
+#include "netsurf/content.h"
+#include "content/content_protected.h"
+#include "content/hlcache.h"
+#include "desktop/frames.h"
+
+#include "html/box.h"
+#include "html/box_construct.h"
+#include "html/private.h"
+#include "html/html.h"
+
+struct sa_pick {
+	int vx0, vy0, vx1, vy1;
+	struct box *full;
+	int full_y;
+	struct box *part;
+	int part_y;
+};
+
+/** Whether a box stays where it is when what comes before it grows. */
+static bool sa_excluded(const struct box *b)
+{
+	if (b->flags & ANCHORED) {
+		return true;
+	}
+	if (b->style != NULL) {
+		switch (css_computed_position(b->style)) {
+		case CSS_POSITION_FIXED:
+		case CSS_POSITION_ABSOLUTE:
+		case CSS_POSITION_STICKY:
+			return true;
+		default:
+			break;
+		}
+	}
+	return false;
+}
+
+static bool sa_inside(const struct box *b, const struct box *outer)
+{
+	for (; b != NULL; b = b->parent) {
+		if (b == outer) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/**
+ * Look through a box's children for the anchor, x and y being where the
+ * box itself is. Returns true once an element wholly in view is found.
+ */
+static bool sa_walk(struct box *parent, int px, int py, struct sa_pick *p)
+{
+	struct box *c;
+
+	for (c = parent->children; c != NULL; c = c->next) {
+		int x = px + c->x;
+		int y = py + c->y;
+		int w = c->padding[LEFT] + c->width + c->padding[RIGHT];
+		int h = c->padding[TOP] + c->height + c->padding[BOTTOM];
+
+		if (sa_excluded(c)) {
+			continue;
+		}
+		/* nothing of it or in it reaches the view */
+		if (y + c->descendant_y1 <= p->vy0 ||
+		    y + c->descendant_y0 >= p->vy1) {
+			continue;
+		}
+
+		/* only an element's principal box is found again after
+		 * the layout, so only that can be the anchor */
+		if (c->node != NULL && h > 0 &&
+		    x < p->vx1 && x + w > p->vx0 &&
+		    box_for_node(c->node) == c) {
+			if (y >= p->vy0 && y + h <= p->vy1) {
+				p->full = c;
+				p->full_y = y;
+				return true;
+			}
+			if (y < p->vy1 && y + h > p->vy0 &&
+			    (p->part == NULL || sa_inside(c, p->part))) {
+				p->part = c;
+				p->part_y = y;
+			}
+		}
+
+		/* a scroll container's content moves with its own
+		 * scrolling, not the page's */
+		if (c->scroll_x != NULL || c->scroll_y != NULL ||
+		    c->object != NULL) {
+			continue;
+		}
+		if (sa_walk(c, x, y, p)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* exported interface documented in html/private.h */
+void html_scroll_anchor_pick(html_content *htmlc)
+{
+	struct sa_pick p;
+	struct box *root = htmlc->layout;
+	int vx, vy, vw, vh;
+
+	if (htmlc->sa_node != NULL) {
+		/* a rebuild already chose one from the old tree */
+		return;
+	}
+	htmlc->sa_moved = false;
+	if (root == NULL || htmlc->had_initial_layout == false ||
+	    htmlc->bw == NULL ||
+	    !browser_window_view_rect(htmlc->bw, &htmlc->base,
+				      &vx, &vy, &vw, &vh) ||
+	    vy <= 0) {
+		return;
+	}
+
+	p.vx0 = vx;
+	p.vy0 = vy;
+	p.vx1 = vx + vw;
+	p.vy1 = vy + vh;
+	p.full = p.part = NULL;
+	p.full_y = p.part_y = 0;
+	sa_walk(root, root->x, root->y, &p);
+
+	if (p.full != NULL) {
+		htmlc->sa_node = dom_node_ref(p.full->node);
+		htmlc->sa_y = p.full_y;
+	} else if (p.part != NULL) {
+		htmlc->sa_node = dom_node_ref(p.part->node);
+		htmlc->sa_y = p.part_y;
+	}
+}
+
+/* exported interface documented in html/private.h */
+void html_scroll_anchor_settle(html_content *htmlc)
+{
+	struct box *b, *a;
+	int y = 0;
+
+	if (htmlc->sa_node == NULL) {
+		return;
+	}
+	b = box_for_node(htmlc->sa_node);
+	dom_node_unref(htmlc->sa_node);
+	htmlc->sa_node = NULL;
+	if (b == NULL) {
+		/* it went, or is display: none now */
+		return;
+	}
+	for (a = b; a != NULL; a = a->parent) {
+		if (sa_excluded(a) ||
+		    (a != b && (a->scroll_x != NULL || a->scroll_y != NULL))) {
+			/* it no longer moves with the page */
+			return;
+		}
+		y += a->y;
+	}
+	if (y != htmlc->sa_y) {
+		htmlc->sa_dy = y - htmlc->sa_y;
+		htmlc->sa_moved = true;
+	}
+}
+
+/* exported interface documented in html/private.h */
+void html_scroll_anchor_free(html_content *htmlc)
+{
+	if (htmlc->sa_node != NULL) {
+		dom_node_unref(htmlc->sa_node);
+		htmlc->sa_node = NULL;
+	}
+	htmlc->sa_moved = false;
+}
+
+/* exported interface documented in html/html.h */
+bool html_scroll_anchor_take(struct hlcache_handle *h, int *dy)
+{
+	html_content *htmlc;
+
+	if (content_get_type(h) != CONTENT_HTML) {
+		return false;
+	}
+	htmlc = (html_content *) hlcache_handle_get_content(h);
+	if (htmlc == NULL || htmlc->sa_moved == false) {
+		return false;
+	}
+	htmlc->sa_moved = false;
+	*dy = htmlc->sa_dy;
+	return true;
+}
