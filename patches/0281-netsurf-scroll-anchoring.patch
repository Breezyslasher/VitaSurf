diff --git a/desktop/browser_window.c b/desktop/browser_window.c
index 70cf8b0d2..c25455a1a 100644
--- a/desktop/browser_window.c
+++ b/desktop/browser_window.c
@@ -257,6 +257,79 @@ browser_window_set_scroll(struct browser_window *bw, const struct rect *rect)
 }
 
 
+/**
+ * Where a browser window is scrolled to, in window px (VitaSurf).
+ */
+static bool
+browser_window_scroll_offsets(struct browser_window *bw, int *sx, int *sy)
+{
+	if (bw->window != NULL) {
+		return guit->window->get_scroll(bw->window, sx, sy);
+	}
+	*sx = (bw->scroll_x != NULL) ? scrollbar_get_offset(bw->scroll_x) : 0;
+	*sy = (bw->scroll_y != NULL) ? scrollbar_get_offset(bw->scroll_y) : 0;
+	return true;
+}
+
+
+/* exported interface documented in desktop/frames.h */
+bool browser_window_view_rect(struct browser_window *bw,
+		struct content *c, int *x, int *y, int *w, int *h)
+{
+	int sx, sy, vw, vh;
+	float scale;
+
+	if (bw == NULL || bw->current_content == NULL ||
+	    hlcache_handle_get_content(bw->current_content) != c) {
+		return false;
+	}
+	if (!browser_window_scroll_offsets(bw, &sx, &sy) ||
+	    browser_window_get_dimensions(bw, &vw, &vh) != NSERROR_OK ||
+	    vw <= 0 || vh <= 0) {
+		return false;
+	}
+	scale = bw->scale > 0.0f ? bw->scale : 1.0f;
+	*x = (int)(sx / scale);
+	*y = (int)(sy / scale);
+	*w = (int)(vw / scale);
+	*h = (int)(vh / scale);
+	return true;
+}
+
+
+/**
+ * Keep what the view showed in place after a relayout moved it: scroll
+ * by as much as the content's anchor element moved (VitaSurf). Until the
+ * user leaves a fragment it was scrolled to, the fragment is the anchor
+ * instead and frag_scroll() has already put the view there.
+ */
+static void browser_window_scroll_anchor(struct browser_window *bw)
+{
+	struct rect rect;
+	int dy, sx, sy;
+	float scale;
+
+	if (bw->current_content == NULL ||
+	    !html_scroll_anchor_take(bw->current_content, &dy)) {
+		return;
+	}
+	if (bw->frag_id != NULL && !bw->frag_left) {
+		return;
+	}
+	if (!browser_window_scroll_offsets(bw, &sx, &sy)) {
+		return;
+	}
+	scale = bw->scale > 0.0f ? bw->scale : 1.0f;
+	rect.x0 = rect.x1 = sx;
+	rect.y0 = rect.y1 = sy + (int)(dy * scale);
+	if (rect.y0 < 0) {
+		rect.y0 = rect.y1 = 0;
+	}
+	NSLOG(netsurf, INFO, "scroll anchor: view follows %d px", dy);
+	browser_window_set_scroll(bw, &rect);
+}
+
+
