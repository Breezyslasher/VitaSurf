+/**
+ * Gather the rules of the document's <style> elements (VitaSurf).
+ */
+static void
+collect_stylesheets(dom_document *document, struct svgtiny_parse_state *state)
+{
+	dom_nodelist *styles;
+	dom_exception exc;
+	uint32_t count, i;
+
+	exc = dom_document_get_elements_by_tag_name(document,
+						    state->interned_style,
+						    &styles);
+	if (exc != DOM_NO_ERR || styles == NULL) {
+		return;
+	}
+	exc = dom_nodelist_get_length(styles, &count);
+	if (exc != DOM_NO_ERR) {
+		count = 0;
+	}
+	for (i = 0; i < count; i++) {
+		dom_node *node;
+		dom_string *text;
+
+		exc = dom_nodelist_item(styles, i, &node);
+		if (exc != DOM_NO_ERR || node == NULL) {
+			continue;
+		}
+		exc = dom_node_get_text_content(node, &text);
+		if (exc == DOM_NO_ERR && text != NULL) {
+			svgtiny_stylesheet_add(state->sheet,
+					       dom_string_data(text),
+					       dom_string_byte_length(text));
+			dom_string_unref(text);
+		}
+		dom_node_unref(node);
+	}
+	dom_nodelist_unref(styles);
