+/**
+ * whether a whitespace separated list holds a word
+ */
+static bool list_has_word(const char *list, size_t listlen,
+			  const char *word, size_t wordlen)
+{
+	const char *c = list;
+	const char *end = list + listlen;
+
+	while (c < end) {
+		const char *w;
+
+		while (c < end && isspace((unsigned char) *c)) {
+			c++;
+		}
+		w = c;
+		while (c < end && !isspace((unsigned char) *c)) {
+			c++;
+		}
+		if ((size_t) (c - w) == wordlen &&
+		    memcmp(w, word, wordlen) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
