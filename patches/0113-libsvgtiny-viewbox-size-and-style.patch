+		 dom_string *nodename,
+		 dom_string *classes,
+		 dom_string *id)
+{
+	const char *c = sel;
+
+	(void) node;
+
+	/* the type selector, if any */
+	if (*c != '.' && *c != '#') {
+		const char *tag = c;
+
+		while (*c != '\0' && *c != '.' && *c != '#') {
+			c++;
+		}
+		if (!(c - tag == 1 && *tag == '*')) {
+			if (dom_string_byte_length(nodename) !=
+			    (size_t) (c - tag) ||
+			    strncasecmp(dom_string_data(nodename), tag,
+					c - tag) != 0) {
+				return false;
+			}
+		}
+	}
+
+	while (*c != '\0') {
+		char kind = *c++;
+		const char *name = c;
+
+		while (*c != '\0' && *c != '.' && *c != '#') {
+			c++;
+		}
+		if (c == name) {
+			return false;
+		}
+		if (kind == '.') {
+			if (classes == NULL ||
+			    !list_has_word(dom_string_data(classes),
+					   dom_string_byte_length(classes),
+					   name, c - name)) {
+				return false;
+			}
+		} else {
+			if (id == NULL ||
+			    dom_string_byte_length(id) != (size_t) (c - name) ||
+			    memcmp(dom_string_data(id), name, c - name) != 0) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+
+/**
+ * apply the sheet's rules that match a node
+ */
+svgtiny_code
+svgtiny_parse_stylesheet_rules(dom_element *node,
+			       struct svgtiny_parse_state *state,
+			       struct svgtiny_parse_internal_operation *ops)
+{
+	struct svgtiny_stylesheet *sheet = state->sheet;
+	dom_string *nodename = NULL;
+	dom_string *classes = NULL;
+	dom_string *id = NULL;
+	dom_exception exc;
+	unsigned int i;
+
+	if (sheet == NULL || sheet->count == 0) {
+		return svgtiny_OK;
+	}
+
+	exc = dom_node_get_node_name(node, &nodename);
+	if (exc != DOM_NO_ERR || nodename == NULL) {
+		return svgtiny_LIBDOM_ERROR;
+	}
+	exc = dom_element_get_attribute(node, state->interned_class, &classes);
+	if (exc != DOM_NO_ERR) {
+		dom_string_unref(nodename);
+		return svgtiny_LIBDOM_ERROR;
+	}
+	exc = dom_element_get_attribute(node, state->interned_id, &id);
+	if (exc != DOM_NO_ERR) {
+		if (classes != NULL) {
+			dom_string_unref(classes);
+		}
+		dom_string_unref(nodename);
+		return svgtiny_LIBDOM_ERROR;
+	}
+
+	for (i = 0; i < sheet->count; i++) {
+		const struct svgtiny_style_rule *rule = &sheet->rule[i];
+
+		if (selector_matches(rule->selector, node, nodename,
+				     classes, id)) {
+			svgtiny_parse_declarations(rule->declarations,
+						   rule->declarations +
+						   strlen(rule->declarations),
+						   state, ops);
+		}
+	}
+
+	if (id != NULL) {
+		dom_string_unref(id);
+	}
+	if (classes != NULL) {
+		dom_string_unref(classes);
+	}
+	dom_string_unref(nodename);
 	return svgtiny_OK;
 }
 
