+static svgtiny_code
+stylesheet_add_rule(struct svgtiny_stylesheet *sheet,
+		    const char *sel, const char *selend,
+		    const char *decl, const char *declend)
+{
+	struct svgtiny_style_rule *rule;
+
+	if (sheet->count == sheet->alloc) {
+		unsigned int alloc = sheet->alloc ? sheet->alloc * 2 : 8;
+		rule = realloc(sheet->rule, alloc * sizeof(*rule));
+		if (rule == NULL) {
+			return svgtiny_OUT_OF_MEMORY;
+		}
+		sheet->rule = rule;
+		sheet->alloc = alloc;
+	}
+	rule = &sheet->rule[sheet->count];
+	rule->selector = dup_range(sel, selend);
+	rule->declarations = dup_range(decl, declend);
+	if (rule->selector == NULL || rule->declarations == NULL) {
+		free(rule->selector);
+		free(rule->declarations);
+		return svgtiny_OUT_OF_MEMORY;
+	}
+	rule->specificity = selector_specificity(sel, selend);
+	sheet->count++;
+	return svgtiny_OK;
+}
