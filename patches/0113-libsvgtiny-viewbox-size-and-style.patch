+				       dom_string_byte_length(view_box),
+				       &vb_width, &vb_height) == svgtiny_OK) {
+		if (has_width) {
+			if (viewport_height <= 0) {
+				*height = *width * vb_height / vb_width;
+			}
+		} else if (has_height) {
+			if (viewport_width <= 0) {
+				*width = *height * vb_width / vb_height;
+			}
+		} else if (viewport_width <= 0 && viewport_height <= 0) {
+			*width = vb_width;
+			*height = vb_height;
