+/**
+ * order the rules so that a more specific selector applies last
+ *
+ * An insertion sort, since it keeps the order of rules that tie,
+ * which is their order in the sheet.
+ */
+static void stylesheet_sort(struct svgtiny_stylesheet *sheet)
+{
+	unsigned int i;
+
+	for (i = 1; i < sheet->count; i++) {
+		struct svgtiny_style_rule rule = sheet->rule[i];
+		unsigned int j = i;
+
+		while (j > 0 &&
+		       sheet->rule[j - 1].specificity > rule.specificity) {
+			sheet->rule[j] = sheet->rule[j - 1];
+			j--;
+		}
+		sheet->rule[j] = rule;
+	}
+}
