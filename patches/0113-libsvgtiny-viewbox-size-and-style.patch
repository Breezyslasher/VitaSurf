+/**
+ * whether a selector is a compound of tag, class and id this can match
+ */
+static bool selector_supported(const char *sel, const char *end)
+{
+	const char *c;
+
+	if (sel == end) {
+		return false;
+	}
+	for (c = sel; c < end; c++) {
+		switch (*c) {
+		case ' ': case '\t': case '\n': case '\r':
+		case '>': case '+': case '~': case ':': case '[':
+		case '(': case ')': case ',':
+			return false;
+		default:
+			break;
+		}
+	}
+	return true;
+}
+
+
+static char *dup_range(const char *start, const char *end)
+{
+	size_t len = end - start;
+	char *copy = malloc(len + 1);
+
+	if (copy != NULL) {
+		memcpy(copy, start, len);
+		copy[len] = '\0';
+	}
+	return copy;
+}
+
+
+/**
+ * a selector's specificity: ids, then classes, then the type
+ */
+static unsigned int selector_specificity(const char *sel, const char *end)
+{
+	unsigned int ids = 0, classes = 0, types = 0;
+	const char *c = sel;
+
+	if (c < end && *c != '.' && *c != '#' && *c != '*') {
+		types = 1;
+	}
+	for (; c < end; c++) {
+		if (*c == '#') {
+			ids++;
+		} else if (*c == '.') {
+			classes++;
+		}
+	}
+	return (ids << 16) | (classes << 8) | types;
+}
