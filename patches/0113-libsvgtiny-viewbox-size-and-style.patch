+/**
+ * Size a root element that has a viewBox but no width or height
+ * (VitaSurf).
+ *
+ * Such a graphic fills whatever it is drawn into, so when the caller
+ * has no size to offer, as NetSurf does not until layout has one, its
+ * size is that of the viewBox, which is what browsers use as its
+ * intrinsic size. With one side given, the other follows the viewBox
+ * aspect.
+ */
+static void
+size_from_viewbox(dom_element *svg,
+		  struct svgtiny_parse_state *state,
+		  int viewport_width,
+		  int viewport_height,
+		  float *width,
+		  float *height)
+{
+	bool has_width, has_height;
+	dom_string *view_box;
+	float vb_width, vb_height;
+
+	if (viewport_width > 0 && viewport_height > 0) {
+		return;
+	}
+	has_width = has_absolute_length(svg, state->interned_width);
+	has_height = has_absolute_length(svg, state->interned_height);
+	if (has_width && has_height) {
+		return;
+	}
+	if (dom_element_get_attribute(svg, state->interned_viewBox,
+				      &view_box) != DOM_NO_ERR ||
+	    view_box == NULL) {
+		return;
+	}
