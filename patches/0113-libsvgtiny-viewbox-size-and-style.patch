+static bool has_absolute_length(dom_element *svg, dom_string *name)
+{
+	dom_string *attr;
+	bool absolute;
+
+	if (dom_element_get_attribute(svg, name, &attr) != DOM_NO_ERR ||
+	    attr == NULL) {
+		return false;
+	}
+	absolute = memchr(dom_string_data(attr), '%',
+			  dom_string_byte_length(attr)) == NULL;
+	dom_string_unref(attr);
+	return absolute;
