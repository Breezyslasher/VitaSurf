+/*
+ * Stylesheets (VitaSurf)
+ *
+ * Illustrator and Inkscape write the fills of an exported graphic as
+ * classes in a <style> element, so every such graphic came out black.
+ * This keeps the rules whose selector is a plain compound of tag, class
+ * and id and applies them between the presentation attributes and the
+ * style attribute, which is their cascade order. Combinators, pseudo
+ * classes, attribute selectors and at-rules are skipped.
+ */
+
+struct svgtiny_stylesheet *svgtiny_stylesheet_create(void)
+{
+	return calloc(1, sizeof(struct svgtiny_stylesheet));
+}
+
+
+void svgtiny_stylesheet_free(struct svgtiny_stylesheet *sheet)
+{
+	unsigned int i;
+
+	if (sheet == NULL) {
+		return;
+	}
+	for (i = 0; i < sheet->count; i++) {
+		free(sheet->rule[i].selector);
+		free(sheet->rule[i].declarations);
+	}
+	free(sheet->rule);
+	free(sheet);
+}
+
+
+static void trim(const char **start, const char **end)
+{
+	while (*start < *end && isspace((unsigned char) **start)) {
+		(*start)++;
+	}
+	while (*end > *start && isspace((unsigned char) *(*end - 1))) {
+		(*end)--;
+	}
+}
