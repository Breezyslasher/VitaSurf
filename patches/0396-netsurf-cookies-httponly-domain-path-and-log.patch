+/** Whether the cookie being set came from script (document.cookie) */
+static bool urldb_cookie_script = false;
+
+/**
+ * Log what became of a cookie a response or a script set: its name and
+ * where it applies, never its value.
+ *
+ * \param what What happened to it
+ * \param c    The cookie, NULL if it could not be parsed
+ * \param host The host whose response or document set it
+ */
+static void
+urldb_cookie_note(const char *what,
+		  const struct cookie_internal_data *c,
+		  lwc_string *host)
+{
+	char life[48];
+
+	if (c == NULL) {
+		NSLOG(netsurf, INFO, "cookie: %s%s from %s",
+		      urldb_cookie_script ? "script " : "", what,
+		      lwc_string_data(host));
+		return;
+	}
+	if (c->expires == -1) {
+		snprintf(life, sizeof(life), "for the session");
+	} else if (c->expires < time(NULL)) {
+		snprintf(life, sizeof(life), "already expired");
+	} else {
+		snprintf(life, sizeof(life), "for %ld s",
+			 (long)(c->expires - time(NULL)));
+	}
+	NSLOG(netsurf, INFO, "cookie: %s%s %s from %s, domain %s path %s, %s%s%s",
+	      urldb_cookie_script ? "script " : "", what,
+	      c->name != NULL ? c->name : "(no name)",
+	      lwc_string_data(host),
+	      c->domain != NULL ? c->domain : "?",
+	      c->path != NULL ? c->path : "?", life,
+	      c->secure ? ", secure" : "",
+	      c->http_only ? ", HttpOnly" : "");
+}
