 	if (c->n_anim > 0)
 		html_anim_relayout_ms += (unsigned) (t1 - t0);
 	if (res == NSERROR_INVALID) {
-		/* busy, or a field is being edited: try again */
+		/* busy, or a field is being edited: try again, still as
+		 * the pointer's rest, so the retry says why it rebuilt
+		 * (VitaSurf): a GitHub hover rebuilt the page with nothing
+		 * in the log to say what changed */
 		c->dynamic_relayout_pending = true;
+		c->dynamic_relayout_resting = rested;
 		guit->misc->schedule(250, html_dynamic_relayout, c);
 	}
 }
