diff --git a/content/handlers/html/html.c b/content/handlers/html/html.c
index 908ac0ad9..32f892497 100644
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -2933,6 +2933,62 @@ static bool html_box_paints(const struct box *b, int *budget)
 	return false;
 }
 
+/*
+ * Say which boxes a scroll draws again at every step, once each time
+ * that set changes (VitaSurf): a GitHub log showed two such areas on
+ * each step of its profile, half its drawing time, and nothing named
+ * them. Called with each box as it is listed, then with NULL and the
+ * count.
+ */
+static void html_pinned_note(const struct box *b, int i)
+{
+	static const struct box *seen[8], *now[8];
+	static int seen_n = -1;
+	int k;
+
+	if (b != NULL) {
+		if (i < 8)
+			now[i] = b;
+		return;
+	}
+	if (i == seen_n && memcmp(seen, now, sizeof(seen[0]) *
+			(size_t) (i < 8 ? i : 8)) == 0)
+		return;
+	seen_n = i;
+	memcpy(seen, now, sizeof(seen));
+	for (k = 0; k < i && k < 8; k++) {
+		const struct box *x = now[k];
+		dom_string *name = NULL, *cls = NULL;
+		char n[16] = "?", c[64] = "";
+
+		if (x->node != NULL) {
+			if (dom_node_get_node_name(x->node, &name) ==
+					DOM_NO_ERR && name != NULL) {
+				snprintf(n, sizeof(n), "%.*s",
+						(int) dom_string_byte_length(
+							name),
+						dom_string_data(name));
+				dom_string_unref(name);
+			}
+			if (dom_element_get_attribute(x->node,
+					corestring_dom_class, &cls) ==
+					DOM_NO_ERR && cls != NULL) {
+				int l = (int) dom_string_byte_length(cls);
+
+				snprintf(c, sizeof(c), " class \"%.*s\"",
+						l > 48 ? 48 : l,
+						dom_string_data(cls));
+				dom_string_unref(cls);
+			}
+		}
+		vita_log("pinned: %d of %d drawn again at each scroll step: "
+			 "%s%s, %s, at %d,%d to %d,%d", k + 1, i, n, c,
+			 css_computed_position(x->style) ==
+				CSS_POSITION_STICKY ? "sticky" : "fixed",
+			 x->pin_x0, x->pin_y0, x->pin_x1, x->pin_y1);
+	}
+}
+
 /* exported interface documented in html/html.h */
 int html_pinned_rects(struct hlcache_handle *h, const struct rect *area,
 		struct rect *out, int max)
@@ -2972,8 +3028,10 @@ int html_pinned_rects(struct hlcache_handle *h, const struct rect *area,
 		out[n].y0 = b->pin_y0;
 		out[n].x1 = b->pin_x1;
 		out[n].y1 = b->pin_y1;
+		html_pinned_note(b, n);
 		n++;
 	}
+	html_pinned_note(NULL, n);
 	return n;
 }
 
