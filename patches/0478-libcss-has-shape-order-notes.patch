+/*
+ * Where a sheet's :has() pseudo-classes are (VitaSurf), for what a
+ * change CSS_REACH_HAS keys on can restyle. With neither bit, each
+ * :has() is in the subject's compound and looks at descendants or
+ * children, so only the changed element's ancestors can answer it
+ * differently, and only their own styles, and what inherits them,
+ * change.
+ */
+enum css_has_shape {
+	/** a :has() left of a combinator: ".a:has(.b) .c" */
+	CSS_HAS_SHAPE_OUTER = 1,
+	/** an argument that looks at later siblings: ":has(+ .b)" */
+	CSS_HAS_SHAPE_SIBLING = 2
+};
+
+/**
+ * \param sheet  The stylesheet
+ * \return the css_has_shape bits of its :has() pseudo-classes
+ */
+uint32_t css_stylesheet_has_shape(const css_stylesheet *sheet);
