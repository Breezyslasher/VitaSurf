 		css_fixed *length, css_unit *unit);
 
+/**
+ * Whether a minimum size is the automatic one (VitaSurf).
+ *
+ * The two accessors above answer SET with a length of zero for an
+ * automatic minimum unless the element is itself a flex container. A
+ * caller that knows the element is a flex item, as flex layout does,
+ * asks here, and can then tell a page that wrote min-width: 0 from one
+ * that wrote nothing at all.
+ */
+bool css_computed_min_width_is_auto(const css_computed_style *style);
+bool css_computed_min_height_is_auto(const css_computed_style *style);
