diff --git a/src/select/computed.c b/src/select/computed.c
index f39c197..f535507 100644
--- a/src/select/computed.c
+++ b/src/select/computed.c
@@ -1455,6 +1455,35 @@ uint8_t css_computed_min_height(const css_computed_style *style,
 	return min_height;
 }
 
+/*
+ * Whether the minimum size is the automatic one (VitaSurf).
+ *
+ * The accessors below answer SET with a length of zero for an
+ * automatic minimum unless the element is itself a flex container,
+ * which is a guess at Flexbox 4.5: the rule is about a flex *item*,
+ * which is an element whose parent is a flex container, and the
+ * computed style cannot see the parent. A caller that does know, as
+ * flex layout does, asks here instead, and can then tell a page that
+ * wrote min-width: 0 from one that wrote nothing at all.
+ */
+bool css_computed_min_width_is_auto(const css_computed_style *style)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+
+	return get_min_width_fixed(style, &length, &unit) ==
+			CSS_MIN_WIDTH_AUTO;
+}
+
+bool css_computed_min_height_is_auto(const css_computed_style *style)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+
+	return get_min_height_fixed(style, &length, &unit) ==
+			CSS_MIN_HEIGHT_AUTO;
+}
+
 uint8_t css_computed_min_width(const css_computed_style *style,
 		css_fixed *length, css_unit *unit)
 {
