diff --git a/src/select/calc.c b/src/select/calc.c
index 25ff0b6..b427222 100644
--- a/src/select/calc.c
+++ b/src/select/calc.c
@@ -322,7 +322,16 @@ css_error css_calculator_calculate(css_calculator *calc,
 		return CSS_INVALID;
 	}
 
-	*unit_out = css__to_css_unit(calc->stack[0].unit);
+	/* A plain number has no unit to report. It was handed back as
+	 * CSS_UNIT_PX, which is what the mapping gives anything unknown, so
+	 * line-height: calc(1.75 / 1.125) became a line a pixel and a half
+	 * tall. It is marked instead, and the caller decides what a number
+	 * means for its property (VitaSurf). */
+	if (calc->stack[0].unit == UNIT_CALC_NUMBER) {
+		*unit_out = CSS_UNIT_CALC;
+	} else {
+		*unit_out = css__to_css_unit(calc->stack[0].unit);
+	}
 	*value_out = calc->stack[0].value;
 
 	return CSS_OK;
diff --git a/src/select/computed.c b/src/select/computed.c
index bb3ac24..01b76b7 100644
--- a/src/select/computed.c
+++ b/src/select/computed.c
@@ -1183,8 +1183,10 @@ static bool css__length_to_px(
 		}
 		/* The calculator normalises every length to CSS pixels,
 		 * whatever the units in the expression, so one last
-		 * conversion puts the answer in device pixels. */
-		if (unit == CSS_UNIT_PX) {
+		 * conversion puts the answer in device pixels. A plain
+		 * number (CSS_UNIT_CALC) is not a length at all; where one
+		 * is not meaningful it is read as pixels. */
+		if (unit == CSS_UNIT_PX || unit == CSS_UNIT_CALC) {
 			value.value = css_unit_len2device_px(style, unit_ctx,
 					value.value, CSS_UNIT_PX);
 		}
@@ -1283,7 +1285,48 @@ COMPUTED_LENGTH_PX_ZERO(min_width, CSS_MIN_WIDTH_SET)
 COMPUTED_LENGTH_PX_ZERO(min_height, CSS_MIN_HEIGHT_SET)
 COMPUTED_LENGTH_PX_ZERO(text_indent, CSS_TEXT_INDENT_SET)
 COMPUTED_LENGTH_PX_ZERO(vertical_align, CSS_VERTICAL_ALIGN_SET)
-COMPUTED_LENGTH_PX_ZERO(line_height, CSS_LINE_HEIGHT_DIMENSION)
+/*
+ * line-height is the one length whose calc() may come out as a plain
+ * number, which means that many times the font size, as the keyword-free
+ * form does: Tailwind writes every text size's line height as
+ * calc(1.75 / 1.125) and the like (VitaSurf).
+ */
+uint8_t css_computed_line_height_px(
+		const css_computed_style *style,
+		const css_unit_ctx *unit_ctx,
+		int available_px,
+		int *px_out)
+{
+	css_fixed_or_calc value = { .value = 0 };
+	css_unit unit = CSS_UNIT_PX;
+	uint8_t type = get_line_height(style, &value, &unit);
+
+	*px_out = 0;
+	if (type == CSS_LINE_HEIGHT_DIMENSION && unit == CSS_UNIT_CALC) {
+		css_unit u = unit;
+		css_fixed v = 0;
+
+		if (css_calculator_calculate(style->calc, unit_ctx,
+				available_px, value.calc, style,
+				&u, &v) != CSS_OK) {
+			return type;
+		}
+		if (u == CSS_UNIT_CALC) {
+			v = css_unit_len2device_px(style, unit_ctx, v,
+					CSS_UNIT_EM);
+		} else if (u == CSS_UNIT_PX) {
+			v = css_unit_len2device_px(style, unit_ctx, v,
+					CSS_UNIT_PX);
+		}
+		*px_out = FIXTOINT(v);
+		return type;
+	}
+	if (type == CSS_LINE_HEIGHT_DIMENSION && css__length_to_px(style,
+			unit_ctx, available_px, value, unit, px_out) == false) {
+		*px_out = 0;
+	}
+	return type;
+}
 COMPUTED_LENGTH_PX_ZERO(border_top_width, CSS_BORDER_WIDTH_WIDTH)
 COMPUTED_LENGTH_PX_ZERO(border_right_width, CSS_BORDER_WIDTH_WIDTH)
 COMPUTED_LENGTH_PX_ZERO(border_bottom_width, CSS_BORDER_WIDTH_WIDTH)
