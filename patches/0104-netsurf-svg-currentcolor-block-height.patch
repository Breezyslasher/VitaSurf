+	/* The root's computed colour, for a fill="currentColor" or
+	 * stroke="currentColor" attribute anywhere inside (VitaSurf):
+	 * libsvgtiny does not know the keyword and painted it black. */
+	bool have_current;
+	char current[8];
 };
 
