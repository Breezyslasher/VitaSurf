-						dom_string_byte_length(value));
+					const char *vd = dom_string_data(value);
+					size_t vl = dom_string_byte_length(value);
+					bool paint = (nl == 4 &&
+						strncmp(nd, "fill", 4) == 0) ||
+						(nl == 6 &&
+						strncmp(nd, "stroke", 6) == 0);
+
+					if (paint && b->have_current &&
+					    vl == 12 &&
+					    strncasecmp(vd, "currentColor",
+							12) == 0) {
+						svg_buf_lit(b, b->current);
+					} else if (nl == 5 && b->have_current &&
+						   strncmp(nd, "style", 5) == 0) {
+						svg_buf_style_current(b, vd, vl);
+					} else {
+						svg_buf_escaped(b, vd, vl);
+					}
 					dom_string_unref(value);
 				}
 				svg_buf_lit(b, "\"");
@@ -2589,7 +2632,7 @@ box_svg(dom_node *n,
