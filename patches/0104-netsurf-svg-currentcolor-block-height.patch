@@ -2130,6 +2135,29 @@ static void svg_paint_attributes(struct svg_buf *b,
 	}
 }
 
+/** Copy a style attribute, with currentColor replaced by the colour. */
+static void svg_buf_style_current(struct svg_buf *b, const char *s, size_t n)
+{
+	size_t i = 0;
+
+	while (i < n) {
+		if (n - i >= 12 && strncasecmp(s + i, "currentColor", 12) == 0) {
+			svg_buf_lit(b, b->current);
+			i += 12;
+		} else {
+			size_t j = i + 1;
+
+			while (j < n && !(n - j >= 12 &&
+					  strncasecmp(s + j, "currentColor",
+						      12) == 0)) {
+				j++;
+			}
+			svg_buf_escaped(b, s + i, j - i);
+			i = j;
+		}
+	}
+}
