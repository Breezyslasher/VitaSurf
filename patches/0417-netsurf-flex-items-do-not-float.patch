+/**
+ * Layout helper: whether a box's float takes it out of flow. A flex
+ * item's float does nothing (CSS Flexbox 4), though its computed value
+ * still names a side, and the containing block a float has --
+ * parent->parent->parent, past its float box and inline container --
+ * is not there for it: an item floated right inside a flex container
+ * that was itself a float found an inline container, which has no
+ * style, and the layout read through null (VitaSurf).
+ */
+static inline bool lh__box_floats(const struct box *b)
+{
+	return b->style != NULL && !lh__box_is_flex_item(b) &&
+	       (css_computed_float(b->style) == CSS_FLOAT_LEFT ||
+		css_computed_float(b->style) == CSS_FLOAT_RIGHT);
+}
