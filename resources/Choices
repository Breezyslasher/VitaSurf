# VitaSurf default options. NetSurf reads this file from app0:resources.
# Phase 5 adds a user copy under ux0:data/VitaSurf that overrides it.
# Option names are documented in deps/netsurf/docs/netsurf-options.md.

# Home page: a bundled local page, loaded through the file fetcher.
homepage_url:file:///resources/vitasurf.html

# Screen geometry
window_width:960
window_height:544

# Memory is the main constraint: every cache has a bound.
# 24 MB: NetSurf gives a quarter of this to decoded images, and at 4 MB
# that was 1 MB, about one poster, so a picture scrolled off and back
# was decoded again. The heap peaked at 84 MB of its 176 MB on GitHub
# and Yamtrack with the old figure. vita_options_floor() holds it here.
memory_cache_size:25165824
max_cached_fetch_handles:4
# A page that loads its code in pieces asks for a dozen at once and a
# bundler gives up on one after a couple of seconds, so these have to be
# closer to what a browser uses than to what saves the most memory. The
# fetchers are small next to the documents they fetch. vita_options_floor
# raises anything lower, because a Choices file written by an earlier
# build is read after this one.
max_fetchers:12
max_fetchers_per_host:6
# FreeType glyph cache for the bundled DejaVu fonts, in KB.
fb_font_cachesize:2048

# JavaScript: QuickJS, an interpreter, so scripts get a time budget
# (seconds) before they are stopped. Large sites ship bundles that need
# most of this; qjs.c enforces the same value as a floor, because a
# Choices file written by an earlier build overrides this one.
enable_javascript:1
script_timeout:20

# Networking (phase 2). Certificates come from the bundled Mozilla CA file.
ca_bundle:app0:resources/cacert.pem
# Let libcurl's connection trace reach the log while verbose logging is on.
suppress_curl_debug:0
send_referer:1
do_not_track:0

# Decode no image larger than the screen. Detail past what 960x544 can
# show costs memory and buys nothing, and a page of full size photographs
# is what uses the heap up: eight 2400x1600 JPEGs held 123 MB before this
# and 14 MB after. Images are still laid out at their own size. Raise it
# if you zoom in a lot and mind the softness.
max_image_width:960
max_image_height:544

# The disc cache, on the memory card rather than in memory. NetSurf's
# default limit is a gigabyte, which is not a sensible thing to leave on
# someone's card; 128 MB holds a lot of pages. disc_cache_age is in days.
disc_cache_path:ux0:data/VitaSurf/cache
disc_cache_size:134217728
disc_cache_age:28

# Persistence (phase 5) writes here.
cookie_file:ux0:data/VitaSurf/Cookies
cookie_jar:ux0:data/VitaSurf/Cookies

# Reflowing a large page costs seconds on the Vita, so let images arrive
# for a while before laying out again (centiseconds).
min_reflow_period:200

# Framebuffer toolkit sizes tuned for a 960x544 screen with touch. The
# on-screen keyboard is the fallback when the system IME is unavailable.
fb_furniture_size:22
fb_toolbar_size:36
fb_osk:1
