# NetSurf build configuration for VitaSurf.
#
# scripts/build-netsurf.sh copies this file to deps/netsurf/Makefile.config
# before running make. Do not edit the copy in the submodule; edit this one.
#
# NetSurf's Makefile.defaults documents every option used here. The build
# script passes HOST=vita for the Vita; a host build (VITASURF_NATIVE=1)
# gets the same feature set with the host's own HOST value, which is how the
# scripts are tested on Linux.

ifneq ($(TARGET),framebuffer)
  $(error VitaSurf only supports TARGET=framebuffer)
endif

# ---------------------------------------------------------------------------
# Static library output
#
# NetSurf normally links an executable. VitaSurf links the final binary with
# CMake instead, so this rule archives every NetSurf object into a static
# library. OBJECTS and MESSAGES are only defined after this file is included,
# hence the secondary expansion.
# ---------------------------------------------------------------------------
.SECONDEXPANSION:
$(OBJROOT)/libnetsurf.a: $$(OBJECTS) $$(MESSAGES)
	$(VQ)echo "      AR: $@"
	$(Q)$(RM) $@
	$(Q)$(AR) rcs $@ $(OBJECTS)

# ---------------------------------------------------------------------------
# Feature set (all hosts)
# ---------------------------------------------------------------------------

# Phase 1 boots with JavaScript disabled. Phase 4 turns Duktape on, which
# also needs nsgenbind built as a host tool.
override NETSURF_USE_DUKTAPE := NO

# Fetching. libcurl does the TLS work with the bundled CA file; NetSurf's own
# OpenSSL certificate inspection is off because VitaSDK ships OpenSSL 1.0.2.
override NETSURF_USE_CURL := YES
override NETSURF_USE_OPENSSL := NO
override NETSURF_USE_NSPSL := YES

# Image formats available from vdpm.
override NETSURF_USE_JPEG := YES
override NETSURF_USE_PNG := YES
override NETSURF_USE_BMP := YES
override NETSURF_USE_GIF := YES
override NETSURF_USE_NSSVG := YES
override NETSURF_USE_WEBP := NO
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_VIDEO := NO
override NETSURF_USE_HARU_PDF := NO

# Text handling. VitaSDK newlib is built with iconv, so no libiconv is linked.
override NETSURF_USE_UTF8PROC := YES
override NETSURF_USE_LIBICONV_PLUG := YES

# Logging. VITASURF_DEBUG=1 compiles verbose logging in; release builds keep
# only INFO and above so logging stays cheap.
override NETSURF_USE_NSLOG := YES
ifeq ($(VITASURF_DEBUG),1)
  override NETSURF_LOG_LEVEL := VERBOSE
else
  override NETSURF_LOG_LEVEL := INFO
endif

# The internal bitmap font needs no files on disk (phase 7 adds FreeType).
override NETSURF_FB_FONTLIB := internal

override NETSURF_HOMEPAGE := "about:welcome"
override NETSURF_STRIP_BINARY := NO
override NETSURF_FS_BACKING_STORE := NO

CFLAGS += -O2 -ffunction-sections -fdata-sections -DVITASURF=1
ifeq ($(VITASURF_DEBUG),1)
  CFLAGS += -g -DVITASURF_DEBUG=1
endif

# ---------------------------------------------------------------------------
# PS Vita only
# ---------------------------------------------------------------------------
ifeq ($(HOST),vita)

# The Vita surface is registered by vita/surface/vita.c at link time.
override NETSURF_FB_FRONTEND := vita

# Resource search path. Drive-less absolute paths resolve against the
# current drive, which VitaSDK newlib initialises to app0:, so these reach
# app0:/resources. See vita/platform/vita_platform.h for the writable paths.
override NETSURF_FB_RESPATH := /resources
override NETSURF_FB_FONTPATH := /resources/fonts

# vita_platform.h, for the memory logging hook added by
# patches/0002-netsurf-vita-memory-log.patch.
CFLAGS += -I$(CURDIR)/../../vita/platform

endif
